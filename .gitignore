# venv + transient/rendered/config
.venv/
opencode_cc_mem/opencode.json
# user research data (scaffolded per launch; never the 111G originals)
opencode_cc_mem/projects/
# heavy re-installable local tool binaries/weights
opencode_cc_mem/softwares/boltzgen/cache/
opencode_cc_mem/softwares/namd/
opencode_cc_mem/softwares/p2rank_2.5.1/
# Ad Verum: whitelist softwares/ — everything untracked (envs/, gnina/, gnina,
# manifest state, installed tool wrappers) is machine-local; only the small
# infra scripts under bin/ belong in git (mirrors outer ad_verum/.gitignore)
opencode_cc_mem/softwares/*
!opencode_cc_mem/softwares/bin/
opencode_cc_mem/softwares/bin/*
!opencode_cc_mem/softwares/bin/hpc_tunnel.sh
!opencode_cc_mem/softwares/bin/debate.sh
!opencode_cc_mem/softwares/bin/magnolia
!opencode_cc_mem/softwares/bin/magnolia-run
!opencode_cc_mem/softwares/bin/magnolia-selfreflex
!opencode_cc_mem/softwares/bin/tests/
!opencode_cc_mem/softwares/bin/tests/**
# caches / logs
__pycache__/
*.pyc
*.log
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/

# Ad Verum: machine-local runtime state, never commit
.magnolia/
**/.magnolia/
extraction-state.yaml
**/extraction-state.yaml
# Agent session process docs (plans/specs), never track
docs/superpowers/
opencode_cc_mem/docs/superpowers/
opencode_cc_mem/docs/INFRASTRUCTURE_ASSESSMENT*

# Pure magnolia side
old_files/
opencode_3_tier_mem/
todo.md
.codegraph/
settings.json
memory-learning-flow.md
plans/
HANDOVER.md

# Root-level docs/ also holds machine-local setup runbooks (credentials-adjacent).
# Everything is ignored by default; only the curated documentation set below is
# tracked, so a new local runbook can never be committed by accident.
/docs/*
!/docs/index.md
!/docs/getting-started.md
!/docs/use-cases.md
!/docs/architecture.md
!/docs/memory.md
!/docs/hpc.md
!/docs/tools.md

# Personal cluster runbook (UniCA/Azzurra specifics, username examples) — machine-local only
opencode_cc_mem/rules/hpc_azzurra.md

# Machine-local tool launchers (absolute-path symlinks, valid on one machine only) — never track
opencode_cc_mem/softwares/bin/p2rank
opencode_cc_mem/softwares/bin/boltzgen
opencode_cc_mem/softwares/boltzgen/.venv

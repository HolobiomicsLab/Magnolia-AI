#!/bin/bash
# magnolia — launch opencode for a specific Magnolia project.
#
# Usage:   magnolia <project>
# Example: magnolia hsc70_peptides
#
# Renders opencode_cc_mem/opencode.json from opencode.json.template (substituting
# the project name and detected venv python), then execs opencode from
# opencode_cc_mem/. The wrapper's argument always wins over any pre-set
# MAGNOLIA_PROJECT_DIR in the environment.
#
# If the project doesn't exist, prompts (y/N, default N) to scaffold it:
# creates the .magnolia/ subdirs and a seed GOAL.md (optionally expanded
# from a one-line description via the `claude` CLI when available).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"
# softwares/bin/magnolia → opencode_cc_mem/
OPENCODE_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
# opencode_cc_mem/ → repo root
REPO_ROOT="$(cd "$OPENCODE_DIR/.." && pwd)"

TEMPLATE="$OPENCODE_DIR/opencode.json.template"
CONFIG="$OPENCODE_DIR/opencode.json"
PROJECTS_DIR="$OPENCODE_DIR/projects"
VENV_PY="$REPO_ROOT/.venv/bin/python3"

# Machine-local LLM setup side file (gitignored via **/.magnolia/). The
# launcher re-renders opencode.json from the template on EVERY launch, so
# LLM choices must persist here — never in the volatile opencode.json.
# Shape: {"main_model": "...", "memory_model": "...",
#         "memory_provider": "...", "memory_enabled": true}
LLM_SETUP="$OPENCODE_DIR/.magnolia/llm-setup.json"
ACTIVE_PROJECT_FILE="$OPENCODE_DIR/.magnolia/.active-project"

# Python for config rendering + LLM probes (venv preferred, PATH fallback).
if [ -x "$VENV_PY" ]; then
    PYTHON_CMD="$VENV_PY"
else
    PYTHON_CMD="python"
fi

# Subdirs created under <project>/.magnolia/ for every new project. Matches
# the layout that ProjectManager + the auto-extractor + the poller all
# expect; pre-creating avoids first-write races and silent fallbacks.
MAGNOLIA_SUBDIRS=(entries staging runs sessions queue archive backups session-notes)

usage() {
    cat <<EOF
Usage: magnolia [setup] [--critic] <project>
       magnolia memory set <model> [--provider P]
       magnolia memory status

Launch opencode for the given Magnolia project. If the project does not
exist, prompts to scaffold it under $PROJECTS_DIR/.

Setup (two-step, run once):
  setup            Step 1: configure + verify the MAIN model (the agent you
                   talk to). Step 2: configure + verify the MEMORY model
                   (background: distillation, handover, re-ranking). Memory
                   stays disabled until verified. Step 2 can be deferred —
                   start opencode and tell the agent "set up memory" (see
                   rules/memory-setup.md). Choices persist in
                   .magnolia/llm-setup.json and are re-injected into
                   opencode.json on every launch.

Options:
  --critic  Enable the flag-only claim-vs-action critic for this session.
            An independent judge LLM flags report claims not backed by the
            tools actually run; verdicts are logged to
            <project>/.magnolia/claim-critic/ and shown as toasts. Changes nothing.

Examples:
  magnolia setup hsc70_peptides
  magnolia hsc70_peptides
  magnolia memory set deepseek-flash
  magnolia --critic hsc70_peptides

Available projects:
EOF
    if [ -d "$PROJECTS_DIR" ]; then
        found=0
        for d in "$PROJECTS_DIR"/*/; do
            if [ -d "$d" ]; then
                echo "  $(basename "$d")"
                found=1
            fi
        done
        if [ "$found" -eq 0 ]; then
            echo "  (none — pass any name to create one)"
        fi
    else
        echo "  (projects dir missing at $PROJECTS_DIR/)"
    fi
}

# Scaffold a new project: <project>/.magnolia/ + standard subdirs.
# Idempotent — safe to re-run on a project that already has some structure.
create_project_structure() {
    local proj="$1"
    local root="$PROJECTS_DIR/$proj"
    local magdir="$root/.magnolia"
    mkdir -p "$magdir"
    for sub in "${MAGNOLIA_SUBDIRS[@]}"; do
        mkdir -p "$magdir/$sub"
    done
    # opencode.json's instructions array references these two files; stub
    # them so a brand-new project never references missing files. Memory
    # takes them over once configured and enabled.
    [ -f "$magdir/boot-context.md" ] || touch "$magdir/boot-context.md"
    [ -f "$magdir/audit-report.md" ] || touch "$magdir/audit-report.md"
    echo "  created: $root/.magnolia/{$(IFS=,; echo "${MAGNOLIA_SUBDIRS[*]}")}"
}

# Write GOAL.md from a one-line description.
# If a description was provided AND Magnolia's LLM client has a usable
# provider (per `is_llm_available()` in compchem_memory.llm — which
# autodetects DEEPSEEK_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY),
# expand the one-liner into a structured markdown via call_llm — same
# provider+model the rest of Magnolia uses for memory work. On any
# failure (no provider configured, network, parse error), fall back
# cleanly to a minimal template with the user's input preserved verbatim.
write_goal_md() {
    local proj="$1"
    local goal_line="$2"
    local goal_path="$PROJECTS_DIR/$proj/.magnolia/GOAL.md"

    if [ -z "$goal_line" ]; then
        cat > "$goal_path" <<EOF
# Goal: $proj

<!-- TODO: write a one-line summary of what this project is trying to
     achieve, then expand into Background / Inputs / Approach / Success
     Criteria. The agent can help with this on first launch. -->
EOF
        echo "  created: GOAL.md (empty template — fill in on first launch)"
        return
    fi

    # Try LLM expansion. Defer the "is the LLM available + which model"
    # decision to compchem_memory.llm — it knows the full resolution order
    # (MAGNOLIA_MEMORY_PROVIDER → model-name prefix → keys → DEEPSEEK →
    # ANTHROPIC → OPENAI). Anything that's not "got useful text back" → fall
    # through to the minimal template.
    if [ -x "$VENV_PY" ]; then
        local system_prompt user_content
        system_prompt="You are scaffolding GOAL.md for a computational-chemistry project named '$proj' in a Magnolia memory-backed agent system. Generate a concise markdown GOAL.md (about 200-400 words) with these sections:
- '# Goal: $proj' (H1 title)
- '## One-line summary' (the user's input, verbatim)
- '## Background' (2-3 sentences placing the goal in scientific context)
- '## Inputs' (bullets — anticipated data/files needed; mark items the user must provide as TODO)
- '## Approach' (3-5 bullets, expected steps; reasonable guesses are fine, mark unknowns as TODO)
- '## Success criteria' (how 'done' will be measured)
- '## Open questions' (things the user/agent should clarify before starting)

Output ONLY the markdown content. No preamble, no code fences around the whole document, no signature."
        user_content="$goal_line"

        # Probe + announce + call, all in one venv python invocation, so the
        # provider/model the user sees printed is the one that actually
        # served the request.
        local llm_out
        llm_out="$(MAGNOLIA_GOAL_SYSTEM="$system_prompt" MAGNOLIA_GOAL_USER="$user_content" \
            MEM_SRC="$OPENCODE_DIR/mcp-servers/compchem-memory/src" \
            "$VENV_PY" -c "
import os, sys
sys.path.insert(0, os.environ['MEM_SRC'])
from compchem_memory.llm import call_llm, is_llm_available, _resolve_provider, _get_model
if not is_llm_available():
    print('NO_PROVIDER', file=sys.stderr)
    sys.exit(0)
provider, model = _resolve_provider(), _get_model(_resolve_provider())
print(f'PROVIDER={provider} MODEL={model}', file=sys.stderr)
out = call_llm(os.environ['MAGNOLIA_GOAL_SYSTEM'], os.environ['MAGNOLIA_GOAL_USER'], max_tokens=1500)
sys.stdout.write(out or '')
" 2> >(while IFS= read -r line; do
    case "$line" in
        (PROVIDER=*) echo "  expanding goal via Magnolia's LLM (${line#*MODEL=})…" >&2 ;;
        (NO_PROVIDER) echo "  note: no LLM provider configured (set DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, or OPENAI_API_KEY) — skipping LLM expansion" >&2 ;;
        (*) echo "  llm stderr: $line" >&2 ;;
    esac
done))" || true

        if [ -n "$llm_out" ]; then
            printf '%s\n' "$llm_out" > "$goal_path"
            echo "  created: GOAL.md (expanded by Magnolia's LLM)"
            return
        fi
    fi

    cat > "$goal_path" <<EOF
# Goal: $proj

## One-line summary
$goal_line

<!-- TODO: expand into Background / Inputs / Approach / Success criteria.
     The agent can help with this on first launch. -->
EOF
    echo "  created: GOAL.md (minimal template — user goal preserved verbatim)"
}

# Read a prompt response from stdin if stdin is a terminal. Echoes the
# answer on stdout; non-zero exit if stdin isn't a tty (e.g. the script
# was invoked from a pipe or with a redirected stdin).
_read_from_tty() {
    local prompt="$1"
    local answer=""
    if [ ! -t 0 ]; then
        return 1
    fi
    printf '%s' "$prompt" >&2
    IFS= read -r answer || return 1
    printf '%s' "$answer"
}

prompt_create_project() {
    local proj="$1"
    echo "Project '$proj' does not exist at $PROJECTS_DIR/$proj/" >&2
    echo >&2
    local answer
    if ! answer="$(_read_from_tty "Create it? [y/N] ")"; then
        echo >&2
        echo "error: no controlling terminal — cannot prompt to create project." >&2
        echo "Re-run from an interactive shell, or create the directory manually:" >&2
        echo "  mkdir -p $PROJECTS_DIR/$proj/.magnolia/{$(IFS=,; echo "${MAGNOLIA_SUBDIRS[*]}")}" >&2
        exit 1
    fi
    case "$answer" in
        y|Y|yes|YES)
            : # fall through to scaffold
            ;;
        *)
            echo "Aborted; no project created." >&2
            exit 1
            ;;
    esac

    echo "Scaffolding $PROJECTS_DIR/$proj/ …" >&2
    create_project_structure "$proj"

    local goal_line
    echo >&2
    # If goal prompt fails (unlikely given the create prompt just succeeded),
    # treat it as 'skipped' — falls through to the empty-template branch.
    goal_line="$(_read_from_tty "Briefly describe the project goal in one line (or press Enter to skip): " || true)"
    write_goal_md "$proj" "$goal_line"
    echo >&2
    echo "Project '$proj' ready. Launching opencode…" >&2
    echo >&2
}

# Read one key from the setup side file ("" when unset/missing).
setup_get() {
    [ -f "$LLM_SETUP" ] || return 0
    MAG_SETUP="$LLM_SETUP" "$PYTHON_CMD" -c '
import json, os
try:
    d = json.load(open(os.environ["MAG_SETUP"]))
    v = d.get("'"$1"'", "")
    print(v if isinstance(v, str) else "")
except Exception:
    pass
' 2>/dev/null
}

# Merge key=value pairs into the setup side file ("true"/"false" → bool).
setup_set() {
    MAG_SETUP="$LLM_SETUP" "$PYTHON_CMD" - "$@" <<'PY'
import json, os, pathlib, sys
sp = pathlib.Path(os.environ["MAG_SETUP"])
d = {}
if sp.exists():
    try:
        d = json.loads(sp.read_text())
    except (OSError, json.JSONDecodeError):
        d = {}
for kv in sys.argv[1:]:
    k, _, v = kv.partition("=")
    if v in ("true", "false"):
        v = (v == "true")
    d[k] = v
sp.parent.mkdir(parents=True, exist_ok=True)
sp.write_text(json.dumps(d, indent=2) + "\n")
PY
}

# Render opencode.json: template substitutions + side-file LLM policy.
# Memory MCP stays DISABLED until a memory model is configured and verified —
# a half-configured memory server silently degrades (the 2026-08 freeze).
# Echoes "on"/"off" so callers can report the resulting memory state.
render_config() {
    local project="$1"
    MAG_TPL="$TEMPLATE" MAG_CFG="$CONFIG" MAG_PROJ="$project" \
    MAG_ROOT="$REPO_ROOT" MAG_PY="$PYTHON_CMD" MAG_SETUP="$LLM_SETUP" \
    "$PYTHON_CMD" - <<'PY'
import json, os, pathlib
setup = {}
sp = pathlib.Path(os.environ["MAG_SETUP"])
if sp.exists():
    try:
        setup = json.loads(sp.read_text())
    except (OSError, json.JSONDecodeError):
        setup = {}
mem_on = bool(setup.get("memory_enabled")) and bool(setup.get("memory_model"))
cfg = pathlib.Path(os.environ["MAG_TPL"]).read_text()
cfg = (cfg.replace("@@PROJECT@@", os.environ["MAG_PROJ"])
          .replace("@@MAGNOLIA_ROOT@@", os.environ["MAG_ROOT"])
          .replace("@@PYTHON@@", os.environ["MAG_PY"])
          .replace("@@MEMORY_ENABLED@@", "true" if mem_on else "false"))
cfg = json.loads(cfg)
if setup.get("main_model"):
    cfg["model"] = setup["main_model"]
if mem_on:
    env = cfg["mcp"]["compchem-memory"]["environment"]
    env["MAGNOLIA_MEMORY_MODEL"] = setup["memory_model"]
    if setup.get("memory_provider"):
        env["MAGNOLIA_MEMORY_PROVIDER"] = setup["memory_provider"]
out = pathlib.Path(os.environ["MAG_CFG"])
tmp = out.with_name(out.name + ".tmp")
tmp.write_text(json.dumps(cfg, indent=2) + "\n")
os.replace(tmp, out)
print("on" if mem_on else "off")
PY
}

# One real call_llm round-trip against a candidate (model, provider).
# Fresh subprocess — the running MCP server's stale env can't mask a bad
# config. Exit 0 + "MEMORY_OK" only on a genuinely working combination.
probe_memory() {
    local model="$1" provider="${2:-}"
    MAGNOLIA_MEMORY_MODEL="$model" MAGNOLIA_MEMORY_PROVIDER="$provider" \
    MEM_SRC="$OPENCODE_DIR/mcp-servers/compchem-memory/src" \
    "$PYTHON_CMD" - <<'PY'
import os, sys
sys.path.insert(0, os.environ["MEM_SRC"])
from compchem_memory.llm import call_llm, _resolve_call
provider, model = _resolve_call()
if not provider:
    print("NO_PROVIDER: no API key found (export DEEPSEEK_API_KEY / "
          "ANTHROPIC_API_KEY / OPENAI_API_KEY / KIMI_API_KEY)", file=sys.stderr)
    sys.exit(1)
sys.stderr.write(f"probe: provider={provider} model={model}\n")
out = call_llm("You are a connectivity probe. Reply with exactly: MEMORY_OK",
               "ping", max_tokens=200, temperature=0, disable_thinking=True)
sys.exit(0 if (out and "MEMORY_OK" in out) else 1)
PY
}

# Re-render for the active project if one is known (best-effort).
render_active_project() {
    [ -s "$ACTIVE_PROJECT_FILE" ] || return 0
    render_config "$(cat "$ACTIVE_PROJECT_FILE")" >/dev/null
}

cmd_memory_set() {
    local model="" provider=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --provider) provider="$2"; shift 2 ;;
            --*) echo "error: unknown option '$1'" >&2; exit 1 ;;
            *) model="$1"; shift ;;
        esac
    done
    if [ -z "$model" ]; then
        echo "usage: magnolia memory set <model> [--provider P]" >&2
        exit 1
    fi
    echo "verifying memory model '$model' with one real call…"
    if ! probe_memory "$model" "$provider"; then
        echo "verification FAILED — nothing written." >&2
        echo "hints: wrong model id? missing API key for that provider? network?" >&2
        exit 1
    fi
    setup_set "memory_model=$model" "memory_provider=$provider" "memory_enabled=true"
    render_active_project
    echo "memory model set: $model (enabled). Restart opencode to activate."
}

cmd_memory_status() {
    echo "setup side file: $LLM_SETUP"
    if [ -f "$LLM_SETUP" ]; then
        cat "$LLM_SETUP"
    else
        echo "  (absent — memory MCP will be rendered disabled)"
    fi
    if [ -s "$ACTIVE_PROJECT_FILE" ]; then
        local proj
        proj="$(cat "$ACTIVE_PROJECT_FILE")"
        echo "active project: $proj"
        "$PYTHON_CMD" -c '
import json
cfg = json.load(open("'"$CONFIG"'"))
m = cfg["mcp"]["compchem-memory"]
print("rendered opencode.json: memory enabled =", m.get("enabled"),
      "| model =", m.get("environment", {}).get("MAGNOLIA_MEMORY_MODEL",
              m.get("environment", {}).get("MAGNOLIA_LLM_MODEL", "(default)")))
' 2>/dev/null || true
    fi
}

# Interactive two-step setup (step 2 can also be done later via the agent
# + `magnolia memory set` — see rules/memory-setup.md).
setup_run() {
    echo "=== Magnolia setup ==="

    # Migration: adopt real values from a legacy opencode.json, if any.
    if [ ! -f "$LLM_SETUP" ] && [ -f "$CONFIG" ]; then
        local legacy
        legacy="$(MAG_CFG="$CONFIG" "$PYTHON_CMD" -c '
import json, os
try:
    e = json.load(open(os.environ["MAG_CFG"]))["mcp"]["compchem-memory"].get("environment", {})
    m, p = e.get("MAGNOLIA_MEMORY_MODEL", e.get("MAGNOLIA_LLM_MODEL", "")), e.get("MAGNOLIA_MEMORY_PROVIDER", e.get("MAGNOLIA_LLM_PROVIDER", ""))
    print((m if m and not m.startswith("@@") else "") + "\t" + (p if p and not p.startswith("@@") else ""))
except Exception:
    print("\t")
' 2>/dev/null || true)"
        local legacy_model="${legacy%%$'\t'*}" legacy_provider="${legacy##*$'\t'}"
        if [ -n "$legacy_model" ]; then
            setup_set "memory_model=$legacy_model" "memory_provider=$legacy_provider" "memory_enabled=true"
            echo "migrated existing memory config: $legacy_model (enabled)"
        fi
    fi

    echo
    echo "Step 1 — main model (drives the agent you talk to)."
    local cur_main
    cur_main="$(setup_get main_model)"
    echo "  opencode model id, e.g. deepseek/deepseek-v4-pro. Enter = keep ${cur_main:-opencode default}."
    local ans
    ans="$(_read_from_tty "  main model: " || true)"
    if [ -n "$ans" ]; then
        echo "  verifying with one real round-trip (may take ~1 min)…"
        if timeout 180 opencode run -m "$ans" 'Reply with exactly: MAIN_MODEL_OK' 2>&1 | grep -q MAIN_MODEL_OK; then
            setup_set "main_model=$ans"
            echo "  OK — main model verified."
        else
            echo "  FAILED to verify '$ans'." >&2
            echo "  hints: 'opencode auth login' for your provider; id must be provider/model; check network." >&2
            exit 1
        fi
    else
        echo "  keeping ${cur_main:-opencode default}."
    fi

    echo
    echo "Step 2 — memory model (background only: distillation, handover, re-ranking)."
    echo "  Cheap is recommended; the provider is derived from the model name."
    local cur_mem def_mem
    cur_mem="$(setup_get memory_model)"
    def_mem="${cur_mem:-deepseek-flash}"
    ans="$(_read_from_tty "  memory model [$def_mem]: " || true)"
    local mem="${ans:-$def_mem}"
    echo "  verifying with one real call…"
    if probe_memory "$mem" ""; then
        setup_set "memory_model=$mem" "memory_enabled=true"
        echo "  OK — memory verified and enabled."
    else
        setup_set "memory_model=$mem" "memory_enabled=false"
        echo "  verification FAILED — memory left OFF (main model still works)." >&2
        echo "  Fix the key/model and re-run setup, or ask your agent: \"set up memory\"." >&2
    fi

    render_active_project
    echo
    if [ "$(setup_get memory_enabled)" = "true" ]; then
        echo "Setup complete: main model + memory model configured."
    else
        echo "Setup complete for the MAIN model. Memory is OFF."
        echo "Start opencode and tell your agent: \"set up memory\"."
    fi
}

if [ "$#" -eq 0 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

# Subcommand dispatch: `magnolia memory …` configures and exits (no launch).
if [ "${1:-}" = "memory" ]; then
    shift
    case "${1:-}" in
        set) shift; cmd_memory_set "$@"; exit 0 ;;
        status) cmd_memory_status; exit 0 ;;
        *)
            echo "usage: magnolia memory set <model> [--provider P]   |   magnolia memory status" >&2
            exit 1
            ;;
    esac
fi

# Parse flags (--critic, setup) plus the single project positional.
CRITIC=0
SETUP=0
PROJECT=""
for arg in "$@"; do
    case "$arg" in
        --critic) CRITIC=1 ;;
        setup) SETUP=1 ;;
        -h|--help) usage; exit 0 ;;
        --*) echo "error: unknown option '$arg'" >&2; echo >&2; usage >&2; exit 1 ;;
        *)
            if [ -n "$PROJECT" ]; then
                echo "error: expected exactly one project argument" >&2
                echo >&2; usage >&2; exit 1
            fi
            PROJECT="$arg"
            ;;
    esac
done

if [ -z "$PROJECT" ]; then
    echo "error: no project specified" >&2
    echo >&2
    usage >&2
    exit 1
fi

if [ ! -d "$PROJECTS_DIR/$PROJECT" ]; then
    prompt_create_project "$PROJECT"
fi

if [ ! -f "$TEMPLATE" ]; then
    echo "error: template missing at $TEMPLATE" >&2
    exit 1
fi

if ! command -v opencode >/dev/null 2>&1; then
    echo "error: 'opencode' not found in PATH" >&2
    exit 1
fi

# Two-step interactive setup (step 2 can be deferred to the agent).
if [ "$SETUP" = "1" ]; then
    setup_run
    if [ -z "$PROJECT" ]; then
        echo
        echo "Launch a project with: magnolia <project>"
        exit 0
    fi
    echo
    echo "Continuing to launch '$PROJECT'…"
    echo
fi

# Safety net (2026-09-10): the live tree must be on master. A stray checkout
# would silently run experimental code in daily sessions (worktree architecture:
# see runs/2026-09-10_debate-position-ds/execution-plan.md). Enforced; bypass
# for deliberate exceptions: MAGNOLIA_ALLOW_NONMASTER=1 magnolia <project>
if [ "${MAGNOLIA_ALLOW_NONMASTER:-0}" != "1" ]; then
    LIVE_BRANCH="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [ "$LIVE_BRANCH" != "master" ]; then
        echo "error: live tree is on '$LIVE_BRANCH', not master — refusing to launch." >&2
        echo "  tree: $REPO_ROOT" >&2
        echo "  deliberate exception: MAGNOLIA_ALLOW_NONMASTER=1 magnolia $PROJECT" >&2
        exit 1
    fi
fi

# Render template + LLM policy → opencode.json (atomic; echoes on/off).
MEMORY_STATE="$(render_config "$PROJECT")"
if [ "$MEMORY_STATE" = "off" ]; then
    echo "note: memory is NOT configured — the agent will offer setup when opencode starts." >&2
fi

# Wrapper argument wins over any pre-set env var.
export MAGNOLIA_PROJECT_DIR="projects/$PROJECT"

# Let the capture plugin (and any other opencode plugin) know which project
# is active. opencode does not pass shell env vars to plugin code; this file
# is the only reliable channel.
echo "$PROJECT" > "$OPENCODE_DIR/.magnolia/.active-project"

# Activate the project venv for THIS process — and thus opencode, its MCP
# servers, and any tool subprocesses (p2rank, haddock3, …) they spawn, so
# binaries resolve on PATH. magnolia runs as a subprocess, so this never leaks
# into the caller's interactive shell: quitting opencode restores the prior env.
if [ -f "$REPO_ROOT/.venv/bin/activate" ]; then
    set +u  # activate references unset vars under `set -u`
    # shellcheck disable=SC1091
    source "$REPO_ROOT/.venv/bin/activate"
    set -u
fi

# Flag-only claim critic (claim-critic.ts no-ops unless this is set).
if [ "$CRITIC" = "1" ]; then
    export MAGNOLIA_CRITIC=1
    echo "claim-critic enabled (flag-only): verdicts → projects/$PROJECT/.magnolia/claim-critic/" >&2
fi

# Exempt Kimi from the HTTP proxy when one is set. With a Clash/FlClash proxy
# (HTTPS_PROXY=127.0.0.1:7890), Kimi's auth/api traffic is forced through it
# and fails two ways: the proxy is dead when the VPN is off (Connect Timeout on
# the managed:kimi-code OAuth refresh), and even when on, Clash drops Kimi's
# long-lived streaming socket. Kimi is a directly-reachable CN edge that does
# NOT need the proxy; overseas hosts still do. Idempotent — mirrors
# start-adverum.sh. Applies to opencode, its MCP servers, and the OAuth refresh.
if [ -n "${HTTPS_PROXY:-}${https_proxy:-}${HTTP_PROXY:-}${http_proxy:-}" ]; then
  case "${NO_PROXY:-}${no_proxy:-}" in
    *kimi.com*|*127.0.0.1*|*localhost*) ;;  # already exempt
    *) export NO_PROXY="${NO_PROXY:+$NO_PROXY,}api.kimi.com,.kimi.com,127.0.0.1,localhost"
       export no_proxy="${no_proxy:+$no_proxy,}api.kimi.com,.kimi.com,127.0.0.1,localhost" ;;
  esac
fi

# Ensure the compchem-tools MCP daemon is up before opencode connects to it.
# Idempotent: returns immediately when already running. The daemon inherits
# this process's MAGNOLIA_PROJECT_DIR (exported above) for its background
# poller default. Non-fatal by design — opencode still launches if the daemon
# can't start; the MCP server will simply be unreachable until it does.
if [ -f "$SCRIPT_DIR/compchem-tools-daemon.sh" ]; then
    bash "$SCRIPT_DIR/compchem-tools-daemon.sh" start >&2 \
        || echo "warning: compchem-tools daemon failed to start — MCP tools may be unavailable" >&2
else
    echo "warning: compchem-tools-daemon.sh missing — compchem-tools MCP tools unavailable" >&2
fi

# Start the helper-agents daemon (mailbox watcher for literature/xiulian).
# Single-instance via its own flock; a second launch is a quiet no-op.
# Kill switch: MAGNOLIA_AGENTS=0. Non-fatal by design.
if [ "$MAGNOLIA_AGENTS" != "0" ] && [ -f "$SCRIPT_DIR/magnolia-agents-daemon" ]; then
    nohup python3 "$SCRIPT_DIR/magnolia-agents-daemon" \
        --root "$REPO_ROOT" >/dev/null 2>&1 &
    disown || true
fi

cd "$OPENCODE_DIR"
exec opencode

#!/usr/bin/env python3
"""magnolia-agents-daemon — mailbox watcher for the helper agents.

Two helper agents (literature, xiulian) live in their project directories.
This daemon watches their inboxes for TASK letters (`*.task.md` with a
`status: open` line); for each it runs a headless `opencode run` in that
project, then writes a reply file beside the letter and marks it done.

Started by the `magnolia` launcher. Single-instance (flock). Event-driven:
the loop only lists directories; LLM work happens once per task letter.
Kill switch: MAGNOLIA_AGENTS=0.

Design: docs/agents-daemon-design.md
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

AGENTS = ("literature", "xiulian")
AGENT_REGISTRY_NAME = "agent.json"
SCAN_INTERVAL_S = 10
TASK_TIMEOUT_S = 30 * 60
# Status lives in the LETTER HEADER (first STATUS_HEADER_LINES lines) and may
# hold any word (open/done/error/prototyped/evaluated/...). The old matcher
# (whole document, value locked to `open`) was the root cause of three
# 2026-10-08 defects: body `status: open` lines zombie-reprocessing edited
# letters, `prototyped` tickets dead-lettering (wait_for could never re-open
# them), and idea tickets force-flipped to `done` (panel verdict #1).
STATUS_HEADER_LINES = 15
_STATUS_LINE_RE = re.compile(r"^([\s>*-]*status:\s*)(\S+?)[ \t]*$", re.I)
_VALID_RID_RE = re.compile(r"[A-Za-z0-9_-]{1,128}")   # wait_for rid: path-safe charset
_TERMINAL_RUN_STATUSES = frozenset(
    {"success", "completed", "pass", "fail", "failed", "error", "cancelled"})
_TICKET_RE = re.compile(r"^ticket:[ \t]*idea[ \t]*$", re.I | re.M)
_TRAILER_STATUS_RE = re.compile(
    r"^[ \t]*ticket-status:[ \t]*([a-z_-]+)[ \t]*$", re.I | re.M)
_TRAILER_PARK_RE = re.compile(
    r"^[ \t]*park:[ \t]*job:[ \t]*([A-Za-z0-9_-]{1,128})[ \t]*$", re.I | re.M)
# A ticket answer trailer (`ticket-status:` / `park: job:<rid>`) lets a lane
# move a ticket without file permissions: the lane decides, the daemon writes.
_TICKET_TRAILER_HINT = (
    "\nTrailer contract: if this letter is an idea ticket, END your FINAL "
    "ANSWER with one or both machine lines: 'ticket-status: "
    "<open|prototyped|evaluated|accepted|rejected>' and, when you started a "
    "tracked computation, 'park: job:<run-id>'. The daemon applies them to "
    "the ticket; do not restate them anywhere else.\n")
# A ticket line `wait_for: job:<run_id>` parks the letter until the run
# record <project>/.magnolia/runs/<run_id>.yaml exists with a status; the
# daemon then re-delivers it (removes the line, appends the recorded result).
WAIT_FOR_RE = re.compile(r"^wait_for:\s*job:\s*(\S+)\s*$", re.I | re.M)

# Answer gate: the helper's LAST assistant message must begin with the
# FINAL ANSWER marker. Without an enforced contract, flash-tier models end
# their turn mid-investigation (verified 2026-09-29: three letter runs
# returned narration-only replies) and the daemon had no way to tell.
FINAL_MARKER_RE = re.compile(r"^\s*#*\s*FINAL ANSWER\s*:?", re.I | re.M)
RESUME_MAX = 2  # resume attempts before giving up
RESUME_NOTE = (
    "Your previous turn ended WITHOUT the required final answer. Do not "
    "repeat or continue the investigation. Give the complete answer to the "
    "letter right now, beginning with the line 'FINAL ANSWER:'. Keep it "
    "under 40 lines."
)


# ----------------------------------------------------------------- paths ---

def state_dir(root: str) -> Path:
    return Path(root) / ".magnolia-agents"


def state_path(root: str) -> Path:
    return state_dir(root) / "state.json"


def log_line(root: str, msg: str) -> None:
    try:
        state_dir(root).mkdir(parents=True, exist_ok=True)
        with (state_dir(root) / "daemon.log").open("a", encoding="utf-8") as fh:
            fh.write(f"{datetime.now(timezone.utc).isoformat()} {msg}\n")
    except Exception:
        pass


def load_state(root: str) -> dict:
    try:
        return json.loads(state_path(root).read_text(encoding="utf-8"))
    except Exception:
        return {"done": {}}


def save_state(root: str, state: dict) -> None:
    state_dir(root).mkdir(parents=True, exist_ok=True)
    state_path(root).write_text(json.dumps(state, indent=1) + "\n", encoding="utf-8")


# ------------------------------------------------------------ discovery ---

def _header_window(text: str) -> str:
    """The letter's header block (first STATUS_HEADER_LINES lines) — the only
    region where machine-read state (status:, ticket:) is recognized."""
    return "\n".join(text.splitlines()[:STATUS_HEADER_LINES])


def get_status(text: str) -> str | None:
    """The letter's header status value (lowercased), or None. Header-only:
    a `status:` mention in the body is content, never state."""
    for line in text.splitlines()[:STATUS_HEADER_LINES]:
        m = _STATUS_LINE_RE.match(line)
        if m:
            return m.group(2).lower()
    return None


def is_open_task(text: str) -> bool:
    return get_status(text) == "open"


def is_deferred_task(text: str) -> str | None:
    """Return the wait_for run_id when the letter is parked on a job.
    The rid is charset-validated: it is interpolated into a runs-dir path
    downstream, so anything beyond [A-Za-z0-9_-] is a malformed park, not a
    deferral (the letter then runs as a normal task — visible, not silent)."""
    m = WAIT_FOR_RE.search(text)
    if not m:
        return None
    rid = m.group(1).strip("'\"")
    return rid if _VALID_RID_RE.fullmatch(rid) else None


def discover_lanes(root: str) -> dict:
    """Lane registry: DEFAULT lanes (literature, xiulian — the current
    deployment) UNION projects declaring <project>/agent.json.

    agent.json: {enabled: bool, model: str, schedule_days: float,
    schedule_task: str}. Unknown projects become lanes; default lanes may
    override settings (e.g. xiulian's schedule). enabled:false removes a lane
    even if it is a default."""
    lanes: dict[str, dict] = {name: {} for name in AGENTS}
    proj_root = Path(root) / "opencode_cc_mem" / "projects"
    if not proj_root.is_dir():
        return lanes
    for d in sorted(proj_root.iterdir()):
        cfg_f = d / AGENT_REGISTRY_NAME
        if not cfg_f.is_file():
            continue
        try:
            cfg = json.loads(cfg_f.read_text(encoding="utf-8"))
        except Exception as e:
            log_line(root, f"[registry] bad {cfg_f}: {e}")
            continue
        if not isinstance(cfg, dict):
            continue
        if cfg.get("enabled") is False:
            lanes.pop(d.name, None)
            continue
        lanes[d.name] = cfg
    return lanes


def discover_tasks(root: str, lanes: dict | None = None) -> list[Path]:
    """All open task letters not already handled (path + content hash).
    Deferred letters (wait_for) are excluded — the job-delivery pass owns
    them. `lanes` defaults to the legacy pair for backwards compatibility."""
    lanes = lanes if lanes is not None else {name: {} for name in AGENTS}
    state = load_state(root)
    found: list[Path] = []
    for agent in lanes:
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        if not inbox.is_dir():
            continue
        for f in sorted(inbox.rglob("*.task.md")):
            try:
                text = f.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if not is_open_task(text):
                continue
            if is_deferred_task(text):
                continue  # parked on a job — the delivery pass owns it
            digest = hashlib.sha1(f.read_bytes()).hexdigest()
            if state["done"].get(str(f)) == digest:
                continue  # already handled, unchanged
            found.append(f)
    return found


# ------------------------------------------------------------- execution ---

def set_status(text: str, new_status: str) -> str:
    """Rewrite the header status line's VALUE, whatever it currently is
    (open/done/error/prototyped/evaluated/...). Returns text unchanged when
    the header carries no status line; body status mentions are never touched."""
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines[:STATUS_HEADER_LINES]):
        m = _STATUS_LINE_RE.match(line)
        if m:
            lines[i] = m.group(1) + new_status + ("\n" if line.endswith("\n") else "")
            return "".join(lines)
    return text


def _upsert_wait_for(letter: str, rid: str) -> str:
    """Drop any existing wait_for line, then insert `wait_for: job:<rid>`
    directly after the header status line."""
    body = WAIT_FOR_RE.sub("", letter)
    lines = body.splitlines(keepends=True)
    for i, line in enumerate(lines[:STATUS_HEADER_LINES]):
        if _STATUS_LINE_RE.match(line):
            lines.insert(i + 1, f"wait_for: job:{rid}\n")
            return "".join(lines)
    return letter.rstrip() + f"\n\nwait_for: job:{rid}\n"


def write_reply(task_file: Path, agent: str, body: str) -> Path:
    reply = task_file.with_name(task_file.stem.replace(".task", "") + "_reply.md")
    header = (f"# Reply: {task_file.stem}\n\n"
              f"- from: agents-daemon ({agent} helper)\n"
              f"- date: {datetime.now(timezone.utc).isoformat()}\n\n")
    reply.write_text(header + body + "\n", encoding="utf-8")
    return reply


def runs_dir(root: str) -> Path:
    return state_dir(root) / "runs"


def parse_run_events(jsonl_text: str) -> dict:
    """Parse `opencode run --format json` NDJSON events.

    Returns {"session_id", "final_text", "all_text", "n_tools"}:
    final_text = concatenated text of the LAST assistant message (parts
    grouped by messageID in event order); all_text = every text part
    (the narration trail, for the error reply when the gate fails)."""
    session_id = None
    texts: dict[str, list[str]] = {}
    order: list[str] = []
    n_tools = 0
    for line in jsonl_text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            evt = json.loads(line)
        except ValueError:
            continue
        session_id = session_id or evt.get("sessionID")
        part = evt.get("part") or {}
        if part.get("type") == "text" and part.get("text"):
            mid = part.get("messageID") or "_"
            if mid not in texts:
                order.append(mid)
                texts[mid] = []
            texts[mid].append(part["text"])
        elif part.get("type") == "tool":
            n_tools += 1
    all_text = "\n".join(t for mid in order for t in texts[mid])
    final_text = "\n".join(texts[order[-1]]) if order else ""
    return {"session_id": session_id, "final_text": final_text,
            "all_text": all_text, "n_tools": n_tools}


def is_final_answer(text: str) -> bool:
    return bool(FINAL_MARKER_RE.search(text or ""))


def _run_once(model: str, project_dir: str, env: dict, timeout_s: int,
              extra_args: list, run_log: Path | None) -> dict:
    """One headless `opencode run --model M --format json [extra_args]`.
    Returns parse_run_events output plus "rc" and "stderr_tail"; appends
    the raw events to run_log so failures stay diagnosable (the daemon
    previously discarded stderr — 2026-09-29 0-byte run was undiagnosable)."""
    proc = subprocess.run(
        ["opencode", "run", "--model", model, "--format", "json", *extra_args],
        cwd=project_dir, env=env, timeout=timeout_s,
        capture_output=True, text=True,
    )
    parsed = parse_run_events(proc.stdout or "")
    parsed["rc"] = proc.returncode
    parsed["stderr_tail"] = (proc.stderr or "")[-2000:]
    if run_log is not None:
        try:
            with run_log.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps({"_attempt": len(extra_args) and extra_args[0][:60] or "",
                                     "_rc": proc.returncode}) + "\n")
                fh.write(proc.stdout or "")
                fh.write("\n")
        except OSError:
            pass
    return parsed


def default_runner(agent: str, project_dir: str, root: str, prompt: str,
                   timeout_s: int, model: str | None = None) -> str:
    """Real headless run with the answer gate. Separate function so tests
    can stub it.

    Contract enforcement (added 2026-09-29, after three narration-only
    letter runs): the helper's LAST assistant message must begin with the
    FINAL ANSWER marker (the daemon prompt requires it). If it does not,
    the SAME session is resumed (`--session <id>` + RESUME_NOTE, "stop
    investigating, answer now") up to RESUME_MAX times. A run that never
    produces the marker raises; handle_task turns that into an error reply
    carrying the narration instead of silently treating it as done.

    --model is REQUIRED in practice: without it, `opencode run` falls back to
    the GLOBAL config's default model, which on this machine names a retired
    model (zai-coding-plan/glm-4.6) and fails with ProviderModelNotFoundError
    (found 2026-09-24, first smoke). Precedence: lane cfg `model` (agent.json,
    panel B7 — previously silently ignored) > MAGNOLIA_AGENTS_MODEL env >
    the deepseek/deepseek-flash default.

    Default deepseek/deepseek-flash = DeepSeek-V4.1-Flash on the official
    api.deepseek.com (verified live 2026-09-29); needs DEEPSEEK_API_KEY in
    the launcher env. Chosen after glm-5.3-flash ended its turn after one
    60-char message without doing the task (2026-09-29 letter test)."""
    model = model or os.environ.get("MAGNOLIA_AGENTS_MODEL",
                                    "deepseek/deepseek-flash")
    env = dict(os.environ)
    env["MAGNOLIA_ROOT"] = root
    env["MAGNOLIA_PROJECT_DIR"] = f"projects/{agent}"
    # Lane session: the lane keeps ONE session across letters — each letter
    # resumes it (`opencode run --session`), so the lane retains its ticket
    # history. First letter starts a fresh session; the resulting session id
    # is stored for the next letter.
    state = load_state(root)
    lane_sid = (state.get("lanes", {}).get(agent) or {}).get("session_id")
    try:
        runs_dir(root).mkdir(parents=True, exist_ok=True)
        run_log = runs_dir(root) / (f"{datetime.now(timezone.utc):%Y%m%d_%H%M%S}_"
                                    f"{agent}.jsonl")
    except OSError:
        run_log = None

    args: list = ([ "--session", lane_sid ] if lane_sid else []) + [prompt]
    resumed = bool(lane_sid)
    healed = False
    attempt = 0
    while True:
        attempt += 1
        parsed = _run_once(model, project_dir, env, timeout_s, args, run_log)
        if parsed.get("session_id"):
            # Lane session persistence: resume next letter in the same session.
            st = load_state(root)
            st.setdefault("lanes", {}).setdefault(agent, {})["session_id"] = parsed["session_id"]
            save_state(root, st)
        marker = is_final_answer(parsed["final_text"])
        log_line(root, f"[{agent}] attempt {attempt} rc={parsed['rc']} "
                       f"tools={parsed['n_tools']} "
                       f"marker={'yes' if marker else 'no'} model={model}")
        if parsed["rc"] != 0:
            if resumed and not healed:
                # Stale/expired stored session id bricks the lane: every
                # future letter fails on resume and the bad id is never
                # cleaned (panel A5). Self-heal once: clear the stored id and
                # retry the SAME letter in a fresh session.
                healed = True
                try:
                    st = load_state(root)
                    st.setdefault("lanes", {}).setdefault(agent, {})["session_id"] = None
                    save_state(root, st)
                except Exception:
                    pass
                log_line(root, f"[{agent}] resume failed rc={parsed['rc']} — "
                               f"stored session id cleared, retrying fresh")
                args = [prompt]
                continue
            raise RuntimeError(f"opencode run exit={parsed['rc']}: "
                               f"{parsed['stderr_tail']}")
        if marker:
            return parsed["final_text"]
        if attempt > RESUME_MAX or not parsed["session_id"]:
            break  # out of resumes, or nothing to resume (e.g. 0-byte run)
        args = ["--session", parsed["session_id"], RESUME_NOTE]
    narration = (parsed.get("all_text") or "(no output)").strip()
    raise RuntimeError(
        f"helper never produced a FINAL ANSWER after {attempt} attempt(s). "
        f"Last narration:\n\n{narration[-3000:]}")


def handle_task(task_file: Path, agent: str, root: str,
                runner=default_runner, timeout_s: int = TASK_TIMEOUT_S,
                lane_cfg: dict | None = None) -> str:
    """Run one task letter; write the reply; flip its status; update state.
    Returns 'done' or 'error' (the letter is consumed either way — a failed
    task is reported in the reply file, not retried in a loop)."""
    state = load_state(root)
    text = task_file.read_text(encoding="utf-8", errors="replace")
    project_dir = str(Path(root) / "opencode_cc_mem" / "projects" / agent)
    is_ticket = bool(_TICKET_RE.search(_header_window(text)))
    prompt = (
        f"You are the on-duty {agent} helper. A request letter arrived in "
        f"your inbox:\n\n---\n{text}\n---\n\n"
        f"Do the work it asks for. Rules: work only inside your own project "
        f"directory ({project_dir}) and the inbox folders; do NOT use the "
        f"memory tools (this letter is self-contained); do NOT try to write "
        f"or edit any files — headless runs cannot approve file-write "
        f"permissions. Instead, give your complete answer as your final "
        f"message. Answer contract: your FINAL message must BEGIN with the "
        f"line 'FINAL ANSWER:' followed by the complete answer — never end "
        f"your turn without it; if you are still investigating, keep "
        f"calling tools instead of stopping."
        + (_TICKET_TRAILER_HINT if is_ticket else "\n")
    )
    status = "done"
    body = ""
    # Per-lane model (agent.json `model`): forwarded to the runner only when
    # set, so injected test runners with the 5-arg signature keep working.
    lane_model = (lane_cfg or {}).get("model") or None
    try:
        body = runner(agent, project_dir, root, prompt, timeout_s,
                      **({"model": lane_model} if lane_model else {}))
        # The agent printed the answer (stdout IS the reply); always
        # overwrite so a re-run never leaves a stale earlier reply.
        write_reply(task_file, agent, body)
    except Exception as e:
        status = "error"
        body = f"## Task failed\n\nThe helper run raised: {e}\n\n"
        body += "To try again, set this letter's `status:` line back to `open`."
        write_reply(task_file, agent, body)

    # Ticket answers may steer the lifecycle via the reply trailer: the lane
    # decides, the daemon writes (lanes have no file permissions).
    if status == "done" and is_ticket:
        tstat = _TRAILER_STATUS_RE.search(body or "")
        park = _TRAILER_PARK_RE.search(body or "")
        new_state = tstat.group(1).lower() if tstat else None
        if park and new_state in (None, "prototyped"):
            # builder hop: park the ticket on the run; NOT done — the
            # terminal run record re-opens it for the evaluation hop.
            letter = _upsert_wait_for(set_status(text, "prototyped"),
                                      park.group(1))
            try:
                task_file.write_text(letter, encoding="utf-8")
            except Exception:
                pass
            state = load_state(root)          # runner may have saved state
            state["done"].pop(str(task_file), None)
            save_state(root, state)
            log_line(root, f"[{agent}] {task_file.name} -> prototyped "
                           f"(parked on {park.group(1)})")
            return "prototyped"
        if new_state in ("evaluated", "accepted", "rejected", "prototyped"):
            try:
                task_file.write_text(set_status(text, new_state),
                                     encoding="utf-8")
            except Exception:
                pass
            state = load_state(root)          # runner may have saved state
            state["done"][str(task_file)] = \
                hashlib.sha1(task_file.read_bytes()).hexdigest()
            save_state(root, state)
            log_line(root, f"[{agent}] {task_file.name} -> {new_state}")
            return new_state
        # missing/unknown trailer on a ticket: consumed like any letter
        # (visible in the reply file; never re-runs)

    try:
        task_file.write_text(set_status(text, status), encoding="utf-8")
    except Exception:
        pass
    # reload: the runner persists lane-session ids mid-run; the snapshot from
    # before the run must not clobber them (lost-update class, panel A7/B6)
    state = load_state(root)
    state["done"][str(task_file)] = \
        hashlib.sha1(task_file.read_bytes()).hexdigest()
    save_state(root, state)
    log_line(root, f"[{agent}] {task_file.name} -> {status}")
    return status


def scan_once(root: str, agents=AGENTS, runner=default_runner, lanes: dict | None = None) -> list[str]:
    # `agents` accepts the legacy name tuple; `lanes` (from discover_lanes)
    # is the registry path and wins when given.
    lane_map = lanes if lanes is not None else (
        agents if isinstance(agents, dict) else {a: {} for a in agents})
    results = []
    for f in discover_tasks(root, lane_map):
        agent = f.parts[f.parts.index("projects") + 1]
        result = handle_task(f, agent, root, runner,
                             lane_cfg=lane_map.get(agent))
        results.append(f"{agent}:{result}")
    return results


def deliver_wait_for(root: str, lanes: dict) -> int:
    """Re-deliver deferred tickets whose job has a recorded status.

    Parked letters (`wait_for: job:<run_id>`) stay out of the runner until the
    run record <project>/.magnolia/runs/<run_id>.yaml exists with a status
    line; the letter is then re-opened with the recorded result appended.
    Durable by design — the run record, not the transient job-notices file,
    is the source (the job-notify plugin drains that file, so watching it
    would race)."""
    delivered = 0
    for agent in lanes:
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        runs = Path(root) / "opencode_cc_mem" / "projects" / agent / ".magnolia" / "runs"
        if not inbox.is_dir():
            continue
        for f in sorted(inbox.rglob("*.task.md")):
            try:
                text = f.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            rid = is_deferred_task(text)
            if not rid:
                continue
            rec = runs / f"{rid}.yaml"
            if not rec.is_file():
                # submit_job writes date-prefixed records (YYYYMMDD_<run_id>.yaml);
                # fall back to a run-id-suffix match so wait_for fires for real
                # records (found 2026-10-08: exact-name lookup never matched).
                hits = sorted(runs.glob(f"*_{rid}.yaml")) if runs.is_dir() else []
                if not hits:
                    continue  # job still pending
                rec = hits[-1]
            try:
                status_m = re.search(r"^status:\s*(\S+)",
                                     rec.read_text(encoding="utf-8", errors="replace"), re.M)
            except OSError:
                continue
            result = status_m.group(1) if status_m else "unknown"
            if result not in _TERMINAL_RUN_STATUSES:
                # running/pending — submit_job writes the record at SUBMISSION
                # time; delivering here would burn the single hop on a job
                # that has not finished (panel verdict #2)
                continue
            new_text = WAIT_FOR_RE.sub("", text) + (
                f"\n\n## Job result ({rid})\n\n- status: {result}\n- record: {rec}\n")
            new_text = set_status(new_text, "open")
            try:
                f.write_text(new_text, encoding="utf-8")
                log_line(root, f"[{agent}] wait_for delivered: {rid} -> {f.name}")
                delivered += 1
            except OSError:
                pass
    return delivered


def scheduled_sweep_letters(root: str, lanes: dict) -> int:
    """Write the sweep letter for lanes whose schedule is due.

    Lane cfg: schedule_days (float) + schedule_task (the request text).
    State tracks the last send per lane; a lane never-swept is due at once
    (registration starts the cadence)."""
    sent = 0
    state = load_state(root)
    swept = state.setdefault("swept", {})
    now = datetime.now(timezone.utc)
    for agent, cfg in sorted(lanes.items()):
        days = cfg.get("schedule_days")
        task_text = cfg.get("schedule_task")
        if not days or not task_text:
            continue
        try:
            days = float(days)
        except (TypeError, ValueError):
            continue
        last = swept.get(agent)
        if last:
            try:
                if (now - datetime.fromisoformat(str(last))).total_seconds() < days * 86400:
                    continue
            except ValueError:
                pass
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        if not inbox.is_dir():
            continue
        letter = inbox / f"{now:%Y-%m-%d}_{agent}-scheduled-sweep.task.md"
        if letter.exists():
            swept[agent] = now.isoformat()  # already sent today — no duplicate
            save_state(root, state)
            continue
        try:
            letter.write_text(
                f"# Scheduled sweep ({agent})\n\n- from: agents-daemon\n"
                f"- date: {now:%Y-%m-%d}\n- status: open\n\n## Request\n\n"
                f"{task_text}\n", encoding="utf-8")
            swept[agent] = now.isoformat()
            save_state(root, state)
            log_line(root, f"[{agent}] scheduled sweep letter written")
            sent += 1
        except OSError:
            pass
    return sent

_LOCK_FH = None  # module-level: if the file object is garbage-collected, the
                 # descriptor closes and the flock is silently released.


def acquire_lock(root: str) -> int | None:
    global _LOCK_FH
    state_dir(root).mkdir(parents=True, exist_ok=True)
    fh = (state_dir(root) / "daemon.lock").open("w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    fh.write(str(os.getpid()))
    fh.flush()
    _LOCK_FH = fh
    return fh.fileno()  # keep the fd open: the lock lives as long as we do


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="magnolia-agents-daemon")
    ap.add_argument("--root", default=os.environ.get("MAGNOLIA_ROOT") or os.getcwd())
    ap.add_argument("--once", action="store_true", help="one scan, no loop")
    ap.add_argument("--force", action="store_true",
                    help="skip the singleton lock — deliberate concurrent scan "
                         "(--once now LOCKS by default: two runners resuming one "
                         "lane session corrupt state.json, panel B8)")
    ap.add_argument("--interval", type=int, default=SCAN_INTERVAL_S)
    args = ap.parse_args(argv)
    if os.environ.get("MAGNOLIA_AGENTS", "") == "0":
        print("agents daemon disabled (MAGNOLIA_AGENTS=0)")
        return 0
    if acquire_lock(args.root) is None and not args.force:
        print("agents daemon already running")
        return 0
    log_line(args.root, f"daemon start (pid={os.getpid()}, once={args.once})")
    while True:
        try:
            lanes = discover_lanes(args.root)
            scheduled_sweep_letters(args.root, lanes)   # due schedules -> letters
            deliver_wait_for(args.root, lanes)          # job landed -> reopen ticket
            for r in scan_once(args.root, lanes=lanes):
                print(r, flush=True)
        except Exception as e:
            log_line(args.root, f"scan error: {e}")
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    raise SystemExit(main())

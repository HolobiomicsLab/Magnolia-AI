#!/usr/bin/env python3
"""magnolia-agents-daemon — mailbox watcher for registered helper lanes.

This daemon watches registered project inboxes for TASK letters (`*.task.md` with a
`status: open` line); for each it runs a headless `opencode run` in that
project, then writes a reply file beside the letter and marks it done.

Started by the `magnolia` launcher. Single-instance (flock). Event-driven:
the loop only lists directories; LLM work happens once per task letter.
Kill switch: MAGNOLIA_AGENTS=0.

Design: docs/agents-daemon-design.md
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid
from dataclasses import asdict, replace
from datetime import datetime, timezone
from pathlib import Path

_INSTALLATION_ROOT = Path(__file__).resolve().parents[2]
sys.path[:0] = [
    str(_INSTALLATION_ROOT),
    str(_INSTALLATION_ROOT / "mcp-servers" / "compchem-memory" / "src"),
    str(_INSTALLATION_ROOT / "mcp-servers" / "compchem-tools" / "src"),
]

from campaign_runner.helper_admission import (  # noqa: E402
    AdmittedLetter,
    AdmissionRefused,
    admit_letter,
    consume_generation_receipt,
    write_generation_receipt,
    write_scheduled_letter,
)

AGENTS: tuple[str, ...] = ()
AGENT_REGISTRY_NAME = "agent.json"
SCAN_INTERVAL_S = 10
TASK_TIMEOUT_S = 30 * 60
# Status lives in the LETTER HEADER (first STATUS_HEADER_LINES lines) and may
# hold any word (open/done/error/prototyped/evaluated/...). The old matcher
# (whole document, value locked to `open`) was the root cause of three
# 2026-10-08 defects: body `status: open` lines zombie-reprocessing edited
# letters, `prototyped` tickets dead-lettering (wait_for could never re-open
# them), and idea tickets force-flipped to `done` (panel verdict #1).
STATUS_HEADER_LINES = 15
_STATUS_LINE_RE = re.compile(r"^([\s>*-]*status:\s*)(\S+?)[ \t]*$", re.I)
_VALID_RID_RE = re.compile(r"[A-Za-z0-9_-]{1,128}")   # wait_for rid: path-safe charset
SAFE_LANE_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")
_TERMINAL_RUN_STATUSES = frozenset(
    {"success", "completed", "pass", "fail", "failed", "error", "cancelled"})
_TICKET_RE = re.compile(r"^ticket:[ \t]*idea[ \t]*$", re.I | re.M)
_TRAILER_STATUS_RE = re.compile(
    r"^[ \t]*ticket-status:[ \t]*([a-z_-]+)[ \t]*$", re.I | re.M)
_TRAILER_PARK_RE = re.compile(
    r"^[ \t]*park:[ \t]*job:[ \t]*([A-Za-z0-9_-]{1,128})[ \t]*$", re.I | re.M)
# A ticket answer trailer (`ticket-status:` / `park: job:<rid>`) lets a lane
# move a ticket without file permissions: the lane decides, the daemon writes.
_TICKET_TRAILER_HINT = (
    "\nTrailer contract: if this letter is an idea ticket, END your FINAL "
    "ANSWER with one or both machine lines: 'ticket-status: "
    "<open|prototyped|evaluated|accepted|rejected>' and, when you started a "
    "tracked computation, 'park: job:<run-id>'. The daemon applies them to "
    "the ticket; do not restate them anywhere else.\n")
# A ticket line `wait_for: job:<run_id>` parks the letter until the run
# record <project>/.magnolia/runs/<run_id>.yaml exists with a status; the
# daemon then re-delivers it (removes the line, appends the recorded result).
WAIT_FOR_RE = re.compile(r"^wait_for:\s*job:\s*(\S+)\s*$", re.I | re.M)

# Answer gate: the helper's LAST assistant message must begin with the
# FINAL ANSWER marker. Without an enforced contract, flash-tier models end
# their turn mid-investigation (verified 2026-09-29: three letter runs
# returned narration-only replies) and the daemon had no way to tell.
FINAL_MARKER_RE = re.compile(r"^\s*#*\s*FINAL ANSWER\s*:?", re.I | re.M)
RESUME_MAX = 2  # resume attempts before giving up
RESUME_NOTE = (
    "Your previous turn ended WITHOUT the required final answer. Do not "
    "repeat or continue the investigation. Give the complete answer to the "
    "letter right now, beginning with the line 'FINAL ANSWER:'. Keep it "
    "under 40 lines."
)


class HelperQuotaWaiting(RuntimeError):
    """A helper letter must remain pending behind a durable quota hold."""

    def __init__(
        self,
        key: str,
        hold_id: str | None,
        reset_at: datetime | None,
        reason: str,
    ) -> None:
        self.key = key
        self.hold_id = hold_id
        self.reset_at = reset_at
        self.reason = reason
        super().__init__(reason)


# ----------------------------------------------------------------- paths ---

def state_dir(root: str) -> Path:
    return Path(root) / ".magnolia-agents"


def state_path(root: str) -> Path:
    return state_dir(root) / "state.json"


def log_line(root: str, msg: str) -> None:
    try:
        state_dir(root).mkdir(parents=True, exist_ok=True)
        with (state_dir(root) / "daemon.log").open("a", encoding="utf-8") as fh:
            fh.write(f"{datetime.now(timezone.utc).isoformat()} {msg}\n")
    except Exception:
        pass


def load_state(root: str) -> dict:
    try:
        return json.loads(state_path(root).read_text(encoding="utf-8"))
    except Exception:
        return {"done": {}}


def save_state(root: str, state: dict) -> None:
    state_dir(root).mkdir(parents=True, exist_ok=True)
    state_path(root).write_text(json.dumps(state, indent=1) + "\n", encoding="utf-8")


# ------------------------------------------------------------ discovery ---

def _header_window(text: str) -> str:
    """The letter's header block (first STATUS_HEADER_LINES lines) — the only
    region where machine-read state (status:, ticket:) is recognized."""
    return "\n".join(text.splitlines()[:STATUS_HEADER_LINES])


def get_status(text: str) -> str | None:
    """The letter's header status value (lowercased), or None. Header-only:
    a `status:` mention in the body is content, never state."""
    for line in text.splitlines()[:STATUS_HEADER_LINES]:
        m = _STATUS_LINE_RE.match(line)
        if m:
            return m.group(2).lower()
    return None


def is_open_task(text: str) -> bool:
    return get_status(text) == "open"


def is_deferred_task(text: str) -> str | None:
    """Return the wait_for run_id when the letter is parked on a job.
    The rid is charset-validated: it is interpolated into a runs-dir path
    downstream, so anything beyond [A-Za-z0-9_-] is a malformed park, not a
    deferral (the letter then runs as a normal task — visible, not silent)."""
    m = WAIT_FOR_RE.search(text)
    if not m:
        return None
    rid = m.group(1).strip("'\"")
    return rid if _VALID_RID_RE.fullmatch(rid) else None


def discover_lanes(root: str) -> dict:
    """Return canonical project lanes declaring a safe ``agent.json``.

    agent.json: {enabled: bool, model: str, schedule_days: float,
    schedule_task: str}. ``enabled:false`` removes the lane. Legacy configured
    names without a project registration are intentionally not admitted."""
    lanes: dict[str, dict] = {}
    proj_root = Path(root) / "opencode_cc_mem" / "projects"
    if not proj_root.is_dir():
        return lanes
    for d in sorted(proj_root.iterdir()):
        if d.is_symlink() or not d.is_dir() or SAFE_LANE_RE.fullmatch(d.name) is None:
            continue
        cfg_f = d / AGENT_REGISTRY_NAME
        if cfg_f.is_symlink() or not cfg_f.is_file():
            continue
        try:
            cfg = json.loads(cfg_f.read_text(encoding="utf-8"))
        except Exception as e:
            log_line(root, f"[registry] bad {cfg_f}: {e}")
            continue
        if not isinstance(cfg, dict):
            continue
        if cfg.get("enabled") is False:
            lanes.pop(d.name, None)
            continue
        lanes[d.name] = cfg
    configured = set(filter(None, re.split(r"[,\s]+", os.environ.get(
        "MAGNOLIA_AGENTD_AGENTS", ""
    ))))
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    lane_file = config_home / "magnolia" / "agents-daemon-lanes.txt"
    try:
        configured.update(
            line.strip() for line in lane_file.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )
    except OSError:
        pass
    for name in sorted(configured):
        if SAFE_LANE_RE.fullmatch(name) is None:
            log_line(root, f"[registry] configured lane has unsafe name: {name!r}")
            continue
        if name not in lanes:
            log_line(root, f"[registry] configured lane {name!r} has no enabled agent.json")
    return lanes


def _letter_digest(letter: AdmittedLetter) -> str:
    """Return a durable digest for one already-admitted regular letter."""
    return letter.digest()


def _quota_wait_is_active(root: str, letter: AdmittedLetter) -> bool:
    """Keep an unchanged letter parked until its known reset has passed."""
    state = load_state(root)
    waits = state.setdefault("quota_waits", {})
    key = str(letter.letter)
    wait = waits.get(key)
    if not isinstance(wait, dict):
        return False
    try:
        unchanged = wait.get("letter_digest") == _letter_digest(letter)
    except (OSError, AdmissionRefused):
        unchanged = False
    reset = wait.get("reset_at")
    due = False
    if reset:
        try:
            due = datetime.fromisoformat(str(reset)) <= datetime.now(timezone.utc)
        except (TypeError, ValueError):
            due = False
    if unchanged and not due:
        return True
    waits.pop(key, None)
    save_state(root, state)
    return False


def resume_quota_waits(root: str, lane: str | None = None) -> int:
    """Clear matching daemon waits and their observed governor generations."""
    from campaign_runner.governor import Governor

    state = load_state(root)
    waits = state.setdefault("quota_waits", {})
    governor = Governor()
    removed = 0
    for key, wait in tuple(waits.items()):
        if lane is not None and isinstance(wait, dict) and wait.get("lane") != lane:
            continue
        if isinstance(wait, dict) and wait.get("subscription_key") and wait.get("hold_id"):
            governor.resume_key(
                str(wait["subscription_key"]), expected_hold=str(wait["hold_id"])
            )
        del waits[key]
        removed += 1
    if removed:
        save_state(root, state)
    return removed


def request_quota_resume(root: str, lane: str | None) -> Path:
    """Queue a durable control request for the singleton daemon."""
    requests = state_dir(root) / "quota-resume-requests"
    requests.mkdir(parents=True, exist_ok=True)
    request = requests / f"{uuid.uuid4().hex}.json"
    with request.open("x", encoding="utf-8") as handle:
        json.dump({"lane": lane, "requested_at": datetime.now(timezone.utc).isoformat()}, handle)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    return request


def apply_quota_resume_requests(root: str) -> int:
    """Consume queued resume requests inside the running daemon loop."""
    requests = state_dir(root) / "quota-resume-requests"
    cleared = 0
    if not requests.is_dir():
        return cleared
    for request in sorted(requests.glob("*.json")):
        try:
            payload = json.loads(request.read_text(encoding="utf-8"))
            lane = payload.get("lane") if isinstance(payload, dict) else None
            if lane is not None and SAFE_LANE_RE.fullmatch(str(lane)) is None:
                raise ValueError("unsafe lane")
            cleared += resume_quota_waits(root, str(lane) if lane else None)
            request.unlink()
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            log_line(root, f"[quota] invalid resume request {request.name}: {exc}")
    return cleared


def _refusal_signature(letter: Path) -> dict[str, int] | None:
    """Return non-following file metadata sufficient to suppress hot retries."""
    try:
        details = letter.lstat()
    except OSError:
        return None
    return {
        "device": details.st_dev,
        "inode": details.st_ino,
        "size": details.st_size,
        "mtime_ns": details.st_mtime_ns,
    }


def _refusal_is_current(root: str, letter: Path) -> bool:
    """Skip one unchanged rejected path without reading its body."""
    state = load_state(root)
    refusals = state.setdefault("refusals", {})
    key = os.path.abspath(os.fspath(letter))
    refusal = refusals.get(key)
    if not isinstance(refusal, dict):
        return False
    if refusal.get("signature") == _refusal_signature(letter):
        return True
    refusals.pop(key, None)
    save_state(root, state)
    return False


def _mark_admission_refusal(root: str, lane: str, refusal: AdmissionRefused) -> None:
    """Record a refusal without writing beside a letter that failed admission."""
    letter = refusal.letter
    if letter is not None:
        state = load_state(root)
        state.setdefault("refusals", {})[
            os.path.abspath(os.fspath(letter))
        ] = {
            "lane": lane,
            "reason": refusal.reason,
            "signature": _refusal_signature(letter),
            "recorded_at": datetime.now(timezone.utc).isoformat(),
        }
        save_state(root, state)
    shown = letter.name if letter is not None else "unresolved letter"
    log_line(root, f"[{lane}] {shown} -> refused ({refusal.reason})")


def discover_tasks(root: str, lanes: dict | None = None) -> list[Path]:
    """All open task letters not already handled (path + content hash).
    Deferred letters (wait_for) are excluded — the job-delivery pass owns
    them. `lanes` defaults to the legacy pair for backwards compatibility."""
    lanes = lanes if lanes is not None else discover_lanes(root)
    state = load_state(root)
    found: list[Path] = []
    for agent in lanes:
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        if not inbox.is_dir():
            continue
        if inbox.is_symlink():
            log_line(root, f"[{agent}] inbox symlink refused")
            continue
        for f in sorted(inbox.rglob("*.task.md")):
            if _refusal_is_current(root, f):
                continue
            try:
                admitted = admit_letter(root, agent, f)
            except AdmissionRefused as exc:
                _mark_admission_refusal(root, agent, exc)
                continue
            try:
                text = admitted.read_text()
                if not is_open_task(text):
                    continue
                if admitted.is_scheduled and admitted.generation_consumed:
                    log_line(root, f"[{agent}] {f.name} -> refused (generation consumed)")
                    continue
                if is_deferred_task(text):
                    continue  # parked on a job — the delivery pass owns it
                if _quota_wait_is_active(root, admitted):
                    continue
                digest = hashlib.sha1(text.encode()).hexdigest()
                if state["done"].get(str(f)) == digest:
                    continue  # already handled, unchanged
                found.append(f)
            finally:
                admitted.close()
    return found


# ------------------------------------------------------------- execution ---

def set_status(text: str, new_status: str) -> str:
    """Rewrite the header status line's VALUE, whatever it currently is
    (open/done/error/prototyped/evaluated/...). Returns text unchanged when
    the header carries no status line; body status mentions are never touched."""
    lines = text.splitlines(keepends=True)
    for i, line in enumerate(lines[:STATUS_HEADER_LINES]):
        m = _STATUS_LINE_RE.match(line)
        if m:
            lines[i] = m.group(1) + new_status + ("\n" if line.endswith("\n") else "")
            return "".join(lines)
    return text


def _upsert_wait_for(letter: str, rid: str) -> str:
    """Drop any existing wait_for line, then insert `wait_for: job:<rid>`
    directly after the header status line."""
    body = WAIT_FOR_RE.sub("", letter)
    lines = body.splitlines(keepends=True)
    for i, line in enumerate(lines[:STATUS_HEADER_LINES]):
        if _STATUS_LINE_RE.match(line):
            lines.insert(i + 1, f"wait_for: job:{rid}\n")
            return "".join(lines)
    return letter.rstrip() + f"\n\nwait_for: job:{rid}\n"


def write_reply(
    task: AdmittedLetter,
    agent: str,
    body: str,
    *,
    replace_existing: bool = True,
) -> Path:
    header = (f"# Reply: {task.letter.stem}\n\n"
              f"- from: agents-daemon ({agent} helper)\n"
              f"- date: {datetime.now(timezone.utc).isoformat()}\n\n")
    return task.write_reply(
        header + body + "\n", replace_existing=replace_existing
    )


def runs_dir(root: str) -> Path:
    return state_dir(root) / "runs"


def parse_run_events(jsonl_text: str) -> dict:
    """Parse `opencode run --format json` NDJSON events.

    Returns {"session_id", "final_text", "all_text", "n_tools"}:
    final_text = concatenated text of the LAST assistant message (parts
    grouped by messageID in event order); all_text = every text part
    (the narration trail, for the error reply when the gate fails)."""
    session_id = None
    texts: dict[str, list[str]] = {}
    order: list[str] = []
    n_tools = 0
    for line in jsonl_text.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            evt = json.loads(line)
        except ValueError:
            continue
        session_id = session_id or evt.get("sessionID")
        part = evt.get("part") or {}
        if part.get("type") == "text" and part.get("text"):
            mid = part.get("messageID") or "_"
            if mid not in texts:
                order.append(mid)
                texts[mid] = []
            texts[mid].append(part["text"])
        elif part.get("type") == "tool":
            n_tools += 1
    all_text = "\n".join(t for mid in order for t in texts[mid])
    final_text = "\n".join(texts[order[-1]]) if order else ""
    return {"session_id": session_id, "final_text": final_text,
            "all_text": all_text, "n_tools": n_tools}


def is_final_answer(text: str) -> bool:
    return bool(FINAL_MARKER_RE.search(text or ""))


def _run_once(model: str, project_dir: str, env: dict, timeout_s: int,
              extra_args: list, run_log: Path | None, binary: str = "opencode",
              governance=None, resolved_route=None) -> dict:
    """One headless `opencode run --model M --format json [extra_args]`.
    Returns parse_run_events output plus "rc" and "stderr_tail"; appends
    the raw events to run_log so failures stay diagnosable (the daemon
    previously discarded stderr — 2026-09-29 0-byte run was undiagnosable)."""
    from campaign_runner.executors.contracts import ExecContext
    from campaign_runner.executors.opencode import OpenCodeHelperExecutor
    from campaign_runner.executors.registry import executor_for
    from campaign_runner.routing import resolve_route

    route = resolved_route or resolve_route(
        "helper", {"agent": {"json": {"model": model}}}
    )
    helper_environment = {**env, "MAGNOLIA_DOORBELL": "0"}
    executor = executor_for(
        route,
        "helper",
        ExecContext(
            route=route,
            role="helper",
            project_dir=Path(project_dir),
            timeout_seconds=timeout_s,
            role_cap=governance.role_cap if governance is not None else 40,
            governor_cap=(
                governance.governor.policy.max_turns_per_run
                if governance is not None
                else None
            ),
            opencode_binary=binary,
            environment=helper_environment,
        ),
    )
    if not isinstance(executor, OpenCodeHelperExecutor):
        raise RuntimeError("OpenCode helper route resolved to an incompatible executor")
    if governance is None:
        proc = executor.run(
            extra_args,
            cwd=project_dir,
            environment=helper_environment,
            timeout_seconds=timeout_s,
        )
        stdout = proc.stdout or ""
        stderr = proc.stderr or ""
        returncode = proc.returncode
        outcome = None
    else:
        from campaign_runner.executors.contracts import LimitInfo, RunOutcome
        from campaign_runner.governor import Admission, AdmissionRequest, QuotaWaiting
        from campaign_runner.process import run_process
        from campaign_runner.workers import _invocation_control

        request = AdmissionRequest(
            route=governance.route,
            invocation_id=f"{governance.parent_run_id}:{uuid.uuid4().hex}",
            parent_run_id=governance.parent_run_id,
            project_digest=governance.project_digest,
            run_kind="helper",
            role_cap=governance.role_cap,
        )
        while True:
            admission = governance.governor.admit(request)
            if isinstance(admission, Admission):
                break
            if admission.reason in {"quota", "daily_limit", "cancelled"}:
                limit = LimitInfo(
                    admission.reason,
                    admission.reset_at,
                    "usage governor",
                    admission.hold_id,
                )
                return {
                    "session_id": None,
                    "final_text": "",
                    "all_text": "",
                    "n_tools": 0,
                    "rc": 0,
                    "stderr_tail": "",
                    "outcome": RunOutcome("quota", limit),
                }
            if not governance.governor.wait(admission):
                return {
                    "session_id": None,
                    "final_text": "",
                    "all_text": "",
                    "n_tools": 0,
                    "rc": 1,
                    "stderr_tail": "usage admission cancelled",
                    "outcome": RunOutcome("cancelled"),
                }
        attempt_dir = (run_log.parent if run_log else state_dir(env["MAGNOLIA_ROOT"]))
        stdout_path = attempt_dir / f"opencode-{uuid.uuid4().hex}.jsonl"
        stderr_path = attempt_dir / f"opencode-{uuid.uuid4().hex}.err.log"
        with admission:
            executor = replace(
                executor,
                role_cap=governance.role_cap,
                governor_cap=admission.effective_cap,
            )
            process = run_process(
                executor.argv(extra_args),
                project_dir,
                executor.environment_with_cap(helper_environment),
                timeout_s,
                stdout_path,
                stderr_path,
                _invocation_control(None, admission),
            )
            stdout = stdout_path.read_text(encoding="utf-8", errors="replace")
            stderr = stderr_path.read_text(encoding="utf-8", errors="replace")
            returncode = process.returncode
            quota_outcome = _text_quota_outcome(stdout, stderr, returncode)
            outcome = quota_outcome or process.outcome
            if outcome is None:
                outcome = RunOutcome("success" if returncode == 0 else "failure")
            if process.client_started:
                admission.release(outcome=outcome)
            else:
                admission._cancel_before_client_exec()
    parsed = parse_run_events(stdout)
    parsed["rc"] = returncode
    parsed["stderr_tail"] = stderr[-2000:]
    if outcome is not None:
        parsed["outcome"] = outcome
    if run_log is not None:
        try:
            with run_log.open("a", encoding="utf-8") as fh:
                fh.write(json.dumps({"_attempt": len(extra_args) and extra_args[0][:60] or "",
                                     "_rc": returncode}) + "\n")
                fh.write(stdout)
                fh.write("\n")
        except OSError:
            pass
    return parsed


def _text_quota_outcome(stdout: str, stderr: str, returncode: int):
    """Recognize explicit terminal quota signals without matching normal prose."""
    from campaign_runner.executors.contracts import LimitInfo, RunOutcome

    if returncode == 0:
        return None
    text = stderr.lower()
    signals = (
        "rate_limit",
        "rate limit",
        "session limit",
        "weekly limit",
        "billing_error",
        "quota exceeded",
    )
    if any(signal in text for signal in signals):
        return RunOutcome("quota", LimitInfo("client quota", None, "client stderr"))
    for line in stdout.splitlines():
        try:
            event = json.loads(line)
        except (TypeError, ValueError):
            continue
        outcome = _event_quota_outcome(event)
        if outcome is not None:
            return outcome
    return None


def _event_quota_outcome(event):
    """Detect documented quota terms only on terminal client event shapes."""
    from campaign_runner.executors.contracts import LimitInfo, RunOutcome

    if not isinstance(event, dict):
        return None
    event_type = str(event.get("type", "")).casefold()
    subtype = str(event.get("subtype", "")).casefold()
    is_error = event.get("is_error") is True
    is_failure = event_type in {"error", "turn.failed"}
    is_failure = is_failure or (
        event_type == "result" and (is_error or subtype not in {"", "success"})
    )
    if not is_failure:
        return None
    diagnostics = {
        key: event.get(key)
        for key in (
            "type", "subtype", "error", "errors", "message", "code", "result",
        )
        if event.get(key) is not None
    }
    text = json.dumps(diagnostics, sort_keys=True).casefold()
    if not any(
        signal in text
        for signal in (
            "rate_limit",
            "rate limit",
            "session limit",
            "weekly limit",
            "billing_error",
            "quota exceeded",
        )
    ):
        return None
    return RunOutcome("quota", LimitInfo("client quota", None, "client event"))


def _opencode_bin() -> str:
    """v2 mode (MAGNOLIA_OPENCODE_V2=1): the pinned v2 binary + its own DB.
    This switch lives on the v2 branch only (exp/opencode-v2);
    exp/distill-admission is the pure-v1 lane."""
    if os.environ.get("MAGNOLIA_OPENCODE_V2", "").lower() in ("1", "true", "yes", "on"):
        return os.environ.get(
            "MAGNOLIA_OPENCODE_V2_BIN",
            str(Path.home() / ".local/share/magnolia-v2/bin/opencode"))
    return "opencode"


def _tools_port(agent: str, root: str) -> int:
    """Same deterministic per-project port as the magnolia wrapper.

    Base: master v1 8001, non-master v1 8101, v2 8201. Hash is POSIX cksum so
    the daemon's port matches the interactive launcher's port.
    """
    try:
        branch = subprocess.run(
            ["git", "-C", root, "rev-parse", "--abbrev-ref", "HEAD"],
            capture_output=True, text=True, timeout=10,
        ).stdout.strip() or "master"
    except Exception:
        branch = "master"
    base = 8001 if branch == "master" else 8101
    if _opencode_bin() != "opencode":
        base = 8201
    out = subprocess.run(
        ["cksum"], input=agent.encode(), stdout=subprocess.PIPE, check=True,
    ).stdout.decode().split()[0]
    return base + int(out) % 90


def _render_project_config(root: str, agent: str) -> None:
    """Render projects/<agent>/opencode.json from the workspace template.

    The lane daemon runs opencode with cwd = the project directory, so the
    config must live there. Rendering is idempotent and never touches the
    shared workspace config or the workspace .active-project marker.
    """
    opencode_dir = Path(root) / "opencode_cc_mem"
    template_path = opencode_dir / "opencode.json.template"
    if not template_path.exists():
        return
    project_dir = opencode_dir / "projects" / agent
    setup = {}
    setup_path = opencode_dir / ".magnolia" / "llm-setup.json"
    if setup_path.exists():
        try:
            setup = json.loads(setup_path.read_text())
        except Exception:
            setup = {}
    mem_on = bool(setup.get("memory_enabled")) and bool(setup.get("memory_model"))
    text = (
        template_path.read_text()
        .replace("@@PROJECT@@", agent)
        .replace("@@MAGNOLIA_ROOT@@", root)
        .replace("@@PYTHON@@", str(Path(root) / ".venv" / "bin" / "python3"))
        .replace("@@MEMORY_ENABLED@@", "true" if mem_on else "false")
        .replace("@@COMPCHEM_TOOLS_PORT@@", str(_tools_port(agent, root)))
    )
    cfg = json.loads(text)
    if setup.get("main_model"):
        cfg["model"] = setup["main_model"]
    if mem_on:
        env = cfg["mcp"]["compchem-memory"].setdefault("environment", {})
        env["MAGNOLIA_MEMORY_MODEL"] = setup["memory_model"]
        if setup.get("memory_provider"):
            env["MAGNOLIA_MEMORY_PROVIDER"] = setup["memory_provider"]
    if _opencode_bin() != "opencode":
        servers = {}
        for name, server in cfg.pop("mcp", {}).items():
            server = dict(server)
            if "enabled" in server:
                server["disabled"] = not server.pop("enabled")
            if isinstance(server.get("timeout"), int):
                t = server["timeout"]
                server["timeout"] = {"startup": t, "catalog": t, "execution": t}
            servers[name] = server
        cfg["mcp"] = {"servers": servers}
        cfg.pop("plugin", None)
        cfg.pop("instructions", None)
        perms = []
        ext = (cfg.pop("permission", {}) or {}).get("external_directory", {})
        for pattern, verdict in ext.items():
            if verdict == "allow":
                perms.append({"action": "edit", "resource": pattern, "effect": "allow"})
        tools = cfg.pop("tools", {}) or {}
        if tools.get("bash") is False:
            perms.append({"action": "shell", "resource": "*", "effect": "deny"})
        if perms:
            cfg["permissions"] = perms
    else:
        # v1 project-root launch: absolute instructions, otherwise the
        # template's projects/<agent> prefix would point inside the project.
        cfg["instructions"] = [
            str(Path(root) / "opencode_cc_mem" / "rules" / "*.md"),
            str(Path(root) / "opencode_cc_mem" / "AGENTS.md"),
            str(project_dir / ".magnolia" / "boot-context.md"),
            str(project_dir / ".magnolia" / "audit-report.md"),
        ]
    (project_dir / ".magnolia").mkdir(parents=True, exist_ok=True)
    (project_dir / ".magnolia" / ".active-project").write_text(agent)
    (project_dir / "opencode.json").write_text(json.dumps(cfg, indent=2) + "\n")


def _ensure_tools_daemon(root: str, env: dict) -> None:
    """Start the per-project compchem-tools daemon if it is not already up."""
    script = Path(root) / "opencode_cc_mem" / "softwares" / "bin" / "compchem-tools-daemon.sh"
    if not script.exists():
        return
    try:
        subprocess.run(
            ["bash", str(script), "start"], env=env, timeout=60,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )
    except Exception:
        pass


def _lane_config(project_dir: str | Path) -> dict:
    """Load one lane's registry mapping without accepting non-object JSON."""
    path = Path(project_dir) / AGENT_REGISTRY_NAME
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def _setup_config(root: str) -> dict:
    """Load checkout-local route and client setup for helper execution."""
    path = Path(root) / "opencode_cc_mem" / ".magnolia" / "llm-setup.json"
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def _project_digest(project_dir: str | Path) -> str:
    """Return the canonical project identity used by executor sessions."""
    return hashlib.sha256(str(Path(project_dir).resolve()).encode()).hexdigest()


def _resolve_helper_route(root: str, project_dir: str, model: str | None):
    """Resolve the helper route from lane, role, and global setup precedence."""
    from campaign_runner.routing import resolve_route

    setup = _setup_config(root)
    lane = _lane_config(project_dir)
    if model:
        lane = {**lane, "model": model}
    return resolve_route(
        "helper",
        {
            "agent": {"json": lane},
            "routes": setup.get("routes", {}),
            "harness": setup.get("harness"),
            "main_model": setup.get("main_model"),
            "models": setup.get("models", {}),
        },
    )


def _client_binary(route) -> str:
    """Resolve the selected native client without adding trust bypasses."""
    configured = {
        "claude-code": os.environ.get("MAGNOLIA_CLAUDE_BIN", "claude"),
        "codex": os.environ.get("MAGNOLIA_CODEX_BIN", "codex"),
        "vibe": os.environ.get("MAGNOLIA_VIBE_BIN", "vibe"),
    }[route.client]
    found = shutil.which(configured)
    return str(Path(found).resolve()) if found else configured


def _role_capabilities():
    """Load capability evidence and turn an invalid snapshot into refusal."""
    from campaign_runner.executors.capabilities import (
        CapabilityTableError,
        load_role_capabilities,
    )
    from campaign_runner.executors.registry import ExecutorRefused

    try:
        return load_role_capabilities()
    except CapabilityTableError as exc:
        raise ExecutorRefused(f"helper capability evidence is unavailable: {exc}") from exc


def _build_helper_context(
    route,
    agent: str,
    project_dir: str,
    root: str,
    timeout_s: int,
):
    """Build one registry context with capability and governor evidence."""
    from campaign_runner.executors.contracts import ExecContext
    from campaign_runner.governor import Governor
    from campaign_runner.launch import resolve_python
    from campaign_runner.workers import InvocationGovernance

    project = Path(project_dir).resolve()
    lane = _lane_config(project)
    requested = lane.get("required_capabilities", [])
    if not isinstance(requested, list) or any(
        not isinstance(item, str) or not item for item in requested
    ):
        requested = ["invalid-required-capabilities"]
    role_cap = lane.get("max_turns", 40)
    if isinstance(role_cap, bool) or not isinstance(role_cap, int) or role_cap < 1:
        role_cap = 40
    run_dir = state_dir(root) / "helper-runs" / agent
    control_dir = run_dir / "control"
    work_dir = run_dir / "work"
    control_dir.mkdir(parents=True, exist_ok=True)
    work_dir.mkdir(parents=True, exist_ok=True)
    environment = dict(os.environ)
    environment.update(
        MAGNOLIA_ROOT=root,
        MAGNOLIA_PROJECT_DIR=str(project),
        MAGNOLIA_WORKSPACE_ROOT=str(project.parent),
    )
    setup = _setup_config(root)
    python = resolve_python(_INSTALLATION_ROOT, environment)
    governor = Governor()
    project_identity = _project_digest(project)
    governance = InvocationGovernance(
        governor,
        route,
        f"helper:{agent}:{uuid.uuid4().hex}",
        project_identity,
        role_cap=role_cap,
    )
    read_roots = (project / "docs",) if "native_read" in requested else ()
    return ExecContext(
        route=route,
        role="helper",
        project_dir=project,
        run_dir=run_dir,
        control_dir=control_dir,
        work_dir=work_dir,
        timeout_seconds=timeout_s,
        role_cap=role_cap,
        governor_cap=governor.policy.max_turns_per_run,
        opencode_binary=_opencode_bin(),
        agent=agent,
        role_capabilities=_role_capabilities(),
        installation_root=_INSTALLATION_ROOT,
        workspace_root=project.parent,
        project_identity=project_identity,
        python_executable=python,
        tools_port=_tools_port(agent, root),
        setup=setup,
        required_capabilities=tuple(requested),
        capability_read_roots=read_roots,
        invocation_id=uuid.uuid4().hex,
        launch_argv=(_client_binary(route),),
        environment=environment,
        governance=governance,
    )


def _configuration_digest(context) -> str:
    """Compute the executor configuration identity used for safe resume."""
    from campaign_runner.launch import configuration_identity

    return configuration_identity(context)


def _opencode_policy_digest(route) -> str:
    """Return the stable policy identity for the legacy OpenCode helper path."""
    policy = {
        "client": route.client,
        "model": route.model,
        "role": "helper",
        "subscription_key": route.subscription_key,
        "answer_contract": "final-answer-v1",
        "resume_max": RESUME_MAX,
    }
    return hashlib.sha256(
        json.dumps(policy, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def _helper_executor(route, context):
    """Return the registry-selected helper executor or a visible refusal."""
    from campaign_runner.executors.registry import executor_for

    return executor_for(route, "helper", context)


def _matching_session(state: dict, agent: str, route, context) -> dict | None:
    """Return a stored session only when route, project, role, and policy match."""
    lane_state = (state.get("lanes", {}).get(agent) or {})
    stored = lane_state.get("session")
    if not isinstance(stored, dict):
        return None
    expected = {
        "client": route.client,
        "model": route.model,
        "project_digest": context.project_identity,
        "role": "helper",
    }
    if any(stored.get(key) != value for key, value in expected.items()):
        return None
    current = _configuration_digest(context)
    if stored.get("configuration_identity_digest") != current:
        return None
    return stored


def _resume_context(context, stored: dict):
    """Attach the prior run-owned launch and typed resume artifact."""
    from campaign_runner.executors.contracts import ResumeArtifact

    artifact = ResumeArtifact(
        stored["client"],
        stored["session_id"],
        stored["configuration_identity_digest"],
        stored["role"],
        stored["project_digest"],
    )
    return replace(
        context,
        resume_from=Path(stored["launch_path"]),
        resume_artifact=artifact,
    )


def _persist_registered_session(
    root: str, agent: str, result, executor, context
) -> None:
    """Persist the complete client/model/project/role/policy session identity."""
    identity = result.session_identity
    artifact = result.resume_artifact
    if identity is None or artifact is None or not result.session_id:
        return
    payload = asdict(identity)
    payload.update(
        configuration_identity_digest=artifact.configuration_identity_digest,
        launch_path=str(executor.prepared.invocation_dir / "launch.json"),
    )
    state = load_state(root)
    lane = state.setdefault("lanes", {}).setdefault(agent, {})
    lane["session"] = payload
    lane.pop("session_id", None)
    save_state(root, state)


def _clear_lane_session(root: str, agent: str) -> None:
    """Forget one stale lane binding without changing unrelated daemon state."""
    state = load_state(root)
    lane = state.setdefault("lanes", {}).setdefault(agent, {})
    lane.pop("session", None)
    lane["session_id"] = None
    save_state(root, state)


def _quota_from_result(route, result, governance) -> HelperQuotaWaiting | None:
    """Translate a typed executor quota outcome into daemon wait metadata."""
    outcome = result.outcome
    if outcome is None or outcome.kind != "quota":
        return None
    limit = outcome.limit
    observed = governance.governor.quota_wait(route.subscription_key)
    return HelperQuotaWaiting(
        route.subscription_key,
        observed.hold_id if observed else (limit.hold_id if limit else None),
        observed.reset_at if observed else (limit.reset_at if limit else None),
        limit.reason if limit else "quota",
    )


def _call_run_once(*args, governance=None, **kwargs):
    """Run every OpenCode helper invocation through the supplied governor."""
    kwargs["governance"] = governance
    return _run_once(*args, **kwargs)


def _registered_runner(
    agent: str,
    project_dir: str,
    root: str,
    prompt: str,
    timeout_s: int,
    route,
) -> str:
    """Run a non-OpenCode helper with typed resume and quota semantics."""
    from campaign_runner.executors.registry import ExecutorRefused

    context = _build_helper_context(route, agent, project_dir, root, timeout_s)
    stored = _matching_session(load_state(root), agent, route, context)
    resumed = stored is not None
    if stored is not None:
        context = _resume_context(context, stored)
    executor = _helper_executor(route, context)
    if hasattr(executor, "quota_detector"):
        executor.quota_detector = _event_quota_outcome
    session_id = stored.get("session_id") if stored else None
    current_prompt = prompt
    healed = False
    attempt = 0
    narration = ""
    while True:
        attempt += 1
        attempt_dir = state_dir(root) / "runs" / f"{uuid.uuid4().hex}-{agent}"
        result = executor.run(
            current_prompt,
            project_dir,
            attempt_dir,
            stem="helper",
            resume_session=session_id,
            retries=0,
        )
        if result.session_id:
            _persist_registered_session(root, agent, result, executor, context)
        quota = _quota_from_result(route, result, context.governance)
        if quota is not None:
            raise quota
        outcome = result.outcome.kind if result.outcome is not None else None
        if outcome == "refused":
            detail = next(
                (
                    str(item.get("message"))
                    for item in result.errors
                    if isinstance(item, dict) and item.get("message")
                ),
                "executor refused the helper invocation",
            )
            raise ExecutorRefused(detail)
        marker = is_final_answer(result.final_text)
        narration = result.all_text or result.final_text or narration
        log_line(
            root,
            f"[{agent}] attempt {attempt} rc={result.returncode} "
            f"tools={result.tool_calls} marker={'yes' if marker else 'no'} "
            f"route={route.client}/{route.model}",
        )
        failed = result.returncode != 0 or outcome not in (None, "success")
        if failed:
            if resumed and not healed:
                healed = True
                resumed = False
                _clear_lane_session(root, agent)
                context = _build_helper_context(
                    route, agent, project_dir, root, timeout_s
                )
                executor = _helper_executor(route, context)
                if hasattr(executor, "quota_detector"):
                    executor.quota_detector = _event_quota_outcome
                session_id = None
                current_prompt = prompt
                continue
            raise RuntimeError(
                f"{route.client} helper failed with outcome={outcome} "
                f"and exit={result.returncode}"
            )
        if marker:
            return result.final_text
        session_id = result.session_id
        if attempt > RESUME_MAX or not session_id:
            break
        current_prompt = RESUME_NOTE
    raise RuntimeError(
        f"helper never produced a FINAL ANSWER after {attempt} attempt(s). "
        f"Last narration:\n\n{narration[-3000:]}"
    )


def default_runner(agent: str, project_dir: str, root: str, prompt: str,
                   timeout_s: int, model: str | None = None) -> str:
    """Real headless run with the answer gate. Separate function so tests
    can stub it.

    Contract enforcement (added 2026-09-29, after three narration-only
    letter runs): the helper's LAST assistant message must begin with the
    FINAL ANSWER marker (the daemon prompt requires it). If it does not,
    the SAME session is resumed (`--session <id>` + RESUME_NOTE, "stop
    investigating, answer now") up to RESUME_MAX times. A run that never
    produces the marker raises; handle_task turns that into an error reply
    carrying the narration instead of silently treating it as done.

    --model is REQUIRED in practice: without it, `opencode run` falls back to
    the GLOBAL config's default model, which on this machine names a retired
    model (zai-coding-plan/glm-4.6) and fails with ProviderModelNotFoundError
    (found 2026-09-24, first smoke). Precedence: lane cfg `model` (agent.json,
    panel B7 — previously silently ignored) > MAGNOLIA_AGENTS_MODEL env >
    the deepseek/deepseek-flash default.

    Default deepseek/deepseek-flash = DeepSeek-V4.1-Flash on the official
    api.deepseek.com (verified live 2026-09-29); needs DEEPSEEK_API_KEY in
    the launcher env. Chosen after glm-5.3-flash ended its turn after one
    60-char message without doing the task (2026-09-29 letter test)."""
    route = _resolve_helper_route(root, project_dir, model)
    if route.client != "opencode":
        return _registered_runner(
            agent, project_dir, root, prompt, timeout_s, route
        )
    model = route.model or ""
    env = dict(os.environ)
    env["MAGNOLIA_ROOT"] = root
    env["MAGNOLIA_PROJECT_DIR"] = str(Path(root) / "opencode_cc_mem" / "projects" / agent)
    # Project-root mode: opencode runs with cwd = the project store, so the
    # location, memory server, and config are per lane.
    env["MAGNOLIA_PROJECT_WORKSPACE"] = "1"
    env["MAGNOLIA_WORKSPACE_ROOT"] = str(Path(root) / "opencode_cc_mem")
    env["MAGNOLIA_DOORBELL"] = "0"
    if _opencode_bin() != "opencode":
        env.setdefault(
            "OPENCODE_DB",
            str(Path.home() / ".local/share/opencode/opencode-v2.db"))
    _render_project_config(root, agent)
    _ensure_tools_daemon(root, env)
    from campaign_runner.governor import Governor
    from campaign_runner.workers import InvocationGovernance

    governor = Governor()
    lane_cap = _lane_config(Path(project_dir)).get("max_turns", 40)
    if isinstance(lane_cap, bool) or not isinstance(lane_cap, int) or lane_cap < 1:
        lane_cap = 40
    governance = InvocationGovernance(
        governor,
        route,
        f"helper:{agent}:{uuid.uuid4().hex}",
        _project_digest(project_dir),
        role_cap=lane_cap,
    )
    # Lane session: the lane keeps ONE session across letters — each letter
    # resumes it (`opencode run --session`), so the lane retains its ticket
    # history. First letter starts a fresh session; the resulting session id
    # is stored for the next letter.
    state = load_state(root)
    lane_state = state.get("lanes", {}).get(agent) or {}
    structured = lane_state.get("session")
    lane_sid = lane_state.get("session_id")
    policy_digest = _opencode_policy_digest(route)
    if isinstance(structured, dict):
        matches = (
            structured.get("client") == "opencode"
            and structured.get("model") == model
            and structured.get("project_digest") == _project_digest(project_dir)
            and structured.get("role") == "helper"
            and structured.get("policy_digest") == policy_digest
        )
        lane_sid = structured.get("session_id") if matches else None
    try:
        runs_dir(root).mkdir(parents=True, exist_ok=True)
        run_log = runs_dir(root) / (f"{datetime.now(timezone.utc):%Y%m%d_%H%M%S}_"
                                    f"{agent}.jsonl")
    except OSError:
        run_log = None

    args: list = ([ "--session", lane_sid ] if lane_sid else []) + [prompt]
    resumed = bool(lane_sid)
    healed = False
    attempt = 0
    while True:
        attempt += 1
        parsed = _call_run_once(
            model,
            project_dir,
            env,
            timeout_s,
            args,
            run_log,
            binary=_opencode_bin(),
            governance=governance,
            resolved_route=route,
        )
        if parsed.get("session_id"):
            # Lane session persistence: resume next letter in the same session.
            st = load_state(root)
            lane = st.setdefault("lanes", {}).setdefault(agent, {})
            lane["session_id"] = parsed["session_id"]
            lane["session"] = {
                "client": "opencode",
                "model": model,
                "session_id": parsed["session_id"],
                "project_digest": _project_digest(project_dir),
                "role": "helper",
                "policy_digest": policy_digest,
            }
            save_state(root, st)
        marker = is_final_answer(parsed["final_text"])
        log_line(root, f"[{agent}] attempt {attempt} rc={parsed['rc']} "
                       f"tools={parsed['n_tools']} "
                       f"marker={'yes' if marker else 'no'} model={model}")
        outcome = parsed.get("outcome")
        if outcome is not None and outcome.kind == "quota":
            limit = outcome.limit
            observed = governor.quota_wait(route.subscription_key)
            raise HelperQuotaWaiting(
                route.subscription_key,
                observed.hold_id if observed else (limit.hold_id if limit else None),
                observed.reset_at if observed else (limit.reset_at if limit else None),
                limit.reason if limit else "quota",
            )
        if parsed["rc"] != 0:
            if resumed and not healed:
                # Stale/expired stored session id bricks the lane: every
                # future letter fails on resume and the bad id is never
                # cleaned (panel A5). Self-heal once: clear the stored id and
                # retry the SAME letter in a fresh session.
                healed = True
                try:
                    st = load_state(root)
                    lane = st.setdefault("lanes", {}).setdefault(agent, {})
                    lane["session_id"] = None
                    lane.pop("session", None)
                    save_state(root, st)
                except Exception:
                    pass
                log_line(root, f"[{agent}] resume failed rc={parsed['rc']} — "
                               f"stored session id cleared, retrying fresh")
                args = [prompt]
                continue
            raise RuntimeError(f"opencode run exit={parsed['rc']}: "
                               f"{parsed['stderr_tail']}")
        if marker:
            return parsed["final_text"]
        if attempt > RESUME_MAX or not parsed["session_id"]:
            break  # out of resumes, or nothing to resume (e.g. 0-byte run)
        args = ["--session", parsed["session_id"], RESUME_NOTE]
    narration = (parsed.get("all_text") or "(no output)").strip()
    raise RuntimeError(
        f"helper never produced a FINAL ANSWER after {attempt} attempt(s). "
        f"Last narration:\n\n{narration[-3000:]}")


def _matching_pending_write(root: str, admitted: AdmittedLetter) -> dict | None:
    """Return a saved post-client write only for the unchanged request."""
    state = load_state(root)
    writes = state.setdefault("pending_writes", {})
    key = str(admitted.letter)
    pending = writes.get(key)
    if isinstance(pending, dict) and pending.get("letter_digest") == admitted.digest():
        return pending
    if key in writes:
        del writes[key]
        save_state(root, state)
    return None


def _save_pending_write(root: str, admitted: AdmittedLetter, pending: dict) -> None:
    """Checkpoint a paid answer before any inbox write is attempted."""
    state = load_state(root)
    state.setdefault("pending_writes", {})[str(admitted.letter)] = pending
    save_state(root, state)


def _finish_pending_write(
    root: str, agent: str, admitted: AdmittedLetter, pending: dict
) -> str:
    """Retry only inbox writes for one already-computed helper answer."""
    task_file = admitted.letter
    if not pending.get("reply_written"):
        try:
            write_reply(
                admitted,
                agent,
                str(pending["body"]),
                replace_existing=bool(pending["replace_existing"]),
            )
        except AdmissionRefused as exc:
            log_line(root, f"[{agent}] reply refused: {exc.reason}")
            if pending["final_status"] == "done":
                pending["final_status"] = "error"
                pending["final_text"] = set_status(pending["final_text"], "error")
        except OSError as exc:
            log_line(root, f"[{agent}] reply write pending: {exc}")
            return "pending_write"
        pending["reply_written"] = True
        _save_pending_write(root, admitted, pending)
    try:
        admitted.write_text(str(pending["final_text"]))
    except AdmissionRefused as exc:
        log_line(root, f"[{agent}] letter write refused: {exc.reason}")
        state = load_state(root)
        state.setdefault("pending_writes", {}).pop(str(task_file), None)
        save_state(root, state)
        return "refused"
    except OSError as exc:
        log_line(root, f"[{agent}] letter write pending: {exc}")
        return "pending_write"

    final_status = str(pending["final_status"])
    state = load_state(root)
    state.setdefault("pending_writes", {}).pop(str(task_file), None)
    if final_status == "prototyped" and is_deferred_task(admitted.read_text()):
        state["done"].pop(str(task_file), None)
    else:
        state["done"][str(task_file)] = hashlib.sha1(
            admitted.read_text().encode()
        ).hexdigest()
    save_state(root, state)
    if admitted.is_scheduled:
        consume_generation_receipt(admitted)
    log_line(root, f"[{agent}] {task_file.name} -> {final_status}")
    return final_status


def handle_task(task_file: Path, agent: str, root: str,
                runner=default_runner, timeout_s: int = TASK_TIMEOUT_S,
                lane_cfg: dict | None = None) -> str:
    """Run one task letter; write the reply; flip its status; update state.
    Returns 'done' or 'error' (the letter is consumed either way — a failed
    task is reported in the reply file, not retried in a loop)."""
    from campaign_runner.executors.registry import ExecutorRefused

    try:
        admitted = admit_letter(root, agent, task_file)
    except AdmissionRefused as exc:
        _mark_admission_refusal(root, agent, exc)
        return "refused"
    try:
        task_file = admitted.letter
        if admitted.is_scheduled and admitted.generation_consumed:
            log_line(root, f"[{agent}] {task_file.name} -> refused (generation consumed)")
            return "refused"
        text = admitted.read_text()
        pending = _matching_pending_write(root, admitted)
        if pending is not None:
            return _finish_pending_write(root, agent, admitted, pending)
        project_dir = str(admitted.lane_project)
        is_ticket = bool(_TICKET_RE.search(_header_window(text)))
        prompt = (
            f"You are the on-duty {agent} helper. A request letter arrived in "
            f"your inbox:\n\n---\n{text}\n---\n\n"
            f"Do the work it asks for. Rules: work only inside your own project "
            f"directory ({project_dir}) and the inbox folders; do NOT use the "
            f"memory tools (this letter is self-contained); do NOT try to write "
            f"or edit any files — headless runs cannot approve file-write "
            f"permissions. Instead, give your complete answer as your final "
            f"message. Answer contract: your FINAL message must BEGIN with the "
            f"line 'FINAL ANSWER:' followed by the complete answer — never end "
            f"your turn without it; if you are still investigating, keep "
            f"calling tools instead of stopping."
            + (_TICKET_TRAILER_HINT if is_ticket else "\n")
        )
        status = "done"
        body = ""
        lane_model = (lane_cfg or {}).get("model") or None
        try:
            body = runner(
                agent,
                project_dir,
                root,
                prompt,
                timeout_s,
                **({"model": lane_model} if lane_model else {}),
            )
        except HelperQuotaWaiting as waiting:
            state = load_state(root)
            state.setdefault("quota_waits", {})[str(task_file)] = {
                "lane": agent,
                "letter_digest": admitted.digest(),
                "subscription_key": waiting.key,
                "hold_id": waiting.hold_id,
                "reset_at": waiting.reset_at.isoformat() if waiting.reset_at else None,
                "reason": waiting.reason,
                "recorded_at": datetime.now(timezone.utc).isoformat(),
            }
            save_state(root, state)
            log_line(
                root,
                f"[{agent}] {task_file.name} -> waiting_quota "
                f"({waiting.key}, hold={waiting.hold_id or 'unknown'})",
            )
            return "waiting_quota"
        except ExecutorRefused as exc:
            status = "refused"
            body = (
                "## Helper capability refused\n\n"
                f"Magnolia did not launch a fallback client: {exc.reason}"
            )
        except Exception as exc:
            status = "error"
            body = f"## Task failed\n\nThe helper run raised: {exc}\n\n"
            body += "To try again, set this letter's `status:` line back to `open`."

        final_status = status
        final_text = set_status(text, status)
        if status == "done" and is_ticket:
            tstat = _TRAILER_STATUS_RE.search(body or "")
            park = _TRAILER_PARK_RE.search(body or "")
            new_state = tstat.group(1).lower() if tstat else None
            if park and new_state in (None, "prototyped"):
                final_status = "prototyped"
                final_text = _upsert_wait_for(
                    set_status(text, final_status), park.group(1)
                )
            elif new_state in ("evaluated", "accepted", "rejected", "prototyped"):
                final_status = new_state
                final_text = set_status(text, final_status)

        pending = {
            "lane": agent,
            "letter_digest": admitted.digest(),
            "body": body,
            "replace_existing": status != "refused",
            "final_status": final_status,
            "final_text": final_text,
            "reply_written": False,
            "recorded_at": datetime.now(timezone.utc).isoformat(),
        }
        _save_pending_write(root, admitted, pending)
        return _finish_pending_write(root, agent, admitted, pending)
    finally:
        admitted.close()


def scan_once(root: str, agents=AGENTS, runner=default_runner, lanes: dict | None = None) -> list[str]:
    # `agents` accepts the legacy name tuple; `lanes` (from discover_lanes)
    # is the registry path and wins when given.
    lane_map = lanes if lanes is not None else (
        discover_lanes(root)
        if agents is AGENTS
        else (agents if isinstance(agents, dict) else {a: {} for a in agents})
    )
    results = []
    for f in discover_tasks(root, lane_map):
        agent = f.parts[f.parts.index("projects") + 1]
        result = handle_task(f, agent, root, runner,
                             lane_cfg=lane_map.get(agent))
        results.append(f"{agent}:{result}")
    return results


def deliver_wait_for(root: str, lanes: dict) -> int:
    """Re-deliver deferred tickets whose job has a recorded status.

    Parked letters (`wait_for: job:<run_id>`) stay out of the runner until the
    run record <project>/.magnolia/runs/<run_id>.yaml exists with a status
    line; the letter is then re-opened with the recorded result appended.
    Durable by design — the run record, not the transient job-notices file,
    is the source (the job-notify plugin drains that file, so watching it
    would race)."""
    delivered = 0
    for agent in lanes:
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        runs = Path(root) / "opencode_cc_mem" / "projects" / agent / ".magnolia" / "runs"
        if inbox.is_symlink() or not inbox.is_dir():
            continue
        for f in sorted(inbox.rglob("*.task.md")):
            if _refusal_is_current(root, f):
                continue
            try:
                admitted = admit_letter(root, agent, f)
            except AdmissionRefused as exc:
                _mark_admission_refusal(root, agent, exc)
                continue
            try:
                text = admitted.read_text()
                rid = is_deferred_task(text)
                if not rid:
                    continue
                rec = runs / f"{rid}.yaml"
                if not rec.is_file():
                    hits = sorted(runs.glob(f"*_{rid}.yaml")) if runs.is_dir() else []
                    if not hits:
                        continue
                    rec = hits[-1]
                try:
                    status_m = re.search(
                        r"^status:\s*(\S+)",
                        rec.read_text(encoding="utf-8", errors="replace"),
                        re.M,
                    )
                except OSError:
                    continue
                result = status_m.group(1) if status_m else "unknown"
                if result not in _TERMINAL_RUN_STATUSES:
                    continue
                new_text = WAIT_FOR_RE.sub("", text) + (
                    f"\n\n## Job result ({rid})\n\n- status: {result}\n- record: {rec}\n"
                )
                admitted.write_text(set_status(new_text, "open"))
                log_line(root, f"[{agent}] wait_for delivered: {rid} -> {f.name}")
                delivered += 1
            except AdmissionRefused as exc:
                log_line(root, f"[{agent}] wait_for write refused: {exc.reason}")
            finally:
                admitted.close()
    return delivered


def scheduled_sweep_letters(root: str, lanes: dict) -> int:
    """Write the sweep letter for lanes whose schedule is due.

    Lane cfg: schedule_days (float) + schedule_task (the request text).
    State tracks the last send per lane; a lane never-swept is due at once
    (registration starts the cadence)."""
    sent = 0
    state = load_state(root)
    swept = state.setdefault("swept", {})
    now = datetime.now(timezone.utc)
    for agent, cfg in sorted(lanes.items()):
        days = cfg.get("schedule_days")
        task_text = cfg.get("schedule_task")
        if not days or not task_text:
            continue
        try:
            days = float(days)
        except (TypeError, ValueError):
            continue
        last = swept.get(agent)
        if last:
            try:
                if (now - datetime.fromisoformat(str(last))).total_seconds() < days * 86400:
                    continue
            except ValueError:
                pass
        inbox = Path(root) / "opencode_cc_mem" / "projects" / agent / "inbox"
        if inbox.is_symlink() or not inbox.is_dir():
            continue
        name = f"{now:%Y-%m-%d}_{agent}-scheduled-sweep.task.md"
        letter = inbox / name
        if letter.exists() and not letter.is_symlink():
            swept[agent] = now.isoformat()  # already sent today — no duplicate
            save_state(root, state)
            continue
        try:
            content = (
                f"# Scheduled sweep ({agent})\n\n- from: agents-daemon\n"
                f"- date: {now:%Y-%m-%d}\n- status: open\n\n## Request\n\n"
                f"{task_text}\n"
            )
            letter = write_scheduled_letter(root, agent, name, content)
            write_generation_receipt(root, agent, letter)
            swept[agent] = now.isoformat()
            save_state(root, state)
            log_line(root, f"[{agent}] scheduled sweep letter written")
            sent += 1
        except (OSError, AdmissionRefused) as exc:
            log_line(root, f"[{agent}] scheduled sweep refused: {exc}")
    return sent

_LOCK_FH = None  # module-level: if the file object is garbage-collected, the
                 # descriptor closes and the flock is silently released.


def acquire_lock(root: str) -> int | None:
    global _LOCK_FH
    state_dir(root).mkdir(parents=True, exist_ok=True)
    fh = (state_dir(root) / "daemon.lock").open("w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    fh.write(str(os.getpid()))
    fh.flush()
    _LOCK_FH = fh
    return fh.fileno()  # keep the fd open: the lock lives as long as we do


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="magnolia-agents-daemon")
    ap.add_argument("--root", default=os.environ.get("MAGNOLIA_ROOT") or os.getcwd())
    ap.add_argument("--once", action="store_true", help="one scan, no loop")
    ap.add_argument("--force", action="store_true",
                    help="skip the singleton lock — deliberate concurrent scan "
                         "(--once now LOCKS by default: two runners resuming one "
                         "lane session corrupt state.json, panel B8)")
    ap.add_argument("--interval", type=int, default=SCAN_INTERVAL_S)
    ap.add_argument(
        "--resume-quota",
        nargs="?",
        const="*",
        metavar="LANE",
        help="clear durable quota waits for every lane or one named lane",
    )
    args = ap.parse_args(argv)
    try:
        args.root = str(Path(args.root).resolve(strict=True))
    except OSError as exc:
        print(f"agents daemon root refused: {exc}")
        return 2
    if os.environ.get("MAGNOLIA_AGENTS", "") == "0":
        print("agents daemon disabled (MAGNOLIA_AGENTS=0)")
        return 0
    lock = acquire_lock(args.root)
    if lock is None and args.resume_quota is not None:
        lane = None if args.resume_quota == "*" else args.resume_quota
        request_quota_resume(args.root, lane)
        print("quota resume request queued for running agents daemon")
        return 0
    if lock is None and not args.force:
        print("agents daemon already running")
        return 0
    if args.resume_quota is not None:
        lane = None if args.resume_quota == "*" else args.resume_quota
        request_quota_resume(args.root, lane)
        print("quota resume request queued for next agents daemon scan")
        return 0
    log_line(args.root, f"daemon start (pid={os.getpid()}, once={args.once})")
    while True:
        try:
            apply_quota_resume_requests(args.root)
            lanes = discover_lanes(args.root)
            scheduled_sweep_letters(args.root, lanes)   # due schedules -> letters
            deliver_wait_for(args.root, lanes)          # job landed -> reopen ticket
            for r in scan_once(args.root, lanes=lanes):
                print(r, flush=True)
        except Exception as e:
            log_line(args.root, f"scan error: {e}")
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    raise SystemExit(main())

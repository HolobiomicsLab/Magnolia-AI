{
  "$schema": "https://opencode.ai/config.json",
  "tools": { "bash": false },
  "logLevel": "INFO",
  "permission": {
    "external_directory": {
      "~/elise/**": "allow",
      "~/repos/**": "allow"
    }
  },
  "plugin": [
    ".opencode/plugins/magnolia-session-capture.ts",
    ".opencode/plugins/magnolia-auto-retrieval.ts",
    ".opencode/plugins/magnolia-action-retrieval.ts",
    ".opencode/plugins/claim-critic.ts"
  ],
  "mcp": {
    "compchem-tools": {
      "type": "remote",
      "url": "http://127.0.0.1:8001/mcp",
      "timeout": 660000,
      "enabled": true
    },
    "compchem-memory": {
      "type": "local",
      "command": ["@@PYTHON@@", "-m", "compchem_memory.server"],
      "timeout": 660000,
      "enabled": true,
      "environment": {
        "MAGNOLIA_ROOT": "@@MAGNOLIA_ROOT@@",
        "MAGNOLIA_SKILLS_DIR": ".magnolia/skills",
        "MAGNOLIA_PROJECT_DIR": "projects/@@PROJECT@@",
        "MAGNOLIA_LLM_PROVIDER": "@@DISTILL_PROVIDER@@",
        "MAGNOLIA_LLM_MODEL": "@@DISTILL_MODEL@@"
      }
    },
    "perspicacite": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "timeout": 660000,
      "enabled": true
    }
  },
  "instructions": [
    "rules/*.md",
    "AGENTS.md",
    "projects/@@PROJECT@@/.magnolia/boot-context.md",
    "projects/@@PROJECT@@/.magnolia/audit-report.md"
  ]
}

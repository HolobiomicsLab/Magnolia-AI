    "COMPCHEM_TOOLS_PORT",
    "HOME",
    "LANG",
    "LOGNAME",
    "MAGNOLIA_CLIENT",
    "MAGNOLIA_CONTROL_DIR",
    "MAGNOLIA_DISTILL_INTERVAL_MIN",
    "MAGNOLIA_DOORBELL",
    "MAGNOLIA_HOOK_POLICY",
    "MAGNOLIA_HOOK_POLICY_REQUIRED",
    "MAGNOLIA_HOOK_POLICY_SHA256",
    "MAGNOLIA_INSTALLATION_ROOT",
    "MAGNOLIA_MEMORY_ALLOWLIST_REQUIRED",
    "MAGNOLIA_MEMORY_MODEL",
    "MAGNOLIA_MEMORY_PROVIDER",
    "MAGNOLIA_MEMORY_SERVICE_TOKEN",
    "MAGNOLIA_MEMORY_TOOL_ALLOWLIST",
    "MAGNOLIA_MODEL",
    "MAGNOLIA_PROJECT_DIR",
    "MAGNOLIA_PROJECT_IDENTITY",
    "MAGNOLIA_PYTHON",
    "MAGNOLIA_ROLE",
    "MAGNOLIA_ROOT",
    "MAGNOLIA_RULES_DIR",
    "MAGNOLIA_RUN_DIR",
    "MAGNOLIA_TRANSCRIPT_TOOL_CHARS",
    "MAGNOLIA_WORKSPACE_ROOT",
    "MAGNOLIA_WORK_DIR",
    "PATH",
    "PYTHONPYCACHEPREFIX",
    "SHELL",
    "TMPDIR",
    "USER",
    "XDG_STATE_HOME"

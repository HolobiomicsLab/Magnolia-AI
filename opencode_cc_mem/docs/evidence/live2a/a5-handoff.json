  "memory_provider_setup": {
    "memory_model": "loopback-test",
    "memory_provider": "openai"
  },
  "memory_server_has_sentinel": true,
  "memory_server_spawn_env_keys": [
    "HOME",
    "LANG",
    "MAGNOLIA_MEMORY_ALLOWLIST_REQUIRED",
    "MAGNOLIA_MEMORY_MODEL",
    "MAGNOLIA_MEMORY_PROVIDER",
    "MAGNOLIA_MEMORY_SERVICE_ACQUIRER_IDENTITY",
    "MAGNOLIA_MEMORY_SERVICE_ACQUIRER_PID",
    "MAGNOLIA_MEMORY_SERVICE_IDENTITY",
    "MAGNOLIA_MEMORY_SERVICE_PORT",
    "MAGNOLIA_MEMORY_SERVICE_TOKEN",
    "MAGNOLIA_MEMORY_TOOL_ALLOWLIST",
    "MAGNOLIA_PROJECT_BOUND",
    "MAGNOLIA_PROJECT_DIR",
    "MAGNOLIA_SERVER_STARTED_AT",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "PATH",
    "PYTHONPATH",
    "TMPDIR",
    "XDG_STATE_HOME"
  ],
  "opencode_spawns_watched_keys": [
    {
      "kind": "opencode-serve",
      "watched_present": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL"
      ]
    },
    {
      "kind": "opencode-model",
      "watched_present": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL"
      ]
    },
    {
      "kind": "opencode-model",
      "watched_present": [
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL"
      ]
    }
  ],
  "runner_env_extra": [
    "OPENAI_API_KEY=<loopback-sentinel>",
    "OPENAI_BASE_URL=http://127.0.0.1:9"
  ]
}

{"event_type":"tool_call","timestamp":"2026-06-17T08:59:53.585045Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c ssh azzurra 'python3 << \"PYEOF\"\nimport csv, io, os\n\n# run_id -> (sequence_label, length)\nruns = {\n    \"213648\": (\"TGGFQMALT\", 9),\n    \"213650\": (\"KFERQ\", 5),\n    \"213651\": (\"KILDQ\", 5),\n    \"213653\": (\"RKDLQ\", 5),\n    \"213654\": (\"RKELQ\", 5),\n    \"213656\": (\"QRKEL\", 5),\n    \"213703\": (\"HAMNG\", 5),\n    \"213704\": (\"KFERQKFERRQ\", 11),\n    \"213706\": (\"QRKELQRKEL\", 10),\n    \"213707\": (\"RKELQRKELQ\", 10),\n    \"213709\": (\"RKDLQRKDDQ\", 10),\n    \"213710\": (\"KFERQKILDQRFFE\", 14),\n}\n\nw_air = 0.01\nbase = \"/workspace/tjiang/magnolia/hsc70_new/runs\"\n\nfor rid in sorted(runs):\n    label, seqlen = runs[rid]\n    capri = os.path.join(base, \"haddock3_20260616_\" + rid, \"output\", \"12_caprieval\", \"capri_clt.tsv\")\n    if not os.path.isfile(capri):\n        print(f\"MISSING: {rid} {label}\")\n        continue\n\n    with open(capri) as f:\n        lines = [l for l in f if not l.startswith(\"#\")]\n    reader = csv.DictReader(lines, delimiter=\"\\t\")\n    for i, row in enumerate(reader):\n        rank = int(row[\"cluster_rank\"])\n        n = int(row[\"n\"])\n        score = float(row[\"score\"])\n        air = float(row[\"air\"])\n        dockq = float(row[\"dockq\"])\n        irmsd = float(row[\"irmsd\"])\n        fnat = float(row[\"fnat\"])\n        air_free = score - w_air * air\n        if rank <= 3:\n            print(f\"{rid} {label:16s} c{rank} n={n:3d} score={score:9.3f} air={air:9.3f} airfree={air_free:8.2f} dockq={dockq:.3f} irmsd={irmsd:.3f} fnat={fnat:.3f}\")\n    print()\nPYEOF'"}

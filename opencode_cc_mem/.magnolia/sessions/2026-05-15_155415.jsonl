{"event_type":"tool_call","timestamp":"2026-06-09T12:07:06.312669Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nwith open('gnina_vinardo_flex.out') as f:\n    text = f.read()\n\n# Extract all Affinity values\naffs = [float(m.group(1)) for m in re.finditer(r'Affinity:\\s+([-\\d.]+)', text)]\nprint(f\"Total affinities: {len(affs)}\")  # should be 800\n\n# Each compound has 20 poses, get the best (most negative) per compound\nN_POSES = 20\nbest_per_comp = []\nfor i in range(40):\n    start = i * N_POSES\n    end = start + N_POSES\n    if end <= len(affs):\n        best = min(affs[start:end])  # most negative\n        best_per_comp.append(best)\n\nprint(f\"Best per compound: {len(best_per_comp)}\")\n\n# Experimental data\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\npairs = []\nfor i, fn in enumerate(sdf_names_sorted):\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    if i < len(best_per_comp):\n        pairs.append((best_per_comp[i], name, kd))\n\n# Correlation\nkd_a = np.array([p[2] for p in pairs])\naff_a = np.array([p[0] for p in pairs])\nrho, p = spearmanr(aff_a, kd_a)\nprint(f\"\\n\u2550\u2550\u2550 VINARDO (flex poses, n={len(pairs)}) \u2550\u2550\u2550\")\nprint(f\"  \u03c1 = {rho:+.4f}  p = {p:.4f}\")\n\n# By class\nGOOD = [p[0] for p in pairs if p[2] < 1.0]\nMOD = [p[0] for p in pairs if 1.0 <= p[2] < 10]\nWEAK = [p[0] for p in pairs if p[2] >= 10]\nprint(f\"  STRONG:      {np.mean(GOOD):+.2f} \u00b1 {np.std(GOOD):.2f}\")\nprint(f\"  MODERATE:    {np.mean(MOD):+.2f} \u00b1 {np.std(MOD):.2f}\")\nprint(f\"  WEAK/NON:    {np.mean(WEAK):+.2f} \u00b1 {np.std(WEAK):.2f}\")\n\n# Top 5\npairs.sort(key=lambda x: x[0])\nprint(f\"\\n  Top 5 by Vinardo:\")\nfor aff, name, kd in pairs[:5]:\n    cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else \"WEAK\")\n    print(f\"    {name:<22s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  [{cls}]\")\n\n# Z11-16\nprint(f\"\\n  Z11-16 series:\")\nfor aff, name, kd in pairs:\n    if 'Z11-16' in name:\n        print(f\"    {name:<15s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}\")\n\nPYEOF"}

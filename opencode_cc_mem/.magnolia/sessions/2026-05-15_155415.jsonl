{"event_type":"tool_call","timestamp":"2026-06-26T13:00:34.967418Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/mcp_build_refs.py <<'PYEOF'\nimport json,sys,time,datetime; sys.path.insert(0,\"/tmp\"); import mcplib as M\nLOG=open(\"/tmp/studium_refs_build.log\",\"a\")\ndef log(*a):\n    s=\"[\"+datetime.datetime.now().strftime(\"%H:%M:%S\")+\"] \"+\" \".join(str(x) for x in a)\n    print(s); LOG.write(s+\"\\n\"); LOG.flush()\ndef safe_call(name,args,t=300):\n    for attempt in range(2):\n        try:\n            r=M.call(name,args,t=t)\n            # detect session/auth errors\n            if isinstance(r,str) and ('not found' in r.lower() and 'session' in r.lower()):\n                raise RuntimeError(r)\n            return r\n        except Exception as e:\n            log(f\"  ! {name} error ({e}), reconnecting...\"); \n            try: M.connect()\n            except Exception as e2: log(f\"  reconnect failed: {e2}\")\n            time.sleep(3)\n    return json.dumps({\"success\":False,\"error\":\"call failed after retry\"})\n\n# 46 DOIs: 34 draft-cited (with DOIs) + 12 lit-scan verified neighbors\nDRAFT=[\n\"10.1207/s15327809jls0402_2\",\"10.18653/v1/2025.bea-1.77\",\"10.1175/1520-0493(1950)078<0001:VOFEIT>2.0.CO;2\",\n\"10.1080/00461520.2014.965823\",\"10.48550/arXiv.1905.06873\",\"10.1007/BF01099821\",\"10.1177/1529100612453266\",\n\"10.1037/0003-066X.34.10.906\",\"10.1073/pnas.1319030111\",\"10.1073/pnas.1916903117\",\"10.3390/soc15010006\",\n\"10.1145/3571730\",\"10.1016/j.lindif.2023.102274\",\"10.1207/s15430421tip4104_2\",\"10.18653/v1/2023.findings-emnlp.372\",\n\"10.2139/ssrn.4391243\",\"10.1016/j.tics.2016.07.002\",\"10.1142/S0218488502001648\",\"10.1080/00461520.2011.611369\",\n\"10.1111/j.1469-7610.1976.tb00381.x\",\"10.3102/0034654307313795\",\"10.1145/3038912.3052580\",\"10.1145/3641289\",\n\"10.1016/j.caeai.2020.100001\",\"10.18653/v1/2023.findings-emnlp.130\",\"10.1073/pnas.1821936116\",\n\"10.1145/3703155\",\"10.3390/info17010051\",\"10.48550/arXiv.2005.11401\",\"10.3389/fcomp.2026.1777749\",\n\"10.48550/arXiv.2405.03734\",\"10.48550/arXiv.2511.11035\",\"10.48550/arXiv.2601.06066\",\"10.1109/ACCESS.2018.2887201\"]\nLITSCAN=[\n\"10.1109/access.2026.3704123\",\"10.1145/3772318.3791476\",\"10.48550/arXiv.2311.17696\",\"10.48550/arXiv.2505.14126\",\n\"10.48550/arXiv.2512.11930\",\"10.48550/arXiv.2604.24807\",\"10.48550/arXiv.2402.09216\",\"10.48550/arXiv.2309.08112\",\n\"10.48550/arXiv.2407.01245\",\"10.48550/arXiv.2605.16207\",\"10.48550/arXiv.2603.27076\",\"10.48550/arXiv.1901.10268\"]\nDOIS=DRAFT+LITSCAN\nlog(f\"START building studium_refs: {len(DOIS)} DOIs ({len(DRAFT)} draft + {len(LITSCAN)} litscan)\")\nM.connect()\ntot_added=tot_meta=tot_skip=tot_fail=0; failed=[]\nB=6\nfor i in range(0,len(DOIS),B):\n    batch=DOIS[i:i+B]\n    out=safe_call(\"add_dois_to_kb\",{\"kb_name\":\"studium_refs\",\"dois\":batch},t=300)\n    try:\n        j=json.loads(out)\n        a=j.get(\"added_papers\",0); m=j.get(\"added_metadata_only\",0); s=j.get(\"skipped_duplicates\",0); f=j.get(\"failed\",[])\n        tot_added+=a; tot_meta+=m; tot_skip+=s\n        log(f\"batch {i//B+1}/{(len(DOIS)+B-1)//B}: added={a}(full={a-m},meta={m}) skip={s} fail={len(f)} :: {[d[:30] for d in batch]}\")\n        if f: \n            failed+=([x.get('doi') if isinstance(x,dict) else str(x) for x in f]); \n            log(f\"   failed detail: {json.dumps(f)[:300]}\")\n    except Exception as e:\n        log(f\"batch {i//B+1} parse-error: {out[:200]}\")\nlog(f\"DONE. added={tot_added} (of which metadata-only={tot_meta}) skipped_dup={tot_skip} failed={len(failed)}\")\nif failed: log(f\"FAILED DOIs: {failed}\")\n# final count\ntry:\n    kb=json.loads(safe_call(\"list_knowledge_bases\",{},t=60))\n    for k in kb.get(\"knowledge_bases\",[]):\n        if k[\"name\"]==\"studium_refs\": log(f\"FINAL studium_refs: papers={k.get('paper_count')} chunks={k.get('chunk_count')}\")\nexcept Exception as e: log(\"final list failed:\",e)\nLOG.close()\nPYEOF\n# launch in background\nnohup python3 /tmp/mcp_build_refs.py >> /tmp/studium_refs_build.log 2>&1 &\necho \"launched PID $!; log=/tmp/studium_refs_build.log\"\nsleep 3; echo \"--- first log lines ---\"; cat /tmp/studium_refs_build.log 2>/dev/null | tail -5"}

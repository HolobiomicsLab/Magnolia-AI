print(f\"{res[0]} {res[1]} CA: ({x:.1f}, {y:.1f}, {z:.1f})  dist to TRS={((x-TRS[0])**2+(y-TRS[1])**2+(z-TRS[2])**2)**0.5:.1f}\")\nPYEOF"}

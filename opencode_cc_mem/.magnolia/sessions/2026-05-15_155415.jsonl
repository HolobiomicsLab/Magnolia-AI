{"event_type":"tool_call","timestamp":"2026-06-10T13:25:42.112854Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\nrec_atoms = []\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box/receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\n# Find residues within 5A of Asn90 sidechain heavy atoms\nasn90_sidechain = [a for a in rec_atoms if a[1]=='ASN' and a[2]==90 and a[0] not in ('N','CA','C','O','H','HA','HN')]\n\nprint(f\"Asn90 sidechain atoms: {[(a[0], f'{a[3]:.1f}', f'{a[4]:.1f}', f'{a[5]:.1f}') for a in asn90_sidechain]}\")\nprint()\n\n# For each residue, find minimum distance to any Asn90 sidechain atom\nfrom collections import defaultdict\nres_min_d = defaultdict(lambda: 999.0)\nres_name = {}\n\nfor a in rec_atoms:\n    if a[1]=='ASN' and a[2]==90: continue  # skip self\n    min_d = min(math.sqrt((sa[3]-a[3])**2+(sa[4]-a[4])**2+(sa[5]-a[5])**2) for sa in asn90_sidechain)\n    key = f\"{a[1]}{a[2]}\"\n    if min_d < res_min_d[key]:\n        res_min_d[key] = min_d\n        res_name[key] = a[1]\n\n# Sort by distance, show residues within 5A\nprint(\"Residues within 5\u00c5 of Asn90 sidechain:\")\nprint(f\"{'Residue':10s} {'Min dist':>9s}\")\nprint(\"-\" * 22)\nfor res, d in sorted(res_min_d.items(), key=lambda x: x[1]):\n    if d <= 5.0:\n        print(f\"{res:10s} {d:>8.2f}\u00c5\")\nPYEOF"}

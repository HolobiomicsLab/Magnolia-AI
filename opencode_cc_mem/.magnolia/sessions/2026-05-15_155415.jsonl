',    'non-binder','docked_flex8_Z11-16-Ac_asn90.sdf'),\n    ('Z11-16-OH',    'weak',      'docked_flex8_Z11-16-OH_asn90.sdf'),\n    ('Palmitic acid','non-binder','docked_flex8_Palmitic_acid_asn90.sdf'),\n    ('Cedrol',       'good',      'docked_flex8_Cedrol_asn90.sdf'),\n    ('\u03b2-Ionone',     'good',      'docked_flex8_\u03b2-Ionone_asn90.sdf'),\n]\n\nprint(f\"{'Ligand':16s} {'class':>10s} {'aff':>6s} {'atoms':>6s} {'polar':>6s} {'contacts':>9s} {'polar_c':>8s} {'apolar_c':>9s} {'res':>5s} {'aff/atom':>9s}\")\nprint(\"-\" * 95)\n\ndata_rows = []\nfor name, cls, fname in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, _, _, lig_atoms = result\n    \n    n_atoms = len(lig_atoms)\n    n_polar_lig = sum(1 for a in lig_atoms if a[0] in ('O','N'))\n    \n    contacts = []\n    res_set = set()\n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                is_polar = lelem in ('O','N') or rname[0] in ('O','N')\n                contacts.append((d, is_polar))\n                res_set.add(f\"{rres}{rnum}\")\n    \n    n_contacts = len(contacts)\n    n_polar_c = sum(1 for _, p in contacts if p)\n    n_apolar_c = n_contacts - n_polar_c\n    n_res = len(res_set)\n    \n    print(f\"{name:16s} {cls:>10s} {emp_aff:>6.1f} {n_atoms:>6d} {n_polar_lig:>6d} {n_contacts:>9d} {n_polar_c:>8d} {n_apolar_c:>9d} {n_res:>5d} {emp_aff/n_atoms:>9.3f}\")\n    data_rows.append((name, cls, emp_aff, n_atoms, n_contacts, n_polar_c))\n\n# Build the correlation check\nprint(f\"\\n{'Ligand':16s} {'atoms':>6s} \u2192 {'contacts':>9s} \u2192 {'aff':>6s}\")\nprint(\"-\" * 42)\nfor name, cls, aff, na, nc, np in data_rows:\n    print(f\"{name:16s} {na:>6d} \u2192 {nc:>9d} \u2192 {aff:>6.1f}\")\n\n# Show: absolute number of contacts correlates with affinity\nxs = [r[4] for r in data_rows]  # n_contacts\nys = [r[2] for r in data_rows]  # emp_aff\nn = len(xs)\nmx = sum(xs)/n; my = sum(ys)/n\nsx = (sum((x-mx)**2 for x in xs)/n)**0.5\nsy = (sum((y-my)**2 for y in ys)/n)**0.5\nr_contacts = sum((xs[i]-mx)*(ys[i]-my) for i in range(n)) / (n*sx*sy) if sx*sy else 0\n\n# Check atom count vs affinity\nxs2 = [r[3] for r in data_rows]\nmx2 = sum(xs2)/n\nsx2 = (sum((x-mx2)**2 for x in xs2)/n)**0.5\nr_atoms = sum((xs2[i]-mx2)*(ys[i]-my) for i in range(n)) / (n*sx2*sy) if sx2*sy else 0\n\nprint(f\"\\n  r(contacts vs aff) = {r_contacts:+.3f}   r(atoms vs aff) = {r_atoms:+.3f}\")\nprint(f\"  Negative r = more contacts/atoms \u2192 better score (more negative aff)\")\n\nPYEOF"}

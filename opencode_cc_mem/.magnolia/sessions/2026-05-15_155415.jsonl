{"event_type":"tool_call","timestamp":"2026-06-18T13:10:59.289673Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c set -e\n\nmkdir -p projects/hsc70_new/runs/2026-06-18_alascan_RKALQ\ncd projects/hsc70_new/runs/2026-06-18_alascan_RKALQ\n\n# Copy best model\ngunzip -c ../2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz > complex.pdb\n\ncat > config.cfg << 'EOF'\nrun_dir = \"output\"\nncores = 32\nmode = \"local\"\nmolecules = [\"complex.pdb\"]\n\n[topoaa]\n\n[alascan]\nresdic_A = [404,405,406,407,427,428,429,430,431,437,438,439,440,460,469]\nresdic_B = [1,2,3,4,5]\nchains = [\"A\", \"B\"]\nscan_residue = \"ALA\"\nint_cutoff = 5.0\nEOF\n\necho \"=== Running RKALQ alascan ===\"\nconda run -n haddock3-py311 haddock3 config.cfg 2>&1 | grep -E 'native score|INFO|ERROR|Finished|took'\n\necho \"\"\necho \"=== Results ===\"\ncat output/1_alascan/scan_complex_haddock.tsv"}
{"event_type":"tool_success","timestamp":"2026-06-18T13:11:37.438260Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":38149,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-18T13:20:11.433950Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, math, re\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') if path.endswith('.gz') else open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'serial': int(line[6:11]),\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                    'elem': line[76:78].strip() if len(line) > 76 else '',\n                })\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\ndef analyze_surroundings(model_path, peptide_chain, positions, label, cutoff=6.0):\n    atoms = parse_pdb(model_path)\n    \n    for pos in positions:\n        pep_atoms = [a for a in atoms if a['chain'] == peptide_chain and a['resi'] == pos]\n        if not pep_atoms:\n            print(f\"\\n--- {label} POS {pos}: not found ---\")\n            continue\n        \n        resn = pep_atoms[0]['resn']\n        print(f\"\\n=== {label} Position {pos} ({resn}) \u2014 receptor atoms within {cutoff}\u00c5 ===\")\n        \n        # Get receptor atoms within cutoff\n        nearby = []\n        for pa in pep_atoms:\n            for ra in atoms:\n                if ra['chain'] != peptide_chain:\n                    d = dist(pa, ra)\n                    if d < cutoff:\n                        nearby.append((d, ra, pa))\n        \n        nearby.sort(key=lambda x: x[0])\n        \n        # Group by receptor residue\n        rec_res = defaultdict(list)\n        for d, ra, pa in nearby:\n            key = f\"{ra['chain']}-{ra['resi']}-{ra['resn']}\"\n            rec_res[key].append((d, pa['name'], ra['name']))\n        \n        print(f\"  Receptor residues within {cutoff}\u00c5:\")\n        for rr in sorted(rec_res, key=lambda x: min(d for d,_,_ in rec_res[x])):\n            dists = rec_res[rr]\n            mind = min(d for d,_,_ in dists)\n            close_contacts = [(d, pn, rn) for d, pn, rn in dists if d < 4.0]\n            # classify residue\n            resn_rr = rr.split('-')[2]\n            charged = resn_rr in ['ARG','LYS','ASP','GLU']\n            hydrophobic = resn_rr in ['ALA','VAL','LEU','ILE','PHE','TRP','MET','PRO']\n            polar = resn_rr in ['SER','THR','ASN','GLN','TYR','HIS','GLY']\n            aro = resn_rr in ['PHE','TYR','TRP']\n            sign = '+/-' if charged else ('\u03a6' if hydrophobic else ('\u03c0' if aro else '~'))\n            n_close = len(close_contacts)\n            print(f\"    {rr:22s} {sign}  min={mind:.1f}\u00c5  <4\u00c5 contacts: {n_close}\")\n        \n        # What's the direction of the sidechain?\n        # For each position, look at the CA position and the sidechain centroid\n        ca = [a for a in pep_atoms if a['name'] == 'CA']\n        cb = [a for a in pep_atoms if a['name'] == 'CB']\n        if ca and cb:\n            vec = (cb[0]['x'] - ca[0]['x'], cb[0]['y'] - ca[0]['y'], cb[0]['z'] - ca[0]['z'])\n            # Find receptor atoms near the CB\n            cb_nearby = [ra for ra in atoms if ra['chain'] != peptide_chain \n                         and dist(cb[0], ra) < cutoff]\n            cb_nearby.sort(key=lambda ra: dist(cb[0], ra))\n            print(f\"  Sidechain direction (CA\u2192CB): closest receptor atoms:\")\n            for ra in cb_nearby[:5]:\n                d = dist(cb[0], ra)\n                print(f\"    {ra['chain']}-{ra['resi']}-{ra['resn']} {ra['name']:5s}  {d:.1f}\u00c5\")\n        \n        elif ca and resn == 'GLY':\n            # GLY has no CB \u2014 check CA vicinity\n            ca_nearby = [ra for ra in atoms if ra['chain'] != peptide_chain \n                         and dist(ca[0], ra) < cutoff]\n            ca_nearby.sort(key=lambda ra: dist(ca[0], ra))\n            print(f\"  No sidechain (GLY). CA surroundings:\")\n            for ra in ca_nearby[:5]:\n                d = dist(ca[0], ra)\n                print(f\"    {ra['chain']}-{ra['resi']}-{ra['resn']} {ra['name']:5s}  {d:.1f}\u00c5\")\n\n# TGFMALQ\nprint(\"=\" * 60)\nprint(\"TGFMALQ \u2014 low-contributing residues: GLY2, LEU6\")\nanalyze_surroundings(\n    'projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz',\n    'B', [2, 6], 'TGFMALQ'\n)\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"RKALQ \u2014 ALA3 environment\")\nanalyze_surroundings(\n    'projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz',\n    'B', [3], 'RKALQ'\n)\n\nPYEOF"}

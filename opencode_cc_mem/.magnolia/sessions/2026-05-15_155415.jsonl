{"event_type":"tool_call","timestamp":"2026-06-11T20:12:13.993767Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 -c \"\nimport os, glob, re\n\ndef get_length(run_name):\n    n = run_name.lower()\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    return 5\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nresults = []\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    n = d.lower()\n    if not ('x2' in n or 'fusion' in n or 'variant' in n or 's5000' in n or 's1000' in n or 's2000' in n):\n        continue\n    if 'x2' not in n and 'fusion' not in n and 'variant' not in n:\n        # Only include KFERQ parent for reference\n        if 'kferq_' in n or 'kferq_s' in n:\n            pass\n        else:\n            continue\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'): continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21: continue\n            score = float(parts[4])\n            air = float(parts[18])\n            results.append({\n                'run': d, 'score': score, 'air_free': score - 0.1*air,\n                'dockq': float(parts[12]), 'irmsd': float(parts[6]),\n                'bsa': float(parts[20]), 'len': get_length(d),\n            })\n            if parts[0] == '1': break\n\ndef peptide_name(n):\n    return re.sub(r'^\\d{4}-\\d{2}-\\d{2}_', '', n).replace('_p2rank1','').replace('_clean','')\n\n# Sort by length then air_free\nresults.sort(key=lambda r: (r['len'], r['air_free']))\n\n# Include KFERQ parent for reference\nparent = [r for r in results if 'KFERQ_s5000' in r['run'] and 'p2rank' not in r['run'].lower()]\nref = [r for r in results if 'KFERQ_p2rank1_s5000' in r['run']]\n\nprint(f\\\"{'Peptide':<30} {'Len':>3} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7} {'AF/res':>8}\\\")\nprint('-' * 78)\nfor r in ref:\n    print(f\\\"{'KFERQ (parent, p2rank)':<30} {r['len']:>3} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f} {r['air_free']/r['len']:>8.2f}\\\")\nfor r in results:\n    if 'KFERQ' in r['run'] and 's5000_s' in r['run']: continue  # skip the nested issue\n    print(f\\\"{peptide_name(r['run']):<30} {r['len']:>3} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f} {r['air_free']/r['len']:>8.2f}\\\")\n\" 2>&1"}

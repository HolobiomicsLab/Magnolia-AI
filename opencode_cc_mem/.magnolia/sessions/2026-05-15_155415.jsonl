{"event_type":"tool_call","timestamp":"2026-06-05T12:32:59.031517Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\ndef get_contacts(atoms, cutoff=5.0):\n    rec = [a for a in atoms if a[\"chain\"]==\"A\"]\n    pep = [a for a in atoms if a[\"chain\"]==\"B\"]\n    contacts = {}\n    for ra in rec:\n        for pa in pep:\n            d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n            if d <= cutoff:\n                key = (ra[\"resn\"], ra[\"resi\"], pa[\"resn\"], pa[\"resi\"])\n                if key not in contacts or d < contacts[key]:\n                    contacts[key] = d\n    return contacts\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nparent = read_pdb(f\"{base}/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nn_ala  = read_pdb(f\"{base}/analysis/6mer_stage1/cluster_2_model_1.pdb\")\n\ncp = get_contacts(parent)\ncn = get_contacts(n_ala)\n\ndef per_residue(contacts):\n    \"\"\"Return dict: peptide_resi -> [(rec_resn, rec_resi, dist), ...]\"\"\"\n    out = {}\n    for (rrn, rri, prn, pri), d in contacts.items():\n        if pri not in out:\n            out[pri] = []\n        out[pri].append((rrn, rri, d))\n    for pri in out:\n        out[pri].sort(key=lambda x: x[2])\n    return out\n\npp = per_residue(cp)\npn = per_residue(cn)\n\n# Get peptide sequences\ndef pep_seq(atoms):\n    seen = {}\n    for a in atoms:\n        if a[\"chain\"]==\"B\" and a[\"resi\"] not in seen:\n            seen[a[\"resi\"]] = a[\"resn\"]\n    return [f\"{seen[r]}{r}\" for r in sorted(seen)]\n\nseq_p = pep_seq(parent)\nseq_n = pep_seq(n_ala)\n\nprint(f\"Parent KFERQ: {'-'.join(seq_p)}\")\nprint(f\"N-ALA:       {'-'.join(seq_n)}\")\nprint()\n\nfor label, pdata, seq in [(\"KFERQ (parent)\", pp, seq_p), (\"ApKFERQ_N\", pn, seq_n)]:\n    print(f\"=== {label} ===\")\n    for resi in sorted(pdata):\n        entries = pdata[resi]\n        resn = next((a[\"resn\"] for a in (parent if label.startswith(\"K\") else n_ala) if a[\"chain\"]==\"B\" and a[\"resi\"]==resi), \"?\")\n        n_contacts = len(entries)\n        contacts_str = \", \".join(f\"{rn}{ri}({d:.1f})\" for rn, ri, d in entries)\n        print(f\"  {resn}{resi}: {n_contacts:2d} contacts -> {contacts_str}\")\n    print()\n\n# Shared per-residue: which parent contacts are preserved/lost in N-ALA?\nprint(\"=== Contact comparison: same peptide residue \u2192 same receptor residue ===\")\nfor resi in sorted(set(list(pp.keys()) + list(pn.keys()))):\n    p_contacts = set((rn, ri) for rn, ri, _ in pp.get(resi, []))\n    n_contacts = set((rn, ri) for rn, ri, _ in pn.get(resi, []))\n    shared = p_contacts & n_contacts\n    lost = p_contacts - n_contacts\n    gained = n_contacts - p_contacts\n    resn_p = next((a[\"resn\"] for a in parent if a[\"chain\"]==\"B\" and a[\"resi\"]==resi), \"?\")\n    resn_n = next((a[\"resn\"] for a in n_ala if a[\"chain\"]==\"B\" and a[\"resi\"]==resi), \"?\")\n    label = f\"{resn_p}/{resn_n}\" if resn_p != resn_n else resn_p\n    print(f\"  {label}{resi}:\")\n    if shared:\n        print(f\"    shared ({len(shared)}): {', '.join(f'{rn}{ri}' for rn,ri in sorted(shared))}\")\n    if lost:\n        print(f\"    lost   ({len(lost)}): {', '.join(f'{rn}{ri}' for rn,ri in sorted(lost))}\")\n    if gained:\n        print(f\"    gained ({len(gained)}): {', '.join(f'{rn}{ri}' for rn,ri in sorted(gained))}\")\n\nPYEOF"}

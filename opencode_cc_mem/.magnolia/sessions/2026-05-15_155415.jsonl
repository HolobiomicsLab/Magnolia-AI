{"event_type":"tool_call","timestamp":"2026-06-17T09:08:59.565308Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\n# All entries ranked by AIR-free, with length, for plotting the trend\ndata = [\n    # (seq, length, airfree, dockq, source)\n    (\"KFERQKILDQRFFE\", 14, -124.70, 0.719, \"c1\"),\n    (\"KFERQKFERRQ\",     11, -114.16, 0.815, \"c1\"),\n    (\"TGGFQMALT\",        9, -100.60, 0.819, \"c1\"),\n    (\"RKELQRKELQ\",      10,  -97.21, 0.845, \"c1\"),\n    (\"RKDLQRKDDQ\",      10,  -77.17, 0.776, \"c2\"),\n    (\"QRKELQRKEL\",      10,  -75.51, 0.741, \"c2\"),\n    (\"RKDLQ\",            5,  -74.85, 0.825, \"c1\"),\n    (\"KFERQ\",            5,  -71.87, 0.819, \"c2\"),\n    (\"HAMNG\",            5,  -67.02, 0.777, \"c1\"),\n    (\"RKELQ\",            5,  -65.24, 0.766, \"c1\"),\n    (\"KILDQ\",            5,  -64.17, 0.719, \"c2\"),\n    (\"QRKEL\",            5,  -61.38, 0.768, \"c2\"),\n]\n\nprint(f\"{'Sequence':18s} {'Len':>3s} {'AIR-free':>9s} {'\u0394/residue':>10s} {'\u0394 vs 5-mer avg':>15s}\")\nprint(\"-\" * 60)\n\n# 5-mer averages\nfive_mers = [d for d in data if d[1] == 5]\nfive_avg = sum(d[2] for d in five_mers) / len(five_mers)\nprint(f\"{'5-mer average':18s} {'  5':>3s} {five_avg:9.2f}\")\nprint()\n\n# For extended peptides, compute per-residue marginal gain\nprev_len = 5\nprev_score = five_avg\nfor seq, length, af, dq, src in data:\n    if length > 5:\n        delta = af - prev_score\n        per_res = delta / (length - prev_len)\n        print(f\"{seq:18s} {length:3d} {af:9.2f} {per_res:+10.2f} {af - five_avg:+15.2f}\")\n        prev_score = af\n        prev_len = length\n\nprint()\nprint(\"--- Normalized: AIR-free / length ---\")\nfor seq, length, af, dq, src in data:\n    norm = af / length\n    print(f\"{seq:18s} {length:3d} {af:9.2f}  norm={norm:.2f}\")\nPYEOF"}

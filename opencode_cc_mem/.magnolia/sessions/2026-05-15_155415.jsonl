{"event_type":"tool_call","timestamp":"2026-07-01T07:11:04.244723Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = {\n    \"EGGFQMAKT(L8->K)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART(L8->R)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"KFERQx2_s20000\": \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\",\n}\n\nfor label, d in runs.items():\n    print(f\"\\n{'='*60}\")\n    print(f\"  {label}\")\n    print(f\"{'='*60}\")\n    # clustfcc scoring\n    for sfx in ['12_caprieval', '09_caprieval']:\n        sc = f\"{d}/output/{sfx}/clustfcc_scoring.tsv\"\n        if os.path.exists(sc):\n            print(f\"\\n  Cluster-level (post-{sfx.split('_')[0]} refinement):\")\n            with open(sc) as f:\n                lines = [l for l in f if not l.startswith('#')]\n            reader = csv.DictReader(lines, delimiter='\\t')\n            for row in reader:\n                cid = row.get('cluster_id','?')\n                crank = row.get('cluster_ranking','?')\n                n = row.get('n','?')\n                score = float(row['score'])\n                air = float(row.get('air',0))\n                air_free = score - 0.1*air\n                vdw = row.get('vdw','0')\n                elec = row.get('elec','0')\n                bsa = row.get('bsa','0')\n                desolv = row.get('desolv','0')\n                print(f\"    Cluster{cid}(rank{crank}): n={n}  score={score:.2f}  AIR-free={air_free:.2f}  vdw={vdw}  elec={elec}  bsa={bsa}  desolv={desolv}\")\n            break\n\n    # Top model from capri_ss\n    ss_paths = [f\"{d}/output/12_caprieval/capri_ss.tsv\", f\"{d}/output/09_caprieval/capri_ss.tsv\"]\n    for ss in ss_paths:\n        if os.path.exists(ss):\n            with open(ss) as f:\n                lines = [l for l in f if not l.startswith('#')]\n            reader = csv.DictReader(lines, delimiter='\\t')\n            best = None\n            for row in reader:\n                s = float(row['score'])\n                if best is None or s < best[0]:\n                    air = float(row.get('air',0))\n                    best = (s, s-0.1*air, row.get('dockq','?'), row.get('vdw','?'), row.get('elec','?'),\n                            row.get('bsa','?'), row.get('cluster_id','?'), row.get('cluster_ranking','?'),\n                            row.get('irmsd','?'), row.get('lrmsd','?'), row.get('fnat','?'))\n            if best:\n                print(f\"\\n  Best single model: score={best[0]:.2f} AIR-free={best[1]:.2f} DockQ={best[2]} vdw={best[3]} elec={best[4]} bsa={best[5]} cl={best[6]}(r{best[7]})\")\n            break\nPYEOF"}

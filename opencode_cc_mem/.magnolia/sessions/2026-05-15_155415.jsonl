{"event_type":"tool_call","timestamp":"2026-06-03T09:30:26.475942Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\n# Atom groups for interaction typing\ndef get_groups(atoms_by_res):\n    \"\"\"Return {group: [(atom_name, xyz)]}\"\"\"\n    groups = defaultdict(list)\n    for (chain, resn, resi, name), xyz in atoms_by_res.items():\n        if name in ('N','H','H1','H2','H3'): groups['backbone-N'].append((name,xyz))\n        elif name in ('O','OXT'): groups['backbone-O'].append((name,xyz))\n        elif resn == 'ARG' and name in ('NH1','NH2','HH11','HH12','HH21','HH22','NE','HE','CZ'):\n            groups['guanidinium'].append((name,xyz))\n        elif resn == 'LYS' and name in ('NZ','HZ1','HZ2','HZ3'):\n            groups['amino'].append((name,xyz))\n        elif resn in ('ASP','GLU') and name in ('OD1','OD2','OE1','OE2','CG','CD'):\n            groups['carboxylate'].append((name,xyz))\n        elif resn in ('SER','THR') and name in ('OG','OG1','HG','HG1'):\n            groups['hydroxyl'].append((name,xyz))\n        elif resn in ('ASN','GLN') and name in ('OD1','ND2','OE1','NE2','HD21','HD22','HE21','HE22'):\n            groups['amide'].append((name,xyz))\n        elif resn in ('TYR') and name in ('OH','HH'):\n            groups['hydroxyl'].append((name,xyz))\n    return groups\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLU',649),('B','ARG',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLU',649):'E3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\n\nmodels = ['cluster_1_model_1.pdb.gz','cluster_1_model_2.pdb.gz','cluster_1_model_3.pdb.gz','cluster_1_model_4.pdb.gz']\n\n# Collect per-residue specific interactions across models\ninteractions = defaultdict(lambda: defaultdict(list))\n\nfor mf in models:\n    all_atoms = read_pdb(mf)\n    \n    # Group receptor atoms by residue\n    rec_residues = defaultdict(list)\n    for k, v in all_atoms.items():\n        if k[0] == 'A':\n            rec_residues[(k[0],k[1],k[2])].append((k[3],v))\n    \n    for pres in PEPTIDE:\n        pep_atoms = [(k[3],v) for k,v in all_atoms.items() if (k[0],k[1],k[2])==pres]\n        pep_groups = get_groups({(pres[0],pres[1],pres[2],n):xyz for n,xyz in pep_atoms})\n        \n        for rres, ratoms in rec_residues.items():\n            rec_groups = get_groups({(rres[0],rres[1],rres[2],n):xyz for n,xyz in ratoms})\n            \n            # Check all group-group distances\n            for pg_name, pg_atoms in pep_groups.items():\n                for rg_name, rg_atoms in rec_groups.items():\n                    min_d = min(dist(pa[1], ra[1]) for pa in pg_atoms for ra in rg_atoms)\n                    if min_d <= 4.0:\n                        pkey = f'{PEP_NAMES[pres]}-{pg_name}'\n                        rkey = f'{rres[1]}{rres[2]}-{rg_name}'\n                        interactions[pkey][rkey].append(min_d)\n\nprint('=== SPECIFIC INTERACTIONS (across 4 models, dist <= 4.0A) ===')\nprint()\nfor pkey in sorted(interactions.keys()):\n    counts = len(interactions[pkey])\n    recs = interactions[pkey]\n    avg_recs = []\n    for rk, dists in sorted(recs.items()):\n        avg_d = sum(dists)/len(dists)\n        if avg_d <= 3.5:\n            avg_recs.append((rk, avg_d, len(dists)))\n    if avg_recs:\n        print(f'{pkey} ({counts} receptor contacts across models):')\n        for rk, avg, n in sorted(avg_recs, key=lambda x: x[1]):\n            print(f'  {rk}  avg {avg:.1f}A  (seen in {n}/4 models)')\n        print()\n\n# Identify REPULSIVE / CLASH contacts\nprint()\nprint('=== POTENTIAL CLASHES (same-charge groups <5A) ===')\nfor mf in models:\n    all_atoms = read_pdb(mf)\n    for pk, pxyz in all_atoms.items():\n        if pk[0] != 'B': continue\n        pres = (pk[0], pk[1], pk[2])\n        if pres not in PEPTIDE: continue\n        pname = PEP_NAMES[pres]\n        for rk, rxyz in all_atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                # Check for same-charge groups\n                if pk[1] in ('LYS','ARG') and rk[1] in ('LYS','ARG') and d <= 5.0:\n                    print(f'  +/+ {pname}({pk[1]}) - A-{rk[1]}{rk[2]} : {pk[3]}-{rk[3]} {d:.1f}A')\n                if pk[1] in ('ASP','GLU') and rk[1] in ('ASP','GLU') and d <= 5.0:\n                    print(f'  -/- {pname}({pk[1]}) - A-{rk[1]}{rk[2]} : {pk[3]}-{rk[3]} {d:.1f}A')\nPYEOF\n"}

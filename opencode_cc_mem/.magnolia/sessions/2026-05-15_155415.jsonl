{"event_type":"tool_call","timestamp":"2026-06-20T08:59:44.104390Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas && python3 << 'PYEOF'\nimport csv, re, os\n\npub = {}\nwith open(\"raw_input/compas_data/compas-1x.csv\") as f:\n    for r in csv.DictReader(f):\n        pub[r['molecule']] = {\n            'HOMO': float(r['HOMO_eV']), 'LUMO': float(r['LUMO_eV']),\n            'GAP': float(r['GAP_eV']), 'Etot': float(r['Etot_eV']),\n            'rings': int(r['n_rings']), 'Erel': float(r['Erel_eV'])\n        }\n\nwith open(\"raw_input/compas_data/selected_molecules.csv\") as f:\n    selected = list(csv.DictReader(f))\n\nrd = \"runs/2026-06-20_compas_xtb_validation\"\n\nprint(\"=\" * 125)\nprint(\"COMPAS-1x REPRODUCTION \u2014 FULL RESULTS\")\nprint(\"=\" * 125)\nprint()\nprint(\"OUR output files:  runs/2026-06-20_compas_xtb_validation/output/<molecule>.out\")\nprint(\"                   (xtb 6.7.1 GFN2-xTB single-point on xtb-optimized geometry)\")\nprint(\"REFERENCE values:  raw_input/compas_data/compas-1x.csv\")\nprint(\"                   (xtb 6.2 GFN2-xTB, from https://gitlab.com/porannegroup/compas)\")\nprint()\n\nfor m in selected:\n    name = m['molecule']\n    outfile = f\"{rd}/output/{name}.out\"\n    \n    with open(outfile) as f:\n        text = f.read()\n    \n    etot_au = float(re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text).group(1))\n    gap_ev  = float(re.search(r'HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV', text).group(1))\n    homo_ev = float(re.findall(r'(-?[\\d.]+)\\s+\\(HOMO\\)', text)[-1])\n    lumo_ev = float(re.findall(r'(-?[\\d.]+)\\s+\\(LUMO\\)', text)[-1])\n    etot_ev = etot_au * 27.2114\n    \n    p = pub[name]\n    dh = homo_ev - p['HOMO']\n    dl = lumo_ev - p['LUMO']\n    dg = gap_ev - p['GAP']\n    de = etot_ev - p['Etot']\n    \n    print(f\"{name:35s}  {p['rings']:2d} rings  Erel={p['Erel']:.2f}\")\n    print(f\"  HOMO:  {homo_ev:10.4f} eV  (from {name}.out, grep '(HOMO)')\")\n    print(f\"         {p['HOMO']:10.4f} eV  (from compas-1x.csv, col HOMO_eV)\")\n    print(f\"         {'\u0394 = %+.4f eV' % dh:>15s}\")\n    print(f\"  LUMO:  {lumo_ev:10.4f} eV  (from {name}.out, grep '(LUMO)')\")\n    print(f\"         {p['LUMO']:10.4f} eV  (from compas-1x.csv, col LUMO_eV)\")\n    print(f\"         {'\u0394 = %+.4f eV' % dl:>15s}\")\n    print(f\"  GAP:   {gap_ev:10.4f} eV  (from {name}.out, grep 'HOMO-LUMO GAP')\")\n    print(f\"         {p['GAP']:10.4f} eV  (from compas-1x.csv, col GAP_eV)\")\n    print(f\"         {'\u0394 = %+.4f eV' % dg:>15s}\")\n    print(f\"  Etot:  {etot_ev:10.3f} eV  (from {name}.out, grep 'TOTAL ENERGY' \u2192 Eh\u00d727.2114)\")\n    print(f\"         {p['Etot']:10.3f} eV  (from compas-1x.csv, col Etot_eV)\")\n    print(f\"         {'\u0394 = %+.3f eV' % de:>15s}\")\n    print()\n\n# Summary stats\ndiffs_homo = []\ndiffs_gap = []\ndiffs_etot = []\nfor m in selected:\n    name = m['molecule']\n    with open(f\"{rd}/output/{name}.out\") as f:\n        text = f.read()\n    etot_au = float(re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text).group(1))\n    gap_ev  = float(re.search(r'HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV', text).group(1))\n    homo_ev = float(re.findall(r'(-?[\\d.]+)\\s+\\(HOMO\\)', text)[-1])\n    etot_ev = etot_au * 27.2114\n    p = pub[name]\n    diffs_homo.append(homo_ev - p['HOMO'])\n    diffs_gap.append(gap_ev - p['GAP'])\n    diffs_etot.append(etot_ev - p['Etot'])\n\nprint(\"=\" * 125)\nprint(\"SUMMARY (25 molecules)\")\nprint(f\"  MAE HOMO: {sum(abs(d) for d in diffs_homo)/len(diffs_homo):.4f} eV\")\nprint(f\"  MAE GAP:  {sum(abs(d) for d in diffs_gap)/len(diffs_gap):.4f} eV\")\nprint(f\"  MAE Etot: {sum(abs(d) for d in diffs_etot)/len(diffs_etot):.4f} eV\")\nprint(f\"  MAX |\u0394| HOMO: {max(abs(d) for d in diffs_homo):.4f} eV  ({selected[diffs_homo.index(max(diffs_homo,key=abs))]['molecule']})\")\nprint(f\"  MAX |\u0394| GAP:  {max(abs(d) for d in diffs_gap):.4f} eV  ({selected[diffs_gap.index(max(diffs_gap,key=abs))]['molecule']})\")\nprint(f\"  MAX |\u0394| Etot: {max(abs(d) for d in diffs_etot):.3f} eV  ({selected[diffs_etot.index(max(diffs_etot,key=abs))]['molecule']})\")\nPYEOF\n"}

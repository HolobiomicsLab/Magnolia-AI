{"event_type":"tool_call","timestamp":"2026-06-05T08:46:14.786242Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                atoms.append({\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                    'rn': line[17:20].strip(), 'ri': int(line[22:26]), 'c': line[21],\n                })\n    return atoms\n\nbase = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs'\nk5 = read_pdb(f'{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb')\nk11 = read_pdb(f'{base}/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\n\ndef contacts(atoms):\n    ra = [a for a in atoms if a['c']=='A']\n    pa = [a for a in atoms if a['c']=='B']\n    out = {}\n    for r in ra:\n        for p in pa:\n            d = math.sqrt((r['x']-p['x'])**2+(r['y']-p['y'])**2+(r['z']-p['z'])**2)\n            if d <= 5.0:\n                k = (r['rn'], r['ri'], p['rn'], p['ri'])\n                if k not in out or d < out[k]: out[k] = d\n    return out\n\nc5 = contacts(k5)\nc11 = contacts(k11)\n\n# Build rec_resi -> set\ndef rec_set(c):\n    return set((k[0],k[1]) for k in c)\n\nr5, r11 = rec_set(c5), rec_set(c11)\nshared = r5 & r11\nprint(f'Contacts: KFERQ={len(r5)}, KFERQx2={len(r11)}, shared={len(shared)} ({len(shared)/len(r5)*100:.0f}%/{len(shared)/len(r11)*100:.0f}%)')\nprint()\n\n# Per-receptor-residue summary for shared\nprint('=== Shared contacts ===')\nfor rn, ri in sorted(shared):\n    p5 = [(k[2],k[3],c5[k]) for k in c5 if k[0]==rn and k[1]==ri]\n    p11 = [(k[2],k[3],c11[k]) for k in c11 if k[0]==rn and k[1]==ri]\n    s5 = ','.join(f'{n}{i}' for n,i,_ in p5)\n    s11 = ','.join(f'{n}{i}' for n,i,_ in p11)\n    mark = ' ***' if s5 != s11 else ''\n    print(f'  {rn}{ri}: 5mer->{s5:20s} | 11mer->{s11}{mark}')\n\nprint()\nprint('=== 5mer-only contacts ===')\nfor rn, ri in sorted(r5 - r11):\n    p5 = [(k[2],k[3],c5[k]) for k in c5 if k[0]==rn and k[1]==ri]\n    s = ','.join(f'{n}{i}' for n,i,_ in p5)\n    print(f'  {rn}{ri}: {s}')\n\nprint()\nprint('=== 11mer-only contacts (core 647-651) ===')\nfor rn, ri in sorted(r11 - r5):\n    p11 = [(k[2],k[3],c11[k]) for k in c11 if k[0]==rn and k[1]==ri and k[3]<=651]\n    if p11:\n        s = ','.join(f'{n}{i}' for n,i,_ in p11)\n        print(f'  {rn}{ri}: {s}')\n\nprint()\nprint('=== 11mer extra contacts (resi>651) ===')\nfor rn, ri in sorted(r11):\n    p11 = [(k[2],k[3],c11[k]) for k in c11 if k[0]==rn and k[1]==ri and k[3]>651]\n    if p11:\n        s = ','.join(f'{n}{i}' for n,i,_ in p11)\n        print(f'  {rn}{ri}: {s}')\n\""}

{"event_type":"tool_call","timestamp":"2026-06-11T20:14:43.983319Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 -c \"\nimport os, glob, re\n\ndef get_length(run_name):\n    n = run_name.lower()\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    if 'apkferq' in n or 'kferqp' in n or 'kferq_n-' in n: return 6\n    return 5\n\ndef peptide_name(run_name):\n    name = re.sub(r'^\\d{4}-\\d{2}-\\d{2}_', '', run_name)\n    name = name.replace('_p2rank1', '')\n    return name\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\n\n# Collect all data with verification\nall_data = []\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    n = d.lower()\n    is_relevant = any(x in n for x in ['x2', 'fusion', 'variant', 'apkferq', 'kferqp', 'kferq_n-', 'kferq_p2rank1'])\n    if not is_relevant:\n        continue\n    \n    with open(f) as fh:\n        lines = [l for l in fh if not l.startswith('#') and not l.startswith('cluster_rank')]\n        if not lines:\n            print(f'SKIP {d}: no data rows')\n            continue\n        parts = lines[0].strip().split('\\t')\n        if len(parts) < 30:\n            print(f'SKIP {d}: only {len(parts)} columns')\n            continue\n        \n        # Verify: columns should be cluster_rank(0), cluster_id(1), n(2), under_eval(3),\n        # score(4), score_std(5), irmsd(6), ... dockq(12), ... air(18), air_std(19),\n        # bsa(20), ... desolv(22), ... elec(24), ... vdw(29), caprieval_rank(30)\n        score, air = float(parts[4]), float(parts[18])\n        air_free = score - 0.1 * air\n        dockq = float(parts[12])\n        irmsd = float(parts[6])\n        bsa = float(parts[20])\n        length = get_length(d)\n        \n        all_data.append({\n            'run': d, 'pep': peptide_name(d),\n            'len': length, 'score': score, 'air_free': air_free,\n            'dockq': dockq, 'irmsd': irmsd, 'bsa': bsa,\n        })\n\n# Verification: check KFERQ parent\nparent = [r for r in all_data if 'KFERQ_p2rank1_s5000' in r['run'] and '2026-06-02' in r['run']]\nprint(f'Parent KFERQ: found {len(parent)} entries')\nif parent:\n    p = parent[0]\n    print(f'  AIR-free={p[\\\"air_free\\\"]:.2f}, DockQ={p[\\\"dockq\\\"]:.3f}, BSA={p[\\\"bsa\\\"]:.0f}')\n    parent_af = p['air_free']\n\n# Check ApKFERQ\nap = [r for r in all_data if 'ApKFERQ' in r['run']]\nprint(f'ApKFERQ: found {len(ap)} entries')\nif ap:\n    a = ap[0]\n    print(f'  AIR-free={a[\\\"air_free\\\"]:.2f}, DockQ={a[\\\"dockq\\\"]:.3f}, BSA={a[\\\"bsa\\\"]:.0f}')\n\n# Verify N-LYS superpostion result is FAR mode\nnlys = [r for r in all_data if 'N-LYS' in r['run']]\nprint(f'N-LYS: {len(nlys)} entries, score={nlys[0][\\\"air_free\\\"]:.2f} if nlys else \\\"missing\\\"')\n\n# Verify N-VAL superposition result is DIFF mode\nnval = [r for r in all_data if 'N-VAL' in r['run']]\nprint(f'N-VAL: {len(nval)} entries, score={nval[0][\\\"air_free\\\"]:.2f} if nval else \\\"missing\\\"')\n\n# Verify fusion length\nfusion = [r for r in all_data if 'fusion' in r['run']]\nprint(f'Fusion: len={fusion[0][\\\"len\\\"]}, AIR-free={fusion[0][\\\"air_free\\\"]:.2f} if fusion else \\\"missing\\\"')\n\n# Verify KFERQx2 length\nx2 = [r for r in all_data if 'KFERQx2' in r['run'] and 'fusion' not in r['run']]\nprint(f'KFERQx2: len={x2[0][\\\"len\\\"]}, AIR-free={x2[0][\\\"air_free\\\"]:.2f} if x2 else \\\"missing\\\"')\n\nprint()\nprint(f'Total entries: {len(all_data)}')\nprint()\n\n# Check for duplicate named entries\nfrom collections import Counter\nnames = [r['pep'] for r in all_data]\ndupes = [n for n, c in Counter(names).items() if c > 1]\nif dupes:\n    print(f'DUPLICATE NAMES: {dupes}')\nelse:\n    print('No duplicate names')\n\""}

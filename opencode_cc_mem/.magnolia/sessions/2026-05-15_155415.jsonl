{"event_type":"tool_call","timestamp":"2026-07-01T07:54:50.819084Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_all_clusters(run_dir):\n    \"\"\"Get best model per cluster from 12_caprieval or 09_caprieval\"\"\"\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{run_dir}/output/{sfx}/capri_ss.tsv\"\n        if not os.path.exists(ss): continue\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','?')\n            if not cid.isdigit(): continue\n            cid = int(cid)\n            score = float(row['score'])\n            air = float(row.get('air',0))\n            af = score - 0.1*air\n            if cid not in clusters or af < clusters[cid]['af']:\n                clusters[cid] = {\n                    'af': af, 'score': score, 'dq': float(row.get('dockq',0)),\n                    'irmsd': float(row.get('irmsd',0)), 'lrmsd': float(row.get('lrmsd',0)),\n                    'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n                    'bsa': float(row.get('bsa',0)), 'fnat': float(row.get('fnat',0)),\n                }\n        # Get cluster sizes from clustfcc\n        clf = f\"{run_dir}/output/10_clustfcc/clustfcc.txt\"\n        sizes = {}\n        with open(clf) as f:\n            for line in f:\n                m = re.search(r'Cluster (\\d+) \\(#\\d+, n=(\\d+),', line)\n                if m: sizes[int(m.group(1))] = int(m.group(2))\n        return clusters, sizes, sfx\n    return {}, {}, '?'\n\n# All runs with all clusters\nruns = [\n    (\"EGGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\"),\n    (\"EAGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\"),\n    (\"EGGFQMAKT\", \"L8\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\"),\n    (\"EGGFQMART\", \"L8\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\"),\n    (\"EAKFQMALT\", \"G3\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\"),\n    (\"EAGFQMRLT\", \"A7\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\"),\n    (\"EAGFQMKLT\", \"A7\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\"),\n]\n\nfor pep, mut, d in runs:\n    clusters, sizes, sfx = get_all_clusters(d)\n    print(f\"\\n=== {pep} ({mut}) [{sfx}] ===\")\n    print(f\"  {'Cl':>3s} {'n':>4s} {'AIR-free':>9s} {'DockQ':>7s} {'irmsd':>6s} {'lrmsd':>6s} {'vdw':>8s} {'elec':>8s} {'bsa':>5s} {'fnat':>5s}\")\n    for cid in sorted(clusters.keys()):\n        c = clusters[cid]\n        n = sizes.get(cid, '?')\n        print(f\"  {cid:>3d} {str(n):>4s} {c['af']:>+9.2f} {c['dq']:>7.3f} {c['irmsd']:>6.2f} {c['lrmsd']:>6.1f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['bsa']:>5.0f} {c['fnat']:>5.3f}\")\nPYEOF"}

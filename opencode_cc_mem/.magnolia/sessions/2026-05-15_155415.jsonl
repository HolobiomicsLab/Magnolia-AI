{"event_type":"tool_call","timestamp":"2026-06-10T14:08:05.470249Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\npython3 << 'PYEOF'\nimport math\n\nrec_atoms = []\nwith open('receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\ndef parse_top_pose(sdf_path):\n    with open(sdf_path) as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        emp_aff = 0; na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        lig = []\n        for i in range(atom_start, min(atom_start+na, len(lines))):\n            l = lines[i]\n            if len(l) < 30: continue\n            try: x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n            except: continue\n            elem = l[31:34].strip() or 'C'\n            lig.append((elem, x, y, z))\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, lig)\n    return best\n\nligands = [\n    ('Z11-16-Ald',   'good',       'docked_flex8_Z11-16-Ald_asn90.sdf', 1.66),\n    ('Z11-16-Ac',    'non-binder', 'docked_flex8_Z11-16-Ac_asn90.sdf', 200),\n    ('Z11-16-OH',    'weak',       'docked_flex8_Z11-16-OH_asn90.sdf', 18),\n    ('Palmitic acid','non-binder', 'docked_flex8_Palmitic_acid_asn90.sdf', 200),\n    ('Cedrol',       'good',       'docked_flex8_Cedrol_asn90.sdf', 1.7),\n    ('\u03b2-Ionone',     'good',       'docked_flex8_\u03b2-Ionone_asn90.sdf', 1.4),\n]\n\nprint(f\"{'Ligand':16s} {'IC50':>6s} {'aff':>6s} {'contacts':>9s} {'avg_d':>7s} {'clash(<2.8A)':>12s} {'close(<3.2)':>10s} {'shape?':>8s}\")\nprint(\"-\" * 80)\n\nfor name, cls, fname, ic50 in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, lig_atoms = result\n    \n    all_dists = []\n    clashers = 0  # d < 2.8A (vdW clash)\n    close = 0     # d < 3.2A (tight contact)\n    \n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                all_dists.append(d)\n                if d < 2.8: clashers += 1\n                if d < 3.2: close += 1\n    \n    avg_d = sum(all_dists)/len(all_dists) if all_dists else 0\n    \n    print(f\"{name:16s} {ic50:>6.1f} {emp_aff:>6.1f} {len(all_dists):>9d} {avg_d:>6.2f}\u00c5 {clashers:>12d} {close:>10d}\")\n\n# The Vina scoring function uses a weighted sum of steric, hydrophobic, and H-bond terms.\n# Steric term: gauss1(o,d) = exp(-(d-o)^2/0.5) for attractive, gauss2(o,d) = exp(-(d-o)^2/3.0) for repulsive\n# The key: repulsive term dominates at short distances\n# If non-binders have MORE very close contacts (<3.0A), Vina should penalize them\n\nPYEOF"}

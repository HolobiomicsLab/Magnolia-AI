{"event_type":"tool_call","timestamp":"2026-06-21T16:14:14.983907Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/studium/studium && .venv/bin/python <<'PYEOF'\nimport fitz, re, json\nfrom pathlib import Path\n\npdf = fitz.open('courses_raw_input/l1-courschimie-smd.pdf')\n\n# Common page-header/footer strings to filter (across all chapters)\nHEADER_FOOTER = {\n    \"Spectroscopies\", \"Structure des mol\u00e9cules\", \"Interactions intermol\u00e9culaires\",\n    \"Structure de l'atome\", \"Nicolas Ch\u00e9ron\",\n    \"PSL \u2013 Licence SMD \u2013 L1 Chimie \u2013 2024-2025\",\n    \"PSL \u2013 Licence Sciences pour un Monde Durable \u2013 2024-2025\",\n}\n\ndef is_garbage(text):\n    s = text.strip()\n    if not s: return True\n    if s in HEADER_FOOTER: return True\n    if s.isdigit(): return True\n    words = re.findall(r\"[A-Za-z\u00c0-\u00ff]{3,}\", s)\n    return len(s) > 4 and sum(len(w) for w in words) / len(s) < 0.25\n\ndef is_figure_label(text):\n    return bool(re.match(r\"^(Figure|Fig\\.|Tableau|Table|Sch\u00e9ma)\\s*\\d+\", text.strip(), re.IGNORECASE))\n\ndef extract_chunk(start_page, end_page, chunk_title, chunk_summary):\n    \"\"\"Extract pages [start_page, end_page] (1-indexed inclusive) as cleaned markdown.\"\"\"\n    md = [f\"# {chunk_title}\", \"\",\n          f\"_Source : \u00ab Introduction \u00e0 la chimie \u00bb, Nicolas Ch\u00e9ron, PSL \u2014 Licence Sciences pour un Monde Durable, 2024-2025, p.{start_page}-{end_page}._\",\n          \"\"]\n    for pno in range(start_page - 1, end_page):\n        page = pdf[pno]\n        d = page.get_text('dict')\n        for block in d.get('blocks', []):\n            block_spans = [s for line in block.get('lines', []) for s in line.get('spans', [])]\n            if not block_spans: continue\n            max_size = max(s['size'] for s in block_spans)\n            block_lines = []\n            for line in block.get('lines', []):\n                ln = ''.join(s['text'] for s in line.get('spans', [])).strip()\n                if ln and not is_garbage(ln) and not is_figure_label(ln):\n                    block_lines.append(ln)\n            if not block_lines: continue\n            text = ' '.join(block_lines)\n            title_only = re.sub(r\"^\\s*\\d+\\)\\s+\", \"\", text)\n            title_only = re.sub(r\"^\\s*\\d+\\.\\s+\", \"\", title_only)\n            if max_size >= 19:\n                continue  # 20pt chapter title \u2014 chunk_title above already covers it\n            elif max_size >= 15:\n                md.append(f\"## {title_only}\")\n                md.append(\"\")\n            elif max_size >= 13 and re.match(r\"^\\s*\\d+\\.\\s+\", text):\n                md.append(f\"### {title_only}\")\n                md.append(\"\")\n            else:\n                md.append(text)\n                md.append(\"\")\n    output = re.sub(r\"\\n{3,}\", \"\\n\\n\", \"\\n\".join(md)).strip() + \"\\n\"\n    return output\n\n# Chunk specs: (id, start_page, end_page, slug, title, summary)\nchunks = [\n    (\"05\",  5, 20, \"05-atomistique-1\",\n     \"Structure de l'atome (1/2) \u2014 Origines quantiques et atome d'hydrog\u00e8ne\",\n     \"Premi\u00e8re partie du chapitre d'atomistique : interaction lumi\u00e8re-mati\u00e8re, spectres d'\u00e9mission et d'absorption, d\u00e9buts de la m\u00e9canique quantique, \u00e9quation de Schr\u00f6dinger, atomes \u00e0 un \u00e9lectron (orbitales, nombres quantiques).\"),\n    (\"06\", 21, 35, \"06-atomistique-2\",\n     \"Structure de l'atome (2/2) \u2014 Atomes poly\u00e9lectroniques et classification p\u00e9riodique\",\n     \"Seconde partie du chapitre d'atomistique : principe de Pauli, r\u00e8gle de Hund, structure \u00e9lectronique des atomes, classification p\u00e9riodique, \u00e9volution des propri\u00e9t\u00e9s atomiques, \u00e9l\u00e9ments dans la nature.\"),\n    (\"07\", 36, 40, \"07-atomistique-annexes\",\n     \"Structure de l'atome \u2014 Annexes\",\n     \"Compl\u00e9ments du chapitre d'atomistique : \u00e9l\u00e9ments imaginaires, constantes physiques, principe d'incertitude de Heisenberg, \u00e9quation de Schr\u00f6dinger (forme g\u00e9n\u00e9rale), chat de Schr\u00f6dinger, atomes poly\u00e9lectroniques, isotopes naturels.\"),\n    (\"08\", 41, 50, \"08-molecules-lewis-vsepr\",\n     \"Structure des mol\u00e9cules (1/3) \u2014 Sch\u00e9ma de Lewis et m\u00e9thode VSEPR\",\n     \"Premi\u00e8re partie du chapitre sur la structure mol\u00e9culaire : \u00e9lectrons de valence, r\u00e8gle de l'octet, sch\u00e9mas de Lewis, m\u00e9som\u00e9rie, hypervalence, types de liaisons, moment dipolaire, m\u00e9thode VSEPR.\"),\n    (\"09\", 51, 63, \"09-molecules-geometrie\",\n     \"Structure des mol\u00e9cules (2/3) \u2014 Groupements chimiques et g\u00e9om\u00e9trie\",\n     \"Seconde partie du chapitre sur la structure mol\u00e9culaire : nomenclature, propri\u00e9t\u00e9s des groupements, conformations, configurations, st\u00e9r\u00e9oisom\u00e9ries.\"),\n    (\"10\", 64, 68, \"10-molecules-orbitales\",\n     \"Structure des mol\u00e9cules (3/3) \u2014 Annexes : orbitales mol\u00e9culaires\",\n     \"Compl\u00e9ments du chapitre sur la structure mol\u00e9culaire : orbitales mol\u00e9culaires, combinaison lin\u00e9aire d'orbitales atomiques (CLOA), construction des orbitales du dihydrog\u00e8ne, \u00e9nergie des OM, transitions entre OM.\"),\n    (\"11\", 69, 79, \"11-interactions-intermoleculaires\",\n     \"Interactions intermol\u00e9culaires\",\n     \"Dip\u00f4les permanents et induits, interactions attractives et r\u00e9pulsives, liaisons hydrog\u00e8ne, solubilit\u00e9. Cons\u00e9quences sur les changements d'\u00e9tat et les propri\u00e9t\u00e9s macroscopiques.\"),\n]\n\n# Extract + write all chunks\nmanifest_additions = []\nfor cid, start, end, slug, title, summary in chunks:\n    body = extract_chunk(start, end, title, summary)\n    path = f\"eval/corpus/{slug}.md\"\n    Path(path).write_text(body, encoding=\"utf-8\")\n    print(f\"  {cid}: p.{start}-{end:>2}  {len(body):>6} chars  \u2192 {path}\")\n    manifest_additions.append({\n        \"id\": cid,\n        \"title\": title,\n        \"discipline\": \"chemistry\",\n        \"branch\": \"sciences\",\n        \"level\": \"L1\",\n        \"local_path\": path,\n        \"word_count\": len(body.split()),\n        \"summary\": summary,\n        \"license\": \"PSL \u2014 Nicolas Ch\u00e9ron (for local testing; not for redistribution)\",\n        \"source_url\": f\"local://courses_raw_input/l1-courschimie-smd.pdf#p{start}-{end}\",\n    })\n\n# Update manifest \u2014 append new entries (preserve existing 01-04)\nm = json.load(open(\"eval/corpus/manifest.json\", encoding=\"utf-8\"))\nexisting_ids = {e[\"id\"] for e in m}\nfor entry in manifest_additions:\n    if entry[\"id\"] not in existing_ids:\n        m.append(entry)\nwith open(\"eval/corpus/manifest.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(m, f, indent=2, ensure_ascii=False)\nprint(f\"\\nmanifest: {len(m)} entries total ({sorted(e['id'] for e in m)})\")\nPYEOF\necho \"\"; echo \"=== verify --list ===\" && .venv/bin/python eval/run_eval.py --list"}

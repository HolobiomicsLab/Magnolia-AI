{"event_type":"tool_call","timestamp":"2026-06-16T13:55:59.360984Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport numpy as np, gzip\n\ndef parse_pdb(path, zipped=False):\n    coords = {}\n    opener = gzip.open if zipped else open\n    with opener(path, 'rt') as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            if line[12:16].strip() != 'CA': continue\n            chain = line[21]\n            if chain != 'A': continue\n            resi = int(line[22:26].strip())\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            coords[resi] = np.array([x, y, z])\n    return coords\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\norig = parse_pdb(f\"{BASE}/raw_input/receptor/4po2_chainA.pdb\")\n\n# Compute Kabsch on SBD\u03b2 only, then apply to all\nbeta_resi = [r for r in orig.keys() if 386 <= r <= 510]\n\nfor peptide, rd in [(\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000_full\"),\n                      (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000_full\"),\n                      (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000_full\")]:\n    \n    model_gz = f\"{BASE}/runs/{rd}/output/11_seletopclusts/cluster_1_model_1.pdb.gz\"\n    docked = parse_pdb(model_gz, zipped=True)\n    \n    common_beta = sorted(set(beta_resi) & set(docked.keys()))\n    \n    # Kabsch on SBD\u03b2\n    P = np.array([docked[r] for r in common_beta])\n    Q = np.array([orig[r] for r in common_beta])\n    p_mean, q_mean = P.mean(axis=0), Q.mean(axis=0)\n    P, Q = P - p_mean, Q - q_mean\n    C = P.T @ Q\n    V, S, Wt = np.linalg.svd(C)\n    d = np.sign(np.linalg.det(V @ Wt))\n    R = V @ np.diag([1, 1, d]) @ Wt\n    \n    # Apply rotation to ALL docked residues, then compute per-residue dev\n    binding = [403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473]\n    lid = [545,548,552,558,561,600,607,610,611]\n    \n    common_all = sorted(set(orig.keys()) & set(docked.keys()))\n    \n    sbd_beta_devs = []\n    sbd_alpha_devs = []\n    \n    print(f\"--- {peptide} ---\")\n    print(f\"  Groove residues:\")\n    for r in binding:\n        if r in common_all:\n            d_rot = (docked[r] - p_mean) @ R + q_mean\n            dev = np.linalg.norm(d_rot - orig[r])\n            print(f\"    {r}: {dev:.2f} \u00c5\")\n    \n    print(f\"  Lid residues:\")\n    for r in lid:\n        if r in common_all:\n            d_rot = (docked[r] - p_mean) @ R + q_mean\n            dev = np.linalg.norm(d_rot - orig[r])\n            print(f\"    {r}: {dev:.2f} \u00c5\")\n    print()\n\nPYEOF"}

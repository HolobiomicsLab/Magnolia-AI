{"event_type":"tool_call","timestamp":"2026-06-19T11:54:49.156858Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c curl -s \"http://localhost:8000/api/jobs/47ca73de-0b03-4ea5-8006-7850bee76314\" | python3 -c \"\nimport sys,json,urllib.request\nd=json.load(sys.stdin)\ndois = [(c['score'], c['doi']) for c in d['result']['candidates'] if c['score'] > 0.5]\ndois.sort(key=lambda x: -x[0])\nfor score, doi in dois:\n    try:\n        req = urllib.request.Request(f'http://localhost:8000/api/paper?doi={urllib.request.quote(doi)}')\n        with urllib.request.urlopen(req, timeout=10) as resp:\n            p = json.loads(resp.read())\n        title = p.get('title','?')\n        abstract = (p.get('abstract') or '')[:250].replace(chr(10),' ')\n        print(f'{score:.3f}  {title[:90]}')\n        print(f'         {abstract}')\n        print()\n    except Exception as e:\n        print(f'{score:.3f}  FAIL: {doi} ({e})')\n        print()\n\" 2>&1"}

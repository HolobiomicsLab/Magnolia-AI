{"event_type":"tool_call","timestamp":"2026-06-18T13:40:52.216427Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, math\n\ndef parse_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                })\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a['x']-b['x'])**2 + (a['y']-b['y'])**2 + (a['z']-b['z'])**2)\n\natoms = parse_pdb('projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\n\n# Get A3 atoms\na3 = [a for a in atoms if a['chain'] == 'B' and a['resi'] == 3]\nrec_atoms = [a for a in atoms if a['chain'] == 'A']\n\nca = [a for a in a3 if a['name'] == 'CA'][0]\ncb = [a for a in a3 if a['name'] == 'CB'][0]\n\n# Direction vectors\ncb_dir = (cb['x'] - ca['x'], cb['y'] - ca['y'], cb['z'] - ca['z'])\nl = math.sqrt(cb_dir[0]**2 + cb_dir[1]**2 + cb_dir[2]**2)\nu = (cb_dir[0]/l, cb_dir[1]/l, cb_dir[2]/l)\n\n# Perpendicular directions to sweep laterally\nif abs(u[0]) < 0.9:\n    perp1 = (-u[1], u[0], 0)\nelse:\n    perp1 = (0, -u[2], u[1])\nl1 = math.sqrt(perp1[0]**2 + perp1[1]**2 + perp1[2]**2)\nperp1 = (perp1[0]/l1, perp1[1]/l1, perp1[2]/l1)\nperp2 = (u[1]*perp1[2] - u[2]*perp1[1], u[2]*perp1[0] - u[0]*perp1[2], u[0]*perp1[1] - u[1]*perp1[0])\n\n# For each residue type, estimate maximum extension radius\n# ALA: CB only, ~1.5\u00c5 beyond CB\n# VAL: CB + CG1/CG2, ~2.5\u00c5 beyond CB  \n# ILE: CB + CG1/CG2, ~3.0\u00c5 beyond CB with branching\n# LEU: CB + CG + CD1/CD2, ~4.0\u00c5 beyond CB\n# PHE: CB + CG + ring, ~4.5\u00c5 beyond CB with ring plane\n\nprint(\"RKALQ A3 \u2014 checking CB-direction space and lateral space\")\nprint(f\"CB direction: ({u[0]:.2f}, {u[1]:.2f}, {u[2]:.2f})\")\nprint()\n\n# Check along CB direction\nprint(\"=== Along CB direction ===\")\nfor label, dist_out in [(\"ALA methyl\", 1.5), (\"VAL branch\", 2.5), (\"ILE branch\", 3.0), (\"LEU tip\", 4.0), (\"PHE ring edge\", 4.5)]:\n    # Probe at CB + dist_out * sqrt(3)/2 in CB direction + some lateral sweep\n    min_dist = 99\n    for angle in range(0, 360, 30):\n        rad = math.radians(angle)\n        # Sweep a cone of 30 degrees around CB direction\n        cone_r = dist_out * 0.3\n        lateral = (perp1[0]*cone_r*math.cos(rad) + perp2[0]*cone_r*math.sin(rad),\n                   perp1[1]*cone_r*math.cos(rad) + perp2[1]*cone_r*math.sin(rad),\n                   perp1[2]*cone_r*math.cos(rad) + perp2[2]*cone_r*math.sin(rad))\n        forward = dist_out * 0.95\n        probe = (cb['x'] + u[0]*forward + lateral[0],\n                 cb['y'] + u[1]*forward + lateral[1],\n                 cb['z'] + u[2]*forward + lateral[2])\n        d = min(dist_xyz(probe, (ra['x'], ra['y'], ra['z'])) for ra in rec_atoms)\n        min_dist = min(min_dist, d)\n    \n    if min_dist > 2.5:\n        status = \"\u2713 CLEAR\"\n    elif min_dist > 1.5:\n        status = \"TIGHT\"\n    else:\n        status = \"CLASH\"\n    print(f\"  {label:20s} \u2192 nearest receptor: {min_dist:.1f}\u00c5  [{status}]\")\n\n# Also check: what receptor atoms are closest to CB\nprint(\"\\n=== Nearest receptor atoms to CB ===\")\ncb_near = [(dist(cb, ra), ra) for ra in rec_atoms]\ncb_near.sort()\nfor d, ra in cb_near[:6]:\n    print(f\"  {ra['chain']}-{ra['resi']}-{ra['resn']} {ra['name']:5s}  {d:.1f}\u00c5\")\n\ndef dist_xyz(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPYEOF"}

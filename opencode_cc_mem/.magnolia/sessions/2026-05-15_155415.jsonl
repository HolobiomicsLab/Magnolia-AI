ind,b['el']))\nallc.sort(key=lambda x:x[3])\nfor ri,rn,an,dd,el in allc[:12]:\n    region=\"\u03b2-groove\" if 388<=ri<=508 else (\"lid\" if 509<=ri<=613 else \"post-lid\")\n    print(f\"  A-{ri}-{rn:3s} {an:4s} [{region}] {el}:  {dd:.2f} \u00c5\")\n\nprint(\"\\nPEPTIDE per-residue burial count (n receptor apolar heavy atoms <=4.5 \u00c5):\")\npep=[(2,\"T1\"),(3,\"G2\"),(4,\"G3\"),(5,\"F4\"),(6,\"Q5\"),(7,\"M6\"),(8,\"A7\"),(9,\"L8\"),(10,\"T9\")]\nfor pri,lab in pep:\n    pa=ra(\"B\",pri)\n    recs=set()\n    for a in pa:\n        if a['el']==\"H\": continue\n        for ri in list(range(388,647)):\n            for b in ra(\"A\",ri):\n                if b['el'] in (\"C\",\"S\") and d(a,b)<=4.5: recs.add(ri)\n    # also count all heavy contacts (any element)\n    allrecs=set()\n    for a in pa:\n        if a['el']==\"H\": continue\n        for ri in list(range(388,647)):\n            for b in ra(\"A\",ri):\n                if d(a,b)<=4.5: allrecs.add(ri)\n    print(f\"  B-{pri} ({lab}): {len(allrecs)} receptor residues <=4.5 \u00c5 ({len(recs)} apolar)\")\n\nprint(\"\\nQ5 (B-6 GLN) polar sidechain contacts (NE2/OE1 <=4.5 \u00c5):\")\nfor pan in [\"NE2\",\"OE1\",\"CD\",\"CG\"]:\n    a=atom(\"B\",6,pan)\n    if a is None: continue\n    cands=[]\n    for ri in list(range(388,647)):\n        for b in ra(\"A\",ri):\n            dd=d(a,b)\n            if dd<=4.5 and b['el']!=\"H\": cands.append((ri,b['rn'],b['an'],dd,b['el']))\n    cands.sort(key=lambda x:x[3])\n    print(f\"  Q5 {pan}:\")\n    for ri,rn,an,dd,el in cands[:4]:\n        print(f\"    A-{ri}-{rn} {an} ({el}): {dd:.2f} \u00c5\")\nPYEOF\npython3 /tmp/measure4.py"}

{"event_type":"tool_call","timestamp":"2026-06-16T13:29:52.740605Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os\n\nBASE = \"runs\"\nPEPTIDES = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\", 3),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\", 1),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\", 1),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\", 3),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\", 1),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\", 1),\n]\n\n# MM-GBSA data from previous run\nmmgbsa = {\n    \"KFERQ\": [(\"LYS647\", 27.6), (\"PHE648\", 1.4), (\"GLU649\", -1.0), (\"ARG650\", 6.8), (\"GLN651\", 6.1)],\n    \"KILDQ\": [(\"LYS652\", 6.0), (\"ILE653\", 0.4), (\"LEU654\", -1.6), (\"ASP655\", 1.9), (\"GLN656\", 11.9)],\n    \"RKDLQ\": [(\"ARG1\", 6.9), (\"LYS2\", 27.0), (\"ASP3\", 1.1), (\"LEU4\", -7.5), (\"GLN5\", 4.3)],\n    \"RKELQ\": [(\"ARG652\", 51.8), (\"LYS653\", 3.0), (\"GLU654\", -1.6), (\"LEU655\", -0.6), (\"GLN656\", 0.6)],\n    \"QRKEL\": [(\"GLN652\", 48.3), (\"ARG653\", 2.8), (\"LYS654\", -0.8), (\"GLU655\", -3.4), (\"LEU656\", 1.4)],\n    \"HAMNG\": [(\"HIS1\", 8.5), (\"ALA2\", -3.3), (\"MET3\", -4.4), (\"ASN4\", -1.8), (\"GLY5\", 9.5)],\n}\n\n# HADDOCK3 scores\nhaddock = {\"KFERQ\": -30.55, \"KILDQ\": -53.39, \"RKDLQ\": -58.02, \"RKELQ\": -25.45, \"QRKEL\": -52.79, \"HAMNG\": -67.84}\n\nprint(f\"{'Peptide':<10} {'Res':<8} {'MM-GBSA':<8} {'Contacts':<10} {'Shortest':<10} {'Top receptor partners'}\")\nprint(\"-\" * 85)\n\nfor tag, rd, best_clt in PEPTIDES:\n    cmdir = f\"{BASE}/{rd}/output/8_contactmap\"\n    tsv = f\"{cmdir}/cluster{best_clt}_interchain_contacts.tsv\"\n    \n    if not os.path.exists(tsv):\n        print(f\"{tag:<10} NO FILE\")\n        continue\n    \n    contacts = {}\n    with open(tsv) as f:\n        for line in f:\n            if line.startswith('#'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 7:\n                continue\n            res1 = parts[0]  # A-582-ASP\n            res2 = parts[1]  # B-647-LYS\n            shortest = float(parts[6])\n            \n            # Extract peptide residue\n            for r in [res1, res2]:\n                if r.startswith('B-'):\n                    parts_r = r.split('-')\n                    pep_res = f\"{parts_r[2]}{parts_r[1]}\"  # LYS647\n                    if pep_res not in contacts:\n                        contacts[pep_res] = {'n': 0, 'mindist': 999, 'partners': []}\n                    contacts[pep_res]['n'] += 1\n                    contacts[pep_res]['mindist'] = min(contacts[pep_res]['mindist'], shortest)\n                    # Get receptor partner\n                    rec = res1 if r == res2 else res2\n                    contacts[pep_res]['partners'].append(rec)\n    \n    # Match with MM-GBSA order\n    for res_name, mm_energy in mmgbsa.get(tag, []):\n        info = contacts.get(res_name, {'n': 0, 'mindist': 0.0, 'partners': []})\n        top_partners = sorted(info['partners'], \n            key=lambda x: min(999, 0) if not contacts.get(res_name) else 0)[:3]\n        # Get shortest 3 partner distances\n        partner_strs = []\n        seen_recs = set()\n        for p in info['partners']:\n            rec_id = p.split('-')[1] + p.split('-')[2]\n            if rec_id not in seen_recs:\n                seen_recs.add(rec_id)\n                partner_strs.append(p)\n                if len(partner_strs) >= 3:\n                    break\n        \n        print(f\"{tag:<10} {res_name:<8} {mm_energy:+6.1f}   {info['n']:<8}  {info['mindist']:<8.1f}  {', '.join(partner_strs)}\")\n    print()\n\nPYEOF"}

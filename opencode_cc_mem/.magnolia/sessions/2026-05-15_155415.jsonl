{"event_type":"tool_call","timestamp":"2026-06-17T20:07:56.115145Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\npeptides = {\n    \"RKDLQ\":  f\"{ROOT}/2026-06-16_af3_RKDLQ_s5000_full/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKALQ\":  f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKGLQ\":  f\"{ROOT}/2026-06-17_RKGLQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKNLQ\":  f\"{ROOT}/2026-06-17_RKNLQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"TGFMALQ\": f\"{ROOT}/2026-06-17_TGFMALQ_s10000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n}\n\nscores = {\"RKDLQ\":-74.85,\"RKALQ\":-79.15,\"RKGLQ\":-74.98,\"RKNLQ\":-71.96,\"TGFMALQ\":-87.68}\nper_res_score = {\"RKDLQ\":-14.97,\"RKALQ\":-15.83,\"RKGLQ\":-15.00,\"RKNLQ\":-14.39,\"TGFMALQ\":-12.53}\nconv_n = {\"RKDLQ\":28,\"RKALQ\":143,\"RKGLQ\":184,\"RKNLQ\":192,\"TGFMALQ\":79}\nconv_p = {\"RKDLQ\":14.0,\"RKALQ\":71.5,\"RKGLQ\":92.0,\"RKNLQ\":96.0,\"TGFMALQ\":39.5}\ndockq  = {\"RKDLQ\":0.825,\"RKALQ\":0.705,\"RKGLQ\":0.745,\"RKNLQ\":0.634,\"TGFMALQ\":0.770}\nnames  = [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\",\"TGFMALQ\"]\n\nall_contacts = {}\nfor name, path in peptides.items():\n    contacts = []\n    with open(path) as f:\n        for line in f:\n            if line[0] == '#' or line.startswith(\"res1\"):\n                continue\n            parts = line.strip().split(\"\\t\")\n            if len(parts) < 7:\n                continue\n            contacts.append({\n                \"rec\": parts[0], \"pep\": parts[1],\n                \"prob\": float(parts[5]), \"dist\": float(parts[6]),\n            })\n    all_contacts[name] = contacts\n\n# TABLE 1\nprint(\"TABLE 1: OVERVIEW\")\nprint(f\"{'Peptide':>10s} {'Score':>8s} {'per/res':>7s} {'DockQ':>6s} {'c1_n':>6s} {'%':>6s} {'Strong':>7s}\")\nprint(\"-\" * 65)\nfor name in names:\n    strong = len([c for c in all_contacts[name] if c[\"prob\"] >= 0.5 and c[\"dist\"] <= 5.0])\n    print(f\"{name:>10s} {scores[name]:8.2f} {per_res_score[name]:7.2f} {dockq[name]:6.3f} {conv_n[name]:6d} {conv_p[name]:5.1f}% {strong:7d}\")\nprint(\"  Strong = prob\u22650.5, dist\u22645.0\u00c5\")\n\n# TABLE 2\nprint()\nprint(\"TABLE 2: L4 ANCHOR CONTACTS (prob\u22650.5, dist\u22645.0\u00c5)\")\nkey_pocket = [\"A-403-ILE\",\"A-404-GLU\",\"A-405-THR\",\"A-406-ALA\",\"A-428-PHE\",\"A-429-THR\",\"A-430-THR\",\"A-431-TYR\",\"A-438-VAL\",\"A-439-LEU\",\"A-440-ILE\"]\nprint(f\"{'Receptor':>14s}\", end=\"\")\nfor name in names:\n    lpos = \"B-6\" if name == \"TGFMALQ\" else \"B-4\"\n    print(f\" {name:>7s}\", end=\"\")\nprint()\nprint(\"-\" * 65)\nfor rec in key_pocket:\n    short = \"-\".join(rec.split(\"-\")[1:])\n    print(f\"{short:>14s}\", end=\"\")\n    for name in names:\n        lpos = \"B-6\" if name == \"TGFMALQ\" else \"B-4\"\n        best_prob = 0.0\n        best_dist = 99.0\n        for c in all_contacts[name]:\n            if c[\"rec\"] == rec and lpos in c[\"pep\"] and \"LEU\" in c[\"pep\"]:\n                if c[\"prob\"] > best_prob:\n                    best_prob = c[\"prob\"]\n                    best_dist = c[\"dist\"]\n        if best_prob >= 0.5:\n            print(f\" \\033[1;32m{best_prob:.2f}\\033[0m\", end=\" \")\n        elif best_prob > 0:\n            print(f\" {best_prob:.2f}\", end=\" \")\n        else:\n            print(f\"   \u2014  \", end=\" \")\n    print()\n\nprint()\nprint(\"  Green = strong contact (\u22650.5 probability)\")\nPYEOF"}

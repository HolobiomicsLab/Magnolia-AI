{"event_type":"tool_call","timestamp":"2026-06-24T14:00:24.657261Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\nR=2026-06-16_af3_TGGFQMALT_s10000_full\necho \"=== which capri_clt files exist? ===\"\nfind $R -name 'capri_clt.tsv' 2>/dev/null\necho \"=== seletopclusts models present? ===\"\nls $R/output/11_seletopclusts/ 2>/dev/null | head\necho \"=== distinct cluster numbers in seletopclusts ===\"\nls $R/output/11_seletopclusts/*.pdb.gz 2>/dev/null | sed -E 's#.*/cluster_([0-9]+)_model.*#\\1#' | sort -un | tr '\\n' ' '; echo\necho\necho \"=== domain-spanning: measure from ALL available cluster_1 models ===\"\npython3 - <<'PY'\nimport gzip,glob,re,os\nR=\"2026-06-16_af3_TGGFQMALT_s10000_full\"\nms=sorted(glob.glob(f\"{R}/output/11_seletopclusts/cluster_*_model_1.pdb.gz\"))\nif not ms:\n    print(\"no seletopclusts models \u2014 run not fetched\"); raise SystemExit\nfor mf in ms:\n    rec={};pep={}\n    with gzip.open(mf,'rt') as fh:\n        for line in fh:\n            if not line.startswith('ATOM'): continue\n            ch=line[21];res=int(line[22:26]);name=line[12:16].strip()\n            if name.startswith('H'): continue\n            try: x,y,z=float(line[30:38]),float(line[38:46]),float(line[46:54])\n            except: continue\n            (pep if ch=='B' else rec).setdefault((ch,res),[]).append((x,y,z))\n    pa=[a for v in pep.values() for a in v]\n    nbd=set();sbd=set()\n    for (ch,res),ats in rec.items():\n        for x,y,z in ats:\n            if any((x-px)**2+(y-py)**2+(z-pz)**2<=25.0 for px,py,pz in pa):\n                (nbd if res<=383 else sbd).add(res); break\n    cl=re.search(r'cluster_(\\d+)_',mf).group(1)\n    v=\"SBD-ONLY \u2713\" if not nbd else f\"SPANS NBD \u2717 {sorted(nbd)}\"\n    sb=f\"[{min(sbd)}-{max(sbd)}]\" if sbd else \"-\"\n    print(f\"  cl{cl}: NBD={len(nbd):2d} SBD={len(sbd):2d} {sb:14s} {v}\")\nPY"}

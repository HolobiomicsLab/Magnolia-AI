{"event_type":"tool_call","timestamp":"2026-07-01T08:45:22.604222Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_contact_zones(run_dir, cluster_id):\n    \"\"\"Get receptor residues contacted by each peptide residue, with distances\"\"\"\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Map: peptide_resnum -> list of (rec_resnum, rec_resname, dist, contact_type)\n    contacts = {}\n    for row in reader:\n        parts1 = row.get('res1','').strip().split('-')\n        parts2 = row.get('res2','').strip().split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1]); rec_res = parts1[2]\n            pep_num = int(parts2[1]); pep_res = parts2[2]\n        except ValueError:\n            continue\n        dist = float(row.get('shortest-dist', 999))\n        ct = row.get('contact-type','')\n        \n        if pep_num not in contacts:\n            contacts[pep_num] = []\n        contacts[pep_num].append((dist, rec_num, rec_res, ct, pep_res))\n    \n    return contacts\n\n# All peptides - groove-only clusters\nruns = [\n    (\"EGGFQMALT\",  \"EGGFQMALT parent\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1),\n    (\"EAGFQMALT\",  \"EAGFQMALT parent\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\", 3),\n    (\"EGGFQMAKT\",  \"L8\u2192K\",  \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3),\n    (\"EGGFQMART\",  \"L8\u2192R\",  \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\", 1),\n    (\"EAKFQMALT\",  \"G3\u2192K\",  \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", 2),\n    (\"EAGFQMRLT\",  \"A7\u2192R\",  \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1),\n    (\"EAGFQMKLT\",  \"A7\u2192K\",  \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", 1),\n]\n\n# Build a matrix: for each peptide residue position, what receptor residue is closest?\n# The sequences (with ACE at position 1):\n# EGGFQMALT: ACE-E2-G3-G4-F5-Q6-M7-A8-L9-T10\n# EAGFQMALT: ACE-E2-A3-G4-F5-Q6-M7-A8-L9-T10\n# Note: positions 3 differ (G vs A) but positions 4-10 are the same residue types\n\nall_contacts = {}\nlabels = {}\nfor seq, label, d, cl in runs:\n    c = get_contact_zones(d, cl)\n    if c is None:\n        continue\n    all_contacts[label] = c\n    labels[label] = seq\n\n# Show closest receptor contact per peptide position for each run\nprint(\"Closest receptor residue per peptide position (groove-only clusters)\")\nprint()\n# Header\nprint(f\"{'Peptide':<20s} {'AF':>9s} {'DQ':>6s}\", end=\"\")\nfor pos in range(2, 11):\n    print(f\"  B{pos:>2d}\", end=\"\")\nprint()\nprint(\"-\" * 110)\n\n# Get scores\nscores = {\n    \"EGGFQMALT parent\": (-110.86, 1.000),\n    \"EAGFQMALT parent\": (-119.10, 1.000),\n    \"L8\u2192K\":  (-118.59, 0.765),\n    \"L8\u2192R\":  (-112.32, 0.613),\n    \"G3\u2192K\":  (-101.31, 1.000),\n    \"A7\u2192R\":  (-116.51, 1.000),\n    \"A7\u2192K\":  (-110.24, 0.887),\n}\n\n# Group by backbone\nbackbones = {\n    \"EGGFQMALT backbone\": [\"EGGFQMALT parent\", \"L8\u2192K\", \"L8\u2192R\"],\n    \"EAGFQMALT backbone\": [\"EAGFQMALT parent\", \"G3\u2192K\", \"A7\u2192R\", \"A7\u2192K\"],\n}\n\nfor bb_name, bb_labels in backbones.items():\n    print(f\"\\n  --- {bb_name} ---\")\n    for label in bb_labels:\n        if label not in all_contacts: continue\n        af, dq = scores.get(label, (0,0))\n        print(f\"  {label:<20s} {af:>+9.2f} {dq:>6.3f}\", end=\"\")\n        contacts = all_contacts[label]\n        for pos in range(2, 11):\n            if pos in contacts:\n                # Closest contact\n                closest = min(contacts[pos], key=lambda x: x[0])\n                _, rn, rr, _, _ = closest\n                print(f\"  {rr[:3]:>3s}{rn}\", end=\"\")\n            else:\n                print(f\"  {'---':>5s}\", end=\"\")\n        print()\n\n# Now show the actual sequence alignment\nprint(\"\\n\\nSequence alignment (contact map numbering, ACE=position 1):\")\nprint(f\"  {'Peptide':<20s}       {'B2':>4s} {'B3':>4s} {'B4':>4s} {'B5':>4s} {'B6':>4s} {'B7':>4s} {'B8':>4s} {'B9':>4s} {'B10':>4s}\")\nfor label in [\"EGGFQMALT parent\", \"L8\u2192K\", \"L8\u2192R\", \"EAGFQMALT parent\", \"G3\u2192K\", \"A7\u2192R\", \"A7\u2192K\"]:\n    if label not in all_contacts: continue\n    seq = labels.get(label, \"\")\n    # Extract residue names per position\n    pos_res = {}\n    for pos, clist in all_contacts[label].items():\n        if clist:\n            pos_res[pos] = clist[0][4]  # pep_res from first entry\n    \n    res_str = \"\"\n    for pos in range(2, 11):\n        res_str += f\"  {pos_res.get(pos, '?'):>4s}\"\n    print(f\"  {label:<20s}      {res_str}\")\nPYEOF"}

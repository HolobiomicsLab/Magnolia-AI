{"event_type":"tool_call","timestamp":"2026-07-01T09:16:09.607316Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef parse_alascan(run_dir):\n    fpath = f\"{run_dir}/output/1_alascan/scan_complex_haddock.tsv\"\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    rows = []\n    for row in reader:\n        rows.append({\n            'pos': int(row['res']),\n            'res': row['ori_resname'],\n            'ds': float(row['delta_score']),\n            'de': float(row['delta_elec']),\n            'dv': float(row['delta_vdw']),\n            'dd': float(row['delta_desolv']),\n        })\n    return rows\n\ndef get_contacts_for_positions(run_dir, cluster_id, positions):\n    \"\"\"Get closest receptor residue for each peptide position\"\"\"\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return {}\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    contacts = {}\n    for row in reader:\n        parts1 = row.get('res1','').strip().split('-')\n        parts2 = row.get('res2','').strip().split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1]); rec_res = parts1[2]\n            pep_num = int(parts2[1])\n        except ValueError:\n            continue\n        dist = float(row.get('shortest-dist', 999))\n        if pep_num in positions:\n            if pep_num not in contacts or dist < contacts[pep_num][1]:\n                contacts[pep_num] = (f\"{rec_res}{rec_num}\", dist)\n    return contacts\n\n# The three peptides\npeptides = [\n    {\n        'label': 'EAGFQMALT (parent, AF=\u2212119.10, DQ=1.000, n=9)',\n        'alascan': 'projects/hsc70_new/runs/2026-06-25_alascan_eagfqmalt_cl3',\n        'contacts_dir': 'projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000',\n        'cluster': 3,\n        'seq': 'E-A-G-F-Q-M-A-L-T',\n    },\n    {\n        'label': 'EGGFQMAKT (L8\u2192K, AF=\u2212118.59, DQ=0.765, n=8)',\n        'alascan': 'projects/hsc70_new/runs/2026-07-01_alascan_eggfqmakt',\n        'contacts_dir': 'projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000',\n        'cluster': 3,\n        'seq': 'E-G-G-F-Q-M-A-K-T',\n    },\n    {\n        'label': 'KFERQx2 (AF=\u2212146.53, DQ=1.000, n=7)',\n        'alascan': 'projects/hsc70_new/runs/2026-07-01_alascan_kferqx2',\n        'contacts_dir': 'projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000',\n        'cluster': 5,\n        'seq': 'K-F-E-R-Q-K-F-E-R-R-Q',\n    },\n]\n\nacidic = {'GLU', 'ASP'}\n\nfor pep in peptides:\n    rows = parse_alascan(pep['alascan'])\n    positions = set(r['pos'] for r in rows)\n    contacts = get_contacts_for_positions(pep['contacts_dir'], pep['cluster'], positions)\n    \n    print(f\"\\n{'='*80}\")\n    print(f\"  {pep['label']}\")\n    print(f\"  Sequence: {pep['seq']}\")\n    print(f\"{'='*80}\")\n    print(f\"  {'Pos':>4s} {'Res':>5s} {'\u0394score':>8s} {'\u0394elec':>8s}  {'Closest receptor':>20s}  {'Acidic nearby?':>15s}  {'Mut target?'}\")\n    print(f\"  {'-'*90}\")\n    \n    for r in sorted(rows, key=lambda x: x['pos']):\n        pos = r['pos']; res = r['res']; ds = r['ds']; de = r['de']\n        \n        contact_str = \"\u2014\"\n        acidic_note = \"\"\n        mut_target = \"\"\n        \n        if pos in contacts:\n            rec_name, dist = contacts[pos]\n            contact_str = f\"{rec_name} @ {dist:.1f}\u00c5\"\n            # Check if any contact is acidic\n            # Actually, get ALL contacts for this position\n            fpath = f\"{pep['contacts_dir']}/output/13_contactmap/cluster{pep['cluster']}_interchain_contacts.tsv\"\n            with open(fpath) as f:\n                clines = [l for l in f if not l.startswith('#')]\n            creader = csv.DictReader(clines, delimiter='\\t')\n            for crow in creader:\n                p1 = crow.get('res1','').strip().split('-')\n                p2 = crow.get('res2','').strip().split('-')\n                if len(p1) >= 3 and len(p2) >= 3:\n                    try:\n                        rn = int(p1[1]); pn = int(p2[1])\n                        rr = p1[2]\n                        d = float(crow.get('shortest-dist', 999))\n                        if pn == pos and rr in acidic and d < 6.0:\n                            acidic_note += f\"{rr}{rn}@{d:.1f} \"\n                    except ValueError:\n                        continue\n        \n        # Classify\n        if abs(ds) < 1.0:\n            mut_target = \"\u2190 TOLERANT\"\n            if acidic_note:\n                mut_target += f\" + ACIDIC NEARBY ({acidic_note.strip()}) \u2190 MUTATE!\"\n        elif ds > 0:\n            mut_target = f\"\u2190 detrimental (mutate\u2192A)\"\n        \n        print(f\"  {pos:>4d} {res:>5s} {ds:>+8.2f} {de:>+8.2f}  {contact_str:>20s}  {acidic_note:>15s}  {mut_target}\")\nPYEOF"}

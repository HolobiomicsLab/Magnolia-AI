{"event_type":"tool_call","timestamp":"2026-06-20T19:50:10.720221Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 << 'PYEOF'\nimport csv, numpy as np\n\nwith open(\"results/comparison.csv\") as f:\n    rows = list(csv.DictReader(f))\n\netot_our = np.array([float(r[\"Etot_our\"]) for r in rows])\netot_lit = np.array([float(r[\"Etot_lit\"]) for r in rows])\ndE = etot_our - etot_lit\nadE = np.abs(dE)\n\nspan_our = etot_our.max() - etot_our.min()\nspan_lit = etot_lit.max() - etot_lit.min()\n\nprint(f\"Total energy stats (N={len(dE)}):\")\nprint(f\"  Our range:     {etot_our.min():.1f} to {etot_our.max():.1f} eV  (span={span_our:.1f} eV)\")\nprint(f\"  Lit range:     {etot_lit.min():.1f} to {etot_lit.max():.1f} eV  (span={span_lit:.1f} eV)\")\nprint(f\"  dE min: {dE.min():.2f} eV  dE max: {dE.max():.2f} eV\")\nprint(f\"  MAE:   {adE.mean():.4f} eV\")\nprint(f\"  RMSE:  {np.sqrt(np.mean(dE**2)):.4f} eV\")\nprint()\n\nss_res = np.sum(dE**2)\nss_tot = np.sum((etot_lit - etot_lit.mean())**2)\nprint(f\"  Why R\u00b2 = 1.0:\")\nprint(f\"    SS_res  (variance of errors)     = {ss_res:.1f}\")\nprint(f\"    SS_tot  (variance of energies)   = {ss_tot:.1f}\")\nprint(f\"    ratio                            = {ss_res/ss_tot:.10f}\")\nprint(f\"    R\u00b2                               = {1 - ss_res/ss_tot:.10f}\")\nprint()\n\nfor thresh in [0.001, 0.01, 0.1, 0.5, 1.0, 5.0]:\n    pct = np.sum(adE < thresh) / len(adE) * 100\n    print(f\"  |\u0394Etot| < {thresh:6.3f} eV: {pct:5.1f}%  ({int(np.sum(adE < thresh))}/{len(adE)})\")\n\nneg = np.sum(dE < -0.1)\npos = np.sum(dE > 0.1)\nmid = len(dE) - neg - pos\nprint(f\"\\n  \u0394Etot < -0.1 eV: {neg} molecules\")\nprint(f\"  |\u0394Etot| < 0.1 eV: {mid} molecules\")\nprint(f\"  \u0394Etot > +0.1 eV:  {pos} molecules\")\nPYEOF\n"}

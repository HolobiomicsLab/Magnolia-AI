{"event_type":"tool_call","timestamp":"2026-06-09T12:57:54.009099Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport re, json\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('gnina_bridge_all.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\nn_done = len(blocks) - 1\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\nprint(f\"\u2550\u2550\u2550 {n_done}/40 COMPLETED \u2550\u2550\u2550\\n\")\nprint(f\"{'Compound':<24s} {'Kd_exp':>8s} {'Aff':>7s} {'CNNpose':>8s} {'Kd_cls':>8s}\")\nprint(\"-\" * 65)\n\nfor i in range(n_done):\n    fn = sdf_names_sorted[i]\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else \"WEAK\")\n    \n    # Parse score from block\n    block = blocks[i+1]\n    m = re.search(r'\\n\\s+1\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', block)\n    if m:\n        aff = float(m.group(1))\n        cnn = float(m.group(3))\n        print(f\"  {name:<22s} {kd:>8.3f} {aff:>+7.2f} {cnn:>8.4f} {cls:>8s}\")\n\n# Quick: any strong binders scoring well?\nprint(f\"\\n\u2550\u2550\u2550 Quick assessment \u2550\u2550\u2550\")\nstrong = [(i, float(re.search(r'\\n\\s+1\\s+(-?\\d+\\.\\d+)', b).group(1))) \n          for i, b in enumerate(blocks[1:]) \n          if (lambda n: exp_lk.get(name_map.get(sdf_names_sorted[n],sdf_names_sorted[n]),999) < 1.0)(i)]\nweak = [(i, float(re.search(r'\\n\\s+1\\s+(-?\\d+\\.\\d+)', b).group(1))) \n        for i, b in enumerate(blocks[1:])\n        if (lambda n: exp_lk.get(name_map.get(sdf_names_sorted[n],sdf_names_sorted[n]),999) >= 10)(i)]\n\nif strong: print(f\"  Strong binders aff: {sum(s[1] for s in strong)/len(strong):+.2f}\")\nif weak: print(f\"  Weak/non binders aff: {sum(w[1] for w in weak)/len(weak):+.2f}\")\nPYEOF"}

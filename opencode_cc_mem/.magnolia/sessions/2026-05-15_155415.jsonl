{"event_type":"tool_call","timestamp":"2026-06-12T07:40:21.337038Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport sys, math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                    'elem': line[76:78].strip() if len(line) > 76 else '',\n                })\n    return atoms\n\ndef dist(a1, a2): \n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\n# Charged group atoms for salt bridges\nPOS_GROUPS = {'LYS': ['NZ'], 'ARG': ['NH1','NH2']}\nNEG_GROUPS = {'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2']}\n\n# H-bond donors (H atoms) and acceptors\nHBOND_DONORS_H = {\n    'ARG': {'NH1': ['HH11','HH12'], 'NH2': ['HH21','HH22'], 'NE': ['HE']},\n    'LYS': {'NZ': ['HZ1','HZ2','HZ3']},\n    'ASN': {'ND2': ['HD21','HD22']},\n    'GLN': {'NE2': ['HE21','HE22']},\n    'SER': {'OG': ['HG']},\n    'THR': {'OG1': ['HG1']},\n    'TYR': {'OH': ['HH']},\n    'HIS': {'ND1': ['HD1'], 'NE2': ['HE2']},\n}\nHBOND_ACCEPTORS = {\n    'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2'],\n    'ASN': ['OD1'], 'GLN': ['OE1'],\n    'SER': ['OG'], 'THR': ['OG1'],\n    'TYR': ['OH'], 'HIS': ['ND1','NE2'],\n}\n\nAPOLAR = {'ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET','CYS'}\n\ndef atom_key(a): return f\"{a['chain']}-{a['resi']}-{a['resn']}:{a['name']}\"\n\nruns = {\n    'KFERQ (5-mer)': '/tmp/kferq5_cl1m1.pdb',\n    'AKFERQ (6-mer)': '/tmp/akferq6_cl2m1.pdb',\n    'AKFERQK (7-mer)': '/tmp/akferqk7_cl2m1.pdb',\n}\n\nall_results = {}\n\nfor name, path in runs.items():\n    atoms = parse_pdb(path)\n    chain_a = [a for a in atoms if a['chain'] == 'A']\n    chain_b = [a for a in atoms if a['chain'] == 'B']\n    \n    b_resis = sorted(set(a['resi'] for a in chain_b))\n    b_seq = []\n    for r in b_resis:\n        a = next(a for a in chain_b if a['resi'] == r)\n        b_seq.append(f\"{a['resn']}{r}\")\n    \n    print(f\"\\n{'='*70}\")\n    print(f\"  {name}  |  Peptide: {'-'.join(b_seq)}\")\n    print(f\"{'='*70}\")\n    \n    # --- SALT BRIDGES ---\n    salt_bridges = []\n    for a_a in chain_a:\n        if a_a['resn'] not in POS_GROUPS and a_a['resn'] not in NEG_GROUPS: continue\n        for a_b in chain_b:\n            if a_b['resn'] not in POS_GROUPS and a_b['resn'] not in NEG_GROUPS: continue\n            # get charged atoms\n            a_charged = POS_GROUPS.get(a_a['resn']) or NEG_GROUPS.get(a_a['resn'])\n            b_charged = POS_GROUPS.get(a_b['resn']) or NEG_GROUPS.get(a_b['resn'])\n            if a_a['name'] not in a_charged: continue\n            if a_b['name'] not in b_charged: continue\n            # opposite charges only\n            a_is_pos = a_a['resn'] in POS_GROUPS\n            b_is_pos = a_b['resn'] in POS_GROUPS\n            if a_is_pos == b_is_pos: continue\n            d = dist(a_a, a_b)\n            if d <= 4.0:\n                salt_bridges.append((a_a, a_b, d))\n    \n    # deduplicate to residue pairs\n    seen_sb = set()\n    unique_sb = []\n    for a_a, a_b, d in sorted(salt_bridges, key=lambda x: x[2]):\n        key = (a_a['resi'], a_b['resi'])\n        if key not in seen_sb:\n            seen_sb.add(key)\n            unique_sb.append((a_a, a_b, d))\n    \n    print(f\"\\n  SALT BRIDGES (N\u2013O \u2264 4.0 \u00c5):\")\n    if unique_sb:\n        for a_a, a_b, d in unique_sb:\n            print(f\"    A-{a_a['resi']:>4}-{a_a['resn']:<4}{a_a['name']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}{a_b['name']:<4}  {d:.1f} \u00c5\")\n    else:\n        print(f\"    (none)\")\n    \n    # --- H-BONDS (sidechain polar \u2264 3.5 \u00c5) ---\n    hbonds = []\n    # Map acceptors and donor-hydrogens for each chain\n    for a_a in chain_a:\n        for a_b in chain_b:\n            a_is_acceptor = a_a['name'] in HBOND_ACCEPTORS.get(a_a['resn'], [])\n            b_is_acceptor = a_b['name'] in HBOND_ACCEPTORS.get(a_b['resn'], [])\n            a_is_hdonor = a_a['name'] in HBOND_DONORS_H.get(a_a['resn'], {})\n            b_is_hdonor = a_b['name'] in HBOND_DONORS_H.get(a_b['resn'], {})\n            \n            d = dist(a_a, a_b)\n            if d > 3.5: continue\n            \n            # A donor-H \u2192 B acceptor\n            if a_is_acceptor and b_is_hdonor:\n                hbonds.append((a_b, a_a, d, 'B\u2192A'))\n            # B donor-H \u2192 A acceptor\n            elif b_is_acceptor and a_is_hdonor:\n                hbonds.append((a_a, a_b, d, 'A\u2192B'))\n            # A acceptor, B acceptor-H \u2192 could be either direction, skip ambiguity\n            # Also include acceptor-acceptor proximity (possible water-mediated)\n    \n    seen_hb = set()\n    unique_hb = []\n    for donor, acceptor, d, direction in sorted(hbonds, key=lambda x: x[2]):\n        key = (donor['resi'], acceptor['resi'])\n        if key not in seen_hb:\n            seen_hb.add(key)\n            unique_hb.append((donor, acceptor, d, direction))\n    \n    print(f\"\\n  H-BONDS (donor-H \u2192 acceptor \u2264 3.5 \u00c5):\")\n    if unique_hb:\n        for donor, acceptor, d, direction in unique_hb[:30]:\n            dp = f\"A-{donor['resi']}-{donor['resn']}:{donor['name']}\" if donor['chain'] == 'A' else f\"B-{donor['resi']}-{donor['resn']}:{donor['name']}\"\n            ap = f\"A-{acceptor['resi']}-{acceptor['resn']}:{acceptor['name']}\" if acceptor['chain'] == 'A' else f\"B-{acceptor['resi']}-{acceptor['resn']}:{acceptor['name']}\"\n            print(f\"    {dp} \u2192 {ap}  {d:.1f} \u00c5 [{direction}]\")\n    else:\n        print(f\"    (none)\")\n    \n    # --- HYDROPHOBIC CONTACTS ---\n    hydrophobic = []\n    for a_a in chain_a:\n        if a_a['resn'] not in APOLAR: continue\n        if a_a['name'] != 'CB' and not (a_a['resn'] == 'GLY' and a_a['name'] == 'CA'): continue\n        for a_b in chain_b:\n            if a_b['resn'] not in APOLAR: continue\n            if a_b['name'] != 'CB' and not (a_b['resn'] == 'GLY' and a_b['name'] == 'CA'): continue\n            d = dist(a_a, a_b)\n            if d <= 5.0:\n                hydrophobic.append((a_a, a_b, d))\n    \n    print(f\"\\n  HYDROPHOBIC CONTACTS (C\u03b2\u2013C\u03b2 \u2264 5.0 \u00c5):\")\n    if hydrophobic:\n        for a_a, a_b, d in sorted(hydrophobic, key=lambda x: x[2]):\n            print(f\"    A-{a_a['resi']:>4}-{a_a['resn']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}  {d:.1f} \u00c5\")\n    else:\n        print(f\"    (none)\")\n    \n    # --- PER-PEPTIDE-RESIDUE CONTACT SUMMARY ---\n    print(f\"\\n  PER-RESIDUE CONTACT MAP (receptor contacts \u2264 4.0 \u00c5):\")\n    for b_r in b_resis:\n        contacts = []\n        for a_a in chain_a:\n            best_d = 999\n            for a_b in chain_b:\n                if a_b['resi'] != b_r: continue\n                d = dist(a_a, a_b)\n                if d < best_d: best_d = d\n            if best_d <= 4.0:\n                contacts.append((a_a['resi'], a_a['resn'], best_d))\n        contacts.sort(key=lambda x: x[2])\n        b_rn = next(a['resn'] for a in chain_b if a['resi'] == b_r)\n        contact_str = ', '.join(f\"{r}-{rn}({d:.1f})\" for r, rn, d in contacts[:8])\n        if len(contacts) > 8: contact_str += f' ... (+{len(contacts)-8})'\n        print(f\"    B-{b_r}-{b_rn:<4} \u2192 {len(contacts):>2} contacts: {contact_str}\")\n    \n    all_results[name] = {\n        'salt_bridges': unique_sb,\n        'hbonds': unique_hb,\n        'hydrophobic': hydrophobic,\n        'b_seq': b_seq,\n        'b_resis': b_resis,\n        'chain_a': chain_a,\n        'chain_b': chain_b,\n    }\n\n# --- CROSS-RUN COMPARISON ---\nprint(f\"\\n{'='*70}\")\nprint(f\"  CROSS-RUN COMPARISON\")\nprint(f\"{'='*70}\")\n\n# Which salt bridges are unique to each peptide?\nprint(f\"\\n  SALT BRIDGE COMPARISON:\")\nfor name, data in all_results.items():\n    sb_pairs = set()\n    for a_a, a_b, d in data['salt_bridges']:\n        sb_pairs.add((a_a['resi'], a_a['resn'], a_b['resi'], a_b['resn']))\n    print(f\"  {name}: {len(sb_pairs)} salt bridges\")\n    for a_r, a_rn, b_r, b_rn in sorted(sb_pairs):\n        print(f\"    A-{a_r}-{a_rn} \u2194 B-{b_r}-{b_rn}\")\n\n# Interactions unique to extensions\nprint(f\"\\n  INTERACTIONS FROM EXTENDED REGIONS (absent in KFERQ):\")\nkferq_b_resis = set(all_results['KFERQ (5-mer)']['b_resis'])\nfor name in ['AKFERQ (6-mer)', 'AKFERQK (7-mer)']:\n    data = all_results[name]\n    new_resis = set(data['b_resis']) - kferq_b_resis\n    print(f\"\\n  {name} new residues: {sorted(new_resis)}\")\n    for b_r in sorted(new_resis):\n        contacts = []\n        for a_a in data['chain_a']:\n            best_d = 999\n            for a_b in data['chain_b']:\n                if a_b['resi'] != b_r: continue\n                d = dist(a_a, a_b)\n                if d < best_d: best_d = d\n            if best_d <= 5.0:\n                contacts.append((a_a['resi'], a_a['resn'], best_d))\n        contacts.sort(key=lambda x: x[2])\n        b_rn = next(a['resn'] for a in data['chain_b'] if a['resi'] == b_r)\n        contact_str = ', '.join(f\"{r}-{rn}({d:.1f})\" for r, rn, d in contacts[:10])\n        print(f\"    B-{b_r}-{b_rn}: {contact_str if contacts else '(no contacts \u2264 5.0 \u00c5)'}\")\n\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-09T12:28:37.796651Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('gnina_gpu.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\ndock = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m: dock.append((float(m.group(2)),float(m.group(4)),float(m.group(5)))); break\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\npairs = []\nfor i, fn in enumerate(sdf_names_sorted):\n    if i >= len(dock): break\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    pairs.append((name, kd, dock[i][0], dock[i][1], dock[i][2]))\n\nkd_a = np.array([p[1] for p in pairs])\naff_a = np.array([p[2] for p in pairs])\ncnn_a = np.array([p[3] for p in pairs])\n\nrho_emp, p_emp = spearmanr(aff_a, kd_a)\nrho_cnn, p_cnn = spearmanr(cnn_a, kd_a)\n\nprint(f\"\u2550\u2550\u2550 GPU ACCELERATED (TRS box, n=40) \u2550\u2550\u2550\")\nprint(f\"  Empirical:  \u03c1={rho_emp:+.4f}  p={p_emp:.4f}\")\nprint(f\"  CNN pose:   \u03c1={rho_cnn:+.4f}  p={p_cnn:.4f}\")\n\n# Compare with old runs\nprint(f\"\\n\u2550\u2550\u2550 COMPARISON ALL RUNS \u2550\u2550\u2550\")\nprint(f\"  Old binary (TRS):        \u03c1_emp={0.0654:+.4f}\")\nprint(f\"  New GPU binary (TRS):    \u03c1_emp={'+' if rho_emp>=0 else ''}{rho_emp:.4f}\")\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-09T12:28:39.152795Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":1357,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T12:46:35.281988Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\n# Key experimental residues\nkey = {39: 'MET', 73: 'SER', 87: 'ASP', 90: 'ASN', 120: 'GLU', 122: 'SER'}\n\n# Get all CA positions and compute centroid of key residues\nall_ca = {}\nwith open('receptor.pdb') as f:\n    for line in f:\n        if not line.startswith('ATOM'): continue\n        rnum = int(line[22:26].strip())\n        rname = line[17:20].strip()\n        atom = line[12:16].strip()\n        if atom == 'CA':\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            all_ca[(rnum, rname)] = (x, y, z)\n\n# Centroid of key residues\nkey_coords = [all_ca[(r, key[r])] for r in key if (r, key[r]) in all_ca]\ncx = sum(c[0] for c in key_coords) / len(key_coords)\ncy = sum(c[1] for c in key_coords) / len(key_coords)\ncz = sum(c[2] for c in key_coords) / len(key_coords)\n\nprint(f\"Key residues centroid: ({cx:.1f}, {cy:.1f}, {cz:.1f})\")\nfor r in sorted(key):\n    if (r, key[r]) in all_ca:\n        x, y, z = all_ca[(r, key[r])]\n        d = ((x-cx)**2 + (y-cy)**2 + (z-cz)**2)**0.5\n        print(f\"  {key[r]} {r}: CA at ({x:.1f}, {y:.1f}, {z:.1f})  dist={d:.1f}\")\n\n# Find ALL residues within 8\u00c5 of the centroid (flex candidates)\nprint(f\"\\nResidues within 8 \u00c5 of centroid (flex candidates):\")\nflex = []\nfor (rnum, rname), (x, y, z) in all_ca.items():\n    d = ((x-cx)**2 + (y-cy)**2 + (z-cz)**2)**0.5\n    if d < 8:\n        flex.append((rnum, rname, d))\n\nflex.sort()\nfor rnum, rname, d in flex:\n    marker = \" \u2190 KEY\" if rnum in key else \"\"\n    print(f\"  A:{rnum} {rname:<4s} dist={d:.1f}{marker}\")\n\nflex_str = ','.join(f'A:{r}' for r,_,_ in flex)\nprint(f\"\\n--flexres {flex_str}\")\n\n# Compute box spread\nxs = [c[0] for c in key_coords]\nys = [c[1] for c in key_coords]\nzs = [c[2] for c in key_coords]\nspread = max(max(xs)-min(xs), max(ys)-min(ys), max(zs)-min(zs))\nbox = max(spread * 1.8, 22)\nprint(f\"\\nKey residue spread: \u0394x={max(xs)-min(xs):.1f} \u0394y={max(ys)-min(ys):.1f} \u0394z={max(zs)-min(zs):.1f}\")\nprint(f\"Recommended box: {box:.0f} \u00c5\")\nprint(f\"--center_x {cx:.1f} --center_y {cy:.1f} --center_z {cz:.1f} --size_x {box:.0f} --size_y {box:.0f} --size_z {box:.0f}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-10T13:19:53.712963Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport json, math\nfrom collections import defaultdict\n\n# Parse receptor once\nrec_atoms = []\nwith open('receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\ndef parse_top_pose(sdf_path):\n    \"\"\"Return (emp_aff, cnn_score, cnn_aff, lig_atoms_list, asn90_min_d) for best empirical affinity pose.\"\"\"\n    with open(sdf_path) as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    best_data = None\n    \n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        cnn_score = cnn_aff = emp_aff = 0\n        na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        \n        if na == 0 or atom_start < 0: continue\n        \n        lig_atoms = []\n        for i in range(atom_start, min(atom_start + na, len(lines))):\n            l = lines[i]\n            if len(l) < 30: continue\n            try:\n                x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n            except: continue\n            lig_atoms.append((f'L{i-atom_start+1}', x, y, z))\n        \n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, cnn_score, cnn_aff)\n            best_data = lig_atoms\n    \n    if best_data is None: return None\n    \n    # Compute Asn90 min distance\n    asn90_min = 999\n    for la in best_data:\n        for ra in rec_atoms:\n            if ra[1] == 'ASN' and ra[2] == 90:\n                d = math.sqrt((ra[3]-la[1])**2 + (ra[4]-la[2])**2 + (ra[5]-la[3])**2)\n                if d < asn90_min: asn90_min = d\n    \n    return (best[0], best[1], best[2], best_data, asn90_min)\n\ndef get_contacts(lig_atoms, cutoff=5.0):\n    \"\"\"Return dict res->[(rec_atom, lig_atom, dist)] for contacts within cutoff.\"\"\"\n    contacts = defaultdict(list)\n    for la_name, lx, ly, lz in lig_atoms:\n        for ra_name, ra_res, ra_num, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2 + (ry-ly)**2 + (rz-lz)**2)\n            if d <= cutoff:\n                contacts[f\"{ra_res}{ra_num}\"].append((f\"{ra_res}{ra_num}:{ra_name}\", la_name, d))\n    return contacts\n\n# Paper-description of cavity residues\npaper_cavity = {\n    'ASN90': 'H-bond donor to aldehyde carbonyl (key)',\n    'ASP87': 'cavity gate residue',\n    'MET39': 'cavity gate residue',\n    'GLU120': 'polar, mutation abolishes all binding',\n    'SER122': 'polar, mutation has limited effect',\n    'SER73': 'polar cavity wall',\n    'PHE56': 'hydrophobic cavity wall',\n    'PHE92': 'hydrophobic cavity wall',\n    'TYR86': 'hydrophobic, near cavity entrance',\n    'TYR89': 'hydrophobic cavity wall',\n}\n\n# Paper: \"Z11-16:Ald ... filled the binding pocket, establishing contacts with most of the cavity residues \n# and accepting a hydrogen bond from Asn90 NH2 moiety\"\n# \"the aldehyde group change to carboxylate/methyl ester ... clashed with cavity residues\"\n\nligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Z11-16-OH', 'Cedrol', '\u03b2-Ionone', \n           'Citral', 'C12-Ald', 'C8-Ald', 'Palmitic_acid']\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\nprint(\"=\" * 80)\nprint(\"CONTACT MAP ANALYSIS \u2014 Gnina Asn90-box (15\u00d715\u00d715 \u00c5, rigid receptor)\")\nprint(\"=\" * 80)\n\nfor lig in ligands:\n    fname = f'docked_{lig}_asn90.sdf'\n    result = parse_top_pose(fname)\n    if result is None:\n        print(f\"\\n{lig}: NO VALID POSES\")\n        continue\n    \n    emp_aff, cnn_score, cnn_aff, lig_atoms, asn90_d = result\n    contacts = get_contacts(lig_atoms)\n    \n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    kd = c.get('kd_obp3', 'N/A')\n    \n    print(f\"\\n{'\u2500' * 70}\")\n    print(f\"{lig}  |  IC50={ic50} \u03bcM  Kd={kd} \u03bcM  EmpAff={emp_aff:.1f}  CNNaff={cnn_aff:.1f}\")\n    print(f\"  Asn90 closest: {asn90_d:.1f} \u00c5\")\n    \n    # Paper cavity residues that contact this ligand\n    paper_contacts = {k: v for k, v in paper_cavity.items() if k in contacts}\n    if paper_contacts:\n        print(f\"  Paper cavity residues in contact:\")\n        for res, desc in sorted(paper_contacts.items()):\n            dmin = min(c[2] for c in contacts[res])\n            print(f\"    {res:8s}  {dmin:.1f}\u00c5  ({desc})\")\n    \n    # Top 10 closest contacts\n    print(f\"\\n  Top 10 contacts:\")\n    all_contacts = []\n    for res, clist in contacts.items():\n        for rac, lac, d in clist:\n            all_contacts.append((rac, lac, d))\n    all_contacts.sort(key=lambda x: x[2])\n    for rac, lac, d in all_contacts[:10]:\n        print(f\"    {rac:24s} -- {lac:5s}  {d:.1f}\u00c5\")\n\nPYEOF"}

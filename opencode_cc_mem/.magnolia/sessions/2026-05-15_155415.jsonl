{"event_type":"tool_call","timestamp":"2026-07-01T07:30:55.130810Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = [\n    (\"EGGFQMAKT L8\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", \"EGGFQMALT\", 8, \"K\"),\n    (\"EGGFQMART L8\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\", \"EGGFQMALT\", 8, \"R\"),\n    (\"EAKFQMALT G3\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", \"EAGFQMALT\", 3, \"K\"),\n    (\"EAGFQMRLT A7\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", \"EAGFQMALT\", 7, \"R\"),\n    (\"EAGFQMKLT A7\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", \"EAGFQMALT\", 7, \"K\"),\n]\n\nfor label, d, parent, mut_pos, mut_res in runs:\n    # Get the best cluster's interchain contacts\n    contacts = None\n    for cl in range(1, 10):\n        fpath = f\"{d}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n        if os.path.exists(fpath):\n            with open(fpath) as f:\n                lines = [l for l in f if not l.startswith('#')]\n            if len(lines) > 1:\n                contacts = (cl, fpath)\n                break\n    \n    if not contacts:\n        print(f\"{label}: NO interchain contacts found\")\n        continue\n    \n    cl_num, fpath = contacts\n    print(f\"\\n=== {label} (cluster {cl_num}) ===\")\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Group by peptide residue\n    peptide_contacts = {}\n    for row in reader:\n        pept = row.get('res1', '').strip()\n        pept_num = int(row.get('resnum1', 0))\n        rec = row.get('res2', '').strip()\n        rec_num = int(row.get('resnum2', 0))\n        dist = float(row.get('shortest-dist', row.get('distance', 999)))\n        ct = row.get('contact-type', '').strip()\n        \n        key = f\"{pept}{pept_num}\"\n        if key not in peptide_contacts:\n            peptide_contacts[key] = []\n        peptide_contacts[key].append((dist, f\"{rec}{rec_num}\", ct))\n    \n    # Show mutated position contacts and summary\n    mut_key = f\"{mut_res}{mut_pos}\"\n    for key in sorted(peptide_contacts.keys()):\n        contacts = sorted(peptide_contacts[key], key=lambda x: x[0])\n        is_mut = key == mut_key\n        marker = \" <<< MUTATED\" if is_mut else \"\"\n        # Show top 3 closest receptor contacts\n        top = \", \".join(f\"{r}({d:.1f}A,{ct})\" for d, r, ct in contacts[:5])\n        total = len(contacts)\n        print(f\"  {key}: {total} contacts{marker}\")\n        if total > 0:\n            print(f\"         {top}\")\n        \n    # Count per-domain contacts for the mutated residue specifically\n    if mut_key in peptide_contacts:\n        ct_list = peptide_contacts[mut_key]\n        nbd = sum(1 for d,r,ct in ct_list if r.startswith(('A','B')) and any(x in r for x in ('190','191','192','200','210','220')))\n        # Actually let's just print distances\n        print(f\"\\n  Mutated {mut_key} closest contacts:\")\n        for d, r, ct in sorted(ct_list, key=lambda x: x[0])[:8]:\n            print(f\"    {r} at {d:.2f}A ({ct})\")\nPYEOF"}

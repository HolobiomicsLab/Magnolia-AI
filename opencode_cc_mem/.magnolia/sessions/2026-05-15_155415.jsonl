{"event_type":"tool_call","timestamp":"2026-06-11T20:12:41.195285Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 -c \"\nimport os, glob, re\n\ndef get_length(run_name):\n    n = run_name.lower()\n    # Long peptides\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    # 6-mers: any N-term or C-term extension\n    if any(x in n for x in ['apkferq', 'kferqp', 'kferq_n-']): return 6\n    return 5\n\nruns = glob.glob('runs/*/output/12_caprieval/capri_clt.tsv')\nresults = []\nfor f in sorted(runs):\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'): continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21: continue\n            score, air = float(parts[4]), float(parts[18])\n            results.append({'run': d, 'score': score, 'air_free': score - 0.1*air,\n                'dockq': float(parts[12]), 'irmsd': float(parts[6]),\n                'bsa': float(parts[20]), 'len': get_length(d),\n            })\n            if parts[0] == '1': break\n\nseen = set()\nselected = []\nfor r in results:\n    if r['run'] in seen: continue\n    seen.add(r['run'])\n    n = r['run'].lower()\n    is_long = any(x in n for x in ['x2', 'fusion', 'variant'])\n    is_6mer = get_length(r['run']) == 6\n    is_parent = '2026-06-02_kferq_p2rank1' in n\n    if is_long or is_6mer or is_parent:\n        selected.append(r)\n\nselected.sort(key=lambda r: (r['len'], r['air_free']))\n\n# Parent reference\nparent = next(r for r in selected if '2026-06-02_KFERQ' in r['run'])\n\nprint(f\\\"{'Peptide':<30} {'Len':>3} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7} {'AF/res':>8} {'\u0394parent':>8}\\\")\nprint('-' * 80)\nfor r in selected:\n    pep = re.sub(r'^\\d{4}-\\d{2}-\\d{2}_', '', r['run']).replace('_p2rank1','')\n    delta = r['air_free'] - parent['air_free']\n    print(f\\\"{pep:<30} {r['len']:>3} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f} {r['air_free']/r['len']:>8.2f} {delta:>8.2f}\\\")\n\""}

{"event_type":"tool_call","timestamp":"2026-06-25T09:13:16.280726Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /tmp/agent-hub-smoke\n: > /tmp/agent-hub-smoke/serve.log\nnohup opencode serve --port 4097 --log-level INFO > /tmp/agent-hub-smoke/serve.log 2>&1 &\necho \"serve pid $!\"\npython3 - <<'PY'\nimport json, time, urllib.request\nHUB=\"http://127.0.0.1:4097\"\ndef req(path, body=None, method=\"GET\"):\n    data=json.dumps(body).encode() if body is not None else None\n    r=urllib.request.Request(HUB+path, data=data, headers={\"content-type\":\"application/json\"}, method=method)\n    return json.load(urllib.request.urlopen(r, timeout=30))\n# wait for server\nfor i in range(20):\n    try: urllib.request.urlopen(HUB+\"/session\", timeout=2); break\n    except Exception: time.sleep(1)\nelse:\n    print(\"SERVER NOT UP; log:\"); print(open(\"/tmp/agent-hub-smoke/serve.log\").read()[-800:]); raise SystemExit\nprint(\"server up\")\ns=req(\"/session\", {\"agent\":\"build\"}, \"POST\")\nsid=s[\"id\"]; print(\"session\", sid)\n# inject a trivial prompt with a known-good FREE model\nbody={\"parts\":[{\"type\":\"text\",\"text\":\"Reply with exactly the token: BACKEND_OK\"}],\n      \"model\":{\"providerID\":\"opencode\",\"modelID\":\"deepseek-v4-flash-free\"},\"agent\":\"build\"}\nreq(f\"/session/{sid}/prompt_async\", body, \"POST\")\nprint(\"injected prompt_async; polling for assistant reply...\")\nresult=\"NO_ASSISTANT_REPLY\"\nfor i in range(14):\n    time.sleep(3)\n    msgs=req(f\"/session/{sid}/message\")\n    asst=[m for m in msgs if m[\"info\"][\"role\"]==\"assistant\"]\n    if asst:\n        result=\"ASSISTANT_REPLY: \"+(asst[-1][\"parts\"][0][\"text\"][:160] if asst[-1].get(\"parts\") else \"<no parts>\")\n        break\nprint(\"user msgs:\", len([m for m in msgs if m[\"info\"][\"role\"]==\"user\"]), \"| assistant msgs:\", len(asst))\nprint(\"VERDICT:\", result)\nprint(\"tokens:\", json.dumps(s.get(\"tokens\",{}))[:120])\nPY\necho \"=== serve.log tail ===\"; tail -8 /tmp/agent-hub-smoke/serve.log\necho \"=== teardown serve ===\"; SPID=$(pgrep -f 'opencode serve --port 4097'); [ -n \"$SPID\" ] && kill \"$SPID\" && echo \"killed serve $SPID\" || echo \"no serve pid found\""}

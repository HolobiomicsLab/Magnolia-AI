{"event_type":"tool_call","timestamp":"2026-06-03T09:29:04.122378Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLU',649),('B','ARG',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLU',649):'E3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\n\nmodels = ['cluster_1_model_1.pdb.gz','cluster_1_model_2.pdb.gz','cluster_1_model_3.pdb.gz','cluster_1_model_4.pdb.gz']\n\nall_contacts = defaultdict(lambda: defaultdict(list))\npocket_residues = set()\n\nfor mi, mf in enumerate(models):\n    atoms = read_pdb(mf)\n    for pk, pxyz in atoms.items():\n        if pk[0] != 'B': continue\n        pres = (pk[0], pk[1], pk[2])\n        if pres not in PEPTIDE: continue\n        for rk, rxyz in atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                rres = (rk[0], rk[1], rk[2])\n                all_contacts[pres][rres].append(d)\n                pocket_residues.add(rres)\n\nprint('=== KFERQ BINDING POCKET: residues within 5A ===')\nprint()\nfor pres in PEPTIDE:\n    pname = PEP_NAMES[pres]\n    contacts = all_contacts[pres]\n    avg_contacts = []\n    for rres, dists in contacts.items():\n        avg_d = sum(dists) / len(dists)\n        avg_contacts.append((rres, avg_d, min(dists)))\n    avg_contacts.sort(key=lambda x: x[1])\n    \n    print(f'--- {pname} ({pres[1]}{pres[2]}) ---')\n    print(f'  Receptor contacts ({len(avg_contacts)} residues):')\n    for rres, avg, mind in avg_contacts[:12]:\n        rlabel = f'A-{rres[1]}{rres[2]}'\n        print(f'    {rlabel:<10s}  avg {avg:.1f}A  min {mind:.1f}A')\n    print()\n\n# Pocket composition\nprint('=== POCKET COMPOSITION ===')\nres_list = sorted(pocket_residues, key=lambda x: x[2])\nprint(f'Total unique receptor residues contacting peptide: {len(pocket_residues)}')\npolar = [r for r in res_list if r[1] in ('SER','THR','ASN','GLN','TYR','HIS','CYS')]\ncharged_pos = [r for r in res_list if r[1] in ('LYS','ARG')]\ncharged_neg = [r for r in res_list if r[1] in ('ASP','GLU')]\napolar = [r for r in res_list if r[1] in ('ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET')]\ngly = [r for r in res_list if r[1] == 'GLY']\nprint(f'  Polar (S/T/N/Q/Y/H/C): {len(polar)}')\nprint(f'  Positive (K/R): {len(charged_pos)}')\nprint(f'  Negative (D/E): {len(charged_neg)}')\nprint(f'  Apolar (A/V/L/I/P/F/W/M): {len(apolar)}')\nprint(f'  Glycine: {len(gly)}')\nprint()\nprint('Glycines:  ', ' '.join(f'{r[1]}{r[2]}' for r in gly))\nprint('Negatives: ', ' '.join(f'{r[1]}{r[2]}' for r in charged_neg))\nprint('Positives: ', ' '.join(f'{r[1]}{r[2]}' for r in charged_pos))\nprint('Polars:    ', ' '.join(f'{r[1]}{r[2]}' for r in polar))\nprint('Apolars:   ', ' '.join(f'{r[1]}{r[2]}' for r in apolar))\nPYEOF\n"}

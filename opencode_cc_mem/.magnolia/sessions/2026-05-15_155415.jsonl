{"event_type":"tool_call","timestamp":"2026-06-20T19:43:16.544533Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 -c \"\nimport csv, re, os, numpy as np\n_nf = {'n_rings','HOMO_eV','LUMO_eV','GAP_eV','Etot_eV','Erel_eV','aIP_eV','aEA_eV','ZPE_eV'}\n\n# Load pub\npub = {}\ncompas_csv = os.path.join(os.path.dirname(os.path.abspath('scripts/05_plot.py')), '..', '..', '..', 'raw_input', 'compas_data', 'compas-1x.csv')\nwith open(compas_csv) as f:\n    for r in csv.DictReader(f):\n        pub[r['molecule']] = {k: float(v) if k in _nf else v for k, v in r.items()}\n\nsel_csv = os.path.join(os.path.dirname(os.path.abspath('scripts/05_plot.py')), '..', 'inputs', 'selected.csv')\nwith open(sel_csv) as f:\n    selected = list(csv.DictReader(f))\n\nresults = []\nfor m in selected:\n    name = m['molecule']\n    outfile = f'output/{name}.out'\n    if not os.path.exists(outfile): continue\n    with open(outfile) as f:\n        text = f.read()\n    etot_m = re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text)\n    gap_m = re.search(r'HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV', text)\n    homo_m = re.findall(r'(-?[\\d.]+)\\s+\\(HOMO\\)', text)\n    lumo_m = re.findall(r'(-?[\\d.]+)\\s+\\(LUMO\\)', text)\n    if not all([etot_m, gap_m, homo_m, lumo_m]): continue\n    p = pub.get(name, {})\n    results.append({\n        'molecule': name, 'n_rings': int(m['n_rings']),\n        'HOMO_our': float(homo_m[-1]), 'HOMO_lit': p.get('HOMO_eV'),\n        'LUMO_our': float(lumo_m[-1]), 'LUMO_lit': p.get('LUMO_eV'),\n        'GAP_our': float(gap_m.group(1)), 'GAP_lit': p.get('GAP_eV'),\n        'Etot_our': float(etot_m.group(1)) * 27.2114, 'Etot_lit': p.get('Etot_eV'),\n    })\n\nprint(f'results: {len(results)}')\nour = {k: np.array([r[f'{k}_our'] for r in results if r[f'{k}_our'] is not None and r[f'{k}_lit'] is not None]) for k in ['HOMO','LUMO','GAP','Etot']}\nfor k in ['HOMO','LUMO','GAP','Etot']:\n    print(f'  our[{k}]: {len(our[k])}')\n\" 2>&1"}

{"event_type":"tool_call","timestamp":"2026-06-10T12:05:02.914737Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport json\nfrom scipy.stats import spearmanr\nimport numpy as np\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\n\ncompounds = {c['name']: c for c in data}\n\nour = [\n    ('Z11-16-Ald',   -42.0, 'restrained'),\n    ('Z11-16-Ac',    -47.6, 'restrained'),\n    ('Cedrol',       -41.3, 'ab-initio'),\n    ('\u03b2-Ionone',     -31.3, 'ab-initio'),\n    ('C8-Ald',       -30.5, 'restrained'),\n    ('C12-Ald',      -34.2, 'restrained'),\n    ('Palmitic acid',-49.9, 'restrained'),\n    ('Citral',       -25.7, 'restrained'),\n]\n\n# Gnina CNNaffinity from docking_results_table.txt\ngnina_aff = {\n    'Z11-16-Ald': -4.01,\n    'Z11-16-Ac': -3.80,\n    'Cedrol': -3.53,\n    '\u03b2-Ionone': -3.12,\n    'C8-Ald': -3.86,\n    'C12-Ald': -2.27,\n    'Citral': -2.95,\n}\n\nprint(f\"{'Ligand':20s} {'IC50':>8s} {'Kd':>8s} {'HADDOCK':>8s} {'Gnina':>8s} {'Mode':>10s}\")\nprint(\"-\" * 70)\n\nh3_scores, ic50s, kds, g_scores = [], [], [], []\nfor name, h3, mode in our:\n    c = compounds.get(name)\n    if not c:\n        print(f\"{name:20s} {'N/A':>8s} {'N/A':>8s} {h3:>8.1f} {'N/A':>8s} {mode:>10s}\")\n        continue\n    ic50 = c['ic50_obp3']\n    kd = c['kd_obp3']\n    g = gnina_aff.get(name, None)\n    g_str = f'{g:>8.2f}' if g is not None else '     N/A'\n    print(f\"{name:20s} {ic50:>8.1f} {kd:>8.3f} {h3:>8.1f} {g_str} {mode:>10s}\")\n    h3_scores.append(h3)\n    ic50s.append(ic50)\n    kds.append(kd)\n    if g is not None:\n        g_scores.append(g)\n\nprint()\n# Full set Spearman\nrho_h3_ic50, p_h3_ic50 = spearmanr(ic50s, h3_scores)\nrho_h3_kd, p_h3_kd = spearmanr(kds, h3_scores)\nprint(f\"All 8 ligands:\")\nprint(f\"  HADDOCK vs IC50:  \u03c1 = {rho_h3_ic50:+.3f}  (p = {p_h3_ic50:.3f})\")\nprint(f\"  HADDOCK vs Kd:    \u03c1 = {rho_h3_kd:+.3f}  (p = {p_h3_kd:.3f})\")\n\n# Gnina comparison (7 ligands)\ng_ic50s = [compounds[n]['ic50_obp3'] for n,_,_ in our if n in gnina_aff]\nrho_g_ic50, p_g_ic50 = spearmanr(g_ic50s, g_scores)\ng_kds = [compounds[n]['kd_obp3'] for n,_,_ in our if n in gnina_aff]\nrho_g_kd, p_g_kd = spearmanr(g_kds, g_scores)\nprint(f\"\\nGnina (7 ligands):\")\nprint(f\"  Gnina CNNaff vs IC50: \u03c1 = {rho_g_ic50:+.3f}  (p = {p_g_ic50:.3f})\")\nprint(f\"  Gnina CNNaff vs Kd:   \u03c1 = {rho_g_kd:+.3f}  (p = {p_g_kd:.3f})\")\n\n# Exclude saturating binders (IC50=200)\nprint(f\"\\nExcluding saturating non-binders (IC50=200):\")\nmask = [ic50 < 200 for ic50 in ic50s]\nfilt_ic50 = [ic50s[i] for i in range(len(ic50s)) if mask[i]]\nfilt_h3 = [h3_scores[i] for i in range(len(h3_scores)) if mask[i]]\nfilt_names = [our[i][0] for i in range(len(ic50s)) if mask[i]]\nprint(f\"  Ligands: {filt_names}\")\nrho_filt, p_filt = spearmanr(filt_ic50, filt_h3)\nprint(f\"  HADDOCK vs IC50: \u03c1 = {rho_filt:+.3f}  (p = {p_filt:.3f})  n={len(filt_ic50)}\")\n\n# Exclude ab-initio (Cedrol + \u03b2-Ionone)\nprint(f\"\\nExcluding ab-initio runs (Cedrol, \u03b2-Ionone):\")\nmask2 = [m != 'ab-initio' for _,_,m in our]\nr_ic50 = [ic50s[i] for i in range(len(ic50s)) if mask2[i]]\nr_h3 = [h3_scores[i] for i in range(len(h3_scores)) if mask2[i]]\nr_names = [our[i][0] for i in range(len(ic50s)) if mask2[i]]\nrho_r, p_r = spearmanr(r_ic50, r_h3)\nprint(f\"  HADDOCK vs IC50: \u03c1 = {rho_r:+.3f}  (p = {p_r:.3f})  n={len(r_ic50)}\")\n\nPYEOF"}

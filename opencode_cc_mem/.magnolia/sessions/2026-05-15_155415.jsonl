{"event_type":"tool_call","timestamp":"2026-06-24T13:51:53.196724Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport glob,re,os\n# (run, label, length)\nruns=[(\"2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full\",\"KFERQKILDQRFFE\",14),\n      (\"2026-06-16_af3_KFERQx2_s10000_full\",\"KFERQKFERRQ\",11),\n      (\"2026-06-16_af3_RKELQx2_s10000_full\",\"RKELQRKELQ\",10),\n      (\"2026-06-16_af3_QRKELx2_s10000_full\",\"QRKELQRKEL\",10),\n      (\"2026-06-16_af3_RKDLQ-variant_s10000_full\",\"RKDLQRKDDQ\",10),\n      (\"2026-06-16_af3_TGGFQMALT_s10000_full\",\"TGGFQMALT\",9),\n      (\"2026-06-17_TGFMALQ_s10000\",\"TGFMALQ\",7),\n      (\"2026-06-17_RKALQ_s5000\",\"RKALQ\",5)]\nprint(f\"{'peptide':16s}{'len':>4}  {'NBD(<=383)':>12}{'SBD(>=384)':>12}  verdict  (best cluster w/ contactmap)\")\nfor r,lab,L in runs:\n    fs=glob.glob(f\"{r}/output/*_contactmap/cluster*_interchain_contacts.tsv\")\n    if not fs:\n        print(f\"{lab:16s}{L:>4}  (no contactmap fetched)\"); continue\n    # pick highest cluster number available as proxy for a populated cluster\n    def cn(f):\n        m=re.search(r'cluster(\\d+)_',f); return int(m.group(1)) if m else 0\n    # try cluster with most contacts overall\n    best=None;bestn=-1\n    for f in fs:\n        nbd=set();sbd=set()\n        for line in open(f):\n            if line.startswith('#') or not line.strip() or line.startswith('res1'): continue\n            m=re.match(r'A-(\\d+)-',line.split('\\t')[0])\n            if m:\n                rr=int(m.group(1)); (nbd if rr<=383 else sbd).add(rr)\n        tot=len(nbd)+len(sbd)\n        if tot>bestn: bestn=tot;best=(os.path.basename(f).split('_')[0],nbd,sbd)\n    cl,nbd,sbd=best\n    nbd_r=f\"[{min(nbd)}-{max(nbd)}]\" if nbd else \"-\"\n    sbd_r=f\"[{min(sbd)}-{max(sbd)}]\" if sbd else \"-\"\n    verdict=\"SBD-ONLY \u2713\" if not nbd else \"SPANS NBD \u2717\"\n    print(f\"{lab:16s}{L:>4}  {len(nbd):>4} {nbd_r:>7}  {len(sbd):>4} {sbd_r:>7}  {verdict}  (cl{cl})\")\nPY"}

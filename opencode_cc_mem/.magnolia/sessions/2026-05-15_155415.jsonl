{"event_type":"tool_call","timestamp":"2026-06-18T12:46:11.353355Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c # Extract per-residue sidechain energies from sander idecomp output\necho \"=== RKALQ per-residue SC gas-phase energies ===\"\npython3 -c \"\nimport re\n\n# Read the sander_decomp.out for RKALQ\nwith open('projects/hsc70_new/runs/2026-06-17_mmgbsa_analysis/RKALQ_5mer/sander_decomp.out') as f:\n    content = f.read()\n\n# Look for the per-residue decomposition in the output\n# idecomp output has TDC (total), VDW, EEL, etc. per residue\n# Find the section with 'Per-residue' or 'Sidechain'\n# Typical format: \n# RESNUM  RESNAME  INTERNAL  VDW  EEL  ...\n\n# Search for residue lines in the complex region\nlines = content.split('\\n')\nin_decomp = False\nfor i, line in enumerate(lines):\n    if 'SANDER' in line and 'DECOMP' in line:\n        in_decomp = True\n    if in_decomp and len(line) > 20 and not line.startswith(' '):\n        parts = line.split()\n        if len(parts) >= 6:\n            try:\n                resnum = int(parts[0])\n                resname = parts[1]\n                # VDW and EEL are typically at specific positions\n                # Let's print the line to understand format\n                if 640 <= resnum <= 660:\n                    print(f'Res {resnum} {resname}: {line[:120]}')\n            except:\n                pass\n\" 2>&1 | head -20\n\necho \"\"\necho \"=== Let's check the full output format ===\"\ngrep -A50 'DECOMP' projects/hsc70_new/runs/2026-06-17_mmgbsa_analysis/RKALQ_5mer/sander_decomp.out 2>/dev/null | head -60"}

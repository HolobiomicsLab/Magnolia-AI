{"event_type":"tool_call","timestamp":"2026-06-18T10:08:17.660342Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c echo \"=== AF3 5-mers \u2014 12_caprieval, best DockQ cluster, w_air=0.1 ===\"\nprintf \"%-8s %6s %10s %10s %10s %8s %8s\\n\" \"Peptide\" \"Clus\" \"Raw\" \"Air\" \"AIR-free\" \"DockQ\" \"fnat\"\n\nfor af3dir in \\\n  projects/hsc70_new/runs/2026-06-16_af3_KFERQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_KILDQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_QRKEL_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_RKELQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_RKDLQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_HAMNG_s5000_full; do\n  name=$(basename $af3dir | sed 's/.*af3_//;s/_s5000_full//')\n  tsv=\"$af3dir/output/12_caprieval/capri_clt.tsv\"\n  # Find cluster with highest DockQ\n  awk -F'\\t' -v w_air=0.1 -v name=\"$name\" '\n    NR>=15 && $13+0 > max_dockq {\n      max_dockq = $13+0\n      best_score = $5+0\n      best_air = $19+0\n      best_cluster = $2\n      best_fn = $9+0\n      air_free = best_score - w_air * best_air\n    }\n    END {\n      printf \"%-8s %6s %10.2f %10.2f %10.2f %8.3f %8.3f\\n\", name, best_cluster, best_score, best_air, air_free, max_dockq, best_fn\n    }\n  ' \"$tsv\"\ndone\n\necho \"\"\necho \"=== Verification: recompute HADDOCK score from components for best-DockQ clusters ===\"\nfor af3dir in \\\n  projects/hsc70_new/runs/2026-06-16_af3_KFERQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_af3_RKDLQ_s5000_full; do\n  name=$(basename $af3dir | sed 's/.*af3_//;s/_s5000_full//')\n  tsv=\"$af3dir/output/12_caprieval/capri_clt.tsv\"\n  echo \"--- $name ---\"\n  awk -F'\\t' -v name=\"$name\" '\n    NR>=15 && $13+0 > max_dq { max_dq = $13+0; best_nr = NR }\n    NR>=15 {\n      dq = $13+0\n      if (dq > max_dq) max_dq = dq\n    }\n    END {\n      for (i=15; i<=NR; i++) {\n        # need to re-read... hack: store best line\n      }\n    }\n  ' \"$tsv\"\n  # Simpler approach\n  awk -F'\\t' 'NR>=15 {\n    dq = $13+0\n    if (dq > maxd) { maxd=dq; vdw=$29; elec=$25; desolv=$23; air=$19; score=$5 }\n  }\n  END {\n    calc = 1.0*vdw + 0.2*elec + 1.0*desolv + 0.1*air\n    printf \"  vdw=%s  elec=%s  desolv=%s  air=%s\\n\", vdw, elec, desolv, air\n    printf \"  1.0*%.0f + 0.2*%.0f + 1.0*%.1f + 0.1*%.1f = %.3f\\n\", vdw, elec, desolv, air, calc\n    printf \"  TSV score = %s  \u0394 = %.3f\\n\", score, calc - score\n  }' \"$tsv\"\ndone"}

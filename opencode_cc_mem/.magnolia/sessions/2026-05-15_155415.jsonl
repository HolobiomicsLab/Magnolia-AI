{"event_type":"tool_call","timestamp":"2026-06-11T20:08:07.082115Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/envs/ambertools/bin/python3 << 'PYEOF'\nimport numpy as np\n\ndef get_backbone(pdb_file, chain, res_range):\n    atoms = []\n    with open(pdb_file) as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            ch = line[21]\n            if ch != chain: continue\n            rnum = int(line[22:26])\n            if rnum < res_range[0] or rnum > res_range[1]: continue\n            aname = line[12:16].strip()\n            if aname in ('N', 'CA', 'C'):\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms.append({'res': rnum, 'atom': aname, 'xyz': np.array([x,y,z])})\n    return atoms\n\ndef kabsch_rmsd(P, Q):\n    P_cent = P.mean(axis=0); Q_cent = Q.mean(axis=0)\n    P_c = P - P_cent; Q_c = Q - Q_cent\n    C = P_c.T @ Q_c\n    V, _, Wt = np.linalg.svd(C)\n    d = np.linalg.det(Wt.T @ V.T)\n    if d < 0: V[:, -1] *= -1\n    R = Wt.T @ V.T\n    Q_rot = Q_c @ R.T\n    return P_c, Q_rot, P_cent, Q_cent\n\ndef get_CA(pdb_file, chain, resnum):\n    atoms = get_backbone(pdb_file, chain, (resnum, resnum))\n    for a in atoms:\n        if a['atom'] == 'CA': return a['xyz']\n    return None\n\nref_path = '/tmp/contact_analysis/ApKFERQ_cl1_m1.pdb'\nref_rec = np.array([a['xyz'] for a in get_backbone(ref_path, 'A', (1,9999))])\nref_CA647 = get_CA(ref_path, 'B', 647)\nref_CA646 = get_CA(ref_path, 'B', 646)\nref_vec = ref_CA646 - ref_CA647  # extension direction from core toward N-term\nref_vec_norm = ref_vec / np.linalg.norm(ref_vec)\nprint(f\"ApKFERQ: CA647->CA646 vector = {ref_vec} (len={np.linalg.norm(ref_vec):.1f} A)\")\n\n# Long peptides to check\n# KFERQx2 (153341), fusion (153344), RKELQx2 (152508), QRKELQx2 (152511), RKDLQ-variant (152514)\ntests = {\n    'KFERQx2 (11mer)': ('153341', [647, 648, 649, 650, 651, 652, 653, 654, 655, 656, 657]),\n    'KFERQ-KILDQ-fusion (14mer)': ('153344', list(range(647, 661))),\n    'RKELQx2 (10mer)': ('152508', list(range(647, 657))),\n    'QRKELQx2 (10mer)': ('152511', list(range(647, 657))),\n    'RKDLQ-variant (10mer)': ('152514', list(range(647, 657))),\n}\n\nprint(f\"\\n{'Model':<32} {'1st res':>4} {'Last res':>4} {'CA1->CA2 vec len':>15} {'Angle to ref':>12} {'CA2 pos dist':>12}\")\nprint(\"-\" * 95)\nfor name, (id_, reslist) in tests.items():\n    path = f'/tmp/contact_analysis/{id_}_cl1_m1.pdb'\n    tr = np.array([a['xyz'] for a in get_backbone(path, 'A', (1,9999))])\n    pc, qc, pc_c, qc_c = kabsch_rmsd(ref_rec, tr)\n    \n    ca1 = get_CA(path, 'B', reslist[0])\n    ca2 = get_CA(path, 'B', reslist[1])\n    if ca1 is None or ca2 is None:\n        print(f\"{name:<32} (missing)\")\n        continue\n    \n    # Align CA1 and CA2 via receptor alignment\n    test_vec = (ca2 - qc_c) @ np.eye(3)  # Hmm, I need to apply the rotation properly\n    # Actually, let me redo this. After kabsch, we have the rotation R from Wt.T @ V.T\n    # The aligned test peptide = (test_pep - qc_c) @ R.T + pc_c\n    V, _, Wt = np.linalg.svd(qc.T @ pc)\n    R = Wt.T @ V.T\n    ca1_al = (ca1 - qc_c) @ R.T + pc_c\n    ca2_al = (ca2 - qc_c) @ R.T + pc_c\n    \n    test_vec = ca2_al - ca1_al\n    test_len = np.linalg.norm(test_vec)\n    cos_angle = np.dot(ref_vec_norm, test_vec / test_len) if test_len > 0 else 0\n    angle = np.arccos(np.clip(cos_angle, -1, 1)) * 180 / np.pi\n    \n    # Also check distance of ca1 to ref_ca647\n    dist647 = np.linalg.norm(ca1_al - ref_CA647)\n    \n    print(f\"{name:<32} {reslist[0]:>4} {reslist[-1]:>4} {test_len:>15.1f} {angle:>12.1f} deg {dist647:>12.1f} A\")\nPYEOF"}

         elif isinstance(r, str):\n                        try:\n                            inner = json.loads(r)\n                            if isinstance(inner, list):\n                                results = inner\n                        except:\n                            pass\n                elif 'results' in outer:\n                    results = outer['results']\n                \n                all_searches.append((kw[:100], len(results), sid[:20]))\n            except:\n                pass\n\nprint(f'Total memory_search calls: {len(all_searches)}')\nprint()\nfor kw, n, sid in all_searches:\n    marker = '***' if n == 0 else ''\n    print(f'{marker} [{n} results] {kw} {marker}')\n\" 2>&1"}

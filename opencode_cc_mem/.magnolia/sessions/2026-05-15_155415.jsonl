{"event_type":"tool_call","timestamp":"2026-06-09T09:53:12.443183Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 -c \"\nimport json, gzip\n\nwith open('compounds.json') as f:\n    compounds = json.load(f)\n\nwith gzip.open('docked_p2rank.sdf.gz') as f:\n    data = f.read().decode('utf-8', errors='replace')\n\nmols = data.strip().split('\\$\\$\\$\\$')\nmols = [m for m in mols if m.strip()]\nprint(f'Total poses: {len(mols)}')\n\nbest = {}\nfor i, mol in enumerate(mols):\n    comp_idx = i // 20\n    if comp_idx >= len(compounds): break\n    name = compounds[comp_idx]['name']\n    \n    lines = mol.split('\\n')\n    cnn_aff = None\n    cnn_pose = None\n    for j, line in enumerate(lines):\n        if '> <CNNaffinity>' in line and j+1 < len(lines):\n            cnn_aff = float(lines[j+1].strip())\n        if '> <CNNscore>' in line and j+1 < len(lines):\n            cnn_pose = float(lines[j+1].strip())\n    \n    if cnn_aff is not None:\n        if name not in best or cnn_aff > best[name]['aff']:\n            best[name] = {'aff': cnn_aff, 'pose': cnn_pose or 0}\n\nprint(f'Unique compounds: {len(best)}')\nprint()\nranked = sorted(best.items(), key=lambda x: x[1]['aff'], reverse=True)\nprint(f'{\\\"Rank\\\":<5} {\\\"Compound\\\":<25} {\\\"CNNpose\\\":<10} {\\\"CNNaff\\\":<10}')\nprint('-'*55)\nfor i, (name, d) in enumerate(ranked, 1):\n    print(f'{i:<5} {name:<25} {d[\\\"pose\\\"]:<10.4f} {d[\\\"aff\\\"]:<10.4f}')\n\"\n"}
{"event_type":"tool_success","timestamp":"2026-06-09T09:53:12.501435Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":58,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T09:53:37.118994Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, gzip, math\n\nwith open('compounds.json') as f:\n    compounds = json.load(f)\n\n# Read P2Rank docking results\nwith gzip.open('docked_p2rank.sdf.gz') as f:\n    data = f.read().decode('utf-8', errors='replace')\nmols = [m for m in data.strip().split('$$$$') if m.strip()]\n\nbest_p2r = {}\nfor i, mol in enumerate(mols):\n    comp_idx = i // 20\n    if comp_idx >= len(compounds): break\n    name = compounds[comp_idx]['name']\n    lines = mol.split('\\n')\n    cnn_aff = None; cnn_pose = None\n    for j, line in enumerate(lines):\n        if '> <CNNaffinity>' in line and j+1 < len(lines):\n            cnn_aff = float(lines[j+1].strip())\n        if '> <CNNscore>' in line and j+1 < len(lines):\n            cnn_pose = float(lines[j+1].strip())\n    if cnn_aff is not None:\n        if name not in best_p2r or cnn_aff > best_p2r[name]['aff']:\n            best_p2r[name] = {'aff': cnn_aff, 'pose': cnn_pose or 0}\n\n# Read TRS-box docking results (from docked.sdf.gz - same format)\nwith gzip.open('docked.sdf.gz') as f:\n    data = f.read().decode('utf-8', errors='replace')\nmols_trs = [m for m in data.strip().split('$$$$') if m.strip()]\n\nbest_trs = {}\nfor i, mol in enumerate(mols_trs):\n    comp_idx = i // 20\n    if comp_idx >= len(compounds): break\n    name = compounds[comp_idx]['name']\n    lines = mol.split('\\n')\n    cnn_aff = None; cnn_pose = None\n    for j, line in enumerate(lines):\n        if '> <CNNaffinity>' in line and j+1 < len(lines):\n            cnn_aff = float(lines[j+1].strip())\n        if '> <CNNscore>' in line and j+1 < len(lines):\n            cnn_pose = float(lines[j+1].strip())\n    if cnn_aff is not None:\n        if name not in best_trs or cnn_aff > best_trs[name]['aff']:\n            best_trs[name] = {'aff': cnn_aff, 'pose': cnn_pose or 0}\n\n# Spearman helper\ndef spearman(vals_x, vals_y):\n    n = len(vals_x)\n    rx = {v: i for i,v in enumerate(sorted(set(vals_x)))}\n    ry = {v: i for i,v in enumerate(sorted(set(vals_y)))}\n    rx = [rx[v] for v in vals_x]\n    ry = [ry[v] for v in vals_y]\n    d2 = sum((a-b)**2 for a,b in zip(rx, ry))\n    return 1 - 6*d2/(n*(n*n-1))\n\n# Get common compounds and align vectors\ncommon = sorted(set(best_trs.keys()) & set(best_p2r.keys()))\np2r_aff = [best_p2r[c]['aff'] for c in common]\np2r_pose = [best_p2r[c]['pose'] for c in common]\ntrs_aff = [best_trs[c]['aff'] for c in common]\ntrs_pose = [best_trs[c]['pose'] for c in common]\nkd_exp = [compounds[[c2['name'] for c2 in compounds].index(c)]['kd_obp3'] for c in common]\n\nprint(\"=== P2Rank-Box Docking correlations (n=%d) ===\" % len(common))\nprint(\"CNNaff vs experimental Kd: \u03c1 = %.3f\" % spearman(p2r_aff, kd_exp))\nprint(\"CNNpose vs experimental Kd: \u03c1 = %.3f\" % spearman(p2r_pose, kd_exp))\nprint(\"CNNaff (P2Rank box) vs CNNaff (TRS box): \u03c1 = %.3f\" % spearman(p2r_aff, trs_aff))\nprint()\n\n# Compare rankings: strong binders (Kd < 1 uM) in top 10 by each method\nstrong = [c for c in common if compounds[[c2['name'] for c2 in compounds].index(c)]['kd_obp3'] < 1.0]\nprint(\"Strong binders (Kd < 1 \u00b5M): %s\" % ', '.join(strong))\nprint()\n\np2r_ranked = sorted(common, key=lambda x: best_p2r[x]['aff'], reverse=True)\ntrs_ranked = sorted(common, key=lambda x: best_trs[x]['aff'], reverse=True)\n\nprint(\"Top-10 by P2Rank CNNaff:\")\nfor i, c in enumerate(p2r_ranked[:10], 1):\n    kd = compounds[[c2['name'] for c2 in compounds].index(c)]['kd_obp3']\n    is_strong = \"\u2713\" if kd < 1.0 else \"  \"\n    print(f\"  {i:2d}. {c:<25s} aff={best_p2r[c]['aff']:.2f} Kd={kd:.3f} {is_strong}\")\nprint()\n\nprint(\"Top-10 by TRS CNNaff:\")\nfor i, c in enumerate(trs_ranked[:10], 1):\n    kd = compounds[[c2['name'] for c2 in compounds].index(c)]['kd_obp3']\n    is_strong = \"\u2713\" if kd < 1.0 else \"  \"\n    print(f\"  {i:2d}. {c:<25s} aff={best_trs[c]['aff']:.2f} Kd={kd:.3f} {is_strong}\")\nprint()\n\n# Triplets: compare Z11-16-Ald vs Z11-16-OH vs Z11-16-Ac\nfor triplet in [('Z11-16-Ald','Z11-16-OH','Z11-16-Ac'), ('Z9-16-Ald','Z9-16-Ald','Z9-16-COOH')]:\n    if triplet[0] in common:\n        vals_p2r = [best_p2r[t]['aff'] for t in triplet if t in common]\n        vals_trs = [best_trs[t]['aff'] for t in triplet if t in common]\n        kds = [compounds[[c2['name'] for c2 in compounds].index(t)]['kd_obp3'] for t in triplet if t in common]\n        print(f\"Triplet {triplet}:\")\n        print(f\"  Experimental Kd: {dict(zip(triplet, kds))}\")\n        print(f\"  P2Rank CNNaff:   {dict(zip(triplet, vals_p2r))}\")\n        print(f\"  TRS CNNaff:      {dict(zip(triplet, vals_trs))}\")\n        print()\nPYEOF\n"}

{"event_type":"tool_call","timestamp":"2026-06-26T12:11:03.204048Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/mcp_gen.py <<'PYEOF'\nimport json, urllib.request\nBASE=\"http://localhost:8000/mcp\"; SID={\"v\":None}\ndef post(msg,ws=False,timeout=600):\n    data=json.dumps(msg).encode()\n    h={\"Content-Type\":\"application/json\",\"Accept\":\"application/json, text/event-stream\"}\n    if SID[\"v\"]:h[\"Mcp-Session-Id\"]=SID[\"v\"]\n    req=urllib.request.Request(BASE,data=data,headers=h,method=\"POST\")\n    with urllib.request.urlopen(req,timeout=timeout) as r:\n        b=r.read().decode()\n        if ws and \"Mcp-Session-Id\" in r.headers:SID[\"v\"]=r.headers[\"Mcp-Session-Id\"]\n        out=[]\n        for ln in b.splitlines():\n            ln=ln.strip()\n            if ln.startswith(\"data:\"):\n                try:out.append(json.loads(ln[5:].strip()))\n                except:pass\n        if out:return out\n        try:return json.loads(b)\n        except:return b\ndef resof(x):\n    def w(v):\n        if isinstance(v,dict):\n            if \"content\" in v and isinstance(v.get(\"content\"),list):return v\n            for k in v:\n                r=w(v[k])\n                if r:return r\n        elif isinstance(v,list):\n            for i in v:\n                r=w(i)\n                if r:return r\n        return None\n    return w(x)\ndef call(name,args):\n    r=resof(post({\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/call\",\"params\":{\"name\":name,\"arguments\":args}}))\n    if not r:return None\n    return \"\".join(c.get(\"text\",\"\") for c in r.get(\"content\",[]) if isinstance(c,dict))\npost({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"magnolia\",\"version\":\"1.0\"}}},ws=True)\npost({\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}})\n\nargs={\"query\":\"Are there adaptive or intelligent tutoring systems that simultaneously combine ALL of: a concept/prerequisite knowledge graph, retrieval-augmented grounding of tutoring content in course source material, Bloom-taxononmy-typed objectives, mastery-based progression gating, and explainable or provenance-tracked per-decision records? Focus on LLM-based and agentic systems (2022-2026).\",\n \"mode\":\"advanced\",\"databases\":[\"semantic_scholar\",\"openalex\",\"arxiv\",\"google_scholar\"],\n \"max_papers_to_download\":8,\"screen_method\":\"rerank\",\"recency_weight\":0.3}\nout=call(\"generate_report\",args)\nopen(\"/tmp/genreport_raw.txt\",\"w\").write(out or \"\")\n# try parse JSON envelope\ntry:\n    j=json.loads(out)\n    open(\"/tmp/genreport.json\",\"w\").write(json.dumps(j,indent=2))\n    print(\"PARSED keys:\",list(j.keys()) if isinstance(j,dict) else type(j))\n    if isinstance(j,dict):\n        ans=j.get(\"answer\") or j.get(\"report\") or j.get(\"synthesis\") or \"\"\n        print(\"ANSWER len:\",len(str(ans)))\n        print(\"\\n----- ANSWER -----\\n\",str(ans)[:4000])\n        srcs=j.get(\"sources\") or j.get(\"citations\") or j.get(\"references\") or []\n        print(\"\\n----- SOURCES count:\",len(srcs),\"-----\")\n        for s in (srcs[:20] if isinstance(srcs,list) else []):\n            if isinstance(s,dict):\n                print(\" -\",(s.get('year') or ''),s.get('title','')[:90],\"|\",s.get('doi') or s.get('url') or '')\nexcept Exception as e:\n    print(\"not JSON, raw head:\"); print((out or \"\")[:3000])\nPYEOF\ntimeout 500 python3 /tmp/mcp_gen.py 2>&1 | head -120"}

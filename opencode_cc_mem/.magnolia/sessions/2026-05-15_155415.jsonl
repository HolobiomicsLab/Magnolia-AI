{"event_type":"tool_call","timestamp":"2026-06-21T10:26:39.020947Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/studium/studium && .venv/bin/python <<'PYEOF'\nimport fitz, re\npdf = fitz.open('courses_raw_input/l1-courschimie-smd.pdf')\n\n# Extract pages 80-92 (1-indexed) \u2192 indices 79-91\n# Use font sizes to assign markdown heading levels:\n#   20pt \u2192 H1 (chapter title)\n#   16pt \u2192 H2 (sub-chapter like \"1) Bases de la spectroscopie\")\n#   14pt + numbered prefix \u2192 H3 (sub-sub-section like \"1. Introduction\")\n#   anything else \u2192 body paragraph\n# Filter out pure equation lines (lots of inline math noise in PDF extraction)\n\nimport re\n\ndef is_equation_noise(text: str) -> bool:\n    \"\"\"Detect lines that are mostly math symbols / numbers (PDF extraction artifacts).\"\"\"\n    if not text.strip(): return True\n    # word = contiguous letters (allow accented FR)\n    words = re.findall(r\"[A-Za-z\u00c0-\u00ff]{3,}\", text)\n    nchars = len(text)\n    # if <25% of chars are inside real words, it's probably an equation\n    word_chars = sum(len(w) for w in words)\n    return nchars > 4 and word_chars / nchars < 0.25\n\ndef is_figure_label(text: str) -> bool:\n    return bool(re.match(r\"^(Figure|Fig\\.|Tableau|Table)\\s*\\d+\", text.strip(), re.IGNORECASE))\n\nmd_lines = []\nmd_lines.append(\"# Spectroscopies \u2014 UV-Visible et Infra-Rouge\")\nmd_lines.append(\"\")  # chapter title H1 already; replace per-section H1 below if needed\nmd_lines.append(\"_Source : \u00ab Introduction \u00e0 la chimie \u00bb, Nicolas Ch\u00e9ron, PSL \u2014 Licence Sciences pour un Monde Durable, 2024-2025, chapitre Spectroscopies (p.80-92)._\")\nmd_lines.append(\"\")\n\nfor pno in range(79, 92):  # pages 80-92\n    page = pdf[pno]\n    d = page.get_text('dict')\n    for block in d.get('blocks', []):\n        for line in block.get('lines', []):\n            spans = line.get('spans', [])\n            if not spans: continue\n            text = ''.join(s['text'] for s in spans).strip()\n            if not text: continue\n            if is_equation_noise(text): continue\n            if is_figure_label(text): continue\n            max_size = max(s['size'] for s in spans)\n            # Strip the \"1)\" / \"1.\" numbering \u2014 keep the title\n            title_only = re.sub(r\"^\\s*\\d+\\)\\s+\", \"\", text)\n            title_only = re.sub(r\"^\\s*\\d+\\.\\s+\", \"\", title_only)\n            if max_size >= 19:  # chapter 20pt \u2014 skip; we already added H1 above\n                continue\n            elif max_size >= 15:  # sub-chapter 16pt \u2192 H2\n                md_lines.append(f\"## {title_only}\")\n                md_lines.append(\"\")\n            elif max_size >= 13 and re.match(r\"^\\s*\\d+\\.\\s+\", text):\n                # numbered 14pt \u2192 H3\n                md_lines.append(f\"### {title_only}\")\n                md_lines.append(\"\")\n            else:\n                # body text\n                md_lines.append(text)\n                md_lines.append(\"\")\n\n# Collapse 3+ blank lines to 2\noutput = re.sub(r\"\\n{3,}\", \"\\n\\n\", \"\\n\".join(md_lines))\n\n# Trim overly-long bodies (keep total < 9000 chars for the LLM author prompt)\nif len(output) > 9000:\n    print(f\"WARNING: output is {len(output)} chars, truncating to 9000\")\n    output = output[:9000] + \"\\n\\n_[ truncated ]_\"\nelse:\n    print(f\"output: {len(output)} chars (~{len(output)//5} tokens)\")\n\nwith open(\"eval/corpus/04-spectroscopies.md\", \"w\", encoding=\"utf-8\") as f:\n    f.write(output)\n\nprint(f\"\\nwrote eval/corpus/04-spectroscopies.md\")\nPYEOF\necho \"=== preview first 60 lines ===\" && head -60 eval/corpus/04-spectroscopies.md"}

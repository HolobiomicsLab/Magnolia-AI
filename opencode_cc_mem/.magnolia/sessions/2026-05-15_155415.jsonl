{"event_type":"tool_call","timestamp":"2026-06-26T12:08:48.200474Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/mcp.py <<'PYEOF'\nimport json, urllib.request, sys\n\nBASE = \"http://localhost:8000/mcp\"\nSID = {\"v\": None}\n\ndef post(msg, want_session=False):\n    data = json.dumps(msg).encode()\n    headers = {\"Content-Type\":\"application/json\",\n               \"Accept\":\"application/json, text/event-stream\"}\n    if SID[\"v\"]:\n        headers[\"Mcp-Session-Id\"] = SID[\"v\"]\n    req = urllib.request.Request(BASE, data=data, headers=headers, method=\"POST\")\n    with urllib.request.urlopen(req, timeout=600) as r:\n        body = r.read().decode()\n        if want_session and \"Mcp-Session-Id\" in r.headers:\n            SID[\"v\"] = r.headers[\"Mcp-Session-Id\"]\n        # parse SSE or plain JSON\n        out = []\n        for line in body.splitlines():\n            line=line.strip()\n            if line.startswith(\"data:\"):\n                try: out.append(json.loads(line[5:].strip()))\n                except: pass\n        if out: return out\n        try: return json.loads(body)\n        except: return body\n\n# 1. initialize\ninit = {\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\n        \"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\n                  \"clientInfo\":{\"name\":\"magnolia\",\"version\":\"1.0\"}}}\nprint(\"INIT:\", json.dumps(post(init, want_session=True))[:300])\nprint(\"SESSION:\", SID[\"v\"])\n# 2. initialized notification\npost({\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}})\n# 3. tools/list\nres = post({\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"})\ntools = []\ndef walk(x):\n    global tools\n    if isinstance(x, dict):\n        if x.get(\"result\",{}).get(\"tools\"): tools=x[\"result\"][\"tools\"]\n        for v in x.values(): walk(v)\n    elif isinstance(x, list):\n        for v in x: walk(v)\nwalk(res)\nprint(\"TOOL COUNT:\", len(tools))\nfor t in tools:\n    print(\" -\", t.get(\"name\"))\n# print schemas for the search/report tools\nfor t in tools:\n    if t.get(\"name\") in (\"generate_report\",\"search_literature\",\"suggest_databases\"):\n        print(\"\\n=== SCHEMA\", t[\"name\"], \"===\")\n        print(json.dumps(t.get(\"inputSchema\",{}), indent=1)[:1400])\nPYEOF\npython3 /tmp/mcp.py 2>&1 | head -80"}
{"event_type":"tool_success","timestamp":"2026-06-26T12:08:48.323075Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":123,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-26T12:09:20.804100Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/mcp_call.py <<'PYEOF'\nimport json, urllib.request, sys\n\nBASE = \"http://localhost:8000/mcp\"\nSID = {\"v\": None}\ndef post(msg, want_session=False, timeout=600):\n    data = json.dumps(msg).encode()\n    headers = {\"Content-Type\":\"application/json\",\"Accept\":\"application/json, text/event-stream\"}\n    if SID[\"v\"]: headers[\"Mcp-Session-Id\"] = SID[\"v\"]\n    req = urllib.request.Request(BASE, data=data, headers=headers, method=\"POST\")\n    with urllib.request.urlopen(req, timeout=timeout) as r:\n        body=r.read().decode()\n        if want_session and \"Mcp-Session-Id\" in r.headers: SID[\"v\"]=r.headers[\"Mcp-Session-Id\"]\n        out=[]\n        for ln in body.splitlines():\n            ln=ln.strip()\n            if ln.startswith(\"data:\"):\n                try: out.append(json.loads(ln[5:].strip()))\n                except: pass\n        if out: return out\n        try: return json.loads(body)\n        except: return body\ndef result_of(res):\n    # walk to first tools/call result content\n    def walk(x):\n        if isinstance(x,dict):\n            if \"result\" in x and isinstance(x[\"result\"],dict) and \"content\" in x[\"result\"]: return x[\"result\"]\n            for v in x.values():\n                r=walk(v)\n                if r is not None: return r\n        elif isinstance(x,list):\n            for v in x:\n                r=walk(v)\n                if r is not None: return r\n        return None\n    return walk(res)\ndef connect():\n    post({\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"clientInfo\":{\"name\":\"magnolia\",\"version\":\"1.0\"}}}, want_session=True)\n    post({\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\",\"params\":{}})\ndef call(name, args, id=10):\n    res=post({\"jsonrpc\":\"2.0\",\"id\":id,\"method\":\"tools/call\",\"params\":{\"name\":name,\"arguments\":args}})\n    r=result_of(res)\n    if r is None: return res\n    # content is list of {type,text}\n    txt=\"\".join(c.get(\"text\",\"\") for c in r.get(\"content\",[]) if isinstance(c,dict))\n    return txt\n\nconnect()\nprint(\"=== suggest_databases ===\")\nprint(call(\"suggest_databases\",{\"query\":\"adaptive tutoring knowledge graph grounded LLM\"})[:500])\n\nqueries = {\n \"q1\":\"knowledge graph grounded large language model adaptive tutoring system\",\n \"q2\":\"intelligent tutoring system retrieval-augmented generation grounded explainable provenance\",\n \"q3\":\"cognitive offloading hint usage penalty mastery estimation tutoring\",\n}\nfor k,q in queries.items():\n    print(f\"\\n=== search_literature {k}: {q} ===\")\n    out=call(\"search_literature\",{\"query\":q,\"max_results\":15,\"databases\":[\"semantic_scholar\",\"openalex\",\"arxiv\"]}, id=hash(k)%1000+10)\n    # try to parse as JSON list of papers\n    try:\n        papers=json.loads(out)\n        if isinstance(papers,dict): papers=papers.get(\"papers\") or papers.get(\"results\") or []\n        print(\"count:\",len(papers))\n        for p in papers[:12]:\n            if isinstance(p,dict):\n                t=p.get(\"title\") or p.get(\"name\") or \"?\"\n                y=p.get(\"year\") or p.get(\"published\",\"\")\n                v=p.get(\"venue\") or p.get(\"source\",\"\")\n                ids=p.get(\"doi\") or p.get(\"arxiv\") or p.get(\"paperId\") or \"\"\n                print(f\"  - [{y}] {t} | {v} | {ids}\")\n    except Exception as e:\n        print(\"raw:\", out[:600])\nPYEOF\npython3 /tmp/mcp_call.py 2>&1 | head -90"}

{"event_type":"tool_success","timestamp":"2026-06-09T13:21:11.213145Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":120048,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T13:21:32.982477Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('gnina_bridge_all.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\n\n# Extract per compound: CNN-best affinity, best empirical affinity, CNN score\ncnn_best, emp_best, cnn_scores = [], [], []\nfor block in blocks[1:]:\n    poses = re.findall(r'\\n\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', block)\n    if poses:\n        cnn_best.append(float(poses[0][1]))      # rank 1 (CNN-best)\n        cnn_scores.append(float(poses[0][3]))      # CNN score of rank 1\n        emp_best.append(min(float(p[1]) for p in poses))  # best empirical across all\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\nkd_all = np.array([exp_lk.get(name_map.get(fn,fn),999) for fn in sdf_names_sorted[:len(cnn_best)]])\n\n# 4 correlations\nprint(\"\u2550\u2550\u2550 BRIDGE BOX + 6 FLEX RESIDUES + EXHAUST 16 (n=40) \u2550\u2550\u2550\\n\")\n\nfor label, arr in [(\"CNN-ranked affinity (gnina default)\", np.array(cnn_best)),\n                    (\"Best empirical affinity (across 20 poses)\", np.array(emp_best)),\n                    (\"CNN pose score\", np.array(cnn_scores))]:\n    rho, p = spearmanr(arr, kd_all)\n    print(f\"  {label:<45s} \u03c1={rho:+.4f}  p={p:.4f}\")\n\n# By class (best empirical)\nGOOD = [emp_best[i] for i in range(len(emp_best)) if kd_all[i] < 1.0]\nMOD = [emp_best[i] for i in range(len(emp_best)) if 1.0 <= kd_all[i] < 10]\nWEAK = [emp_best[i] for i in range(len(emp_best)) if kd_all[i] >= 10]\nprint(f\"\\n  Best empirical affinity by class:\")\nprint(f\"    STRONG (n={len(GOOD)}):     {np.mean(GOOD):+.2f} \u00b1 {np.std(GOOD):.2f}\")\nprint(f\"    MODERATE (n={len(MOD)}):   {np.mean(MOD):+.2f} \u00b1 {np.std(MOD):.2f}\")\nprint(f\"    WEAK/NON (n={len(WEAK)}):  {np.mean(WEAK):+.2f} \u00b1 {np.std(WEAK):.2f}\")\n\n# Z11-16\nprint(f\"\\n  Z11-16 series (best emp affinity):\")\nfor i in range(len(emp_best)):\n    name = name_map.get(sdf_names_sorted[i], sdf_names_sorted[i])\n    if 'Z11-16' in name:\n        print(f\"    {name:<15s} Kd={kd_all[i]:.3f}  Aff={emp_best[i]:+.2f}\")\n\n# Compare with old runs\nprint(f\"\\n\u2550\u2550\u2550 COMPARISON ALL GNINA RUNS \u2550\u2550\u2550\")\nprint(f\"  TRS rigid:             \u03c1=+0.0654\")\nprint(f\"  P2Rank rigid:          \u03c1=+0.0610\")\nprint(f\"  P2Rank flex 4res:      \u03c1=+0.1123\")\nprint(f\"  BRIDGE flex 6res:      \u03c1={'+' if spearmanr(np.array(emp_best),kd_all)[0]>=0 else ''}{spearmanr(np.array(emp_best),kd_all)[0]:.4f}  \u2190 best empirical\")\nprint(f\"  BRIDGE flex 6res CNN:  \u03c1={'+' if spearmanr(np.array(cnn_best),kd_all)[0]>=0 else ''}{spearmanr(np.array(cnn_best),kd_all)[0]:.4f}  \u2190 CNN-ranked\")\n\nPYEOF"}

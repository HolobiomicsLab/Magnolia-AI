{"event_type":"tool_call","timestamp":"2026-06-15T08:29:11.360058Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport subprocess, os\n\n# Find lid-restraint runs (early runs) and P2Rank runs (later runs)\n# Lid restraint: look for KILDQ/s2000 or early runs\n# P2Rank: look for later runs with s5000\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\n# Manual lid: KILDQ was the first successful run\nlid_files = []\nfor root, dirs, files in os.walk(os.path.join(base, \"2026-06-01_KILDQ_s2000\")):\n    if \"capri_clt.tsv\" in root and \"analysis\" not in root:\n        lid_files.append(os.path.join(root, \"capri_clt.tsv\"))\n\n# P2Rank runs: KFERQ s5000\np2r_files = []\nfor run_name in [\"2026-06-01_KFERQ_s5000\"]:\n    rp = os.path.join(base, run_name)\n    if os.path.isdir(rp):\n        for root, dirs, files in os.walk(rp):\n            if \"capri_clt.tsv\" in root and \"analysis\" not in root:\n                p2r_files.append(os.path.join(root, \"capri_clt.tsv\"))\n\n# Read best scores\ndef read_best_score(path):\n    with open(path) as f:\n        lines = f.readlines()\n    for line in lines[1:]:\n        cols = line.strip().split('\\t')\n        if len(cols) >= 8:\n            return float(cols[1])  # score column\n    return None\n\nprint(\"=== LID RESTRAINT (KILDQ) ===\")\nfor f in sorted(lid_files):\n    s = read_best_score(f)\n    if s:\n        print(f\"  {os.path.basename(os.path.dirname(os.path.dirname(f)))}: {s:.1f}\")\n\nprint(\"\\n=== P2RANK (KFERQ) ===\")\nfor f in sorted(p2r_files):\n    s = read_best_score(f)\n    if s:\n        print(f\"  {os.path.basename(os.path.dirname(os.path.dirname(f)))}: {s:.1f}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-24T13:58:47.216420Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\nR=2026-06-16_af3_KFERQx2_s10000_full\necho \"=== KFERQx2 AF3 score (12_caprieval, best clusters) ===\"\npython3 - <<PY\nimport json\nR=\"$R\"\nwp=f\"{R}/output/12_caprieval/weights_params.json\"\nwair=json.load(open(wp)).get('w_air',0.1)\nrows=[];idx={}\nfor line in open(f\"{R}/output/12_caprieval/capri_clt.tsv\"):\n    if line.startswith('#') or not line.strip(): continue\n    if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n    rows.append(line.rstrip().split('\\t'))\ng=lambda rw,c: rw[idx[c]]\nfor rw in rows[:4]:\n    af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"  clt{g(rw,'cluster_id')} rank{g(rw,'caprieval_rank')}: AIR-free={af:.2f} DockQ={float(g(rw,'dockq')):.3f} n={g(rw,'n')}\")\nPY\necho\necho \"=== 13_contactmap contents ===\"\nls $R/output/13_contactmap/ 2>/dev/null | head\necho \"--- any contacts tsv (any name) ---\"\nfind $R/output/13_contactmap -name '*.tsv' 2>/dev/null | head\necho\necho \"=== KFERQx2 alascan per-residue (9 rows) ===\"\npython3 - <<'PY'\nf=\"2026-06-22_alascan_kferqx2_af3/output/1_alascan/scan_complex_haddock.tsv\"\nhdr=None;rows=[]\nfor line in open(f):\n    if line.startswith('#') or not line.strip(): continue\n    c=line.rstrip().split('\\t')\n    if hdr is None: hdr=c; continue\n    rows.append(c)\nprint(\"cols:\",hdr[:8])\nfor r in rows:\n    print(f\"  chain{r[0]} res{r[1]} {r[2]}->{r[3]} score={r[4]} vdw={r[5]} elec={r[6]} desolv={r[7]}\")\nPY"}
{"event_type":"tool_success","timestamp":"2026-06-24T13:58:47.287438Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":71,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-24T13:59:32.729953Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport gzip,glob,re\nR=\"2026-06-16_af3_KFERQx2_s10000_full\"\n# best cluster = clt9; use model 1\nm=sorted(glob.glob(f\"{R}/output/11_seletopclusts/cluster_9_model_*.pdb.gz\"))\nprint(\"clt9 models present:\",len(m))\nif not m: \n    raise SystemExit(\"no clt9 model\")\nf=m[0]\nrec={}; pep={}  # res -> list of (atom,xyz)\nwith gzip.open(f,'rt') as fh:\n    for line in fh:\n        if not line.startswith('ATOM'): continue\n        ch=line[21]; res=int(line[22:26]); name=line[12:16].strip()\n        if name in ('H','HA','HB','HG','HD','HE','HF','HH'): continue  # skip H\n        if name.startswith('H'): continue\n        try: x,y,z=float(line[30:38]),float(line[38:46]),float(line[46:54])\n        except: continue\n        (pep if ch=='B' else rec).setdefault((ch,res),[]).append((name,x,y,z))\n# receptor residues within 5A of any peptide heavy atom\npep_atoms=[a for v in pep.values() for a in v]\nnbd=set();sbd=set()\nfor (ch,res),atoms in rec.items():\n    for nm,x,y,z in atoms:\n        for _,px,py,pz in pep_atoms:\n            if (x-px)**2+(y-py)**2+(z-pz)**2 <= 25.0:  # 5A\n                if res<=383: nbd.add(res)\n                else: sbd.add(res)\n                break\nprint(f\"\\nKFERQx2 clt9 (best, -126.60, DockQ 0.815):\")\nprint(f\"  NBD contacts (<=383): {len(nbd)}  {sorted(nbd) if nbd else 'NONE'}\")\nprint(f\"  SBD contacts (>=384): {len(sbd)}  range [{min(sbd)}-{max(sbd)}]\" if sbd else \"  SBD: none\")\nprint(f\"  VERDICT: {'SBD-ONLY \u2713' if not nbd else 'SPANS NBD \u2717'}\")\nPY"}

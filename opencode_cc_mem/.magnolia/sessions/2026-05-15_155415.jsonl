{"event_type":"tool_call","timestamp":"2026-06-12T14:11:39.175919Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'EOF'\nimport math\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') and line[13:16].strip() == 'CA':\n                atoms.append({\n                    'resn': line[17:20].strip(), 'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                })\n    return atoms\n\nfor label, path in [\n    (\"AlphaFold HSPA8\", \"projects/hsc70_new/raw_input/closed_state/AF-P11142-F1-model_v4.pdb\"),\n    (\"Current receptor (open)\", \"projects/hsc70_new/raw_input/receptor/hsc70-full_processed.pdb\"),\n]:\n    atoms = parse_pdb(path)\n    chain_a = [a for a in atoms if a['chain'] == 'A']\n    \n    # Lid helices A (513-535) and B (543-568)\n    lid_helix_a = [a for a in chain_a if 513 <= a['resi'] <= 535]\n    lid_helix_b = [a for a in chain_a if 543 <= a['resi'] <= 568]\n    sbd_beta = [a for a in chain_a if 394 <= a['resi'] <= 509]\n    \n    min_ha = 999\n    min_hb = 999\n    for a in lid_helix_a:\n        for b in sbd_beta:\n            d = math.sqrt((a['x']-b['x'])**2 + (a['y']-b['y'])**2 + (a['z']-b['z'])**2)\n            if d < min_ha: min_ha = d\n    for a in lid_helix_b:\n        for b in sbd_beta:\n            d = math.sqrt((a['x']-b['x'])**2 + (a['y']-b['y'])**2 + (a['z']-b['z'])**2)\n            if d < min_hb: min_hb = d\n    \n    print(f\"\\n{label}:\")\n    print(f\"  Helix A (513-535) min to SBD-beta: {min_ha:.1f} A\")\n    print(f\"  Helix B (543-568) min to SBD-beta: {min_hb:.1f} A\")\n    \n    if min_ha < 15 or min_hb < 15:\n        print(f\"  \u2192 LID IS CLOSED over SBD-beta\")\n    else:\n        print(f\"  \u2192 LID IS OPEN\")\nEOF"}

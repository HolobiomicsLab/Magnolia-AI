{"event_type":"tool_call","timestamp":"2026-06-11T09:35:55.557129Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob, subprocess\n\n# First, get lengths for run dirs by looking at the peptide.pdb files\nlength_map = {}\n# Check each run dir for a peptide PDB\nfor rundir in sorted(glob.glob('runs/*/')) + sorted(glob.glob('runs/*/')):\n    name = os.path.basename(rundir.rstrip('/'))\n    # Try common PDB names\n    for pdbname in ['peptide.pdb', 'peptide1.pdb', 'peptide2.pdb']:\n        p = os.path.join(rundir, pdbname)\n        if os.path.exists(p):\n            res = os.popen(f\\\"grep '^ATOM' {p} | awk '{{print \\\\$6}}' | sort -nu\\\").read().strip().split()\n            if res:\n                first, last = int(res[0]), int(res[-1])\n                length = last - first + 1\n                length_map[name] = length\n                break\n\n# Now parse capri_clt.tsv\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nresults = []\n\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21:\n                continue\n            score = float(parts[4])\n            air = float(parts[18])\n            air_free = score - 0.1 * air\n            results.append({\n                'run': d,\n                'score': score,\n                'air_free': air_free,\n                'dockq': float(parts[12]),\n                'irmsd': float(parts[6]),\n                'bsa': float(parts[20]),\n                'air': air,\n                'length': length_map.get(d, '?'),\n            })\n            if parts[0] == '1':\n                break\n\nseen = set()\nuniq = []\nfor r in results:\n    if r['run'] not in seen:\n        seen.add(r['run'])\n        uniq.append(r)\n\ndef peptide_name(r):\n    n = r['run']\n    # Strip date prefix\n    n = n.split('_', 3)[-1] if n.startswith('202') else n\n    # Clean suffixes\n    for s in ['_p2rank1_s5000','_p2rank1_s10000','_p2rank1_s2000','_s5000','_s2000','_s1000','_clean']:\n        n = n.replace(s, '')\n    if '_SBD_' in n:\n        n = n.replace('_SBD_', ' (SBD)')\n    return n\n\ndef cat(r):\n    n = r['run'].lower()\n    if 'x2' in n or 'fusion' in n or 'variant' in n:\n        return 3\n    if 'pk' in n or 'pf' in n or 'pq' in n or 'pa_c' in n or 'apkferq' in n:\n        return 2\n    if 'p2rank' in n:\n        return 1\n    return 0\n\nuniq.sort(key=lambda r: (cat(r), r['air_free']))\n\nprint(f\\\"{'Peptide':<22} {'Len':>3} {'Score':>9} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7}\\\")\nprint('-' * 70)\nfor r in uniq:\n    print(f\\\"{peptide_name(r):<22} {str(r['length']):>3} {r['score']:>9.2f} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f}\\\")\n\""}

{"event_type":"tool_call","timestamp":"2026-07-01T07:30:09.456896Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = {\n    \"EGGFQMAKT\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"EAKFQMALT\": \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\",\n    \"EAGFQMRLT\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\",\n    \"EAGFQMKLT\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\",\n}\n\nfor label, d in runs.items():\n    print(f\"\\n{'='*60}\")\n    print(f\"  {label} \u2014 contact map summary\")\n    print(f\"{'='*60}\")\n    \n    # Find contact map files\n    cm_dir = f\"{d}/output/13_contactmap\"\n    if not os.path.isdir(cm_dir):\n        cm_dir = f\"{d}/output/analysis/12_caprieval_analysis\"\n    \n    # Check for interchain contacts\n    for fname in sorted(os.listdir(cm_dir)):\n        if 'interchain_contacts.tsv' in fname:\n            fpath = os.path.join(cm_dir, fname)\n            with open(fpath) as f:\n                lines = [l for l in f if not l.startswith('#')]\n            if not lines:\n                continue\n            reader = csv.DictReader(lines, delimiter='\\t')\n            # Count contacts per peptide residue -> receptor residue\n            peptide_contacts = {}\n            for row in reader:\n                pept_res = row.get('res1', row.get('residue1',''))\n                pept_num = row.get('resnum1', row.get('resnum_1',''))\n                rec_res = row.get('res2', row.get('residue2',''))\n                rec_num = row.get('resnum2', row.get('resnum_2',''))\n                ct = row.get('contact-type','')\n                dist = row.get('shortest-dist', row.get('distance',''))\n                key = f\"{pept_res}{pept_num}\"\n                if key not in peptide_contacts:\n                    peptide_contacts[key] = []\n                peptide_contacts[key].append((rec_res, rec_num, ct, dist))\n            \n            print(f\"\\n  File: {fname}\")\n            for pept, contacts in sorted(peptide_contacts.items()):\n                # Show top receptor contacts by distance\n                sorted_ct = sorted(contacts, key=lambda x: float(x[3]) if x[3] else 999)\n                rec_str = \", \".join(f\"{r}{n}({d[:4]})\" for r,n,_,d in sorted_ct[:5])\n                print(f\"    {pept}: {rec_str}\")\n            break  # Only first matching file\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-11T19:12:08.027012Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/envs/ambertools/bin/python3 << 'PYEOF'\nimport numpy as np\n\ndef get_backbone(pdb_file, chain, res_range):\n    atoms = []\n    with open(pdb_file) as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            ch = line[21]\n            if ch != chain: continue\n            rnum = int(line[22:26])\n            if rnum < res_range[0] or rnum > res_range[1]: continue\n            aname = line[12:16].strip()\n            if aname in ('N', 'CA', 'C'):\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms.append({'res': rnum, 'atom': aname, 'xyz': np.array([x,y,z])})\n    return atoms\n\ndef kabsch_rmsd(P, Q):\n    P_cent = P.mean(axis=0); Q_cent = Q.mean(axis=0)\n    P_c = P - P_cent; Q_c = Q - Q_cent\n    C = P_c.T @ Q_c\n    V, _, Wt = np.linalg.svd(C)\n    d = np.linalg.det(Wt.T @ V.T)\n    if d < 0: V[:, -1] *= -1\n    R = Wt.T @ V.T\n    Q_rot = Q_c @ R.T\n    return np.sqrt(((P_c - Q_rot)**2).sum()/len(P)), R, P_cent, Q_cent\n\nref_path = '/tmp/contact_analysis/ApKFERQ_cl1_m1.pdb'\ntest_paths = {\n    'N-VAL cl1': '/tmp/contact_analysis/N-VAL_cl1_m1.pdb',\n    'N-SER cl1': '/tmp/contact_analysis/N-SER_cl1_m1.pdb',\n    'N-GLY cl1': '/tmp/contact_analysis/N-GLY_cl1_m1.pdb',\n    'N-LYS cl1': '/tmp/contact_analysis/N-LYS_cl1_m1.pdb',\n}\n\nref_rec = np.array([a['xyz'] for a in get_backbone(ref_path, 'A', (1,9999))])\nref_pep = np.array([a['xyz'] for a in get_backbone(ref_path, 'B', (646,651))])\n\nprint(f\"{'Model':<16} {'Rec RMSD':>9} {'Pep BB RMSD':>12} {'Mode':>10}\")\nprint(\"-\" * 52)\nfor name, path in test_paths.items():\n    test_rec = np.array([a['xyz'] for a in get_backbone(path, 'A', (1,9999))])\n    test_pep = np.array([a['xyz'] for a in get_backbone(path, 'B', (646,651))])\n    rmsd_rec, R, rc_ref, rc_test = kabsch_rmsd(ref_rec, test_rec)\n    pep_test = test_pep - rc_test\n    pep_rot = pep_test @ R.T\n    pep_aligned = pep_rot + rc_ref\n    diff = ref_pep - pep_aligned\n    rmsd_pep = np.sqrt(((diff)**2).sum() / len(ref_pep))\n    mode = \"SAME\" if rmsd_pep < 2.0 else \"DIFF\" if rmsd_pep < 4.0 else \"FAR\"\n    print(f\"{name:<16} {rmsd_rec:>9.3f} {rmsd_pep:>12.3f} {mode:>10}\")\nPYEOF"}

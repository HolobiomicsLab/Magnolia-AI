{"event_type":"tool_call","timestamp":"2026-06-02T11:32:03.622963Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c DIR=\"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\npython3 << 'PYEOF'\nimport os, re, collections\n\nruns = {\n    \"KILDQ\": \"2026-06-01_KILDQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"KFERQ\": \"2026-06-02_KFERQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"QRKEL\": \"2026-06-02_QRKEL_p2rank1_s5000/output/13_contactmap/cluster12_interchain_contacts.tsv\",\n    \"RKELQ\": \"2026-06-02_RKELQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKDLQ\": \"2026-06-02_RKDLQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n}\n\n# Collect all receptor residues per peptide\nrec_contacts = collections.defaultdict(list)\n\nfor pep, path in runs.items():\n    full = os.path.join(DIR, path)\n    with open(full) as f:\n        for line in f:\n            if line.startswith('#'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 7:\n                continue\n            res1 = parts[0]  # A-XXX-RESN\n            if not res1.startswith('A-'):\n                continue\n            match = re.match(r'A-(\\d+)-(\\w+)', res1)\n            if match:\n                resnum = int(match.group(1))\n                resname = match.group(2)\n                ctype = parts[4]\n                short_prob = float(parts[5])\n                short_dist = float(parts[6])\n                rec_contacts[resnum].append({\n                    'pep': pep, 'resname': resname, 'type': ctype,\n                    'short_prob': short_prob, 'short_dist': short_dist\n                })\n\n# Count how many peptides each receptor residue appears in\ncounts = collections.Counter()\nbest_interactions = {}\nfor resnum, entries in rec_contacts.items():\n    peps = set(e['pep'] for e in entries)\n    counts[resnum] = len(peps)\n    # Best (lowest distance) interaction\n    best = min(entries, key=lambda e: e['short_dist'])\n    best_interactions[resnum] = best\n\n# Print sorted by frequency\nprint(f\"{'Res':<10} {'Name':<6} {'Freq':<6} {'Best contact':<30} {'Dist':<6} {'Prob':<6}\")\nprint(\"-\" * 70)\nfor resnum, freq in counts.most_common():\n    if freq < 3:\n        continue\n    bi = best_interactions[resnum]\n    best_contact = f\"{bi['pep']} {bi['type']}\"\n    print(f\"A-{resnum:<8} {bi['resname']:<6} {freq}/5    {best_contact:<30} {bi['short_dist']:<6.1f} {bi['short_prob']:<6.2f}\")\n\nPYEOF"}

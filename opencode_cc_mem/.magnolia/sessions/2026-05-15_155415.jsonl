{"event_type":"tool_call","timestamp":"2026-06-20T19:39:16.395203Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 -c \"\nimport csv, re, os, numpy as np\n\n_numeric_fields = {'n_rings','HOMO_eV','LUMO_eV','GAP_eV','Etot_eV','Erel_eV','aIP_eV','aEA_eV','ZPE_eV'}\n\npub = {}\nwith open('../../raw_input/compas_data/compas-1x.csv') as f:\n    for r in csv.DictReader(f):\n        pub[r['molecule']] = {k: float(v) if k in _numeric_fields else v for k, v in r.items()}\n\nwith open('inputs/selected.csv') as f:\n    selected = list(csv.DictReader(f))\n\nresults = []\nfor m in selected:\n    name = m['molecule']\n    outfile = f'output/{name}.out'\n    if not os.path.exists(outfile): continue\n    with open(outfile) as f:\n        text = f.read()\n    etot_m = re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text)\n    gap_m = re.search(r'HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV', text)\n    homo_m = re.findall(r'(-?[\\d.]+)\\s+\\(HOMO\\)', text)\n    lumo_m = re.findall(r'(-?[\\d.]+)\\s+\\(LUMO\\)', text)\n    if not all([etot_m, gap_m, homo_m, lumo_m]): continue\n    etot_ev = float(etot_m.group(1)) * 27.2114\n    gap_ev = float(gap_m.group(1))\n    homo_ev = float(homo_m[-1])\n    lumo_ev = float(lumo_m[-1])\n    p = pub.get(name, {})\n    results.append({\n        'molecule': name, 'n_rings': int(m['n_rings']),\n        'HOMO_our': homo_ev, 'HOMO_lit': p.get('HOMO_eV'),\n        'LUMO_our': lumo_ev, 'LUMO_lit': p.get('LUMO_eV'),\n        'GAP_our': gap_ev, 'GAP_lit': p.get('GAP_eV'),\n        'Etot_our': etot_ev, 'Etot_lit': p.get('Etot_eV'),\n    })\n\nprint(f'Results: {len(results)}')\n\nour = {k: np.array([r[f'{k}_our'] for r in results if r[f'{k}_our'] is not None and r[f'{k}_lit'] is not None]) for k in ['HOMO','LUMO','GAP','Etot']}\nfor k, v in our.items():\n    print(f'  our[{k}]: len={len(v)}')\n\nlit = {k: np.array([r[f'{k}_lit'] for r in results if r[f'{k}_our'] is not None and r[f'{k}_lit'] is not None]) for k in ['HOMO','LUMO','GAP','Etot']}\nfor k, v in lit.items():\n    print(f'  lit[{k}]: len={len(v)}')\n\" 2>&1"}

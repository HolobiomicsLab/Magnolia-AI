{"event_type":"tool_call","timestamp":"2026-06-15T08:33:13.984372Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, subprocess\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\ndef parse_capri(path):\n    \"\"\"Parse capri_clt.tsv, return list of (cluster_id, score, air) for top clusters.\"\"\"\n    results = []\n    try:\n        with open(path) as f:\n            header = f.readline().strip().split('\\t')\n            for line in f:\n                cols = line.strip().split('\\t')\n                if len(cols) >= 8:\n                    cluster_id = cols[0]\n                    score = float(cols[1])\n                    # air is typically column 7 or 8\n                    results.append((cluster_id, score))\n    except:\n        pass\n    return results\n\n# Find best score per run directory\nruns_data = {}\nfor d in sorted(os.listdir(base)):\n    rp = os.path.join(base, d)\n    if not os.path.isdir(rp): continue\n    best = None\n    for root, dirs, files in os.walk(rp):\n        if \"capri_clt.tsv\" in root and \"analysis\" not in root:\n            path = os.path.join(root, \"capri_clt.tsv\")\n            res = parse_capri(path)\n            for cid, score in res:\n                if best is None or score < best:\n                    best = score\n    if best is not None:\n        runs_data[d] = best\n\n# Print Hsc70 key runs\nprint(\"=== HSC70 NEW BEST SCORES ===\")\nfor name, score in sorted(runs_data.items()):\n    # Determine category\n    if \"p2rank1\" in name or \"p2rank\" in name:\n        cat = \"p2rank\"\n    else:\n        cat = \"lid\"\n    print(f\"{cat:8s} | {score:8.2f} | {name}\")\nPYEOF"}

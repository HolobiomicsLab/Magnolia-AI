p_in = f\"\"\"source leaprc.protein.ff14SB\ncomplex = loadpdb {work}/complex.pdb\nsaveamberparm complex {work}/complex.prmtop {work}/complex.rst7\nrec = loadpdb {work}/rec.pdb\nsaveamberparm rec {work}/rec.prmtop {work}/rec.rst7\nlig = loadpdb {work}/lig.pdb\nsaveamberparm lig {work}/lig.prmtop {work}/lig.rst7\nquit\n\"\"\"\n    with open(f\"{work}/tleap.in\", 'w') as f:\n        f.write(tleap_in)\n    \n    mmpbsa_in = \"\"\"&general\n  startframe=1, endframe=1, interval=1, keep_files=0, verbose=0,\n/\n&gb\n  igb=5, saltcon=0.150,\n/\n&decomp\n  idecomp=1, dec_verbose=3,\n/\n\"\"\"\n    with open(f\"{work}/mmpbsa.in\", 'w') as f:\n        f.write(mmpbsa_in)\n    \n    subprocess.run(f\"{conda_setup} && cd {work} && tleap -f tleap.in > tleap.log 2>&1\", shell=True, capture_output=True)\n    subprocess.run(\n        f\"{conda_setup} && cd {work} && MMPBSA.py -O -i mmpbsa.in \"\n        f\"-cp complex.prmtop -rp rec.prmtop -lp lig.prmtop \"\n        f\"-y complex.rst7 -o out.dat -do decomp.dat \"\n        f\"-sp complex.prmtop -sr complex.rst7 > mmpbsa.log 2>&1\",\n        shell=True, capture_output=True\n    )\n    \n    # Parse: for each ligand residue, take the FIRST occurrence of ,L\n    lig_data = []\n    seen = set()\n    try:\n        with open(f\"{work}/decomp.dat\") as f:\n            for line in f:\n                # Check if this is a ligand line (contains ',L ' after the space)\n                if ',L ' not in line:\n                    continue\n                # Extract first field which is \"RESNAME RESI\"\n                first_field = line.split(',')[0].strip()\n                resname = first_field.split()[0]\n                resi = first_field.split()[1]\n                key = f\"{resname}{resi}\"\n                if key in seen:\n                    continue\n                seen.add(key)\n                \n                parts = line.strip().split(',')\n                try:\n                    vdw = float(parts[5])\n                    elec = float(parts[8])\n                    polar = float(parts[11])\n                    npolar = float(parts[14])\n                    total = float(parts[17])\n                    interaction = vdw + elec + polar + npolar\n                    lig_data.append((key, vdw, elec, polar, npolar, total, interaction))\n                except (ValueError, IndexError):\n                    pass\n    except FileNotFoundError:\n        pass\n    \n    if lig_data:\n        results[tag] = lig_data\n    \n    shutil.rmtree(work, ignore_errors=True)\n\n# Print results\nprint(\"=== Per-residue interaction energy (kcal/mol), best cluster model 1 ===\")\nprint()\nfor tag, data in results.items():\n    print(f\"--- {tag} ---\")\n    total_int = 0\n    for key, vdw, elec, polar, npolar, t, inter in data:\n        total_int += inter\n        print(f\"  {key:8s}  vdW={vdw:+7.2f}  elec={elec:+7.1f}  polar={polar:+7.1f}  np={npolar:+5.2f}  \u2192  tot={t:+7.1f}  int={inter:+7.1f}\")\n    best = min(data, key=lambda x: x[6])\n    worst = max(data, key=lambda x: x[6])\n    print(f\"  \u03a3 interaction = {total_int:+.1f}  |  best: {best[0]}={best[6]:+.1f}  worst: {worst[0]}={worst[6]:+.1f}\")\n    print()\nPYEOF"}

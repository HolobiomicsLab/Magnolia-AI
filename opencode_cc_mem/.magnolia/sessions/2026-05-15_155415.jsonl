(p_data)\n            text = part.get('text', '')\n            if any(k.lower() in text.lower() for k in keywords):\n                if len(text) > 1800:\n                    text = text[:1800] + '...'\n                hits.append(text[:300])\n        except:\n            pass\n    \n    if hits:\n        print(f'=== {sess_id} ({len(hits)} hits) ===')\n        for i, h in enumerate(hits[:15]):\n            print(f'  [{i}] {h[:250]}')\n        if len(hits) > 15:\n            print(f'  ... and {len(hits)-15} more')\n        print()\n\nconn.close()\n\" 2>&1 | head -500"}

{"event_type":"tool_call","timestamp":"2026-07-01T09:26:11.900689Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, os, numpy as np\nfrom scipy.spatial import KDTree\n\ndef load_pdb(filepath):\n    atoms = []\n    f = gzip.open(filepath, 'rt') if filepath.endswith('.gz') else open(filepath)\n    for line in f:\n        if line.startswith('ATOM'):\n            atoms.append({\n                'chain': line[21], 'resnum': int(line[22:26]),\n                'resname': line[17:20].strip(), 'atom': line[12:16].strip(),\n                'coord': np.array([float(line[30:38]), float(line[38:46]), float(line[46:54])])\n            })\n    f.close()\n    return atoms\n\ndef void_analysis(pdb_path):\n    atoms = load_pdb(pdb_path)\n    rec = np.array([a['coord'] for a in atoms if a['chain']=='A' and a['atom']!='H'])\n    pep = np.array([a['coord'] for a in atoms if a['chain']=='B' and a['atom']!='H'])\n    allc = np.vstack([rec, pep])\n    ca = {}\n    for a in atoms:\n        if a['chain']=='B' and a['atom']=='CA' and a['resnum'] not in ca:\n            ca[a['resnum']] = (a['coord'], a['resname'])\n    ca_list = sorted(ca.keys())\n    \n    pmin, pmax = pep.min(axis=0)-3, pep.max(axis=0)+3\n    x = np.arange(pmin[0],pmax[0],1.0); y = np.arange(pmin[1],pmax[1],1.0); z = np.arange(pmin[2],pmax[2],1.0)\n    xx,yy,zz = np.meshgrid(x,y,z,indexing='ij')\n    grid = np.column_stack([xx.ravel(),yy.ravel(),zz.ravel()])\n    \n    pt = KDTree(pep)\n    near = np.array([len(i)>0 for i in pt.query_ball_point(grid,5.0)])\n    at = KDTree(allc)\n    d,_ = at.query(grid,k=1)\n    void = near & (d>2.5)\n    vp = grid[void]\n    \n    ca_arr = np.array([ca[r][0] for r in ca_list])\n    ct = KDTree(ca_arr)\n    _,nn = ct.query(vp,k=1)\n    counts = {}\n    for i in nn: counts[ca_list[i]] = counts.get(ca_list[i],0)+1\n    \n    total = len(vp)\n    print(f\"  Total void: {total}\")\n    print(f\"  {'PDB':>4s} {'Seq':>4s} {'Res':>5s} {'Void':>6s} {'%':>5s}\")\n    for i,r in enumerate(ca_list):\n        n = counts.get(r,0); pct = 100.0*n/total if total else 0\n        print(f\"  {r:>4d} {i+1:>4d} {ca[r][1]:>5s} {n:>6d} {pct:>4.0f}%\")\n\nfor label, pdb in [\n    (\"EGGFQMAKT cl3 (AF \u2212118.59, DQ 0.765)\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\"),\n    (\"EAGFQMALT cl3 (AF \u2212119.10, DQ 1.000)\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\"),\n    (\"KFERQx2 cl5 (AF \u2212146.53, DQ 1.000)\", \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000/output/11_seletopclusts/cluster_5_model_1.pdb.gz\"),\n]:\n    print(f\"\\n=== {label} ===\")\n    void_analysis(pdb)\nPYEOF"}

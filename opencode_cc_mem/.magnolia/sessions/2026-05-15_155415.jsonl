{"event_type":"tool_call","timestamp":"2026-06-09T08:45:23.117397Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip\n\nwith gzip.open('docked.sdf.gz', 'rt') as f:\n    content = f.read()\n\nmols = content.strip().split('$$$$\\n')\n\nTRS_CENTER = (21.141, -32.681, -2.137)\n\n# Check poses for specific compounds: each compound has 20 consecutive poses\n# Compound mapping by index in the original docking order\ncompounds = [\n    \"Z9-14-Ald\", \"Z11-16-Ald\", \"Z11-16-Ac\", \"Z11-16-OH\", \"Z9-16-Ald\",\n    \"E2-10-Ald\", \"C8-Ald\", \"C10-Ald\", \"C12-Ald\", \"C14-Ald\",\n    \"C16-Ald\", \"C18-Ald\", \"(-)-Carvone\", \"(+)-Carvone\", \"Citral\",\n    \"Safranal\", \"Citronellal\", \"Coniferyl aldehyde\", \"Eugenol\", \"Citralva\",\n    \"Linalool\", \"Geraniol\", \"Phytol\", \"\u03b2-Ionone\", \"Geranyl acetate\",\n    \"3,7-Dimethyloctanol\", \"Farnesol\", \"Cedrol\", \"Octanoic acid\", \"Decanoic acid\",\n    \"Lauric acid\", \"Myristic acid\", \"Palmitic acid\", \"Stearic acid\", \"Z9-16-COOH\",\n    \"Z9-14-COOH\", \"Z11-16-COOH\", \"Z13-18-COOH\", \"Oleic acid\", \"Linoleic acid\"\n]\n\nN_POSES = 20\n\nprint(f\"{'Compound':<22s} {'Pose#':>5s} {'Dist2Pocket':>12s} {'InBox':>6s} {'Atoms':>6s}  SDF energy\")\nprint(\"-\" * 90)\n\nfor comp_idx in range(min(5, len(compounds))):  # Check first 5 compounds\n    start = comp_idx * N_POSES\n    best_pose = None\n    \n    for pose_i in range(min(3, N_POSES)):  # Check first 3 poses\n        idx = start + pose_i\n        if idx >= len(mols):\n            continue\n        mol = mols[idx].strip()\n        if not mol:\n            continue\n        lines = mol.split('\\n')\n        name_line = lines[0].strip() if lines else ''\n        \n        # Parse atom count\n        if len(lines) < 4:\n            continue\n        try:\n            natoms = int(lines[3][:3].strip())\n        except:\n            continue\n        \n        # Get coordinates\n        coords = []\n        for j in range(4, min(4 + natoms, len(lines))):\n            l = lines[j]\n            if len(l) < 31:\n                continue\n            try:\n                x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n                coords.append((x, y, z))\n            except:\n                continue\n        \n        if not coords:\n            continue\n        \n        cx = sum(a[0] for a in coords) / len(coords)\n        cy = sum(a[1] for a in coords) / len(coords)\n        cz = sum(a[2] for a in coords) / len(coords)\n        dist = ((cx - TRS_CENTER[0])**2 + (cy - TRS_CENTER[1])**2 + (cz - TRS_CENTER[2])**2)**0.5\n        in_box = (abs(cx - TRS_CENTER[0]) < 10 and abs(cy - TRS_CENTER[1]) < 10 and abs(cz - TRS_CENTER[2]) < 10)\n        \n        print(f\"{compounds[comp_idx]:<22s} {pose_i+1:>5d} {dist:>12.1f} {str(in_box):>6s} {natoms:>6d}  {name_line[:60]}\")\n\nPYEOF"}

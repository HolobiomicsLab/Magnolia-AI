{"event_type":"tool_call","timestamp":"2026-06-24T14:13:47.929951Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\nR=2026-06-16_af3_KFERQx2_s10000_full\necho \"=== capri AIR-free for the ROBUST cluster (clt1, n=80) vs outlier (clt9, n=4) ===\"\npython3 - <<PY\nimport json\nR=\"$R\"\nwair=json.load(open(f\"{R}/output/12_caprieval/weights_params.json\")).get('w_air',0.1)\nrows=[];idx={}\nfor line in open(f\"{R}/output/12_caprieval/capri_clt.tsv\"):\n    if line.startswith('#') or not line.strip(): continue\n    if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n    rows.append(line.rstrip().split('\\t'))\ng=lambda rw,c: rw[idx[c]]\nprint(f\"{'clt':>4}{'rank':>5}{'AIR-free':>10}{'DockQ':>8}{'n(capped)':>10}\")\nfor rw in rows[:6]:\n    af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"{g(rw,'cluster_id'):>4}{g(rw,'caprieval_rank'):>5}{af:>10.2f}{float(g(rw,'dockq')):>8.3f}{g(rw,'n'):>10}\")\nPY\necho\necho \"=== domain-spanning: is the ROBUST clt1 (n=80) SBD-only? (need its model) ===\"\nls $R/output/11_seletopclusts/cluster_1_model_*.pdb.gz 2>/dev/null | head -1 || echo \"clt1 model NOT local\"\necho \"--- fetch clt1 model_1 if missing ---\"\nif ! ls $R/output/11_seletopclusts/cluster_1_model_1.pdb.gz >/dev/null 2>&1; then\n  rsync -avz --timeout=60 \"azzurra:/workspace/tjiang/magnolia/hsc70_new/runs/haddock3_20260616_213704/output/11_seletopclusts/cluster_1_model_1.pdb.gz\" $R/output/11_seletopclusts/ 2>&1 | tail -2\nfi\npython3 - <<'PY'\nimport gzip,glob,re\nR=\"2026-06-16_af3_KFERQx2_s10000_full\"\nf=f\"{R}/output/11_seletopclusts/cluster_1_model_1.pdb.gz\"\ntry:\n    rec={};pep={}\n    with gzip.open(f,'rt') as fh:\n        for line in fh:\n            if not line.startswith('ATOM'): continue\n            ch=line[21];res=int(line[22:26]);name=line[12:16].strip()\n            if name.startswith('H'): continue\n            try: x,y,z=float(line[30:38]),float(line[38:46]),float(line[46:54])\n            except: continue\n            (pep if ch=='B' else rec).setdefault((ch,res),[]).append((x,y,z))\n    pa=[a for v in pep.values() for a in v]\n    nbd=set();sbd=set()\n    for (ch,res),ats in rec.items():\n        for x,y,z in ats:\n            if any((x-px)**2+(y-py)**2+(z-pz)**2<=25.0 for px,py,pz in pa):\n                (nbd if res<=383 else sbd).add(res);break\n    print(f\"clt1 (n=80 robust): NBD={len(nbd)} SBD={len(sbd)} [{'SBD-only \u2713' if not nbd else 'SPANS NBD \u2717 '+str(sorted(nbd))}]\")\nexcept FileNotFoundError:\n    print(\"clt1 model not available\")\nPY"}

{"event_type":"tool_call","timestamp":"2026-06-17T14:57:28.441739Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport subprocess, os\n\npdb = \"/tmp/rkdlq_c1_m1.pdb\"\n\n# Parse receptor and peptide atoms\nrec_atoms = []\npep_atoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38])\n        y = float(line[38:46])\n        z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26])\n        atomname = line[12:16].strip()\n        if chain == 'A':\n            rec_atoms.append((resname, resid, atomname, x, y, z))\n        elif chain == 'B':\n            pep_atoms.append((resname, resid, atomname, x, y, z))\n\n# Compute min distance from each receptor residue to any peptide atom\nfrom math import sqrt\n\nCUTOFF = 5.0  # \u00c5\npocket_residues = {}\n\nfor rn, rid, aname, rx, ry, rz in rec_atoms:\n    min_dist = 999.0\n    for pn, pid, pname, px, py, pz in pep_atoms:\n        dx = rx - px\n        dy = ry - py\n        dz = rz - pz\n        d = sqrt(dx*dx + dy*dy + dz*dz)\n        if d < min_dist:\n            min_dist = d\n    if min_dist <= CUTOFF:\n        if rid not in pocket_residues:\n            pocket_residues[rid] = {\"resname\": rn, \"min_dist\": min_dist}\n        else:\n            pocket_residues[rid][\"min_dist\"] = min(pocket_residues[rid][\"min_dist\"], min_dist)\n\n# Sort by residue ID\nprint(f\"Binding pocket (receptor residues within {CUTOFF} \u00c5 of peptide)\")\nprint(f\"=\" * 60)\nprint(f\"{'Resid':>5s} {'Name':>4s}  {'MinDist':>8s}  {'Domain'}\")\nprint(\"-\" * 60)\n\n# Categorize by domain\nsbd_start = 386\nlid_start = 531\n\nfor rid in sorted(pocket_residues.keys()):\n    info = pocket_residues[rid]\n    if rid >= lid_start:\n        domain = \"LID (\u03b1-helical)\"\n    elif rid >= sbd_start:\n        domain = \"SBD\u03b2 (\u03b2-sandwich)\"\n    else:\n        domain = \"NBD\"\n    print(f\"{rid:5d} {info['resname']:>4s}  {info['min_dist']:8.2f}  {domain}\")\n\n# Summary\nprint()\nprint(f\"Total pocket residues: {len(pocket_residues)}\")\nsbd_count = sum(1 for r in pocket_residues if sbd_start <= r < lid_start)\nlid_count = sum(1 for r in pocket_residues if r >= lid_start)\nnbd_count = sum(1 for r in pocket_residues if r < sbd_start)\nprint(f\"  SBD\u03b2: {sbd_count}  |  LID: {lid_count}  |  NBD: {nbd_count}\")\n\n# Compare with our active/passive actpass\nactive = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\npassive = {401,402,407,408,409,410,412,425,432,433,434,436,441,442,443,444,459,461,462,468,470,471,472}\nin_actpass = active | passive\n\nprint()\nprint(\"Pocket residues IN actpass:\")\nin_a = sorted(set(pocket_residues.keys()) & in_actpass)\nprint(\"  \" + \" \".join(str(r) for r in in_a))\n\nout = sorted(set(pocket_residues.keys()) - in_actpass)\nif out:\n    print()\n    print(\"Pocket residues OUTSIDE actpass (blind spots):\")\n    print(\"  \" + \" \".join(str(r) for r in out))\nPYEOF"}

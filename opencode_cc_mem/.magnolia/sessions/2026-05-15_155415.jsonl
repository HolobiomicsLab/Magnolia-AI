OF\ncat > /tmp/mcp_build3.py <<'PYEOF'\nimport json; import sys; sys.path.insert(0,\"/tmp\"); from mcplib import *\nconnect()\nout=call(\"build_kb_from_search\",{\"query\":\"retrieval-augmented generation grounded explainable intelligent tutoring system\",\n   \"kb_name\":\"studium_scan3\",\"max_results\":20,\"databases\":[\"semantic_scholar\",\"openalex\",\"arxiv\"],\n   \"min_year\":2018,\"require_abstract\":False,\"create_if_missing\":True})\nj=json.loads(out)\nfor k in [\"searched\",\"filtered_out\",\"candidates\",\"screened_out\",\"after_screen\",\"added_papers\",\"added_chunks\",\"skipped_duplicates\"]:\n    print(f\"{k}={j.get(k)}\")\nprint(\"filter_reasons:\",json.dumps(j.get(\"filter_reasons\"))[:600])\nprint(\"failed:\",json.dumps(j.get(\"failed\"))[:400])\nprint(\"selected_dois[:6]:\",j.get(\"selected_dois\",[])[:6])\nPYEOF\ntimeout 400 python3 /tmp/mcp_build3.py 2>&1 | head -40"}

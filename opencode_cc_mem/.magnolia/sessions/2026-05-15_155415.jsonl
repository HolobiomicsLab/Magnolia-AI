{"event_type":"tool_call","timestamp":"2026-06-12T07:54:47.777475Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'EOF'\nimport os\n\nruns_dir = \"projects/hsc70_new/runs\"\nruns = sorted(os.listdir(runs_dir))\n\nfor r in runs:\n    clt = os.path.join(runs_dir, r, \"output\", \"12_caprieval\", \"capri_clt.tsv\")\n    if not os.path.exists(clt): continue\n    with open(clt) as f:\n        for line in f:\n            if line.startswith('#') or not line.strip(): continue\n            cols = line.strip().split('\\t')\n            if len(cols) < 30: continue\n            score = float(cols[4])\n            air = float(cols[18])\n            dockq = float(cols[12])\n            fnat = float(cols[8])\n            bsa = float(cols[20])\n            af = score - 0.1 * air\n            n = cols[2]\n            print(f\"{r:<55}  score={score:8.2f}  AF={af:8.2f}  dockq={dockq:.3f}  fnat={fnat:.3f}  AIR={air:.1f}  BSA={bsa:.0f}  n={n}\")\n            break\nEOF"}

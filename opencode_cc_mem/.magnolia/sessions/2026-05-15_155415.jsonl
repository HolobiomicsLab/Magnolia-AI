{"event_type":"tool_call","timestamp":"2026-06-24T12:36:49.162542Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full\npython3 - <<'PY'\nimport re\nf=\"output/13_contactmap/cluster1_interchain_contacts.tsv\"\ndef parse_res(s):\n    m=re.match(r'([A-Z])-(\\d+)-([A-Z]+)',s)\n    return (m.group(1),int(m.group(2)),m.group(3)) if m else None\nrec_nbd=set(); rec_sbd=set()\npep_by_rec={}  # peptide res -> set of rec domain\nrows=[]\nwith open(f) as fh:\n    for line in fh:\n        if line.startswith('#') or not line.strip(): continue\n        c=line.rstrip().split('\\t')\n        if c[0]=='res1': continue\n        r1=parse_res(c[0]); r2=parse_res(c[1])\n        if not r1 or not r2: continue\n        ch1,res1,_=r1; ch2,res2,_=r2\n        prob=float(c[5]) if c[5] else 0  # shortest-cont-probability\n        if ch1=='A':  # receptor\n            dom='NBD' if res1<=383 else 'SBD'\n            if dom=='NBD': rec_nbd.add(res1)\n            else: rec_sbd.add(res1)\n            pep_by_rec.setdefault(res2,set()).add(dom)\n            rows.append((res1,dom,res2,prob))\nprint(f\"RECEPTOR residues contacted: NBD(1-383)={len(rec_nbd)} residues [{min(rec_nbd) if rec_nbd else '-'}-{max(rec_nbd) if rec_nbd else '-'}], SBD(384-646)={len(rec_sbd)} residues [{min(rec_sbd) if rec_sbd else '-'}-{max(rec_sbd) if rec_sbd else '-'}]\")\nprint()\nprint(\"PEPTIDE residue -> receptor domain(s) contacted:\")\nfor p in sorted(pep_by_rec):\n    print(f\"  pep res {p:2d} -> {sorted(pep_by_rec[p])}\")\n# N-term vs C-term summary\nnt=[p for p in pep_by_rec if 'NBD' in pep_by_rec[p] and p<=7]\nct=[p for p in pep_by_rec if 'SBD' in pep_by_rec[p] and p>=8]\nprint(f\"\\nN-terminal half (res 1-7) contacting NBD: {sorted(nt)}\")\nprint(f\"C-terminal half (res 8-14) contacting SBD: {sorted(ct)}\")\nPY"}

{"event_type":"tool_call","timestamp":"2026-06-24T12:12:20.114455Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport gzip, math\nfrom collections import defaultdict\ndef parse(path):\n    atoms=[]; op=gzip.open if path.endswith('.gz') else open\n    with op(path,'rt') as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            try: res=int(line[22:26]); x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n            except ValueError: continue\n            atoms.append((line[21].strip(),res,line[17:20].strip(),line[12:16].strip(),x,y,z))\n    return atoms\ndef vec(a,b): return (b[0]-a[0],b[1]-a[1],b[2]-a[2])\ndef unit(v):\n    m=math.sqrt(sum(c*c for c in v)) or 1.0; return (v[0]/m,v[1]/m,v[2]/m)\ndef ang(d,v):\n    u=unit(v); dot=max(-1,min(1,d[0]*u[0]+d[1]*u[1]+d[2]*u[2])); return math.degrees(math.acos(dot))\ndef analyze(label,path):\n    atoms=parse(path); chains=defaultdict(set)\n    for ch,res,_,_,_,_,_ in atoms: chains[ch].add(res)\n    pc=min(chains,key=lambda c:len(chains[c])); rc='A' if 'A' in chains else max(chains,key=lambda c:len(chains[c]))\n    pres=sorted(chains[pc])\n    def ga(ch,res,nm):\n        for c,r,rn,n,x,y,z in atoms:\n            if c==ch and r==res and n==nm: return (x,y,z)\n    nt,ct=pres[0],pres[-1]\n    CAn,Ng=ga(pc,nt,'CA'),ga(pc,nt,'N'); CAc,Cg=ga(pc,ct,'CA'),ga(pc,ct,'C')\n    dN,dC=unit(vec(CAn,Ng)),unit(vec(CAc,Cg))\n    print(f\"\\n{label}: peptide {pc} res{pres}; N-term ang / C-term ang (to target)\")\n    for rn_,idn in [(431,'TYR'),(469,'ARG'),(543,'GLU')]:\n        rec=[a for a in atoms if a[0]==rc and a[1]==rn_ and a[3] not in('H',)]\n        cn=min(rec,key=lambda a:sum((a[i+4]-CAn[i])**2 for i in range(3)))\n        cc=min(rec,key=lambda a:sum((a[i+4]-CAc[i])**2 for i in range(3)))\n        print(f\"  {idn}{rn_}: N={ang(dN,vec(CAn,(cn[4],cn[5],cn[6]))):5.1f}\u00b0  C={ang(dC,vec(CAc,(cc[4],cc[5],cc[6]))):5.1f}\u00b0\")\n# report cited \"RKDLQ cluster 1\" -- check it + model 2 robustness\nanalyze(\"RKDLQ clt1 model1 (report's cited cluster)\",\"2026-06-16_af3_RKDLQ_s5000_full/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\nanalyze(\"RKALQ clt1 model2 (robustness)\",\"2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_2.pdb.gz\")\nPY\necho\necho \"Legend: angle < 77\u00b0 = points TOWARD residue (extension reaches it); > 90\u00b0 = points AWAY.\""}

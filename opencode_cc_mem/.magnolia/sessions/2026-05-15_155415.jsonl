{"event_type":"tool_call","timestamp":"2026-07-01T09:25:09.284789Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, os\nimport numpy as np\nfrom scipy.spatial import KDTree\n\ndef load_pdb_coords(filepath):\n    atoms = []\n    f = gzip.open(filepath, 'rt') if filepath.endswith('.gz') else open(filepath)\n    for line in f:\n        if line.startswith('ATOM'):\n            chain = line[21]\n            resnum = int(line[22:26])\n            resname = line[17:20].strip()\n            atomname = line[12:16].strip()\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            atoms.append({'chain': chain, 'resnum': resnum, 'resname': resname,\n                         'atom': atomname, 'coord': np.array([x, y, z])})\n    f.close()\n    return atoms\n\ndef void_analysis(pdb_path):\n    atoms = load_pdb_coords(pdb_path)\n    rec_atoms = [a for a in atoms if a['chain'] == 'A' and a['atom'] != 'H']\n    pep_atoms = [a for a in atoms if a['chain'] == 'B' and a['atom'] != 'H']\n    rec_coords = np.array([a['coord'] for a in rec_atoms])\n    pep_coords = np.array([a['coord'] for a in pep_atoms])\n    all_coords = np.vstack([rec_coords, pep_coords])\n    \n    pep_min = pep_coords.min(axis=0) - 3\n    pep_max = pep_coords.max(axis=0) + 3\n    x = np.arange(pep_min[0], pep_max[0], 1.0)\n    y = np.arange(pep_min[1], pep_max[1], 1.0)\n    z = np.arange(pep_min[2], pep_max[2], 1.0)\n    xx, yy, zz = np.meshgrid(x, y, z, indexing='ij')\n    grid = np.column_stack([xx.ravel(), yy.ravel(), zz.ravel()])\n    \n    pep_tree = KDTree(pep_coords)\n    near = np.array([len(i) > 0 for i in pep_tree.query_ball_point(grid, 5.0)])\n    all_tree = KDTree(all_coords)\n    dists, _ = all_tree.query(grid, k=1)\n    void = near & (dists > 2.5)\n    void_pts = grid[void]\n    \n    pep_ca = {}\n    for a in [a for a in atoms if a['chain'] == 'B' and a['atom'] == 'CA']:\n        pep_ca[a['resnum']] = a['coord']\n    ca_list = sorted(pep_ca.keys())\n    ca_arr = np.array([pep_ca[r] for r in ca_list])\n    ca_tree = KDTree(ca_arr)\n    _, nearest = ca_tree.query(void_pts, k=1)\n    \n    counts = {}\n    for i in nearest:\n        r = ca_list[i]\n        counts[r] = counts.get(r, 0) + 1\n    \n    total = len(void_pts)\n    print(f\"  Total void: {total} pts\")\n    print(f\"  {'PDB':>4s} {'Seq':>4s} {'Res':>5s} {'Void':>6s} {'%':>5s}\")\n    for i, r in enumerate(ca_list):\n        seq_pos = i + 1  # sequence position (no ACE)\n        resname = pep_ca_resnames.get(r, '?')\n        n = counts.get(r, 0)\n        pct = 100.0 * n / total if total else 0\n        print(f\"  {r:>4d} {seq_pos:>4d} {resname:>5s} {n:>6d} {pct:>4.0f}%\")\n\npep_ca_resnames = {}\natoms = load_pdb_coords(\"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\")\nfor a in atoms:\n    if a['chain'] == 'B' and a['atom'] == 'CA':\n        pep_ca_resnames[a['resnum']] = a['resname']\n\nfor label, pdb in [\n    (\"EGGFQMAKT cl3 (AF=\u2212118.59)\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\"),\n    (\"EAGFQMALT cl3 (AF=\u2212119.10)\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\"),\n    (\"KFERQx2 cl5 (AF=\u2212146.53)\", \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000/output/11_seletopclusts/cluster_5_model_1.pdb.gz\"),\n]:\n    print(f\"\\n=== {label} ===\")\n    atoms2 = load_pdb_coords(pdb)\n    pep_ca_resnames = {}\n    for a in atoms2:\n        if a['chain'] == 'B' and a['atom'] == 'CA':\n            pep_ca_resnames[a['resnum']] = a['resname']\n    void_analysis(pdb)\nPYEOF"}

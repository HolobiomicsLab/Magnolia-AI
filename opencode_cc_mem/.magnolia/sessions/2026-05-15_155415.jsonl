{"event_type":"tool_call","timestamp":"2026-06-24T13:41:08.059542Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport json\ndef score(r):\n    wp=f\"{r}/output/12_caprieval/weights_params.json\"\n    try: wair=json.load(open(wp)).get('w_air')\n    except: wair=0.1\n    f=f\"{r}/output/analysis/12_caprieval_analysis/capri_clt.tsv\"\n    rows=[];idx={}\n    try:\n        for line in open(f):\n            if line.startswith('#') or not line.strip(): continue\n            if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n            rows.append(line.rstrip().split('\\t'))\n    except FileNotFoundError: return None\n    def g(rw,c): return rw[idx[c]]\n    rw=rows[0]\n    return float(g(rw,'score'))-wair*float(g(rw,'air')), float(g(rw,'dockq')), g(rw,'n')\nfor r in [\"af3_KFERQ_s5000_full\",\"af3_KILDQ_s5000_full\",\"af3_RKELQ_s5000_full\",\"af3_QRKEL_s5000_full\",\"af3_HAMNG_s5000_full\",\"2026-06-17_RKALQ_s5000\",\"2026-06-17_TGFMALQ_s10000\"]:\n    try:\n        af,dq,n=score(r); print(f\"{r:42s} AIR-free={af:8.2f}  DockQ={dq:.3f}  n={n}\")\n    except Exception as e: print(f\"{r:42s} (no 12_caprieval: {e})\")\nPY"}

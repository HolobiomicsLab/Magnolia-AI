{"event_type":"tool_call","timestamp":"2026-06-23T14:02:51.974635Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport sqlite3, json\n\nconn = sqlite3.connect('/home/tjiang/.local/share/opencode/opencode.db')\n\n# Get all memory_get_context calls across all sessions\nrows = conn.execute('''\n    SELECT p.session_id, p.data, p.time_created, p.message_id\n    FROM part p\n    WHERE p.data LIKE '%memory_get_context%'\n    ORDER BY p.time_created\n''').fetchall()\n\nprint(f'Total memory_get_context calls: {len(rows)}')\nfor i, (sid, data_json, ts, msg_id) in enumerate(rows):\n    d = json.loads(data_json)\n    tool = d.get('tool', '')\n    call_id = d.get('callID', '')\n    print(f'\\n--- Call #{i} ---')\n    print(f'Session: {sid}')\n    print(f'Timestamp: {ts}')\n    print(f'Message ID: {msg_id}')\n    print(f'Tool: {tool}')\n    print(f'CallID: {call_id}')\n    \n    # Get the call arguments from the structured_content or similar\n    if 'input' in d:\n        inp = d['input']\n        if isinstance(inp, dict):\n            for k, v in inp.items():\n                if k == 'task_description':\n                    print(f'Task: {str(v)[:300]}')\n                elif k not in ('conversation_history', 'project_dir', 'token_budget'):\n                    print(f'  Arg {k}: {str(v)[:200]}')\n        elif isinstance(inp, str):\n            print(f'Input (str): {inp[:300]}')\n    else:\n        # May be stored elsewhere\n        pass\n    print('...')\n\" 2>&1 | head -200"}

{"event_type":"tool_call","timestamp":"2026-06-09T08:31:57.198758Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re\n\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\nblocks = text.split('mode |  affinity')\ndock_all = []\nfor block in blocks[1:]:\n    poses = []\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            poses.append({\n                'rank': int(m.group(1)), 'affinity': float(m.group(2)),\n                'intramol': float(m.group(3)), 'cnn_pose': float(m.group(4)),\n                'cnn_aff': float(m.group(5))\n            })\n    dock_all.append(poses)\n\nlines = []\nhdr = f\"{'#':<3s} {'Compound':<24s} {'IC50':>8s} {'Kd_exp':>8s} {'Aff':>7s} {'CNNpose':>8s} {'CNNaff':>8s} {'Kd_cls':>7s}\"\nsep = \"-\" * 85\nlines.append(hdr)\nlines.append(sep)\n\nfor i, c in enumerate(exp_data):\n    if i >= len(dock_all):\n        break\n    kd = c.get('kd_obp3', 999)\n    ic50 = c.get('ic50_obp3', 999)\n    poses = dock_all[i]\n    if not poses:\n        continue\n    top = poses[0]\n    cls = \"STRONG\" if kd < 1.0 else (\"MOD\" if kd < 10 else (\"WEAK\" if kd < 43 else \"NON\"))\n    lines.append(f\"{i+1:<3d} {c['name']:<24s} {ic50:>8.1f} {kd:>8.3f} {top['affinity']:>+7.2f} {top['cnn_pose']:>8.4f} {top['cnn_aff']:>8.4f} {cls:>7s}\")\n\nlines.append(sep)\nlines.append(\"Aff = gnina empirical affinity (kcal/mol)\")\nlines.append(\"CNNpose = CNN pose probability (0\u20131)\")\nlines.append(\"CNNaff = CNN affinity score\")\nlines.append(\"Kd_cls = experimental binding class: STRONG<1, MOD<10, WEAK<43, NON>43 \u00b5M\")\n\nout = '\\n'.join(lines)\nwith open('docking_results_table.txt', 'w') as f:\n    f.write(out + '\\n')\nprint(out)\nPYEOF"}

n\n    \n    # Get capri_ss for best model in target cluster\n    ss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\n    if not os.path.exists(ss):\n        ss = f\"{d}/output/09_caprieval/capri_ss.tsv\"\n    with open(ss) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    best = None\n    for row in reader:\n        cid = row.get('cluster_id','')\n        if cid.isdigit() and int(cid) == target_cl:\n            score = float(row['score'])\n            air = float(row.get('air',0))\n            af = score - 0.1*air\n            if best is None or af < best[0]:\n                best = (af, score, row.get('dockq','?'), row.get('vdw','?'),\n                        row.get('elec','?'), row.get('bsa','?'), row.get('irmsd','?'),\n                        row.get('lrmsd','?'))\n    \n    if best:\n        af, sc, dq, vdw, elec, bsa, irmsd, lrmsd = best\n        print(f\"{pep:<14s} {mut:>6s} {target_cl:>4d} {n:>5d} {af:>+9.2f} {dq:>7s} {vdw:>8s} {elec:>8s} {float(bsa):>6.0f} {irmsd:>6s} {lrmsd:>6s}\")\n    else:\n        print(f\"{pep:<14s} {mut:>6s} {target_cl:>4d} \u2014 no capri_ss data\")\n\n# Also show EAGFQMRLT cluster 6 separately\nprint()\nprint(\"EAGFQMRLT all clusters:\")\nd = \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\"\nss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\nwith open(ss) as f:\n    lines = [l for l in f if not l.startswith('#')]\nreader = csv.DictReader(lines, delimiter='\\t')\nclusters = {}\nfor row in reader:\n    cid = row.get('cluster_id','?')\n    if cid not in clusters: clusters[cid] = []\n    score = float(row['score']); air = float(row.get('air',0))\n    clusters[cid].append((score - 0.1*air, float(row.get('dockq',0)), float(row.get('irmsd',0)),\n                          float(row.get('lrmsd',0)), float(row.get('vdw',0)), float(row.get('elec',0)),\n                          float(row.get('bsa',0))))\nprint(f\"  {'Cl':>4s} {'n':>4s} {'Best AF':>9s} {'Best DQ':>8s} {'irmsd':>7s} {'lrmsd':>7s} {'vdw':>8s} {'elec':>8s}\")\nfor cid in sorted(clusters.keys(), key=lambda x: int(x) if x.isdigit() else 99):\n    models = sorted(clusters[cid])\n    b = models[0]\n    print(f\"  {cid:>4s} {len(models):>4d} {b[0]:>+9.2f} {b[1]:>8.3f} {b[2]:>7.3f} {b[3]:>7.1f} {b[4]:>+8.2f} {b[5]:>+8.2f}\")\nPYEOF"}

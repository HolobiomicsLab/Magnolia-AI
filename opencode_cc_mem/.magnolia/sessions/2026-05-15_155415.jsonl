{"event_type":"tool_call","timestamp":"2026-06-03T14:16:07.080353Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFQKQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLN',649),('B','LYS',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLN',649):'Q3', ('B','LYS',650):'K4', ('B','GLN',651):'Q5'}\n\n# KFERQ reference contacts (what each position should contact in the canonical binding mode)\nKFERQ_K1 = {'ASP366','THR37','ASN364','ARG342','THR14'}\nKFERQ_F2 = {'ARG272','ILE343','SER275','GLY339'}\nKFERQ_E3 = {'ARG272','THR37','ARG342','ASP366','ASN35'}\nKFERQ_R4 = {'GLU231','GLU268','ASP234','TYR15','THR14','LYS271','GLY230','GLY202'}\nKFERQ_Q5 = {'ASP10','GLU175','ASP199','GLY202','PRO365','VAL369','GLY338'}\n\nKFERQ_REF = {'K1':KFERQ_K1,'F2':KFERQ_F2,'Q3':KFERQ_E3,'K4':KFERQ_R4,'Q5':KFERQ_Q5}\n\nmodels = ['cluster_1_model_%d.pdb.gz'%i for i in range(1,5)]  # Top cluster (DockQ 0.892)\n\npres_contacts = defaultdict(lambda: defaultdict(list))\nall_pocket = set()\n\nfor mf in models:\n    atoms = read_pdb(mf)\n    for pk, pxyz in atoms.items():\n        if pk[0] != 'B': continue\n        pres = (pk[0], pk[1], pk[2])\n        if pres not in PEPTIDE: continue\n        pname = PEP_NAMES[pres]\n        for rk, rxyz in atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                rres = (rk[0], rk[1], rk[2])\n                pres_contacts[pname][rres].append(d)\n                all_pocket.add(f'{rres[0]}-{rres[1]}{rres[2]}')\n\nprint('=== KFQKQ Cluster 1 (DockQ 0.892, Score -109.99) ===')\nprint()\nfor pname in ['K1','F2','Q3','K4','Q5']:\n    ref = KFERQ_REF[pname]\n    contacts = pres_contacts[pname]\n    \n    rec_summary = {}\n    for rres, dists in contacts.items():\n        rec_summary[rres] = (min(dists), sum(dists)/len(dists), len(dists))\n    \n    sorted_recs = sorted(rec_summary.items(), key=lambda x: x[1][0])\n    print(f'--- {pname} ({len(sorted_recs)} contacts) ---')\n    \n    # Count how many KFERQ contacts are retained\n    retained = []\n    lost = []\n    for rres, (min_d, avg_d, n) in sorted_recs[:12]:\n        rlabel = f'{rres[1]}{rres[2]}'\n        is_kferq = rres[1]+str(rres[2]) in ref\n        mark = '\u2713' if is_kferq else ' '\n        model_str = f'{n}/4' if n < 4 else 'all'\n        if is_kferq:\n            retained.append(rlabel)\n        if min_d <= 3.5:\n            print(f'  {mark} {rlabel:<8s}  min {min_d:.1f}A  avg {avg_d:.1f}A  [{model_str}]')\n    \n    lost = ref - set(retained)\n    if lost:\n        print(f'  Lost KFERQ contacts: {\", \".join(sorted(lost))}')\n    \n    # Check for new charge clashes\n    if pname == 'K4':  # R\u2192K mutation\n        print(f'  R4\u2192K4 mutation: contacts with K271 = ', end='')\n        k271 = [d for d in rec_summary.get(('A','LYS',271), [])]\n        if k271:\n            print(f'min {min(k271[0]):.1f}A')\n        else:\n            print('none')\n    print()\n\n# Pocket overlap\nprint('=== BINDING MODE COMPARISON ===')\n# KFERQ pocket residues (from earlier analysis)\nKFERQ_POCKET = {'ASP10','GLU175','ASP199','GLU231','ASP232','ASP234','GLU268','ASP366',\n                'GLY12','GLY201','GLY202','GLY230','GLY338','GLY339',\n                'ARG36','LYS56','LYS71','ARG264','ARG272','LYS271','ARG342',\n                'THR13','THR14','TYR15','SER16','CYS17','ASN35','THR37','TYR41',\n                'THR145','THR204','SER275','SER276','SER340','THR341','ASN364','TYR371',\n                'LEU11','LEU200','PHE233','VAL337','ILE343','PRO365','ALA368','VAL369','ALA370'}\n\ncommon = all_pocket & {'A-'+r for r in KFERQ_POCKET}\nonly_kfqkq = all_pocket - {'A-'+r for r in KFERQ_POCKET}\nonly_kferq = {'A-'+r for r in KFERQ_POCKET} - all_pocket\nprint(f'  Shared with KFERQ: {len(common)}')\nprint(f'  KFQKQ unique: {len(only_kfqkq)} \u2014 {sorted(only_kfqkq)[:10]}...')\nprint(f'  KFERQ unique: {len(only_kferq)} \u2014 {sorted(only_kferq)[:10]}...')\nPYEOF\n"}

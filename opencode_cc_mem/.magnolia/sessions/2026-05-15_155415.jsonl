{"event_type":"tool_call","timestamp":"2026-07-01T16:26:11.476587Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef analyze_contacts(run_dir, cluster_id, label):\n    \"\"\"Full contact analysis: domain mapping, core overlap, per-residue\"\"\"\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        print(f\"  {label} cl{cluster_id}: NO contact map\")\n        return\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    core = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n    \n    rec_residues = set()\n    pep_contacts = {}\n    domain_counts = {\"NBD\": 0, \"SBD\u03b2\": 0, \"SBD\u03b1-lid\": 0, \"beyond\": 0}\n    \n    for row in reader:\n        parts1 = row.get('res1','').strip().split('-')\n        parts2 = row.get('res2','').strip().split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1]); rec_res = parts1[2]\n            pep_num = int(parts2[1]); pep_res = parts2[2]\n        except ValueError:\n            continue\n        dist = float(row.get('shortest-dist', 999))\n        ct = row.get('contact-type','')\n        \n        rec_residues.add(rec_num)\n        if rec_num < 390: domain = \"NBD\"\n        elif rec_num <= 520: domain = \"SBD\u03b2\"\n        elif rec_num <= 615: domain = \"SBD\u03b1-lid\"\n        else: domain = \"beyond\"\n        domain_counts[domain] += 1\n        \n        if pep_num not in pep_contacts:\n            pep_contacts[pep_num] = []\n        pep_contacts[pep_num].append((dist, rec_num, rec_res, ct))\n    \n    overlap = rec_residues & core\n    missing = core - rec_residues\n    \n    print(f\"\\n{'='*70}\")\n    print(f\"  {label} \u2014 cluster {cluster_id}\")\n    print(f\"  Core: {len(overlap)}/19 matched, missing: {sorted(missing)[:6]}\")\n    print(f\"  Domains: NBD={domain_counts['NBD']} SBD\u03b2={domain_counts['SBD\u03b2']} lid={domain_counts['SBD\u03b1-lid']} beyond={domain_counts['beyond']}\")\n    print(f\"  {'Seq':>3s} {'PDB':>4s} {'Res':>5s} {'Closest receptor':>20s} {'dist':>5s} {'type':>15s}\")\n    \n    for pep_num in sorted(pep_contacts.keys()):\n        contacts = sorted(pep_contacts[pep_num], key=lambda x: x[0])\n        seq_pos = pep_num  # For ACE-capped peptides, seq = pdb - 1; for non-capped, seq = pdb\n        d, rn, rr, ct = contacts[0]\n        print(f\"  {seq_pos:>3d} {pep_num:>4d} {pep_res if 'pep_res' in dir() else '?':>5s} {rr}{rn:>5d} {d:>5.1f} {ct:>15s}\")\n    \n    # Check designed contacts\n    acidic_targets = {404: 'GLU', 460: 'GLU', 433: 'ASP'}\n    for rn, rr in acidic_targets.items():\n        for pep_num, contacts in pep_contacts.items():\n            for d, rnum, rres, ct in contacts:\n                if rnum == rn and d < 5.0:\n                    print(f\"  *** {rres}{rnum} contacted by B{pep_num} at {d:.1f}\u00c5 ({ct})\")\n\n# The 3 new peptides + key parents\nanalyses = [\n    (\"EKGFQMAKT (G\u2082\u2192K+L\u2088\u2192K)\", \"projects/hsc70_new/runs/2026-07-01_EKGFQMAKT_G2K_on_EGGFQMAKT_s10000\", 1, -97.29, 1.000, 52.0),\n    (\"EKGFQMALT (G\u2082\u2192K)\", \"projects/hsc70_new/runs/2026-07-01_EKGFQMALT_G2K_on_EGGFQMALT_s10000\", 5, -109.56, 1.000, 4.5),\n    (\"ERQKFERRQ (truncated)\", \"projects/hsc70_new/runs/2026-07-01_ERQKFERRQ_truncated_KFERQx2_s10000\", 3, -107.60, 0.661, 39.0),\n    (\"EGGFQMAKT (L\u2088\u2192K, parent)\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3, -118.59, 0.765, 4.0),\n    (\"EGGFQMALT (parent)\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1, -110.86, 1.000, 68.0),\n    (\"EAGFQMRLT (A\u2087\u2192R, ref)\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1, -116.51, 1.000, 48.5),\n]\n\nfor label, d, cl, af, dq, pct in analyses:\n    print(f\"\\n  [{label}] AF={af:.2f} DQ={dq:.3f} groove={pct:.1f}%\")\n    analyze_contacts(d, cl, label)\nPYEOF"}

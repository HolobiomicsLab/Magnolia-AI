{"event_type":"tool_call","timestamp":"2026-06-09T08:22:30.921251Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re, gzip\nfrom collections import OrderedDict\n\n# Parse gnina log\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\n# Extract per-compound results\n# Format: Processing <name> ... then table of modes\nblocks = text.split('mode |  affinity')\ncompounds_data = []\n\nfor i, block in enumerate(blocks[1:]):\n    lines = block.strip().split('\\n')\n    # Extract the best pose (first data line)\n    top_pose = None\n    for line in lines:\n        # Match a data line: starts with whitespace + digit\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            rank = int(m.group(1))\n            affinity = float(m.group(2))\n            intramol = float(m.group(3))\n            cnn_pose = float(m.group(4))\n            cnn_affinity = float(m.group(5))\n            if rank == 1:\n                top_pose = {\n                    'affinity': affinity,\n                    'intramol': intramol,\n                    'cnn_pose_score': cnn_pose,\n                    'cnn_affinity': cnn_affinity,\n                }\n                break\n    compounds_data.append(top_pose)\n\nprint(f\"Parsed {len(compounds_data)} compounds\")\n\n# Load experimental data\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\n\n# Match and print results\nprint(f\"\\n{'Compound':<25s} {'Kd_exp':>10s} {'CNNpose':>10s} {'CNNaff':>10s} {'Aff_kcal':>10s}\")\nprint(\"-\" * 70)\nfor i, c in enumerate(exp_data):\n    if i >= len(compounds_data):\n        break\n    dock = compounds_data[i]\n    if dock is None:\n        continue\n    print(f\"{c['name']:<25s} {c.get('kd_obp3', 'N/A'):>10} {dock['cnn_pose_score']:>10.4f} {dock['cnn_affinity']:>10.4f} {dock['affinity']:>10.2f}\")\n\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-09T08:22:31.355426Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":434,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T08:22:54.765565Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re\nfrom scipy.stats import spearmanr\nimport numpy as np\n\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\n\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\nblocks = text.split('mode |  affinity')\ndock_scores = []\n\nfor block in blocks[1:]:\n    lines = block.strip().split('\\n')\n    for line in lines:\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            dock_scores.append({\n                'affinity': float(m.group(2)),\n                'cnn_pose': float(m.group(4)),\n                'cnn_aff': float(m.group(5)),\n            })\n            break\n\nprint(f\"Compounds: {len(dock_scores)}\")\n\n# Match with experimental\nkd_vals = []\ncnn_pose_vals = []\ncnn_aff_vals = []\ngnina_aff_vals = []\nnames = []\n\nfor i, c in enumerate(exp_data):\n    if i >= len(dock_scores):\n        break\n    kd = c.get('kd_obp3')\n    if kd is None:\n        continue\n    dock = dock_scores[i]\n    names.append(c['name'])\n    kd_vals.append(kd)\n    cnn_pose_vals.append(dock['cnn_pose'])\n    cnn_aff_vals.append(dock['cnn_aff'])\n    gnina_aff_vals.append(dock['affinity'])\n\nkd_arr = np.array(kd_vals)\n\n# Spearman correlation (lower Kd = better binder)\nfor label, vals in [('CNN pose score', cnn_pose_vals), ('CNN affinity', cnn_aff_vals), ('Gnina affinity (kcal)', gnina_aff_vals)]:\n    rho, pval = spearmanr(vals, kd_arr)\n    print(f\"{label:<30s} Spearman \u03c1={rho:+.4f}  p={pval:.4f}\")\n\n# Selectivity test: Z11-16:Ald vs Z11-16:OH vs Z11-16:Ac\nprint(\"\\n=== Selectivity Test: Z11-16 functional group series ===\")\ntests = ['Z11-16-Ald', 'Z11-16-OH', 'Z11-16-Ac']\nfor t in tests:\n    if t in names:\n        idx = names.index(t)\n        print(f\"  {t:<15s} Kd={kd_vals[idx]:>8.3f}  CNNpose={cnn_pose_vals[idx]:.4f}  CNNaff={cnn_aff_vals[idx]:.4f}  GninaAff={gnina_aff_vals[idx]:.2f}\")\n\n# Aldehyde vs fatty acid check\nprint(\"\\n=== Positive vs Negative Controls ===\")\npos_controls = ['Z9-14-Ald','Z11-16-Ald','Citral','\u03b2-Ionone','Safranal','Farnesol','Cedrol']\nneg_controls = ['Octanoic acid','Decanoic acid','Lauric acid','Palmitic acid','Stearic acid','Oleic acid']\nfor grp_name, grp in [('STRONG BINDERS (Kd<0.5)', pos_controls), ('NEGATIVE CTLS (Kd>40)', neg_controls)]:\n    cnn_vals = []\n    for name in grp:\n        if name in names:\n            cntl_idx = names.index(name)\n            cnn_vals.append(cnn_pose_vals[cntl_idx])\n    if cnn_vals:\n        print(f\"  {grp_name:<35s} CNNpose mean={np.mean(cnn_vals):.4f} \u00b1 {np.std(cnn_vals):.4f}\")\n\nPYEOF"}

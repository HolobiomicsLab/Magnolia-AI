{"event_type":"tool_call","timestamp":"2026-06-09T08:44:39.501614Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip, re\n\n# Extract first pose of each compound from docked SDF\nwith gzip.open('docked.sdf.gz', 'rt') as f:\n    content = f.read()\n\n# Split by $$$$\nmolecules = content.strip().split('$$$$')\n\n# Extract center coordinates of each docked pose\nTRS_CENTER = (21.141, -32.681, -2.137)\nBOX_SIZE = 20.0\n\nfor i, mol in enumerate(molecules[:5]):  # First 5 compounds\n    mol = mol.strip()\n    if not mol:\n        continue\n    \n    # Get compound name from the SDF header\n    lines = mol.split('\\n')\n    name = lines[0].strip() if lines else 'unknown'\n    \n    # Extract atom coordinates (lines after the atom count line)\n    atom_start = 3  # header lines: name, program, comment\n    if len(lines) < 5:\n        continue\n    \n    # Find the atom count from the counts line (position after the 3 header lines)\n    count_line = lines[3] if len(lines) > 3 else ''\n    try:\n        natoms = int(count_line[:3].strip())\n    except:\n        continue\n    \n    # Collect atom coordinates\n    atoms = []\n    for j in range(4, min(4 + natoms, len(lines))):\n        l = lines[j]\n        if len(l) < 31:\n            continue\n        try:\n            x = float(l[0:10].strip())\n            y = float(l[10:20].strip())\n            z = float(l[20:30].strip())\n            atoms.append((x, y, z))\n        except:\n            continue\n    \n    if not atoms:\n        continue\n    \n    # Calculate centroid of all atoms\n    cx = sum(a[0] for a in atoms) / len(atoms)\n    cy = sum(a[1] for a in atoms) / len(atoms)\n    cz = sum(a[2] for a in atoms) / len(atoms)\n    \n    # Distance from TRS center (the binding pocket)\n    dist = ((cx - TRS_CENTER[0])**2 + (cy - TRS_CENTER[1])**2 + (cz - TRS_CENTER[2])**2)**0.5\n    \n    # Check if within box\n    in_box = (abs(cx - TRS_CENTER[0]) < BOX_SIZE/2 and \n              abs(cy - TRS_CENTER[1]) < BOX_SIZE/2 and \n              abs(cz - TRS_CENTER[2]) < BOX_SIZE/2)\n    \n    print(f\"[{i+1}] {name}\")\n    print(f\"    Centroid: ({cx:.1f}, {cy:.1f}, {cz:.1f})\")\n    print(f\"    Distance to pocket: {dist:.1f} \u00c5\")\n    print(f\"    Inside box: {in_box}\")\n    \n    # Also check: did the compound move much from its input position?\n    # Input SDF positions might tell us if docking actually explored\n    print(f\"    Atom count: {len(atoms)}\")\n    print()\n\nprint(f\"\\nTRS (binding pocket) center: {TRS_CENTER}\")\nprint(f\"Box: {BOX_SIZE}\u00b3 \u00c5 centered on TRS\")\nprint(f\"\\n-- If ligands are docking FAR from the pocket (>10 \u00c5), the box may be wrong --\")\nprint(f\"-- If they're near the pocket but scores are random, the scoring function is the issue --\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-09T10:02:28.786894Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\n# Spot-check a few ligand geometries from xTB-optimized SDFs\nimport os\n\ncheck_compounds = ['Z11-16-Ald', 'Z9-14-Ald', 'Cedrol', '\u03b2-Ionone', 'Decanoic_acid']\nname_map = {\n    'Z11-16-Ald': 'Z11-16-Ald_opt.sdf',\n    'Z9-14-Ald': 'Z9-14-Ald_opt.sdf',\n    'Cedrol': 'Cedrol_opt.sdf',\n    '\u03b2-Ionone': '\u03b2-Ionone_opt.sdf',\n    'Decanoic_acid': 'Decanoic_acid_opt.sdf',\n}\n\nfor name, fn in name_map.items():\n    sdf_path = f'ligands_xtb_opt/{fn}'\n    if not os.path.exists(sdf_path):\n        print(f\"  {name}: MISSING\")\n        continue\n    \n    with open(sdf_path) as f:\n        content = f.read()\n    \n    lines = content.strip().split('\\n')\n    header = lines[0].strip()\n    try:\n        natoms = int(lines[3][:3].strip())\n    except:\n        natoms = 0\n    \n    # Check for geometry sanity: C=O bond in aldehydes should be ~1.21 \u00c5\n    # For Z11-16-Ald, the aldehyde C=O is the last C and O\n    print(f\"\\n\u2550\u2550\u2550 {name} \u2550\u2550\u2550\")\n    print(f\"  Header: {header[:80]}\")\n    print(f\"  Atoms: {natoms}\")\n    \n    # Extract xTB energy\n    import re\n    m = re.search(r'energy:\\s+([-\\d.]+)', header)\n    if m:\n        print(f\"  xTB energy: {m.group(1)} Eh\")\n    m = re.search(r'gnorm:\\s+([-\\d.]+)', header)\n    if m:\n        print(f\"  Gradient norm: {m.group(1)}\")\n    \n    # Check: is the chain extended or folded? Compute end-to-end distance\n    coords = {}\n    for j in range(4, 4 + natoms):\n        l = lines[j]\n        try:\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            elem = l[31:34].strip() if len(l) > 33 else '?'\n            coords[len(coords)] = (x, y, z, elem)\n        except:\n            continue\n    \n    # Find first and last carbon\n    c_atoms = [(i, c) for i, (x, y, z, e) in coords.items() if e == 'C']\n    if len(c_atoms) >= 2:\n        first = c_atoms[0][1]\n        last = c_atoms[-1][1]\n        d = ((first[0]-last[0])**2 + (first[1]-last[1])**2 + (first[2]-last[2])**2)**0.5\n        # For a C16 chain, fully extended = ~20 \u00c5, folded = much less\n        print(f\"  End-to-end C distance: {d:.1f} \u00c5  (C atoms: {len(c_atoms)})\")\n\nprint(f\"\\n\u2550\u2550\u2550 Quick check: are all SDFs valid? \u2550\u2550\u2550\")\nopt_files = sorted([f for f in os.listdir('ligands_xtb_opt') if f.endswith('_opt.sdf')])\nfor f in opt_files:\n    path = f'ligands_xtb_opt/{f}'\n    size = os.path.getsize(path)\n    if size < 100:\n        print(f\"  WARNING: {f}: {size} bytes (likely corrupt)\")\n\nprint(f\"\\n  Total optimized SDFs: {len(opt_files)}\")\nPYEOF"}

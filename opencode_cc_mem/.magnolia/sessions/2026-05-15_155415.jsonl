{"event_type":"tool_call","timestamp":"2026-06-03T14:08:41.064263Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFQRQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLN',649),('B','ARG',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLN',649):'Q3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\n\n# For cluster 2 (the good one), get proper contacts\nmodels = ['cluster_2_model_%d.pdb.gz'%i for i in range(1,5)]\n\npres_contacts = defaultdict(lambda: defaultdict(list))  # pres -> rres -> [min_dists_per_model]\n\nfor mf in models:\n    atoms = read_pdb(mf)\n    for pk, pxyz in atoms.items():\n        if pk[0] != 'B': continue\n        pres = (pk[0], pk[1], pk[2])\n        if pres not in PEPTIDE: continue\n        for rk, rxyz in atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                rres = (rk[0], rk[1], rk[2])\n                pres_contacts[pres][rres].append(d)\n\nprint('=== KFQRQ Cluster 2 \u2014 per-residue receptor contacts (4 models) ===')\nprint()\n\n# KFERQ reference for comparison\nKFERQ_CL1 = {\n    'K1': ['D366 (1.6, salt bridge)', 'T37 (1.7, H-bond)', 'N364 (2.7)'],\n    'F2': ['R272 backbone (2.2)', 'I343 (3.2)', 'S275 (2.4)', 'G339 (3.3)'],\n    'E3': ['R272 (1.8, salt bridge)', 'T37 (1.8, H-bond)', 'R342 (2.6)'],\n    'R4': ['E231 (1.6)', 'E268 (1.7)', 'D234 (1.6)', 'Y15 (2.1)', 'T14 (1.7)', 'K271 +/+ clash'],\n    'Q5': ['D10 (2.2)', 'E175 (1.8)', 'D199 (2.3)', 'G202 (1.8)', 'P365 (2.1)'],\n}\n\n# KFQRQ cluster 2 analysis\nfor pres in PEPTIDE:\n    pname = PEP_NAMES[pres]\n    contacts = pres_contacts[pres]\n    \n    # For each receptor residue, get the min distance across models\n    rec_summary = {}\n    for rres, dists in contacts.items():\n        min_d = min(dists)\n        avg_d = sum(dists)/len(dists)\n        n_models = len(dists)\n        rec_summary[rres] = (min_d, avg_d, n_models)\n    \n    # Show both: residues also seen in KFERQ, and new contacts\n    print(f'--- {pname} (KFERQ contacts in ref: {\", \".join(KFERQ_CL1[pname])}) ---')\n    \n    # Show best contacts\n    sorted_recs = sorted(rec_summary.items(), key=lambda x: x[1][0])\n    for rres, (min_d, avg_d, n) in sorted_recs[:8]:\n        rlabel = f'{rres[1]}{rres[2]}'\n        model_str = f'{n}/4 models' if n < 4 else 'all 4'\n        print(f'  {\"O\" if n>=3 else \"?\"}  {rlabel:<8s}  min {min_d:.1f}A  avg {avg_d:.1f}A  [{model_str}]')\n    \n    # Check if KFERQ key contacts are present\n    print(f'  KFERQ contacts retained: ', end='')\n    kferq_contacts = KFERQ_CL1.get(pname, [])\n    found = []\n    missing = []\n    for kc in kferq_contacts:\n        rname = kc.split()[0]  # e.g. \"D366\"\n        rres = rname[:1] + rname[1:].split()[0] if ' ' in rname else rname\n        # Parse like D366 -> residue name letter + number\n        resn = ''.join(c for c in rname if c.isalpha())\n        resi = ''.join(c for c in rname if c.isdigit())\n        key = ('A', resn, int(resi))\n        if key in rec_summary:\n            found.append(f'{rname}({rec_summary[key][0]:.1f}A)')\n        else:\n            missing.append(rname)\n    if found:\n        print(', '.join(found))\n    if missing:\n        print(f'  KFERQ contacts LOST: {\", \".join(missing)}')\n    print()\nPYEOF\n"}

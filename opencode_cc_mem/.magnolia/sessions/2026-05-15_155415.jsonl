{"event_type":"tool_call","timestamp":"2026-06-24T12:11:19.912106Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport gzip, math\nfrom collections import defaultdict\n\ndef parse(path):\n    atoms=[]\n    op = gzip.open if path.endswith('.gz') else open\n    with op(path,'rt') as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            ch=line[21].strip()\n            try:\n                res=int(line[22:26]); x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n            except ValueError:\n                continue\n            name=line[12:16].strip(); resn=line[17:20].strip()\n            atoms.append((ch,res,resn,name,x,y,z))\n    return atoms\n\ndef vec(a,b): return (b[0]-a[0],b[1]-a[1],b[2]-a[2])\ndef unit(v):\n    m=math.sqrt(sum(c*c for c in v)) or 1.0\n    return (v[0]/m,v[1]/m,v[2]/m)\ndef angle(d,v):  # degrees between direction unit d and vector v\n    u=unit(v); dot=max(-1,min(1,d[0]*u[0]+d[1]*u[1]+d[2]*u[2]))\n    return math.degrees(math.acos(dot))\n\ndef analyze(label, path):\n    atoms=parse(path)\n    # receptor = chain A, peptide = the other (fewest residues)\n    chains=defaultdict(set)\n    for ch,res,_,_,_,_,_ in atoms: chains[ch].add(res)\n    pept_ch=min(chains, key=lambda c: len(chains[c]))\n    rec_ch='A' if 'A' in chains else max(chains, key=lambda c: len(chains[c]))\n    # peptide residues sorted\n    pres=sorted(chains[pept_ch])\n    def getatom(ch,res,name):\n        for c,r,rn,nm,x,y,z in atoms:\n            if c==ch and r==res and nm==name: return (x,y,z)\n        return None\n    nterm=pres[0]; cterm=pres[-1]\n    CA_n=getatom(pept_ch,nterm,'CA'); N_n=getatom(pept_ch,nterm,'N')\n    CA_c=getatom(pept_ch,cterm,'CA'); C_c=getatom(pept_ch,cterm,'C')\n    # growth directions\n    dN=unit(vec(CA_n,N_n))   # N-terminal growth dir\n    dC=unit(vec(CA_c,C_c))   # C-terminal growth dir\n    print(f\"\\n###### {label} ######\")\n    print(f\"peptide chain={pept_ch} res {pres}; N-term res {nterm}, C-term res {cterm}\")\n    # receptor atoms for targets, closest heavy atom to terminal CA\n    targets={431:'TYR',469:'ARG',543:'GLU'}\n    for resnum in (431,469,543):\n        rec=[a for a in atoms if a[0]==rec_ch and a[1]==resnum and a[3] not in ('H',)]\n        if not rec: \n            print(f\"  rec {resnum}: NOT FOUND\"); continue\n        # closest heavy atom of this rec residue to N-term CA and to C-term CA\n        cn=min(rec, key=lambda a: sum((a[i+4]-CA_n[i])**2 for i in range(3)))\n        cc=min(rec, key=lambda a: sum((a[i+4]-CA_c[i])**2 for i in range(3)))\n        vn=vec(CA_n,(cn[4],cn[5],cn[6])); vc=vec(CA_c,(cc[4],cc[5],cc[6]))\n        distN=math.sqrt(sum(c*c for c in vn)); distC=math.sqrt(sum(c*c for c in vc))\n        aN=angle(dN,vn); aC=angle(dC,vc)\n        print(f\"  rec {targets[resnum]}{resnum}: N-term dir\u2192 {aN:5.1f}\u00b0 (dist {distN:4.1f}\u00c5, atom {cn[3]});  C-term dir\u2192 {aC:5.1f}\u00b0 (dist {distC:4.1f}\u00c5, atom {cc[3]})\")\n    # also: overall, does N-term or C-term point more 'into pocket'? avg angle to the 3 targets\n    print(\"  (small angle = terminus points TOWARD that residue => extension would reach it)\")\n\nanalyze(\"RKDLQ best cluster2 model1\", \"2026-06-16_af3_RKDLQ_s5000_full/output/11_seletopclusts/cluster_2_model_1.pdb.gz\")\nanalyze(\"RKALQ best cluster1 model1\", \"2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\nPY"}

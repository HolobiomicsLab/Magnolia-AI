{"event_type":"tool_call","timestamp":"2026-06-03T15:24:47.615797Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, subprocess\n\nruns_base = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\ndirs = [\"2026-06-03_RKELQx2_p2rank1_s10000\", \"2026-06-03_QRKELx2_p2rank1_s10000\", \"2026-06-03_RKDLQ-variant_p2rank1_s10000\"]\n\nfor d in dirs:\n    print(f\"\\n=== {d} ===\")\n    run_dir = os.path.join(runs_base, d)\n    \n    # 1. Input files present and non-empty\n    for f in [\"receptor.pdb\", \"peptide.pdb\", \"config.cfg\", \"receptor.actpass\", \"peptide.actpass\", \"ambig.tbl\"]:\n        fp = os.path.join(run_dir, f)\n        size = os.path.getsize(fp) if os.path.exists(fp) else 0\n        print(f\"  {f}: {'OK' if size > 0 else 'MISSING/EMPTY'} ({size} bytes)\")\n    \n    # 3. No symlinks\n    for f in [\"receptor.pdb\", \"peptide.pdb\"]:\n        fp = os.path.join(run_dir, f)\n        if os.path.islink(fp):\n            print(f\"  WARNING: {f} is a symlink!\")\n    \n    # 5. PDB segments and chains\n    with open(os.path.join(run_dir, \"peptide.pdb\")) as f:\n        first = [l for l in f if l.startswith(\"ATOM\")][0]\n    chain = first[21]\n    segid = first[72:76]\n    print(f\"  Peptide chain: [{chain}], segid: [{segid}]\")\n    \n    # 6. Residue range\n    residues = set()\n    with open(os.path.join(run_dir, \"peptide.pdb\")) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                residues.add(int(line[22:26].strip()))\n    pep_range = f\"{min(residues)}-{max(residues)}\"\n    print(f\"  Peptide residues: {pep_range} ({len(residues)} unique)\")\n    \n    # 7. Actpass \u2194 config agreement\n    with open(os.path.join(run_dir, \"peptide.actpass\")) as f:\n        actpass_res = [int(x) for x in f.readline().split()]\n    print(f\"  Actpass residues: {min(actpass_res)}-{max(actpass_res)} ({len(actpass_res)} residues)\")\n    \n    # Check config fle_sta/fle_end\n    with open(os.path.join(run_dir, \"config.cfg\")) as f:\n        config = f.read()\n    import re\n    fle_sta = re.search(r'fle_sta_2\\s*=\\s*(\\d+)', config)\n    fle_end = re.search(r'fle_end_2\\s*=\\s*(\\d+)', config)\n    if fle_sta and fle_end:\n        print(f\"  Config fle: {fle_sta.group(1)}-{fle_end.group(1)}\")\n    \n    # 8. Actpass format (2 lines)\n    with open(os.path.join(run_dir, \"peptide.actpass\")) as f:\n        lines = f.read().strip().split('\\n')\n    print(f\"  Actpass lines: {len(lines)}\")\n\nPYEOF\n"}

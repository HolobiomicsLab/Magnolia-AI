{"event_type":"tool_call","timestamp":"2026-06-16T13:35:42.169148Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os\n\nBASE = \"runs\"\nPEPTIDES = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\", 3),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\", 1),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\", 1),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\", 3),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\", 1),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\", 1),\n]\n\nmmgbsa = {\n    \"KFERQ\": [(\"LYS\", \"647\", 27.6), (\"PHE\", \"648\", 1.4), (\"GLU\", \"649\", -1.0), (\"ARG\", \"650\", 6.8), (\"GLN\", \"651\", 6.1)],\n    \"KILDQ\": [(\"LYS\", \"652\", 6.0), (\"ILE\", \"653\", 0.4), (\"LEU\", \"654\", -1.6), (\"ASP\", \"655\", 1.9), (\"GLN\", \"656\", 11.9)],\n    \"RKDLQ\": [(\"ARG\", \"1\", 6.9), (\"LYS\", \"2\", 27.0), (\"ASP\", \"3\", 1.1), (\"LEU\", \"4\", -7.5), (\"GLN\", \"5\", 4.3)],\n    \"RKELQ\": [(\"ARG\", \"652\", 51.8), (\"LYS\", \"653\", 3.0), (\"GLU\", \"654\", -1.6), (\"LEU\", \"655\", -0.6), (\"GLN\", \"656\", 0.6)],\n    \"QRKEL\": [(\"GLN\", \"652\", 48.3), (\"ARG\", \"653\", 2.8), (\"LYS\", \"654\", -0.8), (\"GLU\", \"655\", -3.4), (\"LEU\", \"656\", 1.4)],\n    \"HAMNG\": [(\"HIS\", \"1\", 8.5), (\"ALA\", \"2\", -3.3), (\"MET\", \"3\", -4.4), (\"ASN\", \"4\", -1.8), (\"GLY\", \"5\", 9.5)],\n}\n\ndef get_contacts(rd, best_clt):\n    cmdir = f\"{BASE}/{rd}/output/8_contactmap\"\n    tsv_f = f\"{cmdir}/cluster{best_clt}_interchain_contacts.tsv\"\n    contacts = {}\n    if not os.path.exists(tsv_f):\n        return contacts\n    lines = open(tsv_f).readlines()\n    data_started = False\n    for line in lines:\n        if line.startswith('#'): continue\n        if not data_started: data_started = True; continue\n        parts = line.strip().split('\\t')\n        if len(parts) < 7: continue\n        try: shortest = float(parts[6])\n        except ValueError: continue\n        res1, res2 = parts[0], parts[1]\n        for r in [res1, res2]:\n            if r.startswith('B-'):\n                parts_r = r.split('-')\n                key = f\"{parts_r[2]}{parts_r[1]}\"\n                if key not in contacts:\n                    contacts[key] = {'n': 0, 'mindist': 999}\n                contacts[key]['n'] += 1\n                contacts[key]['mindist'] = min(contacts[key]['mindist'], shortest)\n    return contacts\n\n# Residue classification\ndef classify(mm_energy, n_contacts, mindist):\n    \"\"\"Anchor / Contact-only / MM-GBSA-only / None\"\"\"\n    has_mmgbsa = mm_energy < 0\n    has_contacts = n_contacts > 0 and mindist < 4.0\n    if has_mmgbsa and has_contacts:\n        return \"ANCHOR\"\n    elif has_contacts and not has_mmgbsa:\n        return \"contact-only\"\n    elif has_mmgbsa and not has_contacts:\n        return \"MM-GBSA-only\"\n    else:\n        return \"none\"\n\nprint(\"Residue-by-residue comparison: contacts vs MM-GBSA\")\nprint(\"=\" * 105)\nprint(f\"{'Peptide':<10} {'Pos':<5} {'Res':<5} {'#ct':<5} {'d_min':<7} {'MM-GBSA':<9} {'Class'}\")\nprint(\"-\" * 105)\n\nsummary = {\"ANCHOR\": 0, \"contact-only\": 0, \"MM-GBSA-only\": 0, \"none\": 0}\n\nfor tag, rd, best_clt in PEPTIDES:\n    contacts = get_contacts(rd, best_clt)\n    seq_data = mmgbsa[tag]\n    \n    for i, (resname, resi, mm) in enumerate(seq_data):\n        key = f\"{resname}{resi}\"\n        info = contacts.get(key, {'n': 0, 'mindist': 0})\n        d_str = f\"{info['mindist']:.1f}\" if info['n'] > 0 else \"\u2014\"\n        n_str = str(info['n']) if info['n'] > 0 else \"\u2014\"\n        klass = classify(mm, info['n'], info['mindist'])\n        summary[klass] += 1\n        print(f\"{tag if i==0 else '':<10} {i+1:<5} {resname:<5} {n_str:<5} {d_str:<7} {mm:+6.1f}     {klass}\")\n\nprint(\"-\" * 105)\nprint(f\"Summary: ANCHOR={summary['ANCHOR']}, contact-only={summary['contact-only']}, MM-GBSA-only={summary['MM-GBSA-only']}, none={summary['none']}\")\nprint()\nprint(\"ANCHOR = both agree this residue drives binding\")\nprint(\"contact-only = touches but MM-GBSA says no contribution \u2192 free to mutate\")\nprint(\"MM-GBSA-only = favorable energy but no contacts \u2192 buried electrostatics, investigate\")\nprint(\"none = both agree this residue doesn't matter\")\n\nPYEOF"}

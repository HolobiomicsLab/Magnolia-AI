_backbone(path, 'B', cr)])\n    if len(tc) != len(ref_core):\n        print(f\"{name:<32} (atom count mismatch: {len(tc)} vs {len(ref_core)})\")\n        continue\n    rd, R, rc_r, rc_t = kabsch_rmsd(ref_rec, tr)\n    pt = tc - rc_t; pr = pt @ R.T; pa = pr + rc_r\n    r = np.sqrt(((ref_core - pa)**2).sum() / len(ref_core))\n    m = \"SAME\" if r < 2.0 else (\"DIFF\" if r < 4.0 else \"FAR\")\n    print(f\"{name:<32} {rd:>9.3f} {r:>10.3f} {m:>6}\")\n\n# Non-KFERQ: just check receptor RMSD and which side of receptor the peptide is on\nprint(\"\\n=== Non-KFERQ peptides: receptor alignment only ===\")\nprint(f\"{'Model':<28} {'Rec RMSD':>9} {'N-term pos':>12}\")\nprint(\"-\" * 52)\nnon_kferq = {\n    'RKELQx2 (10mer)': ('152508', (647,656)),\n    'QRKELx2 (10mer)': ('152511', (647,656)),\n    'RKDLQ-variant (10mer)': ('152514', (647,656)),\n}\n# Get reference N-term position (CA of residue 647)\nref_nterm = np.array([a['xyz'] for a in get_backbone(ref_path, 'B', (647,647)) if a['atom']=='CA'])[0]\n\nfor name, (id_, cr) in non_kferq.items():\n    path = f'/tmp/contact_analysis/{id_}_cl1_m1.pdb'\n    tr = np.array([a['xyz'] for a in get_backbone(path, 'A', (1,9999))])\n    test_nterm = np.array([a['xyz'] for a in get_backbone(path, 'B', (cr[0],cr[0])) if a['atom']=='CA'])[0]\n    rd, R, rc_r, rc_t = kabsch_rmsd(ref_rec, tr)\n    pt = test_nterm - rc_t; pr = pt @ R.T; pa = pr + rc_r\n    dist = np.linalg.norm(ref_nterm - pa)\n    print(f\"{name:<28} {rd:>9.3f} {dist:>12.1f} A\")\n\n# Also get the centroid of the full peptide for context\nprint(\"\\n=== Peptide centroid distances (after receptor alignment) ===\")\nprint(f\"{'Model':<28} {'Rec RMSD':>9} {'Centroid dist':>13}\")\nprint(\"-\" * 52)\nall_tests = {**kferq_family, **non_kferq}\nfor name, (id_, cr) in all_tests.items():\n    path = f'/tmp/contact_analysis/{id_}_cl1_m1.pdb'\n    tr = np.array([a['xyz'] for a in get_backbone(path, 'A', (1,9999))])\n    tp = np.array([a['xyz'] for a in get_backbone(path, 'B', cr)])\n    rd, R, rc_r, rc_t = kabsch_rmsd(ref_rec, tr)\n    pt = tp - rc_t; pr = pt @ R.T; pa = pr + rc_r\n    ref_c = get_backbone(ref_path, 'B', (646,651))\n    ref_cen = np.array([a['xyz'] for a in ref_c]).mean(axis=0)\n    test_cen = pa.mean(axis=0)\n    d = np.linalg.norm(ref_cen - test_cen)\n    print(f\"{name:<28} {rd:>9.3f} {d:>13.1f} A\")\nPYEOF"}

t(\"KFERQx2 peptide contacts:\", [(r, next(k[2] for k in c11 if k[3]==r)) for r in pep11])\n\n# Receptor residues contacted by each\nrec5 = set((k[0], k[1]) for k in c5)\nrec11 = set((k[0], k[1]) for k in c11)\nshared_rec = rec5 & rec11\n\nprint(f\"\\nReceptor residues contacted: KFERQ={len(rec5)}, KFERQx2={len(rec11)}, shared={len(shared_rec)}\")\nprint(f\"Shared fraction: KFERQ={len(shared_rec)/len(rec5)*100:.0f}%, KFERQx2={len(shared_rec)/len(rec11)*100:.0f}%\")\n\nprint(\"\\n=== Shared receptor contacts ===\")\nfor rn, ri in sorted(shared_rec):\n    p5 = [k for k in c5 if k[0]==rn and k[1]==ri]\n    p11 = [k for k in c11 if k[0]==rn and k[1]==ri]\n    p5_pep = \", \".join(f\"{k[2]}{k[3]}\" for k in p5)\n    p11_pep = \", \".join(f\"{k[2]}{k[3]}\" for k in p11)\n    d5 = min(k[4] for k in p5)\n    d11 = min(k[4] for k in p11)\n    print(f\"  {rn}{ri}:  KFERQ->{p5_pep} ({d5:.1f}A)  |  KFERQx2->{p11_pep} ({d11:.1f}A)\")\n\nprint(\"\\n=== KFERQ-only contacts ===\")\nonly5 = rec5 - rec11\nfor rn, ri in sorted(only5):\n    p5 = [k for k in c5 if k[0]==rn and k[1]==ri]\n    p5_pep = \", \".join(f\"{k[2]}{k[3]}\" for k in p5)\n    print(f\"  {rn}{ri}: {p5_pep}\")\n\nprint(\"\\n=== KFERQx2-only contacts (from the core 5 residues, resi 647-651) ===\")\nonly11 = rec11 - rec5\n# Only show contacts involving core 5-mer residues (647-651), not extras\nonly11_core = [(rn, ri) for rn, ri in only11 if any(k[3]<=651 for k in c11 if k[0]==rn and k[1]==ri)]\nprint(f\"  (showing only core-residue contacts, {len(only11_core)} of {len(only11)} total)\")\nfor rn, ri in sorted(only11_core):\n    p11 = [k for k in c11 if k[0]==rn and k[1]==ri and k[3]<=651]\n    p11_pep = \", \".join(f\"{k[2]}{k[3]}\" for k in p11)\n    if p11_pep:\n        d11 = min(k[4] for k in p11)\n        print(f\"  {rn}{ri}: {p11_pep} ({d11:.1f}A)\")\n\n# Extra residue contacts\nprint(\"\\n=== KFERQx2 extra-residue contacts (resi > 651) ===\")\nfor rn, ri in sorted(rec11):\n    p11 = [k for k in c11 if k[0]==rn and k[1]==ri and k[3]>651]\n    if p11:\n        p11_pep = \", \".join(f\"{k[2]}{k[3]}\" for k in p11)\n        d11 = min(k[4] for k in p11)\n        print(f\"  {rn}{ri}: {p11_pep} ({d11:.1f}A)\")\n\nPYEOF"}

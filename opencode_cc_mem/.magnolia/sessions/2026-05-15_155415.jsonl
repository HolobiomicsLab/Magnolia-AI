{"event_type":"tool_call","timestamp":"2026-07-01T07:46:33.098168Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\n# Detailed side-by-side of key receptor residues for each run/candidate\nruns = {\n    \"EGGFQMALT parent\": (\"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1),\n    \"EAGFQMALT parent\": (\"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\", 1),\n    \"EGGFQMAKT\": (\"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3),  # best cl\n    \"EGGFQMART\": (\"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\", 1),\n    \"EAKFQMALT\": (\"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", 2),  # best cl\n    \"EAGFQMRLT_cl2\": (\"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 2),  # diffuse cl\n    \"EAGFQMRLT_cl6\": (\"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 6),  # tightest cl\n    \"EAGFQMKLT\": (\"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", 1),\n}\n\ncore = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n\ndef get_core_overlap(d, cl):\n    fpath = f\"{d}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return set()\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    contacts = {}\n    for row in reader:\n        m = re.match(r'A-(\\d+)-(\\w+)', row.get('res1',''))\n        if m:\n            rn = int(m.group(1))\n            if rn in core:\n                dist = float(row.get('shortest-dist', 999))\n                m2 = re.match(r'B-(\\d+)-(\\w+)', row.get('res2',''))\n                pept = m2.group(2)+m2.group(1) if m2 else '?'\n                if rn not in contacts or dist < contacts[rn][0]:\n                    contacts[rn] = (dist, pept)\n    return contacts\n\n# Show side-by-side\nprint(f\"{'Core residue':>12s}\", end=\"\")\nfor label in runs:\n    print(f\"  {label:<18s}\", end=\"\")\nprint()\nprint(\"-\" * 140)\n\nfor rn in sorted(core):\n    print(f\"{rn:>12d}\", end=\"\")\n    for label, (d, cl) in runs.items():\n        cts = get_core_overlap(d, cl)\n        if rn in cts:\n            dist, pept = cts[rn]\n            print(f\"  {pept:>6s}@{dist:4.1f}A        \", end=\"\")\n        else:\n            print(f\"  {'--':>6s}            \", end=\"\")\n    print()\nPYEOF"}

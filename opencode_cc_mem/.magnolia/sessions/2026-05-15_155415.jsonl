{"event_type":"tool_call","timestamp":"2026-06-20T19:55:04.939707Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 << 'PYEOF'\nimport csv, numpy as np\n\nwith open(\"results/comparison.csv\") as f:\n    rows = list(csv.DictReader(f))\n\n# 11-ring molecules specifically\nr11 = [r for r in rows if r[\"n_rings\"] == \"11\"]\ndE11 = [float(r[\"Etot_our\"]) - float(r[\"Etot_lit\"]) for r in r11]\nadE11 = np.abs(dE11)\n\nprint(f\"11-ring molecules: {len(r11)}\")\nprint(f\"  MAE Etot:     {np.mean(adE11):.3f} eV\")\nprint(f\"  median |\u0394Etot|: {np.median(adE11):.3f} eV\")\nprint(f\"  |\u0394Etot| < 0.1 eV: {np.sum(adE11 < 0.1)} / {len(r11)}  ({np.sum(adE11 < 0.1)/len(r11)*100:.1f}%)\")\nprint(f\"  |\u0394Etot| < 0.5 eV: {np.sum(adE11 < 0.5)} / {len(r11)}  ({np.sum(adE11 < 0.5)/len(r11)*100:.1f}%)\")\nprint(f\"  |\u0394Etot| > 5.0 eV: {np.sum(adE11 > 5.0)} / {len(r11)}  ({np.sum(adE11 > 5.0)/len(r11)*100:.1f}%)\")\n\n# Check if any 11-ring has small error\ngood = [r for r in r11 if abs(float(r[\"Etot_our\"]) - float(r[\"Etot_lit\"])) < 0.1]\nif good:\n    print(f\"\\n  Examples with good agreement (<0.1 eV):\")\n    for r in good[:3]:\n        z_range = None\n        try:\n            with open(f\"{r['molecule']}.xtbopt.xyz\") as f:\n                lines = f.readlines()\n            natoms = int(lines[0].strip())\n            zs = [float(lines[j].split()[3]) for j in range(2, 2+natoms)]\n            z_range = max(zs) - min(zs)\n        except:\n            pass\n        dE = float(r[\"Etot_our\"]) - float(r[\"Etot_lit\"])\n        print(f\"    {r['molecule']}  \u0394Etot={dE:+.4f}  z-range={z_range}\")\n\nprint(f\"\\n  How \u0394Etot correlates with planarity:\")\n# Check z-range for a few good and bad ones\nfor r in r11[:20]:  # first 20 in list\n    try:\n        with open(f\"{r['molecule']}.xtbopt.xyz\") as f:\n            lines = f.readlines()\n        natoms = int(lines[0].strip())\n        zs = [float(lines[j].split()[3]) for j in range(2, 2+natoms)]\n        zr = max(zs) - min(zs)\n        dE = float(r[\"Etot_our\"]) - float(r[\"Etot_lit\"])\n        if abs(dE) > 5:\n            status = \"BAD\"\n        elif abs(dE) < 0.5:\n            status = \"GOOD\"\n        else:\n            status = \"OK\"\n        print(f\"    {status:4s}  {r['molecule']:35s}  \u0394Etot={dE:+.2f}  z-range={zr:.1f} \u00c5\")\n    except:\n        pass\nPYEOF\n"}

{"event_type":"tool_call","timestamp":"2026-07-01T07:40:55.796152Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = [\n    (\"EGGFQMAKT (L8\u2192K)\", \"projects/hsc70_new/runs/2026-07-01_alascan_eggfqmakt\"),\n    (\"EGGFQMART (L8\u2192R)\", \"projects/hsc70_new/runs/2026-07-01_alascan_eggfqmart\"),\n    (\"EAKFQMALT (G3\u2192K)\", \"projects/hsc70_new/runs/2026-07-01_alascan_eakfqmalt\"),\n    (\"EAGFQMRLT (A7\u2192R)\", \"projects/hsc70_new/runs/2026-07-01_alascan_eagfqmrlt\"),\n    (\"EAGFQMKLT (A7\u2192K)\", \"projects/hsc70_new/runs/2026-07-01_alascan_eagfqmklt\"),\n]\n\nfor label, d in runs:\n    fpath = f\"{d}/output/1_alascan/scan_complex_haddock.tsv\"\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    print(f\"\\n{'='*70}\")\n    print(f\"  {label}\")\n    print(f\"  {'Pos':>4s} {'Res':>5s} {'\u0394_score':>9s} {'\u0394_elec':>9s} {'\u0394_vdw':>9s} {'\u0394_desolv':>9s} {'\u0394_bsa':>8s}  Role\")\n    print(f\"  {'-'*68}\")\n    for row in reader:\n        pos = int(row['res'])\n        res = row['ori_resname']\n        ds = float(row['delta_score'])\n        de = float(row['delta_elec'])\n        dv = float(row['delta_vdw'])\n        dd = float(row['delta_desolv'])\n        db = float(row.get('delta_bsa',0))\n        \n        if ds < -5: role = \"HOTSPOT\"\n        elif ds < -2: role = \"Important\"\n        elif ds > 2: role = \"DETRIMENTAL\"\n        elif ds > 0: role = \"Mild-detrimental\"\n        else: role = \"Neutral/Weak\"\n        \n        marker = \" ***\" if abs(ds) > 1 else \"\"\n        print(f\"  {pos:>4d} {res:>5s} {ds:>+9.2f} {de:>+9.2f} {dv:>+9.2f} {dd:>+9.2f} {db:>+8.1f}  {role}{marker}\")\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-07-01T07:40:55.843895Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":47,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-07-01T07:45:34.032030Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\n# 1. EAGFQMRLT - all models by cluster\nd = \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\"\nfor sfx in ['12_caprieval', '09_caprieval']:\n    ss = f\"{d}/output/{sfx}/capri_ss.tsv\"\n    if os.path.exists(ss):\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        \n        # Group by cluster\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','?')\n            crank = row.get('cluster_ranking','?')\n            if cid not in clusters:\n                clusters[cid] = []\n            score = float(row['score'])\n            air = float(row.get('air',0))\n            af = score - 0.1*air\n            clusters[cid].append((af, score, row.get('dockq','?'), row.get('irmsd','?'), \n                                   row.get('lrmsd','?'), row.get('vdw','?'), row.get('elec','?')))\n        \n        print(f\"=== EAGFQMRLT \u2014 {sfx} ===\")\n        for cid in sorted(clusters.keys(), key=lambda x: int(x) if x.isdigit() else 0):\n            models = clusters[cid]\n            models.sort()\n            best_af, best_score, best_dq, best_irmsd, best_lrmsd, vdw, elec = models[0]\n            # Average of top 4\n            avg_af = sum(m[0] for m in models[:4]) / min(4, len(models))\n            print(f\"  Cluster {cid} (r={models[0][3] if len(models) else '?'}): n={len(models)} | top AIR-free={best_af:.2f} (DockQ={best_dq}) | avg4={avg_af:.2f} | vdw={vdw} elec={elec}\")\n        break\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-07-01T07:45:34.078380Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":46,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-07-01T07:45:51.705447Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\n# EAGFQMRLT \u2014 full cluster details with irmsd/lrmsd\nd = \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\"\nss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\nwith open(ss) as f:\n    lines = [l for l in f if not l.startswith('#')]\nreader = csv.DictReader(lines, delimiter='\\t')\nclusters = {}\nfor row in reader:\n    cid = row.get('cluster_id','?')\n    if cid not in clusters:\n        clusters[cid] = []\n    clusters[cid].append({\n        'score': float(row['score']),\n        'air_free': float(row['score']) - 0.1*float(row.get('air',0)),\n        'dockq': float(row.get('dockq',0)),\n        'irmsd': float(row.get('irmsd',0)),\n        'lrmsd': float(row.get('lrmsd',0)),\n        'fnat': float(row.get('fnat',0)),\n        'vdw': float(row.get('vdw',0)),\n        'elec': float(row.get('elec',0)),\n        'bsa': float(row.get('bsa',0)),\n    })\n\nprint(\"EAGFQMRLT \u2014 all clusters\")\nprint(f\"{'Cluster':>8s} {'n':>4s} {'Best AF':>9s} {'Best DQ':>8s} {'irmsd':>7s} {'lrmsd':>7s} {'fnat':>6s} {'avg4 AF':>9s} {'top vdw':>9s} {'top elec':>9s}\")\nprint(\"-\" * 85)\nfor cid in sorted(clusters.keys(), key=lambda x: int(x) if x.isdigit() else 99):\n    models = sorted(clusters[cid], key=lambda x: x['score'])\n    best = models[0]\n    avg4 = sum(m['air_free'] for m in models[:4]) / min(4, len(models))\n    print(f\"{cid:>8s} {len(models):>4d} {best['air_free']:>+9.2f} {best['dockq']:>8.3f} {best['irmsd']:>7.3f} {best['lrmsd']:>7.1f} {best['fnat']:>6.3f} {avg4:>+9.2f} {best['vdw']:>+9.2f} {best['elec']:>+9.2f}\")\n\n# Now compare parent EAGFQMALT contact map\nprint(\"\\n\\n=== Parent EAGFQMALT cl3 \u2014 contact zone overview ===\")\nparent = \"projects/hsc70_new/runs/2026-06-25_alascan_eagfqmalt_cl3\"\n# Actually the parent docking run. Let me check if we have it.\n# The parent docking run for EAGFQMALT was likely in the TGGFQMALT mutation batch\n# Let me check available contact maps\nfor parent_dir in [\n    \"projects/hsc70_new/runs/2026-06-16_af3_TGGFQMALT_s10000_full\",\n]:\n    if os.path.isdir(parent_dir):\n        cm_dir = f\"{parent_dir}/output/13_contactmap\"\n        if os.path.isdir(cm_dir):\n            print(f\"  Found: {parent_dir}\")\n            break\nelse:\n    # Check for EAGFQMALT itself\n    for dname in os.listdir(\"projects/hsc70_new/runs/\"):\n        if 'eagfqmalt' in dname.lower() and 'alascan' not in dname.lower():\n            cm = f\"projects/hsc70_new/runs/{dname}/output/13_contactmap\"\n            if os.path.isdir(cm) and os.listdir(cm):\n                print(f\"  Parent contact map: {dname}\")\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-07-01T07:45:51.755425Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":50,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-07-01T07:46:05.971758Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_contact_zones(run_dir, cluster_id):\n    \"\"\"Return set of receptor residues contacted by the peptide\"\"\"\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return None, None\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    rec_residues = set()\n    pep_residues = set()\n    for row in reader:\n        res2 = row.get('res2','')  # peptide\n        res1 = row.get('res1','')  # receptor\n        # Parse receptor residues\n        m = re.match(r'A-(\\d+)-(\\w+)', res1)\n        if m:\n            rec_residues.add(int(m.group(1)))\n        m = re.match(r'B-(\\d+)-(\\w+)', res2)\n        if m:\n            pep_residues.add(int(m.group(1)))\n    return rec_residues, pep_residues\n\n# Find parent runs\nruns_to_compare = [\n    (\"EGGFQMALT (parent cl1)\", \"projects/hsc70_new/runs/2026-06-25_alascan_eggfqmalt_cl1\", None),  # need actual docking run\n]\n\n# Actually let me search for the parent docking runs\nfor dname in sorted(os.listdir(\"projects/hsc70_new/runs/\")):\n    if '2026-06-16_af3' in dname and 'TGGFQMALT' not in dname and 's' in dname:\n        cm = f\"projects/hsc70_new/runs/{dname}/output/13_contactmap\"\n        if os.path.isdir(cm) and os.listdir(cm) and 'cluster' in ' '.join(os.listdir(cm)):\n            print(f\"  {dname}\")\n\nprint(\"\\nSearching for EGGFQMALT/EAGFQMALT parent docking runs...\")\nfor dname in sorted(os.listdir(\"projects/hsc70_new/runs/\")):\n    dl = dname.lower()\n    if any(x in dl for x in ['eggfqmalt', 'eagfqmalt']) and 'alascan' not in dl:\n        cm = f\"projects/hsc70_new/runs/{dname}/output/13_contactmap\"\n        has_files = os.path.isdir(cm) and os.listdir(cm) and any('interchain' in f for f in os.listdir(cm))\n        print(f\"  {dname} \u2014 has contactmap: {has_files}\")\nPYEOF"}

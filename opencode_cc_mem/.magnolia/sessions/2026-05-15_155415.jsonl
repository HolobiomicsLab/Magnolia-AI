{"event_type":"tool_call","timestamp":"2026-06-25T13:08:13.161174Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c B=projects/hsc70_new/runs\ndeclare -A F=(\n  [PARENT_cl2]=\"$B/2026-06-16_af3_TGGFQMALT_s10000_full/output/13_contactmap/cluster2_interchain_contacts.tsv\"\n  [EGGFQMALT_T1E_cl1]=\"$B/2026-06-24_EGGFQMALT_s10000/output/13_contactmap/cluster1_interchain_contacts.tsv\"\n  [EAGFQMALT_cl3]=\"$B/2026-06-24_EAGFQMALT_s10000/output/13_contactmap/cluster3_interchain_contacts.tsv\"\n)\nfor k in PARENT_cl2 EGGFQMALT_T1E_cl1 EAGFQMALT_cl3; do\n  f=\"${F[$k]}\"\n  echo \"========================= $k =========================\"\n  echo \"peptide_res -> receptor_contacts (resid:dist)\"\n  awk -F'\\t' '$2 ~ /B-/{split($2,b,\"-\"); key=b[2]\"-\"b[3]; split($1,a,\"-\"); rec[key]=rec[key] sprintf(\" %s:%s\",a[2],$7)} END{n=asorti(rec,sk,\"@ind_num_asc\"); # sort by peptide resnum\n    # simple: just print in encountered order grouped\n    for(k in rec) print k\" ->\"rec[k]}' \"$f\" 2>/dev/null | sort -t- -k1n\ndone"}

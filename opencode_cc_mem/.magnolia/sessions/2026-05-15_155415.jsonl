{"event_type":"tool_call","timestamp":"2026-06-10T12:08:48.314980Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nfrom scipy.stats import spearmanr\n\nhaddock = {\n    'Z11-16-Ald': -42.0, 'Z11-16-Ac': -47.6, 'Cedrol': -41.3,\n    '\u03b2-Ionone': -31.3, 'C8-Ald': -30.5, 'C12-Ald': -34.2, 'Citral': -25.7,\n}\n\ngnina = {\n    'Z11-16-Ald': -4.01, 'Z11-16-Ac': -3.80, 'Cedrol': -3.53,\n    '\u03b2-Ionone': -3.12, 'C8-Ald': -3.86, 'C12-Ald': -2.27, 'Citral': -2.95,\n}\n\ncommon = sorted(haddock.keys() & gnina.keys())\nh3_vals = [haddock[n] for n in common]\ng_vals = [gnina[n] for n in common]\n\nrho, p = spearmanr(h3_vals, g_vals)\n\nprint(f\"{'Ligand':20s} {'HADDOCK':>8s} {'Gnina':>8s} {'Rank_H3':>8s} {'Rank_G':>8s}\")\nprint(\"-\" * 55)\nfor i, n in enumerate(sorted(common, key=lambda n: haddock[n])):\n    r_h3 = sorted(h3_vals).index(haddock[n]) + 1\n    r_g = sorted(g_vals).index(gnina[n]) + 1\n    print(f\"{n:20s} {haddock[n]:>8.1f} {gnina[n]:>8.2f} {r_h3:>8d} {r_g:>8d}\")\n\nprint(f\"\\nHADDOCK vs Gnina: \u03c1 = {rho:+.3f}  (p = {p:.3f})  n = {len(common)}\")\n\nprint(\"\\nAgreements:\")\nagree = sum(1 for n in common if (haddock[n] > -32) == (gnina[n] > -3.4))\ndisagree = len(common) - agree\nfor n in common:\n    h3_good = haddock[n] < -35  # better than avg\n    g_good = gnina[n] < -3.2   # better than avg\n    agree_sym = '\u2713' if h3_good == g_good else '\u2717'\n    print(f\"  {n:20s}  H3={'good' if h3_good else 'weak'}  G={'good' if g_good else 'weak'}  {agree_sym}\")\nPYEOF"}

(C16 aldehydes)\")\nprint(f\"   {'Ligand':16s} {'Sat?':>5s} {'IC50':>7s} {'Kd':>7s} {'HADDOCK':>8s} {'Gnina':>7s}\")\nprint(\"   \" + \"-\" * 55)\nfor name, sat in [('Z11-16-Ald', 'no'), ('C16-Ald', 'yes')]:\n    h = haddock.get(name, 'N/A')\n    g = gnina.get(name, 'N/A')\n    h_s = f'{h:>8.1f}' if isinstance(h, float) else f'{h:>8s}'\n    g_s = f'{g:>7.2f}' if isinstance(g, float) else f'{g:>7s}'\n    print(f\"   {name:16s} {sat:>5s} {ic50(name):>7.1f} {kd(name):>7.3f} {h_s} {g_s}\")\n\nprint(f\"\\n3. CHAIN LENGTH: C12 is optimal for saturated aldehydes\")\nprint(f\"   {'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'HADDOCK':>8s} {'Gnina':>7s}\")\nprint(\"   \" + \"-\" * 50)\nfor name in ['C8-Ald', 'C10-Ald', 'C12-Ald', 'C14-Ald']:\n    h = haddock.get(name, 'N/A')\n    g = gnina.get(name, 'N/A')\n    h_s = f'{h:>8.1f}' if isinstance(h, float) else f'{h:>8s}'\n    g_s = f'{g:>7.2f}' if isinstance(g, float) else f'{g:>7s}'\n    print(f\"   {name:16s} {ic50(name):>7.1f} {kd(name):>7.3f} {h_s} {g_s}\")\n\nprint(f\"\\n4. FATTY ACIDS are OBP5 ligands, NOT OBP3 (negative controls)\")\nprint(f\"   {'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'HADDOCK':>8s} {'Gnina':>7s}\")\nprint(\"   \" + \"-\" * 50)\nfor name in ['Palmitic acid', 'Octanoic acid', 'Decanoic acid', 'Lauric acid', 'Myristic acid', 'Stearic acid']:\n    h = haddock.get(name, 'N/A')\n    g = gnina.get(name, 'N/A')\n    h_s = f'{h:>8.1f}' if isinstance(h, float) else f'{h:>8s}'\n    g_s = f'{g:>7.2f}' if isinstance(g, float) else f'{g:>7s}'\n    print(f\"   {name:16s} {ic50(name):>7.1f} {kd(name):>7.3f} {h_s} {g_s}\")\n\nprint(f\"\\n5. TERPENOID BAMBOO VOLATILES (strong binders)\")\nprint(f\"   {'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'HADDOCK':>8s} {'Gnina':>7s}\")\nprint(\"   \" + \"-\" * 50)\nfor name in ['\u03b2-Ionone', 'Cedrol', 'Citral', 'Citronellal']:\n    h = haddock.get(name, 'N/A')\n    g = gnina.get(name, 'N/A')\n    h_s = f'{h:>8.1f}' if isinstance(h, float) else f'{h:>8s}'\n    g_s = f'{g:>7.2f}' if isinst
 = []\nfor i, fn in enumerate(sdf_names_sorted):\n    if i >= len(dock): break\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    aff, cnn, cnnaff = dock[i]\n    pairs.append((name, kd, aff, cnn, cnnaff))\n\nkd_arr = np.array([p[1] for p in pairs])\naff_arr = np.array([p[2] for p in pairs])\ncnn_arr = np.array([p[3] for p in pairs])\ncnnaff_arr = np.array([p[4] for p in pairs])\n\nrho_a, p_a = spearmanr(aff_arr, kd_arr)\nrho_c, p_c = spearmanr(cnn_arr, kd_arr)\nrho_ca, p_ca = spearmanr(cnnaff_arr, kd_arr)\n\nprint(f\"\u2550\u2550\u2550 P2Rank BOX (n=40) \u2550\u2550\u2550\")\nprint(f\"Empirical affinity:  \u03c1={rho_a:+.4f}  p={p_a:.4f}\")\nprint(f\"CNN pose score:      \u03c1={rho_c:+.4f}  p={p_c:.4f}\")\nprint(f\"CNN affinity:        \u03c1={rho_ca:+.4f}  p={p_ca:.4f}\")\n\n# By class\nGOOD, MOD, WEAK = [], [], []\nfor name, kd, aff, cnn, cnnaff in pairs:\n    if kd < 1.0:     GOOD.append((aff, name, kd))\n    elif kd < 10:    MOD.append((aff, name, kd))\n    else:            WEAK.append((aff, name, kd))\nfor b in [GOOD,MOD,WEAK]: b.sort(key=lambda x: x[0])\n\nprint(f\"\\n\u2550\u2550\u2550 BY CLASS \u2550\u2550\u2550\")\nfor label, grp in [(\"STRONG\",GOOD),(\"MODERATE\",MOD),(\"WEAK/NON\",WEAK)]:\n    affs = [g[0] for g in grp]\n    print(f\"  {label:<15s} aff = {np.mean(affs):+.2f} \u00b1 {np.std(affs):.2f}\")\n\n# Selectivity\nprint(f\"\\n\u2550\u2550\u2550 Z11-16 SELECTIVITY \u2550\u2550\u2550\")\nfor name, kd, aff, cnn, cnnaff in pairs:\n    if 'Z11-16' in name:\n        print(f\"  {name:<15s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  CNNpose={cnn:.4f}\")\n\nPYEOF"}

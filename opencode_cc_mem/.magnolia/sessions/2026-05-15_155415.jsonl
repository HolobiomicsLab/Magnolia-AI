{"event_type":"tool_call","timestamp":"2026-06-16T13:30:13.286972Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os\n\nBASE = \"runs\"\nPEPTIDES = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\", 3),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\", 1),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\", 1),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\", 3),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\", 1),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\", 1),\n]\n\nmmgbsa = {\n    \"KFERQ\": [(\"LYS647\", 27.6), (\"PHE648\", 1.4), (\"GLU649\", -1.0), (\"ARG650\", 6.8), (\"GLN651\", 6.1)],\n    \"KILDQ\": [(\"LYS652\", 6.0), (\"ILE653\", 0.4), (\"LEU654\", -1.6), (\"ASP655\", 1.9), (\"GLN656\", 11.9)],\n    \"RKDLQ\": [(\"ARG1\", 6.9), (\"LYS2\", 27.0), (\"ASP3\", 1.1), (\"LEU4\", -7.5), (\"GLN5\", 4.3)],\n    \"RKELQ\": [(\"ARG652\", 51.8), (\"LYS653\", 3.0), (\"GLU654\", -1.6), (\"LEU655\", -0.6), (\"GLN656\", 0.6)],\n    \"QRKEL\": [(\"GLN652\", 48.3), (\"ARG653\", 2.8), (\"LYS654\", -0.8), (\"GLU655\", -3.4), (\"LEU656\", 1.4)],\n    \"HAMNG\": [(\"HIS1\", 8.5), (\"ALA2\", -3.3), (\"MET3\", -4.4), (\"ASN4\", -1.8), (\"GLY5\", 9.5)],\n}\n\nprint(f\"{'Peptide':<10} {'Res':<8} {'MM-GBSA':<8} {'Contacts':<10} {'Shortest':<10} {'Receptor partners'}\")\nprint(\"-\" * 90)\n\nfor tag, rd, best_clt in PEPTIDES:\n    cmdir = f\"{BASE}/{rd}/output/8_contactmap\"\n    tsv_f = f\"{cmdir}/cluster{best_clt}_interchain_contacts.tsv\"\n    \n    if not os.path.exists(tsv_f):\n        continue\n    \n    contacts = {}\n    lines = open(tsv_f).readlines()\n    data_started = False\n    for line in lines:\n        if line.startswith('#'):\n            continue\n        if not data_started:\n            data_started = True  # skip header row\n            continue\n        parts = line.strip().split('\\t')\n        if len(parts) < 7:\n            continue\n        res1, res2 = parts[0], parts[1]\n        try:\n            shortest = float(parts[6])\n        except ValueError:\n            continue\n        \n        for r in [res1, res2]:\n            if r.startswith('B-'):\n                parts_r = r.split('-')\n                pep_res = f\"{parts_r[2]}{parts_r[1]}\"\n                if pep_res not in contacts:\n                    contacts[pep_res] = {'n': 0, 'mindist': 999, 'partners': set()}\n                contacts[pep_res]['n'] += 1\n                contacts[pep_res]['mindist'] = min(contacts[pep_res]['mindist'], shortest)\n                rec = res1 if r == res2 else res2\n                contacts[pep_res]['partners'].add(rec)\n    \n    for res_name, mm_energy in mmgbsa.get(tag, []):\n        info = contacts.get(res_name, {'n': 0, 'mindist': 0.0, 'partners': set()})\n        # Get top partners by sorting (just show first 3 unique)\n        sorted_partners = sorted(info['partners'])\n        partner_str = ', '.join(sorted_partners[:3])\n        if len(sorted_partners) > 3:\n            partner_str += f\" +{len(sorted_partners)-3}\"\n        \n        print(f\"{tag:<10} {res_name:<8} {mm_energy:+6.1f}   {info['n']:<8}  {info['mindist']:<8.1f}  {partner_str}\")\n    print()\n\n# Summary: correlation between contacts and MM-GBSA\nprint(\"=\" * 90)\nprint(\"Correlation: contacts vs MM-GBSA interaction energy\")\nprint(f\"{'Peptide':<10} {'Res':<8} {'MM-GBSA':<8} {'#contacts':<10} {'min dist':<10} {'Consistent?'}\")\nprint(\"-\" * 60)\nfor tag, rd, best_clt in PEPTIDES:\n    cmdir = f\"{BASE}/{rd}/output/8_contactmap\"\n    tsv_f = f\"{cmdir}/cluster{best_clt}_interchain_contacts.tsv\"\n    contacts = {}\n    lines = open(tsv_f).readlines()\n    data_started = False\n    for line in lines:\n        if line.startswith('#'):\n            continue\n        if not data_started:\n            data_started = True\n            continue\n        parts = line.strip().split('\\t')\n        if len(parts) < 7:\n            continue\n        res1, res2 = parts[0], parts[1]\n        try: shortest = float(parts[6])\n        except ValueError: continue\n        for r in [res1, res2]:\n            if r.startswith('B-'):\n                parts_r = r.split('-')\n                pep_res = f\"{parts_r[2]}{parts_r[1]}\"\n                if pep_res not in contacts:\n                    contacts[pep_res] = {'n': 0, 'mindist': 999}\n                contacts[pep_res]['n'] += 1\n                contacts[pep_res]['mindist'] = min(contacts[pep_res]['mindist'], shortest)\n    \n    for res_name, mm_energy in mmgbsa.get(tag, []):\n        info = contacts.get(res_name, {'n': 0, 'mindist': 999})\n        # A residue with favorable MM-GBSA (< 0) should have contacts AND short distances\n        has_contacts = info['n'] > 0\n        has_short = info['mindist'] < 4.0 if has_contacts else False\n        consistent = \"\u2713\" if (mm_energy < 0 and has_contacts and has_short) or (mm_energy > 0 and not has_short) else \"?\"\n        print(f\"{tag:<10} {res_name:<8} {mm_energy:+6.1f}   {info['n']:<10} {info['mindist']:<10.1f} {consistent}\")\n\nPYEOF"}

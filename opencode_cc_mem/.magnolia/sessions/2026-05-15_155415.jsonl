{"event_type":"tool_call","timestamp":"2026-07-01T12:18:57.271867Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c echo \"=== PRE-JOB CHECKS ===\"\necho \"\"\n\nfor rundir in \\\n  projects/hsc70_new/runs/2026-07-01_EKGFQMAKT_G2K_on_EGGFQMAKT_s10000 \\\n  projects/hsc70_new/runs/2026-07-01_EKGFQMALT_G2K_on_EGGFQMALT_s10000 \\\n  projects/hsc70_new/runs/2026-07-01_ERQKFERRQ_truncated_KFERQx2_s10000; do\n\n  name=$(basename $rundir)\n  echo \"--- $name ---\"\n\n  # 1. All input files present and non-empty\n  for f in receptor.pdb peptide.pdb ambig.tbl config.cfg; do\n    sz=$(wc -c < \"$rundir/$f\" 2>/dev/null || echo 0)\n    if [ \"$sz\" -gt 0 ]; then\n      echo \"  \u2713 $f ($sz bytes)\"\n    else\n      echo \"  \u2717 $f MISSING or EMPTY\"\n    fi\n  done\n\n  # 2. Peptide sequence + residue range\n  echo -n \"  Peptide: \"\n  grep '^ATOM' \"$rundir/peptide.pdb\" | awk '$1==\"ATOM\"{res=substr($0,18,3); num=substr($0,23,4)+0; seq[num]=res} END{for(i=1;i<=20;i++){if(seq[i]!=\"\")printf \"%s\",seq[i]; if(seq[i]!=\"\")printf \"%d \",i}; print \"\"}'\n  echo -n \"  Residue range: \"\n  grep '^ATOM' \"$rundir/peptide.pdb\" | awk '$1==\"ATOM\"{chain=substr($0,22,1); if(chain==\"B\"){num=substr($0,23,4)+0; if(min==0||num<min)min=num; if(num>max)max=num}} END{print min\"-\"max}'\n\n  # 3. Config fle_sta/fle_end matches peptide\n  fle_sta=$(grep 'fle_sta_2' \"$rundir/config.cfg\" | head -1 | grep -oP '[\\d]+')\n  fle_end=$(grep 'fle_end_2' \"$rundir/config.cfg\" | head -1 | grep -oP '[\\d]+')\n  echo \"  Config fle_sta_2=$fle_sta fle_end_2=$fle_end\"\n\n  # 4. ambig peptide residue range\n  ambig_max=$(grep 'segid B' \"$rundir/ambig.tbl\" | grep -oP 'resi \\K\\d+' | sort -nu | tail -1)\n  echo \"  Ambig peptide max resi: $ambig_max\"\n\n  # 5. Receptor chain\n  echo -n \"  Receptor chains: \"\n  grep '^ATOM' \"$rundir/receptor.pdb\" | awk '{print substr($0,22,1)}' | sort -u | tr '\\n' ' '\n  echo \"\"\n  echo -n \"  Receptor residue range: \"\n  grep '^ATOM' \"$rundir/receptor.pdb\" | awk '{chain=substr($0,22,1); if(chain==\"A\"){num=substr($0,23,4)+0; if(min==0||num<min)min=num; if(num>max)max=num}} END{print min\"-\"max}'\n  \n  # 6. Sampling\n  sampling=$(grep 'sampling' \"$rundir/config.cfg\" | grep -oP '[\\d]+')\n  echo \"  Sampling: $sampling\"\n\n  # 7. No symlinks\n  symlinks=$(find \"$rundir\" -type l | wc -l)\n  echo \"  Symlinks: $symlinks\"\n\n  echo \"\"\ndone"}

{"event_type":"tool_call","timestamp":"2026-07-01T07:32:44.138104Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = [\n    (\"EGGFQMAKT\", \"EGGFQMAKT_s10000\"),\n    (\"EGGFQMART\", \"EGGFQMART_s10000\"),\n    (\"EAKFQMALT\", \"EAKFQMALT_s10000\"),\n    (\"EAGFQMRLT\", \"EAGFQMRLT_s10000\"),\n    (\"EAGFQMKLT\", \"EAGFQMKLT_s10000\"),\n]\n\nfor label, run_dir in runs:\n    d = f\"projects/hsc70_new/runs/2026-06-25_{run_dir}\"\n    ts = f\"{d}/output/10_clustfcc/clustfcc.tsv\"\n    if not os.path.exists(ts):\n        print(f\"{label}: no clustfcc.tsv\")\n        continue\n    with open(ts) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    best_cl = None\n    for row in reader:\n        best_cl = row.get('cluster_id', '1')\n        break\n    \n    # Find the best model PDB\n    model_path = f\"{d}/output/11_seletopclusts/cluster_{best_cl}_model_1.pdb\"\n    if not os.path.exists(model_path):\n        # Try .gz\n        model_path += \".gz\"\n    if not os.path.exists(model_path):\n        print(f\"{label}: best model not found for cluster {best_cl}\")\n    else:\n        import subprocess\n        # Get peptide residue numbers\n        if model_path.endswith('.gz'):\n            result = subprocess.run(['zgrep', '^ATOM', model_path], capture_output=True, text=True)\n        else:\n            result = subprocess.run(['grep', '^ATOM', model_path], capture_output=True, text=True)\n        \n        chain_b = [l for l in result.stdout.split('\\n') if len(l) > 21 and l[21] == 'B']\n        res_nums = sorted(set(int(l[22:26]) for l in chain_b if l[22:26].strip().isdigit()))\n        print(f\"{label}: cluster={best_cl} res_B={res_nums} model={os.path.basename(model_path)}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-10T16:01:37.262375Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_all40\n\npython3 << 'PYEOF'\nimport glob\n\nfiles = sorted(glob.glob('*.sdf'))\nfiles = [f for f in files if f not in ('all_40.sdf', 'docked_all40_asn90.sdf', 'xtbtopo.sdf', 'docked_all40_asn90_flex5.sdf')]\n\n# Split into 4 batches of 10\nfor batch_idx in range(4):\n    batch = files[batch_idx*10:(batch_idx+1)*10]\n    with open(f'batch_{batch_idx+1}.sdf', 'w') as out:\n        for f in batch:\n            with open(f) as fh:\n                c = fh.read().strip()\n            out.write(c)\n            if not c.endswith('$$$$'):\n                out.write('\\n$$$$')\n            out.write('\\n')\n    print(f'Batch {batch_idx+1}: {len(batch)} molecules -> batch_{batch_idx+1}.sdf')\n\nprint('\\nNow submit 4 jobs or run sequentially')\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-10T16:01:37.311836Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":49,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-10T16:02:41.630637Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport json, math\nfrom collections import defaultdict\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\ndef best_pose(sdf_path):\n    try:\n        with open(sdf_path) as f:\n            content = f.read()\n    except: return None\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        cnn_score = cnn_aff = emp_aff = 0; na = 0\n        for j, l in enumerate(lines):\n            if 'V2000' in l: na = int(l.split()[0])\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, cnn_score, cnn_aff)\n    return best\n\n# Also parse rigid and flex5 for comparison\nmodes = {\n    'rigid': 'docked_{lig}_asn90.sdf',\n    'flex5': 'docked_flex5_{lig}_asn90.sdf',\n    'flex8': 'docked_flex8_{lig}_asn90.sdf',\n}\n\nligands = ['Z11-16-Ald','Z11-16-Ac','Z11-16-OH','C8-Ald','C12-Ald',\n           'Cedrol','\u03b2-Ionone','Citral','Palmitic_acid']\n\n# Also get unrestrained gnina scores from the original docked.sdf.gz\nimport gzip\ndef best_unrestrained(lig_heavies):\n    with gzip.open('../2026-06-09_docking_5NGH/docked.sdf.gz','rt') as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        na = 0\n        for j, l in enumerate(lines):\n            if 'V2000' in l: na = int(l.split()[0])\n        if na != lig_heavies: continue\n        cnn_score = cnn_aff = emp_aff = 0\n        for j, l in enumerate(lines):\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if best is None or cnn_score > best[0]:\n            best = (cnn_score, cnn_aff, emp_aff)\n    return best\n\nheavy_map = {\n    'Z11-16-Ald': 17,'Z11-16-Ac': 20,'Z11-16-OH': 17,'C8-Ald': 9,\n    'C12-Ald': 13,'Cedrol': 16,'\u03b2-Ionone': 14,'Citral': 11,'Palmitic_acid': 18,\n}\n\nprint(\"Gnina Asn90-box docking \u2014 Z11 variants + key ligands\")\nprint(f\"{'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'Unrestr':>8s} {'Rigid':>7s} {'Flex5':>7s} {'Flex8':>7s} {'Paper':s}\")\nprint(\"-\" * 90)\n\nrows = []\nfor lig in ligands:\n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    kd = c.get('kd_obp3', 'N/A')\n    \n    unr = best_unrestrained(heavy_map[lig])\n    rigid = best_pose(modes['rigid'].format(lig=lig))\n    flex5 = best_pose(modes['flex5'].format(lig=lig))\n    flex8 = best_pose(modes['flex8'].format(lig=lig))\n    \n    unr_str = f'{unr[1]:.1f}' if unr else 'N/A'\n    r_str = f'{rigid[0]:.1f}' if rigid else 'N/A'\n    f5_str = f'{flex5[0]:.1f}' if flex5 else 'N/A'\n    f8_str = f'{flex8[0]:.1f}' if flex8 else 'N/A'\n    \n    # Paper classification\n    if isinstance(ic50, (int,float)):\n        if ic50 < 10: paper = '\u2713 binder'\n        else: paper = '\u2717 non-binder'\n    else:\n        paper = '?'\n    \n    print(f\"{lig:16s} {str(ic50):>7s} {str(kd):>7s} {unr_str:>8s} {r_str:>7s} {f5_str:>7s} {f8_str:>7s} {paper}\")\n    \n    if flex8:\n        rows.append((lig, ic50, flex8[0], flex8[1], flex8[2]))\n\n# Spearman for flex8\nfrom scipy.stats import spearmanr\nnumeric = [(r[1], r[2]) for r in rows if isinstance(r[1], (int,float))]\nrho, p = spearmanr([n[0] for n in numeric], [n[1] for n in numeric])\nprint(f\"\\nFlex8 Spearman \u03c1(IC50 vs EmpAff) = {rho:+.3f} (p={p:.3f}, n={len(numeric)})\")\n\n# Also add HADDOCK3 scores \nprint(f\"\\nHADDOCK3 comparison:\")\nh3 = {'Z11-16-Ald':-42.0,'Z11-16-Ac':-47.6,'Z11-16-OH':'N/A','C8-Ald':-30.5,\n      'C12-Ald':-34.2,'Cedrol':-41.3,'\u03b2-Ionone':-31.3,'Citral':-25.7,'Palmitic_acid':-49.9}\nfor lig in ligands:\n    h3s = h3.get(lig, 'N/A')\n    h3_str = f'{h3s:.1f}' if isinstance(h3s, float) else str(h3s)\n    f8 = best_pose(modes['flex8'].format(lig=lig))\n    f8_str = f'{f8[0]:.1f}' if f8 else 'N/A'\n    c = compounds.get(lig, {})\n    print(f\"  {lig:16s}  H3={h3_str:>6s}  Gnina_flex8={f8_str:>5s}  IC50={c.get('ic50_obp3','?')}\")\n\nPYEOF"}

(atom_start, min(atom_start+na, len(lines))):\n            l = lines[i]\n            if len(l) > 31:\n                elem = l[31:34].strip()\n                if elem == 'O': n_o += 1\n    \n    exp_str = f\"{exp['atoms']} atoms, {exp['O']} O\"\n    found_str = f\"{na} atoms, {n_o} O\"\n    match = '\u2713' if (na == exp['atoms'] and n_o == exp['O']) else '\u2717 MISMATCH'\n    \n    print(f\"{fname:35s} {exp_str:>20s} {found_str:>15s} {match:>7s}\")\n\nPYEOF"}

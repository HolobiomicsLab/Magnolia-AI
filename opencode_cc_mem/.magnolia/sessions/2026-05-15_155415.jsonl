{"event_type":"tool_call","timestamp":"2026-06-24T13:47:08.119839Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\necho \"=== AF3 scores for long peptides (find any capri_clt.tsv, take best cluster) ===\"\npython3 - <<'PY'\nimport glob,json,os\nruns=[\"af3_KFERQ-KILDQ-fusion_s10000_full\",\"af3_KFERQx2_s10000_full\",\"af3_RKELQx2_s10000_full\",\n      \"af3_QRKELx2_s10000_full\",\"af3_RKDLQ-variant_s10000_full\",\"af3_TGGFQMALT_s10000_full\"]\nfor r in runs:\n    ts=sorted(glob.glob(f\"{r}/output/**/capri_clt.tsv\",recursive=True))\n    # pick the highest-numbered caprieval_analysis\n    ts=[t for t in ts if 'caprieval_analysis' in t]\n    if not ts:\n        print(f\"{r:42s} (no capri_clt.tsv in *caprieval_analysis*)\"); continue\n    f=ts[-1]\n    # weights in sibling ../*caprieval dir\n    wdir=f.split('/analysis/')[0]\n    wp=glob.glob(f\"{wdir}/*/weights_params.json\")\n    wair=0.1\n    if wp:\n        try: wair=json.load(open(wp[0])).get('w_air',0.1)\n        except: pass\n    rows=[];idx={}\n    for line in open(f):\n        if line.startswith('#') or not line.strip(): continue\n        if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n        rows.append(line.rstrip().split('\\t'))\n    def g(rw,c): return rw[idx[c]]\n    rw=rows[0]\n    af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"{r:42s} AIR-free={af:8.2f}  DockQ={float(g(rw,'dockq')):.3f}  n={g(rw,'n')}  ({os.path.basename(os.path.dirname(f))})\")\nPY"}

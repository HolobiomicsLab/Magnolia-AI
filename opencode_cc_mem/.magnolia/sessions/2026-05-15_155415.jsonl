{"event_type":"tool_call","timestamp":"2026-07-01T07:31:34.450621Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\nruns = [\n    (\"EGGFQMAKT (L8\u2192K)\", \"EGGFQMAKT_s10000\", 8),\n    (\"EGGFQMART (L8\u2192R)\", \"EGGFQMART_s10000\", 8),\n    (\"EAKFQMALT (G3\u2192K)\", \"EAKFQMALT_s10000\", 3),\n    (\"EAGFQMRLT (A7\u2192R)\", \"EAGFQMRLT_s10000\", 7),\n    (\"EAGFQMKLT (A7\u2192K)\", \"EAGFQMKLT_s10000\", 7),\n]\n\nfor label, run_dir, mut_pos in runs:\n    d = f\"projects/hsc70_new/runs/2026-06-25_{run_dir}\"\n    \n    # Find best cluster\n    best_cl = None\n    cl_tsv = f\"{d}/output/10_clustfcc/clustfcc.tsv\"\n    if os.path.exists(cl_tsv):\n        with open(cl_tsv) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        for row in reader:\n            best_cl = row.get('cluster_id', '1')\n            break\n    \n    # Get contacts\n    fpath = f\"{d}/output/13_contactmap/cluster{best_cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        for cl in [1,2,3,4,5]:\n            alt = f\"{d}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n            if os.path.exists(alt):\n                fpath = alt\n                best_cl = cl\n                break\n    \n    if not os.path.exists(fpath):\n        print(f\"{label}: NO contacts\")\n        continue\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Parse: res1 = \"A-404-GLU\", res2 = \"B-6-GLN\"\n    contacts_per_pep = {}\n    mut_contacts = []\n    \n    for row in reader:\n        res1 = row.get('res1','')  # receptor: A-NUM-RES\n        res2 = row.get('res2','')  # peptide: B-NUM-RES\n        dist = float(row.get('shortest-dist', 999))\n        ct = row.get('contact-type', '')\n        \n        # Parse peptide residue\n        m = re.match(r'B-(\\d+)-(\\w+)', res2)\n        if not m:\n            continue\n        pep_num = int(m.group(1))\n        pep_res = m.group(2)\n        \n        # Parse receptor\n        m2 = re.match(r'A-(\\d+)-(\\w+)', res1)\n        if not m2:\n            continue\n        rec_num = int(m2.group(1))\n        rec_res = m2.group(2)\n        \n        key = (pep_num, pep_res)\n        if key not in contacts_per_pep:\n            contacts_per_pep[key] = []\n        contacts_per_pep[key].append((dist, rec_num, rec_res, ct))\n        \n        if pep_num == mut_pos:\n            mut_contacts.append((dist, rec_num, rec_res, ct))\n    \n    mut_contacts.sort()\n    \n    print(f\"\\n=== {label} (cluster {best_cl}) ===\")\n    print(f\"  Mutated position {mut_pos}: {len(mut_contacts)} receptor contacts\")\n    for dist, rnum, rres, ct in mut_contacts[:8]:\n        print(f\"    {rres}{rnum} at {dist:.2f}A ({ct})\")\n    \n    # Check for acidic targets\n    acidic_targets = [(404, 'GLU'), (460, 'GLU'), (433, 'ASP')]\n    found = [(dist, rnum, rres) for dist, rnum, rres, ct in mut_contacts \n             if (rnum, rres) in acidic_targets]\n    if found:\n        for dist, rnum, rres in found:\n            print(f\"  *** HIT: {rres}{rnum} at {dist:.2f}A (target acidic)\")\n    else:\n        print(f\"  No acidic target contacts for position {mut_pos}\")\n    \n    # Also show all peptide->receptor contacts summary\n    print(f\"  All peptide contacts (top 2 per residue):\")\n    for (pn, pr), clist in sorted(contacts_per_pep.items()):\n        clist.sort()\n        top = \", \".join(f\"{rr}{rn}({d:.1f})\" for d, rn, rr, ct in clist[:2])\n        marker = \" <<< MUT\" if pn == mut_pos else \"\"\n        print(f\"    B-{pr}{pn}: {top}{marker}\")\nPYEOF"}

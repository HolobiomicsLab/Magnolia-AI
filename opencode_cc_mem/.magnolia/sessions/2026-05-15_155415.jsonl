{"event_type":"tool_call","timestamp":"2026-07-01T16:24:14.980678Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_all_clusters(run_dir):\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{run_dir}/output/{sfx}/capri_ss.tsv\"\n        if not os.path.exists(ss): continue\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','')\n            if not cid.isdigit(): continue\n            cid = int(cid)\n            score = float(row['score']); air = float(row.get('air',0))\n            af = score - 0.1*air\n            if cid not in clusters or af < clusters[cid]['af']:\n                clusters[cid] = {\n                    'af': af, 'dq': float(row.get('dockq',0)),\n                    'irmsd': float(row.get('irmsd',0)), 'lrmsd': float(row.get('lrmsd',0)),\n                    'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n                    'bsa': float(row.get('bsa',0)), 'fnat': float(row.get('fnat',0)),\n                }\n        sizes = {}\n        clf = f\"{run_dir}/output/10_clustfcc/clustfcc.txt\"\n        with open(clf) as f:\n            for line in f:\n                m = re.search(r'Cluster (\\d+) \\(#(\\d+), n=(\\d+), top4_avg_score = ([-\\d.]+)', line)\n                if m:\n                    sizes[int(m.group(1))] = (int(m.group(2)), int(m.group(3)), float(m.group(4)))\n        return clusters, sizes\n    return {}, {}\n\n# All three new peptides + parents\nruns = [\n    (\"EKGFQMAKT (G\u2082\u2192K + L\u2088\u2192K, double)\", \"projects/hsc70_new/runs/2026-07-01_EKGFQMAKT_G2K_on_EGGFQMAKT_s10000\"),\n    (\"EKGFQMALT (G\u2082\u2192K, single)\",        \"projects/hsc70_new/runs/2026-07-01_EKGFQMALT_G2K_on_EGGFQMALT_s10000\"),\n    (\"ERQKFERRQ (truncated KFERQx2)\",    \"projects/hsc70_new/runs/2026-07-01_ERQKFERRQ_truncated_KFERQx2_s10000\"),\n    (\"EGGFQMAKT (L\u2088\u2192K, parent)\",         \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\"),\n    (\"EGGFQMALT (parent)\",               \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\"),\n]\n\nfor label, d in runs:\n    clusters, sizes = get_all_clusters(d)\n    if not clusters:\n        print(f\"\\n{label}: no cluster data\")\n        continue\n    print(f\"\\n=== {label} ===\")\n    print(f\"  {'Cl':>3s} {'rank':>4s} {'n':>5s} {'%200':>6s} {'AIR-free':>9s} {'DockQ':>7s} {'irmsd':>6s} {'lrmsd':>6s} {'vdw':>8s} {'elec':>8s}\")\n    for cid in sorted(clusters.keys()):\n        c = clusters[cid]\n        rank, n, avg = sizes.get(cid, (0,0,0))\n        pct = 100.0 * n / 200\n        print(f\"  {cid:>3d} {rank:>4d} {n:>5d} {pct:>5.1f}% {c['af']:>+9.2f} {c['dq']:>7.3f} {c['irmsd']:>6.2f} {c['lrmsd']:>6.1f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f}\")\nPYEOF"}

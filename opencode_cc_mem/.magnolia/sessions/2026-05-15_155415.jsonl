{"event_type":"tool_call","timestamp":"2026-06-11T20:28:49.069554Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/envs/ambertools/bin/python3 << 'PYEOF'\nimport numpy as np\n\n# Load all atoms from the PDB\ndef load_atoms(pdb_file, chain_filter=None):\n    atoms = []\n    with open(pdb_file) as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            ch = line[21]\n            if chain_filter and ch not in chain_filter: continue\n            rnum = int(line[22:26])\n            rname = line[17:20].strip()\n            aname = line[12:16].strip()\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            atoms.append({'chain': ch, 'res': rnum, 'rname': rname, 'atom': aname, 'xyz': np.array([x,y,z])})\n    return atoms\n\npdb = '/tmp/contact_analysis/KFERQx2_cl1_m1.pdb'\nall_a = load_atoms(pdb, chain_filter={'A','B'})\n\n# Middle peptide residues: B-651 (Q5) through B-655 (R9)\n# Also check B-652 (K6) \u2014 the dead residue\npeptide_middle = [a for a in all_a if a['chain'] == 'B' and 651 <= a['res'] <= 655]\nreceptor_atoms = [a for a in all_a if a['chain'] == 'A']\n\n# For each middle peptide residue, find all receptor residues within 8 \u00c5\nfrom collections import defaultdict\n\nfor p_res in [651, 652, 653, 654, 655]:\n    p_atoms = [a for a in peptide_middle if a['res'] == p_res]\n    if not p_atoms: continue\n    p_center = np.mean([a['xyz'] for a in p_atoms], axis=0)\n    \n    # Find closest receptor residues\n    rec_distances = defaultdict(list)\n    for a in receptor_atoms:\n        d = np.linalg.norm(p_center - a['xyz'])\n        rec_distances[a['res']].append(d)\n    \n    close = [(r, min(ds)) for r, ds in rec_distances.items() if min(ds) < 12.0]\n    close.sort(key=lambda x: x[1])\n    \n    p_name = {651:'Q5',652:'K6',653:'F7',654:'E8',655:'R9'}[p_res]\n    print(f\"B-{p_res} ({p_name}): closest receptor residues within 12 A:\")\n    for rnum, dist in close[:10]:\n        rname = next((a['rname'] for a in receptor_atoms if a['res'] == rnum), '?')\n        print(f\"  A-{rnum:>4} {rname:<4}  {dist:.1f} A\")\n    print()\nPYEOF"}

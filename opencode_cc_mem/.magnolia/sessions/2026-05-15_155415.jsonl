{"event_type":"tool_call","timestamp":"2026-06-16T09:47:37.295869Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\n# Generate extended-chain HAMNG peptide: HIS-ALA-MET-ASN-GLY\n# Standard CA-CA distance ~3.8\u00c5, build along x-axis\n# Chain B, starting residue 701\n\nimport math\n\n# Standard backbone atom names for each residue type\n# We'll build a simple all-atom model with approximate geometry\n\nATOM_LINE = \"ATOM  {:5d}  {:<3s} {:<3s} {:1s}{:4d}    {:8.3f}{:8.3f}{:8.3f}  1.00  0.00           {:>2s}  \\n\"\n\n# Approximate backbone internal coordinates (simplified)\n# N-CA-C-N loop with ~3.8\u00c5 CA-CA spacing, build along x-axis\n# For a simple linear peptide we'll use approximate coordinates\n\nresidues = [\n    (\"HIS\", [(\"N\", -0.46, 0.00, 0.00), (\"CA\", 0.00, 0.00, 0.00), (\"C\", 1.52, 0.00, 0.00), (\"O\", 2.10, -0.80, 0.00),\n             (\"CB\", -0.70, -1.10, 0.00), (\"CG\", -0.10, -2.20, 0.00), (\"ND1\", -0.80, -3.30, 0.00),\n             (\"CD2\", 1.10, -2.40, 0.00), (\"CE1\", 0.00, -4.10, 0.00), (\"NE2\", 1.20, -3.60, 0.00)]),\n    (\"ALA\", [(\"N\", -0.44, 0.00, 0.00), (\"CA\", 0.00, 0.00, 0.00), (\"C\", 1.52, 0.00, 0.00), (\"O\", 2.10, -0.80, 0.00),\n             (\"CB\", -0.70, -1.10, 0.00)]),\n    (\"MET\", [(\"N\", -0.46, 0.00, 0.00), (\"CA\", 0.00, 0.00, 0.00), (\"C\", 1.52, 0.00, 0.00), (\"O\", 2.10, -0.80, 0.00),\n             (\"CB\", -0.70, -1.10, 0.00), (\"CG\", -0.10, -2.50, 0.00), (\"SD\", -1.00, -3.90, 0.00),\n             (\"CE\", 0.30, -5.10, 0.00)]),\n    (\"ASN\", [(\"N\", -0.46, 0.00, 0.00), (\"CA\", 0.00, 0.00, 0.00), (\"C\", 1.52, 0.00, 0.00), (\"O\", 2.10, -0.80, 0.00),\n             (\"CB\", -0.70, -1.10, 0.00), (\"CG\", -0.10, -2.30, 0.00), (\"OD1\", -1.10, -2.90, 0.00),\n             (\"ND2\", 0.80, -2.80, 0.00)]),\n    (\"GLY\", [(\"N\", -0.46, 0.00, 0.00), (\"CA\", 0.00, 0.00, 0.00), (\"C\", 1.52, 0.00, 0.00), (\"O\", 2.10, -0.80, 0.00)]),\n]\n\n# Spacing: each residue shifted by 3.8\u00c5 along x\nspacing = 3.8\n\noutpath = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/raw_input/peptides/5mers/HAMNG.pdb\"\n\nwith open(outpath, 'w') as f:\n    f.write(\"REMARK   Generated linear 5-mer peptide for HADDOCK3\\n\")\n    f.write(\"REMARK   HIS-ALA-MET-ASN-GLY (HAMNG)\\n\")\n    \n    atom_num = 1\n    for i, (resname, atoms) in enumerate(residues):\n        resi = 701 + i\n        for aname, x, y, z in atoms:\n            f.write(ATOM_LINE.format(atom_num, aname, resname, \"B\", resi,\n                                    x + i * spacing, y, z, aname[0] if len(aname) <= 1 else aname[0:2]))\n            atom_num += 1\n    \n    f.write(\"END\\n\")\n\n# Verify\nprint(\"Generated HAMNG.pdb\")\nimport os\nprint(f\"Size: {os.path.getsize(outpath)} bytes\")\n\n# Show residues\nwith open(outpath) as f:\n    for line in f:\n        if line.startswith(\"ATOM\") and \"CA\" in line:\n            print(line.rstrip())\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-11T09:26:15.445070Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nprint(f'{'Peptide':<30} {'Sampling':>8} {'Score':>10} {'DockQ':>7} {'iRMSD':>7} {'BSA':>8} {'AIR':>8}  Run')\nprint('-' * 110)\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 20:\n                continue\n            # cluster_rank, cluster_id, n, under_eval, score, score_std, irmsd, irmsd_std, fnat, fnat_std, lrmsd, lrmsd_std, dockq, dockq_std, ilrmsd, ilrmsd_std, rmsd, rmsd_std, air, air_std, bsa, bsa_std, desolv, desolv_std, elec, elec_std, total, total_std, vdw, vdw_std, caprieval_rank\n            rank = parts[0]\n            n = parts[2]\n            score = parts[4]\n            dockq = parts[12]\n            irmsd = parts[6]\n            bsa = parts[20]\n            air = parts[18]\n            print(f'{d:<30} {rank:>8} {score:>10} {dockq:>7} {irmsd:>7} {bsa:>8} {air:>8}')\n            if rank == '1':\n                break\n\""}

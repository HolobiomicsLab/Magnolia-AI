{"event_type":"tool_call","timestamp":"2026-06-17T20:07:06.237736Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport sys, os\nfrom collections import defaultdict\n\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\npeptides = {\n    \"RKDLQ\":  f\"{ROOT}/2026-06-16_af3_RKDLQ_s5000_full/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKALQ\":  f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKGLQ\":  f\"{ROOT}/2026-06-17_RKGLQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKNLQ\":  f\"{ROOT}/2026-06-17_RKNLQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"TGFMALQ\": f\"{ROOT}/2026-06-17_TGFMALQ_s10000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n}\n\nscores = {\n    \"RKDLQ\":   -74.85,\n    \"RKALQ\":   -79.15,\n    \"RKGLQ\":   -74.98,\n    \"RKNLQ\":   -71.96,\n    \"TGFMALQ\": -87.68,\n}\n\nconvergence = {\n    \"RKDLQ\":   (28, 14.0),\n    \"RKALQ\":   (143, 71.5),\n    \"RKGLQ\":   (184, 92.0),\n    \"RKNLQ\":   (192, 96.0),\n    \"TGFMALQ\": (79, 39.5),\n}\n\nseqlen = {\"RKDLQ\":5, \"RKALQ\":5, \"RKGLQ\":5, \"RKNLQ\":5, \"TGFMALQ\":7}\n\n# Parse all contact maps\nall_contacts = {}\nfor name, path in peptides.items():\n    contacts = []\n    if not os.path.isfile(path):\n        print(f\"MISSING: {name} -> {path}\", file=sys.stderr)\n        all_contacts[name] = contacts\n        continue\n    with open(path) as f:\n        for line in f:\n            if line.startswith(\"#\") or line.startswith(\"res1\"):\n                continue\n            parts = line.strip().split(\"\\t\")\n            if len(parts) < 8:\n                continue\n            rec = parts[0].strip()   # e.g., A-404-GLU\n            pep = parts[1].strip()   # e.g., B-4-LEU\n            prob = float(parts[6])\n            dist = float(parts[7])\n            ctype = parts[4].strip()\n            contacts.append({\"rec\": rec, \"pep\": pep, \"prob\": prob, \"dist\": dist, \"type\": ctype})\n    all_contacts[name] = contacts\n\n# ============================================================\n# TABLE 1: Per-residue contact summary \u2014 which peptide residues\n#          contact which receptor residues (shortest-dist < 5.0)\n# ============================================================\n\nprint(\"=\" * 110)\nprint(\"TABLE 1: PEPTIDE-LEVEL CONTACT DENSITY (cluster 1, all models)\")\nprint(\"=\" * 110)\n\nnames = [\"RKDLQ\", \"RKALQ\", \"RKGLQ\", \"RKNLQ\", \"TGFMALQ\"]\n\n# Header\nheader = f\"{'Peptide':>10s} {'Seq':>8s}  c1_n  c1%    AIR-free  DockQ  {'Contacts':>8s}  {'per_res':>7s}\"\nprint(header)\nprint(\"-\" * 110)\n\nfor name in names:\n    contacts = all_contacts[name]\n    n_contacts = len(contacts)\n    n_c1, pct = convergence[name]\n    per_res = n_contacts / seqlen[name]\n    air = scores[name]\n    # Count unique receptor residues contacted\n    unique_rec = set(c[\"rec\"] for c in contacts)\n    unique_pep = set(c[\"pep\"] for c in contacts)\n    \n    print(f\"{name:>10s} {name:>8s}  {n_c1:4d}  {pct:4.1f}%  {air:8.2f}   \u2014    {n_contacts:8d}  {per_res:7.1f}\")\n\nprint()\n\n# ============================================================\n# TABLE 2: Receptor residue contact matrix\n# ============================================================\n\nprint(\"=\" * 110)\nprint(\"TABLE 2: RECEPTOR CONTACT MATRIX (shortest-dist \u2264 5.0 \u00c5, probability \u2265 0.5)\")\nprint(\"=\" * 110)\n\n# Collect all receptor residues across all peptides\nall_rec_res = set()\nfor name in names:\n    for c in all_contacts[name]:\n        if c[\"prob\"] >= 0.5 and c[\"dist\"] <= 5.0:\n            all_rec_res.add(c[\"rec\"])\n\nsorted_rec = sorted(all_rec_res, key=lambda x: (int(x.split(\"-\")[1])))\n\n# Build matrix: for each receptor residue, which peptide residues contact it\nprint(f\"{'Receptor':>10s}  \", end=\"\")\nfor name in names:\n    print(f\"{name:>30s}\", end=\"  \")\nprint()\nprint(\"-\" * 110)\n\nfor rec in sorted_rec:\n    print(f\"{rec:>10s}  \", end=\"\")\n    for name in names:\n        hits = []\n        for c in all_contacts[name]:\n            if c[\"rec\"] == rec and c[\"prob\"] >= 0.5 and c[\"dist\"] <= 5.0:\n                pep_res = c[\"pep\"].split(\"-\")[2]\n                hits.append(f\"{pep_res}_{c['pep'].split('-')[1]}({c['dist']:.0f}\u00c5)\")\n        \n        cell = \" \".join(hits) if hits else \"\u2014\"\n        print(f\"{cell:>30s}\", end=\"  \")\n    print()\n\nprint()\n\n# ============================================================\n# TABLE 3: L4 (hydrophobic anchor) contact comparison\n# ============================================================\n\nprint(\"=\" * 110)\nprint(\"TABLE 3: L4 (HYDROPHOBIC ANCHOR) \u2014 contact probability to key pocket residues\")\nprint(\"=\" * 110)\n\nkey_pocket = [\n    \"A-403-ILE\", \"A-404-GLU\", \"A-405-THR\", \"A-406-ALA\",\n    \"A-428-PHE\", \"A-429-THR\", \"A-430-THR\", \"A-431-TYR\",\n    \"A-438-VAL\", \"A-439-LEU\", \"A-440-ILE\"\n]\n\nprint(f\"{'Receptor':>12s}  \", end=\"\")\nfor name in names:\n    print(f\"{name:>8s}\", end=\"  \")\nprint()\nprint(\"-\" * 110)\n\nfor rec in key_pocket:\n    print(f\"{rec:>12s}  \", end=\"\")\n    for name in names:\n        found = False\n        for c in all_contacts[name]:\n            p = c[\"pep\"]\n            if c[\"rec\"] == rec and \"LEU\" in p and (\"B-4\" in p or (name == \"TGFMALQ\" and \"B-6\" in p)):\n                print(f\"  {c['prob']:.2f}   \", end=\"\")\n                found = True\n                break\n        if not found:\n            # Check any L contact\n            for c in all_contacts[name]:\n                p = c[\"pep\"]\n                if c[\"rec\"] == rec and \"LEU\" in p:\n                    print(f\"  {c['prob']:.2f}*  \", end=\"\")\n                    found = True\n                    break\n        if not found:\n            print(f\"   \u2014    \", end=\"\")\n    print()\n\nprint()\nprint(\"* L from different position\")\n\n# ============================================================\n# TABLE 4: D3/A3/G3/N3 (mutated position) contact comparison\n# ============================================================\n\nprint(\"=\" * 110)\nprint(\"TABLE 4: POSITION-3 (ASP\u2192ALA/GLY/ASN) \u2014 gain/loss of contacts\")\nprint(\"=\" * 110)\n\n# For RKDLQ: D3, RKALQ: A3, RKGLQ: G3, RKNLQ: N3, TGFMALQ: F3\npos3 = {\"RKDLQ\": \"B-3-ASP\", \"RKALQ\": \"B-3-ALA\", \"RKGLQ\": \"B-3-GLY\", \"RKNLQ\": \"B-3-ASN\"}\n\nfor name in [\"RKDLQ\", \"RKALQ\", \"RKGLQ\", \"RKNLQ\"]:\n    p3 = pos3[name]\n    print(f\"\\n{name} ({p3.split('-')[2]}):\")\n    has_any = False\n    for c in all_contacts[name]:\n        if c[\"pep\"] == p3 and c[\"prob\"] >= 0.5:\n            print(f\"  \u2192 {c['rec']} ({c['type']}): prob={c['prob']:.2f}, dist={c['dist']:.1f} \u00c5\")\n            has_any = True\n    if not has_any:\n        print(f\"  \u2192 NO strong contacts (all prob < 0.5)\")\n\n# ============================================================\n# TABLE 5: Q5 C-terminal extension toward lid\n# ============================================================\n\nprint()\nprint(\"=\" * 110)\nprint(\"TABLE 5: C-TERMINAL GLN (Q5) \u2014 lid contacts\")\nprint(\"=\" * 110)\n\nq5_pos = {\"RKDLQ\": \"B-5-GLN\", \"RKALQ\": \"B-5-GLN\", \"RKGLQ\": \"B-5-GLN\", \"RKNLQ\": \"B-5-GLN\"}\n\nlid_res = [\"A-540-ASN\", \"A-541-SER\", \"A-543-GLU\", \"A-544-SER\", \"A-578-ILE\", \"A-581-LEU\", \"A-582-ASP\", \"A-585-GLN\"]\n\nprint(f\"{'Lid residue':>12s}  \", end=\"\")\nfor name in [\"RKDLQ\", \"RKALQ\", \"RKGLQ\", \"RKNLQ\"]:\n    print(f\"{name:>12s}\", end=\"  \")\nprint()\nprint(\"-\" * 110)\n\nfor lr in lid_res:\n    print(f\"{lr:>12s}  \", end=\"\")\n    for name in [\"RKDLQ\", \"RKALQ\", \"RKGLQ\", \"RKNLQ\"]:\n        found = \"\"\n        for c in all_contacts[name]:\n            if c[\"rec\"] == lr and c[\"pep\"] == q5_pos[name]:\n                found = f\"{c['prob']:.2f}/{c['dist']:.0f}\u00c5\"\n                break\n        if not found:\n            found = \"\u2014\"\n        print(f\"{found:>12s}\", end=\"  \")\n    print()\n\nprint()\n\n# ============================================================\n# TABLE 6: N-terminal ARG1 contacts\n# ============================================================\nprint(\"=\" * 110)\nprint(\"TABLE 6: N-TERMINAL R1/K1/T1 \u2014 contacts\")\nprint(\"=\" * 110)\n\nr1_pos = {\"RKDLQ\":\"B-1-ARG\",\"RKALQ\":\"B-1-ARG\",\"RKGLQ\":\"B-1-ARG\",\"RKNLQ\":\"B-1-ARG\",\"TGFMALQ\":\"B-1-THR\"}\n\nfor name in names:\n    p1 = r1_pos[name]\n    strong = [c for c in all_contacts[name] if c[\"pep\"] == p1 and c[\"prob\"] >= 0.5]\n    weak = [c for c in all_contacts[name] if c[\"pep\"] == p1 and 0.2 <= c[\"prob\"] < 0.5]\n    print(f\"\\n{name} {p1}:\")\n    if strong:\n        print(f\"  Strong (\u22650.5): \" + \" | \".join(f\"{c['rec']} {c['prob']:.2f}/{c['dist']:.0f}\u00c5\" for c in strong))\n    else:\n        print(f\"  Strong (\u22650.5): NONE\")\n    if weak:\n        print(f\"  Weak (0.2-0.5): \" + \" | \".join(f\"{c['rec']} {c['prob']:.2f}/{c['dist']:.0f}\u00c5\" for c in weak))\n\nPYEOF"}

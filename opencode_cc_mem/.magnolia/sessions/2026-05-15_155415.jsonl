d receptor contacts (both peptides touch these) ===\")\nfor rn, ri in sorted(shared_rec):\n    p5_entries = [(k[2],k[3],k[4]) for k in c5 if k[0]==rn and k[1]==ri]\n    p11_entries = [(k[2],k[3],k[4]) for k in c11 if k[0]==rn and k[1]==ri]\n    p5_str = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(p5_entries, key=lambda x: x[2]))\n    p11_str = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(p11_entries, key=lambda x: x[2]))\n    print(f\"  {rn}{ri:>4}: 5mer->{p5_str:40s} | 11mer->{p11_str}\")\n\nprint(f\"\\n=== KFERQ-only contacts ===\")\nfor rn, ri in sorted(rec5 - rec11):\n    entries = [(k[2],k[3],k[4]) for k in c5 if k[0]==rn and k[1]==ri]\n    s = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(entries, key=lambda x: x[2]))\n    print(f\"  {rn}{ri:>4}: {s}\")\n\nprint(f\"\\n=== KFERQx2-only, core-only (resi<=651) contacts ===\")\nonly11 = rec11 - rec5\nfor rn, ri in sorted(only11):\n    entries = [(k[2],k[3],k[4]) for k in c11 if k[0]==rn and k[1]==ri and k[3]<=651]\n    if entries:\n        s = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(entries, key=lambda x: x[2]))\n        print(f\"  {rn}{ri:>4}: {s}\")\n\nprint(f\"\\n=== KFERQx2 extra-residue contacts (resi>651) ===\")\nfor rn, ri in sorted(rec11):\n    entries = [(k[2],k[3],k[4]) for k in c11 if k[0]==rn and k[1]==ri and k[3]>651]\n    if entries:\n        s = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(entries, key=lambda x: x[2]))\n        print(f\"  {rn}{ri:>4}: {s}\")\n\nPYEOF"}

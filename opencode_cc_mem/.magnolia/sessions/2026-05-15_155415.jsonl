niq.sort(key=lambda r: (cat(r), r['air_free']))\n\nsections = [\n    ('Experimentalist restraints', [r for r in uniq if cat(r)==0]),\n    ('P2Rank \u2014 5-mers', [r for r in uniq if cat(r)==1]),\n    ('P2Rank \u2014 6-mers (KFERQ extensions)', [r for r in uniq if cat(r)==2]),\n    ('P2Rank \u2014 longer peptides', [r for r in uniq if cat(r)==3]),\n]\n\nfor title, group in sections:\n    print(f'\\\\n### {title}')\n    print(f\\\"{'Peptide':<24} {'Len':>3} {'Sampl':>5} {'Score':>9} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7}\\\")\n    print('-' * 78)\n    for r in group:\n        print(f\\\"{r['pep']:<24} {r['len']:>3} {r['sampling']:>5} {r['score']:>9.2f} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f}\\\")\n\""}

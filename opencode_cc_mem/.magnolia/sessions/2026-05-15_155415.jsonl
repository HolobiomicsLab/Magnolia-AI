n_aff, lig)\n    return best\n\nligands = [\n    ('Z11-16-Ald',   'good',      'docked_flex8_Z11-16-Ald_asn90.sdf'),\n    ('Z11-16-Ac',    'non-binder','docked_flex8_Z11-16-Ac_asn90.sdf'),\n    ('Z11-16-OH',    'weak',      'docked_flex8_Z11-16-OH_asn90.sdf'),\n    ('Palmitic acid','non-binder','docked_flex8_Palmitic_acid_asn90.sdf'),\n    ('Cedrol',       'good',      'docked_flex8_Cedrol_asn90.sdf'),\n    ('\u03b2-Ionone',     'good',      'docked_flex8_\u03b2-Ionone_asn90.sdf'),\n]\n\nprint(f\"{'Ligand':16s} {'class':>10s} {'aff':>6s} {'atoms':>6s} {'polar':>6s} {'contacts':>9s} {'polar_c':>8s} {'apolar_c':>9s} {'residues':>9s} {'aff/atom':>9s}\")\nprint(\"-\" * 95)\n\nfor name, cls, fname in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, _, _, lig_atoms = result\n    \n    n_atoms = len(lig_atoms)\n    n_polar_lig = sum(1 for e,_,_ in lig_atoms if e in ('O','N'))\n    \n    contacts = []\n    res_set = set()\n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                is_polar = lelem in ('O','N') or rname[0] in ('O','N')\n                contacts.append((d, is_polar))\n                res_set.add(f\"{rres}{rnum}\")\n    \n    n_contacts = len(contacts)\n    n_polar_c = sum(1 for _, p in contacts if p)\n    n_apolar_c = n_contacts - n_polar_c\n    n_res = len(res_set)\n    \n    # Average contact distance (lower = tighter packing)\n    avg_d = sum(c[0] for c in contacts) / n_contacts if n_contacts else 0\n    \n    print(f\"{name:16s} {cls:>10s} {emp_aff:>6.1f} {n_atoms:>6d} {n_polar_lig:>6d} {n_contacts:>9d} {n_polar_c:>8d} {n_apolar_c:>9d} {n_res:>9d} {emp_aff/n_atoms:>9.3f}\")\n\n# Now check: does Vina simply reward more contacts?\nprint(f\"\\n--- Correlation checks ---\")\nxs = []; ys = []; names_list = []\nfor name, cls, fname in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, _, _, lig_atoms = result\n    contacts = 0\n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0: contacts += 1\n    print(f\"  {name:16s}  {len(lig_atoms):2d} atoms \u2192 {contacts:3d} contacts \u2192 aff={emp_aff:.1f}\")\n    xs.append(contacts)\n    ys.append(emp_aff)\n    names_list.append(name)\n\n# Manual Pearson-like check\nn = len(xs)\nmx = sum(xs)/n; my = sum(ys)/n\nsx = (sum((x-mx)**2 for x in xs)/n)**0.5\nsy = (sum((y-my)**2 for y in ys)/n)**0.5\nr = sum((xs[i]-mx)*(ys[i]-my) for i in range(n)) / (n*sx*sy) if sx*sy else 0\nprint(f\"\\n  Pearson r(contacts vs affinity) = {r:.3f}\")\nprint(f\"  More contacts \u2192 more negative affinity? {'YES' if r < -0.3 else 'WEAK' if r < 0 else 'NO'}\")\n\nPYEOF"}

{"event_type":"tool_success","timestamp":"2026-06-16T09:07:17.677923Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":84,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-16T09:07:48.183659Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport sys\nsys.path.insert(0, '/home/tjiang/repos/project_magnolia/.venv/lib/python3.12/site-packages')\n\nimport numpy as np\n\ndef parse_pdb(pdb_path, chain=None, resi_range=None):\n    \"\"\"Parse CA atoms from PDB. Returns (resnames, resnums, coords).\"\"\"\n    coords = []\n    resnames = []\n    resnums = []\n    with open(pdb_path) as f:\n        for line in f:\n            if not line.startswith(\"ATOM\") and not line.startswith(\"HETATM\"):\n                continue\n            atom_name = line[12:16].strip()\n            if atom_name != \"CA\":\n                continue\n            chain_id = line[21]\n            if chain and chain_id != chain:\n                continue\n            resi = int(line[22:26].strip())\n            if resi_range and not (resi_range[0] <= resi <= resi_range[1]):\n                continue\n            x = float(line[30:38])\n            y = float(line[38:46])\n            z = float(line[46:54])\n            coords.append([x, y, z])\n            resnames.append(line[17:20].strip())\n            resnums.append(resi)\n    return resnames, resnums, np.array(coords)\n\ndef kabsch_rmsd(P, Q):\n    \"\"\"Kabsch alignment: superimpose P onto Q, return RMSD.\"\"\"\n    P = P - P.mean(axis=0)\n    Q = Q - Q.mean(axis=0)\n    C = P.T @ Q\n    V, S, Wt = np.linalg.svd(C)\n    d = np.sign(np.linalg.det(V @ Wt))\n    R = V @ np.diag([1, 1, d]) @ Wt\n    P_aligned = P @ R\n    return np.sqrt(np.mean(np.sum((P_aligned - Q)**2, axis=1)))\n\n# Load structures\naf3_path = \"raw_input/receptor/Hsc70_full_Abeta_KFERQ_like_motif_ADP.pdb\"\npo2_path = \"raw_input/receptor/4po2_chainA.pdb\"\n\n# AF3: get chain A full\naf3_resn, af3_resi, af3_coords = parse_pdb(af3_path, chain=\"A\")\nprint(f\"AF3 chain A: {len(af3_coords)} CA atoms, resi {min(af3_resi)}-{max(af3_resi)}\")\n\n# 4PO2: get chain A\npo2_resn, po2_resi, po2_coords = parse_pdb(po2_path, chain=\"A\")\nprint(f\"4PO2 chain A: {len(po2_coords)} CA atoms, resi {min(po2_resi)}-{max(po2_resi)}\")\n\n# Find overlapping residues (SBD region: 386-510 for SBD\u03b2, 510-613 for SBD\u03b1 lid)\n# 4PO2 residue numbering matches Hsp70 numbering (383-613)\n# AF3 uses 1-646 for full Hsc70\n# Let's align on SBD\u03b2 core (resi ~386-510)\nsbd_beta_range = (386, 510)\n\naf3_beta = [(n, r, c) for n, r, c in zip(af3_resn, af3_resi, af3_coords) if sbd_beta_range[0] <= r <= sbd_beta_range[1]]\npo2_beta = [(n, r, c) for n, r, c in zip(po2_resn, po2_resi, po2_coords) if sbd_beta_range[0] <= r <= sbd_beta_range[1]]\n\nprint(f\"\\nSBD\u03b2 range ({sbd_beta_range[0]}-{sbd_beta_range[1]}):\")\nprint(f\"  AF3: {len(af3_beta)} CA atoms\")\nprint(f\"  4PO2: {len(po2_beta)} CA atoms\")\n\n# Find common residues\naf3_dict = {r: (n, c) for n, r, c in af3_beta}\npo2_dict = {r: (n, c) for n, r, c in po2_beta}\ncommon_resi = sorted(set(af3_dict.keys()) & set(po2_dict.keys()))\nprint(f\"  Common residues: {len(common_resi)}\")\nprint(f\"  Range: {min(common_resi)}-{max(common_resi)}\")\n\n# Align on common SBD\u03b2 residues\naf3_align = np.array([af3_dict[r][1] for r in common_resi])\npo2_align = np.array([po2_dict[r][1] for r in common_resi])\n\nrmsd_beta = kabsch_rmsd(af3_align, po2_align)\nprint(f\"\\n  SBD\u03b2 C\u03b1 RMSD: {rmsd_beta:.2f} \u00c5\")\n\n# Now check the lid domain (resi 531-613)\nlid_range = (531, 613)\naf3_lid = [(n, r, c) for n, r, c in zip(af3_resn, af3_resi, af3_coords) if lid_range[0] <= r <= lid_range[1]]\npo2_lid = [(n, r, c) for n, r, c in zip(po2_resn, po2_resi, po2_coords) if lid_range[0] <= r <= lid_range[1]]\n\nprint(f\"\\nSBD\u03b1 lid range ({lid_range[0]}-{lid_range[1]}):\")\nprint(f\"  AF3: {len(af3_lid)} CA atoms\")\nprint(f\"  4PO2: {len(po2_lid)} CA atoms\")\n\naf3_lid_dict = {r: (n, c) for n, r, c in af3_lid}\npo2_lid_dict = {r: (n, c) for n, r, c in po2_lid}\ncommon_lid = sorted(set(af3_lid_dict.keys()) & set(po2_lid_dict.keys()))\nprint(f\"  Common residues: {len(common_lid)}\")\n\naf3_lid_align = np.array([af3_lid_dict[r][1] for r in common_lid])\npo2_lid_align = np.array([po2_lid_dict[r][1] for r in common_lid])\n\nrmsd_lid = kabsch_rmsd(af3_lid_align, po2_lid_align)\nprint(f\"  Lid C\u03b1 RMSD: {rmsd_lid:.2f} \u00c5\")\n\n# Combined RMSD\nprint(f\"\\nOverall: SBD\u03b2 + lid combined (using SBD\u03b2 alignment):\")\naf3_combined = np.array([af3_dict[r][1] for r in common_resi] + [af3_lid_dict[r][1] for r in common_lid])\npo2_combined = np.array([po2_dict[r][1] for r in common_resi] + [po2_lid_dict[r][1] for r in common_lid])\nrmsd_combined = kabsch_rmsd(af3_combined, po2_combined)\nprint(f\"  Combined C\u03b1 RMSD: {rmsd_combined:.2f} \u00c5\")\n\n# Per-residue deviation in the binding site\nprint(f\"\\nPer-residue C\u03b1 deviation (\u00c5) in SBD\u03b2 binding site residues:\")\nbinding_site = [403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473]\nfor r in binding_site:\n    if r in af3_dict and r in po2_dict:\n        d = np.linalg.norm(af3_dict[r][1] - po2_dict[r][1])\n        print(f\"  {af3_dict[r][0]}{r}: {d:.2f} \u00c5\")\n    else:\n        print(f\"  {r}: missing in one structure\")\n\nPYEOF"}

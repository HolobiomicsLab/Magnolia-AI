scores)\nprint(f\"\\nGnina (7): \u03c1(IC50 vs CNNaff) = {rg_ic50:+.3f} (p={pg_ic50:.3f})  |  \u03c1(Kd vs CNNaff) = {rg_kd:+.3f} (p={pg_kd:.3f})\")\n\n# Exclude IC50=200 saturating\nmask = [ic50 < 200 for ic50 in ic50s]\nf_ic50 = [ic50s[i] for i,m in enumerate(mask) if m]\nf_h3 = [h3_scores[i] for i,m in enumerate(mask) if m]\nrf, pf = spearmanr(f_ic50, f_h3)\nprint(f\"\\nExcluding IC50=200 (n={len(f_ic50)}): \u03c1 = {rf:+.3f} (p={pf:.3f})\")\n\n# Exclude ab-initio\nmask2 = [m != 'ab-initio' for _,_,m in our]\nr_ic50_2 = [ic50s[i] for i,m in enumerate(mask2) if m]\nr_h3_2 = [h3_scores[i] for i,m in enumerate(mask2) if m]\nr2, p2 = spearmanr(r_ic50_2, r_h3_2)\nprint(f\"Excluding ab-initio (n={len(r_ic50_2)}): \u03c1 = {r2:+.3f} (p={p2:.3f})\")\n\n# Restrained only, excluding IC50=200\nmask3 = [ic50s[i] < 200 and our[i][2] != 'ab-initio' for i in range(len(our))]\nf3_ic50 = [ic50s[i] for i,m in enumerate(mask3) if m]\nf3_h3 = [h3_scores[i] for i,m in enumerate(mask3) if m]\nr3, p3 = spearmanr(f3_ic50, f3_h3)\nprint(f\"Restrained + IC50<200 (n={len(f3_ic50)}): \u03c1 = {r3:+.3f} (p={p3:.3f})\")\nPYEOF"}

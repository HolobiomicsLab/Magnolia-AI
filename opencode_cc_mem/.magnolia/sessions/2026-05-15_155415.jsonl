xp_lk.get(name, 999)\n    aff, cnn, cnnaff = dock[i]\n    pairs.append((name, kd, aff, cnn, cnnaff))\n\n# Simple Spearman\ndef spearman(x, y):\n    n = len(x)\n    rank_x = [sorted(x).index(v) for v in x]\n    rank_y = [sorted(y).index(v) for v in y]\n    d2 = sum((rx - ry)**2 for rx, ry in zip(rank_x, rank_y))\n    return 1 - (6*d2)/(n*(n*n - 1))\n\nkd_arr = [p[1] for p in pairs]\naff_arr = [p[2] for p in pairs]\ncnn_arr = [p[3] for p in pairs]\ncnnaff_arr = [p[4] for p in pairs]\n\nprint(f\"\u2550\u2550\u2550 P2Rank BOX (n=40) \u2550\u2550\u2550\")\nprint(f\"Empirical affinity:  \u03c1={spearman(aff_arr, kd_arr):+.4f}\")\nprint(f\"CNN pose score:      \u03c1={spearman(cnn_arr, kd_arr):+.4f}\")\nprint(f\"CNN affinity:        \u03c1={spearman(cnnaff_arr, kd_arr):+.4f}\")\n\nGOOD, MOD, WEAK = [], [], []\nfor name, kd, aff, cnn, cnnaff in pairs:\n    if kd < 1.0:     GOOD.append((aff, name, kd, cnn, cnnaff))\n    elif kd < 10:    MOD.append((aff, name, kd, cnn, cnnaff))\n    else:            WEAK.append((aff, name, kd, cnn, cnnaff))\nfor b in [GOOD,MOD,WEAK]: b.sort(key=lambda x: x[0])\n\nprint(f\"\\n\u2550\u2550\u2550 BY CLASS \u2550\u2550\u2550\")\nfor label, grp in [(\"STRONG\",GOOD),(\"MODERATE\",MOD),(\"WEAK/NON\",WEAK)]:\n    affs = [g[0] for g in grp]\n    print(f\"  {label:<15s} aff = {sum(affs)/len(affs):+.2f} \u00b1 {math.sqrt(sum((a-sum(affs)/len(affs))**2 for a in affs)/len(affs)):.2f}\")\n\nprint(f\"\\n\u2550\u2550\u2550 Z11-16 SELECTIVITY \u2550\u2550\u2550\")\nfor name, kd, aff, cnn, cnnaff in pairs:\n    if 'Z11-16' in name:\n        print(f\"  {name:<15s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  CNN={cnn:.4f}\")\nPYEOF"}

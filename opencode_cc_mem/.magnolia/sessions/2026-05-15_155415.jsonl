{"event_type":"tool_call","timestamp":"2026-06-24T14:27:45.013249Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/measure3.py << 'PYEOF'\nimport numpy as np\natoms=[]\nwith open(\"/tmp/cl2m1.pdb\") as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"): continue\n        atoms.append(dict(an=line[12:16].strip(), rn=line[17:20].strip(),\n            ch=line[21], ri=int(line[22:26]),\n            xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])]),\n            el=(line[76:78].strip() if len(line)>=78 else line[12:16].strip()[0])))\ndef atom(ch,ri,an):\n    m=[a for a in atoms if a['ch']==ch and a['ri']==ri and a['an']==an]; return m[0] if m else None\ndef ra(ch,ri): return [a for a in atoms if a['ch']==ch and a['ri']==ri]\ndef d(a,b): return np.linalg.norm(a['xyz']-b['xyz'])\n\n# Proper H-bond scan: H atom (donor) to acceptor (O/N/S), <=3.5 \u00c5\nACCEPTORS=[\"O\",\"OD1\",\"OD2\",\"OE1\",\"OE2\",\"OG\",\"OG1\",\"OH\",\"OXT\",\"ND1\",\"NE2\",\"SD\",\"NZ\"]\nDONOR_H=[\"HN\",\"HH11\",\"HH12\",\"HH21\",\"HH22\",\"HE\",\"HZ1\",\"HZ2\",\"HZ3\",\"HG1\",\"HE21\",\"HE22\",\"HD21\",\"HD22\",\"HH\",\"HE2\",\"HG\",\"HH11\"]\n# Generic: every H atom on peptide + every H atom on receptor within 3.5 \u00c5 of an acceptor on the other chain\nHlabel={\"H\",\"HN\",\"HH11\",\"HH12\",\"HH21\",\"HH22\",\"HE\",\"HZ1\",\"HZ2\",\"HZ3\",\"HG1\",\"HE21\",\"HE22\",\"HD21\",\"HD22\",\"HH\",\"HE2\",\"HG\",\"HA\",\"HB1\",\"HB2\",\"HB3\",\"HG21\",\"HG22\",\"HG23\",\"HD11\",\"HD12\",\"HD13\",\"HD2\",\"HD3\",\"HE1\",\"HE2\",\"HE3\",\"HZ\",\"HZ1\",\"HZ2\",\"HZ3\",\"HG11\",\"HG12\",\"HG13\",\"HD1\",\"HD2\"}\nACCEPT_EL=set([\"O\",\"N\",\"S\"])  # acceptor atoms are O/N/S (heavy)\nprint(\"H-BONDS (donor-H ... acceptor, <=3.5 \u00c5), peptide <-> receptor\")\nprint(\"-\"*70)\nhb=[]\nfor a in atoms:\n    if a['el']!=\"H\": continue\n    # is H attached to peptide or receptor?\n    h_chain=a['ch']; h_ri=a['ri']\n    other=\"A\" if h_chain==\"B\" else \"B\"\n    for b in atoms:\n        if b['ch']!=other: continue\n        if b['el'] not in ACCEPT_EL: continue\n        dd=d(a,b)\n        if dd<=3.5:\n            hb.append((a,b,dd))\nhb.sort(key=lambda x:x[2])\ndonor_dir=[]\nfor a,b,dd in hb:\n    donor = f\"B-{a['ri']}-{a['rn']} {a['an']}\" if a['ch']==\"B\" else f\"A-{a['ri']}-{a['rn']} {a['an']}\"\n    accp  = f\"A-{b['ri']}-{b['rn']} {b['an']}\" if b['ch']==\"A\" else f\"B-{b['ri']}-{b['rn']} {b['an']}\"\n    donor_dir.append((donor,accp,dd))\n# dedupe\nseen=set(); uniq=[]\nfor donor,accp,dd in donor_dir:\n    k=(donor,accp)\n    if k in seen: continue\n    seen.add(k); uniq.append((donor,accp,dd))\nfor donor,accp,dd in uniq:\n    print(f\"  {donor:28s} -> {accp:28s}  {dd:.2f} \u00c5\")\n\nprint(\"\\nSALT BRIDGES: peptide has no charged sidechain; check receptor-cation .. peptide-Cterm/ACE\")\nprint(\"-\"*70)\n# ACE cap O and T9 OXT/O\nfor ri in [1,2,10]:\n    for an in [\"O\",\"OXT\"]:\n        a=atom(\"B\",ri,an)\n        if a is None: continue\n        for rri,rn in [(469,\"ARG\"),(447,\"ARG\"),(533,\"ARG\"),(415,\"LYS\"),(416,\"ARG\"),(458,\"LYS\")]:\n            cation_an = \"NZ\" if rn==\"LYS\" else [\"NH1\",\"NH2\",\"CZ\",\"NE\"]\n            if isinstance(cation_an,str): cation_an=[cation_an]\n            for can in cation_an:\n                b=atom(\"A\",rri,can)\n                if b:\n                    dd=d(a,b)\n                    if dd<=5.0: print(f\"  B-{ri}-{an} ... A-{rri}-{rn} {can}: {dd:.2f} \u00c5 {'SALT-BRIDGE' if dd<=4.0 else ''}\")\nprint(\"\\nHYDROPHOBIC CLUSTER: L8 sidechain heavy atoms within 4.5 \u00c5 of receptor apolar\")\nprint(\"-\"*70)\nfor pan in [\"CB\",\"CG\",\"CD1\",\"CD2\"]:\n    a=atom(\"B\",9,pan)\n    if a is None: continue\n    for ri in list(range(388,647)):\n        for b in ra(\"A\",ri):\n            if b['el'] in (\"C\",\"S\"):\n                dd=d(a,b)\n                if dd<=4.2 and b['an'] not in (\"CA\",):  # skip CA backbone for clarity\n                    if b['an'].startswith((\"CB\",\"CG\",\"CD\",\"CE\",\"CZ\",\"SD\",\"OG2\")) or b['an'] in (\"SD\",):\n                        pass\n    # just print closest 6 apolar\n    cands=[]\n    for ri in list(range(388,647)):\n        for b in ra(\"A\",ri):\n            if b['el'] in (\"C\",\"S\") and dd<=4.5: cands.append((ri,b['rn'],b['an'],d(a,b)))\n    cands=[(ri,rn,an,dd) for ri,rn,an,dd in cands]\n    cands.sort(key=lambda x:x[3])\nprint(\"  L8 (LEU) apolar contact summary (all sidechain heavy <=4.5 \u00c5):\")\na_atoms=[atom(\"B\",9,x) for x in [\"CB\",\"CG\",\"CD1\",\"CD2\"] if atom(\"B\",9,x)]\nallc=[]\nfor ri in list(range(388,647)):\n    for b in ra(\"A\",ri):\n        if b['el'] in (\"C\",\"S\"):\n            mind=min((d(a,b) for a in a_atoms), default=99)\n            if mind<=4.5: allc.append((ri,b['rn'],b['an'],mind))\nallc.sort(key=lambda x:x[3])\nfor ri,rn,an,dd in allc[:10]:\n    region=\"\u03b2-groove\" if 388<=ri<=508 else (\"lid\" if 509<=ri<=613 else \"post-lid\")\n    print(f\"    A-{ri}-{rn:3s} {an:4s} [{region}]  {dd:.2f} \u00c5\")\nPYEOF\npython3 /tmp/measure3.py"}

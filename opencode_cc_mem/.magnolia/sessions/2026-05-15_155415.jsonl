{"event_type":"tool_call","timestamp":"2026-06-24T13:47:50.264328Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport glob,json,os,re\nruns=[\"2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full\",\"2026-06-16_af3_KFERQx2_s10000_full\",\n      \"2026-06-16_af3_RKELQx2_s10000_full\",\"2026-06-16_af3_QRKELx2_s10000_full\",\n      \"2026-06-16_af3_RKDLQ-variant_s10000_full\",\"2026-06-16_af3_TGGFQMALT_s10000_full\"]\nseqs={\"KFERQ-KILDQ-fusion\":\"KFERQKILDQRFFE(14)\",\"KFERQx2\":\"KFERQKFERRQ(11)\",\"RKELQx2\":\"RKELQRKELQ(10)\",\n      \"QRKELx2\":\"QRKELQRKEL(10)\",\"RKDLQ-variant\":\"RKDLQRKDDQ(10)\",\"TGGFQMALT\":\"TGGFQMALT(9)\"}\nprint(f\"{'peptide':24s}{'AIR-free':>10}{'DockQ':>8}{'n':>5}\")\nfor r in runs:\n    key=[k for k in seqs if k in r][0]\n    ts=glob.glob(f\"{r}/output/**/capri_clt.tsv\",recursive=True)\n    ts=[t for t in ts if 'caprieval_analysis' in t]\n    if not ts: print(f\"{seqs[key]:24s}  (no capri_clt)\"); continue\n    def num(t):\n        m=re.search(r'(\\d+)_caprieval_analysis',t); return int(m.group(1)) if m else 0\n    f=max(ts,key=num)\n    wdir=f.split('/analysis/')[0]\n    wp=glob.glob(f\"{wdir}/*/weights_params.json\"); wair=0.1\n    if wp:\n        try: wair=json.load(open(wp[0])).get('w_air',0.1)\n        except: pass\n    rows=[];idx={}\n    for line in open(f):\n        if line.startswith('#') or not line.strip(): continue\n        if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n        rows.append(line.rstrip().split('\\t'))\n    def g(rw,c): return rw[idx[c]]\n    rw=rows[0]; af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"{seqs[key]:24s}{af:10.2f}{float(g(rw,'dockq')):8.3f}{g(rw,'n'):>5}\")\nPY"}

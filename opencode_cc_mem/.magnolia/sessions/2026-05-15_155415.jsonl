in r and r[k]:\n                                print(f'  {k}: {str(r[k])[:200]}')\n                        print()\n                    else:\n                        print(f'  Type: {type(r)}, Value: {str(r)[:200]}')\n                        print()\n                \n                # Check next agent text\n                for j in range(i+1, min(i+20, len(rows))):\n                    data_json2, ts2, pid2 = rows[j]\n                    try:\n                        d2 = json.loads(data_json2)\n                    except:\n                        continue\n                    t2 = d2.get('type', '?')\n                    if t2 == 'text' and d2.get('text', '').strip():\n                        print(f'FOLLOW-UP TEXT: {d2.get(\\\"text\\\",\\\"\\\")[:400]}')\n                        break\n            except Exception as e:\n                print(f'Error: {e}')\n        break\n\" 2>&1"}

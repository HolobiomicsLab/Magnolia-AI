{"event_type":"tool_call","timestamp":"2026-06-23T14:32:55.401453Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport sqlite3, json, re\nfrom datetime import datetime\n\nconn = sqlite3.connect('/home/tjiang/.local/share/opencode/opencode.db')\n\nsession_dates = {\n    'ses_14d178160ffeFCUNF8muY7i3DL': '2026-06-10',\n    'ses_14a8d1dd6ffesLHxScnqDJwwUz': '2026-06-11',\n    'ses_14a4301fcffe2zIr27rODUZ3PS': '2026-06-11',\n    'ses_1456d0e73ffe6ULEPwvHYx84J4': '2026-06-12',\n    'ses_13fc23de2ffelf2ddyTWl2olKC': '2026-06-13',\n    'ses_134c7b1a2ffeMFkXQrSHFP8Cs1': '2026-06-15',\n    'ses_1349d35caffeQYdQoegiPzSDIl': '2026-06-15',\n    'ses_130e4d4e4ffeJu5Q6ZBCByktmm': '2026-06-16',\n    'ses_12b819265ffeRiCjSRTOF2mCwU': '2026-06-17',\n    'ses_12b8117ebffeVUQKhrJh87qWNB': '2026-06-17',\n    'ses_12b670a8effezB5zYoxyPnSA46': '2026-06-17',\n    'ses_12a46493fffehueb24QomyJNE8': '2026-06-17',\n    'ses_12a373231ffeLcYS57pJqIwi68': '2026-06-17',\n    'ses_12a31596dffeU2R6yIw5W4l4yk': '2026-06-17',\n    'ses_125e030f7ffeXnTIPy3gi7ezbx': '2026-06-18',\n    'ses_120fa984affeN2zTmXpUOp3es8': '2026-06-19',\n    'ses_11186eec2ffe47heamLxUwWbfN': '2026-06-22',\n    'ses_1112f1045ffeaXFZuHiIouAkDM': '2026-06-22',\n    'ses_111257958ffe11RGJcUGSOER9m': '2026-06-22',\n    'ses_10bc31326ffeTnbvzCh53fUJnF': '2026-06-23',\n    'ses_10bbac41affe71w1NKzuwR3QGR': '2026-06-23',\n}\n\n# Get all submit_job tool calls across all sessions\n# Also get memory_get_context calls\nfor sess_id, date in session_dates.items():\n    rows = conn.execute('''\n        SELECT p.data, m.data, p.time_created\n        FROM part p JOIN message m ON p.message_id = m.id\n        WHERE p.session_id = ?\n        ORDER BY p.time_created\n    ''', [sess_id]).fetchall()\n    \n    if not rows:\n        continue\n    \n    submit_calls = []\n    mem_get_ctx = []\n    reasonings = []\n    \n    for p_data, m_data, ts in rows:\n        try:\n            part = json.loads(p_data)\n            ptype = part.get('type', '')\n            \n            if ptype == 'tool':\n                tool_name = part.get('tool', '')\n                state = part.get('state', {})\n                tool_input = state.get('input', {})\n                \n                if 'submit_job' in tool_name and isinstance(tool_input, dict):\n                    submit_calls.append((ts, tool_input))\n                \n                if 'memory_get_context' in tool_name and isinstance(tool_input, dict):\n                    task_desc = tool_input.get('task_description', '')[:200]\n                    mem_get_ctx.append((ts, task_desc))\n            \n            elif ptype == 'reasoning':\n                text = part.get('text', '')\n                tl = text.lower()\n                if any(kw in tl for kw in ['sampl', 'ncore', 'memor', 'partit', 's5000', 's10000',\n                    'p2rank', 'restrain', 'ambig', 'actpass', 'pocket', 'bind', 'haddock3',\n                    '4po2', 'lid', 'sandwich', 'rule', 'memory_get_context', 'from rules',\n                    'from memory', 'based on', 'because']):\n                    reasonings.append((ts, text[:500]))\n        \n        except:\n            pass\n    \n    if submit_calls or mem_get_ctx:\n        print(f'\\n{\"=\"*80}')\n        print(f'SESSION: {date} ({sess_id})')\n        print(f'  submit_job: {len(submit_calls)}, memory_get_context: {len(mem_get_ctx)}')\n        print(f'  relevant reasonings: {len(reasonings)}')\n        print(f'{\"=\"*80}')\n        \n        for ts, mc in mem_get_ctx[:3]:\n            print(f'\\n  [memory_get_context] {mc[:300]}')\n        \n        for ts, inp in submit_calls[:15]:\n            sched = inp.get('scheduler', '?')\n            cmd = inp.get('command', '?')\n            nc = inp.get('ncores', '?')\n            mem = inp.get('memory', '?')\n            tl = inp.get('time_limit', '?')\n            part = inp.get('partition', '?')\n            tool = inp.get('tool', '?')\n            jn = inp.get('job_name', '?')\n            wd = inp.get('working_dir', '?')\n            \n            # Extract from wd\n            wd_short = str(wd).split('/projects/')[-1] if '/projects/' in str(wd) else str(wd)[-60:]\n            \n            print(f'\\n  [{sched}] {jn}')\n            print(f'    ncores={nc}, mem={mem}, time={tl}, partition={part}')\n            print(f'    tool={tool}, dir=.../{wd_short}')\n            print(f'    cmd: {str(cmd)[:200]}')\n        \n        for ts, text in reasonings[:3]:\n            print(f'\\n  [reasoning] {text[:400]}')\n\nconn.close()\nPYEOF\n 2>&1 | head -500"}

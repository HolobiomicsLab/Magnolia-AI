{"event_type":"tool_call","timestamp":"2026-06-24T13:10:09.641921Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new\necho \"=== find 4PO2 structure files ===\"\nfind . -iname '*4po2*' \\( -name '*.pdb' -o -name '*.pdb.gz' -o -name '*.cif' \\) 2>/dev/null | head\necho \"--- also raw_input ---\"\nfind raw_input -iname '*4po2*' 2>/dev/null | head\necho\necho \"=== AF3 receptor location ===\"\nls -la runs/2026-06-17_RKALQ_s5000/receptor.pdb\necho\necho \"=== tools: biopython? numpy? ===\"\npython3 -c \"import numpy; print('numpy', numpy.__version__)\" 2>&1\npython3 -c \"import Bio; print('biopython', Bio.__version__)\" 2>&1\necho\necho \"=== 4PO2 chain/residue summary (first match) ===\"\nf=$(find . -iname '*4po2*' -name '*.pdb' 2>/dev/null | grep -iv 'full' | head -1)\necho \"using: $f\"\n[ -n \"$f\" ] && awk '/^ATOM/{print $5}' \"$f\" | sort -u | tr '\\n' ' '; echo\n[ -n \"$f\" ] && echo \"4PO2 res range per chain:\" && awk '/^ATOM/{print $5,$6,$4}' \"$f\" | sort -k1,1 -k2,2n -u | awk '{print $1}' | uniq -c"}
{"event_type":"tool_success","timestamp":"2026-06-24T13:10:10.918439Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":1276,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-24T13:11:01.822989Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new\npython3 - <<'PY'\nimport numpy as np\n\ndef ca_chain(path):\n    d={}\n    with open(path) as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            if line[12:16].strip()!='CA': continue\n            ch=line[21]\n            if ch!='A' and ch!=' ': \n                # some files may use space; keep only chain A or blank\n                if ch!=' ': continue\n            try:\n                res=int(line[22:26]); x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n            except ValueError: continue\n            resn=line[17:20].strip()\n            d[res]=(resn,np.array([x,y,z]))\n    return d\n\npo2=ca_chain(\"raw_input/receptor/4po2_chainA.pdb\")\naf3=ca_chain(\"runs/2026-06-17_RKALQ_s5000/receptor.pdb\")\nprint(f\"4PO2 chain A: {len(po2)} CA, range {min(po2)}-{max(po2)}\")\nprint(f\"AF3  chain A: {len(af3)} CA, range {min(af3)}-{max(af3)}\")\n\n# common resnums in SBD overlap\ncommon=sorted(set(po2)&set(af3))\nprint(f\"common resnums: {len(common)}, range {min(common)}-{max(common)}\")\n\n# check resname agreement (numbering alignment sanity)\nagree=sum(1 for r in common if po2[r][0]==af3[r][0])\nprint(f\"resname match at matched positions: {agree}/{len(common)} ({100*agree/len(common):.1f}%)\")\n# show first few mismatches if any\nmis=[(r,po2[r][0],af3[r][0]) for r in common if po2[r][0]!=af3[r][0]][:8]\nif mis: print(\"first mismatches (res,4po2,af3):\",mis)\n\ndef kabsch_rmsd(P,Q):\n    Pc=P-P.mean(0); Qc=Q-Q.mean(0)\n    H=Pc.T@Qc\n    U,S,Vt=np.linalg.svd(H)\n    d=np.sign(np.linalg.det(Vt.T@U.T))\n    D=np.diag([1,1,d])\n    R=Vt.T@D@U.T\n    Pr=Pc@R.T\n    return np.sqrt(((Pr-Qc)**2).sum(1).mean())\n\ndef report(lo,hi,label):\n    rs=[r for r in common if lo<=r<=hi and po2[r][0]==af3[r][0]]\n    if not rs: print(f\"{label}: no matched residues\"); return\n    P=np.array([po2[r][1] for r in rs]); Q=np.array([af3[r][1] for r in rs])\n    print(f\"{label}: residues {min(rs)}-{max(rs)} (n={len(rs)}): RMSD = {kabsch_rmsd(P,Q):.2f} \u00c5\")\n\nprint(\"\\n=== SBD superposition 4PO2(chainA) vs AF3(chainA) ===\")\nreport(386,613,\"whole SBD (386-613)\")\nreport(386,508,\"\u03b2-sandwich core (386-508)  [peptide-binding groove]\")\nreport(509,613,\"\u03b1-helical lid (509-613)\")\nPY"}

\\\n  projects/hsc70_new/runs/2026-06-17_RKALQR_s10000; do\n  name=$(basename $dir | sed 's/2026-06-17_//;s/_s10000//')\n  tsv=\"$dir/output/12_caprieval/capri_clt.tsv\"\n  awk -F'\\t' -v n=\"$name\" '\n    NR==15 { air_free = $5 - 0.1*$19\n             printf \"%-8s %6s %10.2f %10.2f %10.2f %8.3f %8.3f %4s\\n\", n, \"s10000\", $5, $19, air_free, $13, $9, $3 }\n  ' \"$tsv\"\ndone\n\necho \"\"\necho \"--- x2 / longer peptides (for reference) ---\"\nprintf \"%-10s %6s %10s %10s %10s %8s %8s %4s\\n\" \"Peptide\" \"s\" \"Raw\" \"Air\" \"AIR-free\" \"DockQ\" \"fnat\" \"n\"\nfor dir in \\\n  projects/hsc70_new/runs/2026-06-16_4po2_KFERQx2_s10000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_QRKELx2_s10000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_RKELQx2_s10000_full; do\n  name=$(basename $dir | sed 's/.*4po2_//;s/_s10000_full//')\n  tsv=\"$dir/output/12_caprieval/capri_clt.tsv\"\n  awk -F'\\t' -v n=\"$name\" '\n    NR==15 { air_free = $5 - 0.1*$19\n             printf \"%-10s %6s %10.2f %10.2f %10.2f %8.3f %8.3f %4s\\n\", n, \"s10000\", $5, $19, air_free, $13, $9, $3 }\n  ' \"$tsv\"\ndone"}

{"event_type":"tool_call","timestamp":"2026-06-17T20:31:56.904597Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\nrec_by_res = {}\npep_coords = []\npep_full = []\n\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"): continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        rn = line[17:20].strip(); rid = int(line[22:26]); an = line[12:16].strip()\n        if chain == 'A':\n            rec_by_res.setdefault(rid, {\"resname\": rn, \"xyz\": [], \"types\": []})\n            rec_by_res[rid][\"xyz\"].append((x, y, z))\n            rec_by_res[rid][\"types\"].append(an)\n        elif chain == 'B':\n            pep_coords.append((x, y, z))\n            pep_full.append((chain, rn, rid, an, x, y, z))\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vlen(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef norm(v):\n    l = vlen(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\ndef get_pos(chain, resid, atomname):\n    for ca, rn, ri, an, x, y, z in pep_full:\n        if ca == chain and ri == resid and an == atomname:\n            return (x, y, z)\n    return None\n\n# Pocket\npocket = {}\nfor rid in sorted(rec_by_res.keys()):\n    d = min(dist(p, t) for p in pep_coords for t in rec_by_res[rid][\"xyz\"])\n    if d <= 5.0:\n        pocket[rid] = d\n\n# Contact map\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\ncontacts = []\nwith open(f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\") as f:\n    for line in f:\n        if line[0] == '#' or line.startswith(\"res1\"): continue\n        parts = line.strip().split(\"\\t\")\n        if len(parts) < 7: continue\n        contacts.append({\"rec\": parts[0], \"pep\": parts[1], \"prob\": float(parts[5]), \"dist\": float(parts[6])})\n\ncontacted = set()\nfor c in contacts:\n    if c[\"prob\"] >= 0.5:\n        contacted.add(int(c[\"rec\"].split(\"-\")[1]))\n\nunder_ids = sorted(set(pocket.keys()) - contacted)\n\n# Terminal geometry\nN_pos  = get_pos('B', 1, 'N')\nCA1 = get_pos('B', 1, 'CA')\nCB1 = get_pos('B', 1, 'CB')\nnt_dir = norm(vec(CA1, N_pos))  # direction from N toward new residue (CA\u2192N)\nca_to_cb_norm_nt = norm(vec(CA1, CB1))\nnew_ca_nt = tuple(N_pos[i] + nt_dir[i] * 3.0 for i in range(3))\nnew_cb_nt = tuple(new_ca_nt[i] + ca_to_cb_norm_nt[i] * 1.53 for i in range(3))\n\nC_c  = get_pos('B', 5, 'C')\nCA5 = get_pos('B', 5, 'CA')\nct_dir = norm(vec(CA5, C_c))  # CA\u2192C direction\n\nreach = {\"ARG\":6.5,\"LYS\":6.0,\"TYR\":5.5,\"TRP\":5.5,\"PHE\":5.0,\"GLU\":5.0,\n         \"GLN\":5.0,\"MET\":5.0,\"HIS\":4.5,\"LEU\":4.0,\"ILE\":4.0,\"ASP\":3.5,\n         \"ASN\":3.5,\"THR\":3.0,\"VAL\":3.0,\"SER\":2.5,\"ALA\":1.5,\"GLY\":0.0}\n\ncharged_pos = {\"ARG\",\"LYS\",\"HIS\"}\ncharged_neg = {\"ASP\",\"GLU\"}\npolar_aa = {\"ASN\",\"GLN\",\"SER\",\"THR\",\"TYR\",\"CYS\"}\napolar_aa = {\"ALA\",\"VAL\",\"LEU\",\"ILE\",\"MET\",\"PHE\",\"TRP\",\"PRO\",\"GLY\"}\n\ndef complement(tgt_name):\n    if tgt_name in charged_pos: return [\"ASP\",\"GLU\"], \"salt bridge (-)\"\n    if tgt_name in charged_neg: return [\"ARG\",\"LYS\"], \"salt bridge (+)\"\n    if tgt_name in apolar_aa: return [\"LEU\",\"ILE\",\"VAL\",\"ALA\"], \"hydrophobic pack\"\n    if tgt_name in polar_aa: return [\"ARG\",\"GLN\",\"ASN\",\"TYR\"], \"H-bond\"\n    return [], \"?\"\n\n# ============================================================\n# N-TERMINAL\n# ============================================================\nprint(\"=\" * 90)\nprint(\"N-TERMINAL EXTENSION SCAN\")\nprint(f\"N at ({N_pos[0]:.1f}, {N_pos[1]:.1f}, {N_pos[2]:.1f})\")\nprint(f\"Extension direction CA\u2192N: ({nt_dir[0]:.3f}, {nt_dir[1]:.3f}, {nt_dir[2]:.3f})\")\nprint(f\"New CB at ({new_cb_nt[0]:.1f}, {new_cb_nt[1]:.1f}, {new_cb_nt[2]:.1f})\")\nprint(\"=\" * 90)\n\nnt_hits = []\nnt_near = []\n\nfor rid in under_ids:\n    name = rec_by_res[rid][\"resname\"]\n    pd = pocket[rid]\n    rxyz = rec_by_res[rid][\"xyz\"]\n    \n    d_n  = min(dist(N_pos, p) for p in rxyz)\n    d_cb = min(dist(new_cb_nt, p) for p in rxyz)\n    \n    closest = min(rxyz, key=lambda p: dist(N_pos, p))\n    tg_dir = norm(vec(N_pos, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(nt_dir, tg_dir)))))\n    \n    best = None\n    for r, rlen in sorted(reach.items(), key=lambda x: -x[1]):\n        if rlen >= d_cb:\n            best = r\n            break\n    \n    if angle < 60 and best:\n        comp_res, ctype = complement(name)\n        nt_hits.append((rid, name, pd, d_n, d_cb, angle, best, comp_res, ctype))\n    elif angle < 90 and best:\n        nt_near.append((rid, name, pd, d_n, d_cb, angle, best))\n\n# ALL under-utilized residues, sorted by angle\nprint(f\"\\n{'#':>5s} {'Name':>4s} {'Pocket':>7s} {'N\u2192':>6s} {'CB\u2192':>6s} {'Angle':>7s} {'Reach':>6s} {'Viable':>8s}\")\nprint(\"-\" * 70)\nfor rid in under_ids:\n    name = rec_by_res[rid][\"resname\"]\n    pd = pocket[rid]\n    rxyz = rec_by_res[rid][\"xyz\"]\n    d_n  = min(dist(N_pos, p) for p in rxyz)\n    d_cb = min(dist(new_cb_nt, p) for p in rxyz)\n    closest = min(rxyz, key=lambda p: dist(N_pos, p))\n    tg_dir_c = norm(vec(N_pos, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(nt_dir, tg_dir_c)))))\n    best = None\n    for r, rlen in sorted(reach.items(), key=lambda x: -x[1]):\n        if rlen >= d_cb:\n            best = r; break\n    viable = \"\u2713\" if angle < 60 and best else (\"~\" if angle < 90 and best else \"\u2717\")\n    print(f\"{rid:5d} {name:>4s} {pd:6.1f}\u00c5 {d_n:5.1f}  {d_cb:5.1f}  {angle:6.1f}\u00b0 {best or '\u2014':>6s} {viable:>8s}\")\n\nif nt_hits:\n    print(f\"\\nVIABLE (angle<60\u00b0, reachable) \u2014 {len(nt_hits)}:\")\n    for rid, name, pd, dn, dcb, ang, best_r, comp, ctype in sorted(nt_hits, key=lambda x: x[4]):\n        print(f\"  {name}{rid} ({pd:.1f}\u00c5): ang={ang:.1f}\u00b0, newCB\u2192{dcb:.1f}\u00c5, {best_r} works \u2192 {ctype} ({', '.join(comp)})\")\nif nt_near:\n    print(f\"\\nMARGINAL (60-90\u00b0) \u2014 {len(nt_near)}:\")\n    for rid, name, pd, dn, dcb, ang, best_r in sorted(nt_near, key=lambda x: x[4]):\n        print(f\"  {name}{rid} ({pd:.1f}\u00c5): ang={ang:.1f}\u00b0, newCB\u2192{dcb:.1f}\u00c5, {best_r} can reach\")\n\n# ============================================================\n# C-TERMINAL\n# ============================================================\nprint()\nprint(\"=\" * 90)\nprint(\"C-TERMINAL EXTENSION SCAN\")\nprint(f\"C at ({C_c[0]:.1f}, {C_c[1]:.1f}, {C_c[2]:.1f})\")\nprint(f\"Extension direction CA\u2192C: ({ct_dir[0]:.3f}, {ct_dir[1]:.3f}, {ct_dir[2]:.3f})\")\nprint(\"=\" * 90)\n\nct_hits = []\nct_marginal = []\n\nfor rid in under_ids:\n    name = rec_by_res[rid][\"resname\"]\n    pd = pocket[rid]\n    rxyz = rec_by_res[rid][\"xyz\"]\n    \n    d_c  = min(dist(C_c, p) for p in rxyz)\n    new_ca_ct = tuple(C_c[i] + ct_dir[i] * 3.8 for i in range(3))\n    d_ca = min(dist(new_ca_ct, p) for p in rxyz)\n    \n    closest = min(rxyz, key=lambda p: dist(C_c, p))\n    tg_dir = norm(vec(C_c, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ct_dir, tg_dir)))))\n    \n    # Total reach: backbone(3.8) + max_sidechain(6.5) = 10.3 \u00c5 from C-term C\n    max_total = 3.8 + 6.5\n    best = None\n    for r, rlen in sorted(reach.items(), key=lambda x: -x[1]):\n        if 3.8 + rlen >= d_c:\n            best = r; break\n    \n    if angle < 90 and best:\n        comp_res, ctype = complement(name)\n        ct_hits.append((rid, name, pd, d_c, d_ca, angle, best, comp_res, ctype))\n    elif 90 <= angle < 130 and best and d_c <= max_total:\n        comp_res, ctype = complement(name)\n        ct_marginal.append((rid, name, pd, d_c, d_ca, angle, best, comp_res, ctype))\n\nprint(f\"\\n{'#':>5s} {'Name':>4s} {'Pocket':>7s} {'C\u2192':>6s} {'CA\u2192':>6s} {'Angle':>7s} {'Total':>6s} {'Viable':>8s}\")\nprint(\"-\" * 70)\nfor rid in under_ids:\n    name = rec_by_res[rid][\"resname\"]\n    pd = pocket[rid]\n    rxyz = rec_by_res[rid][\"xyz\"]\n    d_c  = min(dist(C_c, p) for p in rxyz)\n    new_ca_ct = tuple(C_c[i] + ct_dir[i] * 3.8 for i in range(3))\n    d_ca = min(dist(new_ca_ct, p) for p in rxyz)\n    closest = min(rxyz, key=lambda p: dist(C_c, p))\n    tg_dir = norm(vec(C_c, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ct_dir, tg_dir)))))\n    max_total = 3.8 + 6.5\n    best = None\n    for r, rlen in sorted(reach.items(), key=lambda x: -x[1]):\n        if 3.8 + rlen >= d_c:\n            best = r; break\n    if angle < 90 and best: viable = \"\u2713\"\n    elif 90 <= angle < 130 and best and d_c <= max_total: viable = \"~sidechain\"\n    else: viable = \"\u2717\"\n    print(f\"{rid:5d} {name:>4s} {pd:6.1f}\u00c5 {d_c:5.1f}  {d_ca:5.1f}  {angle:6.1f}\u00b0 {3.8 + (reach.get(best,0) if best else 0):5.1f}  {viable:>8s}\")\n\nif ct_hits:\n    print(f\"\\nFAVORABLE (angle<90\u00b0, reachable) \u2014 {len(ct_hits)}:\")\n    for rid, name, pd, dc, dca, ang, best_r, comp, ctype in sorted(ct_hits, key=lambda x: x[5]):\n        print(f\"  {name}{rid} ({pd:.1f}\u00c5): C\u2192{dc:.1f}\u00c5, CA\u2192{dca:.1f}\u00c5, ang={ang:.1f}\u00b0, {best_r} works \u2192 {ctype} ({', '.join(comp)})\")\n\nif ct_marginal:\n    print(f\"\\nMARGINAL (90-130\u00b0, sidechain compensates) \u2014 {len(ct_marginal)}:\")\n    for rid, name, pd, dc, dca, ang, best_r, comp, ctype in sorted(ct_marginal, key=lambda x: x[5]):\n        print(f\"  {name}{rid} ({pd:.1f}\u00c5): C\u2192{dc:.1f}\u00c5, ang={ang:.1f}\u00b0, {best_r} works \u2192 {ctype} ({', '.join(comp)})\")\n\n# ============================================================\n# FINAL PROPOSAL\n# ============================================================\nprint()\nprint(\"=\" * 90)\nprint(\"PROPOSAL \u2014 viable extension candidates\")\nprint(\"=\" * 90)\n\nif nt_hits:\n    print(f\"\\nN-terminal (X0-RKALQ): {len(nt_hits)} targets\")\n    for rid, name, pd, dn, dcb, ang, best_r, comp, ctype in nt_hits:\n        print(f\"  X0={comp[0] if comp else best_r} to engage {name}{rid} via {ctype}\")\n\nif ct_hits:\n    print(f\"\\nC-terminal (RKALQ-X6): {len(ct_hits)} targets\")\n    for rid, name, pd, dc, dca, ang, best_r, comp, ctype in ct_hits:\n        print(f\"  X6={comp[0] if comp else best_r} to engage {name}{rid} via {ctype}\")\n\nif ct_marginal:\n    print(f\"\\nC-terminal marginal (RKALQ-X6, sidechain compensates): {len(ct_marginal)}\")\n    for rid, name, pd, dc, dca, ang, best_r, comp, ctype in ct_marginal:\n        print(f\"  X6={comp[0] if comp else best_r} to engage {name}{rid} via {ctype} (requires favorable \u03c71)\")\n\nif not nt_hits and not ct_hits and not ct_marginal:\n    print(\"\\nNo viable extension candidates. The 5-mer scaffold is the local optimum.\")\n\nPYEOF"}

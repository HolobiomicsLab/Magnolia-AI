{"event_type":"tool_call","timestamp":"2026-06-03T15:24:14.251381Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, shutil\n\nproject = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nruns = os.path.join(project, \"runs\")\nreceptor_src = os.path.join(project, \"raw_input/receptor/hsc70-full_processed.pdb\")\n\npeptides = [\n    (\"2026-06-03_RKELQx2_p2rank1_s10000\", \"raw_input/peptides/longer/peptide1_RKELQx2.pdb\"),\n    (\"2026-06-03_QRKELx2_p2rank1_s10000\", \"raw_input/peptides/longer/peptide2_QRKELx2.pdb\"),\n    (\"2026-06-03_RKDLQ-variant_p2rank1_s10000\", \"raw_input/peptides/longer/peptide4_RKDLQ-variant_fixed.pdb\"),\n]\n\n# P2Rank receptor actpass (same for all)\nrec_actpass = \"10 12 14 15 37 56 175 199 201 202 230 231 234 268 271 272 275 338 339 340 342 343 365 366 369\\n10 12 14 15 37 56 175 199 201 202 230 231 234 268 271 272 275 338 339 340 342 343 365 366 369\\n\"\n\n# Config template (s10000, 10-mer)\nconfig_tpl = \"\"\"run_dir = \"output\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\nmode = \"local\"\nncores = 32\n\n[topoaa]\n\n[rigidbody]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nsampling = 10000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[flexref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = 647\nfle_end_2 = 656\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = 647\nfle_end_2 = 656\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 4\n\n[caprieval]\nallatoms = true\n\n[contactmap]\n\"\"\"\n\n# Peptide actpass: all 10 residues active (647-656)\npep_actpass = \" \".join(str(i) for i in range(647, 657)) + \"\\n\" + \" \".join(str(i) for i in range(647, 657)) + \"\\n\"\n\nfor dirname, pep_src_rel in peptides:\n    run_dir = os.path.join(runs, dirname)\n    os.makedirs(run_dir, exist_ok=True)\n    \n    pep_src = os.path.join(project, pep_src_rel)\n    \n    # Copy receptor\n    shutil.copy2(receptor_src, os.path.join(run_dir, \"receptor.pdb\"))\n    # Copy peptide\n    shutil.copy2(pep_src, os.path.join(run_dir, \"peptide.pdb\"))\n    \n    # Write receptor.actpass\n    with open(os.path.join(run_dir, \"receptor.actpass\"), \"w\") as f:\n        f.write(rec_actpass)\n    \n    # Write peptide.actpass\n    with open(os.path.join(run_dir, \"peptide.actpass\"), \"w\") as f:\n        f.write(pep_actpass)\n    \n    # Write config.cfg\n    with open(os.path.join(run_dir, \"config.cfg\"), \"w\") as f:\n        f.write(config_tpl)\n    \n    print(f\"Created: {dirname}\")\n\nPYEOF\n"}

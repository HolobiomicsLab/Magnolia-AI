{"event_type":"tool_call","timestamp":"2026-06-30T14:46:29.844376Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport json\nfrom collections import defaultdict, Counter\n\nwith open(\"/home/tjiang/.local/share/opencode/tool-output/tool_f18fdce520017YkwToN44c0spa\") as f:\n    raw = f.read()\n\ndata = json.loads(raw)\nif isinstance(data, dict) and \"result\" in data:\n    records = json.loads(data[\"result\"])\nelse:\n    records = data\n\n# Write full summary to file\noutlines = []\noutlines.append(f\"=== TOTAL RUNS: {len(records)} ===\\n\")\n\n# Determine grouping\ngroups = defaultdict(list)\n\nfor r in records:\n    run_id = r.get(\"run_id\", \"unknown\")\n    tool = r.get(\"tool\", \"unknown\")\n    status = r.get(\"status\", \"None\")\n    lifecycle = r.get(\"lifecycle\", \"None\")\n    date_str = r.get(\"date\", \"unknown\")\n    \n    remote = r.get(\"remote\", {})\n    slurm_state = None\n    exit_code = None\n    job_id = None\n    local_dir = None\n    errors = r.get(\"errors_solved\", [])\n    quality_flags = r.get(\"quality_flags\", [])\n    \n    if isinstance(remote, dict) and remote:\n        slurm_info = remote.get(\"slurm\", {})\n        if isinstance(slurm_info, dict):\n            slurm_state = slurm_info.get(\"state\", None)\n            exit_code = slurm_info.get(\"exit_code\", None)\n        job_id = remote.get(\"job_id\", None)\n        local_dir = remote.get(\"local_run_dir\", None)\n    \n    # Determine category - use more granular grouping\n    if lifecycle == \"completed\":\n        if status == \"pass\":\n            cat = \"COMPLETED (success)\"\n        elif status in (\"fail\", \"failed\"):\n            cat = \"COMPLETED (failed)\"\n        else:\n            cat = f\"COMPLETED (status={status})\"\n    elif lifecycle == \"fetched\":\n        if status == \"pass\":\n            cat = \"FETCHED (success)\"\n        elif status in (\"fail\", \"failed\"):\n            cat = \"FETCHED (failed)\"\n        else:\n            cat = f\"FETCHED (status={status})\"\n    elif lifecycle == \"running\":\n        if slurm_state and slurm_state != \"RUNNING\":\n            cat = f\"RUNNING (slurm={slurm_state})\"\n        else:\n            cat = \"RUNNING (active)\"\n    elif lifecycle == \"cancelled\":\n        cat = \"CANCELLED\"\n    elif lifecycle == \"failed\":\n        if slurm_state == \"OUT_OF_MEMORY\":\n            cat = \"OUT_OF_MEMORY\"\n        elif slurm_state == \"TIMEOUT\":\n            cat = \"TIMED_OUT\"\n        else:\n            cat = f\"FAILED (slurm={slurm_state or 'unknown'})\"\n    elif lifecycle == \"submitting\":\n        cat = \"SUBMITTING (incomplete)\"\n    elif lifecycle == \"submitted\":\n        cat = \"SUBMITTED (awaiting cluster)\"\n    elif status == \"pass\":\n        cat = \"PASS (no lifecycle)\"\n    elif status == \"fail\":\n        cat = \"FAIL (no lifecycle)\"\n    elif status == \"submission_failed\":\n        cat = \"SUBMISSION_FAILED\"\n    else:\n        cat = f\"OTHER (lifecycle={lifecycle}, status={status})\"\n    \n    groups[cat].append(r)\n\n\n# Print grouped summary\nfor cat in sorted(groups.keys()):\n    recs = groups[cat]\n    outlines.append(f\"## {cat} \u2014 {len(recs)} runs\\n\")\n    for rec in recs:\n        metrics_str = \"\"\n        if rec.get(\"metrics\"):\n            mkeys = [k for k in rec[\"metrics\"].keys() if not k.startswith(\"#\")]\n            if mkeys:\n                parts = []\n                for k in mkeys[:4]:\n                    parts.append(f\"{k}={rec['metrics'][k]}\")\n                metrics_str = \" | \" + \", \".join(parts)\n        jid = \"\"\n        remote = rec.get(\"remote\", {})\n        if isinstance(remote, dict) and remote.get(\"job_id\"):\n            jid = f\" job={remote['job_id']}\"\n        ec = \"\"\n        if isinstance(remote, dict) and remote.get(\"slurm\", {}).get(\"exit_code\"):\n            ec = f\" exit={remote['slurm']['exit_code']}\"\n        local = \"\"\n        if isinstance(remote, dict) and remote.get(\"local_run_dir\"):\n            local = f\" dir={remote['local_run_dir']}\"\n        outlines.append(f\"  {rec['run_id']} | date={rec['date']}{jid}{ec}{local}{metrics_str}\\n\")\n    outlines.append(\"\")\n\n# MOST RECENT 15 runs (by date then by order in list)\noutlines.append(\"=== MOST RECENT 15 RUNS ===\\n\")\nrecent = sorted(records, key=lambda r: str(r.get(\"date\", \"0000\")), reverse=True)[:15]\nfor rec in recent:\n    rmt = rec.get(\"remote\", {})\n    jid = rmt.get(\"job_id\", \"-\") if isinstance(rmt, dict) else \"-\"\n    sl = rmt.get(\"slurm\", {}) if isinstance(rmt, dict) else {}\n    state = sl.get(\"state\", \"-\") if isinstance(sl, dict) else \"-\"\n    lc = rec.get(\"lifecycle\", \"-\")\n    st = rec.get(\"status\", \"-\")\n    m = rec.get(\"metrics\", {})\n    mks = [k for k in m if not k.startswith(\"#\")]\n    mp = \", \".join(f\"{k}={m[k]}\" for k in mks[:3]) if mks else \"\"\n    outlines.append(f\"  {rec['run_id']}\\n    date={rec['date']} lifecycle={lc} status={st} slurm={state} job={jid}\\n    metrics: {mp}\\n\")\n\nwith open(\"/tmp/run_summary.txt\", \"w\") as f:\n    f.write(\"\\n\".join(outlines))\n\nprint(\"Summary written to /tmp/run_summary.txt\")\nprint(f\"Total records: {len(records)}\")\nprint(f\"Groups: {len(groups)}\")\nfor cat in sorted(groups.keys()):\n    print(f\"  {cat}: {len(groups[cat])}\")\n\nPYEOF\n"}

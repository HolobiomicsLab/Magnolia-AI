{"event_type":"tool_success","timestamp":"2026-06-11T20:31:40.434473Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":824,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-11T20:31:53.519549Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/envs/ambertools/bin/python3 << 'PYEOF'\nimport numpy as np\n\npdb = '/tmp/contact_analysis/KFERQx2_cl1_m1.pdb'\n\n# Load receptor A-342 and peptide middle residues\ndef load_atoms_by_res(pdb_file, chain, resnum):\n    atoms = []\n    with open(pdb_file) as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            ch = line[21]\n            if ch != chain: continue\n            rnum = int(line[22:26])\n            if rnum != resnum: continue\n            aname = line[12:16].strip()\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            atoms.append({'atom': aname, 'xyz': np.array([x,y,z])})\n    return atoms\n\na342 = load_atoms_by_res(pdb, 'A', 342)\nif not a342:\n    print(\"A-342 not found in PDB!\")\n    exit()\nprint(f\"A-342 ARG: {len(a342)} atoms\")\n\nfor res in [651, 652, 653, 654, 655, 656, 657]:\n    patoms = load_atoms_by_res(pdb, 'B', res)\n    if not patoms: continue\n    rname = patoms[0].get('rname', '?')\n    \n    # CA-CA distance\n    ca_a342 = next((a['xyz'] for a in a342 if a['atom'] == 'CA'), None)\n    ca_pep = next((a['xyz'] for a in patoms if a['atom'] == 'CA'), None)\n    ca_dist = np.linalg.norm(ca_a342 - ca_pep) if ca_a342 is not None and ca_pep is not None else None\n    \n    # Shortest atom-atom distance\n    min_dist = float('inf')\n    min_pair = None\n    for a1 in a342:\n        for a2 in patoms:\n            d = np.linalg.norm(a1['xyz'] - a2['xyz'])\n            if d < min_dist:\n                min_dist = d\n                min_pair = (a1['atom'], a2['atom'])\n    \n    name_map = {651:'Q5', 652:'K6', 653:'F7', 654:'E8', 655:'R9', 656:'R10', 657:'Q11'}\n    pep_name = name_map.get(res, f'B{res}')\n    \n    formal = \"YES\" if res >= 655 else (\"NO \u2014 present in model but below contact threshold\" if min_dist < 5.0 else \"NO\")\n    \n    print(f\"B-{res} ({pep_name}): CA-CA={ca_dist:.1f}A, shortest={min_dist:.1f}A ({min_pair[0]}-{min_pair[1]}), formal contact: {formal}\")\nPYEOF"}

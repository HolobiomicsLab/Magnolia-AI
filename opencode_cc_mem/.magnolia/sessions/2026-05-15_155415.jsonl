{"event_type":"tool_call","timestamp":"2026-06-05T08:37:21.004931Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\npdb_path = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\"\n\natoms = []\nwith open(pdb_path) as f:\n    for line in f:\n        if line.startswith(\"ATOM\"):\n            atoms.append({\n                \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                \"name\": line[12:16].strip(), \"elem\": line[76:78].strip()\n            })\n\n# Peptide atoms (chain B) \u2014 compute centroids per residue\npep_atoms = [a for a in atoms if a[\"chain\"] == \"B\"]\nrec_atoms = [a for a in atoms if a[\"chain\"] == \"A\"]\n\n# Get peptide residue order\npep_resis = sorted(set(a[\"resi\"] for a in pep_atoms))\nprint(\"Peptide residues:\", [(r, next(a[\"resn\"] for a in pep_atoms if a[\"resi\"]==r)) for r in pep_resis])\n\n# Get centroids for each peptide residue\nfor resi in pep_resis:\n    res_atoms = [a for a in pep_atoms if a[\"resi\"] == resi]\n    cx = sum(a[\"x\"] for a in res_atoms)/len(res_atoms)\n    cy = sum(a[\"y\"] for a in res_atoms)/len(res_atoms)\n    cz = sum(a[\"z\"] for a in res_atoms)/len(res_atoms)\n    resn = res_atoms[0][\"resn\"]\n    print(f\"\\n  {resn} {resi}: centroid ({cx:.1f}, {cy:.1f}, {cz:.1f})\")\n\n# N-term and C-term analysis\nn_term_centroid = [sum(a[k] for a in pep_atoms if a[\"resi\"]==pep_resis[0])/len([a for a in pep_atoms if a[\"resi\"]==pep_resis[0]]) for k in [\"x\",\"y\",\"z\"]]\nc_term_centroid = [sum(a[k] for a in pep_atoms if a[\"resi\"]==pep_resis[-1])/len([a for a in pep_atoms if a[\"resi\"]==pep_resis[-1]]) for k in [\"x\",\"y\",\"z\"]]\n\nprint(\"\\n\\n=== Receptor residues near N-terminus (K1, <6A) ===\")\nseen = set()\nnear = []\nfor a in rec_atoms:\n    d = math.sqrt((a[\"x\"]-n_term_centroid[0])**2 + (a[\"y\"]-n_term_centroid[1])**2 + (a[\"z\"]-n_term_centroid[2])**2)\n    if d < 6:\n        key = f\"{a['resn']}{a['resi']}\"\n        if key not in seen:\n            near.append((d, key, a[\"resn\"], a[\"resi\"]))\n            seen.add(key)\nfor d, key, rn, ri in sorted(near)[:15]:\n    print(f\"  {rn} {ri}: {d:.1f}A\")\n\nprint(\"\\n=== Receptor residues near C-terminus (Q5, <6A) ===\")\nseen = set()\nnear = []\nfor a in rec_atoms:\n    d = math.sqrt((a[\"x\"]-c_term_centroid[0])**2 + (a[\"y\"]-c_term_centroid[1])**2 + (a[\"z\"]-c_term_centroid[2])**2)\n    if d < 6:\n        key = f\"{a['resn']}{a['resi']}\"\n        if key not in seen:\n            near.append((d, key, a[\"resn\"], a[\"resi\"]))\n            seen.add(key)\nfor d, key, rn, ri in sorted(near)[:15]:\n    print(f\"  {rn} {ri}: {d:.1f}A\")\n\n# Backbone direction vector\nn_ca = next(a for a in pep_atoms if a[\"resi\"]==pep_resis[0] and a[\"name\"]==\"CA\")\nc_ca = next(a for a in pep_atoms if a[\"resi\"]==pep_resis[-1] and a[\"name\"]==\"CA\")\nvec = (c_ca[\"x\"]-n_ca[\"x\"], c_ca[\"y\"]-n_ca[\"y\"], c_ca[\"z\"]-n_ca[\"z\"])\nvec_len = math.sqrt(vec[0]**2 + vec[1]**2 + vec[2]**2)\nvec_norm = tuple(v/vec_len for v in vec)\nprint(f\"\\n=== Peptide backbone direction (N-term CA -> C-term CA) ===\")\nprint(f\"  Vector: ({vec[0]:.1f}, {vec[1]:.1f}, {vec[2]:.1f}), length={vec_len:.1f}A\")\nprint(f\"  Normalized: ({vec_norm[0]:.3f}, {vec_norm[1]:.3f}, {vec_norm[2]:.3f})\")\n\n# Extend beyond N-term by ~3.8A (typical CA-CA distance)\nn_ext = tuple(c - 3.8*v for c, v in zip(n_term_centroid, vec_norm))\nprint(f\"\\n=== Extended N-term position (~3.8A upstream) ===\")\nprint(f\"  Position: ({n_ext[0]:.1f}, {n_ext[1]:.1f}, {n_ext[2]:.1f})\")\nprint(\"  Receptor residues nearby:\")\nseen = set()\nfor a in rec_atoms:\n    d = math.sqrt((a[\"x\"]-n_ext[0])**2 + (a[\"y\"]-n_ext[1])**2 + (a[\"z\"]-n_ext[2])**2)\n    if d < 6:\n        key = f\"{a['resn']}{a['resi']}\"\n        if key not in seen:\n            near.append((d, key, a[\"resn\"], a[\"resi\"]))\n            seen.add(key)\nfor d, key, rn, ri in sorted(near)[:15]:\n    print(f\"  {rn} {ri}: {d:.1f}A\")\n\n# Extend beyond C-term\nc_ext = tuple(c + 3.8*v for c, v in zip(c_term_centroid, vec_norm))\nprint(f\"\\n=== Extended C-term position (~3.8A downstream) ===\")\nprint(f\"  Position: ({c_ext[0]:.1f}, {c_ext[1]:.1f}, {c_ext[2]:.1f})\")\nprint(\"  Receptor residues nearby:\")\nseen = set()\nfor a in rec_atoms:\n    d = math.sqrt((a[\"x\"]-c_ext[0])**2 + (a[\"y\"]-c_ext[1])**2 + (a[\"z\"]-c_ext[2])**2)\n    if d < 6:\n        key = f\"{a['resn']}{a['resi']}\"\n        if key not in seen:\n            near.append((d, key, a[\"resn\"], a[\"resi\"]))\n            seen.add(key)\nfor d, key, rn, ri in sorted(near)[:15]:\n    print(f\"  {rn} {ri}: {d:.1f}A\")\nPYEOF"}

on.loads(data_json)\n        except:\n            continue\n        tool = d.get('tool', '')\n        if tool != 'compchem-memory_memory_get_context':\n            continue\n        \n        count += 1\n        state = d.get('state', {})\n        inp = state.get('input', {})\n        task = inp.get('task_description', 'N/A')\n        \n        # Parse the output to see what was returned\n        output_str = state.get('output', '{}')\n        try:\n            output = json.loads(output_str)\n            content = output.get('content', '')\n            # Look for project entries specifically (skip the [PROJECT GOAL] header)\n            # Entry markers in the content: \"[session]\" or \"[project]\" or \"[skill]\" or \"[ENTRY:\" \n            entry_markers = ['[session]', '[project]', '[skill]', 'ENTRY:', 'Entry:', '## Entry:']\n            has_entries = any(m.lower() in content.lower() for m in entry_markers)\n            \n            # Count how many entries of each tier\n            n_session = content.count('[session]')\n            n_project = content.count('[project]')\n            n_skill = content.count('[skill]')\n            \n            if n_session + n_project + n_skill > 0 or has_entries:\n                print(f'CALL #{count} | {sid}')\n                print(f'Task: {task[:150]}')\n                print(f'Entries: session={n_session}, project={n_project}, skill={n_skill}')\n                print()\n        except:\n            pass\n\" 2>&1"}

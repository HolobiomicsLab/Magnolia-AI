      pres = (pk[0], pk[1], pk[2])\n        if pres not in PEPTIDE: continue\n        pname = PEP_NAMES[pres]\n        for rk, rxyz in atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                rres = (rk[0], rk[1], rk[2])\n                pres_contacts[pname][rres].append(d)\n                pocket_set.add(f'{rres[0]}-{rres[1]}{rres[2]}')\n\nprint('=== KFQRQ Cluster 2 (DockQ 0.682) ===')\nprint()\nfor pname in ['K1','F2','Q3','R4','Q5']:\n    kf_ref = {'K1':KFERQ_K1,'F2':KFERQ_F2,'Q3':KFERQ_E3,'R4':KFERQ_R4,'Q5':KFERQ_Q5}[pname]\n    contacts = pres_contacts[pname]\n    \n    rec_summary = {}\n    for rres, dists in contacts.items():\n        rec_summary[rres] = (min(dists), sum(dists)/len(dists), len(dists))\n    \n    sorted_recs = sorted(rec_summary.items(), key=lambda x: x[1][0])\n    print(f'--- {pname} ---')\n    for rres, (min_d, avg_d, n) in sorted_recs[:8]:\n        rlabel = f'{rres[1]}{rres[2]}'\n        was_kferq = '\u2713' if rres[1]+str(rres[2]) in kf_ref else ' '\n        model_str = f'{n}/4' if n < 4 else 'all'\n        print(f'  {was_kferq} {rlabel:<8s}  min {min_d:.1f}A  avg {avg_d:.1f}A  [{model_str}]')\n    print()\n\n# Pocket overlap\nprint('=== POCKET OVERLAP (KFERQ vs KFQRQ cluster 2) ===')\ncommon = pocket_set & KFERQ_ALL\nonly_kfqrq = pocket_set - KFERQ_ALL\nonly_kferq = KFERQ_ALL - pocket_set\nprint(f'  Shared: {len(common)} \u2014 {sorted(common)}')\nprint(f'  KFQRQ only: {len(only_kfqrq)} \u2014 {sorted(only_kfqrq)}')\nprint(f'  KFERQ only: {len(only_kferq)} \u2014 {sorted(only_kferq)}')\nprint(f'  Total KFQRQ pocket: {len(pocket_set)} residues')\nPYEOF\n"}

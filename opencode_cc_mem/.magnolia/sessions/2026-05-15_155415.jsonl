{"event_type":"tool_call","timestamp":"2026-06-20T19:51:24.308996Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 << 'PYEOF'\nimport csv, numpy as np\nfrom collections import defaultdict\n\nwith open(\"results/comparison.csv\") as f:\n    rows = list(csv.DictReader(f))\n\n# Group by n_rings (same n_rings = same formula for cata-condensed PBHs)\nby_rings = defaultdict(list)\nfor r in rows:\n    by_rings[int(r[\"n_rings\"])].append(r)\n\n# Compute our Erel: Etot - min(Etot) within each ring group\nfor n, group in by_rings.items():\n    our_energies = [float(r[\"Etot_our\"]) for r in group]\n    lit_energies = [float(r[\"Etot_lit\"]) for r in group]\n    our_min = min(our_energies)\n    lit_min = min(lit_energies)\n    for r, eo, el in zip(group, our_energies, lit_energies):\n        r[\"Erel_our\"] = eo - our_min\n        r[\"Erel_lit_calc\"] = el - lit_min\n\n# Collect Erel diffs\nerel_our = []\nerel_lit = []\nfor r in rows:\n    if \"Erel_our\" in r:\n        erel_our.append(r[\"Erel_our\"])\n        erel_lit.append(r[\"Erel_lit_calc\"])\n\nerel_our = np.array(erel_our)\nerel_lit = np.array(erel_lit)\ndErel = erel_our - erel_lit\nadErel = np.abs(dErel)\n\nprint(f\"Erel (relative energy within same formula), N={len(dErel)}:\")\nprint(f\"  Our range:  {erel_our.min():.3f} to {erel_our.max():.3f} eV\")\nprint(f\"  Lit range:  {erel_lit.min():.3f} to {erel_lit.max():.3f} eV\")\nprint(f\"  MAE:        {adErel.mean():.4f} eV\")\nprint(f\"  RMSE:       {np.sqrt(np.mean(dErel**2)):.4f} eV\")\nprint(f\"  max |\u0394|:    {adErel.max():.3f} eV\")\n\n# R\u00b2 for Erel\nmx, my = erel_our.mean(), erel_lit.mean()\nss_xy = np.sum((erel_our - mx) * (erel_lit - my))\nss_xx = np.sum((erel_our - mx)**2)\nss_yy = np.sum((erel_lit - my)**2)\nr2 = (ss_xy**2) / (ss_xx * ss_yy) if ss_xx * ss_yy != 0 else 0\nslope = ss_xy / ss_xx if ss_xx != 0 else 0\nprint(f\"  R\u00b2:         {r2:.4f}\")\nprint(f\"  slope:      {slope:.4f}\")\nprint()\n\nfor thresh in [0.001, 0.01, 0.1, 0.5, 1.0]:\n    pct = np.sum(adErel < thresh) / len(adErel) * 100\n    print(f\"  |\u0394Erel| < {thresh:6.3f} eV: {pct:5.1f}%\")\n\n# Also compare against published Erel_eV directly\n# The published dataset has Erel_eV column\n# Let me load it\npub_erel = {}\nwith open(\"../../raw_input/compas_data/compas-1x.csv\") as f:\n    for r in csv.DictReader(f):\n        pub_erel[r[\"molecule\"]] = float(r[\"Erel_eV\"])\n\ndErel_pub = []\nfor r in rows:\n    name = r[\"molecule\"]\n    if name in pub_erel and \"Erel_our\" in r:\n        dErel_pub.append(r[\"Erel_our\"] - pub_erel[name])\n\ndErel_pub = np.array(dErel_pub)\nprint(f\"\\n  vs published Erel_eV column: MAE={np.abs(dErel_pub).mean():.4f} eV\")\nPYEOF\n"}

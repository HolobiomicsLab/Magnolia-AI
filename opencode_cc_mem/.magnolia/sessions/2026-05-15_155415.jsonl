e(tleap_in)\n    \n    result = subprocess.run(f\"{conda_setup} && cd {work} && tleap -f tleap.in\", \n                            shell=True, capture_output=True, text=True)\n    if \"Error\" in result.stdout + result.stderr:\n        print(f\"  TLEAP ERROR: {result.stdout[-200:]}\")\n        continue\n    \n    if not os.path.exists(f\"{work}/complex.prmtop\"):\n        print(f\"  TLEAP: no prmtop generated\")\n        continue\n    \n    mmpbsa_in = \"\"\"&general\n  startframe=1, endframe=1, interval=1, keep_files=0, verbose=0,\n/\n&gb\n  igb=5, saltcon=0.150,\n/\n&decomp\n  idecomp=1, dec_verbose=3,\n/\n\"\"\"\n    with open(f\"{work}/mmpbsa.in\", 'w') as f:\n        f.write(mmpbsa_in)\n    \n    result = subprocess.run(\n        f\"{conda_setup} && cd {work} && MMPBSA.py -O -i mmpbsa.in \"\n        f\"-cp complex.prmtop -rp rec.prmtop -lp lig.prmtop \"\n        f\"-y complex.rst7 -o out.dat -do decomp.dat \"\n        f\"-sp complex.prmtop -sr complex.rst7\",\n        shell=True, capture_output=True, text=True\n    )\n    \n    # Get total\n    total_binding = \"?\"\n    if os.path.exists(f\"{work}/out.dat\"):\n        for line in open(f\"{work}/out.dat\"):\n            if \"DELTA TOTAL\" in line:\n                total_binding = line.split()[-3]\n    \n    # Parse ligand residues\n    if not os.path.exists(f\"{work}/decomp.dat\"):\n        print(f\"  MMPBSA: no decomp.dat\")\n        continue\n    \n    lig_data = []\n    seen = set()\n    for line in open(f\"{work}/decomp.dat\"):\n        if ',L ' not in line:\n            continue\n        parts = line.strip().split(',')\n        if len(parts) < 18:\n            continue\n        # Field 0 is \"RESNAME RESI\" (Amber numbering)\n        amber_name = parts[0].strip().split()[0]\n        amber_resi = parts[0].strip().split()[1]\n        haddock_info = parts[1].strip()  # \"L RESNAME RESI\"\n        \n        key = f\"{amber_name}{amber_resi}\"\n        if key in seen:\n            continue\n        seen.add(key)\n        \n        try:\n            vdw = float(parts[5])\n            elec = float(parts[8])\n            polar = float(parts[11])\n            npolar = float(parts[14])\n            total = float(parts[17])\n            interaction = vdw + elec + polar + npolar\n            lig_data.append((haddock_info.split()[-2] + haddock_info.split()[-1], vdw, elec, polar, npolar, total, interaction))\n        except (ValueError, IndexError) as e:\n            pass\n    \n    print(f\"  \u0394G_total = {total_binding} kcal/mol\")\n    for key, v, e, p, n, t, i in lig_data:\n        print(f\"    {key:8s} vdW={v:+7.2f} elec={e:+7.1f} polar={p:+7.1f} np={n:+5.2f} \u2192 int={i:+7.1f}\")\n\nPYEOF"}

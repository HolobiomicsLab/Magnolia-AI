{"event_type":"tool_call","timestamp":"2026-06-24T10:32:06.703833Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport json\nruns = [\n  (\"RKALQ (parent)\",  \"2026-06-17_RKALQ_s5000\"),\n  (\"RKVLQ A3->V\",     \"2026-06-18_RKVLQ_s5000\"),\n  (\"RKILQ A3->I\",     \"2026-06-18_RKILQ_s5000\"),\n  (\"RKLLQ A3->L\",     \"2026-06-18_RKLLQ_s5000\"),\n  (\"TGFMALQ (parent)\",\"2026-06-17_TGFMALQ_s10000\"),\n  (\"TAFMALQ G2->A\",   \"2026-06-18_TAFMALQ_s10000\"),\n]\nfor label, r in runs:\n    wp = f\"{r}/output/12_caprieval/weights_params.json\"\n    W=dict()\n    try:\n        d = json.load(open(wp))\n        for k in ['w_air','w_vdw','w_elec','w_desolv']: W[k]=d.get(k)\n    except Exception:\n        for k in ['w_air','w_vdw','w_elec','w_desolv']: W[k]='NA'\n    print(f\"\\n###### {label}  [{r}] ######\")\n    print(f\"weights: w_vdw={W['w_vdw']} w_elec={W['w_elec']} w_desolv={W['w_desolv']} w_air={W['w_air']}\")\n    tsv = f\"{r}/output/analysis/12_caprieval_analysis/capri_clt.tsv\"\n    rows=[]; hdr=None; idx={}\n    with open(tsv) as f:\n        for line in f:\n            if line.startswith('#') or not line.strip(): continue\n            if hdr is None:\n                hdr=line.rstrip('\\n').split('\\t'); idx={c:i for i,c in enumerate(hdr)}; continue\n            rows.append(line.rstrip('\\n').split('\\t'))\n    def g(rw,c):\n        i=idx.get(c); return rw[i] if i is not None and i<len(rw) else 'NA'\n    print(f\"{'clt':>4} {'n':>4} {'score':>9} {'air':>8} {'airfree':>9} {'vdw':>9} {'elec':>9} {'desolv':>7} {'dockq':>6} {'irmsd':>6} {'rank':>4}\")\n    for rw in rows[:3]:\n        try:\n            score=float(g(rw,'score')); air=float(g(rw,'air'))\n            af = score - W['w_air']*air if isinstance(W['w_air'],(int,float)) else None\n            afs = f\"{af:.3f}\" if af is not None else 'NA'\n        except Exception:\n           
{"event_type":"tool_success","timestamp":"2026-06-17T20:03:06.365868Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":37,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-17T20:03:28.051931Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, os\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\n\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38])\n        y = float(line[38:46])\n        z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26])\n        atomname = line[12:16].strip()\n        atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef get_atom(chain, resid, atomname):\n    for a in atoms:\n        if a[0] == chain and a[2] == resid and a[3] == atomname:\n            return a[4], a[5], a[6]\n    return None\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vec_len(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef normalize(v):\n    l = vec_len(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\n# ============================================================\n# 1. PEPTIDE POSITION & BINDING POCKET\n# ============================================================\n\npep_atoms = [(a[1], a[2], a[3], a[4], a[5], a[6]) for a in atoms if a[0] == 'B']\nrec_atoms = [(a[1], a[2], a[3], a[4], a[5], a[6]) for a in atoms if a[0] == 'A']\n\nprint(\"=\" * 70)\nprint(\"RKALQ \u2014 BINDING POCKET (receptor residues within 5.0 \u00c5 of peptide)\")\nprint(\"=\" * 70)\n\nrec_by_res = {}\nfor rn, rid, aname, rx, ry, rz in rec_atoms:\n    if rid not in rec_by_res:\n        rec_by_res[rid] = {\"resname\": rn, \"atoms\": []}\n    rec_by_res[rid][\"atoms\"].append((rx, ry, rz))\n\npocket = {}\nfor rid in sorted(rec_by_res.keys()):\n    info = rec_by_res[rid]\n    min_d = min(dist((px,py,pz), ra) for ra in info[\"atoms\"] for _,_,_,px,py,pz in pep_atoms)\n    if min_d <= 5.0:\n        pocket[rid] = {\"resname\": info[\"resname\"], \"min_dist\": min_d}\n\nsbd_start, lid_start = 386, 531\nfor rid in sorted(pocket.keys()):\n    info = pocket[rid]\n    if rid >= lid_start:\n        domain = \"LID\"\n    elif rid >= sbd_start:\n        domain = \"SBD\u03b2\"\n    else:\n        domain = \"NBD\"\n    print(f\"{rid:5d} {info['resname']:>4s}  {info['min_dist']:6.2f} \u00c5  {domain}\")\n\nprint(f\"\\nTotal: {len(pocket)}\")\n\n# Check for lid contacts\nlid_contacts = [r for r in pocket if r >= lid_start]\nprint(f\"LID contacts: {lid_contacts if lid_contacts else 'NONE'}\")\n\n# ============================================================\n# 2. COMPARE WITH RKDLQ POCKET\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"RKALQ vs RKDLQ \u2014 POCKET COMPARISON\")\nprint(\"=\" * 70)\n\n# Load RKDLQ pocket from earlier analysis (we already computed it)\nrkd_pocket = {403:'ILE', 404:'GLU', 405:'THR', 406:'ALA', 407:'GLY', 408:'GLY',\n              428:'PHE', 429:'THR', 430:'THR', 431:'TYR', 432:'SER', 435:'GLN',\n              436:'PRO', 437:'GLY', 438:'VAL', 439:'LEU', 440:'ILE', 441:'GLN',\n              443:'TYR', 460:'GLU', 462:'THR', 469:'ARG', 474:'ILE', 476:'VAL',\n              540:'ASN', 543:'GLU', 544:'SER'}\n\nshared = set(pocket.keys()) & set(rkd_pocket.keys())\nrkalq_only = set(pocket.keys()) - set(rkd_pocket.keys())\nrkd_only = set(rkd_pocket.keys()) - set(pocket.keys())\n\nprint(f\"Shared: {len(shared)} \u2014 {sorted(shared)}\")\nprint(f\"RKALQ-only: {rkalq_only}\")\nprint(f\"RKDLQ-only (LOST in RKALQ): {sorted(rkd_only)}\")\n\n# ============================================================\n# 3. L4 HYDROPHOBIC ANCHOR CHECK\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"L4 HYDROPHOBIC ANCHOR \u2014 contact comparison\")\nprint(\"=\" * 70)\n\n# From contact maps, compare L4's key contacts\nl4_targets = {403: \"ILE\", 404: \"GLU\", 405: \"THR\", 406: \"ALA\", \n              428: \"PHE\", 429: \"THR\", 438: \"VAL\", 439: \"LEU\", 440: \"ILE\"}\n\nl4_rkalq = get_atom('B', 4, 'CB')\nprint(f\"\\nL4 (RKALQ) C\u03b2 position: ({l4_rkalq[0]:.2f}, {l4_rkalq[1]:.2f}, {l4_rkalq[2]:.2f})\")\n\nfor rid, name in l4_targets.items():\n    r_atoms = rec_by_res.get(rid, {}).get(\"atoms\", [])\n    if not r_atoms:\n        print(f\"  A-{rid}-{name}: NOT IN RECEPTOR\")\n        continue\n    d = min(dist(l4_rkalq, ra) for ra in r_atoms)\n    in_pocket = \"IN POCKET\" if rid in pocket else \"\"\n    print(f\"  A-{rid}-{name}: L4_C\u03b2 \u2192 {d:.2f} \u00c5  {in_pocket}\")\n\n# ============================================================\n# 4. N-TERMINAL GEOMETRY (for extension panel)\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"N-TERMINAL EXTENSION GEOMETRY (RKALQ)\")\nprint(\"=\" * 70)\n\nN_pos = get_atom('B', 1, 'N')\nCA_pos = get_atom('B', 1, 'CA')\nC_pos = get_atom('B', 1, 'C')\nCB_pos = get_atom('B', 1, 'CB')\n\nCA_to_N = vec(CA_pos, N_pos)\nca_to_n_norm = normalize(CA_to_N)\n\nnew_ca_pos = tuple(N_pos[i] + ca_to_n_norm[i] * 3.0 for i in range(3))\nca_to_cb = vec(CA_pos, CB_pos)\nca_to_cb_norm = normalize(ca_to_cb)\nnew_cb_pos = tuple(new_ca_pos[i] + ca_to_cb_norm[i] * 1.53 for i in range(3))\n\nprint(f\"N position:     ({N_pos[0]:.2f}, {N_pos[1]:.2f}, {N_pos[2]:.2f})\")\nprint(f\"CA\u2192N direction: ({ca_to_n_norm[0]:.3f}, {ca_to_n_norm[1]:.3f}, {ca_to_n_norm[2]:.3f})\")\nprint(f\"New C\u03b1:         ({new_ca_pos[0]:.2f}, {new_ca_pos[1]:.2f}, {new_ca_pos[2]:.2f})\")\nprint(f\"New C\u03b2:         ({new_cb_pos[0]:.2f}, {new_cb_pos[1]:.2f}, {new_cb_pos[2]:.2f})\")\n\n# Target residues: 431 (TYR), 469 (ARG), 543 (GLU) \u2014 from original analysis\ntargets = {\n    431: (\"TYR\", \"SBD\u03b2\"),\n    469: (\"ARG\", \"SBD\u03b2\"),\n    543: (\"GLU\", \"LID\"),\n}\n\nprint()\nprint(f\"{'Target':>12s} {'N\u2192tgt':>7s} {'newC\u03b2\u2192tgt':>9s} {'Angle':>6s} {'Verdict'}\")\nprint(\"-\" * 55)\n\nfor t_resid, (t_name, t_domain) in targets.items():\n    r_atoms = rec_by_res.get(t_resid, {}).get(\"atoms\", [])\n    if not r_atoms:\n        print(f\"{t_name}{t_resid}: NOT IN MODEL\")\n        continue\n    \n    d_n = min(dist(N_pos, ra) for ra in r_atoms)\n    d_cb = min(dist(new_cb_pos, ra) for ra in r_atoms)\n    \n    new_ca_dir = normalize(vec(N_pos, new_ca_pos))\n    closest_ra = min(r_atoms, key=lambda ra: dist(N_pos, ra))\n    target_dir = normalize(vec(N_pos, closest_ra))\n    \n    angle = math.degrees(math.acos(max(-1, min(1, dot(new_ca_dir, target_dir)))))\n    \n    if angle < 60:\n        v = \"FAVORABLE\"\n    elif angle < 90:\n        v = \"marginal\"\n    else:\n        v = \"AGAINST\"\n    \n    marker = \"\"\n    if t_resid in pocket:\n        marker = \" [IN POCKET]\"\n    \n    print(f\"{t_name}{t_resid} ({t_domain:>5s})  {d_n:5.1f}  {d_cb:7.1f}   {angle:5.1f}\u00b0  {v}{marker}\")\n\n# ============================================================\n# 5. C-TERMINAL DIRECTION\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"C-TERMINAL EXTENSION GEOMETRY (RKALQ)\")\nprint(\"=\" * 70)\n\nCterm_C = get_atom('B', 5, 'C')\nCterm_CA = get_atom('B', 5, 'CA')\nca5_to_c5 = vec(Cterm_CA, Cterm_C)\nca5_to_c5_norm = normalize(ca5_to_c5)\n\nfor t_resid, (t_name, t_domain) in targets.items():\n    r_atoms = rec_by_res.get(t_resid, {}).get(\"atoms\", [])\n    if not r_atoms:\n        continue\n    d = min(dist(Cterm_C, ra) for ra in r_atoms)\n    closest = min(r_atoms, key=lambda ra: dist(Cterm_C, ra))\n    target_dir = normalize(vec(Cterm_C, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ca5_to_c5_norm, target_dir)))))\n    v = \"favorable\" if angle < 90 else \"AGAINST\"\n    print(f\"  {t_name}{t_resid}: dist={d:.1f} \u00c5, angle={angle:.0f}\u00b0 ({v})\")\n\n# Also check lid residues near C-term\nprint()\nprint(\"Nearest lid residues to C-term:\")\nfor rid in sorted(rec_by_res.keys()):\n    if rid < lid_start:\n        continue\n    d = min(dist(Cterm_C, ra) for ra in rec_by_res[rid][\"atoms\"])\n    if d < 12.0:\n        print(f\"  A-{rid}-{rec_by_res[rid]['resname']}: {d:.1f} \u00c5\")\n\nPYEOF"}

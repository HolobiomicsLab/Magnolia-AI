sts.items():\n    tr = np.array([a['xyz'] for a in get_backbone(path, 'A', (1,9999))])\n    tp = np.array([a['xyz'] for a in get_backbone(path, 'B', (646,651))])\n    rd, R, rc_r, rc_t = kabsch_rmsd(ref_rec, tr)\n    pt = tp - rc_t\n    pr = pt @ R.T\n    pa = pr + rc_r\n    d = ref_pep - pa\n    r = np.sqrt(((d)**2).sum() / len(ref_pep))\n    m = \"SAME\" if r < 2.0 else (\"DIFF\" if r < 4.0 else \"FAR\")\n    print(f\"{name:<10} {rd:>9.3f} {r:>9.3f} {m:>6}\")\nPYEOF"}

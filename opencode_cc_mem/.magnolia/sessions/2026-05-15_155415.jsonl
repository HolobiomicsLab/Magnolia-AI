{"event_type":"tool_call","timestamp":"2026-06-24T13:11:44.613598Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new\npython3 - <<'PY'\nimport numpy as np\ndef ca_chain(path):\n    d={}\n    for line in open(path):\n        if not line.startswith('ATOM') or line[12:16].strip()!='CA': continue\n        if line[21] not in ('A',' '): continue\n        try: res=int(line[22:26]); x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n        except ValueError: continue\n        d[res]=(line[17:20].strip(),np.array([x,y,z]))\n    return d\npo2=ca_chain(\"raw_input/receptor/4po2_chainA.pdb\"); af3=ca_chain(\"runs/2026-06-17_RKALQ_s5000/receptor.pdb\")\ncommon=[r for r in sorted(set(po2)&set(af3)) if po2[r][0]==af3[r][0]]  # identical residues only\n\ndef fit(P,Q):\n    Pc=P-P.mean(0); Qc=Q-Q.mean(0); H=Pc.T@Qc\n    U,S,Vt=np.linalg.svd(H); d=np.sign(np.linalg.det(Vt.T@U.T))\n    R=Vt.T@np.diag([1,1,d])@U.T; Pr=Pc@R.T\n    return Pr,Qc,np.sqrt(((Pr-Qc)**2).sum(1).mean())\n\ndef reg(lo,hi):\n    return [r for r in common if lo<=r<=hi]\n\n# independent fits\nfor lo,hi,lbl in [(386,508,\"\u03b2-sandwich (386-508)\"),(509,613,\"\u03b1-lid (509-613)\"),(386,613,\"whole SBD (386-613)\")]:\n    rs=reg(lo,hi)\n    if len(rs)<3: continue\n    P=np.array([po2[r][1] for r in rs]); Q=np.array([af3[r][1] for r in rs])\n    _,_,r=fit(P,Q); print(f\"independent fit  {lbl:24s} n={len(rs):3d}  RMSD={r:5.2f} \u00c5\")\n\n# hinge test: align on \u03b2-sandwich, measure where lid lands (quantifies relative motion)\nsb=reg(386,508); ld=reg(509,613)\nPs=np.array([po2[r][1] for r in sb]); Qs=np.array([af3[r][1] for r in sb])\nPsc,Qsc,_=fit(Ps,Qs)            # rotation from sandwich fit\n# apply same centering/rotation idea: refit to get R on sandwich, then apply to lid\nPsc2=Ps-Ps.mean(0); Qsc2=Qs-Qs.mean(0); H=Psc2.T@Qsc2\nU,S,Vt=np.linalg.svd(H); d=np.sign(np.linalg.det(Vt.T@U.T)); R=Vt.T@np.diag([1,1,d])@U.T\n# transform 4PO2 lid into AF3 frame using sandwich R+translation\nPl=np.array([po2[r][1] for r in ld]); Ql=np.array([af3[r][1] for r in ld])\nPl_x=(Pl-Ps.mean(0))@R.T + Qs.mean(0)\nlid_after=np.sqrt(((Pl_x-Ql)**2).sum(1).mean())\nprint(f\"\\nwhen aligned on \u03b2-sandwich, the \u03b1-lid sits at  RMSD={lid_after:5.2f} \u00c5  (quantifies sandwich\u2194lid hinge)\")\nPY"}

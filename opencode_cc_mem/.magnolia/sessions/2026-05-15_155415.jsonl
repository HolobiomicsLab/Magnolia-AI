{"event_type":"tool_call","timestamp":"2026-06-24T14:49:05.539904Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-24_alascan_tggfqmalt_af3\nf=output/1_alascan/scan_complex_haddock.tsv\necho \"=== raw file (header + all rows) ===\"\ngrep -v '^#' \"$f\"\necho\necho \"=== interpret: \u0394score vs native (WT). native = ? ===\"\npython3 - \"$f\" <<'PY'\nimport sys\nf=sys.argv[1]\nhdr=None;rows=[]\nfor line in open(f):\n    if line.startswith('#') or not line.strip(): continue\n    c=line.rstrip().split('\\t')\n    if hdr is None: hdr=c; continue\n    rows.append(c)\nprint(\"cols:\",hdr[:8])\n# score = col 4 (index 4)\n# Find WT/native: rows where ori_resname==end_resname? or take the unmutated ref. \n# HADDOCK alascan: each row = a mutant (X->A). native not in rows; use median as ref, AND report absolute.\nseq=[(int(r[1]),r[2],r[3],float(r[4]),float(r[5]),float(r[6]),float(r[7])) for r in rows]  # res,ori,end,score,vdw,elec,desolv\nimport statistics\nref=statistics.median(s[3] for s in seq)\nprint(f\"ref (median mutant score)={ref:.2f}\\n\")\nprint(f\"{'pos':>3}{'Torielli':>3}{'res':>5}{'mut_score':>11}{'\u0394vs_ref':>9}{'vdw':>8}{'elec':>9}{'desolv':>8}  call\")\ntorielli={2:'T1',3:'G2',4:'G3',5:'F4',6:'Q5',7:'M6',8:'A7',9:'L8',10:'T9'}\nfor res,ori,end,sc,vdw,elec,des in seq:\n    d=sc-ref\n    if ori=='ALA': call=\"(already Ala)\"\n    elif d<-1.5: call=\"DETRIMENTAL -> mutate helps\"\n    elif d>1.5: call=\"CONTRIBUTES (keep)\"\n    else: call=\"~neutral/free\"\n    print(f\"{res:>3}{torielli.get(res,'?'):>3}{ori:>5}{sc:>11.2f}{d:>9.2f}{vdw:>8.2f}{elec:>9.2f}{des:>8.2f}  {call}\")\nPY"}
{"event_type":"tool_success","timestamp":"2026-06-24T14:49:05.593469Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":53,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-24T14:54:46.176587Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-24_alascan_tggfqmalt_af3\npython3 - <<'PY'\nimport math\ndef parse(path):\n    rec={};pep={}\n    for line in open(path):\n        if not line.startswith('ATOM'): continue\n        ch=line[21]; res=int(line[22:26]); nm=line[12:16].strip(); rn=line[17:20].strip()\n        if nm.startswith('H'): continue\n        try: x,y,z=float(line[30:38]),float(line[38:46]),float(line[46:54])\n        except: continue\n        (pep if ch=='B' else rec).setdefault((ch,res,rn),[]).append((nm,x,y,z))\n    return rec,pep\nrec,pep=parse(\"complex.pdb\")\ndef cls(rn):\n    if rn in ('ARG','LYS'): return '+'\n    if rn in ('ASP','GLU'): return '-'\n    if rn in ('ALA','VAL','LEU','ILE','PHE','MET','PRO','TRP'): return '\u03a6'\n    return 'p'  # polar (SER,THR,GLN,ASN,HIS,TYR,CYS)\ndef mindist(a1,a2):\n    return min(math.sqrt((x-px)**2+(y-py)**2+(z-pz)**2) for nx,x,y,z in a1 for _,px,py,pz in a2)\n\nfor label,ptgt in [(\"T1 (B-2 THR)\",(2,'THR')),(\"G2 (B-3 GLY)\",(3,'GLY'))]:\n    pres,prn=ptgt\n    pa=pep[('B',pres,prn)]\n    # receptor residues within 7A of any peptide atom at this position\n    near=[]\n    for (ch,res,rn),ats in rec.items():\n        d=mindist(pa,ats)\n        if d<=7.0: near.append((d,res,rn,cls(rn)))\n    near.sort()\n    print(f\"\\n===== {label} =====\")\n    print(f\"  receptor residues within 7 \u00c5 (dist, res, type):\")\n    for d,res,rn,c in near:\n        print(f\"    {res:>4} {rn:>4} [{c}]  {d:4.1f} \u00c5\")\n    # nearest cations (for T1->E salt bridge) / hydrophobes (for G2->A)\n    cats=[(d,res,rn) for d,res,rn,c in near if c=='+']\n    hyd=[(d,res,rn) for d,res,rn,c in near if c=='\u03a6']\n    print(f\"  nearest cation (+): {cats[:3] if cats else 'NONE within 7\u00c5'}\")\n    print(f\"  nearest hydrophobe (\u03a6): {hyd[:3] if hyd else 'NONE'}\")\nPY"}
{"event_type":"tool_success","timestamp":"2026-06-24T14:54:46.238323Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":62,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-24T15:01:09.192448Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-24_alascan_tggfqmalt_af3\npython3 - <<'PY'\nimport numpy as np, math\ndef atoms(path):\n    R=[];P={}\n    for line in open(path):\n        if not line.startswith('ATOM'): continue\n        ch=line[21];res=int(line[22:26]);nm=line[12:16].strip();rn=line[17:20].strip()\n        if nm.startswith('H'): continue\n        try: v=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])\n        except: continue\n        (P if ch=='B' else R).append((ch,res,rn,nm,v))\n    return np.array([a[4] for a in R]),R,P\nrec_xyz,rec,R,P=atoms(\"complex.pdb\")\ndef getb(p,res,nm):\n    for ch,r,rn,n,v in p:\n        if r==res and n==nm: return v\n    return None\n\nprint(\"######## (a) G2 (B-3 GLY) methyl clearance scan ########\")\nCA=getb(P,3,'CA'); N=getb(P,3,'N'); C=getb(P,3,'C')\n# backbone bond directions to AVOID\nbN=(N-CA)/np.linalg.norm(N-CA); bC=(C-CA)/np.linalg.norm(C-CA)\n# fibonacci sphere sample\ndef fib(n):\n    pts=[]; phi=math.pi*(3-5**.5)\n    for i in range(n):\n        y=1-(i/(n-1))*2; r=math.sqrt(1-y*y); th=phi*i\n        pts.append(np.array([r*math.cos(th),y,r*math.sin(th)]))\n    return pts\nbest=None\nfor d in fib(1500):\n    d=d/np.linalg.norm(d)\n    if abs(np.dot(d,bN))>math.cos(math.radians(50)) or abs(np.dot(d,bC))>math.cos(math.radians(50)): continue\n    mp=CA+1.52*d   # methyl carbon position\n    dd=np.linalg.norm(rec_xyz-mp,axis=1); mn=dd.min(); idx=dd.argmin()\n    if best is None or mn>best[0]:\n        best=(mn,rec[idx])\nclr,atom=best\nprint(f\"  best methyl-carbon clearance: {clr:.2f} \u00c5  (nearest receptor atom: {atom[1]} {atom[3]} of {atom[2]}{atom[1]})\")\nprint(f\"  current nearest receptor atom to G2 CA: {np.linalg.norm(rec_xyz-CA,axis=1).min():.2f} \u00c5\")\nprint(f\"  interpretation: {'CLEARS (methyl fits, >3.4\u00c5)' if clr>=3.4 else ('TIGHT (3.0-3.4\u00c5)' if clr>=3.0 else 'CLASH (<3.0\u00c5)')}\")\nprint(f\"  => G2->A is {'geometrically VIABLE' if clr>=3.4 else 'geometrically RISKY' if clr>=3.0 else 'likely CLASHES'}\")\n\nprint(\"\\n######## (b) T9 (B-10) C-terminal extension direction ########\")\ndef getres(p,res):\n    d={}\n    for ch,r,rn,n,v in p:\n        if r==res: d[n]=v\n    return d\nt9=getres(P,10)\nCA9=t9['CA']; C9=t9['C']\ndC=(C9-CA9)/np.linalg.norm(C9-CA9)   # C-terminal growth dir\ndef ang(u,v):\n    return math.degrees(math.acos(max(-1,min(1,np.dot(u/np.linalg.norm(u),v/np.linalg.norm(v))))))\nprint(f\"  T9 CA->C growth direction vs nearby SBD residues (small angle = extension reaches it):\")\ntargets=[('N548','A',548),('R469','A',469),('G623','A',623),('P622','A',622),('F625','A',625),('V471','A',471),('S544','A',544)]\nfor nm,ch,res in targets:\n    # closest atom of that residue to T9 CA\n    rs=[a for a in R if a[1]==res and a[0]==ch]\n    if not rs: continue\n    ca=np.array([a[4] for a in rs]); d=ca-CA9\n    dd=np.linalg.norm(d,axis=1); j=dd.argmin()\n    print(f\"    {nm:5s}: closest-atom dist {dd[j]:4.1f} \u00c5, angle to growth dir {ang(dC,d[j]):5.1f}\u00b0\")\n# also: does extension point toward NBD (res<384) or stay SBD?\nprint(f\"  T9 CA residue context: extension stays in lid/post-lid SBD region (540-625)\")\nPY"}

{"event_type":"tool_call","timestamp":"2026-06-13T10:26:45.586422Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, math\n\ndef convert_pdb(inpath, outpath, start_resi, chain_id='B'):\n    \"\"\"Convert tleap PDB: renumber residues, add chain, renumber atoms.\"\"\"\n    lines = []\n    with open(inpath, 'r') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                lines.append(line)\n    \n    # First pass: map old resi -> new resi\n    resi_map = {}\n    resi_counter = start_resi\n    for line in lines:\n        old_resi = line[22:26].strip()\n        if old_resi not in resi_map:\n            resi_map[old_resi] = resi_counter\n            resi_counter += 1\n    \n    # Second pass: write with renumbering\n    atom_num = 1\n    with open(outpath, 'w') as out:\n        for line in lines:\n            old_resi = line[22:26].strip()\n            new_resi = resi_map[old_resi]\n            new_line = (\n                line[:6] +                                          # ATOM/HETATM\n                f\"{atom_num:5d}\" +                                  # atom serial\n                line[11:17] +                                       # atom name\n                line[17:21] +                                       # residue name + space\n                f\" {chain_id}\" +                                    # chain ID\n                f\"{new_resi:4d}\" +                                  # residue number\n                line[26:]                                           # rest (coords etc)\n            )\n            out.write(new_line)\n            atom_num += 1\n        out.write('END\\n')\n    \n    print(f'Wrote {outpath}: {len(lines)} atoms, residues {start_resi}-{resi_counter-1}')\n    return outpath\n\nconvert_pdb('/tmp/fusion_uc.pdb', '/tmp/fusion_fixed.pdb', 647)\nconvert_pdb('/tmp/qrkelx2_uc.pdb', '/tmp/qrkelx2_fixed.pdb', 647)\n\n# Verify\nfor fname, label in [('/tmp/fusion_fixed.pdb', 'fusion'), ('/tmp/qrkelx2_fixed.pdb', 'QRKELx2')]:\n    print(f'\\n=== {label} backbone check ===')\n    atoms = []\n    with open(fname, 'r') as f:\n        for line in f:\n            if line.startswith('ATOM') and 'CA' in line[12:16]:\n                chain = line[21] if len(line) > 21 else ' '\n                resn = line[17:20].strip()\n                resi = line[22:26].strip()\n                x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n                atoms.append((chain, resn, resi, x, y, z))\n    breaks = []\n    for i in range(1, len(atoms)):\n        dx = atoms[i][3] - atoms[i-1][3]; dy = atoms[i][4] - atoms[i-1][4]; dz = atoms[i][5] - atoms[i-1][5]\n        d = math.sqrt(dx*dx+dy*dy+dz*dz)\n        if d > 5.0:\n            breaks.append(f'  {atoms[i-1][1]}{atoms[i-1][2]} -> {atoms[i][1]}{atoms[i][2]}: {d:.1f}A')\n    if breaks:\n        for b in breaks: print(b)\n    else:\n        print('  All CA-CA distances normal')\n    for a in atoms:\n        print(f'    {a[0]} {a[1]} {a[2]}')\nPYEOF"}

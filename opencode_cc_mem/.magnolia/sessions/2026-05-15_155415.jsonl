{"event_type":"tool_call","timestamp":"2026-06-09T10:02:42.895321Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport os, re\n\nname_map = {\n    'Z11-16-Ald': 'Z11-16-Ald_opt.sdf',\n    'Z9-14-Ald': 'Z9-14-Ald_opt.sdf',\n    'Cedrol': 'Cedrol_opt.sdf',\n    '\u03b2-Ionone': '\u03b2-Ionone_opt.sdf',\n    'Decanoic_acid': 'Decanoic_acid_opt.sdf',\n}\n\nfor name, fn in name_map.items():\n    sdf_path = f'ligands_xtb_opt/{fn}'\n    if not os.path.exists(sdf_path):\n        print(f\"  {name}: MISSING\"); continue\n    with open(sdf_path) as f: content = f.read()\n    lines = content.strip().split('\\n')\n    header = lines[0].strip()\n    natoms = int(lines[3][:3].strip())\n    \n    # Build atom list\n    atoms = []\n    for j in range(4, 4 + natoms):\n        l = lines[j]\n        try:\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            elem = l[31:34].strip() if len(l) > 33 else '?'\n            atoms.append((elem, x, y, z))\n        except: continue\n    \n    # End-to-end of carbon skeleton\n    c_coords = [(x,y,z) for e,x,y,z in atoms if e == 'C']\n    if len(c_coords) >= 2:\n        d = ((c_coords[0][0]-c_coords[-1][0])**2 + (c_coords[0][1]-c_coords[-1][1])**2 + (c_coords[0][2]-c_coords[-1][2])**2)**0.5\n    \n    # Check bond lengths for aldehyde: find C=O\n    o_atoms = [(x,y,z) for e,x,y,z in atoms if e == 'O']\n    c_atoms_full = [(i, x, y, z) for i, (e, x, y, z) in enumerate(atoms) if e == 'C']\n    \n    print(f\"{name:<22s} atoms={natoms:3d}  C_end2end={d:.1f} \u00c5  C-count={len(c_coords)}  O-count={len(o_atoms)}\")\n\n# Also check all SDF sizes\nprint(f\"\\n\u2550\u2550\u2550 SDF sanity check \u2550\u2550\u2550\")\nfor f in sorted(os.listdir('ligands_xtb_opt')):\n    if f.endswith('_opt.sdf'):\n        path = f'ligands_xtb_opt/{f}'\n        sz = os.path.getsize(path)\n        flag = \" \u26a0 SMALL\" if sz < 1000 else \"\"\n        print(f\"  {f:<40s} {sz:>6d} bytes{flag}\")\nPYEOF"}

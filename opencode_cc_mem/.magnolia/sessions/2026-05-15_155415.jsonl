lower() or 'memory' in text.lower() or 'sampling' in text.lower() or 'time_limit' in text.lower()):\n                total_parts += 1\n                submits.append((role, text))\n        except:\n            pass\n    \n    if submits:\n        submit_hits += len(submits)\n        print(f'=== {sess_id} ({len(submits)} submit_job hits) ===')\n        for role, text in submits[:3]:\n            print(f'  [{role}] {text[:500]}')\n            print()\n\nprint(f'Total: {total_msgs} messages across {len(sessions)} sessions, {submit_hits} submit_job param hits')\nconn.close()\n\" 2>&1 | head -300"}

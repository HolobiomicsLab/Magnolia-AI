{"event_type":"tool_call","timestamp":"2026-06-22T12:42:12.465766Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full/output/11_seletopclusts\npython3 << 'EOF'\nimport numpy as np\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                chain = line[21].strip()\n                resname = line[17:20].strip()\n                resnum = int(line[22:26])\n                atomname = line[12:16].strip()\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                el = line[76:78].strip() or atomname[0]\n                if el == 'H' or atomname[0] == 'H':\n                    continue\n                atoms.append({'chain':chain,'resnum':resnum,'resname':resname,\n                              'atom':atomname,'xyz':np.array([x,y,z])})\n    return atoms\n\natoms = parse_pdb('/tmp/cluster3_model1.pdb')\nrec = [a for a in atoms if a['chain']=='A']\npep = [a for a in atoms if a['chain']=='B']\n\nseq = {1:'K',2:'F',3:'E',4:'R',5:'Q',6:'K',7:'I',8:'L',9:'D',10:'Q',11:'R',12:'F',13:'F',14:'E'}\n\n# For positions 3 and 4, find ALL receptor atoms within 5A and identify types\nprint(\"=== Atom-level analysis: Pos 3 (E) \u2014 why no contact? ===\")\nfor bres in [3]:\n    pa = [a for a in pep if a['resnum']==bres]\n    hits = []\n    for p in pa:\n        for r in rec:\n            d = np.linalg.norm(p['xyz'] - r['xyz'])\n            if d < 5.5:\n                hits.append((d, r['resnum'], r['resname'], r['atom'], p['atom']))\n    hits.sort()\n    for d, rnum, rname, ratom, patom in hits[:12]:\n        print(f\"  B3-{patom} ... A{rnum} {rname}-{ratom}  {d:.2f} A\")\n    if not hits:\n        print(\"  (nothing within 5.5 A)\")\n\nprint(\"\\n=== Atom-level analysis: Pos 4 (R) \u2014 should salt bridge? ===\")\nfor bres in [4]:\n    pa = [a for a in pep if a['resnum']==bres]\n    hits = []\n    for p in pa:\n        for r in rec:\n            d = np.linalg.norm(p['xyz'] - r['xyz'])\n            if d < 5.5:\n                hits.append((d, r['resnum'], r['resname'], r['atom'], p['atom']))\n    hits.sort()\n    for d, rnum, rname, ratom, patom in hits[:12]:\n        print(f\"  B4-{patom} ... A{rnum} {rname}-{ratom}  {d:.2f} A\")\n    if not hits:\n        print(\"  (nothing within 5.5 A)\")\n\nprint(\"\\n=== Atom-level: Pos 1 (K) and Pos 2 (F) ===\")\nfor bres in [1, 2]:\n    pa = [a for a in pep if a['resnum']==bres]\n    hits = []\n    for p in pa:\n        for r in rec:\n            d = np.linalg.norm(p['xyz'] - r['xyz'])\n            if d < 5.0:\n                hits.append((d, r['resnum'], r['resname'], r['atom'], p['atom']))\n    hits.sort()\n    print(f\"  Pos {bres} ({seq[bres]}): {len(hits)} atom pairs <5A\")\n    for d, rnum, rname, ratom, patom in hits[:6]:\n        print(f\"    B{bres}-{patom} ... A{rnum} {rname}-{ratom}  {d:.2f} A\")\n\n# Check the distance between peptide N-terminus (B1 CA) and C-terminus (B14 CA)\nb1 = [a for a in pep if a['resnum']==1 and a['atom']=='CA'][0]\nb14 = [a for a in pep if a['resnum']==14 and a['atom']=='CA'][0]\nprint(f\"\\n=== Peptide span: B1-CA to B14-CA = {np.linalg.norm(b1['xyz']-b14['xyz']):.1f} A ===\")\n\n# Per-residue CA distance to nearest receptor CA (binding footprint)\nprint(\"\\n=== Binding footprint: CA-CA distance to nearest receptor residue ===\")\nfor bres in range(1, 15):\n    bca = [a for a in pep if a['resnum']==bres and a['atom']=='CA']\n    if not bca:\n        continue\n    min_d = 999\n    min_res = None\n    for r in rec:\n        if r['atom'] == 'CA':\n            d = np.linalg.norm(bca[0]['xyz'] - r['xyz'])\n            if d < min_d:\n                min_d = d\n                min_res = f\"A{r['resnum']}{r['resname']}\"\n    print(f\"  B{bres:>2}{seq[bres]:>2}  nearest receptor CA: {min_res} @ {min_d:.1f} A  {'<< IN GROOVE' if min_d < 10 else '<< OUTSIDE'}\")\nEOF"}

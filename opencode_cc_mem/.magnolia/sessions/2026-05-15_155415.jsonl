{"event_type":"tool_call","timestamp":"2026-06-10T13:03:01.785089Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\n# Box center: Asn90 centroid (36.7, -29.4, -1.6)\n# Box size: 15x15x15 -> half = 7.5\n\ncx, cy, cz = 36.7, -29.4, -1.6\nhalf = 7.5\n\nresidues_in_box = set()\nall_residues = set()\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box/receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        res = l[17:20].strip()\n        resnum = int(l[22:26])\n        chain = l[21:22].strip()\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        atname = l[12:16].strip()\n        \n        if (abs(x - cx) <= half and abs(y - cy) <= half and abs(z - cz) <= half):\n            residues_in_box.add((res, resnum, chain))\n\n# Print residues in box, sorted by residue number\nprint(f\"Residues within {2*half:.0f}x{2*half:.0f}x{2*half:.0f} box centered at Asn90 ({cx},{cy},{cz}):\")\nprint(f\"Count: {len(residues_in_box)}\")\nprint()\nprint(\"As --flexres chain:resnum format:\")\nflexres_list = sorted(residues_in_box, key=lambda x: x[1])\nflex_str = ','.join(f'{c}:{rnum}' for _, rnum, c in flexres_list)\nprint(f'--flexres {flex_str}')\nprint()\nfor res, rnum, chain in flexres_list:\n    print(f\"  {chain}:{rnum} {res}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-18T13:46:17.443371Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c echo \"============================================================\"\necho \" PREJOB CHECKS \u2014 rules/prejob_check.md\"\necho \"============================================================\"\n\nfor rundir in \\\n  projects/hsc70_new/runs/2026-06-18_RKVLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKILQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKLLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_TAFMALQ_s10000; do\n  \n  name=$(basename $rundir)\n  echo \"\"\n  echo \"========== $name ==========\"\n  \n  # 1. All input files present and non-empty\n  echo \"--- 1. File presence & size ---\"\n  all_ok=true\n  for f in receptor.pdb peptide.pdb ambig.tbl receptor.actpass peptide.actpass config.cfg; do\n    if [ -f \"$rundir/$f\" ]; then\n      size=$(wc -c < \"$rundir/$f\")\n      if [ \"$size\" -gt 0 ]; then\n        echo \"  \u2713 $f ($size bytes)\"\n      else\n        echo \"  \u2717 $f EMPTY\"\n        all_ok=false\n      fi\n    else\n      echo \"  \u2717 $f MISSING\"\n      all_ok=false\n    fi\n  done\n  \n  # 2. Validate structures\n  echo \"--- 2. Structure validation ---\"\n  patom=$(grep -c '^ATOM' \"$rundir/receptor.pdb\")\n  latom=$(grep -c '^ATOM' \"$rundir/peptide.pdb\")\n  echo \"  Receptor: $patom ATOM lines\"\n  echo \"  Peptide: $latom ATOM lines\"\n  [ \"$patom\" -gt 100 ] && echo \"  \u2713 Receptor seems OK\" || echo \"  \u2717 Receptor suspicious (<100 atoms)\"\n  [ \"$latom\" -gt 10 ] && echo \"  \u2713 Peptide seems OK\" || echo \"  \u2717 Peptide suspicious (<10 atoms)\"\n  \n  # 3. No symlinks\n  echo \"--- 3. Symlink check ---\"\n  syms=$(find \"$rundir\" -maxdepth 1 -type l 2>/dev/null | wc -l)\n  [ \"$syms\" = \"0\" ] && echo \"  \u2713 No symlinks\" || echo \"  \u2717 $syms symlinks found\"\n  \n  # 4. Config parses\n  echo \"--- 4. Config check ---\"\n  grep -q 'run_dir = \"output\"' \"$rundir/config.cfg\" && echo \"  \u2713 run_dir = output\" || echo \"  \u2717 run_dir wrong\"\n  grep -q 'ncores = 32' \"$rundir/config.cfg\" && echo \"  \u2713 ncores = 32\" || echo \"  \u2717 ncores wrong\"\n  grep -q 'molecules = \\[\"receptor.pdb\", \"peptide.pdb\"\\]' \"$rundir/config.cfg\" && echo \"  \u2713 molecules correct\" || echo \"  \u2717 molecules wrong\"\n  \n  # HADDOCK3-specific\n  echo \"--- 5. PDB chain/segment ---\"\n  chain=$(grep '^ATOM' \"$rundir/peptide.pdb\" | head -1 | cut -c22)\n  echo \"  Peptide chain: '$chain'\"\n  [ \"$chain\" = \"B\" ] && echo \"  \u2713 Chain B\" || echo \"  \u2717 Chain is not B!\"\n  \n  # Peptide residue range\n  echo \"--- 6. Residue range consistency ---\"\n  pep_first=$(grep '^ATOM' \"$rundir/peptide.pdb\" | awk '{print $6}' | sort -nu | head -1)\n  pep_last=$(grep '^ATOM' \"$rundir/peptide.pdb\" | awk '{print $6}' | sort -nu | tail -1)\n  echo \"  Peptide resi range: $pep_first-$pep_last\"\n  \n  # Compare with config\n  fle_sta=$(grep 'fle_sta_2' \"$rundir/config.cfg\" | head -1 | grep -o '[0-9]\\+')\n  fle_end=$(grep 'fle_end_2' \"$rundir/config.cfg\" | head -1 | grep -o '[0-9]\\+')\n  echo \"  Config fle_sta_2=$fle_sta fle_end_2=$fle_end\"\n  [ \"$pep_first\" = \"$fle_sta\" ] && echo \"  \u2713 fle_sta matches\" || echo \"  \u2717 fle_sta MISMATCH: PDB=$pep_first config=$fle_sta\"\n  [ \"$pep_last\" = \"$fle_end\" ] && echo \"  \u2713 fle_end matches\" || echo \"  \u2717 fle_end MISMATCH: PDB=$pep_last config=$fle_end\"\n  \n  # Actpass check\n  echo \"--- 7. Actpass check ---\"\n  act_lines=$(grep -cv '^$' \"$rundir/peptide.actpass\" 2>/dev/null || echo 0)\n  echo \"  Peptide actpass lines: $act_lines\"\n  [ \"$act_lines\" -eq 2 ] && echo \"  \u2713 Exactly 2 lines (active + passive)\" || echo \"  \u2717 Should have exactly 2 lines\"\n  \n  # Ambig.tbl check  \n  echo \"--- 8. Ambig.tbl check ---\"\n  ambig_lines=$(wc -l < \"$rundir/ambig.tbl\")\n  echo \"  ambig.tbl lines: $ambig_lines\"\n  [ \"$ambig_lines\" -gt 5 ] && echo \"  \u2713 Has content\" || echo \"  \u2717 Suspiciously short\"\n  \ndone\n\necho \"\"\necho \"============================================================\"\necho \" SUMMARY\"\necho \"============================================================\""}

{"event_type":"tool_call","timestamp":"2026-06-23T14:30:23.314145Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport sqlite3, json\n\nconn = sqlite3.connect('/home/tjiang/.local/share/opencode/opencode.db')\n\nsessions = [\n    'ses_14d178160ffeFCUNF8muY7i3DL', 'ses_14a8d1dd6ffesLHxScnqDJwwUz',\n    'ses_14a4301fcffe2zIr27rODUZ3PS', 'ses_1456d0e73ffe6ULEPwvHYx84J4',\n    'ses_13fc23de2ffelf2ddyTWl2olKC', 'ses_134c7b1a2ffeMFkXQrSHFP8Cs1',\n    'ses_1349d35caffeQYdQoegiPzSDIl', 'ses_130e4d4e4ffeJu5Q6ZBCByktmm',\n    'ses_12b819265ffeRiCjSRTOF2mCwU', 'ses_12b8117ebffeVUQKhrJh87qWNB',\n    'ses_12b670a8effezB5zYoxyPnSA46', 'ses_12a46493fffehueb24QomyJNE8',\n    'ses_12a373231ffeLcYS57pJqIwi68', 'ses_12a31596dffeU2R6yIw5W4l4yk',\n    'ses_125e030f7ffeXnTIPy3gi7ezbx', 'ses_120fa984affeN2zTmXpUOp3es8',\n    'ses_11186eec2ffe47heamLxUwWbfN', 'ses_1112f1045ffeaXFZuHiIouAkDM',\n    'ses_111257958ffe11RGJcUGSOER9m', 'ses_10bc31326ffeTnbvzCh53fUJnF',\n    'ses_10bbac41affe71w1NKzuwR3QGR'\n]\n\n# Track submit_job calls and parameter mentions\nfor sess_id in sessions:\n    rows = conn.execute('''\n        SELECT p.data, m.data, m.role\n        FROM part p JOIN message m ON p.message_id = m.id\n        WHERE p.session_id = ?\n        ORDER BY p.time_created\n    ''', [sess_id]).fetchall()\n    \n    if not rows:\n        continue\n    \n    submit_calls = []\n    param_mentions = []\n    \n    for p_data, m_data, role in rows:\n        try:\n            part = json.loads(p_data)\n            text = part.get('text', '')\n            role_str = role or 'unknown'\n            \n            # Look for submit_job with parameter details\n            if 'submit_job' in text.lower() and ('ncores' in text.lower() or 'memory' in text.lower() or 'sampling' in text.lower() or 'cpus' in text.lower()):\n                # Get surrounding context\n                idx = text.lower().find('submit_job')\n                ctx = text[max(0,idx-100):idx+1000] if idx >= 0 else text[:1000]\n                if len(ctx) > 800:\n                    ctx = ctx[:800] + '...'\n                submit_calls.append((role_str, ctx))\n            \n            # Also look for sampling, ncores mentions in context\n            for kw in ['sampling', 's5000', 's10000', 's2000', 's3000', 'ncores']:\n                if kw in text.lower():\n                    idx = text.lower().find(kw)\n                    ctx = text[max(0,idx-100):idx+200] if idx >= 0 else text[:200]\n                    if len(ctx) > 300:\n                        ctx = ctx[:300]\n                    param_mentions.append((role_str, kw, ctx))\n                    break\n        except:\n            pass\n    \n    if submit_calls:\n        print(f'=== {sess_id} ===')\n        for role, ctx in submit_calls[:5]:\n            print(f'  [{role}] {ctx[:400]}')\n            print()\n    \nconn.close()\n\" 2>&1 | head -600"}

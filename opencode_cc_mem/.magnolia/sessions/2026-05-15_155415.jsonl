{"event_type":"tool_call","timestamp":"2026-05-19T07:25:30.286222Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport os, glob, csv\n\nbase = '/mnt/d/new_repos/project_magnolia/opencode_cc_mem/projects/hsc70_peptides/runs/haddock3_trihelix_blind'\n\ndirs = [\n    'scan_p3_E3A','scan_p3_E3L','scan_p3_E3Q','scan_p3_E3V',\n    'scan_p6_K6I','scan_p6_K6L','scan_p6_K6N','scan_p6_K6Q',\n    'scan_p8_E8A','scan_p8_E8F','scan_p8_E8Q','scan_p8_E8W','scan_p8_E8Y',\n    'scan_p10_R10L','scan_p10_R10M','scan_p10_R10Q','scan_p10_R10W',\n    'surface_test','surf_des2','surf_des3','surf_des4','surf_des5','surf_des6','surf_des7','surf_des8',\n    'surf_opt1','surf_opt2','surf_opt3','surf_opt4','surf_opt5','surf_opt6','surf_opt7',\n    'rdkit_des2','rdkit_des3','rdkit_des4','rdkit_des5','rdkit_des6','rdkit_des7','rdkit_des8',\n    'rdkit_opt1','rdkit_opt2','rdkit_opt3','rdkit_opt4','rdkit_opt5','rdkit_opt6','rdkit_opt7',\n]\n\nprint('dir,status,clusters,capri_file,best_score,air,vdw,elec,desolv,total')\nfor d in dirs:\n    rdir = os.path.join(base, d)\n    # Capri after final (09)\n    capri_files = sorted(glob.glob(os.path.join(rdir, 'output', '*_caprieval', 'capri_clt.tsv')))\n    cf = capri_files[-1] if capri_files else None\n    status = 'ok'\n    clusters = 0\n    best = ''\n    if cf:\n        try:\n            with open(cf) as f:\n                reader = csv.DictReader(f, delimiter='\\t')\n                rows = list(reader)\n                if rows:\n                    r = rows[0]\n                    best = '{},{},{},{},{},{}'.format(r.get('score','NA'), r.get('air','NA'), r.get('vdw','NA'), r.get('elec','NA'), r.get('desolv','NA'), r.get('total','NA'))\n        except:\n            best = 'parse_error'\n    else:\n        status = 'NO_CAPRI'\n    # Cluster count\n    clust_txt = os.path.join(rdir, 'output', '07_clustfcc', 'clustfcc.txt')\n    if os.path.exists(clust_txt):\n        with open(clust_txt) as f:\n            for line in f:\n                if 'Total number of clusters:' in line:\n                    clusters = line.split(':')[-1].strip()\n    print('{},{},{},{},{}'.format(d, status, clusters, cf or 'NA', best))\n\" 2>&1"}

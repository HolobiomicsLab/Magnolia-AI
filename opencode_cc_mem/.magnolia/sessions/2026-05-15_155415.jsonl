{"event_type":"tool_call","timestamp":"2026-07-01T07:10:42.297051Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport csv, os\n\nruns = {\n    \"EGGFQMAKT (L8->K)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART (L8->R)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"KFERQx2 s20000\": \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\",\n}\n\nfor label, d in runs.items():\n    ss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\n    if not os.path.exists(ss):\n        ss = f\"{d}/output/09_caprieval/capri_ss.tsv\"\n    if not os.path.exists(ss):\n        print(f\"{label}: no capri_ss found\")\n        continue\n    print(f\"\\n=== {label} ===\")\n    with open(ss) as f:\n        # skip comment lines\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    # air_free = score - 0.1 * air (same formula used throughout project)\n    rows = []\n    for row in reader:\n        try:\n            score = float(row['score'])\n            air = float(row.get('air', 0))\n            vdw = float(row.get('vdw', 0))\n            elec = float(row.get('elec', 0))\n            desolv = float(row.get('desolv', 0))\n            bsa = float(row.get('bsa', 0))\n            dockq = float(row.get('dockq', 0))\n            irmsd = float(row.get('irmsd', 0))\n            lrmsd = float(row.get('lrmsd', 0))\n            fnat = float(row.get('fnat', 0))\n            cluster_id = row.get('cluster_id','?')\n            cluster_rank = row.get('cluster_ranking','?')\n            air_free = score - 0.1 * air\n            rows.append((score, air_free, dockq, irmsd, lrmsd, fnat, vdw, elec, desolv, bsa, cluster_id, cluster_rank))\n        except:\n            continue\n    rows.sort()\n    # Top 5\n    for r in rows[:5]:\n        score, air_free, dockq, irmsd, lrmsd, fnat, vdw, elec, desolv, bsa, cid, crank = r\n        print(f\"  cl={cid}(r{crank}) score={score:.2f} air_free={air_free:.2f} DockQ={dockq:.3f} vdw={vdw:.2f} elec={elec:.2f} bsa={bsa:.0f} irmsd={irmsd:.3f} lrmsd={lrmsd:.1f}\")\n    # Cluster-level summary from clustfcc\n    clf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\n    if os.path.exists(clf):\n        with open(clf) as f:\n            text = f.read()\n        # Extract cluster sizes\n        import re\n        clusters = re.findall(r'Cluster (\\d+) -> (\\d+) models', text)\n        print(f\"  clusters: {', '.join(f'cl{c}: n={n}' for c,n in sorted(clusters, key=lambda x: int(x[0]))[:6])}\")\nPYEOF"}

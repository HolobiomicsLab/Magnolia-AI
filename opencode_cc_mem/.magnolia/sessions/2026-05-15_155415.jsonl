{"event_type":"tool_call","timestamp":"2026-06-24T10:31:52.361984Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\npython3 - <<'PY'\nimport json, csv\nruns = [\n  (\"RKALQ (parent)\",  \"2026-06-17_RKALQ_s5000\"),\n  (\"RKVLQ A3->V\",     \"2026-06-18_RKVLQ_s5000\"),\n  (\"RKILQ A3->I\",     \"2026-06-18_RKILQ_s5000\"),\n  (\"RKLLQ A3->L\",     \"2026-06-18_RKLLQ_s5000\"),\n  (\"TGFMALQ (parent)\",\"2026-06-17_TGFMALQ_s10000\"),\n  (\"TAFMALQ G2->A\",   \"2026-06-18_TAFMALQ_s10000\"),\n]\nfor label, r in runs:\n    wp = f\"{r}/output/12_caprieval/weights_params.json\"\n    try:\n        d = json.load(open(wp))\n        wair = d.get('w_air'); wvdw=d.get('w_vdw'); welec=d.get('w_elec'); wdes=d.get('w_desolv')\n    except Exception as e:\n        wair=wvdw=welec=wdes=\"NA\"\n    print(f\"\\n###### {label}  [{r}] ######\")\n    print(f\"weights: w_vdw={wvdw} w_elec={welec} w_desolv={wdesolv} w_air={wair}\")\n    tsv = f\"{r}/output/analysis/12_caprieval_analysis/capri_clt.tsv\"\n    rows=[]\n    with open(tsv) as f:\n        hdr=None\n        for line in f:\n            if line.startswith('#') or not line.strip(): continue\n            if hdr is None:\n                hdr=line.rstrip('\\n').split('\\t'); idx={c:i for i,c in enumerate(hdr)}; continue\n            rows.append(line.rstrip('\\n').split('\\t'))\n    def g(rw,c): \n        i=idx.get(c); \n        return rw[i] if i is not None and i<len(rw) else 'NA'\n    # top 3 by score (file already sorted by score asc)\n    print(f\"{'clt':>4} {'n':>4} {'score':>9} {'air':>8} {'airfree':>9} {'vdw':>9} {'elec':>9} {'desolv':>7} {'dockq':>6} {'irmsd':>6} {'rank':>4}\")\n    for rw in rows[:3]:\n        try:\n            score=float(g(rw,'score')); air=float(g(rw,'air'))\n            af = score - wair*air if isinstance(wair,(int,float)) else 'NA'\n            if isinstance(af,float): af=f\"{af:.3f}\"\n        except: af='NA'\n        print(f\"{g(rw,'cluster_id'):>4} {g(rw,'n'):>4} {g(rw,'score'):>9} {g(rw,'air'):>8} {str(af):>9} {g(rw,'vdw'):>9} {g(rw,'elec'):>9} {g(rw,'desolv'):>7} {g(rw,'dockq'):>6} {g(rw,'irmsd'):>6} {g(rw,'caprieval_rank'):>4}\")\nPY"}

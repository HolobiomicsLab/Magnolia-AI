{"event_type":"tool_call","timestamp":"2026-06-17T20:23:06.826530Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\ncontacts = []\nwith open(f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\") as f:\n    for line in f:\n        if line[0] == '#' or line.startswith(\"res1\"):\n            continue\n        parts = line.strip().split(\"\\t\")\n        if len(parts) < 7:\n            continue\n        contacts.append({\"rec\": parts[0].strip(), \"pep\": parts[1].strip(), \"prob\": float(parts[5]), \"dist\": float(parts[6])})\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\nrec_by_res = {}\npep_coords = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        resname = line[17:20].strip(); resid = int(line[22:26])\n        if chain == 'A':\n            rec_by_res.setdefault(resid, {\"resname\": resname, \"xyz\": []})[\"xyz\"].append((x, y, z))\n        elif chain == 'B':\n            pep_coords.append((x, y, z))\n\ndef dmin(target_xyz_list, probe_xyz_list):\n    best = 999.0\n    for px, py, pz in probe_xyz_list:\n        for tx, ty, tz in target_xyz_list:\n            dx, dy, dz = tx - px, ty - py, tz - pz\n            d = math.sqrt(dx*dx + dy*dy + dz*dz)\n            if d < best:\n                best = d\n    return best\n\n# Pocket\npocket = {}\nfor rid in sorted(rec_by_res.keys()):\n    d = dmin(rec_by_res[rid][\"xyz\"], pep_coords)\n    if d <= 5.0:\n        pocket[rid] = d\n\ncontacted = set()\nweak = set()\nfor c in contacts:\n    rid = int(c[\"rec\"].split(\"-\")[1])\n    if c[\"prob\"] >= 0.5: contacted.add(rid)\n    elif c[\"prob\"] >= 0.2: weak.add(rid)\n\nall_p = set(pocket.keys())\nunder = all_p - contacted\nsbd, lid = 386, 531\n\nprint(f\"{'#':>4s} {'Name':>4s} {'Dist':>7s} {'Dom':>5s} {'Contacted by':>32s} {'Status'}\")\nprint(\"-\" * 80)\nfor rid in sorted(all_p):\n    name = rec_by_res[rid][\"resname\"]\n    d = pocket[rid]\n    dom = \"LID\" if rid >= lid else (\"SBD\" if rid >= sbd else \"NBD\")\n    hits = []\n    for c in contacts:\n        if int(c[\"rec\"].split(\"-\")[1]) == rid and c[\"prob\"] >= 0.5:\n            pn = c[\"pep\"].split(\"-\")[2]; pi = c[\"pep\"].split(\"-\")[1]\n            hits.append(f\"{pn}{pi}({c['prob']:.1f})\")\n    h = \",\".join(hits) if hits else \"-\"\n    if rid in contacted: st = \"STRONG\"\n    elif rid in weak: st = \"WEAK\"\n    else: st = \"\u26a0 UNDER\"\n    print(f\"{rid:4d} {name:>4s} {d:7.2f} {dom:>5s} {h:>32s} {st}\")\n\nprint(f\"\\nUnder-utilized ({len(under)}):\", \" \".join(str(r) for r in sorted(under)))\nfor rid in sorted(under):\n    print(f\"  {rid}({rec_by_res[rid]['resname']})\")\n\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-17T20:23:06.910836Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":85,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-17T20:23:33.485292Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\nrec_by_res = {}\npep_atoms = []  # (chain, resname, resid, atomname, x, y, z)\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        resname = line[17:20].strip(); resid = int(line[22:26]); atomname = line[12:16].strip()\n        if chain == 'A':\n            rec_by_res.setdefault(resid, {\"resname\": resname, \"xyz\": []})[\"xyz\"].append((x, y, z))\n        pep_atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef get_pos(chain, resid, atomname):\n    for ca, rn, ri, an, x, y, z in pep_atoms:\n        if ca == chain and ri == resid and an == atomname:\n            return (x, y, z)\n    return None\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vlen(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef norm(v):\n    l = vlen(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\n# N-terminal geometry\nN_pos  = get_pos('B', 1, 'N')\nCA_pos = get_pos('B', 1, 'CA')\nCB_pos = get_pos('B', 1, 'CB')\nca_to_n = vec(CA_pos, N_pos)\nca_to_n_norm = norm(ca_to_n)\nca_to_cb = vec(CA_pos, CB_pos)\nca_to_cb_norm = norm(ca_to_cb)\n\n# New residue N-terminal: X0-R1\nnew_ca_nt = tuple(N_pos[i] + ca_to_n_norm[i] * 3.0 for i in range(3))\nnew_cb_nt = tuple(new_ca_nt[i] + ca_to_cb_norm[i] * 1.53 for i in range(3))\n\n# C-terminal geometry\nCterm_C  = get_pos('B', 5, 'C')\nCterm_CA = get_pos('B', 5, 'CA')\nca5_to_c5 = vec(Cterm_CA, Cterm_C)\nca5_to_c5_norm = norm(ca5_to_c5)\n\n# Target residues\ntargets = [(460, \"GLU\"), (469, \"ARG\"), (543, \"GLU\")]\n\nprint(\"=\" * 85)\nprint(\"EXTENSION REACH TO UNDER-UTILIZED POCKET RESIDUES\")\nprint(\"=\" * 85)\nprint()\n\n# N-TERMINAL\nprint(\"--- N-TERMINAL EXTENSION (X0-R1-K2-A3-L4-Q5) ---\")\nprint(f\"Current R1 N:  ({N_pos[0]:.1f}, {N_pos[1]:.1f}, {N_pos[2]:.1f})\")\nprint(f\"Proj new CA:  ({new_ca_nt[0]:.1f}, {new_ca_nt[1]:.1f}, {new_ca_nt[2]:.1f})\")\nprint(f\"Proj new CB:  ({new_cb_nt[0]:.1f}, {new_cb_nt[1]:.1f}, {new_cb_nt[2]:.1f})\")\nprint()\n\n# Sidechain reach from new C\u03b2\nreach_table = {\"ARG\": 6.5, \"LYS\": 6.0, \"TYR\": 5.5, \"TRP\": 5.5, \"PHE\": 5.0,\n               \"GLU\": 5.0, \"GLN\": 5.0, \"MET\": 5.0, \"HIS\": 4.5, \"LEU\": 4.0,\n               \"ILE\": 4.0, \"ASP\": 3.5, \"ASN\": 3.5, \"THR\": 3.0, \"VAL\": 3.0,\n               \"SER\": 2.5, \"ALA\": 1.5, \"GLY\": 0.0}\n\nprint(f\"{'Target':>10s} {'R1\u2192tgt':>8s} {'Angle':>7s} {'newCB\u2192tgt':>10s} {'Min reach':>10s} {'Verdict'}\")\nprint(\"-\" * 85)\n\nfor rid, name in targets:\n    rxyz = rec_by_res[rid][\"xyz\"]\n    d_n   = min(dist(N_pos, (x,y,z)) for x,y,z in rxyz)\n    d_cb  = min(dist(new_cb_nt, (x,y,z)) for x,y,z in rxyz)\n    \n    # Angle: new_CA direction vs N\u2192target direction\n    closest = min(rxyz, key=lambda p: dist(N_pos, p))\n    nt_dir = norm(vec(N_pos, new_ca_nt))\n    tg_dir = norm(vec(N_pos, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(nt_dir, tg_dir)))))\n    \n    # Minimum sidechain reach needed from new CB\n    # new_CB is already 1.53 \u00c5 from new CA, so remaining to target = d_cb\n    # Need a residue with reach >= d_cb\n    min_reach = d_cb\n    \n    # Find smallest residue that can reach\n    can_reach = [r for r, reach in sorted(reach_table.items(), key=lambda x: -x[1]) if reach >= min_reach]\n    \n    if angle < 60: v = f\"FAVORABLE ({can_reach[0] if can_reach else 'none'})\"\n    elif angle < 90: v = f\"marginal ({can_reach[0] if can_reach else 'none'})\"\n    else: v = f\"AGAINST {angle:.0f}\u00b0\"\n    \n    print(f\"{name}{rid:>5d} {d_n:8.2f} {angle:7.1f}\u00b0 {d_cb:10.2f} {min_reach:10.1f} {v}\")\n\nprint()\nprint(\"--- C-TERMINAL EXTENSION (R1-K2-A3-L4-Q5-X6) ---\")\nprint(f\"Current Q5 C:  ({Cterm_C[0]:.1f}, {Cterm_C[1]:.1f}, {Cterm_C[2]:.1f})\")\nprint(f\"Backbone dir:  ({ca5_to_c5_norm[0]:.3f}, {ca5_to_c5_norm[1]:.3f}, {ca5_to_c5_norm[2]:.3f})\")\nprint()\n\nprint(f\"{'Target':>10s} {'Q5C\u2192tgt':>8s} {'Angle':>7s} {'newCA\u2192tgt':>10s} {'Min reach':>10s} {'Verdict'}\")\nprint(\"-\" * 85)\n\nfor rid, name in targets:\n    rxyz = rec_by_res[rid][\"xyz\"]\n    d_c   = min(dist(Cterm_C, (x,y,z)) for x,y,z in rxyz)\n    \n    # New CA position for C-terminal extension\n    new_ca_ct = tuple(Cterm_C[i] + ca5_to_c5_norm[i] * 3.8 for i in range(3))\n    d_ca  = min(dist(new_ca_ct, (x,y,z)) for x,y,z in rxyz)\n    \n    # Angle\n    closest = min(rxyz, key=lambda p: dist(Cterm_C, p))\n    ct_dir = norm(vec(Cterm_C, new_ca_ct))\n    tg_dir = norm(vec(Cterm_C, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ct_dir, tg_dir)))))\n    \n    min_reach = d_ca\n    can_reach = [r for r, reach in sorted(reach_table.items(), key=lambda x: -x[1]) if reach >= min_reach]\n    \n    if angle < 60: v = f\"FAVORABLE ({can_reach[0] if can_reach else 'none'})\"\n    elif angle < 90: v = f\"marginal ({can_reach[0] if can_reach else 'none'})\"\n    else: v = f\"AGAINST {angle:.0f}\u00b0\"\n    \n    print(f\"{name}{rid:>5d} {d_c:8.2f} {angle:7.1f}\u00b0 {d_ca:10.2f} {min_reach:10.1f} {v}\")\n\n# Summary\nprint()\nprint(\"=\" * 85)\nprint(\"SUMMARY\")\nprint(\"=\" * 85)\nprint()\nprint(\"N-terminal: all three targets AGAINST (>90\u00b0). Register shift killed this.\")\nprint()\nprint(\"C-terminal reach to under-utilized residues:\")\nfor rid, name in targets:\n    rxyz = rec_by_res[rid][\"xyz\"]\n    d_c = min(dist(Cterm_C, (x,y,z)) for x,y,z in rxyz)\n    new_ca_ct = tuple(Cterm_C[i] + ca5_to_c5_norm[i] * 3.8 for i in range(3))\n    d_ca = min(dist(new_ca_ct, (x,y,z)) for x,y,z in rxyz)\n    closest = min(rxyz, key=lambda p: dist(Cterm_C, p))\n    ct_dir = norm(vec(Cterm_C, new_ca_ct))\n    tg_dir = norm(vec(Cterm_C, closest))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ct_dir, tg_dir)))))\n    \n    # Check sidechain reach from new CA (add 6.5 for ARG)\n    max_reach = 3.8 + 6.5  # backbone + longest sidechain\n    reachable = d_c <= max_reach\n    \n    print(f\"  {name}{rid}: C-term\u2192{d_c:.1f}\u00c5, angle={angle:.0f}\u00b0, \"\n          f\"newCA\u2192{d_ca:.1f}\u00c5, max={max_reach:.1f}\u00c5 \u2192 {'REACHABLE' if reachable else 'too far'}\")\n\nPYEOF"}

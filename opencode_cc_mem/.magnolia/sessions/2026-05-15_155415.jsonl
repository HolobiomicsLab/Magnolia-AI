{"event_type":"tool_call","timestamp":"2026-06-24T12:37:22.010095Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full\necho \"=== which cluster is best (rank1 by score)? 12_caprieval ===\"\npython3 - <<'PY'\nimport json\nwp=\"output/12_caprieval/weights_params.json\"\ntry: wair=json.load(open(wp)).get('w_air')\nexcept: wair=0.1\nf=\"output/analysis/12_caprieval_analysis/capri_clt.tsv\"\nrows=[];idx={}\nwith open(f) as fh:\n    h=None\n    for line in fh:\n        if line.startswith('#') or not line.strip(): continue\n        if h is None: h=line.rstrip().split('\\t');idx={c:i for i,c in enumerate(h)};continue\n        rows.append(line.rstrip().split('\\t'))\ndef g(r,c): return r[idx[c]]\nprint(f\"{'rank':>4}{'clt':>4}{'n':>4}{'score':>9}{'airfree':>9}{'dockq':>7}\")\nfor r in rows[:5]:\n    af=f\"{float(g(r,'score'))-float(wair)*float(g(r,'air')):.2f}\"\n    print(f\"{g(r,'caprieval_rank'):>4}{g(r,'cluster_id'):>4}{g(r,'n'):>4}{g(r,'score'):>9}{af:>9}{g(r,'dockq'):>7}\")\nPY\necho\necho \"=== NBD vs SBD contacts PER cluster (contactmap) ===\"\npython3 - <<'PY'\nimport re,glob,os\ndef dom(res): return 'NBD' if res<=383 else 'SBD'\nfor f in sorted(glob.glob(\"output/*_contactmap/cluster*_interchain_contacts.tsv\")):\n    nbd=set();sbd=set()\n    for line in open(f):\n        if line.startswith('#') or not line.strip() or line.startswith('res1'): continue\n        c=line.rstrip().split('\\t')\n        m=re.match(r'A-(\\d+)-',c[0])\n        if m:\n            r=int(m.group(1))\n            (nbd if r<=383 else sbd).add(r)\n    cl=os.path.basename(f).split('_')[0]\n    print(f\"{cl}: NBD={len(nbd)}{(' ['+str(min(nbd))+'-'+str(max(nbd))+']') if nbd else ''}  SBD={len(sbd)}{(' ['+str(min(sbd))+'-'+str(max(sbd))+']') if sbd else ''}\")\nPY"}

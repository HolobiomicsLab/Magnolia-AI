{"event_type":"tool_call","timestamp":"2026-06-05T12:36:01.801157Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nparent = read_pdb(f\"{base}/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nn_ala  = read_pdb(f\"{base}/analysis/6mer_stage1/cluster_2_model_1.pdb\")\n\ndef backbone_vec(atoms):\n    cas = sorted([a for a in atoms if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"], key=lambda a: a[\"resi\"])\n    n_term = cas[0]\n    c_term = cas[-1]\n    vec = (c_term[\"x\"]-n_term[\"x\"], c_term[\"y\"]-n_term[\"y\"], c_term[\"z\"]-n_term[\"z\"])\n    length = math.sqrt(vec[0]**2+vec[1]**2+vec[2]**2)\n    return vec, length, n_term, c_term\n\nvp, lp, np, cp = backbone_vec(parent)\nvn, ln, nn, cn = backbone_vec(n_ala)\n\nprint(\"=== Backbone vectors (N-term CA -> C-term CA) ===\")\nprint(f\"Parent KFERQ: ({vp[0]:6.1f}, {vp[1]:6.1f}, {vp[2]:6.1f}), len={lp:.1f}A\")\nprint(f\"  N-term K1: ({np['x']:.1f}, {np['y']:.1f}, {np['z']:.1f})\")\nprint(f\"  C-term Q5: ({cp['x']:.1f}, {cp['y']:.1f}, {cp['z']:.1f})\")\nprint(f\"N-ALA:       ({vn[0]:6.1f}, {vn[1]:6.1f}, {vn[2]:6.1f}), len={ln:.1f}A\")\nprint(f\"  N-term A0: ({nn['x']:.1f}, {nn['y']:.1f}, {nn['z']:.1f})\")\nprint(f\"  C-term Q5: ({cn['x']:.1f}, {cn['y']:.1f}, {cn['z']:.1f})\")\n\n# Dot product of direction vectors\ndot = (vp[0]*vn[0] + vp[1]*vn[1] + vp[2]*vn[2]) / (lp*ln)\nprint(f\"\\nDot product of direction vectors: {dot:.3f}\")\nif dot < -0.5:\n    print(\"\u2192 Direction REVERSED (anti-parallel, dot < -0.5)\")\nelif dot > 0.5:\n    print(\"\u2192 Direction PRESERVED (parallel, dot > 0.5)\")\nelse:\n    print(\"\u2192 Direction changed substantially\")\n\n# Check N-term vs C-term positions\ndist_n = math.sqrt((np[\"x\"]-nn[\"x\"])**2+(np[\"y\"]-nn[\"y\"])**2+(np[\"z\"]-nn[\"z\"])**2)\ndist_c = math.sqrt((cp[\"x\"]-cn[\"x\"])**2+(cp[\"y\"]-cn[\"y\"])**2+(cp[\"z\"]-cn[\"z\"])**2)\nprint(f\"\\nN-term displacement: {dist_n:.1f}A\")\nprint(f\"C-term displacement: {dist_c:.1f}A\")\n\n# Which is closer: N-ALA N-term to parent N-term, or N-ALA N-term to parent C-term?\ndist_nn_cterm = math.sqrt((cp[\"x\"]-nn[\"x\"])**2+(cp[\"y\"]-nn[\"y\"])**2+(cp[\"z\"]-nn[\"z\"])**2)\ndist_cn_nterm = math.sqrt((np[\"x\"]-cn[\"x\"])**2+(np[\"y\"]-cn[\"y\"])**2+(np[\"z\"]-cn[\"z\"])**2)\nprint(f\"\\nN-ALA N-term(A0) \u2192 parent C-term(Q5): {dist_nn_cterm:.1f}A\")\nprint(f\"N-ALA C-term(Q5) \u2192 parent N-term(K1): {dist_cn_nterm:.1f}A\")\n\n# Summary\nprint(f\"\\n=== Verdict ===\")\nif dist_nn_cterm < dist_n and dist_cn_nterm < dist_c:\n    print(\"FLIPPED: N-ALA N-term occupies parent C-term site, and vice versa\")\nelif dot < -0.5:\n    print(\"FLIPPED: backbone direction reversed\")\nelse:\n    print(\"REGISTER SHIFT: peptide shifted along same direction\")\n\nPYEOF"}

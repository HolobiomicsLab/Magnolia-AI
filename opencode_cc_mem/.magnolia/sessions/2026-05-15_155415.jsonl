{"event_type":"tool_call","timestamp":"2026-06-11T09:36:14.129684Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob\n\n# Known lengths from PDB verification\npdb_lengths = {\n    # Raw input peptides\n    'KFERQ': 5, 'KILDQ': 5, 'KFQKQ': 5, 'KFQRQ': 5, 'QRKEL': 5, 'RKELQ': 5, 'RKDLQ': 5,\n    # 6-mers\n    'ApKFERQ': 6, 'KFERQpK': 6, 'KFERQpA': 6, 'KFERQpF': 6, 'KFERQpQ': 6,\n    # Longer\n    'KFERQx2': 11, 'RKELQx2': 10, 'QRKELQx2': 10, 'RKDLQ-variant': 10, 'KFERQ-KILDQ-fusion': 14,\n}\n\ndef get_length(run_name):\n    n = run_name.lower()\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    if 'apkferq' in n: return 6\n    if 'kferqpk' in n: return 6\n    if 'kferqpf' in n: return 6\n    if 'kferqpq' in n: return 6\n    if 'kferqpa' in n: return 6\n    return 5\n\ndef peptide_name(run_name):\n    n = run_name.split('_', 3)[-1] if run_name.startswith('202') else run_name\n    for s in ['_p2rank1_s5000','_p2rank1_s10000','_p2rank1_s2000','_s5000','_s2000','_s1000','_clean']:\n        n = n.replace(s, '')\n    if '_SBD_' in n:\n        n = n.replace('_SBD_', ' (SBD)')\n    return n\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nresults = []\n\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21:\n                continue\n            score = float(parts[4])\n            air = float(parts[18])\n            air_free = score - 0.1 * air\n            results.append({\n                'pep': peptide_name(d),\n                'run': d,\n                'score': score,\n                'air_free': air_free,\n                'dockq': float(parts[12]),\n                'irmsd': float(parts[6]),\n                'bsa': float(parts[20]),\n                'air': air,\n                'len': get_length(d),\n            })\n            if parts[0] == '1':\n                break\n\nseen = set()\nuniq = []\nfor r in results:\n    if r['run'] not in seen:\n        seen.add(r['run'])\n        uniq.append(r)\n\ndef cat(r):\n    n = r['run'].lower()\n    if 'x2' in n or 'fusion' in n or 'variant' in n: return 3\n    if 'pk' in n or 'pf' in n or 'pq' in n or 'pa_c' in n or 'apkferq' in n: return 2\n    if 'p2rank' in n: return 1\n    return 0\n\nuniq.sort(key=lambda r: (cat(r), r['air_free']))\n\nprint(f\\\"{'Peptide':<24} {'Len':>3} {'Score':>9} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7}\\\")\nprint('-' * 72)\nfor r in uniq:\n    print(f\\\"{r['pep']:<24} {r['len']:>3} {r['score']:>9.2f} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f}\\\")\n\""}

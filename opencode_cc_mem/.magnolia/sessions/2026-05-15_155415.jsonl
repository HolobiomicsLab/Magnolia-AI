{"event_type":"tool_call","timestamp":"2026-06-25T13:12:05.029159Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c B=projects/hsc70_new/runs\ndeclare -A RUN=(\n  [EGGFQMALT_T1E]=2026-06-24_EGGFQMALT_s10000\n  [TAGFQMALT_G2A]=2026-06-24_TAGFQMALT_s10000\n  [EAGFQMALT_T1E_G2A]=2026-06-24_EAGFQMALT_s10000\n)\nfor k in EGGFQMALT_T1E TAGFQMALT_G2A EAGFQMALT_T1E_G2A; do\n  base=\"$B/${RUN[$k]}/output\"\n  cap=\"$base/12_caprieval/capri_clt.tsv\"\n  echo \"========================= $k =========================\"\n  printf \"%-5s %-8s %-9s %-7s %-6s %s\\n\" \"clt\" \"dockq\" \"score\" \"n\" \"MODE\" \"signature\"\n  # iterate clusters by caprieval cluster_id\n  awk -F'\\t' '/^[0-9]/{print $2}' \"$cap\" | sort -n -u | while read cid; do\n    [ -z \"$cid\" ] && continue\n    # caprieval stats for this cluster_id (take the row)\n    line=$(awk -F'\\t' -v c=\"$cid\" '$2==c' \"$cap\")\n    n=$(echo \"$line\" | awk '{print $3}'); score=$(echo \"$line\" | awk '{print $5}'); dq=$(echo \"$line\" | awk '{print $13}')\n    # contactmap signature (dedup: read the single interchain file)\n    cf=\"$base/13_contactmap/cluster${cid}_interchain_contacts.tsv\"\n    if [ -f \"$cf\" ]; then\n      recs=$(awk -F'\\t' '$1 ~ /^A-/{split($1,a,\"-\"); print a[2]}' \"$cf\" | sort -n -u)\n      lid533=$(echo \"$recs\" | grep -x 533); lid544=$(echo \"$recs\" | grep -x 544); lid548=$(echo \"$recs\" | grep -x 548)\n      tail=$(echo \"$recs\" | awk '$1>=621 && $1<=624' | head -1)\n      parent=\"\"; [ -n \"$lid544\" ] && [ -n \"$tail\" ] && parent=\"PARENT-MODE\"\n      [ -z \"$parent\" ] && parent=\"groove-only\"\n      sig=$(echo \"$recs\" | awk '$1==533||$1==544||$1==548||$1==622||$1==623' | tr '\\n' ' ')\n    else\n      parent=\"no-cmap\"; sig=\"-\"\n    fi\n    printf \"%-5s %-8s %-9s %-7s %-6s %s\\n\" \"#$cid\" \"$dq\" \"$score\" \"$n\" \"$parent\" \"${sig:--}\"\n  done\ndone"}

{"event_type":"tool_call","timestamp":"2026-06-16T13:29:23.277212Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os, glob\n\nBASE = \"runs\"\nPEPTIDES = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\", 3),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\", 1),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\", 1),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\", 3),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\", 1),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\", 1),\n]\n\nprint(\"=== Contact analysis for best cluster of each peptide ===\\n\")\nprint(f\"{'Peptide':<10} {'Residue':<10} {'# contacts':<12} {'shortest (\u00c5)':<14} {'receptor partners'}\")\nprint(\"-\" * 80)\n\nfor tag, rd, best_clt in PEPTIDES:\n    cmdir = f\"{BASE}/{rd}/output/8_contactmap\"\n    tsv = f\"{cmdir}/cluster{best_clt}_interchain_contacts.tsv\"\n    \n    if not os.path.exists(tsv):\n        print(f\"{tag:<10} NO CONTACT FILE\")\n        continue\n    \n    # Parse: columns are flexible, but typically:\n    # mol1_chain:resname:resi, mol1_resname, mol1_resi, mol2_chain:resname:resi, mol2_resname, mol2_resi, shortest-dist, contact-type\n    contacts_by_res = {}\n    \n    with open(tsv) as f:\n        header = f.readline().strip()\n        for line in f:\n            if not line.strip():\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 8:\n                continue\n            # First column: mol1 identifier, check if it's receptor (A) or peptide (B)\n            mol1 = parts[0]\n            mol2 = parts[3]\n            dist = float(parts[6])\n            \n            # Determine which is peptide\n            if ':B:' in mol1:\n                pep_res = mol1.split(':')[2]  # resname:resi\n                rec_res = mol2.split(':')[2]\n            elif ':B:' in mol2:\n                pep_res = mol2.split(':')[2] \n                rec_res = mol1.split(':')[2]\n            else:\n                continue\n            \n            if pep_res not in contacts_by_res:\n                contacts_by_res[pep_res] = {'count': 0, 'mindist': 999, 'partners': set()}\n            \n            contacts_by_res[pep_res]['count'] += 1\n            contacts_by_res[pep_res]['mindist'] = min(contacts_by_res[pep_res]['mindist'], dist)\n            contacts_by_res[pep_res]['partners'].add(rec_res)\n    \n    # Sort by residue number\n    sorted_res = sorted(contacts_by_res.items(), key=lambda x: int(x[0].split(':')[1]) if ':' in x[0] else int(x[0]) if x[0].isdigit() else 0)\n    \n    for res, info in sorted_res:\n        partners = ', '.join(sorted(info['partners'])[:5])\n        if len(info['partners']) > 5:\n            partners += f\" +{len(info['partners'])-5} more\"\n        print(f\"{tag:<10} {res:<10} {info['count']:<12} {info['mindist']:<14.1f} {partners}\")\n\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-16T12:12:49.495240Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\n\n# Setup 3 pilot runs with full protocol\nRECEPTOR_SRC=\"runs/2026-06-16_4po2_KFERQ_s5000/receptor.pdb\"\nREC_ACTPASS=\"runs/2026-06-16_4po2_KFERQ_s5000/receptor.actpass\"\n\n# KFERQ: resi 647-651\n# HAMNG: resi 1-5\n# RKELQ: resi 652-656\n\ndeclare -A fle_end\nfle_end[KFERQ]=651\nfle_end[HAMNG]=5\nfle_end[RKELQ]=656\n\ndeclare -A fle_start\nfle_start[KFERQ]=647\nfle_start[HAMNG]=1\nfle_start[RKELQ]=652\n\nBASE_DIR=\"runs/2026-06-16\"\nSAMPLING=5000\n\nfor peptide in KFERQ HAMNG RKELQ; do\n    RUN_DIR=\"${BASE_DIR}_4po2_${peptide}_s${SAMPLING}_full\"\n    SRC_DIR=\"${BASE_DIR}_4po2_${peptide}_s${SAMPLING}\"\n    \n    mkdir -p \"$RUN_DIR\"\n    cp \"$SRC_DIR/peptide.pdb\" \"$RUN_DIR/peptide.pdb\"\n    cp \"$SRC_DIR/receptor.pdb\" \"$RUN_DIR/receptor.pdb\"\n    cp \"$SRC_DIR/receptor.actpass\" \"$RUN_DIR/receptor.actpass\"\n    cp \"$SRC_DIR/peptide.actpass\" \"$RUN_DIR/peptide.actpass\"\n    \n    cat > \"$RUN_DIR/config.cfg\" << CFGEND\nrun_dir = \"output\"\nncores = 32\nmode = \"local\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\n\n[topoaa]\n\n[rigidbody]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nsampling = ${SAMPLING}\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[flexref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = ${fle_start[$peptide]}\nfle_end_2 = ${fle_end[$peptide]}\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = ${fle_start[$peptide]}\nfle_end_2 = ${fle_end[$peptide]}\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 4\n\n[caprieval]\nallatoms = true\n\n[contactmap]\nCFGEND\n\n    # Regenerate ambig.tbl\n    haddock3-restraints active_passive_to_ambig \\\n        \"$RUN_DIR/receptor.actpass\" \"$RUN_DIR/peptide.actpass\" \\\n        --segid-one A \\\n        > \"$RUN_DIR/ambig.tbl\" 2>/dev/null\n    \n    echo \"Setup: $peptide (fle ${fle_start[$peptide]}-${fle_end[$peptide]}, ambig $(wc -l < \"$RUN_DIR/ambig.tbl\") lines)\"\ndone"}

{"event_type":"tool_call","timestamp":"2026-07-01T09:40:49.518940Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\n# EAGFQMRLT - full cluster data\nd = \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\"\n\n# Get all clusters with scores\nss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\nwith open(ss) as f:\n    lines = [l for l in f if not l.startswith('#')]\nreader = csv.DictReader(lines, delimiter='\\t')\nclusters = {}\nfor row in reader:\n    cid = row.get('cluster_id','?')\n    if not cid.isdigit(): continue\n    cid = int(cid)\n    score = float(row['score']); air = float(row.get('air',0))\n    af = score - 0.1*air\n    if cid not in clusters or af < clusters[cid]['af']:\n        clusters[cid] = {\n            'af': af, 'dq': float(row.get('dockq',0)),\n            'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n            'bsa': float(row.get('bsa',0)), 'irmsd': float(row.get('irmsd',0)),\n            'lrmsd': float(row.get('lrmsd',0)), 'fnat': float(row.get('fnat',0)),\n        }\n\n# Cluster sizes\nimport re as re2\nclf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\nsizes = {}\nranks = {}\nwith open(clf) as f:\n    for line in f:\n        m = re2.search(r'Cluster (\\d+) \\(#(\\d+), n=(\\d+), top4_avg_score = ([-\\d.]+)', line)\n        if m:\n            cl_id = int(m.group(1)); rank = int(m.group(2)); n = int(m.group(3)); avg = float(m.group(4))\n            sizes[cl_id] = n\n            ranks[rank] = cl_id\n\nprint(\"EAGFQMRLT (A\u2087\u2192R) \u2014 all clusters\")\nprint(f\"{'Cl':>3s} {'rank':>4s} {'n':>5s} {'%200':>6s} {'AIR-free':>9s} {'DockQ':>7s} {'irmsd':>6s} {'lrmsd':>6s} {'vdw':>8s} {'elec':>8s} {'bsa':>5s} {'fnat':>5s}\")\nprint(\"-\" * 90)\nfor rank in sorted(ranks.keys()):\n    cl = ranks[rank]\n    if cl not in clusters: continue\n    c = clusters[cl]\n    n = sizes.get(cl, 0)\n    pct = 100.0 * n / 200\n    print(f\"{cl:>3d} {rank:>4d} {n:>5d} {pct:>5.1f}% {c['af']:>+9.2f} {c['dq']:>7.3f} {c['irmsd']:>6.2f} {c['lrmsd']:>6.1f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['bsa']:>5.0f} {c['fnat']:>5.3f}\")\n\n# Now check the binding mode of cl6 (DockQ 0.642) vs cl1 (DockQ 1.000) vs cl2 (best AF)\nprint(\"\\n\\nContact zone comparison (core SBD\u03b2 residues):\")\ncore = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n\nfor cl in [1, 2, 6]:\n    fpath = f\"{d}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath): continue\n    with open(fpath) as f:\n        clines = [l for l in f if not l.startswith('#')]\n    reader2 = csv.DictReader(clines, delimiter='\\t')\n    \n    contacted = set()\n    nbd = set()\n    lid = set()\n    for row in reader2:\n        parts1 = row.get('res1','').strip().split('-')\n        if len(parts1) >= 3:\n            try:\n                rn = int(parts1[1])\n                contacted.add(rn)\n                if rn < 390: nbd.add(rn)\n                elif rn > 520: lid.add(rn)\n            except ValueError:\n                pass\n    \n    overlap = contacted & core\n    missing = core - contacted\n    c = clusters.get(cl, {})\n    print(f\"\\n  cl{cl} (AF={c.get('af',0):.2f}, DQ={c.get('dq',0):.3f}, n={sizes.get(cl,0)}):\")\n    print(f\"    Core matched: {len(overlap)}/19, missing: {sorted(missing)[:6]}\")\n    print(f\"    NBD: {len(nbd)}, lid: {len(lid)}, lid residues: {sorted(lid)[:5]}\")\nPYEOF"}

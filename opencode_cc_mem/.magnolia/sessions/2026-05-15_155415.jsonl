{"event_type":"tool_call","timestamp":"2026-06-24T14:03:23.040645Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-16_af3_TGGFQMALT_s10000_full\npython3 - <<'PY'\nimport json,re,glob,os\nR=\".\"\nprint(\"=== TGGFQMALT (9-mer, Torielli) AF3 score ===\")\nwp=\"output/12_caprieval/weights_params.json\"; wair=json.load(open(wp)).get('w_air',0.1)\nrows=[];idx={}\nfor line in open(\"output/12_caprieval/capri_clt.tsv\"):\n    if line.startswith('#') or not line.strip(): continue\n    if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n    rows.append(line.rstrip().split('\\t'))\ng=lambda rw,c: rw[idx[c]]\nfor rw in rows[:5]:\n    af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"  clt{g(rw,'cluster_id')} rank{g(rw,'caprieval_rank')}: AIR-free={af:.2f} DockQ={float(g(rw,'dockq')):.3f} n={g(rw,'n')}\")\nprint(\"\\n=== domain-spanning via contactmap (clusters with interchain_contacts.tsv) ===\")\nfor f in sorted(glob.glob(\"output/13_contactmap/cluster*_interchain_contacts.tsv\")):\n    nbd=set();sbd=set()\n    for line in open(f):\n        if line.startswith('#') or not line.strip() or line.startswith('res1'): continue\n        m=re.match(r'A-(\\d+)-',line.split('\\t')[0])\n        if m:\n            rr=int(m.group(1)); (nbd if rr<=383 else sbd).add(rr)\n    cl=os.path.basename(f).split('_')[0]\n    v=\"SBD-ONLY \u2713\" if not nbd else f\"SPANS NBD \u2717 [{min(nbd)}-{max(nbd)}]\"\n    sb=f\"[{min(sbd)}-{max(sbd)}]\" if sbd else \"-\"\n    print(f\"  {cl}: NBD={len(nbd):2d} SBD={len(sbd):2d} {sb:14s} {v}\")\nPY"}

{"event_type":"tool_call","timestamp":"2026-06-09T09:52:00.081657Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && zcat docked_p2rank.sdf.gz | python3 -c \"\nimport sys, re\nlines = sys.stdin.read()\nmols = lines.strip().split('\\$\\$\\$\\$')\nbest_nn = {}\nfor mol in mols:\n    if not mol.strip(): continue\n    name_m = re.search(r'>(.*)</Name>', mol)\n    aff_m = re.search(r'CNNaffinity:\\s*([-\\d.]+)', mol)\n    pose_m = re.search(r'CNNscore:\\s*([-\\d.]+)', mol)\n    if name_m and aff_m:\n        name = name_m.group(1).strip()\n        aff = float(aff_m.group(1))\n        pose = float(pose_m.group(1)) if pose_m else 0\n        if name not in best_nn or aff > best_nn[name][1]:\n            best_nn[name] = (pose, aff)\nprint(f'Total unique compounds: {len(best_nn)}')\nprint()\nranked = sorted(best_nn.items(), key=lambda x: x[1][1], reverse=True)\nprint(f'{\\\"Rank\\\":<5} {\\\"Compound\\\":<25} {\\\"CNNpose\\\":<10} {\\\"CNNaff\\\":<10}')\nprint('-'*55)\nfor i, (name, (pose, aff)) in enumerate(ranked, 1):\n    print(f'{i:<5} {name:<25} {pose:<10.4f} {aff:<10.4f}')\n\"\n"}

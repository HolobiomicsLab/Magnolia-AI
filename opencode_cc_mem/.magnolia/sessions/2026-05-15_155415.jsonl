tance(tool_input, dict) and 'submit_job' in tool_name:\n                    nc = tool_input.get('ncores', '?')\n                    mem = tool_input.get('memory', '?')\n                    tl = tool_input.get('time_limit', '?')\n                    pt = tool_input.get('partition', '?')\n                    tool = tool_input.get('tool', '?')\n                    jn = tool_input.get('job_name', '?')\n                    sched = tool_input.get('scheduler', '?')\n                    cmd = str(tool_input.get('command', '?'))[:200]\n                    \n                    # Extract sampling\n                    m = re.search(r's(\\d{4,6})', str(cmd) + str(jn))\n                    sampling = f's{m.group(1)}' if m else '?'\n                    \n                    # Check if submission succeeded\n                    success = 'success' in str(output).lower() if output else False\n                    \n                    timeline.append(('submit', date, sess_id[:20], ts, {\n                        'jn': jn, 'nc': nc, 'mem': mem, 'tl': tl,\n                        'pt': pt, 'tool': tool, 'sched': sched,\n                        'sampling': sampling, 'cmd': cmd,\n                        'success': success\n                    }))\n                \n                elif 'memory_get_context' in tool_name and isinstance(tool_input, dict):\n                    td = tool_input.get('task_description', '')[:300]\n                    timeline.append(('mem_get_ctx', date, sess_id[:20], ts, td))\n                    \n                elif isinstance(tool_input, dict) and any(t in tool_name for t in ['p2rank', 'generate_restraints', 'haddock3_parse', 'haddock3_run', 'check_job', 'poll_jobs', 'memory_record_learning']):\n                    timeline.append(('tool', date, sess_id[:20], ts, \n                        f'{tool_name}: {str(tool_input)[:200]}'))\n                    \n            elif ptype == 'reasoning':\n                text = part.get('text', '')\n                tl_t = text.lower()\n                if any(kw in tl_t for kw in ['p2rank', 'restraint strat', 'actpass', 'binding site strateg',\n                    'sampling', 'ncore', '64g', 'oom', '32g', 'memory', 'partition', 'cpucourt',\n                    'submit_job', 's5000', 's10000', 'resubmi', '4po2', 'ambig']):\n                    if len(text) > 50 and len(text) < 800:\n                        timeline.append(('reasoning', date, sess_id[:20], ts, text[:500]))\n        except:\n            pass\n\n# Sort by date\ntimeline.sort(key=lambda x: (x[1], x[3]))\n\n# Print\nfor entry in timeline:\n    etype, date, sess, ts, data = entry\n    if etype == 'submit':\n        print(f'[{date}] SUBMIT_JOB {data[\"jn\"][:40]:40s} nc={data[\"nc\"]} mem={data[\"mem\"]:6s} time={data[\"tl\"]:>10s} part={data[\"pt\"]:>10s} samp={data[\"sampling\"]} [{data[\"sched\"]}]')\n    elif etype == 'mem_get_ctx':\n        print(f'[{date}] MEM_GET_CTX: {data[:200]}')\n    elif etype == 'reasoning':\n        print(f'[{date}] REASONING: {data[:400]}')\n    elif etype == 'tool':\n        print(f'[{date}] TOOL: {data[:200]}')\n\nconn.close()\nPYEOF\n 2>&1 | head -400"}

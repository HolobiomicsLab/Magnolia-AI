{"event_type":"tool_call","timestamp":"2026-06-18T12:44:44.221086Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c # Per-residue contact counts for TGFMALQ cluster 1 (shortest-dist < 5\u00c5)\necho \"=== TGFMALQ per-residue contacts (shortest-dist < 5\u00c5) ===\"\npython3 -c \"\nimport csv\nwith open('projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000/output/13_contactmap/cluster1_interchain_contacts.tsv') as f:\n    # skip header lines\n    for line in f:\n        if line.startswith('#'): continue\n        if line.startswith('res1'): continue  # skip column header\n        parts = line.strip().split('\\t')\n        if len(parts) < 7: continue\n        res1 = parts[0]  # A-404-GLU\n        res2 = parts[1]  # B-3-PHE\n        try:\n            shortest = float(parts[6])\n        except: continue\n        if shortest < 5.0:\n            print(f'{res2:20s} \u2194 {res1:20s}  {shortest:.1f}\u00c5')\n\"\necho \"\"\necho \"=== Count by peptide position ===\"\npython3 -c \"\nimport csv\nfrom collections import defaultdict\ncounts = defaultdict(set)\nwith open('projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000/output/13_contactmap/cluster1_interchain_contacts.tsv') as f:\n    for line in f:\n        if line.startswith('#') or line.startswith('res1'): continue\n        parts = line.strip().split('\\t')\n        if len(parts) < 7: continue\n        try: shortest = float(parts[6])\n        except: continue\n        if shortest < 5.0:\n            res2 = parts[1]  # B-3-PHE\n            pep_pos, pep_name = res2.split('-')[1], res2.split('-')[2]\n            counts[f'{pep_pos}-{pep_name}'].add(parts[0])  # unique receptor contacts\nfor pos in sorted(counts, key=lambda x: int(x.split('-')[0])):\n    print(f'Position {pos}: {len(counts[pos])} unique receptor contacts')\n\""}

{"event_type":"tool_call","timestamp":"2026-06-05T09:01:32.585967Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, shutil\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nref_run = f\"{base}/runs/2026-06-02_KFERQ_p2rank1_s5000\"\nruns_dir = f\"{base}/runs\"\n\n# 6-mer definitions: (run_name, peptide_pdb, first_resi, last_resi)\nsixmers = [\n    (\"2026-06-05_KFERQpK_p2rank1_s5000\", \"raw_input/peptides/6mers/KFERQ_K.pdb\", 647, 652),\n    (\"2026-06-05_KFERQpF_p2rank1_s5000\", \"raw_input/peptides/6mers/KFERQ_F.pdb\", 647, 652),\n    (\"2026-06-05_KFERQpQ_p2rank1_s5000\", \"raw_input/peptides/6mers/KFERQ_Q.pdb\", 647, 652),\n    (\"2026-06-05_KFERQpA_C_p2rank1_s5000\", \"raw_input/peptides/6mers/KFERQ_A_C.pdb\", 647, 652),\n    (\"2026-06-05_ApKFERQ_N_p2rank1_s5000\", \"raw_input/peptides/6mers/A_KFERQ_N.pdb\", 646, 651),\n]\n\n# Common receptor actpass\nreceptor_actpass = \"\"\"10 12 14 15 37 56 175 199 201 202 230 231 234 268 271 272 275 338 339 340 342 343 365 366 369\n\n\"\"\"\n\nfor run_name, pep_pdb_path, first_resi, last_resi in sixmers:\n    run_dir = f\"{runs_dir}/{run_name}\"\n    os.makedirs(run_dir, exist_ok=True)\n    \n    # Copy receptor\n    shutil.copy(f\"{ref_run}/receptor.pdb\", f\"{run_dir}/receptor.pdb\")\n    shutil.copy(f\"{base}/{pep_pdb_path}\", f\"{run_dir}/peptide.pdb\")\n    \n    # Receptor actpass (unchanged)\n    with open(f\"{run_dir}/receptor.actpass\", 'w') as f:\n        f.write(receptor_actpass)\n    \n    # Peptide actpass (all residues active, no passive)\n    active_resis = list(range(first_resi, last_resi + 1))\n    active_str = \" \".join(str(r) for r in active_resis)\n    with open(f\"{run_dir}/peptide.actpass\", 'w') as f:\n        f.write(f\"{active_str}\\n{active_str}\\n\")\n    \n    # Config\n    config = f\"\"\"run_dir = \"output\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\nmode = \"local\"\nncores = 32\n\n[topoaa]\n\n[rigidbody]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nsampling = 5000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[flexref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = {first_resi}\nfle_end_2 = {last_resi}\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = {first_resi}\nfle_end_2 = {last_resi}\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 4\n\n[caprieval]\nallatoms = true\n\n[contactmap]\n\"\"\"\n    with open(f\"{run_dir}/config.cfg\", 'w') as f:\n        f.write(config)\n    \n    print(f\"Created {run_name}\")\n\nPYEOF"}

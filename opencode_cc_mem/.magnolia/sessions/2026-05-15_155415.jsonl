{"event_type":"tool_call","timestamp":"2026-06-03T09:22:06.356925Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts && gunzip -c cluster_1_model_1.pdb.gz > /tmp/cluster1_m1.pdb && python3 -c \"\nimport math\n\ndef read_pdb(path):\n    atoms = {}\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                seg = line[72:76].strip()\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                key = (chain, resn, resi, name)\n                atoms[key] = (x, y, z)\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1[0]-a2[0])**2 + (a1[1]-a2[1])**2 + (a1[2]-a2[2])**2)\n\natoms = read_pdb('/tmp/cluster1_m1.pdb')\n\n# Peptide: B 647-651 KFERQ\n# Focus on key pairs from interchain_contacts\npairs = [\n    # F2(B-648) - R272(A-272): interchain says shortest-dist=3.1, ca-ca=6.3\n    (('A','ARG',272), ('B','PHE',648)),\n    # E3(B-649) - R272(A-272): ca-ca=8.0, shortest-dist=3.6\n    (('A','ARG',272), ('B','GLU',649)),\n    # D366 - K1(B-647): ca-ca=7.8, shortest-dist=2.7\n    (('A','ASP',366), ('B','LYS',647)),\n    # D366 - E3(B-649): ca-ca=6.8, shortest-dist=3.3\n    (('A','ASP',366), ('B','GLU',649)),\n    # T37 - E3(B-649): ca-ca=7.3, shortest-dist=2.8\n    (('A','THR',37), ('B','GLU',649)),\n    # A-201 GLY - R4(B-650): ca-ca=5.0, shortest-dist=3.9\n    (('A','GLY',201), ('B','ARG',650)),\n]\n\nfor (rc, rrn, rri), (lc, lrn, lri) in pairs:\n    ra = [(k,a) for k,a in atoms.items() if k[0]==rc and k[1]==rrn and k[2]==rri]\n    la = [(k,a) for k,a in atoms.items() if k[0]==lc and k[1]==lrn and k[2]==lri]\n    if not ra or not la:\n        print(f'{rrn}{rri}-{lrn}{lri}: NO ATOMS')\n        continue\n    # ca-ca\n    ra_ca = [(k,a) for k,a in ra if k[3]=='CA']\n    la_ca = [(k,a) for k,a in la if k[3]=='CA']\n    ca_dist = dist(ra_ca[0][1], la_ca[0][1]) if ra_ca and la_ca else None\n    # shortest any-atom\n    shortest = None\n    spair = None\n    for rk, ra_xyz in ra:\n        for lk, la_xyz in la:\n            d = dist(ra_xyz, la_xyz)\n            if shortest is None or d < shortest:\n                shortest = d\n                spair = (rk, lk)\n    print(f'{rrn}{rri}-{lrn}{lri}: ca-ca={ca_dist:.1f}  shortest={shortest:.1f} ({spair[0][1]}-{spair[0][2]}{spair[0][3]} <-> {spair[1][1]}-{spair[1][2]}{spair[1][3]})')\n\"\n"}

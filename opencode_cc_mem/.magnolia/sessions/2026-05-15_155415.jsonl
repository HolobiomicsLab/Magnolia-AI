as_460, has_404, zones = result\n    \n    zone_str = \"\"\n    for pn in sorted(zones):\n        z = zones[pn]\n        if not z: zone_str += f\" B{pn}:\u2014\"\n        else: zone_str += f\" B{pn}:{'/'.join(sorted(z))}\"\n    \n    print(f\"{label:<14s} {af:>+9.2f} {dq:>6.3f} {overlap:>4d}/19 {'\u2713' if has_460 else '\u2717':>5s} {'\u2713' if has_404 else '\u2717':>5s}  {zone_str}\")\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-07-01T17:05:05.107999Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":90,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-07-01T17:05:58.507234Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_scores_and_contacts(run_dir):\n    # Find best cluster\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{run_dir}/output/{sfx}/capri_ss.tsv\"\n        if not os.path.exists(ss): continue\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','')\n            if not cid.isdigit(): continue\n            cid = int(cid)\n            score = float(row['score']); air = float(row.get('air',0))\n            af = score - 0.1*air\n            if cid not in clusters or af < clusters[cid]['af']:\n                clusters[cid] = {'af': af, 'dq': float(row.get('dockq',0)),\n                                 'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n                                 'bsa': float(row.get('bsa',0))}\n        if not clusters: continue\n        \n        sizes = {}\n        clf = f\"{run_dir}/output/10_clustfcc/clustfcc.txt\"\n        if os.path.exists(clf):\n            with open(clf) as f:\n                for line in f:\n                    m = re.search(r'Cluster (\\d+) \\(#(\\d+), n=(\\d+)', line)\n                    if m: sizes[int(m.group(1))] = int(m.group(3))\n        \n        return clusters, sizes, sfx\n    return None, None, None\n\ndef contact_zones(run_dir, cl):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath): return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    core = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n    rec_set = set()\n    pep_zones = {}\n    key_contacts = {}  # rec_resnum -> (pep_pdb, dist, pep_resname)\n    \n    for row in reader:\n        p1 = row['res1'].split('-')\n        p2 = row['res2'].split('-')\n        if len(p1)<3 or len(p2)<3: continue\n        try: rn=int(p1[1]); rr=p1[2]; pn=int(p2[1]); pr=p2[2]\n        except: continue\n        dist = float(row['shortest-dist'])\n        rec_set.add(rn)\n        \n        if pn not in pep_zones: pep_zones[pn] = []\n        pep_zones[pn].append((dist, rn, rr, pr))\n        \n        # Track key receptor contacts\n        if rn in [404, 428, 429, 435, 437, 438, 439, 460, 469] and dist < 5.0:\n            if rn not in key_contacts or dist < key_contacts[rn][1]:\n                key_contacts[rn] = (pn, dist, pr)\n    \n    overlap = len(rec_set & core)\n    return overlap, rec_set, pep_zones, key_contacts\n\n# TGFMALQ family + position-3 scan\npeptides = [\n    (\"TGFMALQ\", \"runs/2026-06-17_af3_TGFMALQ_s5000_full\"),\n    (\"TAFMALQ\", \"runs/2026-06-18_TAFMALQ_s10000\"),\n    (\"RKALQ\", \"runs/2026-06-17_af3_RKALQ_s5000_full\"),\n    (\"RKVLQ\", \"runs/2026-06-18_RKVLQ_s5000\"),\n    (\"RKILQ\", \"runs/2026-06-18_RKILQ_s5000\"),\n    (\"RKLLQ\", \"runs/2026-06-18_RKLLQ_s5000\"),\n    (\"RKGLQ\", \"runs/2026-06-17_af3_RKGLQ_s5000_full\"),\n    (\"RKNLQ\", \"runs/2026-06-17_af3_RKNLQ_s5000_full\"),\n]\n\nfor label, rd in peptides:\n    d = f\"projects/hsc70_new/{rd}\"\n    if not os.path.isdir(d):\n        print(f\"\\n{label}: dir not found ({rd})\")\n        continue\n    \n    clusters, sizes, sfx = get_scores_and_contacts(d)\n    if not clusters:\n        print(f\"\\n{label}: no capri_ss data\")\n        continue\n    \n    print(f\"\\n=== {label} ({rd}) ===\")\n    # Show all clusters\n    for cid in sorted(clusters.keys()):\n        c = clusters[cid]\n        n = sizes.get(cid, '?')\n        pct = f\"{100*n/200:.0f}%\" if isinstance(n, int) else \"?\"\n        print(f\"  cl{cid} (n={n}, {pct}): AF={c['af']:+.2f} DQ={c['dq']:.3f} vdw={c['vdw']:+.1f} elec={c['elec']:+.1f} bsa={c['bsa']:.0f}\")\n    \n    # Contact analysis for rank-1 cluster\n    r1_cl = min(clusters.keys(), key=lambda x: -clusters[x]['af'])  # best AF cluster\n    # Actually get rank-1 from clustfcc\n    clf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\n    r1 = 1\n    if os.path.exists(clf):\n        with open(clf) as f:\n            for line in f:\n                m = re.search(r'Cluster (\\d+) \\(#1,', line)\n                if m: r1 = int(m.group(1)); break\n    \n    for cl in [r1]:\n        if cl not in clusters: continue\n        c = clusters[cl]\n        result = contact_zones(d, cl)\n        if not result: \n            print(f\"  cl{cl}: no contact map\")\n            continue\n        overlap, rec_set, pep_zones, key_contacts = result\n        print(f\"  cl{cl} contacts: core={overlap}/19, E460={'\u2713' if 460 in rec_set else '\u2717'}, E404={'\u2713' if 404 in rec_set else '\u2717'}\")\n        print(f\"  Key receptor contacts:\")\n        for rn in sorted(key_contacts.keys()):\n            pn, dist, pr = key_contacts[rn]\n            print(f\"    {rn}: B{pn}({pr}) @ {dist:.1f}\u00c5\")\nPYEOF"}

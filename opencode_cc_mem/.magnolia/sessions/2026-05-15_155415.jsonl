{"event_type":"tool_call","timestamp":"2026-06-09T13:26:55.347949Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('gnina_bridge_all.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\n\n# Extract: CNN-top affinity vs best affinity across all 20 poses\ncnn_top, best_aff, best_cnn = [], [], []\nfor block in blocks[1:]:\n    poses = re.findall(r'\\n\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', block)\n    if not poses: continue\n    cnn_top.append(float(poses[0][1]))   # CNN ranked top-1\n    best_aff.append(min(float(p[1]) for p in poses))  # best empirical across all\n    best_cnn.append(float(poses[0][3]))  # CNN score\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\nkd_all = np.array([exp_lk.get(name_map.get(fn,fn),999) for fn in sdf_names_sorted[:len(cnn_top)]])\n\nprint(f\"{'Compound':<24s} {'Kd':>7s} {'CNN_top':>8s} {'Best emp':>9s} {'\u0394':>7s} {'Kd_class':>9s}\")\nprint(\"-\" * 72)\nfor i in range(len(cnn_top)):\n    name = name_map.get(sdf_names_sorted[i], sdf_names_sorted[i])\n    kd = kd_all[i]\n    cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else \"WEAK\")\n    delta = best_aff[i] - cnn_top[i]\n    mark = \" \u2190 gap!\" if abs(delta) > 3 else \"\"\n    print(f\"  {name:<22s} {kd:>7.3f} {cnn_top[i]:>+8.2f} {best_aff[i]:>+9.2f} {delta:>+7.2f}{mark} {cls:>9s}\")\n\n# Correlations\nrho_cnn, p_cnn = spearmanr(np.array(cnn_top), kd_all)\nrho_best, p_best = spearmanr(np.array(best_aff), kd_all)\n\nprint(f\"\\n\u2550\u2550\u2550 SCORING \u2550\u2550\u2550\")\nprint(f\"  CNN-ranked top pose (gnina default):  \u03c1={rho_cnn:+.4f}  p={p_cnn:.4f}\")\nprint(f\"  Best affinity across all 20 poses:     \u03c1={rho_best:+.4f}  p={p_best:.4f}\")\n\n# By class for best affinity\nGOOD = [best_aff[i] for i in range(len(best_aff)) if kd_all[i] < 1.0]\nMOD = [best_aff[i] for i in range(len(best_aff)) if 1.0 <= kd_all[i] < 10]\nWEAK = [best_aff[i] for i in range(len(best_aff)) if kd_all[i] >= 10]\nprint(f\"\\n  Best affinity by class:\")\nprint(f\"    STRONG:      {np.mean(GOOD):+.2f} \u00b1 {np.std(GOOD):.2f}\")\nprint(f\"    MODERATE:    {np.mean(MOD):+.2f} \u00b1 {np.std(MOD):.2f}\")\nprint(f\"    WEAK/NON:    {np.mean(WEAK):+.2f} \u00b1 {np.std(WEAK):.2f}\")\n\n# Z11-16\nprint(f\"\\n  Z11-16 series (best affinity):\")\nfor i in range(len(best_aff)):\n    name = name_map.get(sdf_names_sorted[i], sdf_names_sorted[i])\n    if 'Z11-16' in name:\n        print(f\"    {name:<15s} Kd={kd_all[i]:.3f}  aff={best_aff[i]:+.2f}  (CNN top={cnn_top[i]:+.2f})\")\nPYEOF"}

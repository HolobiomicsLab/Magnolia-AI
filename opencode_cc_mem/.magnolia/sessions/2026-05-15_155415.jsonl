{"event_type":"tool_call","timestamp":"2026-06-16T09:24:36.697033Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport numpy as np\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\n\ndef parse_pdb(pdb_path, chain=None):\n    coords = {}\n    with open(pdb_path) as f:\n        for line in f:\n            if not line.startswith(\"ATOM\") and not line.startswith(\"HETATM\"):\n                continue\n            atom_name = line[12:16].strip()\n            if atom_name != \"CA\":\n                continue\n            chain_id = line[21]\n            if chain and chain_id != chain:\n                continue\n            resi = int(line[22:26].strip())\n            x = float(line[30:38])\n            y = float(line[38:46])\n            z = float(line[46:54])\n            coords[resi] = np.array([x, y, z])\n    return coords\n\naf3 = parse_pdb(f\"{BASE}/raw_input/receptor/Hsc70_full_Abeta_KFERQ_like_motif_ADP.pdb\", chain=\"A\")\npo2 = parse_pdb(f\"{BASE}/raw_input/receptor/4po2_chainA.pdb\", chain=\"A\")\n\n# Groove center: average of binding site residues near the groove floor\ngroove_resi = [403, 404, 428, 429, 430, 438, 440, 473]\n# Lid center: average of lid hotspot residues\nlid_resi = [545, 548, 552, 558, 561, 600, 607, 610, 611]\n\ndef center(coords_dict, resi_list):\n    pts = [coords_dict[r] for r in resi_list if r in coords_dict]\n    return np.mean(pts, axis=0), len(pts)\n\nprint(\"=== Distance between groove center and lid center ===\\n\")\n\naf3_groove_c, n1 = center(af3, groove_resi)\naf3_lid_c, n2 = center(af3, lid_resi)\nd_af3 = np.linalg.norm(af3_groove_c - af3_lid_c)\nprint(f\"AF3 (full-length Hsc70):\")\nprint(f\"  Groove center residues: {n1}/{len(groove_resi)}\")\nprint(f\"  Lid center residues: {n2}/{len(lid_resi)}\")\nprint(f\"  Groove \u2192 Lid distance: {d_af3:.1f} \u00c5\")\n\nprint()\n\npo2_groove_c, n1 = center(po2, groove_resi)\npo2_lid_c, n2 = center(po2, lid_resi)\nd_po2 = np.linalg.norm(po2_groove_c - po2_lid_c)\nprint(f\"4PO2 (crystal structure, SBD only):\")\nprint(f\"  Groove center residues: {n1}/{len(groove_resi)}\")\nprint(f\"  Lid center residues: {n2}/{len(lid_resi)}\")\nprint(f\"  Groove \u2192 Lid distance: {d_po2:.1f} \u00c5\")\n\nprint()\nprint(f\"Difference: AF3 lid is {d_af3 - d_po2:.1f} \u00c5 {'further from' if d_af3 > d_po2 else 'closer to'} the groove than 4PO2\")\n\n# Also check per-pair distances\nprint(\"\\n=== Key groove\u2194lid closest pairs ===\")\n# Measure shortest distance between any groove CA and any lid CA\nfor groove_r in [403, 428, 438, 440]:\n    for lid_r in [545, 558, 600, 611]:\n        if groove_r in af3 and lid_r in af3:\n            d = np.linalg.norm(af3[groove_r] - af3[lid_r])\n            print(f\"  AF3: {groove_r} \u2194 {lid_r}: {d:.1f} \u00c5\")\n\nprint()\nfor groove_r in [403, 428, 438, 440]:\n    for lid_r in [545, 558, 600, 611]:\n        if groove_r in po2 and lid_r in po2:\n            d = np.linalg.norm(po2[groove_r] - po2[lid_r])\n            print(f\"  4PO2: {groove_r} \u2194 {lid_r}: {d:.1f} \u00c5\")\n\nPYEOF"}

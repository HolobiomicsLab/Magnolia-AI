{"event_type":"tool_call","timestamp":"2026-06-09T09:52:52.644068Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 -c \"\nimport json, re, gzip\n\nwith open('compounds.json') as f:\n    compounds = json.load(f)\n\n# Read P2Rank docking results\nwith gzip.open('docked_p2rank.sdf.gz') as f:\n    data = f.read().decode('utf-8', errors='replace')\n\nmols = data.strip().split('\\$\\$\\$\\$')\nprint(f'Total poses: {len([m for m in mols if m.strip()])}')\n\nbest = {}\nfor i, mol in enumerate(mols):\n    if not mol.strip(): continue\n    comp_idx = i // 20\n    if comp_idx >= len(compounds): break\n    name = compounds[comp_idx]['name']\n    \n    aff_m = re.search(r'CNNaffinity:\\s*([-\\d.]+)', mol)\n    pose_m = re.search(r'CNNscore:\\s*([-\\d.]+)', mol)\n    if aff_m:\n        aff = float(aff_m.group(1))\n        pose = float(pose_m.group(1)) if pose_m else 0\n        # Take best CNNaffinity (top rank) for each compound\n        if name not in best or aff > best[name]['aff']:\n            best[name] = {'aff': aff, 'pose': pose}\n\nprint(f'Unique compounds: {len(best)}')\nprint()\nprint('P2RANK-Box Docking \u2014 Top Pose per Compound:')\nprint()\nranked = sorted(best.items(), key=lambda x: x[1]['aff'], reverse=True)\nprint(f'{\\\"Rank\\\":<5} {\\\"Compound\\\":<25} {\\\"CNNpose\\\":<10} {\\\"CNNaff\\\":<10}')\nprint('-'*55)\nfor i, (name, d) in enumerate(ranked, 1):\n    print(f'{i:<5} {name:<25} {d[\\\"pose\\\"]:<10.4f} {d[\\\"aff\\\"]:<10.4f}')\n\"\n"}

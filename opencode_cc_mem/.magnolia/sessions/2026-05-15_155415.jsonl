{"event_type":"tool_call","timestamp":"2026-06-24T14:00:00.766750Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\nR=2026-06-16_af3_TGGFQMALT_s10000_full\necho \"=== stages present + capri_clt? ===\"\nls $R/output/ 2>/dev/null | tr '\\n' ' '; echo\nfind $R -name 'capri_clt.tsv' 2>/dev/null\necho\npython3 - <<PY\nimport json,gzip,glob,re\nR=\"$R\"\n# ---- score ----\nf=f\"{R}/output/12_caprieval/capri_clt.tsv\"\ntry:\n    wp=f\"{R}/output/12_caprieval/weights_params.json\"; wair=json.load(open(wp)).get('w_air',0.1)\nexcept: wair=0.1\nrows=[];idx={}\ntry:\n    for line in open(f):\n        if line.startswith('#') or not line.strip(): continue\n        if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n        rows.append(line.rstrip().split('\\t'))\n    g=lambda rw,c: rw[idx[c]]\n    print(\"=== TGGFQMALT (9-mer) AF3 score (top clusters) ===\")\n    for rw in rows[:4]:\n        af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n        print(f\"  clt{g(rw,'cluster_id')} rank{g(rw,'caprieval_rank')}: AIR-free={af:.2f} DockQ={float(g(rw,'dockq')):.3f} n={g(rw,'n')}\")\n    best_clt=rows[0][idx['cluster_id']]\nexcept Exception as e:\n    print(\"score read failed:\",e); best_clt=None\n# ---- domain spanning from best-cluster model ----\nif best_clt:\n    ms=sorted(glob.glob(f\"{R}/output/11_seletopclusts/cluster_{best_clt}_model_*.pdb.gz\"))\n    if not ms: \n        # fallback: any cluster model\n        ms=sorted(glob.glob(f\"{R}/output/11_seletopclusts/cluster_*_model_1.pdb.gz\"))\n    if ms:\n        mf=ms[0]\n        rec={};pep={}\n        with gzip.open(mf,'rt') as fh:\n            for line in fh:\n                if not line.startswith('ATOM'): continue\n                ch=line[21];res=int(line[22:26]);name=line[12:16].strip()\n                if name.startswith('H'): continue\n                try: x,y,z=float(line[30:38]),float(line[38:46]),float(line[46:54])\n                except: continue\n                (pep if ch=='B' else rec).setdefault((ch,res),[]).append((x,y,z))\n        pa=[a for v in pep.values() for a in v]\n        nbd=set();sbd=set()\n        for (ch,res),ats in rec.items():\n            for x,y,z in ats:\n                if any((x-px)**2+(y-py)**2+(z-pz)**2<=25 for _,px,py,pz in [(0,0,0)]+pa):\n                    # need actual pep atoms\n                    pass\n        # redo cleanly\n        nbd=set();sbd=set()\n        for (ch,res),ats in rec.items():\n            hit=False\n            for x,y,z in ats:\n                for px,py,pz in pa:\n                    if (x-px)**2+(y-py)**2+(z-pz)**2<=25.0:\n                        hit=True;break\n                if hit:\n                    if res<=383: nbd.add(res)\n                    else: sbd.add(res)\n                    break\n        cl=os.path.basename(mf).split('_')[1]\n        print(f\"\\n=== contacts from {os.path.basename(mf)} ===\")\n        print(f\"  NBD (<=383): {len(nbd)} {sorted(nbd) if nbd else 'NONE'}\")\n        print(f\"  SBD (>=384): {len(sbd)} [{min(sbd)}-{max(sbd)}]\" if sbd else \"  SBD: none\")\n        print(f\"  VERDICT: {'SBD-ONLY \u2713' if not nbd else 'SPANS NBD \u2717'}\")\n    else: print(\"no seletopclusts model found\")\nPY"}

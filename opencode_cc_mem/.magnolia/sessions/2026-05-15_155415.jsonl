{"event_type":"tool_call","timestamp":"2026-06-24T13:53:56.143477Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\necho \"=== RKELQx2: domain-spanning PER cluster (all contactmap clusters) ===\"\npython3 - <<'PY'\nimport glob,re,os\nR=\"2026-06-16_af3_RKELQx2_s10000_full\"\nfor f in sorted(glob.glob(f\"{R}/output/*_contactmap/cluster*_interchain_contacts.tsv\")):\n    nbd=set();sbd=set()\n    for line in open(f):\n        if line.startswith('#') or not line.strip() or line.startswith('res1'): continue\n        m=re.match(r'A-(\\d+)-',line.split('\\t')[0])\n        if m:\n            rr=int(m.group(1)); (nbd if rr<=383 else sbd).add(rr)\n    cl=os.path.basename(f).split('_')[0]\n    verdict=\"SBD-ONLY \u2713\" if not nbd else f\"SPANS NBD \u2717 [{min(nbd)}-{max(nbd)}]\"\n    print(f\"  {cl}: NBD={len(nbd):2d}  SBD={len(sbd):2d} [{min(sbd) if sbd else '-'}-{max(sbd) if sbd else '-'}]  {verdict}\")\nPY\necho\necho \"=== RKELQx2 alascan: native score + identify detrimental residues ===\"\npython3 - <<'PY'\nf=\"2026-06-22_alascan_rkelqx2_af3/output/1_alascan/scan_complex_haddock.tsv\"\n# find header (non-# line starting the column names)\nhdr=None\nrows=[]\nfor line in open(f):\n    if line.startswith('#'): continue\n    s=line.rstrip('\\n')\n    if not s.strip(): continue\n    cols=s.split('\\t')\n    if hdr is None:\n        hdr=cols; continue\n    rows.append(cols)\nprint(\"columns:\", hdr[:8],\"...\")\n# col 0 chain,1 resnum,2 orig,3 mut,4 = score?\nimport collections\n# native = the row where orig==mut? or take min? HADDOCK alascan: each row = a mutant; 'score' col is mutant total score\nsc=4\nseq=[]\nfor r in rows:\n    if r[3]=='ALA' and r[2]!='ALA':\n        seq.append((int(r[1]),r[2],float(r[sc])))\n# reference: median score ~ native\nimport statistics\nvals=[x[2] for x in seq]\nnative=statistics.median(vals)\nprint(f\"approx native (median mutant score)={native:.2f}\")\nprint(f\"{'pos':>4}{'res':>4}{'mut_score':>11}{'vs_native':>10}  call\")\nfor pos,res,ms in seq:\n    d=ms-native\n    call=\"DETRIMENTAL (mutate->A)\" if d<-1.5 else (\"hotspot (keep)\" if d>1.5 else \"neutral\")\n    print(f\"{pos:>4}{res:>4}{ms:>11.2f}{d:>10.2f}  {call}\")\nPY"}

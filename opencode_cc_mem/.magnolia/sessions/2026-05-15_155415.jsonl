{"event_type":"tool_call","timestamp":"2026-06-25T13:10:53.866192Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c B=projects/hsc70_new/runs\ndeclare -A RUN=(\n  [EGGFQMALT_T1E]=2026-06-24_EGGFQMALT_s10000\n  [TAGFQMALT_G2A]=2026-06-24_TAGFQMALT_s10000\n  [EAGFQMALT_T1E_G2A]=2026-06-24_EAGFQMALT_s10000\n)\nfor k in EGGFQMALT_T1E TAGFQMALT_G2A EAGFQMALT_T1E_G2A; do\n  d=\"$B/${RUN[$k]}/output/13_contactmap\"\n  echo \"========================= $k =========================\"\n  printf \"%-10s %-8s %-22s %s\\n\" \"cluster\" \"lid?\" \"tail?\" \"signature_residues\"\n  for f in $(ls \"$d\"/cluster*_interchain_contacts.tsv 2>/dev/null | sort -V); do\n    cn=$(basename \"$f\" | grep -oE 'cluster[0-9]+')\n    recs=$(awk -F'\\t' '$1 ~ /^A-/{split($1,a,\"-\"); print a[2]}' \"$f\" | sort -n -u)\n    lid=$(echo \"$recs\" | awk '$1>=533 && $1<=552' | tr '\\n' ',' )\n    tail=$(echo \"$recs\" | awk '$1>=621 && $1<=624' | tr '\\n' ',')\n    sig=$(echo \"$recs\" | awk '$1==533||$1==544||$1==548||$1==551||$1==552||$1==622||$1==623' | tr '\\n' ' ')\n    [ -n \"$lid\" ] && lidstat=\"YES($lid)\" || lidstat=\"no\"\n    [ -n \"$tail\" ] && tailstat=\"YES($tail)\" || tailstat=\"no\"\n    printf \"%-10s %-8s %-22s %s\\n\" \"$cn\" \"$lidstat\" \"$tailstat\" \"${sig:-(none)}\"\n  done\ndone"}

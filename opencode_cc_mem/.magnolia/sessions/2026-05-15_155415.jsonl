{"event_type":"tool_call","timestamp":"2026-06-09T08:48:09.267577Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re, os\n\n# Actual SDF order (alphabetical)\nsdf_names = sorted(os.listdir('ligands_xtb_opt'))\nsdf_names = [f.replace('_opt.sdf','') for f in sdf_names if f.endswith('_opt.sdf')]\n\n# Map back: convert filename to Dataset S3 name\nname_map = {\n    '+-Carvone': '(+)-Carvone',\n    '--Carvone': '(-)-Carvone',\n    '37-Dimethyloctanol': '3,7-Dimethyloctanol',\n    'C8-Ald': 'C8-Ald', 'C10-Ald': 'C10-Ald', 'C12-Ald': 'C12-Ald',\n    'C14-Ald': 'C14-Ald', 'C16-Ald': 'C16-Ald', 'C18-Ald': 'C18-Ald',\n    'E2-10-Ald': 'E2-10-Ald',\n    'Cedrol': 'Cedrol', 'Citral': 'Citral', 'Citralva': 'Citralva',\n    'Citronellal': 'Citronellal', 'Coniferyl_aldehyde': 'Coniferyl aldehyde',\n    'Decanoic_acid': 'Decanoic acid', 'Eugenol': 'Eugenol',\n    'Farnesol': 'Farnesol', 'Geraniol': 'Geraniol',\n    'Geranyl_acetate': 'Geranyl acetate', 'Lauric_acid': 'Lauric acid',\n    'Linalool': 'Linalool', 'Linoleic_acid': 'Linoleic acid',\n    'Myristic_acid': 'Myristic acid', 'Octanoic_acid': 'Octanoic acid',\n    'Oleic_acid': 'Oleic acid', 'Palmitic_acid': 'Palmitic acid',\n    'Phytol': 'Phytol', 'Safranal': 'Safranal',\n    'Stearic_acid': 'Stearic acid',\n    'Z11-16-Ac': 'Z11-16-Ac', 'Z11-16-Ald': 'Z11-16-Ald',\n    'Z11-16-COOH': 'Z11-16-COOH', 'Z11-16-OH': 'Z11-16-OH',\n    'Z13-18-COOH': 'Z13-18-COOH', 'Z9-14-Ald': 'Z9-14-Ald',\n    'Z9-14-COOH': 'Z9-14-COOH', 'Z9-16-Ald': 'Z9-16-Ald',\n    'Z9-16-COOH': 'Z9-16-COOH', '\u03b2-Ionone': '\u03b2-Ionone',\n}\n\n# Now read docking scores (from gnina output)\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\nblocks = text.split('mode |  affinity')\ndock_scores = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            dock_scores.append({'aff': float(m.group(2)), 'cnn_pose': float(m.group(4)), 'cnn_aff': float(m.group(5))})\n            break\n\n# Load experimental data\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\n\n# Build lookup: name \u2192 experimental Kd\nexp_lookup = {c['name']: c.get('kd_obp3', 999) for c in exp_data}\n\n# Now match CORRECTLY\nprint(f\"SDF entries: {len(sdf_names)}, Dock scores: {len(dock_scores)}, Exp entries: {len(exp_data)}\")\n\ncorrect_pairs = []\nfor i, fn in enumerate(sdf_names):\n    if i >= len(dock_scores): break\n    name = name_map.get(fn, fn)\n    kd = exp_lookup.get(name)\n    if kd is None:\n        print(f\"  MISSING exp for: {fn} \u2192 {name}\")\n        continue\n    correct_pairs.append((name, kd, dock_scores[i]['aff'], dock_scores[i]['cnn_pose'], dock_scores[i]['cnn_aff']))\n\n# Recompute correlation\nfrom scipy.stats import spearmanr\nimport numpy as np\n\nkd_arr = np.array([p[1] for p in correct_pairs])\naff_arr = np.array([p[2] for p in correct_pairs])\ncnn_arr = np.array([p[3] for p in correct_pairs])\ncnnaff_arr = np.array([p[4] for p in correct_pairs])\n\nrho_aff, p_aff = spearmanr(aff_arr, kd_arr)\nrho_cnn, p_cnn = spearmanr(cnn_arr, kd_arr)\nrho_cnnaff, p_cnnaff = spearmanr(cnnaff_arr, kd_arr)\n\nprint(f\"\\n=== CORRECT CORRELATIONS (N={len(correct_pairs)}) ===\")\nprint(f\"Empirical affinity:  \u03c1={rho_aff:+.4f}  p={p_aff:.4f}\")\nprint(f\"CNN pose score:      \u03c1={rho_cnn:+.4f}  p={p_cnn:.4f}\")\nprint(f\"CNN affinity:        \u03c1={rho_cnnaff:+.4f}  p={p_cnnaff:.4f}\")\n\n# Show top-10 by empirical affinity\ncorrect_pairs.sort(key=lambda x: x[2])\nprint(f\"\\nTop 10 by empirical affinity:\")\nfor i, (name, kd, aff, cnn, cnnaff) in enumerate(correct_pairs[:10], 1):\n    cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else (\"WEAK\" if kd < 43 else \"NON\"))\n    print(f\"  {i:2d}. {name:<22s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  [{cls}]\")\n\n# And the selectivity test\nprint(f\"\\n=== Z11-16 selectivity ===\")\nfor name, kd, aff, cnn, cnnaff in correct_pairs:\n    if 'Z11-16' in name:\n        print(f\"  {name:<15s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  CNNpose={cnn:.4f}\")\n\nPYEOF"}

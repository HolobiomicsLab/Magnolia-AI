{"event_type":"tool_call","timestamp":"2026-07-01T07:10:51.808845Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os\n\nruns = {\n    \"EGGFQMAKT (L8->K)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART (L8->R)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"KFERQx2 s20000\": \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\",\n}\n\nfor label, d in runs.items():\n    clf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\n    print(f\"\\n=== {label} ===\")\n    if os.path.exists(clf):\n        with open(clf) as f:\n            for line in f:\n                line = line.strip()\n                if line:\n                    print(f\"  {line}\")\n    # Also check clustfcc_scoring.tsv for AIR-free\n    sc = f\"{d}/output/12_caprieval/clustfcc_scoring.tsv\"\n    if not os.path.exists(sc):\n        sc = f\"{d}/output/09_caprieval/clustfcc_scoring.tsv\"\n    if os.path.exists(sc):\n        print(\"\\n  [cluster scoring]\")\n        with open(sc) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        if lines:\n            header = lines[0].strip().split('\\t')\n            print(f\"  cols: {header}\")\n            for line in lines[1:6]:\n                parts = line.strip().split('\\t')\n                vals = dict(zip(header, parts))\n                score = float(vals.get('score', 0))\n                air = float(vals.get('air', 0))\n                air_free = score - 0.1 * air\n                print(f\"  {vals.get('cluster_id','?')}(r{vals.get('cluster_ranking','?')}): score={score:.2f} air_free={air_free:.2f} n={vals.get('n','?')} vdw={vals.get('vdw','0')} elec={vals.get('elec','0')} bsa={vals.get('bsa','0')} desolv={vals.get('desolv','0')}\")\nPYEOF"}

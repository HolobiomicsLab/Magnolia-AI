{"event_type":"tool_call","timestamp":"2026-06-17T20:22:46.747653Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, os\n\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\n# Load RKALQ contact map\ncontacts = []\nwith open(f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\") as f:\n    for line in f:\n        if line[0] == '#' or line.startswith(\"res1\"):\n            continue\n        parts = line.strip().split(\"\\t\")\n        if len(parts) < 7:\n            continue\n        contacts.append({\n            \"rec\": parts[0].strip(),\n            \"pep\": parts[1].strip(),\n            \"prob\": float(parts[5]),\n            \"dist\": float(parts[6]),\n        })\n\n# Load model, compute pocket\npdb = \"/tmp/rkalq_c1_m1.pdb\"\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26]); atomname = line[12:16].strip()\n        atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vec_len(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef normalize(v):\n    l = vec_len(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\npep_atoms = [(a[1], a[2], a[3], a[4], a[5], a[6]) for a in atoms if a[0] == 'B']\nrec_by_res = {}\nfor a in atoms:\n    if a[0] == 'A':\n        if a[2] not in rec_by_res:\n            rec_by_res[a[2]] = {\"resname\": a[1], \"atoms\": []}\n        rec_by_res[a[2]][\"atoms\"].append((a[3], a[4], a[5], a[6]))\n\n# Pocket = residues within 5.0 \u00c5\npocket = {}\nfor rid in sorted(rec_by_res.keys()):\n    min_d = min(dist((px,py,pz), ra) for _,_,_,px,py,pz in pep_atoms for ra in rec_by_res[rid][\"atoms\"])\n    if min_d <= 5.0:\n        pocket[rid] = min_d\n\n# Get contacted residues (strong: prob \u2265 0.5)\ncontacted = set()\nfor c in contacts:\n    if c[\"prob\"] >= 0.5:\n        rec_rid = int(c[\"rec\"].split(\"-\")[1])\n        contacted.add(rec_rid)\n\n# Also include weak contacts (prob 0.2-0.5)\nweak_contacted = set()\nfor c in contacts:\n    if 0.2 <= c[\"prob\"] < 0.5:\n        rec_rid = int(c[\"rec\"].split(\"-\")[1])\n        weak_contacted.add(rec_rid)\n\n# Under-utilized: in pocket but not strongly contacted\nall_pocket = set(pocket.keys())\nunderutilized = all_pocket - contacted\nstrong_but_pocket = all_pocket & contacted\n\nprint(\"=\" * 70)\nprint(\"POCKET RESIDUES \u2014 UTILIZATION ANALYSIS (RKALQ)\")\nprint(\"=\" * 70)\n\nsbd_start, lid_start = 386, 531\n\nprint(f\"\\n{'Resid':>6s} {'Name':>4s} {'Dist(\u00c5)':>8s} {'Domain':>6s} {'Contacted by':>30s} {'Status'}\")\nprint(\"-\" * 70)\n\nfor rid in sorted(all_pocket):\n    name = rec_by_res[rid][\"resname\"]\n    d = pocket[rid]\n    if rid >= lid_start:\n        domain = \"LID\"\n    elif rid >= sbd_start:\n        domain = \"SBD\"\n    else:\n        domain = \"NBD\"\n    \n    # Which peptide residues contact this\n    hit_list = []\n    for c in contacts:\n        if int(c[\"rec\"].split(\"-\")[1]) == rid and c[\"prob\"] >= 0.5:\n            pep_id = c[\"pep\"].split(\"-\")[1]\n            pep_name = c[\"pep\"].split(\"-\")[2]\n            hit_list.append(f\"{pep_name}{pep_id}({c['prob']:.1f})\")\n    \n    if rid in contacted:\n        status = \"STRONG\"\n    elif rid in weak_contacted:\n        status = \"WEAK\"\n    else:\n        status = \"\u26a0 UNDER-UTILIZED\"\n    \n    hits = \",\".join(hit_list) if hit_list else \"\u2014\"\n    print(f\"{rid:6d} {name:>4s} {d:8.2f} {domain:>6s} {hits:>30s} {status}\")\n\n# Summary\nprint()\nprint(f\"Total pocket: {len(all_pocket)}\")\nprint(f\"  Strongly contacted:  {len(strong_but_pocket)}\")\nprint(f\"  Weakly contacted:    {len(all_pocket & weak_contacted)}\")\nprint(f\"  Under-utilized:      {len(underutilized)}\")\nprint(f\"\\nUnder-utilized residues: {sorted(underutilized)}\")\nprint(f\"  Names: {', '.join(f'{rid}({rec_by_res[rid][\\\"resname\\\"]})' for rid in sorted(underutilized))}\")\n\nPYEOF"}

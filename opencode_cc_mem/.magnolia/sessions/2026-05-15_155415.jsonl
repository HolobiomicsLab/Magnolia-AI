{"event_type":"tool_call","timestamp":"2026-06-18T10:01:38.498586Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c echo \"=== Batch 1 \u2014 June 16, core 5-mers (s5000, 12_caprieval) ===\"\nprintf \"%-12s %10s %10s %10s %8s %8s %4s\\n\" \"Peptide\" \"Raw\" \"Air\" \"AIR-free\" \"DockQ\" \"fnat\" \"n\"\nfor dir in \\\n  projects/hsc70_new/runs/2026-06-16_4po2_KFERQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_KILDQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_QRKEL_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_RKELQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_RKDLQ_s5000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_HAMNG_s5000_full; do\n  tsv=\"$dir/output/12_caprieval/capri_clt.tsv\"\n  awk -F'\\t' -v name=\"$(echo $(basename $dir) | sed 's/.*4po2_//;s/_s5000_full//')\" '\n    NR==15 { air_free = $5 - 0.1*$19\n             printf \"%-12s %10.2f %10.2f %10.2f %8.3f %8.3f %4s\\n\", name, $5, $19, air_free, $13, $9, $3 }\n  ' \"$tsv\"\ndone\n\necho \"\"\necho \"=== Batch 2 \u2014 June 17, extension scan (12_caprieval) ===\"\nprintf \"%-12s %6s %10s %10s %10s %8s %8s %4s\\n\" \"Peptide\" \"s\" \"Raw\" \"Air\" \"AIR-free\" \"DockQ\" \"fnat\" \"n\"\nfor dir in \\\n  projects/hsc70_new/runs/2026-06-17_RKNLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-17_RKGLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-17_RKALQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000 \\\n  projects/hsc70_new/runs/2026-06-17_RKALQL_s10000 \\\n  projects/hsc70_new/runs/2026-06-17_RKALQR_s10000; do\n  tsv=\"$dir/output/12_caprieval/capri_clt.tsv\"\n  awk -F'\\t' -v name=\"$(basename $dir | sed 's/2026-06-17_//')\" '\n    NR==15 { air_free = $5 - 0.1*$19\n             samp = $3 == \"20\" ? \"s10000\" : \"s5000\"\n             printf \"%-12s %6s %10.2f %10.2f %10.2f %8.3f %8.3f %4s\\n\", name, samp, $5, $19, air_free, $13, $9, $3 }\n  ' \"$tsv\"\ndone\n\necho \"\"\necho \"=== Longer peptides (12_caprieval) ===\"\nprintf \"%-12s %10s %10s %10s %8s %8s %4s\\n\" \"Peptide\" \"Raw\" \"Air\" \"AIR-free\" \"DockQ\" \"fnat\" \"n\"\nfor dir in \\\n  projects/hsc70_new/runs/2026-06-16_4po2_KFERQx2_s10000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_QRKELx2_s10000_full \\\n  projects/hsc70_new/runs/2026-06-16_4po2_RKELQx2_s10000_full; do\n  tsv=\"$dir/output/12_caprieval/capri_clt.tsv\"\n  awk -F'\\t' -v name=\"$(echo $(basename $dir) | sed 's/.*4po2_//;s/_s10000_full//')\" '\n    NR==15 { air_free = $5 - 0.1*$19\n             printf \"%-12s %10.2f %10.2f %10.2f %8.3f %8.3f %4s\\n\", name, $5, $19, air_free, $13, $9, $3 }\n  ' \"$tsv\"\ndone"}

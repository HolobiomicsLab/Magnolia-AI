{"event_type":"tool_call","timestamp":"2026-06-16T13:24:02.456960Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os, subprocess, gzip, glob, shutil\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nRUNS = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\"),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\"),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\"),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\"),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\"),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\"),\n]\n\nresults = {}\n\nfor tag, run_name in RUNS:\n    rd = f\"{BASE}/runs/{run_name}\"\n    seletop_dirs = glob.glob(f\"{rd}/output/*seletopclusts*\")\n    model_gz = f\"{seletop_dirs[0]}/cluster_1_model_1.pdb.gz\"\n    \n    work = f\"/tmp/mmpbsa_{tag}\"\n    if os.path.exists(work):\n        shutil.rmtree(work)\n    os.makedirs(work)\n    \n    with gzip.open(model_gz, 'rt') as f:\n        lines = f.readlines()\n    \n    def no_h(atoms):\n        return [l for l in atoms if not l[12:16].strip().startswith('H')]\n    \n    rec = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'A'])\n    lig = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'B'])\n    \n    for pdb_type, atoms in [('complex', rec + lig), ('rec', rec), ('lig', lig)]:\n        with open(f\"{work}/{pdb_type}.pdb\", 'w') as f:\n            f.writelines(atoms + ['END\\n'])\n    \n    # Write MMPBSA input file explicitly\n    with open(f\"{work}/mmpbsa.in\", 'w') as f:\n        f.write(\"\"\"&general\n  startframe=1, endframe=1, interval=1, keep_files=0, verbose=0,\n/\n&gb\n  igb=5, saltcon=0.150,\n/\n&decomp\n  idecomp=1, dec_verbose=3,\n/\n\"\"\")\n    \n    script = f\"\"\"#!/bin/bash\nsource /home/tjiang/anaconda3/etc/profile.d/conda.sh\nconda activate ambertools\ncd {work}\ntleap -f - > tleap.log 2>&1 << 'TLEAP_END'\nsource leaprc.protein.ff14SB\ncomplex = loadpdb {work}/complex.pdb\nsaveamberparm complex {work}/complex.prmtop {work}/complex.rst7\nrec = loadpdb {work}/rec.pdb\nsaveamberparm rec {work}/rec.prmtop {work}/rec.rst7\nlig = loadpdb {work}/lig.pdb\nsaveamberparm lig {work}/lig.prmtop {work}/lig.rst7\nquit\nTLEAP_END\n\nMMPBSA.py -O -i {work}/mmpbsa.in -cp {work}/complex.prmtop -rp {work}/rec.prmtop -lp {work}/lig.prmtop -y {work}/complex.rst7 -o {work}/out.dat -do {work}/decomp.dat -sp {work}/complex.prmtop -sr {work}/complex.rst7 > {work}/mmpbsa.log 2>&1\n\"\"\"\n    with open(f\"{work}/run.sh\", 'w') as f:\n        f.write(script)\n    \n    subprocess.run([\"bash\", f\"{work}/run.sh\"], capture_output=True, text=True)\n    \n    # Parse\n    total_binding = \"?\"\n    if os.path.exists(f\"{work}/out.dat\"):\n        for line in open(f\"{work}/out.dat\"):\n            if \"DELTA TOTAL\" in line:\n                total_binding = line.split()[-3]\n    \n    lig_data = []\n    seen = set()\n    if os.path.exists(f\"{work}/decomp.dat\"):\n        for line in open(f\"{work}/decomp.dat\"):\n            if ',L ' not in line:\n                continue\n            parts = line.strip().split(',')\n            if len(parts) < 18:\n                continue\n            amber_name = parts[0].strip().split()[0]\n            amber_resi = parts[0].strip().split()[1]\n            key = f\"{amber_name}{amber_resi}\"\n            if key in seen:\n                continue\n            seen.add(key)\n            try:\n                vdw = float(parts[5])\n                elec = float(parts[8])\n                polar = float(parts[11])\n                npolar = float(parts[14])\n                total = float(parts[17])\n                interaction = vdw + elec + polar + npolar\n                haddock_parts = parts[1].strip().split()\n                hname = haddock_parts[-2] + haddock_parts[-1] if len(haddock_parts) >= 3 else key\n                lig_data.append((hname, vdw, elec, polar, npolar, total, interaction))\n            except (ValueError, IndexError):\n                pass\n    \n    results[tag] = (total_binding, lig_data)\n    best = min(lig_data, key=lambda x: x[6]) if lig_data else (\"?\", 0)\n    print(f\"{tag:10s} \u0394G={total_binding:>8s}  best={best[0]}({best[6]:+.1f})  res={len(lig_data)}\", flush=True)\n\nprint()\nprint(\"=\" * 100)\nprint(\"Per-residue interaction energy (MM-GBSA, kcal/mol)\")\nprint(\"=\" * 100)\nfor tag, (tb, data) in results.items():\n    if not data:\n        continue\n    parts = [f\"{r}:{i:+.1f}\" for r, v, e, p, n, t, i in data]\n    print(f\"{tag:10s}  {'  '.join(parts)}\")\n\nprint()\nprint(\"=\" * 100)\nprint(\"Summary: best residue per peptide\")\nprint(\"=\" * 100)\nfor tag, (tb, data) in results.items():\n    if not data:\n        continue\n    best = min(data, key=lambda x: x[6])\n    worst = max(data, key=lambda x: x[6])\n    print(f\"{tag:10s}  best: {best[0]}={best[6]:+.1f}  worst: {worst[0]}={worst[6]:+.1f}  spread: {worst[6]-best[6]:.1f}\")\n\nPYEOF"}

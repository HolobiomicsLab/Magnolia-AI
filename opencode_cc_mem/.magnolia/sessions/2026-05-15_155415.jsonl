{"event_type":"tool_call","timestamp":"2026-06-10T15:59:50.539309Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_all40\n\npython3 << 'PYEOF'\nimport json, math, os\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\n# Parse docked SDF\nwith open('docked_all40_asn90_flex5.sdf') as f:\n    content = f.read()\nblocks = content.split('$$$$')\n\n# Group results by molecule name\nfrom collections import defaultdict\nresults = defaultdict(list)\n\nfor b in blocks:\n    if not b.strip(): continue\n    lines = b.strip().split('\\n')\n    \n    mol_name = lines[0].strip()\n    cnn_score = cnn_aff = emp_aff = 0\n    for j, l in enumerate(lines):\n        if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n        if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n        if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n    \n    # Try to match molecule name to compound\n    matched = None\n    for c in data:\n        safe = c['name'].replace('/','_').replace(' ','_').replace('(','').replace(')','').replace('+','plus').replace('-','minus')\n        if safe in mol_name or c['name'] in mol_name:\n            matched = c['name']\n            break\n    \n    if matched is None:\n        # Try matching by SDF filename pattern\n        for c in data:\n            safe = c['name'].replace('/','_').replace(' ','_').replace('(','').replace(')','').replace('+','plus').replace('-','minus')\n            if safe.lower() in mol_name.lower() or mol_name.lower() in safe.lower():\n                matched = c['name']\n                break\n    \n    if matched:\n        results[matched].append((emp_aff, cnn_score, cnn_aff))\n\n# Get best empirical affinity for each compound\nprint(f\"{'Ligand':25s} {'IC50':>7s} {'Kd':>7s} {'EmpAff':>8s} {'CNNaff':>7s} {'CNNscore':>9s} {'Poses':>6s}\")\nprint(\"-\" * 82)\n\nrows = []\nfor c in data:\n    name = c['name']\n    if name not in results:\n        continue\n    \n    poses = results[name]\n    best_emp = min(poses, key=lambda x: x[0])\n    rows.append((name, c.get('ic50_obp3', 999), c.get('kd_obp3', 999), \n                 best_emp[0], best_emp[1], best_emp[2], len(poses)))\n\nrows.sort(key=lambda x: x[3])  # sort by empirical affinity\n\nfor name, ic50, kd, emp, cs, ca, np in rows:\n    ic50_s = f'{ic50:.1f}' if isinstance(ic50, (int,float)) else str(ic50)\n    kd_s = f'{kd:.3f}' if isinstance(kd, (int,float)) else str(kd)\n    print(f\"{name:25s} {ic50_s:>7s} {kd_s:>7s} {emp:>8.1f} {ca:>7.1f} {cs:>9.4f} {np:>6d}\")\n\n# Spearman\n# Only use compounds with IC50 values (numeric)\nnumeric = [(r[1], r[3]) for r in rows if isinstance(r[1], (int,float))]\nif len(numeric) >= 5:\n    from scipy.stats import spearmanr\n    ic50s = [n[0] for n in numeric]\n    emps = [n[1] for n in numeric]\n    rho, p = spearmanr(ic50s, emps)\n    print(f\"\\nSpearman \u03c1(IC50 vs EmpAff) = {rho:+.3f} (p={p:.3f}, n={len(numeric)})\")\n\nprint(f\"\\nTotal compounds docked: {len(results)}/40\")\n\n# List missing\nmissing = [c['name'] for c in data if c['name'] not in results]\nif missing:\n    print(f\"Missing ({len(missing)}): {missing}\")\nPYEOF"}

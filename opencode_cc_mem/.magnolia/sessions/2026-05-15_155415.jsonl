{"event_type":"tool_call","timestamp":"2026-06-05T08:59:56.865602Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/build_6mers.py << 'PYEOF'\nimport math, os, copy\n\ndef vec_norm(v):\n    l = math.sqrt(v[0]**2+v[1]**2+v[2]**2)\n    return (v[0]/l, v[1]/l, v[2]/l) if l > 1e-12 else (0,0,0)\n\ndef vec_cross(a, b):\n    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\n\ndef vec_dot(a, b):\n    return a[0]*b[0]+a[1]*b[1]+a[2]*b[2]\n\ndef rotation_matrix(axis, angle):\n    \"\"\"Rodrigues rotation formula. axis must be a unit vector.\"\"\"\n    a = math.cos(angle)\n    b = math.sin(angle)\n    c = 1 - a\n    x, y, z = axis\n    return [\n        [a + x*x*c, x*y*c - z*b, x*z*c + y*b],\n        [y*x*c + z*b, a + y*y*c, y*z*c - x*b],\n        [z*x*c - y*b, z*y*c + x*b, a + z*z*c],\n    ]\n\ndef matvec(m, v):\n    return [m[0][0]*v[0]+m[0][1]*v[1]+m[0][2]*v[2],\n            m[1][0]*v[0]+m[1][1]*v[1]+m[1][2]*v[2],\n            m[2][0]*v[0]+m[2][1]*v[1]+m[2][2]*v[2]]\n\ndef build_ala_backbone(n_pos, ca_dir_vec, resi):\n    \"\"\"Build an ALA residue.\"\"\"\n    atoms = []\n    ca_dir = vec_norm(ca_dir_vec)\n    \n    n = n_pos\n    atoms.append({\"name\":\"N\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":n[0],\"y\":n[1],\"z\":n[2],\"elem\":\"N\",\"occ\":1.0,\"bf\":15.0})\n    hn = (n[0]-0.86*ca_dir[0]+0.5, n[1]-0.86*ca_dir[1]+0.3, n[2]-0.86*ca_dir[2]-0.5)\n    atoms.append({\"name\":\"HN\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":hn[0],\"y\":hn[1],\"z\":hn[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n    \n    ca = (n[0]+1.46*ca_dir[0], n[1]+1.46*ca_dir[1], n[2]+1.46*ca_dir[2])\n    atoms.append({\"name\":\"CA\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":ca[0],\"y\":ca[1],\"z\":ca[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    ha = (ca[0]+0.5, ca[1]+0.3, ca[2]+0.5)\n    atoms.append({\"name\":\"HA\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":ha[0],\"y\":ha[1],\"z\":ha[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n    \n    # CB perpendicular to backbone plane\n    perp = vec_norm(vec_cross(ca_dir, (0.2, 0.9, -0.3)))\n    cb = (ca[0]+1.53*perp[0], ca[1]+1.53*perp[1], ca[2]+1.53*perp[2])\n    atoms.append({\"name\":\"CB\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":cb[0],\"y\":cb[1],\"z\":cb[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    for j in range(3):\n        offs = [(0.7,0.6,0.3), (-0.3,0.9,-0.2), (-0.4,-0.3,0.8)]\n        hb = (cb[0]+offs[j][0], cb[1]+offs[j][1], cb[2]+offs[j][2])\n        atoms.append({\"name\":f\"HB{j+1}\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":hb[0],\"y\":hb[1],\"z\":hb[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n    \n    c = (ca[0]+1.52*ca_dir[0], ca[1]+1.52*ca_dir[1], ca[2]+1.52*ca_dir[2])\n    atoms.append({\"name\":\"C\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":c[0],\"y\":c[1],\"z\":c[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    o = (c[0]+0.1, c[1]+1.23, c[2]-0.1)\n    atoms.append({\"name\":\"O\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\"x\":o[0],\"y\":o[1],\"z\":o[2],\"elem\":\"O\",\"occ\":1.0,\"bf\":15.0})\n    return atoms\n\ndef read_pdb(path):\n    atoms = []\n    opener = __import__('gzip').open if path.endswith('.gz') else open\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\") or line.startswith(\"HETATM\"):\n                atoms.append({\n                    \"name\": line[12:16].strip(),\n                    \"resn\": line[17:20].strip(),\n                    \"chain\": line[21],\n                    \"resi\": int(line[22:26]),\n                    \"x\": float(line[30:38]),\n                    \"y\": float(line[38:46]),\n                    \"z\": float(line[46:54]),\n                    \"occ\": float(line[54:60]) if line[54:60].strip() else 1.0,\n                    \"bf\": float(line[60:66]) if line[60:66].strip() else 15.0,\n                    \"elem\": line[76:78].strip(),\n                })\n    return atoms\n\ndef write_pdb(atoms, path):\n    with open(path, 'w') as f:\n        f.write(\"REMARK   Generated 6-mer peptide for HADDOCK3\\n\")\n        for i, a in enumerate(atoms):\n            serial = i + 1\n            name = a[\"name\"]\n            if len(name) == 1:\n                name = f\" {name}  \"\n            elif len(name) == 2:\n                name = f\" {name} \"\n            elif len(name) == 3:\n                name = f\" {name}\"\n            f.write(f\"ATOM  {serial:5d} {name} {a['resn']} {a['chain']}{a['resi']:4d}    \"\n                    f\"{a['x']:8.3f}{a['y']:8.3f}{a['z']:8.3f}\"\n                    f\"{a['occ']:6.2f}{a['bf']:6.2f}          {a['elem']:>2}  \\n\")\n        f.write(\"END\\n\")\n\ndef get_by_name(atoms, resi, name):\n    for a in atoms:\n        if a[\"resi\"]==resi and a[\"name\"]==name:\n            return a\n    return None\n\ndef align_residue(template_atoms, target_n, target_ca_dir):\n    \"\"\"Translate + rotate template atoms so N->target_n, N->CA aligns with target_ca_dir.\"\"\"\n    t_n = get_by_name(template_atoms, template_atoms[0][\"resi\"], \"N\")\n    t_ca = get_by_name(template_atoms, template_atoms[0][\"resi\"], \"CA\")\n    if not t_n or not t_ca:\n        return [copy.deepcopy(a) for a in template_atoms]\n    \n    # Template N->CA vector (normalized)\n    t_vec = (t_ca[\"x\"]-t_n[\"x\"], t_ca[\"y\"]-t_n[\"y\"], t_ca[\"z\"]-t_n[\"z\"])\n    t_dir = vec_norm(t_vec)\n    target_dir = vec_norm(target_ca_dir)\n    \n    # Rotation axis and angle\n    axis = vec_cross(t_dir, target_dir)\n    axis_len = math.sqrt(axis[0]**2+axis[1]**2+axis[2]**2)\n    \n    result = []\n    if axis_len < 1e-6:\n        for a in template_atoms:\n            na = copy.deepcopy(a)\n            na[\"x\"] += target_n[0] - t_n[\"x\"]\n            na[\"y\"] += target_n[1] - t_n[\"y\"]\n            na[\"z\"] += target_n[2] - t_n[\"z\"]\n            result.append(na)\n    else:\n        axis = vec_norm(axis)\n        angle = math.acos(max(-1.0, min(1.0, vec_dot(t_dir, target_dir))))\n        R = rotation_matrix(axis, angle)\n        for a in template_atoms:\n            rel = (a[\"x\"]-t_n[\"x\"], a[\"y\"]-t_n[\"y\"], a[\"z\"]-t_n[\"z\"])\n            rot = matvec(R, rel)\n            na = copy.deepcopy(a)\n            na[\"x\"] = target_n[0] + rot[0]\n            na[\"y\"] = target_n[1] + rot[1]\n            na[\"z\"] = target_n[2] + rot[2]\n            result.append(na)\n    return result\n\n# === MAIN ===\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\nkferq_all = read_pdb(f\"{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nkferqx2_all = read_pdb(f\"{base}/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\n\npep5 = sorted([a for a in kferq_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"name\"]))\npep11 = sorted([a for a in kferqx2_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"name\"]))\n\n# Templates from KFERQx2\nlys_t = [a for a in pep11 if a[\"resi\"]==652]\nphe_t = [a for a in pep11 if a[\"resi\"]==648]\ngln_t = [a for a in pep11 if a[\"resi\"]==651]\n\n# C-term extension geometry\nq651_c = get_by_name(pep5, 651, \"C\")\nq651_ca = get_by_name(pep5, 651, \"CA\")\ncterm_dir = vec_norm((q651_c[\"x\"]-q651_ca[\"x\"], q651_c[\"y\"]-q651_ca[\"y\"], q651_c[\"z\"]-q651_ca[\"z\"]))\nn652 = (q651_c[\"x\"]+1.33*cterm_dir[0], q651_c[\"y\"]+1.33*cterm_dir[1], q651_c[\"z\"]+1.33*cterm_dir[2])\n\n# N-term extension geometry\nk647_n = get_by_name(pep5, 647, \"N\")\nk647_ca = get_by_name(pep5, 647, \"CA\")\nnterm_dir = vec_norm((k647_ca[\"x\"]-k647_n[\"x\"], k647_ca[\"y\"]-k647_n[\"y\"], k647_ca[\"z\"]-k647_n[\"z\"]))\nc646 = (k647_n[\"x\"]-1.33*nterm_dir[0], k647_n[\"y\"]-1.33*nterm_dir[1], k647_n[\"z\"]-1.33*nterm_dir[2])\nca646 = (c646[0]-1.52*nterm_dir[0], c646[1]-1.52*nterm_dir[1], c646[2]-1.52*nterm_dir[2])\nn646 = (ca646[0]-1.46*nterm_dir[0], ca646[1]-1.46*nterm_dir[1], ca646[2]-1.46*nterm_dir[2])\n\noutdir = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/raw_input/peptides/6mers\"\nos.makedirs(outdir, exist_ok=True)\n\n# Build each 6-mer\ntargets = [\n    (\"KFERQ_K.pdb\", lys_t, \"LYS\", n652, cterm_dir, \"cterm\"),\n    (\"KFERQ_F.pdb\", phe_t, \"PHE\", n652, cterm_dir, \"cterm\"),\n    (\"KFERQ_Q.pdb\", gln_t, \"GLN\", n652, cterm_dir, \"cterm\"),\n]\n\nfor fname, templ, resn, target_n, ca_dir, mode in targets:\n    if mode == \"cterm\":\n        atoms = [copy.deepcopy(a) for a in pep5]\n        aligned = align_residue(templ, target_n, ca_dir)\n        for a in aligned:\n            na = copy.deepcopy(a)\n            na[\"resi\"] = 652\n            na[\"resn\"] = resn\n            atoms.append(na)\n    write_pdb(atoms, f\"{outdir}/{fname}\")\n\n# ALA C-term\nala_c = build_ala_backbone(n652, cterm_dir, 652)\natoms = [copy.deepcopy(a) for a in pep5] + ala_c\nwrite_pdb(atoms, f\"{outdir}/KFERQ_A_C.pdb\")\n\n# ALA N-term\nala_n = build_ala_backbone(n646, nterm_dir, 646)\natoms = ala_n + [copy.deepcopy(a) for a in pep5]\nwrite_pdb(atoms, f\"{outdir}/A_KFERQ_N.pdb\")\n\nprint(\"Generated 5 6-mer PDBs:\")\nfor f in sorted(os.listdir(outdir)):\n    path = f\"{outdir}/{f}\"\n    atoms = read_pdb(path)\n    residues = sorted(set((a[\"resi\"],a[\"resn\"]) for a in atoms))\n    seq = \"\".join(rn[0] for _,rn in residues)\n    print(f\"  {f}: {len(residues)} residues [{seq}], {len(atoms)} atoms\")\nPYEOF\npython3 /tmp/build_6mers.py"}

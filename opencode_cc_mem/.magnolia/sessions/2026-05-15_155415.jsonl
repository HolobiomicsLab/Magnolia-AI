{"event_type":"tool_call","timestamp":"2026-06-17T09:14:12.071645Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c ssh azzurra 'python3 << \"PYEOF\"\nimport os, csv, json\n\nbase = \"/workspace/tjiang/magnolia/hsc70_new/runs\"\nw_air = 0.01\n\n# All AF3 runs with their labels\nruns = {\n    \"213648\": \"TGGFQMALT\",\n    \"213650\": \"KFERQ\",\n    \"213651\": \"KILDQ\",\n    \"213653\": \"RKDLQ\",\n    \"213654\": \"RKELQ\",\n    \"213656\": \"QRKEL\",\n    \"213703\": \"HAMNG\",\n    \"213704\": \"KFERQKFERRQ\",\n    \"213706\": \"QRKELQRKEL\",\n    \"213707\": \"RKELQRKELQ\",\n    \"213709\": \"RKDLQRKDDQ\",\n    \"213710\": \"KFERQKILDQRFFE\",\n}\n\n# Also 4PO2 runs for comparison\nruns_4po2 = {\n    \"121304\": \"KFERQ\",\n    \"121306\": \"HAMNG\",\n    \"121308\": \"RKELQ\",\n    \"135825\": \"KILDQ\",\n    \"135828\": \"RKDLQ\",\n    \"135830\": \"QRKEL\",\n    \"135833\": \"KFERQKFERRQ\",\n    \"135835\": \"QRKELQRKEL\",\n    \"135838\": \"RKELQRKELQ\",\n    \"165058\": \"RKDLQRKDDQ\",\n    \"165100\": \"KFERQKILDQRFFE\",\n}\n\n# 3-letter to 1-letter\naa_map = {\"ALA\":\"A\",\"ARG\":\"R\",\"ASN\":\"N\",\"ASP\":\"D\",\"CYS\":\"C\",\"GLN\":\"Q\",\"GLU\":\"E\",\n           \"GLY\":\"G\",\"HIS\":\"H\",\"ILE\":\"I\",\"LEU\":\"L\",\"LYS\":\"K\",\"MET\":\"M\",\"PHE\":\"F\",\n           \"PRO\":\"P\",\"SER\":\"S\",\"THR\":\"T\",\"TRP\":\"W\",\"TYR\":\"Y\",\"VAL\":\"V\",\"HIE\":\"H\",\"ACE\":\"x\"}\n\ndef get_sequence(pdb_path):\n    \"\"\"Extract 1-letter sequence from PDB, ordered by residue number.\"\"\"\n    residues = {}\n    with open(pdb_path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                resname = line[17:20].strip()\n                resseq = int(line[22:26].strip())\n                if resseq not in residues:\n                    residues[resseq] = resname\n    seq = \"\"\n    for resnum in sorted(residues):\n        three = residues[resnum]\n        one = aa_map.get(three, \"?\")\n        if one != \"x\":  # skip ACE cap\n            seq += one\n    return seq\n\ndef get_capri_data(run_dir, step=\"12_caprieval\"):\n    capri = os.path.join(run_dir, \"output\", step, \"capri_clt.tsv\")\n    if not os.path.isfile(capri):\n        return []\n    with open(capri) as f:\n        lines = [l for l in f if not l.startswith(\"#\")]\n    reader = csv.DictReader(lines, delimiter=\"\\t\")\n    clusters = []\n    for row in reader:\n        clusters.append({\n            \"rank\": int(row[\"cluster_rank\"]),\n            \"n\": int(row[\"n\"]),\n            \"score\": float(row[\"score\"]),\n            \"air\": float(row[\"air\"]),\n            \"dockq\": float(row[\"dockq\"]),\n            \"irmsd\": float(row[\"irmsd\"]),\n            \"fnat\": float(row[\"fnat\"]),\n            \"air_free\": float(row[\"score\"]) - w_air * float(row[\"air\"]),\n        })\n    return clusters\n\ndef get_clustfcc_sizes(run_dir):\n    cf = os.path.join(run_dir, \"output\", \"10_clustfcc\", \"clustfcc.txt\")\n    if not os.path.isfile(cf):\n        return None\n    sizes = {}\n    total_clusters = 0\n    with open(cf) as f:\n        for line in f:\n            if line.startswith(\"Cluster \"):\n                parts = line.strip().split()\n                # Cluster 1 (#5, n=10, top4_avg_score = ...)\n                cl_num = parts[1]\n                for p in parts:\n                    if p.startswith(\"n=\"):\n                        n = int(p[2:])\n                        sizes[cl_num] = n\n                total_clusters += 1\n    return {\"sizes\": sizes, \"total_clusters\": total_clusters}\n\nprint(\"=\" * 80)\nprint(\"AF3 RUNS - COMPLETE DATA\")\nprint(\"=\" * 80)\n\nfor rid in sorted(runs):\n    label = runs[rid]\n    run_dir = os.path.join(base, \"haddock3_20260616_\" + rid)\n    \n    # Sequence from local copy\n    peptide_pdb = None\n    local_base = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n    for d in os.listdir(local_base):\n        if \"af3_\" in d and rid in d:\n            peptide_pdb = os.path.join(local_base, d, \"peptide.pdb\")\n            break\n    # Try cluster peptide.pdb\n    cluster_pep = os.path.join(run_dir, \"peptide.pdb\")\n    if os.path.isfile(cluster_pep):\n        peptide_pdb = cluster_pep\n    \n    seq = get_sequence(peptide_pdb) if peptide_pdb else \"UNKNOWN\"\n    seqlen = len(seq)\n    \n    clusters = get_capri_data(run_dir)\n    clustfcc = get_clustfcc_sizes(run_dir)\n    \n    print(f\"\\n--- {label} (run {rid}, seq={seq}, len={seqlen}) ---\")\n    if clusters:\n        for c in clusters[:3]:\n            print(f\"  c{c['rank']}: n={c['n']} score={c['score']:.3f} air={c['air']:.3f} airfree={c['air_free']:.2f} dockq={c['dockq']:.3f} irmsd={c['irmsd']:.3f} fnat={c['fnat']:.3f}\")\n    if clustfcc:\n        c1_real = clustfcc[\"sizes\"].get(\"1\", \"?\")\n        print(f\"  clustfcc: total={clustfcc['total_clusters']} c1_real_n={c1_real}\")\n\nprint(\"\\n\" + \"=\" * 80)\nprint(\"4PO2 RUNS - COMPLETE DATA (for comparison)\")\nprint(\"=\" * 80)\n\nfor rid in sorted(runs_4po2):\n    label = runs_4po2[rid]\n    run_dir = os.path.join(base, \"haddock3_20260616_\" + rid)\n    clusters = get_capri_data(run_dir)\n    clustfcc = get_clustfcc_sizes(run_dir)\n    \n    print(f\"\\n--- {label} (run {rid}) ---\")\n    if clusters:\n        c = clusters[0]\n        print(f\"  c1: n={c['n']} score={c['score']:.3f} air={c['air']:.3f} airfree={c['air_free']:.2f} dockq={c['dockq']:.3f} irmsd={c['irmsd']:.3f}\")\n    if clustfcc:\n        c1_real = clustfcc[\"sizes\"].get(\"1\", \"?\")\n        print(f\"  clustfcc: total={clustfcc['total_clusters']} c1_real_n={c1_real}\")\n\nPYEOF'"}

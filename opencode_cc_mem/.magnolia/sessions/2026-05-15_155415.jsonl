{"event_type":"tool_call","timestamp":"2026-07-01T07:40:39.496020Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = {\n    \"EGGFQMAKT (L8->K)\": \"projects/hsc70_new/runs/2026-07-01_alascan_eggfqmakt\",\n    \"EGGFQMART (L8->R)\": \"projects/hsc70_new/runs/2026-07-01_alascan_eggfqmart\",\n    \"EAKFQMALT (G3->K)\": \"projects/hsc70_new/runs/2026-07-01_alascan_eakfqmalt\",\n    \"EAGFQMRLT (A7->R)\": \"projects/hsc70_new/runs/2026-07-01_alascan_eagfqmrlt\",\n    \"EAGFQMKLT (A7->K)\": \"projects/hsc70_new/runs/2026-07-01_alascan_eagfqmklt\",\n}\n\nfor label, d in runs.items():\n    print(f\"\\n{'='*60}\")\n    print(f\"  {label}\")\n    \n    # scan_complex_haddock.tsv has per-residue dHADDOCK scores\n    fpath = f\"{d}/output/1_alascan/scan_complex_haddock.tsv\"\n    if not os.path.exists(fpath):\n        print(\"  NO SCAN OUTPUT\")\n        continue\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    print(f\"  {'Position':<8s} {'Residue':<6s} {'\u0394_score':>10s} {'\u0394_elec':>10s} {'\u0394_vdw':>10s} {'\u0394_desolv':>10s}  {'Role'}\")\n    print(f\"  {'-'*70}\")\n    \n    rows = []\n    for row in reader:\n        res = row.get('residue_name','').strip()\n        pos = row.get('residue_number','').strip()\n        dscore = float(row.get('delta_score',0))\n        delec = float(row.get('delta_elec',0))\n        dvdw = float(row.get('delta_vdw',0))\n        ddesolv = float(row.get('delta_desolv',0))\n        rows.append((int(pos) if pos.isdigit() else 99, res, dscore, delec, dvdw, ddesolv))\n    \n    rows.sort()\n    for pos, res, ds, de, dv, dd in rows:\n        # Role assessment\n        if ds < -5:\n            role = \"HOTSPOT\"\n        elif ds < -2:\n            role = \"Important\"\n        elif ds > 2:\n            role = \"DETRIMENTAL\"\n        elif ds > 0:\n            role = \"Mild-detrimental\"\n        elif ds > -1:\n            role = \"Neutral\"\n        else:\n            role = \"Weak\"\n        print(f\"  {pos:<8d} {res:<6s} {ds:>+10.2f} {de:>+10.2f} {dv:>+10.2f} {dd:>+10.2f}  {role}\")\nPYEOF"}

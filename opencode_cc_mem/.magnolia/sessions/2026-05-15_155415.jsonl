{"event_type":"tool_call","timestamp":"2026-06-05T12:27:12.456453Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\ndef read_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/analysis/6mer_stage1\"\nparent = read_pdb(f\"{base}/cluster_1_model_1.pdb\")\nn_ala = read_pdb(f\"{base}/cluster_2_model_1.pdb\")\n\n# Verify receptor positions are identical\nrec_p = {(a[\"resi\"],a[\"name\"]): (a[\"x\"],a[\"y\"],a[\"z\"]) for a in parent if a[\"chain\"]==\"A\" and a[\"name\"]==\"CA\"}\nrec_n = {(a[\"resi\"],a[\"name\"]): (a[\"x\"],a[\"y\"],a[\"z\"]) for a in n_ala if a[\"chain\"]==\"A\" and a[\"name\"]==\"CA\"}\n\nshared = set(rec_p.keys()) & set(rec_n.keys())\ndiffs = []\nfor k in list(shared)[:50]:\n    p = rec_p[k]\n    n = rec_n[k]\n    d = math.sqrt((p[0]-n[0])**2+(p[1]-n[1])**2+(p[2]-n[2])**2)\n    if d > 0.01:\n        diffs.append((k, d))\nif diffs:\n    print(f\"RECEPTOR COORDINATES DIFFER! {len(diffs)} atoms with d>0.01\")\n    for k, d in sorted(diffs, key=lambda x: -x[1])[:10]:\n        print(f\"  {k}: \u0394={d:.1f}A\")\nelse:\n    print(f\"Receptor coordinates identical (checked {len(shared)} CA atoms)\")\n\n# Get peptide centroid\npep_p = [a for a in parent if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"]\npep_n = [a for a in n_ala if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"]\ncent_p = [sum(a[k] for a in pep_p)/len(pep_p) for k in [\"x\",\"y\",\"z\"]]\ncent_n = [sum(a[k] for a in pep_n)/len(pep_n) for k in [\"x\",\"y\",\"z\"]]\ncent_d = math.sqrt(sum((cent_p[i]-cent_n[i])**2 for i in range(3)))\nprint(f\"\\nPeptide centroid shift: {cent_d:.1f}A\")\nprint(f\"Parent centroid: ({cent_p[0]:.1f}, {cent_p[1]:.1f}, {cent_p[2]:.1f})\")\nprint(f\"N-ALA centroid:  ({cent_n[0]:.1f}, {cent_n[1]:.1f}, {cent_n[2]:.1f})\")\n\n# Check what receptor domain the N-ALA peptide is near\nprint(\"\\n=== N-ALA peptide vs receptor domains ===\")\n# Full Hsc70 has NBD (resi ~1-385) and SBD (resi ~386-615)\n# Check which receptor residues are within 10A of N-ALA peptide\npep_n_atoms = [a for a in n_ala if a[\"chain\"]==\"B\"]\nrec_n_atoms = [a for a in n_ala if a[\"chain\"]==\"A\"]\nnear_rec = set()\nfor pa in pep_n_atoms:\n    for ra in rec_n_atoms:\n        d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n        if d < 10:\n            near_rec.add(ra[\"resi\"])\nnbd = [r for r in near_rec if r <= 385]\nsbd = [r for r in near_rec if r >= 386]\nprint(f\"  Residues within 10A: {len(near_rec)} total, {len(nbd)} NBD, {len(sbd)} SBD\")\nif nbd:\n    print(f\"  NBD range: {min(nbd)}-{max(nbd)}\")\nif sbd:\n    print(f\"  SBD range: {min(sbd)}-{max(sbd)}\")\n\n# Same for parent\npep_p_atoms = [a for a in parent if a[\"chain\"]==\"B\"]\nrec_p_atoms = [a for a in parent if a[\"chain\"]==\"A\"]\nnear_rec_p = set()\nfor pa in pep_p_atoms:\n    for ra in rec_p_atoms:\n        d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n        if d < 10:\n            near_rec_p.add(ra[\"resi\"])\nnbd_p = [r for r in near_rec_p if r <= 385]\nsbd_p = [r for r in near_rec_p if r >= 386]\nprint(f\"\\nParent peptide:\")\nprint(f\"  Residues within 10A: {len(near_rec_p)} total, {len(nbd_p)} NBD, {len(sbd_p)} SBD\")\nif nbd_p:\n    print(f\"  NBD range: {min(nbd_p)}-{max(nbd_p)}\")\nif sbd_p:\n    print(f\"  SBD range: {min(sbd_p)}-{max(sbd_p)}\")\n\nPYEOF"}

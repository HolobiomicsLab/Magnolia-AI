{"event_type":"tool_call","timestamp":"2026-07-01T16:27:04.578297Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef analyze(run_dir, cl, label, af, dq, pct):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        print(f\"  {label}: NO contact map for cl{cl}\"); return\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    core = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n    rec_set = set()\n    pep_map = {}  # pep_num -> [(dist, rec_num, rec_res, ct, pep_res)]\n    \n    for row in reader:\n        p1 = row['res1'].split('-')  # A-404-GLU\n        p2 = row['res2'].split('-')  # B-3-GLY\n        if len(p1) < 3 or len(p2) < 3: continue\n        try:\n            rn = int(p1[1]); rr = p1[2]\n            pn = int(p2[1]); pr = p2[2]\n        except: continue\n        dist = float(row['shortest-dist'])\n        ct = row.get('contact-type','')\n        \n        rec_set.add(rn)\n        if pn not in pep_map: pep_map[pn] = []\n        pep_map[pn].append((dist, rn, rr, ct, pr))\n    \n    overlap = rec_set & core\n    missing = sorted(core - rec_set)\n    \n    # Domain counts\n    nbd = sum(1 for r in rec_set if r < 390)\n    sbdb = sum(1 for r in rec_set if 390 <= r <= 520)\n    lid = sum(1 for r in rec_set if 520 < r <= 615)\n    beyond = sum(1 for r in rec_set if r > 615)\n    \n    print(f\"\\n{'='*70}\")\n    print(f\"  {label}\")\n    print(f\"  AF={af:+.2f}  DockQ={dq:.3f}  groove={pct:.1f}%\")\n    print(f\"  Core: {len(overlap)}/19  missing: {missing[:6]}\")\n    print(f\"  NBD={nbd} SBD\u03b2={sbdb} lid={lid} beyond={beyond}\")\n    \n    # Per-residue closest contact\n    print(f\"  {'PDB':>4s} {'Res':>5s}  {'\u2192 closest receptor':>22s}  {'all receptor contacts (\u22645\u00c5)'}\")\n    for pn in sorted(pep_map):\n        contacts = sorted(pep_map[pn])\n        pr = contacts[0][4]  # peptide residue name\n        d, rn, rr, ct, _ = contacts[0]\n        all_str = \", \".join(f\"{r2}{n2}({d2:.1f})\" for d2,n2,r2,_,_ in contacts if d2 <= 5.0)\n        print(f\"  B{pn:>2d} {pr:>5s}  \u2192 {rr}{rn:>4d} @ {d:.1f}\u00c5 ({ct:>16s})   {all_str}\")\n    \n    # Designed acidic contacts\n    print(f\"  Designed contacts check:\")\n    for target_res in [404, 460, 433]:\n        target_name = {404:'GLU', 460:'GLU', 433:'ASP'}[target_res]\n        hits = []\n        for pn, contacts in pep_map.items():\n            for d, rn, rr, ct, pr in contacts:\n                if rn == target_res and d < 5.0:\n                    hits.append(f\"B{pn}({pr})@{d:.1f}\u00c5\")\n        if hits:\n            print(f\"    {target_name}{target_res}: {'; '.join(hits)}\")\n        else:\n            print(f\"    {target_name}{target_res}: \u2014 none \u2014\")\n\n# Three new peptides (best cluster each)\nanalyze(\"projects/hsc70_new/runs/2026-07-01_EKGFQMAKT_G2K_on_EGGFQMAKT_s10000\", 1,\n        \"EKGFQMAKT (G\u2082\u2192K+L\u2088\u2192K, double mutant)\", -97.29, 1.000, 52.0)\nanalyze(\"projects/hsc70_new/runs/2026-07-01_EKGFQMALT_G2K_on_EGGFQMALT_s10000\", 5,\n        \"EKGFQMALT (G\u2082\u2192K, single mutant)\", -109.56, 1.000, 4.5)\nanalyze(\"projects/hsc70_new/runs/2026-07-01_ERQKFERRQ_truncated_KFERQx2_s10000\", 3,\n        \"ERQKFERRQ (truncated KFERQx2)\", -107.60, 0.661, 39.0)\n\n# Parents for comparison\nanalyze(\"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3,\n        \"EGGFQMAKT (L\u2088\u2192K, parent)\", -118.59, 0.765, 4.0)\nanalyze(\"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1,\n        \"EGGFQMALT (parent)\", -110.86, 1.000, 68.0)\nanalyze(\"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1,\n        \"EAGFQMRLT (A\u2087\u2192R, reference)\", -116.51, 1.000, 48.5)\nPYEOF"}

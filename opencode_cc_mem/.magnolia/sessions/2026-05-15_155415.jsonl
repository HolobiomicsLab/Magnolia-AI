{"event_type":"tool_call","timestamp":"2026-07-01T07:49:38.725174Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\n# Get parent alascan data\nparents = {\n    \"EGGFQMALT cl1\": \"projects/hsc70_new/runs/2026-06-25_alascan_eggfqmalt_cl1\",\n    \"EAGFQMALT cl3\": \"projects/hsc70_new/runs/2026-06-25_alascan_eagfqmalt_cl3\",\n}\n\nfor label, d in parents.items():\n    fpath = f\"{d}/output/1_alascan/scan_complex_haddock.tsv\"\n    if not os.path.exists(fpath):\n        fpath = f\"{d}/output/alascan/scan_complex_haddock.tsv\"\n    if not os.path.exists(fpath):\n        print(f\"{label}: no alascan output found\")\n        continue\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    print(f\"\\n=== {label} ===\")\n    print(f\"  {'Pos':>4s} {'Res':>5s} {'\u0394_score':>9s} {'\u0394_elec':>9s} {'\u0394_vdw':>9s} {'\u0394_desolv':>9s}  Role\")\n    for row in reader:\n        pos = int(row['res'])\n        res = row['ori_resname']\n        ds = float(row['delta_score'])\n        de = float(row['delta_elec'])\n        dv = float(row['delta_vdw'])\n        dd = float(row['delta_desolv'])\n        if ds < -5: role = \"HOTSPOT\"\n        elif ds < -2: role = \"Important\"\n        elif ds > 2: role = \"DETRIMENTAL\"\n        elif ds > 0: role = \"Mild-detrimental\"\n        else: role = \"Neutral\"\n        print(f\"  {pos:>4d} {res:>5s} {ds:>+9.2f} {de:>+9.2f} {dv:>+9.2f} {dd:>+9.2f}  {role}\")\nPYEOF"}

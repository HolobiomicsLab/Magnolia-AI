') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\nGOOD, MOD, WEAK = [], [], []\nfor i, fn in enumerate(sdf_names):\n    if i >= len(dock): break\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    aff, cnn, cnnaff = dock[i]\n    if kd < 1.0:     GOOD.append((aff, name, kd, cnn, cnnaff))\n    elif kd < 10:    MOD.append((aff, name, kd, cnn, cnnaff))\n    else:            WEAK.append((aff, name, kd, cnn, cnnaff))\n\nfor block in [GOOD, MOD, WEAK]:\n    block.sort(key=lambda x: x[0])\n\nprint(\"\u2550\u2550\u2550 PAPER: STRONG BINDERS (Kd < 1 \u00b5M, n=10) \u2014 sorted by gnina affinity \u2550\u2550\u2550\")\nprint(f\"{'Compound':<22s} {'Kd_exp':>8s} {'GninaAff':>9s}\")\nprint(\"-\" * 42)\nfor aff, name, kd, _, _ in GOOD:\n    print(f\"  {name:<20s} {kd:>8.3f} {aff:>+9.2f}\")\n\nprint(f\"\\n\u2550\u2550\u2550 PAPER: MODERATE BINDERS (1 \u2264 Kd < 10 \u00b5M, n=16) \u2550\u2550\u2550\")\nprint(f\"{'Compound':<22s} {'Kd_exp':>8s} {'GninaAff':>9s}\")\nprint(\"-\" * 42)\nfor aff, name, kd, _, _ in MOD:\n    print(f\"  {name:<20s} {kd:>8.3f} {aff:>+9.2f}\")\n\nprint(f\"\\n\u2550\u2550\u2550 PAPER: WEAK / NON-BINDERS (Kd \u2265 10 \u00b5M, n=14) \u2550\u2550\u2550\")\nprint(f\"{'Compound':<22s} {'Kd_exp':>8s} {'GninaAff':>9s}\")\nprint(\"-\" * 42)\nfor aff, name, kd, _, _ in WEAK:\n    print(f\"  {name:<20s} {kd:>8.3f} {aff:>+9.2f}\")\n\nprint(f\"\\n\u2550\u2550\u2550 SUMMARY \u2550\u2550\u2550\")\nfor label, grp in [(\"STRONG (n=10)\",GOOD),(\"MODERATE (n=16)\",MOD),(\"WEAK/NON (n=14)\",WEAK)]:\n    affs = [g[0] for g in grp]\n    print(f\"  {label:<20s} affinity = {np.mean(affs):+.2f} \u00b1 {np.std(affs):.2f}  [range {min(affs):+.2f} to {max(affs):+.2f}]\")\nprint(f\"\\n  \u2192 ALL THREE GROUPS are indistinguishable by gnina affinity.\")\nPYEOF"}

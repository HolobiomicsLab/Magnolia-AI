['memory', 'entry', 'previous', 'learned', 'earlier', 'handover', 'retrieved', 'context', 'staging']\n            has_ref = any(term in text.lower() for term in key_terms)\n            if has_ref or len(text) > 100:\n                print(f'[TEXT] {text[:300]}')\n    elif t == 'reasoning':\n        pass\n    elif t == 'step-start':\n        pass\n    else:\n        if t not in ('step-finish',):\n            pass\n\" 2>&1 | head -150"}

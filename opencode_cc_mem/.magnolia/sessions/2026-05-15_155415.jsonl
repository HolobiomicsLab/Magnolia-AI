{"event_type":"tool_call","timestamp":"2026-07-01T07:23:29.617310Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = {\n    \"EAKFQMALT (G3->K)\": \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\",\n    \"EAGFQMRLT (A7->R)\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\",\n    \"EAGFQMKLT (A7->K)\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\",\n}\n\nfor label, d in runs.items():\n    print(f\"\\n=== {label} ===\")\n    # clustfcc\n    clf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\n    with open(clf) as f:\n        for line in f:\n            if 'models' in line and 'top4' in line:\n                print(f\"  {line.strip()}\")\n            if line.startswith('Total number of clusters:'):\n                print(f\"  {line.strip()}\")\n\n    # Top-3 models from capri_ss\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{d}/output/{sfx}/capri_ss.tsv\"\n        if os.path.exists(ss):\n            with open(ss) as f:\n                lines = [l for l in f if not l.startswith('#')]\n            reader = csv.DictReader(lines, delimiter='\\t')\n            best = []\n            for row in reader:\n                score = float(row['score'])\n                air = float(row.get('air',0))\n                af = score - 0.1*air\n                best.append((score, af, row.get('dockq','?'), row.get('vdw','?'), row.get('elec','?'),\n                              row.get('desolv','?'), row.get('bsa','?'), row.get('cluster_id','?'),\n                              row.get('cluster_ranking','?')))\n            best.sort(key=lambda x: x[0])\n            print(f\"\\n  Top-3 (from {sfx}):\")\n            for i, (s, af, dq, vdw, elec, desolv, bsa, cid, crank) in enumerate(best[:3]):\n                print(f\"    #{i+1}: score={s:.2f} AIR-free={af:.2f} DockQ={dq} vdw={vdw} elec={elec} desolv={desolv} bsa={bsa} cl={cid}(r{crank})\")\n            break\nPYEOF"}

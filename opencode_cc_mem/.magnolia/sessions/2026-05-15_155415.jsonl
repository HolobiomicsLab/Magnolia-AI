{"event_type":"tool_call","timestamp":"2026-07-01T07:31:09.421134Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = [\n    (\"EGGFQMAKT (L8\u2192K)\", \"EGGFQMAKT_s10000\", \"EGGFQMALT\", 8, \"K\"),\n    (\"EGGFQMART (L8\u2192R)\", \"EGGFQMART_s10000\", \"EGGFQMALT\", 8, \"R\"),\n    (\"EAKFQMALT (G3\u2192K)\", \"EAKFQMALT_s10000\", \"EAGFQMALT\", 3, \"K\"),\n    (\"EAGFQMRLT (A7\u2192R)\", \"EAGFQMRLT_s10000\", \"EAGFQMALT\", 7, \"R\"),\n    (\"EAGFQMKLT (A7\u2192K)\", \"EAGFQMKLT_s10000\", \"EAGFQMALT\", 7, \"K\"),\n]\n\nfor label, run_dir, parent, mut_pos, mut_res in runs:\n    d = f\"projects/hsc70_new/runs/2026-06-25_{run_dir}\"\n    best_cl = None\n    \n    # Find which cluster has the best model (from clustfcc.tsv)\n    cl_tsv = f\"{d}/output/10_clustfcc/clustfcc.tsv\"\n    if os.path.exists(cl_tsv):\n        with open(cl_tsv) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        for row in reader:\n            best_cl = row.get('cluster_id', '1')\n            break\n    \n    # Get interchain contacts for best cluster\n    fpath = f\"{d}/output/13_contactmap/cluster{best_cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        for cl in [1,2,3,4,5]:\n            alt = f\"{d}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n            if os.path.exists(alt):\n                fpath = alt\n                best_cl = cl\n                break\n    \n    if not os.path.exists(fpath):\n        print(f\"{label}: NO contacts\")\n        continue\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Find mutated position contacts\n    mut_contacts = []\n    for row in reader:\n        pept = row.get('res1', '').strip()\n        pept_num = int(row.get('resnum1', 0))\n        rec = row.get('res2', '').strip()\n        rec_num = int(row.get('resnum2', 0))\n        dist = float(row.get('shortest-dist', 999))\n        ct = row.get('contact-type', '').strip()\n        \n        if pept_num == mut_pos:\n            mut_contacts.append((dist, f\"{rec}{rec_num}({ct})\"))\n    \n    mut_contacts.sort()\n    print(f\"\\n=== {label} (cluster {best_cl}) ===\")\n    print(f\"  Mutated position {mut_pos}: {len(mut_contacts)} contacts\")\n    for d, contact in mut_contacts[:8]:\n        print(f\"    {contact} at {d:.2f}A\")\n    \n    # Check specifically for target acidic receptor residues\n    acidic = {'GLU404','GLU460','ASP433'}\n    found_acidic = [c for c in mut_contacts if any(a in c[1] for a in ['404','460','433']) and ('GLU' in c[1] or 'ASP' in c[1])]\n    if found_acidic:\n        print(f\"  *** TARGETS found: {[c[1] for c in found_acidic]}\")\n    else:\n        print(f\"  No acidic target contacts found\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-24T08:09:16.332891Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/communication/presentation && python3 - <<'PY'\nfrom pptx import Presentation\nfrom pptx.util import Emu\np = Presentation(\"output/magnolia_group_meeting.pptx\")\nSW, SH = p.slide_width, p.slide_height\ndef inch(e): return round(e/914400,2)\nprint(f\"slides: {len(p.slides)}  size: {inch(SW)}x{inch(SH)} in\")\nissues=[]\npics=0; tables=0; notes_ct=0\nfor i,s in enumerate(p.slides,1):\n    has_note = s.has_notes_slide and bool(s.notes_slide.notes_text_frame.text.strip())\n    notes_ct += has_note\n    for sh in s.shapes:\n        if sh.shape_type==13: pics+=1\n        if sh.has_table: tables+=1\n        try:\n            l,t,w,h = sh.left,sh.top,sh.width,sh.height\n            if l is None: continue\n            r=l+w; b=t+h\n            if r>SW+9144 or b>SH+9144 or l<-9144 or t<-9144:\n                issues.append(f\"S{i}: '{sh.name}' OOB bounds L={inch(l)} T={inch(t)} R={inch(r)} B={inch(b)}\")\n        except Exception as e:\n            pass\n    # count text runs that might overflow: crude \u2014 flag tiny boxes with lots of text\nprint(f\"pictures: {pics}  tables: {tables}  slides_with_notes: {notes_ct}\")\nprint(\"out-of-bounds issues:\", len(issues))\nfor x in issues: print(\"  \", x)\nPY\necho \"=== soffice available? ===\"\nwhich soffice libreoffice 2>/dev/null || echo \"no headless renderer\""}

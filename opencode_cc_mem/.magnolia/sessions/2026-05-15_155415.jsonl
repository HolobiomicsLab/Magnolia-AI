{"event_type":"tool_call","timestamp":"2026-06-12T14:11:25.055522Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'EOF'\nimport math\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') and line[13:16].strip() == 'CA':\n                atoms.append({\n                    'resn': line[17:20].strip(), 'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                })\n    return atoms\n\npath = \"projects/hsc70_new/raw_input/closed_state/AF-P11142-F1-model_v4.pdb\"\natoms = parse_pdb(path)\nchain_a = [a for a in atoms if a['chain'] == 'A']\n\nprint(f\"Total CA atoms: {len(chain_a)}\")\nprint(f\"Residue range: {min(a['resi'] for a in chain_a)} - {max(a['resi'] for a in chain_a)}\")\n\n# Check SBD-beta vs SBD-alpha distances\nsbd_beta = [a for a in chain_a if 394 <= a['resi'] <= 509]\nsbd_alpha = [a for a in chain_a if 510 <= a['resi'] <= 615]\n\ndef com(atoms):\n    x = sum(a['x'] for a in atoms) / len(atoms)\n    y = sum(a['y'] for a in atoms) / len(atoms)\n    z = sum(a['z'] for a in atoms) / len(atoms)\n    return (x, y, z)\n\nif sbd_beta and sbd_alpha:\n    com_b = com(sbd_beta)\n    com_a = com(sbd_alpha)\n    d = math.sqrt(sum((a-b)**2 for a,b in zip(com_b, com_a)))\n    print(f\"SBD-beta (394-509): {len(sbd_beta)} CA, COM: ({com_b[0]:.1f}, {com_b[1]:.1f}, {com_b[2]:.1f})\")\n    print(f\"SBD-alpha (510-615): {len(sbd_alpha)} CA, COM: ({com_a[0]:.1f}, {com_a[1]:.1f}, {com_a[2]:.1f})\")\n    print(f\"COM distance: {d:.1f} A\")\n    \n    # Min distance between any lid CA and any SBD-beta CA\n    min_d = 999\n    pair = None\n    for a in sbd_alpha:\n        for b in sbd_beta:\n            d = math.sqrt((a['x']-b['x'])**2 + (a['y']-b['y'])**2 + (a['z']-b['z'])**2)\n            if d < min_d:\n                min_d = d\n                pair = (a, b)\n    print(f\"Minimum lid\u2194SBD-beta distance: {min_d:.1f} A ({pair[0]['resn']}{pair[0]['resi']} \u2194 {pair[1]['resn']}{pair[1]['resi']})\")\n    \n    if min_d < 10:\n        print(\"\u2192 LID IS CLOSED (packed against SBD-beta)\")\n    else:\n        print(\"\u2192 LID IS OPEN (detached from SBD-beta)\")\n\n# Also check NBD-SBD distance\nnbd = [a for a in chain_a if 1 <= a['resi'] <= 385]\ncom_nbd = com(nbd)\nd_nbd_sbd = math.sqrt(sum((a-b)**2 for a,b in zip(com_nbd, com_b)))\nprint(f\"\\nNBD-SBD beta COM distance: {d_nbd_sbd:.1f} A\")\n\n# Compare with our current receptor\nprint(f\"\\n=== Comparison ===\")\nprint(f\"Current receptor (open state): lid-SBDbeta COM distance = 64.0 A\")\nprint(f\"AlphaFold model: lid-SBDbeta COM distance = {d:.1f} A\")\nEOF"}

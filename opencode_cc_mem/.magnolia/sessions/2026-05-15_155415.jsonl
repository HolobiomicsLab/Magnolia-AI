{"event_type":"tool_call","timestamp":"2026-06-17T20:03:49.415962Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26]); atomname = line[12:16].strip()\n        atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef get_atom(chain, resid, atomname):\n    for a in atoms:\n        if a[0] == chain and a[2] == resid and a[3] == atomname:\n            return a[4], a[5], a[6]\n    return None\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vec_len(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef normalize(v):\n    l = vec_len(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\n# Group receptor atoms by residue\nrec_by_res = {}\nfor a in atoms:\n    if a[0] == 'A':\n        k = a[2]\n        if k not in rec_by_res:\n            rec_by_res[k] = {\"resname\": a[1], \"atoms\": []}\n        rec_by_res[k][\"atoms\"].append((a[3], a[4], a[5], a[6]))\n\n# ============================================================\n# C-TERMINAL EXTENSION toward LID\n# ============================================================\n\nprint(\"=\" * 70)\nprint(\"C-TERMINAL EXTENSION toward LID (RKALQ)\")\nprint(\"=\" * 70)\n\nCterm_C = get_atom('B', 5, 'C')\nCterm_CA = get_atom('B', 5, 'CA')\nca5_to_c5 = vec(Cterm_CA, Cterm_C)\nca5_to_c5_norm = normalize(ca5_to_c5)\n\nprint(f\"C-term (GLN5 C):    ({Cterm_C[0]:.2f}, {Cterm_C[1]:.2f}, {Cterm_C[2]:.2f})\")\nprint(f\"C-term direction:   ({ca5_to_c5_norm[0]:.3f}, {ca5_to_c5_norm[1]:.3f}, {ca5_to_c5_norm[2]:.3f})\")\n\n# New lid targets (from pocket)\nlid_targets = [540, 543, 544, 541, 578, 581, 582, 585]\n\nprint(f\"\\n{'Target':>10s}  {'C\u2192tgt':>7s}  {'Angle':>6s}  {'Verdict':>12s}  {'Reach needed':>12s}\")\nprint(\"-\" * 70)\n\nBB_EXT = 1.33  # C\u2192new_N bond\nCA_REACH = BB_EXT + 3.8  # new_N \u2192 new_CA\n\nfor rid in lid_targets:\n    if rid not in rec_by_res:\n        continue\n    ra = rec_by_res[rid][\"atoms\"]\n    closest = min(ra, key=lambda r: dist(Cterm_C, (r[1],r[2],r[3])))\n    d = dist(Cterm_C, (closest[1], closest[2], closest[3]))\n    \n    target_dir = normalize(vec(Cterm_C, (closest[1], closest[2], closest[3])))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(ca5_to_c5_norm, target_dir)))))\n    \n    if angle < 60:\n        v = \"FAVORABLE\"\n    elif angle < 90:\n        v = \"marginal\"\n    else:\n        v = \"AGAINST\"\n    \n    # Reach needed: backbone + sidechain to reach this distance\n    # New CA = Cterm_C + backbone_dir * 3.0\n    new_ca = tuple(Cterm_C[i] + ca5_to_c5_norm[i] * 3.0 for i in range(3))\n    new_ca_d = dist(new_ca, (closest[1], closest[2], closest[3]))\n    \n    print(f\"{rid}-{rec_by_res[rid]['resname']:>4s}  {d:6.1f}  {angle:5.0f}\u00b0  {v:>12s}  {new_ca_d:6.1f} \u00c5 (newCA)\")\n\n# ============================================================\n# N-TERMINAL extension toward lid\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"N-TERMINAL EXTENSION toward LID (RKALQ)\")\nprint(\"=\" * 70)\n\nN_pos = get_atom('B', 1, 'N')\nCA_pos = get_atom('B', 1, 'CA')\nC_pos = get_atom('B', 1, 'C')\nCB_pos = get_atom('B', 1, 'CB')\n\nCA_to_N = vec(CA_pos, N_pos)\nca_to_n_norm = normalize(CA_to_N)\nca_to_cb = vec(CA_pos, CB_pos)\nca_to_cb_norm = normalize(ca_to_cb)\nnew_ca_nt = tuple(N_pos[i] + ca_to_n_norm[i] * 3.0 for i in range(3))\nnew_cb_nt = tuple(new_ca_nt[i] + ca_to_cb_norm[i] * 1.53 for i in range(3))\n\nprint(f\"\\n{'Target':>10s}  {'N\u2192tgt':>7s}  {'Angle':>6s}  {'newCB\u2192tgt':>9s}  Verdict\")\nprint(\"-\" * 70)\n\nfor rid in lid_targets:\n    if rid not in rec_by_res:\n        continue\n    ra = rec_by_res[rid][\"atoms\"]\n    closest_n = min(ra, key=lambda r: dist(N_pos, (r[1],r[2],r[3])))\n    d_n = dist(N_pos, (closest_n[1], closest_n[2], closest_n[3]))\n    d_cb = dist(new_cb_nt, (closest_n[1], closest_n[2], closest_n[3]))\n    \n    new_ca_dir = normalize(vec(N_pos, new_ca_nt))\n    target_dir = normalize(vec(N_pos, (closest_n[1], closest_n[2], closest_n[3])))\n    angle = math.degrees(math.acos(max(-1, min(1, dot(new_ca_dir, target_dir)))))\n    \n    v = \"FAVORABLE\" if angle < 60 else (\"marginal\" if angle < 90 else \"AGAINST\")\n    print(f\"{rid}-{rec_by_res[rid]['resname']:>4s}  {d_n:6.1f}  {angle:5.0f}\u00b0  {d_cb:8.1f}   {v}\")\n\n# ============================================================\n# SUMMARY\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"SUMMARY: BINDING MODE SHIFT\")\nprint(\"=\" * 70)\n\nprint(\"\"\"\nRKDLQ \u2192 RKALQ register shift:\n  - N-terminal direction ROTATED ~180\u00b0 vs receptor\n  - N-term extension toward SBD\u03b2 targets: DEAD (angles >135\u00b0)\n  - C-term extension into lid: now more viable (ASN540 at 6.0 \u00c5)\n  - L4 anchor preserved but contact profile changed\n  - Peptide gained 5 new lid contacts (541, 578, 581, 582, 585)\n  - Total pocket expanded from 27 to 28 residues\n\"\"\")\n\nPYEOF"}

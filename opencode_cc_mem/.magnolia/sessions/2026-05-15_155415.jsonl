{"event_type":"tool_call","timestamp":"2026-06-05T12:28:15.095056Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                atoms.append({\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                    'resi': int(line[22:26]), 'chain': line[21],\n                })\n    return atoms\n\nbase = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs'\nexp = read_pdb(f'{base}/2026-06-01_KFERQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\np2 = read_pdb(f'{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb')\n\nfor label, atoms in [('Exp-site KFERQ', exp), ('P2Rank KFERQ', p2)]:\n    pep = [a for a in atoms if a['chain']=='B']\n    rec = [a for a in atoms if a['chain']=='A']\n    near = set()\n    for pa in pep:\n        for ra in rec:\n            d = math.sqrt((ra['x']-pa['x'])**2+(ra['y']-pa['y'])**2+(ra['z']-pa['z'])**2)\n            if d < 10: near.add(ra['resi'])\n    nbd = sorted([r for r in near if r <= 385])\n    sbd = sorted([r for r in near if r >= 386])\n    print(f'{label}: {len(nbd)} NBD ({min(nbd)}-{max(nbd)}), {len(sbd)} SBD')\n\n# P2Rank pocket check\npr = [10,12,14,15,37,56,175,199,201,202,230,231,234,268,271,272,275,338,339,340,342,343,365,366,369]\nprint(f'P2Rank pocket 1: all {len(pr)} residues in NBD (max={max(pr)})')\nprint(f'Experimental site: SBD resi 531-615')\n\""}

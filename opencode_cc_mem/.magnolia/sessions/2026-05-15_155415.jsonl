{"event_type":"tool_call","timestamp":"2026-06-19T11:56:20.815605Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c curl -s \"http://localhost:8000/api/jobs/47ca73de-0b03-4ea5-8006-7850bee76314\" | python3 \"\nimport sys,json,urllib.request\nd=json.load(sys.stdin)\ndois = [(c['score'], c['doi']) for c in d['result']['candidates'] if c['score'] > 0.5]\ndois.sort(key=lambda x: -x[0])\nlines = []\nfor score, doi in dois:\n    try:\n        req = urllib.request.Request(f'http://localhost:8000/api/paper?doi={urllib.request.quote(doi)}')\n        with urllib.request.urlopen(req, timeout=15) as resp:\n            p = json.loads(resp.read())\n        title = p.get('title','?')\n        abstract = (p.get('abstract') or 'NO ABSTRACT')[:200].replace(chr(10),' ')\n        year = p.get('year','?')\n        journal = p.get('journal','?')\n        lines.append(f'### {score:.3f} | {year} | {journal}')\n        lines.append(f'**{title}**')\n        lines.append(f'{abstract}')\n        lines.append('')\n    except Exception as e:\n        lines.append(f'### {score:.3f} | FAIL: {e}')\n        lines.append('')\nwith open('/tmp/abstracts.txt','w') as f:\n    f.write('\\n'.join(lines))\nprint(f'Wrote {len(dois)} abstracts to /tmp/abstracts.txt')\n\" 2>&1"}

{"event_type":"tool_call","timestamp":"2026-06-12T07:38:23.185780Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport sys, math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atom = {\n                    'serial': int(line[6:11]),\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                }\n                atoms.append(atom)\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\ndef is_backbone(name):\n    return name in ('CA','C','O','N','H','HA','H1','H2','H3')\n\ndef is_sidechain_polar(name, resn):\n    # H-bond donors/acceptors in sidechains\n    donors = {'ARG': ['NH1','NH2','NE','HH11','HH12','HH21','HH22','HE'],\n              'LYS': ['NZ','HZ1','HZ2','HZ3'],\n              'HIS': ['ND1','NE2','HD1','HE2'],\n              'ASN': ['ND2','HD21','HD22'],\n              'GLN': ['NE2','HE21','HE22'],\n              'SER': ['OG','HG'],\n              'THR': ['OG1','HG1'],\n              'TYR': ['OH','HH'],\n              'TRP': ['NE1','HE1']}\n    acceptors = {'ASP': ['OD1','OD2'],\n                 'GLU': ['OE1','OE2'],\n                 'ASN': ['OD1'],\n                 'GLN': ['OE1'],\n                 'HIS': ['ND1','NE2'],\n                 'SER': ['OG'],\n                 'THR': ['OG1'],\n                 'TYR': ['OH']}\n    return name in donors.get(resn, []) or name in acceptors.get(resn, [])\n\ndef charged_group(resn):\n    pos = {'LYS': ['NZ'], 'ARG': ['NH1','NH2']}\n    neg = {'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2']}\n    if resn in pos: return ('positive', pos[resn])\n    if resn in neg: return ('negative', neg[resn])\n    return None\n\ndef is_apolar(resn):\n    return resn in ('ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET','CYS')\n\n# --- Analysis ---\nruns = {\n    'KFERQ (5-mer)': '/tmp/kferq5_cl1m1.pdb',\n    'AKFERQ (6-mer)': '/tmp/akferq6_cl2m1.pdb',\n    'AKFERQK (7-mer)': '/tmp/akferqk7_cl2m1.pdb',\n}\n\nfor name, path in runs.items():\n    atoms = parse_pdb(path)\n    chain_a = [a for a in atoms if a['chain'] == 'A']\n    chain_b = [a for a in atoms if a['chain'] == 'B']\n    \n    print(f'\\\\n===== {name} =====')\n    print(f'Chain A atoms: {len(chain_a)}, Chain B atoms: {len(chain_b)}')\n    \n    # Get peptide residues\n    b_resis = sorted(set(a['resi'] for a in chain_b))\n    b_seq = ''.join([next(a['resn'] for a in chain_b if a['resi']==r) for r in b_resis])\n    print(f'Peptide (chain B): {\\\"-\\\".join(f\\\"{r}{rn}\\\" for r, rn in zip(b_resis, b_seq))}')\n    \n    # Salt bridges: oppositely charged groups \u2264 4.0 \u00c5 (N-O)\n    salt_bridges = []\n    for a_a in chain_a:\n        cg_a = charged_group(a_a['resn'])\n        if not cg_a: continue\n        if a_a['name'] not in cg_a[1]: continue\n        for a_b in chain_b:\n            cg_b = charged_group(a_b['resn'])\n            if not cg_b: continue\n            if a_b['name'] not in cg_b[1]: continue\n            if cg_a[0] == cg_b[0]: continue  # same charge\n            d = dist(a_a, a_b)\n            if d <= 4.0:\n                salt_bridges.append((a_a, a_b, d))\n    \n    if salt_bridges:\n        print(f'\\\\n  SALT BRIDGES (N-O \u2264 4.0\u00c5):')\n        for a_a, a_b, d in sorted(salt_bridges, key=lambda x: x[2]):\n            print(f'  A-{a_a[\\\"resi\\\"]}-{a_a[\\\"resn\\\"]}:{a_a[\\\"name\\\"]} \u2194 B-{a_b[\\\"resi\\\"]}-{a_b[\\\"resn\\\"]}:{a_b[\\\"name\\\"]}  {d:.1f}\u00c5')\n    else:\n        print(f'\\\\n  No salt bridges found (\u22644.0\u00c5)')\n    \n    # H-bonds: polar H donor-acceptor \u2264 3.5 \u00c5 (excluding backbone-backbone)\n    # Simplified: any polar sidechain atom pairs \u2264 3.5 \u00c5\n    hbonds = []\n    for a_a in chain_a:\n        if not is_sidechain_polar(a_a['name'], a_a['resn']): continue\n        for a_b in chain_b:\n            if not is_sidechain_polar(a_b['name'], a_b['resn']): continue\n            # Skip if both are backbone\n            if is_backbone(a_a['name']) and is_backbone(a_b['name']): continue\n            d = dist(a_a, a_b)\n            if d <= 3.5:\n                hbonds.append((a_a, a_b, d))\n    \n    # Deduplicate to residue-level\n    seen = set()\n    unique_polar = []\n    for a_a, a_b, d in sorted(hbonds, key=lambda x: x[2]):\n        key = (a_a['resi'], a_b['resi'])\n        if key not in seen:\n            seen.add(key)\n            unique_polar.append((a_a, a_b, d))\n    \n    if unique_polar:\n        print(f'\\\\n  POLAR CONTACTS (sidechain \u2264 3.5\u00c5):')\n        for a_a, a_b, d in unique_polar[:25]:\n            print(f'  A-{a_a[\\\"resi\\\"]}-{a_a[\\\"resn\\\"]}:{a_a[\\\"name\\\"]} \u2194 B-{a_b[\\\"resi\\\"]}-{a_b[\\\"resn\\\"]}:{a_b[\\\"name\\\"]}  {d:.1f}\u00c5')\n        if len(unique_polar) > 25:\n            print(f'  ... ({len(unique_polar)} total polar contacts)')\n    else:\n        print(f'\\\\n  No polar contacts found (\u22643.5\u00c5)')\n    \n    # Hydrophobic: apolar-apolar \u2264 4.5 \u00c5\n    apolar_contacts = []\n    for a_a in chain_a:\n        if not is_apolar(a_a['resn']): continue\n        if a_a['name'] != 'CB' and not (a_a['resn'] == 'GLY' and a_a['name'] == 'CA'): continue\n        for a_b in chain_b:\n            if not is_apolar(a_b['resn']): continue\n            if a_b['name'] != 'CB' and not (a_b['resn'] == 'GLY' and a_b['name'] == 'CA'): continue\n            d = dist(a_a, a_b)\n            if d <= 4.5:\n                apolar_contacts.append((a_a, a_b, d))\n    \n    if apolar_contacts:\n        print(f'\\\\n  HYDROPHOBIC CONTACTS (CB-CB \u2264 4.5\u00c5):')\n        for a_a, a_b, d in sorted(apolar_contacts, key=lambda x: x[2]):\n            print(f'  A-{a_a[\\\"resi\\\"]}-{a_a[\\\"resn\\\"]} \u2194 B-{a_b[\\\"resi\\\"]}-{a_b[\\\"resn\\\"]}  {d:.1f}\u00c5')\n    else:\n        print(f'\\\\n  No hydrophobic contacts (\u22644.5\u00c5)')\n    \n    # Also count unique receptor residues contacting the peptide\n    receptor_contacts = defaultdict(list)\n    for a_a in chain_a:\n        for a_b in chain_b:\n            d = dist(a_a, a_b)\n            if d <= 4.0:\n                receptor_contacts[a_a['resi']].append((a_b['resi'], a_b['resn'], d))\n    \n    close_receptor = [(resi, min(contacts, key=lambda x: x[2])) for resi, contacts in receptor_contacts.items()]\n    close_receptor.sort(key=lambda x: x[1][2])\n    \n    print(f'\\\\n  RECEPTOR RESIDUES within 4.0\u00c5 of peptide (nearest contact):')\n    for resi, (b_resi, b_resn, d) in close_receptor:\n        print(f'  A-{resi} \u2192 B-{b_resi}-{b_resn}  {d:.1f}\u00c5')\n    print(f'  Total: {len(close_receptor)} receptor residues contacting peptide')\n\"\n"}

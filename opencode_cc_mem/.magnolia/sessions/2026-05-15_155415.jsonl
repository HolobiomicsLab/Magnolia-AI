{"event_type":"tool_call","timestamp":"2026-06-05T12:28:28.247253Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                atoms.append({'x':float(line[30:38]),'y':float(line[38:46]),'z':float(line[46:54]),'resi':int(line[22:26]),'chain':line[21]})\n    return atoms\n\nbase='/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs'\nfor label,path in [('Exp-site',f'{base}/2026-06-01_KFERQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz'),\n                   ('P2Rank',f'{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb'),\n                   ('N-ALA',f'{base}/../analysis/6mer_stage1/cluster_2_model_1.pdb')]:\n    atoms=read_pdb(path)\n    pep=[a for a in atoms if a['chain']=='B']\n    rec=[a for a in atoms if a['chain']=='A']\n    near=set()\n    for pa in pep:\n        for ra in rec:\n            if math.sqrt((ra['x']-pa['x'])**2+(ra['y']-pa['y'])**2+(ra['z']-pa['z'])**2)<10:\n                near.add(ra['resi'])\n    nbd=[r for r in near if r<=385]\n    sbd=[r for r in near if r>=386]\n    print(f'{label}: {len(nbd)} NBD ({min(nbd) if nbd else \\\"-\\\"}-{max(nbd) if nbd else \\\"-\\\"}), {len(sbd)} SBD ({min(sbd) if sbd else \\\"-\\\"}-{max(sbd) if sbd else \\\"-\\\"})')\n\""}

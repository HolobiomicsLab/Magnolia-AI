{"event_type":"tool_call","timestamp":"2026-07-01T09:24:33.284086Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, os\nimport numpy as np\nfrom scipy.spatial import KDTree\n\ndef load_pdb_coords(filepath):\n    \"\"\"Load CA coordinates with chain and residue info\"\"\"\n    atoms = []\n    if filepath.endswith('.gz'):\n        f = gzip.open(filepath, 'rt')\n    else:\n        f = open(filepath)\n    for line in f:\n        if line.startswith('ATOM'):\n            chain = line[21]\n            resnum = int(line[22:26])\n            resname = line[17:20].strip()\n            atomname = line[12:16].strip()\n            x = float(line[30:38])\n            y = float(line[38:46])\n            z = float(line[46:54])\n            atoms.append({'chain': chain, 'resnum': resnum, 'resname': resname,\n                         'atom': atomname, 'coord': np.array([x, y, z])})\n    f.close()\n    return atoms\n\ndef void_analysis(pdb_path, peptide_chain='B', receptor_chain='A'):\n    \"\"\"Simple void analysis: grid points near peptide but not occupied\"\"\"\n    atoms = load_pdb_coords(pdb_path)\n    \n    # Split into receptor and peptide\n    rec_atoms = [a for a in atoms if a['chain'] == receptor_chain]\n    pep_atoms = [a for a in atoms if a['chain'] == peptide_chain]\n    \n    # Get all heavy atoms\n    rec_coords = np.array([a['coord'] for a in rec_atoms if a['atom'] != 'H'])\n    pep_coords = np.array([a['coord'] for a in pep_atoms if a['atom'] != 'H'])\n    all_coords = np.vstack([rec_coords, pep_coords])\n    \n    # Build KDTree of all atoms\n    tree = KDTree(all_coords)\n    \n    # Create grid around peptide\n    pep_min = pep_coords.min(axis=0) - 3\n    pep_max = pep_coords.max(axis=0) + 3\n    \n    # Grid spacing 1.0 \u00c5\n    x = np.arange(pep_min[0], pep_max[0], 1.0)\n    y = np.arange(pep_min[1], pep_max[1], 1.0)\n    z = np.arange(pep_min[2], pep_max[2], 1.0)\n    xx, yy, zz = np.meshgrid(x, y, z, indexing='ij')\n    grid_points = np.column_stack([xx.ravel(), yy.ravel(), zz.ravel()])\n    \n    # Find grid points that are:\n    # 1. Within 5 \u00c5 of any peptide atom (near peptide)\n    # 2. More than 2.5 \u00c5 from any atom (in void space)\n    pep_tree = KDTree(pep_coords)\n    near_peptide = pep_tree.query_ball_point(grid_points, 5.0)\n    near_peptide_mask = np.array([len(idx) > 0 for idx in near_peptide])\n    \n    all_tree = KDTree(all_coords)\n    dists, _ = all_tree.query(grid_points, k=1)\n    void_mask = dists > 2.5\n    \n    void_near_peptide = near_peptide_mask & void_mask\n    \n    # Assign each void point to nearest peptide residue\n    pep_resnums = sorted(set(a['resnum'] for a in pep_atoms))\n    pep_ca_coords = {}\n    for a in pep_atoms:\n        if a['atom'] == 'CA' and a['resnum'] not in pep_ca_coords:\n            pep_ca_coords[a['resnum']] = a['coord']\n    \n    void_points = grid_points[void_near_peptide]\n    if len(void_points) == 0:\n        print(\"  No void points found\")\n        return\n    \n    # Assign to nearest peptide CA\n    pep_ca_list = sorted(pep_ca_coords.keys())\n    pep_ca_arr = np.array([pep_ca_coords[r] for r in pep_ca_list])\n    ca_tree = KDTree(pep_ca_arr)\n    _, nearest_ca = ca_tree.query(void_points, k=1)\n    \n    # Count void points per peptide residue\n    void_per_res = {}\n    for i, ca_idx in enumerate(nearest_ca):\n        resnum = pep_ca_list[ca_idx]\n        if resnum not in void_per_res:\n            void_per_res[resnum] = 0\n        void_per_res[resnum] += 1\n    \n    total_void = len(void_points)\n    print(f\"  Total void points: {total_void}\")\n    print(f\"  {'PDB pos':>7s} {'Void pts':>9s} {'% void':>7s}\")\n    for resnum in pep_ca_list:\n        n = void_per_res.get(resnum, 0)\n        pct = 100.0 * n / total_void if total_void > 0 else 0\n        print(f\"  {resnum:>7d} {n:>9d} {pct:>6.1f}%\")\n\n# Run on the three peptides\nfor label, pdb, cl in [\n    (\"EGGFQMAKT cl3\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\", 3),\n    (\"EAGFQMALT cl3\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000/output/11_seletopclusts/cluster_3_model_1.pdb.gz\", 3),\n    (\"KFERQx2 cl5\", \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000/output/11_seletopclusts/cluster_5_model_1.pdb.gz\", 5),\n]:\n    print(f\"\\n=== {label} ===\")\n    if os.path.exists(pdb):\n        void_analysis(pdb)\n    else:\n        print(f\"  File not found: {pdb}\")\nPYEOF"}

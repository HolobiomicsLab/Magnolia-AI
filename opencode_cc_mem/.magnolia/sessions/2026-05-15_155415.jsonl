{"event_type":"tool_call","timestamp":"2026-06-24T15:01:32.812222Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-24_alascan_tggfqmalt_af3\npython3 - <<'PY'\nimport numpy as np, math\ndef parse(path):\n    R=[];P=[]\n    for line in open(path):\n        if not line.startswith('ATOM'): continue\n        ch=line[21];res=int(line[22:26]);nm=line[12:16].strip();rn=line[17:20].strip()\n        if nm.startswith('H'): continue\n        try: v=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])])\n        except: continue\n        (P if ch=='B' else R).append((ch,res,rn,nm,v))\n    return R,P\nR,P=parse(\"complex.pdb\")\nrec_xyz=np.array([a[4] for a in R])\ndef getb(p,res,nm):\n    for ch,r,rn,n,v in p:\n        if r==res and n==nm: return v\n\nprint(\"######## (a) G2 (B-3 GLY) methyl clearance scan ########\")\nCA=getb(P,3,'CA'); N=getb(P,3,'N'); C=getb(P,3,'C')\nbN=(N-CA)/np.linalg.norm(N-CA); bC=(C-CA)/np.linalg.norm(C-CA)\ndef fib(n):\n    pts=[];phi=math.pi*(3-5**.5)\n    for i in range(n):\n        y=1-(i/(n-1))*2;r=math.sqrt(max(0,1-y*y));th=phi*i\n        pts.append(np.array([r*math.cos(th),y,r*math.sin(th)]))\n    return pts\nbest=None\nfor d in fib(2000):\n    d=d/np.linalg.norm(d)\n    if abs(np.dot(d,bN))>math.cos(math.radians(50)) or abs(np.dot(d,bC))>math.cos(math.radians(50)): continue\n    mp=CA+1.52*d\n    dd=np.linalg.norm(rec_xyz-mp,axis=1);mn=dd.min();idx=dd.argmin()\n    if best is None or mn>best[0]: best=(mn,R[idx])\nclr,atom=best\nprint(f\"  best methyl-carbon clearance: {clr:.2f} \u00c5 (nearest: {atom[3]} of {atom[2]}{atom[1]})\")\nprint(f\"  current nearest receptor atom to G2 CA: {np.linalg.norm(rec_xyz-CA,axis=1).min():.2f} \u00c5\")\nprint(f\"  => G2->A: {'CLEARS (fits, >3.4\u00c5)' if clr>=3.4 else 'TIGHT (3.0-3.4)' if clr>=3.0 else 'CLASH (<3.0)'}\")\n\nprint(\"\\n######## (b) T9 (B-10) C-terminal extension direction ########\")\ndef ang(u,v):\n    u=u/np.linalg.norm(u);v=v/np.linalg.norm(v);return math.degrees(math.acos(max(-1,min(1,float(np.dot(u,v))))))\nCA9=getb(P,10,'CA');C9=getb(P,10,'C')\ndC=(C9-CA9)/np.linalg.norm(C9-CA9)\nprint(\"  angle of T9 CA->C growth dir to nearby SBD residues (small=reaches):\")\nfor nm,res in [('N548',548),('R469',469),('G623',623),('P622',622),('F625',625),('V471',471),('S544',544)]:\n    rs=[a for a in R if a[1]==res and a[0]=='A']\n    if not rs: continue\n    ca=np.array([a[4] for a in R if a[1]==res and a[0]=='A'])\n    d=ca-CA9;dd=np.linalg.norm(d,axis=1);j=dd.argmin()\n    print(f\"    {nm:5s}: closest {dd[j]:4.1f} \u00c5, angle {ang(dC,d[j]):5.1f}\u00b0\")\nPY"}

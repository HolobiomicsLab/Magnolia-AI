{"event_type":"tool_call","timestamp":"2026-06-10T13:20:11.029526Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\npython3 << 'PYEOF'\nimport json, math\nfrom collections import defaultdict\n\nrec_atoms = []\nwith open('receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\ndef parse_top_pose(sdf_path):\n    with open(sdf_path) as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        cnn_score = cnn_aff = emp_aff = 0; na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        lig = []\n        for i in range(atom_start, min(atom_start+na, len(lines))):\n            l = lines[i]\n            if len(l) < 30: continue\n            try: x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n            except: continue\n            lig.append((f'A{i-atom_start+1}', x, y, z))\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, cnn_score, cnn_aff, lig)\n    if best is None: return None\n    asn90_d = min((math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2) \n                   for _, _, _, rx, ry, rz in rec_atoms if _[1]=='ASN' and _[2]==90\n                   for _, lx, ly, lz in lig), default=999)\n    return (*best, asn90_d)\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\nligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Z11-16-OH', 'Cedrol', '\u03b2-Ionone', \n           'Citral', 'C12-Ald', 'C8-Ald', 'Palmitic_acid']\n\n# Key paper residues\nKEY = ['ASN90','ASP87','MET39','GLU120','SER122','SER73','PHE56','PHE92','TYR86','TYR89','LEU107','VAL84','MET118']\n\n# Build header\nheader = f\"{'Ligand':16s} {'IC50':>6s} {'EmpAff':>7s} {'Asn90':>6s}\" \nfor r in KEY:\n    header += f\" {r:>6s}\"\nprint(header)\nprint(\"-\" * len(header))\n\nfor lig in ligands:\n    fname = f'docked_{lig}_asn90.sdf'\n    result = parse_top_pose(fname)\n    if result is None:\n        print(f\"{lig:16s} {'N/A':>6s} {'N/A':>7s} {'N/A':>6s}\")\n        continue\n    emp_aff, cnn_score, cnn_aff, lig_atoms, asn90_d = result\n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    \n    # Contact matrix\n    contacts = defaultdict(list)\n    for la_name, lx, ly, lz in lig_atoms:\n        for ra_name, ra_res, ra_num, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                contacts[f\"{ra_res}{ra_num}\"].append(d)\n    \n    row = f\"{lig:16s} {str(ic50):>6s} {emp_aff:>7.1f} {asn90_d:>5.1f}\u00c5\"\n    for r in KEY:\n        if r in contacts:\n            dmin = min(contacts[r])\n            row += f\" {dmin:>5.1f}\u00c5\"\n        else:\n            row += f\" {'-':>6s}\"\n    print(row)\n\nPYEOF"}

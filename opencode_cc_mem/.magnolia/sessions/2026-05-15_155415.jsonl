{"event_type":"tool_call","timestamp":"2026-06-19T09:26:21.104244Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, glob, yaml, re\n\nstaging = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/.magnolia/staging'\nproject_dir = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/.magnolia/project'\n\nstops = {'the','and','for','that','with','from','this','into','over','more','than','each','both','also','not','are','was','use','used','using','have','has','been','can','will','all','had','but','its','does','only','well','much','here','when','some','just'}\n\n# Load project entries\ndef load_entries(d):\n    out = {}\n    for f in sorted(glob.glob(f'{d}/*.md')):\n        bn = os.path.basename(f)\n        with open(f) as fh: content = fh.read()\n        m = re.match(r'^---\\n(.*?)\\n---', content, re.DOTALL)\n        title, desc, tags, body = '', '', [], ''\n        if m:\n            try:\n                fm = yaml.safe_load(m.group(1))\n                title = str(fm.get('title','')).lower()\n                desc = str(fm.get('description','')).lower()\n                tags = [str(t).lower() for t in fm.get('tags',[])]\n            except: pass\n        bstart = content.find('---\\n',4)\n        body = content[bstart+4:].lower()[:800] if bstart>=0 else ''\n        text = f\"{title} {desc} {' '.join(tags)} {body}\"\n        kws = {w for w in re.split(r'[\\s\\-_/]+', text) if len(w)>3 and w not in stops}\n        out[bn] = {'title':title, 'kws':kws}\n    return out\n\nproject = load_entries(project_dir)\nstaging_entries = load_entries(staging)\n\nnot_covered = []\nfor bn, sdata in staging_entries.items():\n    sk = sdata['kws']\n    best = 0\n    best_p = ''\n    for pn, pdata in project.items():\n        overlap = len(sk & pdata['kws'])\n        if overlap > best:\n            best = overlap\n            best_p = pn\n    if best < 6:\n        not_covered.append((bn, best, best_p, sdata['title']))\n\nprint(f\"Project entries: {len(project)}\")\nprint(f\"Staging entries: {len(staging_entries)}\")\nprint(f\"NOT covered (overlap < 6 keywords): {len(not_covered)}\")\n\n# Group not-covered by broad topic\ngroups = {}\nfor bn, best, best_p, title in not_covered:\n    t = title\n    if 'bindcraft' in t: g = 'bindcraft'\n    elif 'p2rank' in t: g = 'p2rank'\n    elif 'shell' in t or 'tool' in t or 'mcp' in t or 'error' in t.lower(): g = 'tool_errors'\n    elif 'session' in t or 'consolidation' in t or 'memory_' in t: g = 'meta'\n    elif 'azzurra' in t or 'pending' in t or 'rsync' in t or 'fetch' in t or 'timeout' in t: g = 'operations'\n    elif 'vmd' in t: g = 'vmd'\n    elif 'topoaa' in t or 'acpype' in t: g = 'haddock_setup'\n    else: g = 'other'\n    groups.setdefault(g, []).append(title[:100])\n\nprint()\nfor g in sorted(groups.keys()):\n    items = groups[g]\n    print(f\"\\n## {g} ({len(items)})\")\n    for t in items[:5]:\n        print(f\"  - {t}\")\n    if len(items) > 5:\n        print(f\"  ... +{len(items)-5} more\")\nPYEOF\n"}

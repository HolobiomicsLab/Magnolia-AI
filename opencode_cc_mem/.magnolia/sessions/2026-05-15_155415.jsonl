{"event_type":"tool_call","timestamp":"2026-06-18T13:45:40.243486Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c set -e\n\n# Read templates\nRECEPTOR_PDB=\"projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/receptor.pdb\"\nRECEPTOR_ACTPASS=\"projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/receptor.actpass\"\nAMBIG_TBL=\"projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/ambig.tbl\"\n\n# Generate ambig.tbl for each peptide\nfor run_name in RKVLQ_s5000 RKILQ_s5000 RKLLQ_s5000 TAFMALQ_s10000; do\n    echo \"=== Setting up $run_name ===\"\n    \n    RUNDIR=\"projects/hsc70_new/runs/2026-06-18_${run_name}\"\n    mkdir -p \"$RUNDIR\"\n    \n    # Copy receptor files\n    cp \"$RECEPTOR_PDB\" \"$RUNDIR/receptor.pdb\"\n    cp \"$RECEPTOR_ACTPASS\" \"$RUNDIR/receptor.actpass\"\n    \n    # Copy peptide PDB\n    pep_name=\"${run_name%%_*}\"\n    cp \"projects/hsc70_new/runs/2026-06-18_d3_scan/peptides/${pep_name}.pdb\" \"$RUNDIR/peptide.pdb\"\n    \n    # Determine length\n    if echo \"$run_name\" | grep -q \"TAFMALQ\"; then\n        pep_len=7\n        sampling=10000\n    else\n        pep_len=5\n        sampling=5000\n    fi\n    \n    # Create peptide actpass\n    python3 -c \"\nres = ' '.join(str(i) for i in range(1, $pep_len+1))\nprint(res)\nprint()\n\" > \"$RUNDIR/peptide.actpass\"\n    \n    # Generate ambig.tbl using haddock3-restraints\n    conda run -n haddock3-py311 haddock3-restraints active_passive_to_ambig \\\n        \"$RUNDIR/receptor.actpass\" \"$RUNDIR/peptide.actpass\" > \"$RUNDIR/ambig.tbl\" 2>/dev/null\n    \n    # Create config.cfg\n    cat > \"$RUNDIR/config.cfg\" << ENDCONFIG\nrun_dir = \"output\"\nncores = 32\nmode = \"local\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\n\n[topoaa]\n\n[rigidbody]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nsampling = $sampling\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[flexref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = 1\nfle_end_2 = $pep_len\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = 1\nfle_end_2 = $pep_len\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 20\n\n[caprieval]\nallatoms = true\n\n[contactmap]\nENDCONFIG\n    \n    echo \"  Done: $RUNDIR\"\ndone\n\necho \"\"\necho \"=== Verify all run dirs ===\"\nfor d in projects/hsc70_new/runs/2026-06-18_*/; do\n    name=$(basename $d)\n    echo \"--- $name ---\"\n    ls \"$d\"\n    echo \"\"\ndone"}

{"event_type":"tool_call","timestamp":"2026-06-16T13:20:57.215282Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os, subprocess, gzip, glob, shutil, re\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nRUNS = [\n    (\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000\"),\n    (\"KILDQ\", \"2026-06-16_4po2_KILDQ_s5000\"),\n    (\"RKDLQ\", \"2026-06-16_4po2_RKDLQ_s5000\"),\n    (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000\"),\n    (\"QRKEL\", \"2026-06-16_4po2_QRKEL_s5000\"),\n    (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000\"),\n    (\"KFERQx2\", \"2026-06-16_4po2_KFERQx2_s10000\"),\n    (\"QRKELx2\", \"2026-06-16_4po2_QRKELx2_s10000\"),\n    (\"RKELQx2\", \"2026-06-16_4po2_RKELQx2_s10000\"),\n    (\"RKDLQv\", \"2026-06-16_4po2_RKDLQ-variant_s10000\"),\n    (\"fusion\", \"2026-06-16_4po2_KFERQ-KILDQ-fusion_s10000\"),\n]\n\nTLEAP_SCRIPT = \"\"\"source leaprc.protein.ff14SB\ncomplex = loadpdb {work}/complex.pdb\nsaveamberparm complex {work}/complex.prmtop {work}/complex.rst7\nrec = loadpdb {work}/rec.pdb\nsaveamberparm rec {work}/rec.prmtop {work}/rec.rst7\nlig = loadpdb {work}/lig.pdb\nsaveamberparm lig {work}/lig.prmtop {work}/lig.rst7\nquit\n\"\"\"\n\nMMPBSA_INPUT = \"\"\"&general\n  startframe=1, endframe=1, interval=1, keep_files=0, verbose=0,\n/\n&gb\n  igb=5, saltcon=0.150,\n/\n&decomp\n  idecomp=1, dec_verbose=3,\n/\n\"\"\"\n\nconda_setup = \"source /home/tjiang/anaconda3/etc/profile.d/conda.sh && conda activate ambertools\"\n\nresults = {}\n\nfor tag, run_name in RUNS:\n    rd = f\"{BASE}/runs/{run_name}\"\n    seletop_dirs = glob.glob(f\"{rd}/output/*seletopclusts*\")\n    model_gz = f\"{seletop_dirs[0]}/cluster_1_model_1.pdb.gz\"\n    \n    work = f\"/tmp/mmpbsa_{tag}\"\n    os.makedirs(work, exist_ok=True)\n    \n    with gzip.open(model_gz, 'rt') as f:\n        lines = f.readlines()\n    \n    def no_h(atoms):\n        return [l for l in atoms if not l[12:16].strip().startswith('H')]\n    \n    rec = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'A'])\n    lig = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'B'])\n    \n    for pdb_type, atoms in [('complex', rec + lig), ('rec', rec), ('lig', lig)]:\n        with open(f\"{work}/{pdb_type}.pdb\", 'w') as f:\n            f.writelines(atoms + ['END\\n'])\n    \n    with open(f\"{work}/tleap.in\", 'w') as f:\n        f.write(TLEAP_SCRIPT.format(work=work))\n    with open(f\"{work}/mmpbsa.in\", 'w') as f:\n        f.write(MMPBSA_INPUT)\n    \n    subprocess.run(f\"{conda_setup} && cd {work} && tleap -f tleap.in > tleap.log 2>&1\", shell=True, capture_output=True)\n    subprocess.run(\n        f\"{conda_setup} && cd {work} && MMPBSA.py -O -i mmpbsa.in \"\n        f\"-cp complex.prmtop -rp rec.prmtop -lp lig.prmtop \"\n        f\"-y complex.rst7 -o out.dat -do decomp.dat \"\n        f\"-sp complex.prmtop -sr complex.rst7 > mmpbsa.log 2>&1\",\n        shell=True, capture_output=True\n    )\n    \n    # Extract ligand residues: take entries with ,L that have internal=0,0,0\n    lig_contribs = []\n    try:\n        with open(f\"{work}/decomp.dat\") as f:\n            seen = set()\n            for line in f:\n                if ',L ' not in line:\n                    continue\n                parts = line.strip().split(',')\n                resname = parts[0].split()[0]\n                resi = parts[0].split()[1]\n                # Check if internal energy columns (idx 1,2,3) are all 0\n                if float(parts[1]) == 0 and float(parts[2]) == 0 and float(parts[3]) == 0:\n                    key = f\"{resname}{resi}\"\n                    if key in seen:\n                        continue\n                    seen.add(key)\n                    try:\n                        vdw = float(parts[4]) if parts[4].strip() else 0\n                        elec = float(parts[7]) if parts[7].strip() else 0\n                        polar = float(parts[10]) if parts[10].strip() else 0\n                        nonpolar = float(parts[13]) if parts[13].strip() else 0\n                        total = float(parts[16]) if parts[16].strip() else 0\n                        interaction = vdw + elec + polar + nonpolar\n                        lig_contribs.append((key, vdw, elec, polar, nonpolar, total, interaction))\n                    except (ValueError, IndexError):\n                        pass\n    except FileNotFoundError:\n        pass\n    \n    if lig_contribs:\n        results[tag] = lig_contribs\n    \n    shutil.rmtree(work, ignore_errors=True)\n\n# Print results\nprint(\"=== Per-residue interaction energy (kcal/mol), best cluster model ===\")\nprint(f\"{'Peptide':<12} {'Residue contributions (vdW)':<60} {'Best'} {'Worst'}\")\nprint(\"-\" * 100)\n\nfor tag, data in results.items():\n    residues = [f\"{r}:{v:.1f}\" for r, v, e, p, n, t, i in data]\n    best_res = min(data, key=lambda x: x[6])  # most negative interaction\n    worst_res = max(data, key=lambda x: x[6])\n    print(f\"{tag:<12} {'  '.join(residues):<60} {best_res[0]}={best_res[6]:.1f} {worst_res[0]}={worst_res[6]:.1f}\")\n\nprint()\nprint(\"=== Full breakdown for all 5-mers ===\")\nfor tag, data in results.items():\n    if len(data) > 7:  # skip long peptides for readability\n        continue\n    print(f\"\\n{tag}:\")\n    for key, vdw, elec, polar, npolar, total, interaction in data:\n        print(f\"  {key:8s} vdW={vdw:7.2f} elec={elec:7.1f} polar={polar:7.1f} np={npolar:5.2f} \u2192 TOT={total:7.1f} INT={interaction:7.1f}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-09T13:08:38.011952Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport re\n\nwith open('gnina_bridge_all.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\nn_done = len(blocks) - 1\n\nprint(f\"{n_done}/40 done\\n\")\nprint(f\"{'#':<3s} CNN_top_aff   best_emp_aff   CNNpose     Compound\")\nprint(\"-\" * 70)\n\nfor i in range(min(n_done, 15)):\n    block = blocks[i+1]\n    # Extract ALL poses\n    poses = re.findall(r'\\n\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', block)\n    if not poses: continue\n    \n    cnn_top_aff = float(poses[0][1])  # rank 1 = CNN-best\n    cnn_top_cnn = float(poses[0][3])\n    \n    # Best empirical affinity (most negative)\n    best_emp = min(float(p[1]) for p in poses)\n    best_emp_cnn = min((float(p[1]), float(p[3])) for p in poses)\n    \n    same = \"SAME\" if abs(cnn_top_aff - best_emp) < 0.01 else f\"\u0394={best_emp-cnn_top_aff:+.2f}\"\n    \n    # Get compound name\n    sdf_names = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald',\n                 'C16-Ald','C18-Ald','C8-Ald','Cedrol','Citral','Citralva','Citronellal',\n                 'Coniferyl_aldehyde','Decanoic_acid'][:n_done]\n    name = sdf_names[i] if i < len(sdf_names) else f'comp_{i}'\n    \n    print(f\"{i+1:<3d} {cnn_top_aff:>+9.2f}   {best_emp:>+9.2f}      {cnn_top_cnn:>5.3f}     {name}  [{same}]\")\nPYEOF"}

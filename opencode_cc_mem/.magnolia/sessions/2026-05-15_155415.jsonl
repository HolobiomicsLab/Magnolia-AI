{"event_type":"tool_call","timestamp":"2026-06-22T13:23:21.232352Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c # Atom-level contact analysis for both peptides\ncd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\npython3 << 'PYEOF'\nimport numpy as np, gzip\n\ndef parse_pdb(path):\n    atoms = []\n    opener = gzip.open if path.endswith('.gz') else open\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                chain = line[21].strip()\n                resname = line[17:20].strip()\n                resnum = int(line[22:26])\n                atomname = line[12:16].strip()\n                xyz = np.array([float(line[30:38]), float(line[38:46]), float(line[46:54])])\n                el = line[76:78].strip() or atomname[0]\n                if el != 'H' and atomname[0] != 'H':\n                    atoms.append({'chain':chain,'resnum':resnum,'resname':resname,'atom':atomname,'xyz':xyz})\n    return atoms\n\nfor label, path, seq in [\n    (\"KFERQx2 (KFERQKFERRQ)\", \"kferqx2_af3_best_cluster9_model1.pdb\",\n     {1:'K',2:'F',3:'E',4:'R',5:'Q',6:'K',7:'F',8:'E',9:'R',10:'R',11:'Q'}),\n    (\"RKELQx2 (RKELQRKELQ)\", \"2026-06-16_af3_RKELQx2_s10000_full/output/11_seletopclusts/cluster_1_model_1.pdb\",\n     {1:'R',2:'K',3:'E',4:'L',5:'Q',6:'R',7:'K',8:'E',9:'L',10:'Q'}),\n]:\n    import os\n    full_path = os.path.join('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs', path)\n    if path.endswith('.pdb.gz'):\n        atoms = parse_pdb(full_path)\n    elif path.endswith('.pdb'):\n        atoms = parse_pdb(full_path)\n    else:\n        print(f\"Skipping {label}: need to decompress\")\n        continue\n    rec = [a for a in atoms if a['chain']=='A']\n    pep = [a for a in atoms if a['chain']=='B']\n    max_res = max(seq.keys())\n    \n    print(f\"\\n{'='*60}\")\n    print(f\"  {label}\")\n    print(f\"{'='*60}\")\n    \n    # CA-CA footprint + contact count\n    print(f\"\\n{'Pos':>3} {'Res':>3} {'<5A':>5} {'NearCA':>8} {'Domain':>12}\")\n    print(\"-\" * 45)\n    for bres in range(1, max_res+1):\n        pa = [a for a in pep if a['resnum']==bres]\n        if not pa:\n            print(f\"{bres:>3} {seq[bres]:>3}  (no atoms)\")\n            continue\n        contact_count = 0\n        for p in pa:\n            for r in rec:\n                d = np.linalg.norm(p['xyz'] - r['xyz'])\n                if d < 5.0:\n                    contact_count += 1\n                    break\n        \n        # Nearest receptor CA\n        bca = [a for a in pa if a['atom']=='CA']\n        min_d = 999; min_res = None; min_resnum = 0\n        if bca:\n            for r in rec:\n                if r['atom'] == 'CA':\n                    d = np.linalg.norm(bca[0]['xyz'] - r['xyz'])\n                    if d < min_d:\n                        min_d = d; min_res = r['resname']; min_resnum = r['resnum']\n        \n        domain = \"NBD\" if min_resnum < 380 else (\"SBD\u03b2\" if min_resnum < 520 else \"SBD\u03b1/lid\")\n        if min_d > 10: domain = \"OUTSIDE\"\n        \n        print(f\"{bres:>3} {seq[bres]:>3} {contact_count:>5}   {min_res}{min_resnum}@{min_d:.1f}A  {domain}\")\n    \n    # Peptide span\n    b1 = [a for a in pep if a['resnum']==1 and a['atom']=='CA']\n    blast = [a for a in pep if a['resnum']==max_res and a['atom']=='CA']\n    if b1 and blast:\n        span = np.linalg.norm(b1[0]['xyz'] - blast[0]['xyz'])\n        print(f\"\\nPeptide span (CA1\u2192CA{max_res}): {span:.1f} A\")\nPYEOF"}

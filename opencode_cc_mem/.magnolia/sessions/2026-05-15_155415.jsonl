{"event_type":"tool_call","timestamp":"2026-07-01T08:02:26.924951Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef domain_contacts(run_dir, cluster_id):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    pep_to_domains = {}\n    for row in reader:\n        res1 = row.get('res1','').strip()\n        res2 = row.get('res2','').strip()\n        # Parse \"A-404-GLU\" format\n        parts1 = res1.split('-')\n        parts2 = res2.split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1])\n            pep_num = int(parts2[1])\n        except ValueError:\n            continue\n        dist = float(row.get('shortest-dist', 999))\n        \n        if rec_num < 390: domain = \"NBD\"\n        elif rec_num <= 520: domain = \"SBD\u03b2\"\n        elif rec_num <= 615: domain = \"SBD\u03b1-lid\"\n        else: domain = \"beyond-615\"\n        \n        if pep_num not in pep_to_domains:\n            pep_to_domains[pep_num] = {\"NBD\": [], \"SBD\u03b2\": [], \"SBD\u03b1-lid\": [], \"beyond-615\": []}\n        pep_to_domains[pep_num][domain].append((rec_num, dist))\n    \n    return pep_to_domains\n\nruns = [\n    (\"EGGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1),\n    (\"EAGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\", 3),\n    (\"EGGFQMAKT\", \"L8\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3),\n    (\"EAKFQMALT\", \"G3\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", 2),\n    (\"EAGFQMRLT\", \"A7\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1),\n    (\"EAGFQMKLT\", \"A7\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", 1),\n]\n\nfor label, mut, d, cl in runs:\n    ptd = domain_contacts(d, cl)\n    if ptd is None:\n        print(f\"\\n=== {label} ({mut}) === NO CONTACT MAP for cluster {cl}\")\n        continue\n    \n    print(f\"\\n=== {label} ({mut}) \u2014 cluster {cl} ===\")\n    print(f\"  {'Pos':>4s}  {'NBD (<390)':>18s}  {'SBD\u03b2 (390-520)':>18s}  {'SBD\u03b1-lid (520-615)':>22s}  {'beyond (>615)':>14s}\")\n    print(f\"  {'-'*82}\")\n    \n    domain_totals = {\"NBD\": 0, \"SBD\u03b2\": 0, \"SBD\u03b1-lid\": 0, \"beyond-615\": 0}\n    \n    for pep_num in sorted(ptd.keys()):\n        cells = []\n        for domain in [\"NBD\", \"SBD\u03b2\", \"SBD\u03b1-lid\", \"beyond-615\"]:\n            contacts = sorted(ptd[pep_num][domain], key=lambda x: x[1])\n            if contacts:\n                domain_totals[domain] += len(contacts)\n                r, dist = contacts[0]\n                cell = f\"{r}@{dist:.1f}\"\n                if len(contacts) > 1:\n                    cell += f\"(+{len(contacts)-1})\"\n            else:\n                cell = \"\u2014\"\n            cells.append(cell)\n        print(f\"  {pep_num:>4d}  {cells[0]:>18s}  {cells[1]:>18s}  {cells[2]:>22s}  {cells[3]:>14s}\")\n    \n    print(f\"  {'TOT':>4s}  {domain_totals['NBD']:>18d}  {domain_totals['SBD\u03b2']:>18d}  {domain_totals['SBD\u03b1-lid']:>22d}  {domain_totals['beyond-615']:>14d}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-20T20:30:56.642257Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000/scripts && python3 << 'PYEOF'\nimport csv, re, os\nfrom collections import defaultdict\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nRUN_DIR = os.path.dirname(os.getcwd())  # since cwd is scripts/\nRESULTS_DIR = os.path.join(RUN_DIR, \"results\")\nCOMPAS_CSV = os.path.join(RUN_DIR, \"..\", \"..\", \"raw_input\", \"compas_data\", \"compas-1x.csv\")\nSEL_CSV = os.path.join(RUN_DIR, \"inputs\", \"selected.csv\")\nOUTPUT_DIR = os.path.join(RUN_DIR, \"output\")\n\n_nf = {\"n_rings\",\"HOMO_eV\",\"LUMO_eV\",\"GAP_eV\",\"Etot_eV\",\"Erel_eV\"}\n\npub = {}\nwith open(COMPAS_CSV) as f:\n    for r in csv.DictReader(f):\n        pub[r[\"molecule\"]] = {k: float(v) if k in _nf else v for k, v in r.items()}\n\nwith open(SEL_CSV) as f:\n    selected = list(csv.DictReader(f))\n\nresults = []\nfor m in selected:\n    name = m[\"molecule\"]\n    outfile = os.path.join(OUTPUT_DIR, f\"{name}.out\")\n    if not os.path.exists(outfile): continue\n    with open(outfile) as f: text = f.read()\n    etot_m = re.search(r\"TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh\", text)\n    gap_m = re.search(r\"HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV\", text)\n    homo_m = re.findall(r\"(-?[\\d.]+)\\s+\\(HOMO\\)\", text)\n    lumo_m = re.findall(r\"(-?[\\d.]+)\\s+\\(LUMO\\)\", text)\n    if not all([etot_m, gap_m, homo_m, lumo_m]): continue\n    etot_ev = float(etot_m.group(1)) * 27.2114\n    p = pub.get(name, {})\n    results.append({\n        \"molecule\": name, \"n_rings\": int(m[\"n_rings\"]),\n        \"HOMO_our\": float(homo_m[-1]), \"HOMO_lit\": p.get(\"HOMO_eV\"),\n        \"LUMO_our\": float(lumo_m[-1]), \"LUMO_lit\": p.get(\"LUMO_eV\"),\n        \"GAP_our\": float(gap_m.group(1)), \"GAP_lit\": p.get(\"GAP_eV\"),\n        \"Etot_our\": etot_ev, \"Etot_lit\": p.get(\"Etot_eV\"),\n        \"Erel_lit\": p.get(\"Erel_eV\"),\n    })\n\nby_rings = defaultdict(list)\nfor r in results: by_rings[r[\"n_rings\"]].append(r)\nfor n, group in by_rings.items():\n    our_min = min(r[\"Etot_our\"] for r in group)\n    for r in group: r[\"Erel_our\"] = r[\"Etot_our\"] - our_min\n\nfiltered = [r for r in results if r[\"Etot_lit\"] and r[\"Etot_our\"] and abs(r[\"Etot_our\"]-r[\"Etot_lit\"])<=1.0]\nprint(f\"All: {len(results)}, filtered: {len(filtered)} ({len(results)-len(filtered)} outliers removed)\")\n\nplt.rcParams.update({\"font.family\":\"sans-serif\",\"font.sans-serif\":[\"Arial\",\"DejaVu Sans\"],\n    \"font.size\":9,\"axes.labelsize\":11,\"axes.titlesize\":12,\"xtick.labelsize\":9,\"ytick.labelsize\":9})\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\naxes = axes.flatten()\n\ndef sp(ax, x, y, xl, yl, t, cb=None, cl=None):\n    if cb is not None and len(cb)==len(x):\n        sc=ax.scatter(x,y,c=cb,cmap=\"viridis\",s=1,alpha=0.5,rasterized=True)\n        cbar=plt.colorbar(sc,ax=ax)\n        if cl: cbar.set_label(cl)\n    else: ax.scatter(x,y,s=1,alpha=0.3,color=\"steelblue\",rasterized=True)\n    mx,my=np.mean(x),np.mean(y)\n    ss_xy=np.sum((x-mx)*(y-my)); ss_xx=np.sum((x-mx)**2); ss_yy=np.sum((y-my)**2)\n    r2=(ss_xy**2)/(ss_xx*ss_yy) if ss_xx*ss_yy!=0 else 0\n    slope=ss_xy/ss_xx if ss_xx!=0 else 0\n    ax.plot(np.linspace(min(x),max(x),100),np.linspace(min(x),max(x),100),\"k--\",lw=0.5,alpha=0.3)\n    ax.set_xlabel(xl); ax.set_ylabel(yl)\n    ax.set_title(f\"{t}  (R\u00b2={r2:.4f}, slope={slope:.4f})\")\n    mae=np.mean(np.abs(np.array(x)-np.array(y)))\n    ax.text(0.05,0.95,f\"MAE={mae:.4f} eV  N={len(x)}\",transform=ax.transAxes,va=\"top\",fontsize=8)\n\ndef ex(k, d=filtered):\n    o=np.array([r[f\"{k}_our\"] for r in d if r[f\"{k}_our\"] is not None and r[f\"{k}_lit\"] is not None])\n    l=np.array([r[f\"{k}_lit\"] for r in d if r[f\"{k}_our\"] is not None and r[f\"{k}_lit\"] is not None])\n    return o,l\n\nrf=np.array([r[\"n_rings\"] for r in filtered if r[\"HOMO_our\"] is not None and r[\"HOMO_lit\"] is not None])\n\noh,lh=ex(\"HOMO\"); ol,ll=ex(\"LUMO\"); og,lg=ex(\"GAP\"); oe,le=ex(\"Erel\")\nsp(axes[0],oh,lh,\"Our HOMO (eV)\",\"Published HOMO (eV)\",\"HOMO\",rf,\"n_rings\")\nsp(axes[1],ol,ll,\"Our LUMO (eV)\",\"Published LUMO (eV)\",\"LUMO\",rf,\"n_rings\")\nsp(axes[2],og,lg,\"Our GAP (eV)\",\"Published GAP (eV)\",\"HOMO-LUMO Gap\",rf,\"n_rings\")\nsp(axes[3],oe,le,\"Our Erel (eV)\",\"Published Erel (eV)\",\"Relative Energy\",rf,\"n_rings\")\n\nde=oe-le; axes[4].hist(de,bins=100,color=\"steelblue\",alpha=0.7,edgecolor=\"white\",lw=0.3)\naxes[4].set_xlabel(\"\u0394Erel (eV)\"); axes[4].set_ylabel(\"Count\")\naxes[4].set_title(f\"\u0394Erel Distribution  (MAE={np.mean(np.abs(de)):.4f} eV)\")\naxes[4].axvline(0,color=\"k\",ls=\"--\",lw=0.5)\n\nna=np.array([r[\"n_rings\"] for r in filtered if r[\"GAP_our\"] is not None])\nga=np.array([r[\"GAP_our\"] for r in filtered if r[\"GAP_our\"] is not None])\naxes[5].scatter(na,ga,s=1,alpha=0.15,color=\"steelblue\",rasterized=True)\nfor n in sorted(set(na)):\n    mask=na==n\n    if np.sum(mask)>0: axes[5].plot(n,np.median(ga[mask]),\"ro\",ms=4)\naxes[5].set_xlabel(\"Number of Rings\"); axes[5].set_ylabel(\"HOMO-LUMO Gap (eV)\")\naxes[5].set_title(\"Gap vs Ring Size  (red = median)\")\n\nplt.tight_layout()\nplt.savefig(os.path.join(RESULTS_DIR,\"figure4_correlation_filtered.png\"),dpi=150)\nplt.savefig(os.path.join(RESULTS_DIR,\"figure4_correlation_filtered.svg\"))\nprint(f\"Saved: {RESULTS_DIR}/figure4_correlation_filtered.png\")\n\nprint(f\"\\nStats (excluding {len(results)-len(filtered)} outliers):\")\nfor label,o,l in [(\"HOMO\",oh,lh),(\"LUMO\",ol,ll),(\"GAP\",og,lg),(\"Erel\",oe,le)]:\n    d=o-l; ad=np.abs(d); mx,my=np.mean(o),np.mean(l)\n    ss_xy=np.sum((o-mx)*(l-my)); ss_xx=np.sum((o-mx)**2); ss_yy=np.sum((l-my)**2)\n    r2=(ss_xy**2)/(ss_xx*ss_yy) if ss_xx*ss_yy!=0 else 0\n    slope=ss_xy/ss_xx if ss_xx!=0 else 0\n    print(f\"  {label:5s}: MAE={ad.mean():.4f}  R\u00b2={r2:.4f}  slope={slope:.4f}\")\nPYEOF\n"}

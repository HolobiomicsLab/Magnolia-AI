{"event_type":"tool_call","timestamp":"2026-06-10T12:04:13.245771Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport json\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\n\nhaddock_scores = {\n    'Z11-16-Ald': -42.0,\n    'Z11-16-Ac': -47.6,\n    'Cedrol': -41.3,\n    '\u03b2-Ionone': -31.3,\n    'C8-Ald': -30.5,\n    'C12-Ald': -34.2,\n    'Palmitic acid': -49.9,\n    'Citral': -25.7,\n}\n\ncompounds = {c['name']: c for c in data}\n\nprint('Ligand             IC50(\u03bcM)  HADDOCK   Rank(IC50) Rank(H3)')\nprint('-' * 60)\npairs = []\nfor name, score in haddock_scores.items():\n    c = compounds.get(name)\n    if c:\n        ic50 = c['ic50_obp3']\n        pairs.append((name, ic50, score))\n\n# Rank by IC50 (lower = better) and HADDOCK (lower = better)\npairs_by_ic50 = sorted(pairs, key=lambda x: x[1])\npairs_by_h3 = sorted(pairs, key=lambda x: x[2])\n\nfor i, (name, ic50, score) in enumerate(pairs_by_ic50):\n    h3_rank = [n for n,_,_ in pairs_by_h3].index(name) + 1\n    print(f'{name:20s} {ic50:>8.1f}  {score:>8.1f}  {i+1:>9d}  {h3_rank:>8d}')\n\n# Manual spearman\ndef rankdata(a):\n    n = len(a)\n    ranks = [0]*n\n    sorted_pairs = sorted(enumerate(a), key=lambda x: x[1])\n    for rank, (idx, _) in enumerate(sorted_pairs):\n        ranks[idx] = rank + 1\n    return ranks\n\nic50_ranks = rankdata([p[1] for p in pairs])\nh3_ranks = rankdata([p[2] for p in pairs])\nn = len(pairs)\nrho = 1 - 6*sum((a-b)**2 for a,b in zip(ic50_ranks, h3_ranks))/(n*(n*n-1))\nprint(f'\\nSpearman \u03c1 = {rho:.3f}  (n={n})')\nprint('Meaning: \u03c1 < 0 = anti-correlated with experiment')\nprint('         \u03c1 > 0 = docking ranks track experimental affinity')\n\"\n"}

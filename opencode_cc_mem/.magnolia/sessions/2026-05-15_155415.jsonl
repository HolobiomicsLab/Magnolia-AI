len(sk & pk)\n        if overlap > best_overlap:\n            best_overlap = overlap\n            best_pn = pn\n    results.append((best_overlap, bn, best_pn, sdata['title']))\n\nresults.sort()\n\n# Categorize coverage\nhigh = sum(1 for r in results if r[0] >= 10)\nmed  = sum(1 for r in results if 5 <= r[0] < 10)\nlow  = sum(1 for r in results if r[0] < 5)\ntotal = len(results)\n\nprint(f\"Total project entries: {len(entries)}\")\nprint(f\"Total staging entries: {total}\")\nprint(f\"  Strong coverage (>=10 kw overlap): {high} ({high*100//total}%)\")\nprint(f\"  Medium coverage (5-9 kw overlap): {med} ({med*100//total}%)\")\nprint(f\"  Weak / no coverage (<5 kw overlap): {low} ({low*100//total}%)\")\nprint()\n\n# Show the uncovered ones\nprint(\"=== WEAKLY COVERED (< 5 keyword overlap) ===\")\nfor ov, bn, pn, title in results:\n    if ov < 5:\n        short_bn = bn[:60]\n        short_pn = pn[:50] if pn else 'none'\n        print(f\"  [{ov:2d}] {title[:110]}\")\n        print(f\"        best match: {short_pn}\")\nprint()\n\n# Now show a sample of what IS well-covered vs what's NOT\nprint(\"=== MEDIUM COVERAGE (5-9) \u2014 borderline ===\")\nfor ov, bn, pn, title in results:\n    if 5 <= ov <= 6:\n        print(f\"  [{ov:2d}] {title[:110]}\")\nPYEOF\n"}

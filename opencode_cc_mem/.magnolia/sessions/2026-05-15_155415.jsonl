{"event_type":"tool_call","timestamp":"2026-06-10T13:07:59.883195Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\n# Full comparison: Asn90-box rigid vs experiment\npython3 << 'PYEOF'\nimport json, math\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\nligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Z11-16-OH', 'C8-Ald', 'C12-Ald', \n           '\u03b2-Ionone', 'Citral', 'Palmitic_acid']\n\nprint(f\"{'Ligand':16s} {'IC50':>7s} {'Kd_exp':>7s} {'EmpAff':>7s} {'CNNaff':>7s} {'CNNscore':>9s}  Asn90?\")\nprint(\"-\" * 75)\n\nresults = []\nfor lig in ligands:\n    fname = f'docked_{lig}_asn90.sdf'\n    best_aff = None\n    try:\n        with open(fname) as fh:\n            content = fh.read()\n        blocks = content.split('$$$$')\n        for b in blocks:\n            if not b.strip(): continue\n            lines = b.strip().split('\\n')\n            cnn_score = cnn_aff = emp_aff = 0\n            for j, l in enumerate(lines):\n                if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n                if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n                if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n            if best_aff is None or emp_aff < best_aff[0]:\n                best_aff = (emp_aff, cnn_score, cnn_aff)\n    except:\n        pass\n\n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    kd = c.get('kd_obp3', 'N/A')\n    \n    if best_aff:\n        ea, cs, ca = best_aff\n        \n        # Check Asn90 contact\n        na = 0\n        with open(fname) as fh:\n            content = fh.read()\n        blocks = content.split('$$$$')\n        for b in blocks:\n            if not b.strip(): continue\n            lines = b.strip().split('\\n')\n            if len(lines) < 5: continue\n            na = int(lines[3][:3])\n            # Parse receptor atoms\n            rec_atoms = []\n            with open('receptor.pdb') as rf:\n                for l in rf:\n                    if not l.startswith('ATOM'): continue\n                    res = l[17:20].strip()\n                    rnum = int(l[22:26])\n                    x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n                    rec_atoms.append((res, rnum, x, y, z))\n            # Parse this block's ligand atoms\n            lig_atoms = []\n            for i in range(4, 4+na):\n                if i >= len(lines): break\n                l = lines[i]\n                x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n                lig_atoms.append((x, y, z))\n            # Check Asn90 distance\n            asn90_d = 999\n            for ra in rec_atoms:\n                if ra[0] == 'ASN' and ra[1] == 90:\n                    for la in lig_atoms:\n                        d = math.sqrt((ra[2]-la[0])**2 + (ra[3]-la[1])**2 + (ra[4]-la[2])**2)\n                        if d < asn90_d:\n                            asn90_d = d\n            asn90_str = f'{asn90_d:.1f}\u00c5' if asn90_d < 6 else 'none'\n            break  # only check top pose\n        \n        print(f\"{lig:16s} {ic50:>7.1f} {kd:>7.3f} {ea:>7.2f} {ca:>7.3f} {cs:>9.4f}  {asn90_str}\")\n        results.append((lig, ic50, ea))\n    else:\n        print(f\"{lig:16s} {ic50:>7.1f} {kd:>7.3f} {'N/A':>7s} {'N/A':>7s} {'N/A':>9s}  -\")\n\nPYEOF"}

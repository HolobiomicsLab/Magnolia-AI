{"event_type":"tool_success","timestamp":"2026-06-12T12:22:48.360865Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":30,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-12T12:44:03.328916Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22], 'resi': int(line[22:26]),\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                })\n    return atoms\n\ndef dist(a1, a2): return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\nPOS = {'LYS': ['NZ'], 'ARG': ['NH1','NH2']}\nNEG = {'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2']}\nAPOLAR = {'ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET','CYS'}\n\natoms = parse_pdb('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/share-structures/KFERQ_5mer_ref.pdb')\nchain_a = [a for a in atoms if a['chain'] == 'A']\nchain_b = [a for a in atoms if a['chain'] == 'B']\n\nb_resis = sorted(set(a['resi'] for a in chain_b))\nb_seq = [(r, next(a['resn'] for a in chain_b if a['resi']==r)) for r in b_resis]\nprint(f\"Peptide: {'-'.join(f'{rn}{r}' for r, rn in b_seq)}\")\n\n# === SALT BRIDGES ===\nprint(\"\\n===== SALT BRIDGES (N\u2013O \u2264 4.0 \u00c5) =====\")\nsb = []\nfor a_a in chain_a:\n    if a_a['resn'] not in POS and a_a['resn'] not in NEG: continue\n    a_ch = POS.get(a_a['resn']) or NEG.get(a_a['resn'])\n    if a_a['name'] not in a_ch: continue\n    a_pos = a_a['resn'] in POS\n    for a_b in chain_b:\n        if a_b['resn'] not in POS and a_b['resn'] not in NEG: continue\n        if a_b['resn'] in POS == a_pos: continue\n        b_ch = POS.get(a_b['resn']) or NEG.get(a_b['resn'])\n        if a_b['name'] not in b_ch: continue\n        d = dist(a_a, a_b)\n        if d <= 4.0: sb.append((a_a, a_b, d))\n\n# dedup by residue pair\nseen = set()\nfor a_a, a_b, d in sorted(sb, key=lambda x: x[2]):\n    k = (a_a['resi'], a_b['resi'])\n    if k not in seen:\n        seen.add(k)\n        print(f\"  A-{a_a['resi']:>4}-{a_a['resn']:<4}{a_a['name']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}{a_b['name']:<4}  {d:.1f} \u00c5\")\nprint(f\"  Total: {len(seen)} salt bridges\")\n\n# === H-BONDS ===\nprint(\"\\n===== H-BONDS (donor-H \u2192 acceptor \u2264 3.5 \u00c5) =====\")\nACCEPTORS = {'ASP':['OD1','OD2'],'GLU':['OE1','OE2'],'ASN':['OD1'],'GLN':['OE1'],'SER':['OG'],'THR':['OG1'],'TYR':['OH']}\nDONORS_H = {'ARG':{'NH1':['HH11','HH12'],'NH2':['HH21','HH22'],'NE':['HE']}, 'LYS':{'NZ':['HZ1','HZ2','HZ3']},\n            'ASN':{'ND2':['HD21','HD22']},'GLN':{'NE2':['HE21','HE22']},'SER':{'OG':['HG']},'THR':{'OG1':['HG1']},'TYR':{'OH':['HH']}}\n\nhb = []\nfor a_a in chain_a:\n    for a_b in chain_b:\n        af_a = a_a['name'] in ACCEPTORS.get(a_a['resn'],[])\n        af_b = a_b['name'] in ACCEPTORS.get(a_b['resn'],[])\n        dh_a = a_a['name'] in DONORS_H.get(a_a['resn'],{})\n        dh_b = a_b['name'] in DONORS_H.get(a_b['resn'],{})\n        d = dist(a_a, a_b)\n        if d > 3.5: continue\n        if af_a and dh_b: hb.append(('Peptide\u2192Rec', a_b, a_a, d))\n        elif af_b and dh_a: hb.append(('Rec\u2192Peptide', a_a, a_b, d))\n\nseen2 = set()\nfor direc, donor, acc, d in sorted(hb, key=lambda x: x[3]):\n    k = (donor['resi'], acc['resi'])\n    if k not in seen2:\n        seen2.add(k)\n        dl = f\"{donor['chain']}-{donor['resi']}-{donor['resn']}:{donor['name']}\"\n        al = f\"{acc['chain']}-{acc['resi']}-{acc['resn']}:{acc['name']}\"\n        print(f\"  {dl:>20} \u2192 {al:<20}  {d:.1f} \u00c5  [{direc}]\")\nprint(f\"  Total: {len(seen2)} H-bonds\")\n\n# === HYDROPHOBIC ===\nprint(\"\\n===== HYDROPHOBIC (C\u03b2\u2013C\u03b2 \u2264 5.0 \u00c5) =====\")\nhydro = []\nfor a_a in chain_a:\n    if a_a['resn'] not in APOLAR: continue\n    if a_a['name'] != 'CB' and not (a_a['resn']=='GLY' and a_a['name']=='CA'): continue\n    for a_b in chain_b:\n        if a_b['resn'] not in APOLAR: continue\n        if a_b['name'] != 'CB' and not (a_b['resn']=='GLY' and a_b['name']=='CA'): continue\n        d = dist(a_a, a_b)\n        if d <= 5.0: hydro.append((a_a, a_b, d))\nif hydro:\n    for a_a, a_b, d in sorted(hydro, key=lambda x: x[2]):\n        print(f\"  A-{a_a['resi']:>4}-{a_a['resn']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}  {d:.1f} \u00c5\")\nelse:\n    print(\"  (none)\")\n\n# === PER-RESIDUE BREAKDOWN ===\nprint(\"\\n===== PER-RESIDUE RECEPTOR CONTACTS (\u2264 4.0 \u00c5) =====\")\nfor b_r, b_rn in b_seq:\n    contacts = []\n    for a_a in chain_a:\n        best = 999\n        for a_b in chain_b:\n            if a_b['resi'] != b_r: continue\n            d = dist(a_a, a_b)\n            if d < best: best = d\n        if best <= 4.0:\n            contacts.append((a_a['resi'], a_a['resn'], best))\n    contacts.sort(key=lambda x: x[2])\n    line = ', '.join(f\"{r}-{rn}({d:.1f})\" for r, rn, d in contacts)\n    print(f\"  B-{b_r}-{b_rn:<4} \u2192 {len(contacts):>2} contacts: {line}\")\n\n# === TOTAL RECEPTOR ===\nall_rec = set()\nfor a_a in chain_a:\n    for a_b in chain_b:\n        if dist(a_a, a_b) <= 4.0: all_rec.add(a_a['resi'])\nprint(f\"\\n  Total unique receptor residues contacting peptide: {len(all_rec)}\")\n\nPYEOF"}

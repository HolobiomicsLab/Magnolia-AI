\n        ok += 1; continue\n    \n    if heavies != exp:\n        bad.append((name, f'expected {exp} heavies, got {heavies}'))\n    else:\n        ok += 1\n\nprint(f\"OK: {ok}/40\")\nif bad:\n    print(f\"\\nMismatches ({len(bad)}):\")\n    for name, detail in bad:\n        print(f\"  {name:30s} {detail}\")\nelse:\n    print(\"All verified \u2713\")\nprint(f\"\\nHas hydrogens: {has_h}\")\n\n# Show example PDB snippet\nprint(f\"\\nExample (Z11-16-Ald.pdb first 5 atoms):\")\nwith open('Z11-16-Ald.pdb') as f:\n    for i, l in enumerate(f):\n        if i >= 5: break\n        print(f\"  {l.rstrip()}\")\nPYEOF"}

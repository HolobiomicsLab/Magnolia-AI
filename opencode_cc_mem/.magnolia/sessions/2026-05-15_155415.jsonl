['resnum'], r['resname']))\n    bca = [a for a in pa if a['atom']=='CA']\n    min_d=999; mr=''; mrn=0\n    for r in rec:\n        if r['atom']=='CA':\n            d=np.linalg.norm(bca[0]['xyz']-r['xyz'])\n            if d<min_d: min_d=d; mr=r['resname']; mrn=r['resnum']\n    dom = \"NBD\" if mrn<380 else (\"SBD\u03b2\" if mrn<520 else \"SBD\u03b1/lid\")\n    if min_d>10: dom=\"OUTSIDE\"\n    res = t2o.get([a['resname'] for a in pa][0], '?')\n    print(f\"{i:>3} {res:>3} {len(contacts):>5}   {mr}{mrn}@{min_d:.1f}A  {dom}\")\n\nb1=[a for a in pep if a['resnum']==pep_resnums[0] and a['atom']=='CA']\nb5=[a for a in pep if a['resnum']==pep_resnums[-1] and a['atom']=='CA']\nif b1 and b5:\n    print(f\"\\nPeptide span: {np.linalg.norm(b1[0]['xyz']-b5[0]['xyz']):.1f} A\")\nPYEOF"}

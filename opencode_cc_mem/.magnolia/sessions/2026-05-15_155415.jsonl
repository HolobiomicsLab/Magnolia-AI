{"event_type":"tool_success","timestamp":"2026-06-10T14:02:57.800839Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":80169,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-10T14:06:36.691222Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport math, json\nfrom collections import defaultdict\n\nrec_atoms = []\nwith open('receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\ndef parse_top_pose(sdf_path):\n    with open(sdf_path) as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        cnn_score = cnn_aff = emp_aff = 0; na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        lig = []\n        for i in range(atom_start, min(atom_start+na, len(lines))):\n            l = lines[i]\n            if len(l) < 30: continue\n            try: x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n            except: continue\n            elem = l[31:34].strip() or 'C'\n            lig.append((elem, x, y, z))\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, cnn_score, cnn_aff, lig)\n    return best\n\n# Analyze flex8 results for each ligand\nligands = [\n    ('Z11-16-Ald',  'good',     'docked_flex8_Z11-16-Ald_asn90.sdf'),\n    ('Z11-16-Ac',   'non-binder','docked_flex8_Z11-16-Ac_asn90.sdf'),\n    ('Z11-16-OH',   'weak',     'docked_flex8_Z11-16-OH_asn90.sdf'),\n    ('Palmitic acid','non-binder','docked_flex8_Palmitic_acid_asn90.sdf'),\n    ('Cedrol',      'good',     'docked_flex8_Cedrol_asn90.sdf'),\n    ('\u03b2-Ionone',    'good',     'docked_flex8_\u03b2-Ionone_asn90.sdf'),\n]\n\n# Vina atom types that contribute to empirical affinity\n# In AutoDock Vina, the scoring function uses atom-type pairs:\n# C-C: hydrophobic/dispersion (~-0.03 to -0.06 per pair)\n# C-N/O: mixed (~-0.05)  \n# N/O-N/O: polar/H-bond (~-0.10 to -0.30)\n# The more contacts, the better the score (it's additive)\n\nfor name, cls, fname in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, cnn_score, cnn_aff, lig_atoms = result\n    c = compounds.get(name, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    \n    # Count contacts by type\n    contacts = []\n    polar_contacts = []\n    hbond_candidates = []\n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d > 5.0: continue\n            is_polar = lelem in ('O','N') or rname[0] in ('O','N')\n            contacts.append((rres, rnum, rname, lelem, d, is_polar))\n            if is_polar and d <= 3.5:\n                # H-bond geometry check for donor-acceptor pairs\n                if (lelem == 'O' and rname[0] == 'N') or (lelem == 'N' and rname[0] == 'O'):\n                    hbond_candidates.append((f\"{rres}{rnum}:{rname}\", f\"LIG:{lelem}\", d))\n    \n    polar = [c for c in contacts if c[5]]\n    apolar = [c for c in contacts if not c[5]]\n    close_polar = [c for c in polar if c[4] <= 3.5]\n    \n    print(f\"\\n{'='*60}\")\n    print(f\"{name}  ({cls})  EmpAff={emp_aff:.1f}  IC50={ic50}\")\n    print(f\"  Atoms: {len(lig_atoms)}  |  Contacts \u22645\u00c5: {len(contacts)}\")\n    print(f\"  Polar contacts: {len(polar)}  |  Close polar (\u22643.5\u00c5): {len(close_polar)}\")\n    print(f\"  Apolar contacts: {len(apolar)}\")\n    \n    if hbond_candidates:\n        print(f\"  H-bond candidates (O\u00b7\u00b7\u00b7N \u22643.5\u00c5):\")\n        for rc, lc, d in sorted(hbond_candidates, key=lambda x: x[2]):\n            print(f\"    {rc:20s} \u2190 {lc:10s}  {d:.1f}\u00c5\")\n    \n    # Top polar contacts\n    close_polar.sort(key=lambda x: x[4])\n    if close_polar:\n        print(f\"  Top 5 close polar contacts:\")\n        for rres, rnum, rname, lelem, d, _ in close_polar[:5]:\n            print(f\"    {rres}{rnum}:{rname:5s} \u2190 LIG:{lelem}  {d:.1f}\u00c5\")\n\n# Now compare: what makes non-binders score well?\nprint(f\"\\n{'='*60}\")\nprint(\"COMPARISON: What drives the scores?\")\nprint(f\"{'='*60}\")\n\nfor name, cls, fname in ligands:\n    result = parse_top_pose(fname)\n    if result is None: continue\n    emp_aff, _, _, lig_atoms = result\n    \n    # Count contact composition\n    n_atoms = len(lig_atoms)\n    n_polar_lig = sum(1 for e,_,_ in lig_atoms if e in ('O','N'))\n    n_apolar_lig = n_atoms - n_polar_lig\n    \n    contacts = []\n    for lelem, lx, ly, lz in lig_atoms:\n        for rname, rres, rnum, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                is_polar = lelem in ('O','N') or rname[0] in ('O','N')\n                contacts.append((rres, rnum, d, is_polar))\n    \n    polar_c = [c for c in contacts if c[3]]\n    apolar_c = [c for c in contacts if not c[3]]\n    \n    # Unique contacting residues\n    res_set = set(f\"{c[0]}{c[1]}\" for c in contacts)\n    \n    print(f\"\\n{name:16s} ({cls:10s})  aff={emp_aff:.1f}\")\n    print(f\"  Lig atoms: {n_atoms} (polar={n_polar_lig}, apolar={n_apolar_lig})\")\n    print(f\"  Contacts:  {len(contacts)} total, {len(polar_c)} polar, {len(apolar_c)} apolar\")\n    print(f\"  Contacting residues: {len(res_set)}\")\n    print(f\"  Affinity per contact: {emp_aff/len(contacts):.4f}\")\n\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-16T09:44:09.315586Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\n\npython3 << 'PYEOF'\nimport os, shutil\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nDATE = \"2026-06-16\"\nRECEPTOR_SRC = f\"{BASE}/raw_input/receptor/4po2_chainA.pdb\"\n\n# Receptor actpass\n# Active: 19 groove residues within 4A of NRLLLTG\nrec_active = [403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473]\n# Passive: flanking surface residues\nrec_passive = [401,402,407,408,409,410,412,425,432,433,434,436,441,442,443,444,459,461,462,468,470,471,472]\n\n# Peptides: (name, pdb_path)\npeptides_5mer = [\n    (\"KFERQ\", f\"{BASE}/raw_input/peptides/5mers/KFERQ.pdb\"),\n    (\"KILDQ\", f\"{BASE}/raw_input/peptides/5mers/KILDQ.pdb\"),\n    (\"RKDLQ\", f\"{BASE}/raw_input/peptides/5mers/RKDLQ_clean.pdb\"),\n    (\"RKELQ\", f\"{BASE}/raw_input/peptides/5mers/RKELQ.pdb\"),\n    (\"QRKEL\", f\"{BASE}/raw_input/peptides/5mers/QRKEL.pdb\"),\n]\n\npeptides_long = [\n    (\"KFERQx2\", f\"{BASE}/raw_input/peptides/longer/peptide3_KFERQx2_fixed.pdb\"),\n    (\"QRKELx2\", f\"{BASE}/raw_input/peptides/longer/peptide2_QRKELx2.pdb\"),\n    (\"RKELQx2\", f\"{BASE}/raw_input/peptides/longer/peptide1_RKELQx2.pdb\"),\n    (\"RKDLQ-variant\", f\"{BASE}/raw_input/peptides/longer/peptide4_RKDLQ-variant_fixed.pdb\"),\n    (\"KFERQ-KILDQ-fusion\", f\"{BASE}/raw_input/peptides/longer/peptide5_KFERQ-KILDQ-fusion.pdb\"),\n]\n\ndef get_peptide_resi(pdb_path):\n    \"\"\"Get sorted list of unique residue numbers from peptide PDB.\"\"\"\n    resis = []\n    with open(pdb_path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                resi = int(line[22:26].strip())\n                if resi not in resis:\n                    resis.append(resi)\n    return sorted(resis)\n\ndef write_actpass(path, active, passive):\n    with open(path, 'w') as f:\n        f.write(\" \".join(str(r) for r in active) + \"\\n\")\n        f.write(\" \".join(str(r) for r in passive) + \"\\n\")\n\ndef write_config(path, peptide_name, sampling, ncores=32, mode=\"local\"):\n    config = f\"\"\"run_dir = \"output\"\nncores = {ncores}\nmode = \"{mode}\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\n\n[topoaa]\n\n[rigidbody]\nambig_fname = \"ambig.tbl\"\nsampling = {sampling}\n\n[seletop]\nselect = 200\n\n[flexref]\n\n[emref]\n\n[clustfcc]\n\n[seletopclusts]\n\n[caprieval]\n\n[contactmap]\n\"\"\"\n    with open(path, 'w') as f:\n        f.write(config)\n\nall_peptides = [(name, pdb, 5000, False) for name, pdb in peptides_5mer] + \\\n               [(name, pdb, 5000, True) for name, pdb in peptides_long]\n\nfor pname, ppdb, sampling, is_long in all_peptides:\n    run_dir = f\"{BASE}/runs/{DATE}_4po2_{pname}_s{sampling}\"\n    os.makedirs(run_dir, exist_ok=True)\n    \n    # Copy receptor\n    shutil.copy(RECEPTOR_SRC, f\"{run_dir}/receptor.pdb\")\n    \n    # Copy peptide\n    shutil.copy(ppdb, f\"{run_dir}/peptide.pdb\")\n    \n    # Get peptide residues\n    pep_resis = get_peptide_resi(ppdb)\n    pep_active = pep_resis\n    pep_passive = []\n    \n    # Write actpass files\n    write_actpass(f\"{run_dir}/receptor.actpass\", rec_active, rec_passive)\n    write_actpass(f\"{run_dir}/peptide.actpass\", pep_active, pep_passive)\n    \n    # Write config\n    write_config(f\"{run_dir}/config.cfg\", pname, sampling)\n    \n    print(f\"Created: {os.path.basename(run_dir)}\")\n    print(f\"  Peptide resi: {pep_active}\")\n    print(f\"  Sampling: {sampling}\")\n\nprint(f\"\\nDone. Created {len(all_peptides)} run directories.\")\nPYEOF"}

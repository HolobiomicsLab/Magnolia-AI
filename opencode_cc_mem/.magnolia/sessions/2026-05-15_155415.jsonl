{"event_type":"tool_call","timestamp":"2026-06-17T07:33:56.995329Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport yaml, os, glob, json\nfrom collections import defaultdict\n\nyaml_dir = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/.magnolia/runs/'\nfiles = sorted(glob.glob(os.path.join(yaml_dir, '20260616*.yaml')))\n\nby_lifecycle = defaultdict(list)\nall_job_ids = []\n\nfor f in files:\n    with open(f) as fh:\n        d = yaml.safe_load(fh)\n    rid = d.get('run_id', '?')\n    lc = d.get('lifecycle', 'unknown')\n    remote = d.get('remote', {})\n    jid = remote.get('job_id', None) if remote else None\n    slurm = remote.get('slurm', {}) if remote else {}\n    slurm_state = slurm.get('state', None)\n    local_dir = remote.get('local_run_dir', 'N/A') if remote else 'N/A'\n    \n    if jid:\n        all_job_ids.append(jid)\n    \n    by_lifecycle[lc].append({\n        'run_id': rid,\n        'job_id': jid,\n        'slurm_state': slurm_state,\n        'local_dir': local_dir,\n    })\n\nprint(f\"Total entries: {len(files)}\\n\")\n\nfor lc in sorted(by_lifecycle.keys()):\n    items = by_lifecycle[lc]\n    print(f\"=== LIFECYCLE: {lc} ({len(items)} entries) ===\")\n    for item in items:\n        jid_str = f\"job={item['job_id']}\" if item['job_id'] else \"job=local\"\n        slurm_str = f\" slurm={item['slurm_state']}\" if item['slurm_state'] else \"\"\n        local = item['local_dir']\n        # extract peptide name from path\n        import re\n        m = re.search(r'runs/([^/]+)$', local)\n        run_name = m.group(1) if m else local.split('/')[-1]\n        print(f\"  {item['run_id']:45s} {jid_str:>18s}{slurm_str:>15s}  dir: {run_name}\")\n    print()\n\nprint(f\"\\nUnique Slurm job IDs: {len(set(all_job_ids))}\")\nfor jid in sorted(set(all_job_ids)):\n    print(f\"  {jid}\")\nPYEOF\n"}

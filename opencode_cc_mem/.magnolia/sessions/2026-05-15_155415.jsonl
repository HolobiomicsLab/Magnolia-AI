{"event_type":"tool_call","timestamp":"2026-06-09T13:23:58.588885Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip, re, json\n\nASN_ND2 = (37.7, -29.2, 0.5)\nASN_OD1 = (37.8, -31.3, -0.3)\n\nwith gzip.open('docked_bridge_all.sdf.gz', 'rt') as f:\n    mols = f.read().strip().split('$$$$\\n')\n\n# For each compound (40), check the 20 poses for H-bond with Asn90\nN_POSES = 20\n\nprint(\"\u2550\u2550\u2550 CONTACT ANALYSIS: Asn90 H-bond (any O within 3.5\u00c5 of ND2) \u2550\u2550\u2550\")\nprint(f\"{'Compound':<22s} {'Kd':>7s} {'O-ND2 min':>10s} {'H-bond?':>8s} {'Top aff':>8s}\")\nprint(\"-\" * 65)\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\nhbond_count = 0\nfor comp_i in range(40):\n    start = comp_i * N_POSES\n    fn = sdf_names_sorted[comp_i]\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else \"WEAK\")\n    \n    # Find best O-ND2 distance across all 20 poses\n    best_ond2 = 999\n    best_aff = 999\n    for pose_i in range(N_POSES):\n        idx = start + pose_i\n        if idx >= len(mols): continue\n        mol = mols[idx].strip()\n        if not mol: continue\n        lines = mol.split('\\n')\n        try: natoms = int(lines[3][:3].strip())\n        except: continue\n        \n        # Get affinity from header properties\n        header = '\\n'.join(lines[:4])\n        m = re.search(r'minimizedAffinity', header)\n        \n        for j in range(4, 4 + natoms):\n            l = lines[j]\n            if len(l) < 34: continue\n            elem = l[31:34].strip()\n            if elem == 'O':\n                x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n                d = ((x-ASN_ND2[0])**2 + (y-ASN_ND2[1])**2 + (z-ASN_ND2[2])**2)**0.5\n                if d < best_ond2:\n                    best_ond2 = d\n    \n    hbond = \"\u2713 H-BOND\" if best_ond2 < 3.5 else (\"~close\" if best_ond2 < 5 else \"\")\n    if best_ond2 < 3.5: hbond_count += 1\n    \n    # Also get top affinity from log\n    with open('gnina_bridge_all.out') as f_log:\n        blocks_log = f_log.read().split('mode |  affinity')[1:]\n        if comp_i < len(blocks_log):\n            m = re.search(r'\\n\\s+1\\s+(-?\\d+\\.\\d+)', blocks_log[comp_i])\n            best_aff = float(m.group(1)) if m else 999\n    \n    print(f\"  {name:<20s} {kd:>7.3f} {best_ond2:>10.1f} {hbond:>8s} {best_aff:>+8.2f}  [{cls}]\")\n\nprint(f\"\\n  Total with H-bond: {hbond_count}/40\")\n\n# Check: which scoring function? Both.\nprint(f\"\\n\u2550\u2550\u2550 WHAT I'M REPORTING \u2550\u2550\u2550\")\nprint(f\"  'Affinity' = gnina empirical (Vina) scoring function, kcal/mol\")\nprint(f\"  Pose ranking: CNN pose score (gnina default)\")\nprint(f\"  'CNN pose score' in table = probability pose is correct (0-1)\")\nprint(f\"  'CNN affinity' in table = CNN-predicted binding affinity\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-09T09:45:53.499472Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip, re\n\n# Check pose locations for key compounds\nwith gzip.open('docked_p2rank.sdf.gz', 'rt') as f:\n    content = f.read()\n\nmols = content.strip().split('$$$$\\n')\nASN90_COORDS = (37.3, -30.2, -0.3)  # CG atom\n\n# SDF compound order (alphabetical, same as before)\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nN_POSES = 20\nprint(\"Distance from best pose to Asn90 CG (should be <5 \u00c5 if H-bonding):\")\nprint(f\"{'Compound':<22s} {'Dist2Asn90':>12s}\")\nprint(\"-\" * 40)\n\nfor comp_idx in range(min(40, len(mols)//N_POSES)):\n    start = comp_idx * N_POSES\n    fn = sdf_names_sorted[comp_idx]\n    name = name_map.get(fn, fn)\n    \n    mol = mols[start].strip()  # first pose\n    if not mol: continue\n    lines = mol.split('\\n')\n    try:\n        natoms = int(lines[3][:3].strip())\n    except:\n        continue\n    \n    coords = []\n    for j in range(4, min(4 + natoms, len(lines))):\n        l = lines[j]\n        if len(l) < 31: continue\n        try:\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            coords.append((x, y, z))\n        except: continue\n    \n    if not coords: continue\n    cx = sum(a[0] for a in coords) / len(coords)\n    cy = sum(a[1] for a in coords) / len(coords)\n    cz = sum(a[2] for a in coords) / len(coords)\n    dist = ((cx - ASN90_COORDS[0])**2 + (cy - ASN90_COORDS[1])**2 + (cz - ASN90_COORDS[2])**2)**0.5\n    \n    marker = \" \u2713 CLOSE!\" if dist < 5 else (\" ~\" if dist < 8 else \"\")\n    print(f\"  {name:<20s} {dist:>12.1f}{marker}\")\n\nPYEOF"}

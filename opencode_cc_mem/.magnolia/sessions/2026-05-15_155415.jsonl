{"event_type":"tool_call","timestamp":"2026-06-20T08:53:33.277383Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas && python3 << 'PYEOF'\nimport csv, re, os\n\n# Read published data\npublished = {}\nwith open(\"raw_input/compas_data/compas-1x.csv\") as f:\n    for r in csv.DictReader(f):\n        published[r['molecule']] = {\n            'HOMO_eV': float(r['HOMO_eV']),\n            'LUMO_eV': float(r['LUMO_eV']),\n            'GAP_eV': float(r['GAP_eV']),\n            'Etot_eV': float(r['Etot_eV']),\n        }\n\n# Read selected molecules\nwith open(\"raw_input/compas_data/selected_molecules.csv\") as f:\n    selected = list(csv.DictReader(f))\n\nrun_dir = \"runs/2026-06-20_compas_xtb_validation\"\n\nprint(f\"{'Molecule':35s} {'R':>2s} {'HOMO_our':>9s} {'HOMO_pub':>9s} {'\u0394HOMO':>9s} {'GAP_our':>8s} {'GAP_pub':>8s} {'\u0394GAP':>8s} {'Etot_our':>12s} {'Etot_pub':>12s} {'\u0394Etot':>10s}\")\nprint(\"-\" * 145)\n\ndiffs_homo, diffs_gap, diffs_etot = [], [], []\n\nfor m in selected:\n    name = m['molecule']\n    outfile = f\"{run_dir}/output/{name}.out\"\n    \n    with open(outfile) as f:\n        text = f.read()\n    \n    # Extract total energy (Eh)\n    etot_match = re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text)\n    # Extract HOMO and LUMO from orbital listing\n    homo_match = re.search(r'\\(HOMO\\)\\s*\\n.*?([\\d.]+)\\s+eV\\s+HOMO', text)\n    if not homo_match:\n        # Try alternate pattern\n        homo_matches = re.findall(r'(-?[\\d.]+)\\s+\\(HOMO\\)', text)\n        lumo_matches = re.findall(r'(-?[\\d.]+)\\s+\\(LUMO\\)', text)\n        homo_ev = float(homo_matches[-1]) if homo_matches else None\n        lumo_ev = float(lumo_matches[-1]) if lumo_matches else None\n    else:\n        homo_ev = float(homo_match.group(1))\n        lumo_ev = None\n    \n    # Get HOMO-LUMO gap from summary\n    gap_match = re.search(r'HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV', text)\n    \n    etot_au = float(etot_match.group(1)) if etot_match else None\n    etot_ev = etot_au * 27.2114 if etot_au else None\n    gap_ev = float(gap_match.group(1)) if gap_match else None\n    \n    # If we have gap and one orbital energy, compute the other\n    if gap_ev and homo_ev:\n        lumo_ev = homo_ev + gap_ev  # gap = lumo - homo, so lumo = homo + gap\n    \n    pub = published.get(name, {})\n    \n    dh = homo_ev - pub['HOMO_eV'] if homo_ev else None\n    dg = gap_ev - pub['GAP_eV'] if gap_ev else None\n    de = etot_ev - pub['Etot_eV'] if etot_ev else None\n    \n    if dh is not None: diffs_homo.append(dh)\n    if dg is not None: diffs_gap.append(dg)\n    if de is not None: diffs_etot.append(de)\n    \n    ho = f\"{homo_ev:.4f}\" if homo_ev else \"N/A\"\n    hp = f\"{pub['HOMO_eV']:.4f}\" if pub.get('HOMO_eV') else \"N/A\"\n    go = f\"{gap_ev:.4f}\" if gap_ev else \"N/A\"\n    gp = f\"{pub['GAP_eV']:.4f}\" if pub.get('GAP_eV') else \"N/A\"\n    eo = f\"{etot_ev:.4f}\" if etot_ev else \"N/A\"\n    ep = f\"{pub['Etot_eV']:.4f}\" if pub.get('Etot_eV') else \"N/A\"\n    dh_s = f\"{dh:+.4f}\" if dh is not None else \"N/A\"\n    dg_s = f\"{dg:+.4f}\" if dg is not None else \"N/A\"\n    de_s = f\"{de:+.4f}\" if de is not None else \"N/A\"\n    \n    print(f\"{name:35s} {m['n_rings']:>2s} {ho:>9s} {hp:>9s} {dh_s:>9s} {go:>8s} {gp:>8s} {dg_s:>8s} {eo:>12s} {ep:>12s} {de_s:>10s}\")\n\n# Stats\nif diffs_homo:\n    mae_homo = sum(abs(d) for d in diffs_homo) / len(diffs_homo)\n    mae_gap = sum(abs(d) for d in diffs_gap) / len(diffs_gap)\n    mae_etot = sum(abs(d) for d in diffs_etot) / len(diffs_etot)\n    max_homo = max(abs(d) for d in diffs_homo)\n    max_gap = max(abs(d) for d in diffs_gap)\n    max_etot = max(abs(d) for d in diffs_etot)\n    print(f\"\\n{'MAE HOMO:':>15s} {mae_homo:.4f} eV  (max |\u0394| = {max_homo:.4f})\")\n    print(f\"{'MAE GAP:':>15s} {mae_gap:.4f} eV  (max |\u0394| = {max_gap:.4f})\")\n    print(f\"{'MAE Etot:':>15s} {mae_etot:.4f} eV  (max |\u0394| = {max_etot:.4f})\")\n    print(f\"{'N molecules:':>15s} {len(diffs_homo)}\")\nPYEOF\n"}

{"event_type":"tool_call","timestamp":"2026-06-17T09:09:45.242195Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\n# Compare parent 5-mer vs extended version within same family\nfamilies = [\n    (\"KFERQ\",   -71.87, \"KFERQKFERRQ\",       11, -114.16),\n    (\"KFERQ\",   -71.87, \"KFERQKILDQRFFE\",    14, -124.70),\n    (\"RKDLQ\",   -74.85, \"RKDLQRKDDQ\",        10, -77.17),\n    (\"QRKEL\",   -61.38, \"QRKELQRKEL\",        10, -75.51),\n    (\"RKELQ\",   -65.24, \"RKELQRKELQ\",        10, -97.21),\n]\n\nprint(\"=== Parent vs Extended (same family) ===\")\nprint(f\"{'Family':12s} {'5-mer':>8s} {'Extended':18s} {'Len':>3s} {'Ext score':>9s} {'\u0394 total':>8s} {'\u0394/res':>7s}\")\nprint(\"-\" * 70)\nfor parent, p5, ext, elen, ext_af in families:\n    delta = ext_af - p5\n    per_res = delta / (elen - 5)\n    print(f\"{parent:12s} {p5:8.2f} {ext:18s} {elen:3d} {ext_af:9.2f} {delta:+8.2f} {per_res:+7.2f}\")\n\nprint()\nprint(\"=== Normalized: AIR-free per residue ===\")\nall_data = [\n    (\"KFERQKILDQRFFE\", 14, -124.70),\n    (\"KFERQKFERRQ\",     11, -114.16),\n    (\"TGGFQMALT\",        9, -100.60),\n    (\"RKELQRKELQ\",      10,  -97.21),\n    (\"RKDLQRKDDQ\",      10,  -77.17),\n    (\"QRKELQRKEL\",      10,  -75.51),\n    (\"RKDLQ\",            5,  -74.85),\n    (\"KFERQ\",            5,  -71.87),\n    (\"HAMNG\",            5,  -67.02),\n    (\"RKELQ\",            5,  -65.24),\n    (\"KILDQ\",            5,  -64.17),\n    (\"QRKEL\",            5,  -61.38),\n]\nprint(f\"{'Sequence':18s} {'Len':>3s} {'AIR-free':>9s} {'per residue':>12s}\")\nprint(\"-\" * 45)\nfor seq, l, af in sorted(all_data, key=lambda x: x[1]):\n    print(f\"{seq:18s} {l:3d} {af:9.2f} {af/l:12.2f}\")\n\nprint()\nprint(\"=== 5-mer group stats ===\")\nfives = [(-74.85,\"RKDLQ\"),(-71.87,\"KFERQ\"),(-67.02,\"HAMNG\"),(-65.24,\"RKELQ\"),(-64.17,\"KILDQ\"),(-61.38,\"QRKEL\")]\navg5 = sum(x[0] for x in fives)/len(fives)\nprint(f\"5-mer mean: {avg5:.2f}, range: {min(x[0] for x in fives):.2f} to {max(x[0] for x in fives):.2f}, spread: {max(x[0] for x in fives)-min(x[0] for x in fives):.2f}\")\nprint(f\"5-mer per-res mean: {avg5/5:.2f}\")\n\ntens = [(-97.21,\"RKELQRKELQ\"),(-77.17,\"RKDLQRKDDQ\"),(-75.51,\"QRKELQRKEL\")]\navg10 = sum(x[0] for x in tens)/len(tens)\nprint(f\"10-mer mean: {avg10:.2f}, per-res: {avg10/10:.2f}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-05T12:25:43.127440Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\ndef read_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\ndef get_contacts(atoms, cutoff=5.0):\n    rec = [a for a in atoms if a[\"chain\"]==\"A\"]\n    pep = [a for a in atoms if a[\"chain\"]==\"B\"]\n    contacts = {}\n    for ra in rec:\n        for pa in pep:\n            d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n            if d <= cutoff:\n                key = (ra[\"resn\"], ra[\"resi\"], pa[\"resn\"], pa[\"resi\"])\n                if key not in contacts or d < contacts[key]:\n                    contacts[key] = d\n    return contacts\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/analysis/6mer_stage1\"\nparent = read_pdb(f\"{base}/cluster_1_model_1.pdb\")\nn_ala = read_pdb(f\"{base}/cluster_2_model_1.pdb\")\nc_ala = read_pdb(f\"{base}/KFERQpA_C_clt3.pdb\")\n\ncp = get_contacts(parent)\ncn = get_contacts(n_ala)\ncc = get_contacts(c_ala)\n\n# Receptor residues contacted\nrp = set((k[0],k[1]) for k in cp)\nrn = set((k[0],k[1]) for k in cn)\nrc = set((k[0],k[1]) for k in cc)\n\nprint(f\"Receptor contacts: parent={len(rp)}, N-ALA={len(rn)}, C-ALA={len(rc)}\")\nprint(f\"Parent \u2229 N-ALA: {len(rp & rn)} ({len(rp & rn)/len(rp)*100:.0f}%)\")\nprint(f\"Parent \u2229 C-ALA: {len(rp & rc)} ({len(rp & rc)/len(rp)*100:.0f}%)\")\nprint(f\"N-ALA \u2229 C-ALA: {len(rn & rc)} ({len(rn & rc)/len(rn)*100:.0f}%)\")\n\n# Shared contacts\nshared_pn = rp & rn\nshared_pc = rp & rc\n\n# Core KFERQ residues (647-651 in both)\nprint(\"\\n=== Per-residue contact count (KFERQ core 647-651 only) ===\")\nfor label, cdata in [(\"parent\", cp), (\"N-ALA\", cn), (\"C-ALA\", cc)]:\n    counts = {}\n    for (rrn,rri,prn,pri), d in cdata.items():\n        if pri <= 651:\n            counts[pri] = counts.get(pri, 0) + 1\n    res_str = \"  \".join(f\"K{pri-646}\" if pri<=651 else f\"res{pri}\" for pri in sorted(counts))\n    cnt_str = \"  \".join(f\"{counts[pri]:3d}\" for pri in sorted(counts))\n    print(f\"  {label:8s}: {res_str}\")\n    print(f\"           {cnt_str}\")\n\n# Check: did N-ALA's core shift deeper?\n# Compare CA positions of core residues\nprint(\"\\n=== Core KFERQ CA positions and displacement ===\")\ndef pep_cas(atoms):\n    return {a[\"resi\"]: a for a in atoms if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"}\n\ncas_p = pep_cas(parent)\ncas_n = pep_cas(n_ala)\ncas_c = pep_cas(c_ala)\n\nfor resi in [647, 648, 649, 650, 651]:\n    cp_a = cas_p.get(resi)\n    cn_a = cas_n.get(resi)\n    cc_a = cas_c.get(resi)\n    if cp_a and cn_a:\n        dn = math.sqrt((cp_a[\"x\"]-cn_a[\"x\"])**2+(cp_a[\"y\"]-cn_a[\"y\"])**2+(cp_a[\"z\"]-cn_a[\"z\"])**2)\n        dc = math.sqrt((cp_a[\"x\"]-cc_a[\"x\"])**2+(cp_a[\"y\"]-cc_a[\"y\"])**2+(cp_a[\"z\"]-cc_a[\"z\"])**2)\n        rn = next((a[\"resn\"] for a in n_ala if a[\"chain\"]==\"B\" and a[\"resi\"]==resi), \"?\")\n        print(f\"  {rn}{resi}: parent\u2192N-ALA \u0394={dn:.1f}A   parent\u2192C-ALA \u0394={dc:.1f}A\")\n\n# Which receptor residues are NEW in N-ALA (not in parent)?\nprint(\"\\n=== N-ALA contacts NOT in parent ===\")\nnew_n = rn - rp\nfor rn_name, ri in sorted(new_n):\n    entries = [(k[2],k[3],cn[k]) for k in cn if k[0]==rn_name and k[1]==ri]\n    s = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(entries, key=lambda x: x[2]))\n    print(f\"  {rn_name}{ri}: {s}\")\n\n# Which parent contacts are LOST in N-ALA?\nprint(\"\\n=== Parent contacts LOST in N-ALA ===\")\nlost_n = rp - rn\nfor rn_name, ri in sorted(lost_n):\n    entries = [(k[2],k[3],cp[k]) for k in cp if k[0]==rn_name and k[1]==ri]\n    s = \", \".join(f\"{pn}{pi}({d:.1f})\" for pn,pi,d in sorted(entries, key=lambda x: x[2]))\n    print(f\"  {rn_name}{ri}: {s}\")\n\n# N-terminal ALA (resi 646) contacts\nprint(\"\\n=== N-terminal ALA (resi 646) contacts ===\")\nala_n = [(k[0],k[1],k[3],cn[k]) for k in cn if k[2]==\"ALA\" and k[3]==646]\nfor rn, ri, pn, d in sorted(ala_n, key=lambda x: x[3]):\n    print(f\"  {rn}{ri} -> {pn}: {d:.1f}A\")\n\nPYEOF"}

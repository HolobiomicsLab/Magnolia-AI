{"event_type":"tool_call","timestamp":"2026-07-01T08:08:00.362701Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re, glob\n\ndef get_best_cluster(run_dir):\n    \"\"\"Get best cluster info from clustfcc + capri_ss\"\"\"\n    # Cluster sizes\n    clf = f\"{run_dir}/output/10_clustfcc/clustfcc.txt\"\n    if not os.path.exists(clf):\n        return None\n    sizes = {}\n    rankings = {}\n    with open(clf) as f:\n        for line in f:\n            m = re.search(r'Cluster (\\d+) \\(#(\\d+), n=(\\d+), top4_avg_score = ([-\\d.]+)', line)\n            if m:\n                cl_id = int(m.group(1)); rank = int(m.group(2)); n = int(m.group(3)); avg = float(m.group(4))\n                sizes[cl_id] = n\n                rankings[rank] = (cl_id, n, avg)\n    \n    total_clusters = len(sizes)\n    \n    # Capri_ss - best model per cluster\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{run_dir}/output/{sfx}/capri_ss.tsv\"\n        if not os.path.exists(ss): continue\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','')\n            if not cid.isdigit(): continue\n            cid = int(cid)\n            score = float(row['score']); air = float(row.get('air',0))\n            af = score - 0.1*air\n            if cid not in clusters or af < clusters[cid]['af']:\n                clusters[cid] = {\n                    'af': af, 'score': score, 'dq': float(row.get('dockq',0)),\n                    'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n                    'bsa': float(row.get('bsa',0)), 'irmsd': float(row.get('irmsd',0)),\n                    'lrmsd': float(row.get('lrmsd',0)), 'fnat': float(row.get('fnat',0)),\n                }\n        # Return rank-1 cluster + best AIR-free cluster\n        r1_cl = rankings.get(1, (1,0,0))[0]\n        return clusters, sizes, rankings, total_clusters, r1_cl\n    return None\n\n# All missing runs\nmissing_runs = [\n    # Position-3 scan\n    (\"RKVLQ\", \"RKALQ A3\u2192V\", \"projects/hsc70_new/runs/2026-06-18_RKVLQ_s5000\"),\n    (\"RKILQ\", \"RKALQ A3\u2192I\", \"projects/hsc70_new/runs/2026-06-18_RKILQ_s5000\"),\n    (\"RKLLQ\", \"RKALQ A3\u2192L\", \"projects/hsc70_new/runs/2026-06-18_RKLLQ_s5000\"),\n    (\"TAFMALQ\", \"TGFMALQ G2\u2192A\", \"projects/hsc70_new/runs/2026-06-18_TAFMALQ_s10000\"),\n    # T1\u2192E parents\n    (\"TGGFQMALT\", \"Torielli 9-mer\", \"projects/hsc70_new/runs/2026-06-16_af3_TGGFQMALT_s10000_full\"),\n    (\"EGGFQMALT\", \"T1\u2192E (G1\u2192E)\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\"),\n    (\"EAGFQMALT\", \"T1\u2192E + A3\u2192A\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\"),\n]\n\nprint(f\"{'Peptide':<14s} {'Design':>16s} {'Cl':>3s} {'n':>5s} {'AF':>9s} {'DockQ':>7s} {'vdw':>8s} {'elec':>8s} {'bsa':>5s} {'irmsd':>6s} {'#cl':>4s}\")\nprint(\"-\" * 100)\n\nfor label, design, d in missing_runs:\n    result = get_best_cluster(d)\n    if result is None:\n        print(f\"{label:<14s} {design:>16s}  \u2014 not found / no clustfcc\")\n        continue\n    clusters, sizes, rankings, total_cl, r1_cl = result\n    \n    # Show rank-1 cluster\n    if r1_cl in clusters:\n        c = clusters[r1_cl]\n        n = sizes.get(r1_cl, '?')\n        print(f\"{label:<14s} {design:>16s} {r1_cl:>3d} {str(n):>5s} {c['af']:>+9.2f} {c['dq']:>7.3f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['bsa']:>5.0f} {c['irmsd']:>6.2f} {total_cl:>4d}\")\n    \n    # Also show best AIR-free cluster if different\n    if clusters:\n        best_af_cl = min(clusters.keys(), key=lambda x: clusters[x]['af'])\n        if best_af_cl != r1_cl:\n            c = clusters[best_af_cl]\n            n = sizes.get(best_af_cl, '?')\n            print(f\"{'  (best AF)':>31s} {best_af_cl:>3d} {str(n):>5s} {c['af']:>+9.2f} {c['dq']:>7.3f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['bsa']:>5.0f} {c['irmsd']:>6.2f}\")\n\n# Also KFERQx2 s20000\nprint()\nd = \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\"\nresult = get_best_cluster(d)\nif result:\n    clusters, sizes, rankings, total_cl, r1_cl = result\n    for cid in sorted(clusters.keys()):\n        c = clusters[cid]\n        n = sizes.get(cid, '?')\n        print(f\"KFERQx2 s20k   cl{cid:>1d}        {str(n):>5s} {c['af']:>+9.2f} {c['dq']:>7.3f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['bsa']:>5.0f} {c['irmsd']:>6.2f} {total_cl:>4d}\")\nPYEOF"}

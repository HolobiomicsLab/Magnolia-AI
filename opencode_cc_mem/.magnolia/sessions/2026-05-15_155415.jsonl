{"event_type":"tool_success","timestamp":"2026-06-03T11:13:49.877511Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":700,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-03T11:18:47.722427Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/raw_input/peptides/5mers && python3 << 'PYEOF'\nimport math\n\ndef read_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                atoms.append((name, resn, chain, resi, x, y, z))\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1[4]-a2[4])**2 + (a1[5]-a2[5])**2 + (a1[6]-a2[6])**2)\n\ndef angle(a, b, c):\n    \"\"\"Bond angle at b, a-b-c in degrees\"\"\"\n    ba = (a[4]-b[4], a[5]-b[5], a[6]-b[6])\n    bc = (c[4]-b[4], c[5]-b[5], c[6]-b[6])\n    dot = ba[0]*bc[0] + ba[1]*bc[1] + ba[2]*bc[2]\n    mag = math.sqrt(ba[0]**2+ba[1]**2+ba[2]**2) * math.sqrt(bc[0]**2+bc[1]**2+bc[2]**2)\n    return math.degrees(math.acos(max(-1, min(1, dot/mag))))\n\ndef dihedral(a, b, c, d):\n    \"\"\"Dihedral angle a-b-c-d in degrees\"\"\"\n    ba = (a[4]-b[4], a[5]-b[5], a[6]-b[6])\n    bc = (c[4]-b[4], c[5]-b[5], c[6]-b[6])\n    cd = (d[4]-c[4], d[5]-c[5], d[6]-c[6])\n    # cross products\n    n1 = (ba[1]*bc[2] - ba[2]*bc[1], ba[2]*bc[0] - ba[0]*bc[2], ba[0]*bc[1] - ba[1]*bc[0])\n    n2 = (bc[1]*cd[2] - bc[2]*cd[1], bc[2]*cd[0] - bc[0]*cd[2], bc[0]*cd[1] - bc[1]*cd[0])\n    m1 = math.sqrt(n1[0]**2+n1[1]**2+n1[2]**2)\n    m2 = math.sqrt(n2[0]**2+n2[1]**2+n2[2]**2)\n    dot = n1[0]*n2[0] + n1[1]*n2[1] + n1[2]*n2[2]\n    return math.degrees(math.acos(max(-1, min(1, dot/(m1*m2)))))\n\ndef get_by_name(atoms, resi, name):\n    return [a for a in atoms if a[3]==resi and a[0]==name]\n\nprint('=== KFERQ (reference) ===')\natoms = read_pdb('KFERQ.pdb')\n# peptide bond: CA(i)-C(i)-N(i+1)-CA(i+1) dihedral (omega)\nfor i in [647, 648, 649, 650]:\n    ca1 = get_by_name(atoms, i, 'CA')[0]\n    c1 = get_by_name(atoms, i, 'C')[0]\n    n2 = get_by_name(atoms, i+1, 'N')[0]\n    ca2 = get_by_name(atoms, i+1, 'CA')[0]\n    omega = dihedral(ca1, c1, n2, ca2)\n    flag = ' <-- CIS!' if abs(omega) < 150 else ''\n    print(f'  {i}-{i+1} peptide bond: omega = {omega:.1f}\u00b0{flag}')\n\n# CA-CA distances\nfor i in [647, 648, 649, 650]:\n    ca1 = get_by_name(atoms, i, 'CA')[0]\n    ca2 = get_by_name(atoms, i+1, 'CA')[0]\n    print(f'  CA{i}-CA{i+1} = {dist(ca1, ca2):.2f} \u00c5')\n\nprint()\nfor pep in ['KFQRQ', 'KFQKQ']:\n    print(f'=== {pep} ===')\n    atoms = read_pdb(f'{pep}.pdb')\n    for i in [647, 648, 649, 650]:\n        ca1 = get_by_name(atoms, i, 'CA')[0]\n        c1 = get_by_name(atoms, i, 'C')[0]\n        n2 = get_by_name(atoms, i+1, 'N')[0]\n        ca2 = get_by_name(atoms, i+1, 'CA')[0]\n        omega = dihedral(ca1, c1, n2, ca2)\n        flag = ' <-- CIS!' if abs(omega) < 150 else ''\n        print(f'  {i}-{i+1} peptide bond: omega = {omega:.1f}\u00b0{flag}')\n    for i in [647, 648, 649, 650]:\n        ca1 = get_by_name(atoms, i, 'CA')[0]\n        ca2 = get_by_name(atoms, i+1, 'CA')[0]\n        print(f'  CA{i}-CA{i+1} = {dist(ca1, ca2):.2f} \u00c5')\n    print()\nPYEOF\n"}
{"event_type":"tool_success","timestamp":"2026-06-03T11:18:48.355189Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":645,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-03T11:19:27.083418Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\n\ndef read_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                name = line[12:16].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                if chain == 'B':\n                    atoms.append((name, resi, x, y, z))\n    return atoms\n\ndef dihedral(a1, a2, a3, a4):\n    ba = (a1[0]-a2[0], a1[1]-a2[1], a1[2]-a2[2])\n    bc = (a3[0]-a2[0], a3[1]-a2[1], a3[2]-a2[2])\n    cd = (a4[0]-a3[0], a4[1]-a3[1], a4[2]-a3[2])\n    n1 = (ba[1]*bc[2]-ba[2]*bc[1], ba[2]*bc[0]-ba[0]*bc[2], ba[0]*bc[1]-ba[1]*bc[0])\n    n2 = (bc[1]*cd[2]-bc[2]*cd[1], bc[2]*cd[0]-bc[0]*cd[2], bc[0]*cd[1]-bc[1]*cd[0])\n    m1 = math.sqrt(n1[0]**2+n1[1]**2+n1[2]**2)\n    m2 = math.sqrt(n2[0]**2+n2[1]**2+n2[2]**2)\n    dot = n1[0]*n2[0]+n1[1]*n2[1]+n1[2]*n2[2]\n    return math.degrees(math.acos(max(-1, min(1, dot/(m1*m2)))))\n\nfor m in ['cluster_1_model_1.pdb.gz', 'cluster_1_model_2.pdb.gz']:\n    atoms = read_pdb(m)\n    print(f'{m}:')\n    for resi in [647, 648, 649, 650]:\n        ca = next(a for a in atoms if a[0]=='CA' and a[1]==resi)\n        c  = next(a for a in atoms if a[0]=='C'  and a[1]==resi)\n        n2 = next(a for a in atoms if a[0]=='N'  and a[1]==resi+1)\n        ca2= next(a for a in atoms if a[0]=='CA' and a[1]==resi+1)\n        omega = dihedral(ca[2:], c[2:], n2[2:], ca2[2:])\n        print(f'  {resi}-{resi+1}: omega = {omega:.1f}\u00b0')\nPYEOF\n"}

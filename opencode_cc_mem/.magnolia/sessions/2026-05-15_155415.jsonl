{"event_type":"tool_call","timestamp":"2026-06-15T08:33:36.418227Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, re\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\ndef parse_capri(path):\n    \"\"\"Parse capri_clt.tsv, skip comments, return list of (cluster_id, score, air, dockq)\"\"\"\n    results = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('#'):\n                continue\n            if line.startswith('cluster_rank'):\n                continue\n            cols = line.strip().split('\\t')\n            if len(cols) >= 18:\n                try:\n                    cid = cols[1]\n                    score = float(cols[4])\n                    air = float(cols[17])\n                    dockq = float(cols[15]) if cols[15] != '-' else None\n                    results.append((cid, score, air, dockq))\n                except:\n                    pass\n    return results\n\n# Collect from the FINAL caprieval (step 12 or highest numbered output)\nfor d in sorted(os.listdir(base)):\n    rp = os.path.join(base, d)\n    if not os.path.isdir(rp): continue\n    outdir = os.path.join(rp, \"output\")\n    if not os.path.isdir(outdir): continue\n    \n    # Find highest numbered caprieval\n    best_file = None\n    best_num = -1\n    for sub in os.listdir(outdir):\n        m = re.match(r'(\\d+)_caprieval', sub)\n        if m:\n            num = int(m.group(1))\n            fpath = os.path.join(outdir, sub, \"capri_clt.tsv\")\n            if os.path.exists(fpath) and num > best_num:\n                best_num = num\n                best_file = fpath\n    \n    if best_file:\n        res = parse_capri(best_file)\n        if res:\n            cid, score, air, dockq = res[0]\n            cat = \"p2rank\" if (\"p2rank1\" in d) else (\"SBD\" if \"SBD\" in d else \"manual\")\n            air_free = score - 0.1 * air\n            print(f\"{d:55s} | {cat:7s} | score={score:8.2f} | air={air:8.1f} | AIR-free={air_free:8.2f} | DockQ={dockq}\")\nPYEOF"}

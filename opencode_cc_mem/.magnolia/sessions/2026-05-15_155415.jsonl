{"event_type":"tool_call","timestamp":"2026-06-10T13:50:05.821252Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport json\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\ndef best_pose(sdf_path):\n    try:\n        with open(sdf_path) as f:\n            content = f.read()\n    except:\n        return None\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        cnn_score = cnn_aff = emp_aff = 0; na = 0\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n            if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, cnn_score, cnn_aff)\n    return best\n\nligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Z11-16-OH', 'C8-Ald', 'C12-Ald', \n           'Cedrol', '\u03b2-Ionone', 'Citral', 'Palmitic_acid']\n\nprint(f\"{'Ligand':16s} {'IC50':>7s} {'Rigid':>7s} {'Flex5':>7s} {'Flex8':>7s}\")\nprint(\"-\" * 50)\n\nfor lig in ligands:\n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 'N/A')\n    \n    rigid_r = best_pose(f'docked_{lig}_asn90.sdf')\n    flex5_r = best_pose(f'docked_flex5_{lig}_asn90.sdf')\n    flex8_r = best_pose(f'docked_flex8_{lig}_asn90.sdf')\n    \n    r_aff = rigid_r[0] if rigid_r else None\n    f5_aff = flex5_r[0] if flex5_r else None\n    f8_aff = flex8_r[0] if flex8_r else None\n    \n    r_str = f'{r_aff:.1f}' if r_aff else 'N/A'\n    f5_str = f'{f5_aff:.1f}' if f5_aff else 'N/A'\n    f8_str = f'{f8_aff:.1f}' if f8_aff else 'N/A'\n    print(f\"{lig:16s} {str(ic50):>7s} {r_str:>7s} {f5_str:>7s} {f8_str:>7s}\")\n\nPYEOF"}

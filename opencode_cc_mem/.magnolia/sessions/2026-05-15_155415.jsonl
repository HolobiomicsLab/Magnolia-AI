{"event_type":"tool_call","timestamp":"2026-06-17T12:11:48.137135Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c source ~/anaconda3/etc/profile.d/conda.sh && conda activate ambertools && export AMBERHOME=~/anaconda3/envs/ambertools\n\nPDIR=/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-17_mmgbsa_analysis/TGGFQMALT_9mer\ncd \"$PDIR\"\n\n# Remove ACE residue from peptide\nawk 'substr($0,22,1)==\"A\" && /^ATOM/' cluster_1_model_1.pdb > receptor_raw.pdb\nawk 'substr($0,22,1)==\"B\" && /^ATOM/ && substr($0,18,3)!=\"ACE' cluster_1_model_1.pdb > peptide_raw.pdb\n\n# Strip H, fix terminals, renumber\npython3 -c \"\nimport re\nTERMINAL = {'N','C'}\nAAS = {'LYS','ARG','PHE','ASP','ILE','LEU','MET','ALA','ASN','GLY','THR','VAL','GLU','GLN','TRP','SER','CYS','HIS','PRO','TYR'}\ndef clean(infile, outfile):\n    out = []\n    for line in open(infile):\n        if not line.startswith('ATOM'): continue\n        elem = line[76:78].strip()\n        name = line[12:16].strip()\n        if elem == 'H' or re.match(r'^H[A-Z0-9]?\\$', name) or re.match(r'^[0-9]H', name): continue\n        rn = line[17:20].strip()\n        if len(rn)==4 and rn[0] in TERMINAL and rn[1:] in AAS: rn = rn[1:]\n        if rn == 'HIE': rn = 'HIS'\n        line = line[:17] + rn.ljust(3) + line[20:]\n        out.append(line)\n    open(outfile,'w').writelines(out)\nclean('receptor_raw.pdb','receptor.pdb')\nclean('peptide_raw.pdb','peptide_noH.pdb')\n# Renumber peptide\nlines = open('peptide_noH.pdb').readlines()\nout = []; prev=None; r=0\nfor line in lines:\n    if len(line)>=26:\n        rn = int(line[22:26])\n        if rn!=prev: r+=1; prev=rn\n        line = line[:22]+str(r).rjust(4)+line[26:]\n    out.append(line)\nopen('peptide.pdb','w').writelines(out)\nprint('peptide res:', r)\n\"\n\ncat > tleap.in << 'EOF'\nsource leaprc.protein.ff14SB\nrec = loadpdb receptor.pdb\nlig = loadpdb peptide.pdb\ncomplex = combine {rec lig}\nsaveamberparm complex complex.prmtop complex.rst7\nsaveamberparm rec receptor.prmtop receptor.rst7\nsaveamberparm lig ligand.prmtop ligand.rst7\nquit\nEOF\ntleap -f tleap.in > tleap.log 2>&1 && echo \"tleap OK\" || { echo \"TLEAP FAILED\"; grep -i fatal tleap.log | head -3; }\n\n# Get residue counts\npython3 -c \"\ndef read_flag(fn, flag):\n    data=[]; inf=False\n    for line in open(fn):\n        if '%FLAG' in line:\n            if flag in line: inf=True; continue\n            elif inf: break\n            else: inf=False\n        elif inf and '%FORMAT' in line: continue\n        elif inf: data.extend(line.split())\n    return data\np = read_flag('complex.prmtop','POINTERS')\nrl = read_flag('receptor.prmtop','RESIDUE_LABEL')\nll = read_flag('ligand.prmtop','RESIDUE_LABEL')\nprint(f'rec={len(rl)} lig={len(ll)} last={len(rl)+len(ll)}')\n\" && echo \"prmtop OK\"\n\n# Create mdin, mdcrd, run sander\npython3 -c \"\ndef read_flag(fn, flag):\n    data=[]; inf=False\n    for line in open(fn):\n        if '%FLAG' in line:\n            if flag in line: inf=True; continue\n            elif inf: break\n            else: inf=False\n        elif inf and '%FORMAT' in line: continue\n        elif inf: data.extend(line.split())\n    return data\nrl = read_flag('receptor.prmtop','RESIDUE_LABEL')\nll = read_flag('ligand.prmtop','RESIDUE_LABEL')\nnres_rec = len(rl)\nnres_lig = len(ll)\nlast = nres_rec + nres_lig\nres_list = ' '.join(str(r) for r in range(nres_rec+1, last+1))\nmdin = f'''Per-residue energy decomposition\n &cntrl\n  ntb=0, nsnb=99999, cut=999.0, imin=5,\n  ncyc=0, igb=5, saltcon=0.15, gbsa=2,\n  surften=0.0072, extdiel=80.0,\n  idecomp=2,\n /\nResidues considered as REC\nRRES 1 {nres_rec}\nEND\nResidues considered as LIG\nLRES {nres_rec+1} {last}\nEND\nResidues to print\n'''\nfor r in range(nres_rec+1, last+1):\n    mdin += f'RES {r} {r}\\n'\nmdin += 'END\\nEND\\n'\nopen('sander_decomp.mdin','w').write(mdin)\nprint(f'mdin: rec=1-{nres_rec}, lig={nres_rec+1}-{last}')\n\"\n\necho 'trajin complex.rst7\ntrajout complex.mdcrd\ngo' | cpptraj complex.prmtop > /dev/null 2>&1\n\nsander -O -i sander_decomp.mdin -o sander_decomp.out -r restrt -c complex.rst7 -y complex.mdcrd -p complex.prmtop > /dev/null 2>&1\n\ngrep -c \"PRINT DECOMP\" sander_decomp.out 2>/dev/null && echo \"TGGFQMALT: SUCCESS\" || echo \"TGGFQMALT: FAILED\""}

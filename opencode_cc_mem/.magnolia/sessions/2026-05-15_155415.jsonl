{"event_type":"tool_call","timestamp":"2026-06-09T09:48:12.140374Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\nRD = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH'\n\ndef parse_log(path):\n    with open(f'{RD}/{path}') as f: text = f.read()\n    blocks = text.split('mode |  affinity')\n    dock = []\n    for block in blocks[1:]:\n        for line in block.strip().split('\\n'):\n            m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n            if m: dock.append(float(m.group(2))); break\n    return dock\n\ndock_trs = parse_log('gnina_dock_v3.out')\ndock_p2r = parse_log('gnina_p2rank_box.out')\n\nwith open(f'{RD}/compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\npairs_trs, pairs_p2r = [], []\nfor i, fn in enumerate(sdf_names_sorted):\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    if i < len(dock_trs): pairs_trs.append((name, kd, dock_trs[i]))\n    if i < len(dock_p2r): pairs_p2r.append((name, kd, dock_p2r[i]))\n\nkd_trs = np.array([p[1] for p in pairs_trs])\naff_trs = np.array([p[2] for p in pairs_trs])\nkd_p2r = np.array([p[1] for p in pairs_p2r])\naff_p2r = np.array([p[2] for p in pairs_p2r])\n\nprint(\"\u2550\u2550\u2550 COMPARISON \u2550\u2550\u2550\")\nrho_t, p_t = spearmanr(aff_trs, kd_trs)\nrho_p, p_p = spearmanr(aff_p2r, kd_p2r)\nprint(f\"TRS box:     \u03c1={rho_t:+.4f}  p={p_t:.4f}  range [{aff_trs.min():+.1f}, {aff_trs.max():+.1f}]\")\nprint(f\"P2Rank box:  \u03c1={rho_p:+.4f}  p={p_p:.4f}  range [{aff_p2r.min():+.1f}, {aff_p2r.max():+.1f}]\")\nprint(f\"  Clashes (aff > 0): TRS={(aff_trs>0).sum()}/40  P2R={(aff_p2r>0).sum()}/40\")\n\n# Filtered (remove clashes)\nmask = aff_p2r < 0\nrho_pf, p_pf = spearmanr(aff_p2r[mask], kd_p2r[mask])\nprint(f\"\\n  P2Rank filtered (no clashes, n={mask.sum()}): \u03c1={rho_pf:+.4f}  p={p_pf:.4f}\")\n\n# By class\nfor label, affs in [(\"TRS box\", aff_trs), (\"P2Rank box\", aff_p2r)]:\n    g = [affs[i] for i in range(len(affs)) if pairs_trs[i][1] < 1.0]\n    m = [affs[i] for i in range(len(affs)) if 1.0 <= pairs_trs[i][1] < 10]\n    w = [affs[i] for i in range(len(affs)) if pairs_trs[i][1] >= 10]\n    print(f\"\\n  {label}:\")\n    print(f\"    STRONG:    {np.mean(g):+.2f} \u00b1 {np.std(g):.2f}\")\n    print(f\"    MODERATE:  {np.mean(m):+.2f} \u00b1 {np.std(m):.2f}\")\n    print(f\"    WEAK/NON:  {np.mean(w):+.2f} \u00b1 {np.std(w):.2f}\")\nPYEOF"}

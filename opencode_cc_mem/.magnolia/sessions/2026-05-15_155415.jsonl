{"event_type":"tool_call","timestamp":"2026-06-05T12:28:00.393076Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\ndef read_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resi\": int(line[22:26]), \"chain\": line[21],\n                })\n    return atoms\n\n# Check experimental-site KFERQ run\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\nexp_kferq = read_pdb(f\"{base}/2026-06-01_KFERQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\np2_kferq = read_pdb(f\"{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\n\nfor label, atoms in [(\"Exp-site KFERQ\", exp_kferq), (\"P2Rank KFERQ\", p2_kferq)]:\n    pep = [a for a in atoms if a[\"chain\"]==\"B\"]\n    rec_near = set()\n    for pa in pep:\n        for ra in [a for a in atoms if a[\"chain\"]==\"A\"]:\n            d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n            if d < 10:\n                rec_near.add(ra[\"resi\"])\n    nbd = sorted([r for r in rec_near if r <= 385])\n    sbd = sorted([r for r in rec_near if r >= 386])\n    print(f\"{label}: {len(nbd)} NBD (resi {min(nbd) if nbd else '-'}-{max(nbd) if nbd else '-'}), {len(sbd)} SBD (resi {min(sbd) if sbd else '-'}-{max(sbd) if sbd else '-'})\")\n\n# Check which domain P2Rank pocket 1 targets\np2rank_resis = [10,12,14,15,37,56,175,199,201,202,230,231,234,268,271,272,275,338,339,340,342,343,365,366,369]\nin_nbd = [r for r in p2rank_resis if r <= 385]\nin_sbd = [r for r in p2rank_resis if r >= 386]\nprint(f\"\\nP2Rank pocket 1 residues: {len(in_nbd)} in NBD, {len(in_sbd)} in SBD\")\nprint(f\"All P2Rank residues are NBD (max={max(p2rank_resis)})\")\n\n# Check experimental-site residues\nexp_resis = list(range(531, 616))\nprint(f\"Experimental-site residues: {len(exp_resis)} in SBD (531-615)\")\nPYEOF"}

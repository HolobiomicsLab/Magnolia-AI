{"event_type":"tool_call","timestamp":"2026-06-09T12:48:06.885152Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip, sys\n\nASN_ND2 = (37.7, -29.2, 0.5)\n\nwith gzip.open('docked_asn90_box.sdf.gz', 'rt') as f:\n    mols = f.read().strip().split('$$$$\\n')\n\nprint(\"\u2550\u2550\u2550 Z11-16:Ald \u2014 Asn90-centered box, 6 flex residues \u2550\u2550\u2550\")\nfor pose_i in range(min(10, len(mols))):\n    mol = mols[pose_i].strip()\n    if not mol: continue\n    lines = mol.split('\\n')\n    try: natoms = int(lines[3][:3].strip())\n    except: continue\n    \n    min_ond2 = 999\n    for j in range(4, 4 + natoms):\n        l = lines[j]\n        if len(l) < 34: continue\n        elem = l[31:34].strip()\n        if elem == 'O':\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            d = ((x-ASN_ND2[0])**2 + (y-ASN_ND2[1])**2 + (z-ASN_ND2[2])**2)**0.5\n            if d < min_ond2: min_ond2 = d\n    \n    hbond = \" \u2713 H-BOND!\" if min_ond2 < 3.5 else (\" ~ close\" if min_ond2 < 5 else \"\")\n    print(f\"  Pose {pose_i+1:2d}: O\u2192ND2 = {min_ond2:.1f} \u00c5{hbond}\")\n\n# Also check scores\nwith open('gnina_Asn90_box.out') as f:\n    for line in f:\n        if line.strip().startswith('1 ') and not 'mode' in line:\n            print(f\"\\n\u2550\u2550\u2550 Top pose score \u2550\u2550\u2550\\n{line.strip()}\")\n            break\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-11T13:44:59.825522Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport numpy as np\n\ndef get_backbone(pdb_file, chain, res_range):\n    \"\"\"Extract N, CA, C atoms for given chain and residue range.\"\"\"\n    atoms = []\n    with open(pdb_file) as f:\n        for line in f:\n            if not line.startswith('ATOM'):\n                continue\n            ch = line[21]\n            if ch != chain:\n                continue\n            rnum = int(line[22:26])\n            if rnum < res_range[0] or rnum > res_range[1]:\n                continue\n            aname = line[12:16].strip()\n            if aname in ('N', 'CA', 'C'):\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms.append({'res': rnum, 'atom': aname, 'xyz': np.array([x, y, z])})\n    return atoms\n\ndef kabsch_rmsd(P, Q):\n    \"\"\"Compute RMSD after optimal superposition of Q onto P.\"\"\"\n    P_cent = P.mean(axis=0)\n    Q_cent = Q.mean(axis=0)\n    P_c = P - P_cent\n    Q_c = Q - Q_cent\n    C = P_c.T @ Q_c\n    V, _, Wt = np.linalg.svd(C)\n    R = Wt.T @ V.T\n    Q_rot = Q_c @ R.T\n    diff = P_c - Q_rot\n    return np.sqrt((diff * diff).sum() / len(P)), R, P_cent, Q_cent\n\nfiles = {\n    'ApKFERQ': '/tmp/contact_analysis/ApKFERQ_cl1_m1.pdb',\n    'N-LYS': '/tmp/contact_analysis/N-LYS_cl1_m1.pdb',\n    'N-GLY': '/tmp/contact_analysis/N-GLY_cl1_m1.pdb',\n}\n\n# Extract receptor backbone (chain A, all residues) and peptide backbone (chain B, 646-651)\ndata = {}\nfor name, path in files.items():\n    rec_bb = get_backbone(path, 'A', (1, 9999))\n    pep_bb = get_backbone(path, 'B', (646, 651))\n    data[name] = {'rec': np.array([a['xyz'] for a in rec_bb]), \n                  'pep': np.array([a['xyz'] for a in pep_bb]),\n                  'pep_atoms': pep_bb}\n\nprint(\"=== Receptor backbone RMSD (A chain, all residues) ===\")\nnames = list(data.keys())\nfor i in range(len(names)):\n    for j in range(i+1, len(names)):\n        rmsd, _, _, _ = kabsch_rmsd(data[names[i]]['rec'], data[names[j]]['rec'])\n        print(f\"  {names[i]} vs {names[j]}: {rmsd:.3f} \u00c5\")\n\nprint(\"\\n=== Peptide backbone RMSD (chain B, residues 646-651, N/CA/C only) ===\")\nfor i in range(len(names)):\n    for j in range(i+1, len(names)):\n        rmsd, _, _, _ = kabsch_rmsd(data[names[i]]['pep'], data[names[j]]['pep'])\n        print(f\"  {names[i]} vs {names[j]}: {rmsd:.3f} \u00c5\")\n\n# Also compute: if we align on receptor, what's the peptide RMSD?\nprint(\"\\n=== Peptide RMSD after receptor alignment ===\")\nref = data['ApKFERQ']\nfor name in ['N-LYS', 'N-GLY']:\n    # Align receptor of 'name' onto 'ApKFERQ'\n    rmsd_rec, R, rec_c_ref, rec_c_target = kabsch_rmsd(ref['rec'], data[name]['rec'])\n    # Apply same rotation to peptide\n    pep_target = data[name]['pep'] - rec_c_target\n    pep_rot = pep_target @ R.T\n    pep_aligned = pep_rot + rec_c_ref\n    diff = ref['pep'] - pep_aligned\n    rmsd_pep = np.sqrt((diff * diff).sum() / len(ref['pep']))\n    print(f\"  ApKFERQ vs {name}: receptor RMSD={rmsd_rec:.3f} \u00c5, peptide RMSD={rmsd_pep:.3f} \u00c5\")\n\nprint(\"\\n=== Per-residue peptide backbone RMSD (after receptor alignment) ===\")\nfor name in ['N-LYS', 'N-GLY']:\n    rmsd_rec, R, rec_c_ref, rec_c_target = kabsch_rmsd(ref['rec'], data[name]['rec'])\n    pep_target = data[name]['pep'] - rec_c_target\n    pep_rot = pep_target @ R.T\n    pep_aligned = pep_rot + rec_c_ref\n    for k, atom_info in enumerate(ref['pep_atoms']):\n        rnum = atom_info['res']\n        aname = atom_info['atom']\n        d = np.linalg.norm(ref['pep'][k] - pep_aligned[k])\n        if aname == 'CA':\n            print(f\"  {name}: CA residue {rnum}: {d:.3f} \u00c5\")\nPYEOF"}

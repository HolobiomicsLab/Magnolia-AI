{"event_type":"tool_call","timestamp":"2026-06-11T10:53:03.395716Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 -c \"\nimport re\n\n# Process N-LYS\nwith open('/tmp/KFERQ_N-LYS.pdb') as f:\n    lines = f.readlines()\n\nout_lines = []\nres_map = {1: 646, 2: 647, 3: 648, 4: 649, 5: 650, 6: 651}\nres_name = {1: 'LYS', 2: 'LYS', 3: 'PHE', 4: 'GLU', 5: 'ARG', 6: 'GLN'}\n\nfor line in lines:\n    if line.startswith('ATOM') or line.startswith('HETATM'):\n        # Strip hydrogens (H, HA, HB, etc. starting with H)\n        atom_name = line[12:16].strip()\n        if atom_name.startswith('H') and not atom_name.startswith('HG'):\n            # Keep HG, skip all other H atoms\n            continue\n        # Also skip the N-terminal H (explicit H on N)\n        if atom_name == 'H':\n            continue\n            \n        res_num = int(line[22:26])\n        if res_num in res_map:\n            new_num = res_map[res_num]\n            new_name = res_name[res_num]\n            # Rebuild line with correct chain 'B' and residue numbering\n            line = line[:17] + f'{new_name}' + line[20:22] + f'{new_num:4d}' + line[26:]\n        out_lines.append(line)\n    elif line.startswith('TER') or line.startswith('END'):\n        out_lines.append(line)\n\nwith open('raw_input/peptides/6mers/KFERQ_N-LYS.pdb', 'w') as f:\n    f.writelines(out_lines)\n\nprint(f'N-LYS: {len([l for l in out_lines if l.startswith(\\\"ATOM\\\")])} atoms')\nprint(f'Residues: {sorted(set(int(l[22:26]) for l in out_lines if l.startswith(\\\"ATOM\\\")))}')\n\n# Process N-GLY\nwith open('/tmp/KFERQ_N-GLY.pdb') as f:\n    lines = f.readlines()\n\nout_lines = []\nres_name = {1: 'GLY', 2: 'LYS', 3: 'PHE', 4: 'GLU', 5: 'ARG', 6: 'GLN'}\n\nfor line in lines:\n    if line.startswith('ATOM') or line.startswith('HETATM'):\n        atom_name = line[12:16].strip()\n        if atom_name.startswith('H') and not atom_name.startswith('HG'):\n            continue\n        if atom_name == 'H':\n            continue\n            \n        res_num = int(line[22:26])\n        if res_num in res_map:\n            new_num = res_map[res_num]\n            new_name = res_name[res_num]\n            line = line[:17] + f'{new_name}' + line[20:22] + f'{new_num:4d}' + line[26:]\n        out_lines.append(line)\n    elif line.startswith('TER') or line.startswith('END'):\n        out_lines.append(line)\n\nwith open('raw_input/peptides/6mers/KFERQ_N-GLY.pdb', 'w') as f:\n    f.writelines(out_lines)\n\nprint(f'N-GLY: {len([l for l in out_lines if l.startswith(\\\"ATOM\\\")])} atoms')\nprint(f'Residues: {sorted(set(int(l[22:26]) for l in out_lines if l.startswith(\\\"ATOM\\\")))}')\n\""}

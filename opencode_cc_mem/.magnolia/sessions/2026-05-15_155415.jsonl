{"event_type":"tool_call","timestamp":"2026-06-09T08:40:45.405580Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re\n\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\nblocks = text.split('mode |  affinity')\ndock_all = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            dock_all.append({'aff': float(m.group(2)), 'cnn_pose': float(m.group(4)), 'cnn_aff': float(m.group(5))})\n            break\n\nPAPER_NOTES = {\n    \"Z9-14-Ald\":\"Good ligand \u2014 fits cavity, H-bond to Asn90.\",\n    \"Z11-16-Ald\":\"Excellent ligand \u2014 fills cavity, H-bond to Asn90. Best aldehyde.\",\n    \"Z11-16-Ac\":\"Does NOT bind \u2014 acetate clashes with cavity.\",\n    \"Z11-16-OH\":\"Weak binder \u2014 alcohol cannot H-bond Asn90.\",\n    \"Z9-16-Ald\":\"Good ligand \u2014 unsaturated aldehyde, H-bond to Asn90.\",\n    \"E2-10-Ald\":\"Moderate binder \u2014 shorter unsaturated aldehyde.\",\n    \"C8-Ald\":\"Does NOT bind at 200 \u00b5M \u2014 too short.\",\n    \"C10-Ald\":\"Does NOT bind at 200 \u00b5M.\",\n    \"C12-Ald\":\"Moderate binder \u2014 borderline size.\",\n    \"C14-Ald\":\"Weak binder \u2014 approaching optimal length.\",\n    \"C16-Ald\":\"Does NOT bind \u2014 saturated C16 paradoxically worse.\",\n    \"C18-Ald\":\"Does NOT bind \u2014 too long.\",\n    \"(-)-Carvone\":\"Moderate binder \u2014 monoterpenoid.\",\n    \"(+)-Carvone\":\"Moderate binder \u2014 enantiomer, slightly better.\",\n    \"Citral\":\"Good ligand \u2014 improves in Ser122Ala mutant.\",\n    \"Safranal\":\"Good ligand \u2014 selective for OBP3 over OBP5.\",\n    \"Citronellal\":\"Moderate binder \u2014 monoterpenoid aldehyde.\",\n    \"Coniferyl aldehyde\":\"Weak binder \u2014 phenylpropanoid.\",\n    \"Eugenol\":\"Weak binder \u2014 weaker in Asn90Leu mutant.\",\n    \"Citralva\":\"Good ligand \u2014 geranyl nitrile.\",\n    \"Linalool\":\"Does NOT bind \u2014 despite being common bamboo terpenoid.\",\n    \"Geraniol\":\"Moderate \u2014 aldehyde>alcohol selectivity.\",\n    \"Phytol\":\"Does NOT bind \u2014 too large for cavity.\",\n    \"\u03b2-Ionone\":\"Excellent \u2014 key bamboo volatile. High affinity.\",\n    \"Geranyl acetate\":\"Excellent \u2014 OBP5 does NOT bind (selective).\",\n    \"3,7-Dimethyloctanol\":\"Moderate \u2014 saturated terpenoid alcohol.\",\n    \"Farnesol\":\"Excellent \u2014 sesquiterpene, abundant in bamboo.\",\n    \"Cedrol\":\"Excellent \u2014 most abundant in SPRING bamboo.\",\n    \"Octanoic acid\":\"No OBP3 binding \u2014 AimelOBP5 ligand.\",\n    \"Decanoic acid\":\"No OBP3 binding \u2014 AimelOBP5 ligand (C16 peak).\",\n    \"Lauric acid\":\"No OBP3 binding \u2014 AimelOBP5 ligand.\",\n    \"Myristic acid\":\"No OBP3 binding \u2014 AimelOBP5 ligand.\",\n    \"Palmitic acid\":\"No OBP3 binding \u2014 peak for OBP5 (C16).\",\n    \"Stearic acid\":\"No OBP3 binding \u2014 weak OBP5 binder.\",\n    \"Z9-16-COOH\":\"Weak OBP3. Good OBP5 ligand.\",\n    \"Z9-14-COOH\":\"Weak OBP3. Moderate OBP5 ligand.\",\n    \"Z11-16-COOH\":\"Weak OBP3. Good OBP5 ligand.\",\n    \"Z13-18-COOH\":\"Weak OBP3. Good OBP5 ligand.\",\n    \"Oleic acid\":\"No OBP3 binding \u2014 good OBP5 (unsaturated).\",\n    \"Linoleic acid\":\"Weak OBP3 \u2014 good OBP5 (polyunsaturated).\",\n}\n\ndata = []\nfor i, c in enumerate(exp_data):\n    if i >= len(dock_all): break\n    kd = c.get('kd_obp3', 999)\n    d = dock_all[i]\n    cls = \"STRONG\" if kd < 1.0 else (\"MOD\" if kd < 10 else (\"WEAK\" if kd < 43 else \"NON\"))\n    data.append((d['cnn_aff'], c['name'], kd, d['aff'], d['cnn_pose'], PAPER_NOTES.get(c['name'],'\u2014'), cls))\n\n# Sort by CNN affinity (higher = better)\ndata.sort(key=lambda x: x[0], reverse=True)\n\nout_lines = []\nout_lines.append(f\"{'Rank':<5s} {'Compound':<24s} {'Kd_exp':>8s} {'EmpAff':>7s} {'CNNpose':>8s} {'CNNaff':>8s}  Paper claims\")\nout_lines.append(\"-\" * 130)\nfor i, (cnn_aff, name, kd, emp_aff, cnn_pose, note, cls) in enumerate(data, 1):\n    out_lines.append(f\"{i:<5d} {name:<24s} {kd:>8.3f} {emp_aff:>+7.2f} {cnn_pose:>8.4f} {cnn_aff:>8.4f}  [{cls}] {note}\")\nout_lines.append(\"-\" * 130)\nout_lines.append(f\"Sorted by CNN affinity (higher = better). Paper: Zhu et al. 2017 PNAS\")\n\ntext = '\\n'.join(out_lines)\nwith open('docking_results_by_cnn_affinity.txt', 'w') as f:\n    f.write(text + '\\n')\n\nfor line in out_lines:\n    print(line)\nPYEOF"}

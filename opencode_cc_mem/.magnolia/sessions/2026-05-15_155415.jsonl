{"event_type":"tool_call","timestamp":"2026-06-22T13:26:57.029319Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\npython3 << 'PYEOF'\nimport numpy as np, gzip\n\ndef parse_pdb(path):\n    atoms = []\n    opener = gzip.open if path.endswith('.gz') else open\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                chain = line[21].strip()\n                resname = line[17:20].strip()\n                resnum = int(line[22:26])\n                atomname = line[12:16].strip()\n                xyz = np.array([float(line[30:38]), float(line[38:46]), float(line[46:54])])\n                el = line[76:78].strip() or atomname[0]\n                if el != 'H' and atomname[0] != 'H':\n                    atoms.append({'chain':chain,'resnum':resnum,'resname':resname,'atom':atomname,'xyz':xyz})\n    return atoms\n\natoms = parse_pdb(\"2026-06-16_af3_RKELQx2_s10000_full/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\nrec = [a for a in atoms if a['chain']=='A']\npep = [a for a in atoms if a['chain']=='B']\n\n# Map 647-656 \u2192 1-10\nresmap = {647:1, 648:2, 649:3, 650:4, 651:5, 652:6, 653:7, 654:8, 655:9, 656:10}\nseq = {1:'R',2:'K',3:'E',4:'L',5:'Q',6:'R',7:'K',8:'E',9:'L',10:'Q'}\n\nprint(\"RKELQx2 (RKELQRKELQ) \u2014 atom-level contact analysis\")\nprint(f\"{'Pos':>3} {'Res':>3} {'<5A':>5} {'NearCA':>14} {'Domain':>12}\")\nprint(\"-\" * 52)\nfor orig_res in range(647, 657):\n    bres = resmap[orig_res]\n    pa = [a for a in pep if a['resnum']==orig_res]\n    contact_count = 0\n    for p in pa:\n        for r in rec:\n            d = np.linalg.norm(p['xyz'] - r['xyz'])\n            if d < 5.0:\n                contact_count += 1\n                break\n    bca = [a for a in pa if a['atom']=='CA']\n    min_d = 999; min_res = ''; min_rn = 0\n    if bca:\n        for r in rec:\n            if r['atom'] == 'CA':\n                d = np.linalg.norm(bca[0]['xyz'] - r['xyz'])\n                if d < min_d:\n                    min_d = d; min_res = r['resname']; min_rn = r['resnum']\n    domain = \"NBD\" if min_rn < 380 else (\"SBD\u03b2\" if min_rn < 520 else \"SBD\u03b1/lid\")\n    if min_d > 10: domain = \"OUTSIDE\"\n    print(f\"{bres:>3} {seq[bres]:>3} {contact_count:>5}   {min_res}{min_rn}@{min_d:.1f}A  {domain}\")\n\nb1 = [a for a in pep if a['resnum']==647 and a['atom']=='CA']\nb10 = [a for a in pep if a['resnum']==656 and a['atom']=='CA']\nif b1 and b10:\n    print(f\"\\nPeptide span (CA1\u2192CA10): {np.linalg.norm(b1[0]['xyz']-b10[0]['xyz']):.1f} A\")\nPYEOF"}

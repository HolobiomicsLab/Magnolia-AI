{"event_type":"tool_call","timestamp":"2026-06-19T11:54:44.576779Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c curl -s \"http://localhost:8000/api/jobs/47ca73de-0b03-4ea5-8006-7850bee76314\" | python3 -c \"\nimport sys,json,requests\nd=json.load(sys.stdin)\ndois = [c['doi'] for c in d['result']['candidates'] if c['score'] > 0.5]\nprint(f'Fetching abstracts for {len(dois)} papers...')\nfor doi in dois:\n    try:\n        r = requests.get(f'http://localhost:8000/api/paper', params={'doi': doi}, timeout=10)\n        p = r.json()\n        title = p.get('title','?')\n        abstract = (p.get('abstract') or '')[:300].replace('\\n',' ')\n        score = next(c['score'] for c in d['result']['candidates'] if c['doi'] == doi)\n        print(f'\\n=== {score:.3f} | {doi} ===')\n        print(f'TITLE: {title}')\n        print(f'ABSTRACT: {abstract}')\n    except Exception as e:\n        print(f'\\n=== FAIL | {doi} | {e} ===')\n\" 2>&1"}

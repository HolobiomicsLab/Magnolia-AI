{"event_type":"tool_call","timestamp":"2026-06-23T14:09:31.185611Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport sqlite3, json\n\nconn = sqlite3.connect('/home/tjiang/.local/share/opencode/opencode.db')\n\n# Check memory_search_errors calls\nrows = conn.execute('SELECT p.session_id, p.data, p.time_created FROM part p WHERE p.data LIKE ? ORDER BY p.time_created', ['%memory_search_errors%']).fetchall()\n\nprint(f'Total memory_search_errors calls: {len(rows)}')\nfor sid, data_json, ts in rows:\n    try:\n        d = json.loads(data_json)\n    except:\n        continue\n    tool = d.get('tool', '')\n    if 'memory_search_errors' in tool:\n        state = d.get('state', {})\n        inp = state.get('input', {})\n        err = inp.get('error_message', '')\n        output_str = state.get('output', '{}')\n        outer = json.loads(output_str)\n        \n        results = []\n        if 'result' in outer:\n            r = outer['result']\n            if isinstance(r, list):\n                results = r\n            elif isinstance(r, str):\n                try:\n                    results = json.loads(r)\n                except:\n                    pass\n        elif 'results' in outer:\n            results = outer['results']\n        \n        print(f'Session: {sid}')\n        print(f'Error: {err[:150]}')\n        print(f'Results: {len(results)}')\n        for r in results[:3]:\n            if isinstance(r, dict):\n                print(f'  -> \\\"{r.get(\\\"title\\\",\\\"\\\")[:120]}\\\" [{r.get(\\\"entry_type\\\",\\\"\\\")}]')\n            else:\n                print(f'  -> {str(r)[:150]}')\n        print()\n\" 2>&1"}

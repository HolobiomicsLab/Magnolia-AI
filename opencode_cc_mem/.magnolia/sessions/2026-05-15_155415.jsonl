{"event_type":"tool_call","timestamp":"2026-06-16T13:46:55.107315Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\n\necho \"=== Full protocol (mdref + water) vs Bare protocol ===\"\necho \"\"\n\nfor peptide in KFERQ HAMNG RKELQ; do\n    bare_tsv=\"runs/2026-06-16_4po2_${peptide}_s5000/output/7_caprieval/capri_clt.tsv\"\n    full_tsv=\"runs/2026-06-16_4po2_${peptide}_s5000_full/output/12_caprieval/capri_clt.tsv\"\n    \n    echo \"--- $peptide ---\"\n    \n    # Bare protocol\n    bare_line=$(grep -v \"^#\" \"$bare_tsv\" | tail -n +2 | head -1)\n    bare_score=$(echo \"$bare_line\" | awk -F'\\t' '{print $5}')\n    bare_dockq=$(echo \"$bare_line\" | awk -F'\\t' '{print $13}')\n    bare_n=$(echo \"$bare_line\" | awk -F'\\t' '{print $3}')\n    bare_clusters=$(grep -cv \"^#\" \"$bare_tsv\")\n    \n    # Full protocol\n    full_line=$(grep -v \"^#\" \"$full_tsv\" | tail -n +2 | head -1)\n    full_score=$(echo \"$full_line\" | awk -F'\\t' '{print $5}')\n    full_dockq=$(echo \"$full_line\" | awk -F'\\t' '{print $13}')\n    full_n=$(echo \"$full_line\" | awk -F'\\t' '{print $3}')\n    full_clusters=$(grep -cv \"^#\" \"$full_tsv\")\n    \n    echo \"  Bare:   score=$bare_score  dockq=$bare_dockq  n=$bare_n  clusters=$bare_clusters\"\n    echo \"  Full:   score=$full_score  dockq=$full_dockq  n=$full_n  clusters=$full_clusters\"\n    \n    # Also check air (restraint contribution) in full protocol\n    full_air=$(echo \"$full_line\" | awk -F'\\t' '{print $19}')\n    echo \"  AIR:    $full_air\"\n    echo \"\"\ndone"}
{"event_type":"tool_success","timestamp":"2026-06-16T13:46:55.212974Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":106,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-16T13:55:42.966257Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport numpy as np, gzip\n\ndef parse_pdb(path, zipped=False):\n    coords = {}\n    opener = gzip.open if zipped else open\n    with opener(path, 'rt') as f:\n        for line in f:\n            if not line.startswith('ATOM'): continue\n            if line[12:16].strip() != 'CA': continue\n            chain = line[21]\n            if chain != 'A': continue\n            resi = int(line[22:26].strip())\n            x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n            coords[resi] = np.array([x, y, z])\n    return coords\n\ndef kabsch_rmsd(P, Q, common_resi):\n    p = np.array([P[r] for r in common_resi])\n    q = np.array([Q[r] for r in common_resi])\n    p = p - p.mean(axis=0)\n    q = q - q.mean(axis=0)\n    C = p.T @ q\n    V, S, Wt = np.linalg.svd(C)\n    d = np.sign(np.linalg.det(V @ Wt))\n    R = V @ np.diag([1, 1, d]) @ Wt\n    p_aligned = p @ R\n    return np.sqrt(np.mean(np.sum((p_aligned - q)**2, axis=1))), R, p.mean(axis=0), q.mean(axis=0)\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\n\n# Original receptor (starting structure)\norig = parse_pdb(f\"{BASE}/raw_input/receptor/4po2_chainA.pdb\")\n\nfor peptide, rd in [(\"KFERQ\", \"2026-06-16_4po2_KFERQ_s5000_full\"),\n                      (\"HAMNG\", \"2026-06-16_4po2_HAMNG_s5000_full\"),\n                      (\"RKELQ\", \"2026-06-16_4po2_RKELQ_s5000_full\")]:\n    \n    model_gz = f\"{BASE}/runs/{rd}/output/11_seletopclusts/cluster_1_model_1.pdb.gz\"\n    docked = parse_pdb(model_gz, zipped=True)\n    \n    common = sorted(set(orig.keys()) & set(docked.keys()))\n    rmsd, R, p_mean, q_mean = kabsch_rmsd(docked, orig, common)\n    \n    print(f\"--- {peptide} ---\")\n    print(f\"  Common C\u03b1: {len(common)} (resi {min(common)}-{max(common)})\")\n    print(f\"  Overall C\u03b1 RMSD: {rmsd:.2f} \u00c5\")\n    \n    # Per-region breakdown\n    sbd_beta = [r for r in common if 386 <= r <= 510]\n    sbd_alpha = [r for r in common if 531 <= r <= 613]\n    \n    p = np.array([docked[r] for r in sbd_beta])\n    q = np.array([orig[r] for r in sbd_beta])\n    p_c = p - p.mean(axis=0)\n    q_c = q - q.mean(axis=0)\n    rmsd_beta = np.sqrt(np.mean(np.sum((p_c @ R - q_c)**2, axis=1)))\n    \n    p = np.array([docked[r] for r in sbd_alpha])\n    q = np.array([orig[r] for r in sbd_alpha])\n    p_c = p - p.mean(axis=0)\n    q_c = q - q.mean(axis=0)\n    rmsd_alpha = np.sqrt(np.mean(np.sum((p_c @ R - q_c)**2, axis=1)))\n    \n    print(f\"  SBD\u03b2 (386-510) RMSD: {rmsd_beta:.2f} \u00c5\")\n    print(f\"  SBD\u03b1 (531-613) RMSD: {rmsd_alpha:.2f} \u00c5\")\n    \n    # Per-residue deviation at binding site\n    binding_site = [403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473]\n    print(f\"  Binding groove residues:\")\n    for r in binding_site:\n        if r in common:\n            d_rot = (docked[r] - q_mean) @ R + p_mean\n            d = np.linalg.norm(d_rot - orig[r])\n            print(f\"    {r}: {d:.2f} \u00c5\")\n    print()\n\nPYEOF"}

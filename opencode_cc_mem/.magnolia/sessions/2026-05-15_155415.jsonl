{"event_type":"tool_call","timestamp":"2026-07-01T07:11:26.734893Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\nruns = {\n    \"EGGFQMAKT (L8->K)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART (L8->R)\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"KFERQx2 s20000\":   \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\",\n}\n\n# baseline reference (from boot-context)\nrefs = {\n    \"TGFMALQ (best prior 6-mer)\": {\"score\": None, \"air_free\": -91.00, \"dockq\": 0.770},\n    \"RKALQ (best prior 5-mer)\":   {\"score\": None, \"air_free\": -83.77, \"dockq\": 0.705},\n    \"TGGFQMALT (best prior 9-mer)\": {\"score\": None, \"air_free\": -101.63, \"dockq\": 0.819},\n    \"EGGFQMALT cl1 (parent)\": {\"score\": None, \"air_free\": -112.6, \"dockq\": None},\n    \"EAGFQMALT cl3 (parent)\": {\"score\": None, \"air_free\": -92.9, \"dockq\": None},\n}\n\nfor label, d in runs.items():\n    print(f\"=== {label} ===\")\n    ss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\n    if not os.path.exists(ss):\n        ss = f\"{d}/output/09_caprieval/capri_ss.tsv\"\n    with open(ss) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    best = []\n    for row in reader:\n        score = float(row['score'])\n        air = float(row.get('air',0))\n        af = score - 0.1*air\n        best.append((score, af, row.get('dockq','?'), row.get('vdw','?'), row.get('elec','?'),\n                      row.get('desolv','?'), row.get('bsa','?'), row.get('cluster_id','?'),\n                      row.get('irmsd','?'), row.get('lrmsd','?')))\n    best.sort(key=lambda x: x[0])\n    top3 = best[:3]\n    print(f\"  Top-3 models:\")\n    for i, (s, af, dq, vdw, elec, desolv, bsa, cid, irmsd, lrmsd) in enumerate(top3):\n        print(f\"    #{i+1}: score={s:.2f}  AIR-free={af:.2f}  DockQ={dq}  vdw={vdw}  elec={elec}  desolv={desolv}  bsa={bsa}  cl={cid}  irmsd={irmsd}\")\n\n    # Cluster counts from clustfcc.txt\n    clf = f\"{d}/output/10_clustfcc/clustfcc.txt\"\n    with open(clf) as f:\n        for line in f:\n            if 'models' in line and 'top4' in line:\n                print(f\"  {line.strip()}\")\n            if line.startswith('Total number of clusters:'):\n                print(f\"  {line.strip()}\")\n    print()\nPYEOF"}

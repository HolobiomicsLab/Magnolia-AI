ngle:.0f}\u00b0  {'\u03c0-STACK' if cd<5.5 and angle<30 else ('close but off-axis' if cd<6.0 else 'too far')}\")\n\nprint(\"\\n\"+\"=\"*60); print(\"C. CATION-\u03c0: receptor cations to F4 ring (<=6.0 \u00c5)\"); print(\"=\"*60)\nfor ri,cat in [(415,\"LYS\"),(416,\"ARG\"),(447,\"ARG\"),(469,\"ARG\"),(458,\"LYS\"),(533,\"ARG\")]:\n    if cat==\"LYS\": c=atom(\"A\",ri,\"NZ\")\n    else:\n        cz=atom(\"A\",ri,\"CZ\")\n        # cation center ~ CZ\n        c=cz\n    if c is None: continue\n    cd=np.linalg.norm(f4c-c['xyz'])\n    flag=\"CATION-\u03c0\" if cd<=6.0 else \"\"\n    print(f\"  A-{ri}-{cat} {'NZ' if cat=='LYS' else 'CZ'} -> F4 centroid: {cd:.2f} \u00c5  {flag}\")\n\nprint(\"\\n\"+\"=\"*60); print(\"D. VERIFY T1(OG1) <-> R533 contact (ensemble TSV didn't list it)\"); print(\"=\"*60)\nt1ca=atom(\"B\",2,\"CA\"); r533ca=atom(\"A\",533,\"CA\")\nprint(f\"  T1 CA - R533 CA: {d(t1ca,r533ca):.2f} \u00c5 (ensemble TSV ca-ca threshold ~9 \u00c5; if >9, pair suppressed in TSV)\")\nt1og1=atom(\"B\",2,\"OG1\"); \nfor h in [\"HH11\",\"HH12\",\"HE\",\"HH21\",\"HH22\",\"NE\",\"NH1\",\"NH2\"]:\n    a=atom(\"A\",533,h)\n    if a: print(f\"    T1 OG1 ... R533 {h}: {d(t1og1,a):.2f} \u00c5\")\n\nprint(\"\\n\"+\"=\"*60); print(\"E. PEPTIDE C-terminus (T9 OXT) salt bridge check\"); print(\"=\"*60)\nfor an in [\"O\",\"OXT\"]:\n    a=atom(\"B\",10,an)\n    if a is None: continue\n    for ri,cat in [(469,\"ARG\"),(447,\"ARG\"),(533,\"ARG\"),(415,\"LYS\"),(458,\"LYS\")]:\n        for h in ([\"NZ\",\"CZ\"] + ([\"HH11\",\"HH12\",\"HH21\",\"HH22\",\"HE\"] if cat==\"ARG\" else [\"HZ1\",\"HZ2\",\"HZ3\"])):\n            b=atom(\"A\",ri,h)\n            if b:\n                dd=d(a,b)\n                if dd<5.0: print(f\"  T9 {an} ... A-{ri}-{cat} {h}: {dd:.2f} \u00c5\")\n\nprint(\"\\n\"+\"=\"*60); print(\"F. M6 (MET) sulfur environment\"); print(\"=\"*60)\nm6sd=atom(\"B\",7,\"SD\")\nif m6sd:\n    for ri in list(range(388,647)):\n        for b in ra(\"A\",ri):\n            dd=d(m6sd,b)\n            if dd<5.0 and b['el']!=\"H\": print(f\"  M6 SD ... A-{ri}-{b['rn']} {b['an']}: {dd:.2f} \u00c5\")\n\nprint(\"\\n\"+\"=\"*60); print(\"G. Backbone H-bond registry (peptide HN/O <-> receptor, <=3.5 \u00c5)\"); print(\"=\"*60)\npep=[(2,\"T1\"),(3,\"G2\"),(4,\"G3\"),(5,\"F4\"),(6,\"Q5\"),(7,\"M6\"),(8,\"A7\"),(9,\"L8\"),(10,\"T9\")]\nfor pri,lab in pep:\n    for pan in [\"HN\",\"O\",\"N\"]:\n        a=atom(\"B\",pri,pan)\n        if a is None: continue\n        best=None\n        for ri in list(range(388,647)):\n            for b in ra(\"A\",ri):\n                if b['el']==\"H\" and pan!=\"HN\": continue  # only use H atoms for HN donor\n                dd=d(a,b)\n                if dd<=3.5 and (best is None or dd<best[2]):\n                    best=(ri,b['rn'],b['an'],dd)\n        if best: print(f\"  B-{pri}({lab}) {pan} -> A-{best[0]}-{best[1]} {best[2]}: {best[3]:.2f} \u00c5\")\nPYEOF\npython3 /tmp/measure2.py"}

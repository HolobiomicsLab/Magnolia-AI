{"event_type":"tool_call","timestamp":"2026-06-10T13:36:48.670589Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport math\n\nrec_atoms = []\nwith open('receptor.pdb') as f:\n    for l in f:\n        if not l.startswith('ATOM'): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((name, res, rnum, x, y, z))\n\ndef parse_top_pose(sdf_path):\n    with open(sdf_path) as f:\n        content = f.read()\n    blocks = content.split('$$$$')\n    best = None\n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        emp_aff = 0; na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts: na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n        if na == 0: continue\n        lig = []\n        for i in range(atom_start, min(atom_start+na, len(lines))):\n            l = lines[i]\n            if len(l) < 30: continue\n            try: x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n            except: continue\n            lig.append((x, y, z))\n        if best is None or emp_aff < best[0]:\n            best = (emp_aff, lig)\n    return best\n\ndef get_contacts(lig_atoms):\n    from collections import defaultdict\n    contacts = defaultdict(list)\n    for lx, ly, lz in lig_atoms:\n        for ra_name, ra_res, ra_num, rx, ry, rz in rec_atoms:\n            d = math.sqrt((rx-lx)**2+(ry-ly)**2+(rz-lz)**2)\n            if d <= 5.0:\n                contacts[f\"{ra_res}{ra_num}\"].append(d)\n    return contacts\n\nald = parse_top_pose('docked_flex5_Z11-16-Ald_asn90.sdf')\nac = parse_top_pose('docked_flex5_Z11-16-Ac_asn90.sdf')\n\nif ald and ac:\n    ald_contacts = get_contacts(ald[1])\n    ac_contacts = get_contacts(ac[1])\n    \n    print(\"Residues contacted by ACETATE but NOT aldehyde (potential clash sites):\")\n    print(f\"{'Residue':10s} {'Ac dmin':>9s} {'Ald dmin':>9s}\")\n    print(\"-\" * 32)\n    ac_only = set(ac_contacts.keys()) - set(ald_contacts.keys())\n    for r in sorted(ac_only):\n        if r in ald_contacts: continue\n        d = min(ac_contacts[r])\n        # check if residue is within 6A of Asn90\n        asn90_d = 999.0\n        for a in rec_atoms:\n            if a[1]=='ASN' and a[2]==90:\n                for a2 in rec_atoms:\n                    if f\"{a2[1]}{a2[2]}\" == r:\n                        dd = math.sqrt((a[3]-a2[3])**2+(a[4]-a2[4])**2+(a[5]-a2[5])**2)\n                        if dd < asn90_d: asn90_d = dd\n        print(f\"{r:10s} {d:>8.2f}\u00c5 {'--':>9s}  (dist to Asn90: {asn90_d:.1f}\u00c5)\")\n    \n    print()\n    print(\"Residues where acetate is CLOSER than aldehyde:\")\n    print(f\"{'Residue':10s} {'Ac dmin':>9s} {'Ald dmin':>9s} {'\u0394':>6s}\")\n    print(\"-\" * 38)\n    common = set(ald_contacts.keys()) & set(ac_contacts.keys())\n    diffs = []\n    for r in common:\n        d_ac = min(ac_contacts[r])\n        d_ald = min(ald_contacts[r])\n        d = d_ac - d_ald\n        if d < -0.3:  # acetate closer by >0.3A\n            diffs.append((r, d_ac, d_ald, d))\n    for r, d_ac, d_ald, d in sorted(diffs, key=lambda x: x[3]):\n        print(f\"{r:10s} {d_ac:>8.2f}\u00c5 {d_ald:>8.2f}\u00c5 {d:>5.1f}\u00c5\")\n\nPYEOF"}

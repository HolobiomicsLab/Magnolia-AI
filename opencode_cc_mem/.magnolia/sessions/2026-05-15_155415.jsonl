{"event_type":"tool_success","timestamp":"2026-06-03T09:25:09.851321Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":555,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-03T09:28:41.759249Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts && python3 -c \"\nimport math, gzip, sys\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') if path.endswith('.gz') else open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x = float(line[30:38])\n                y = float(line[38:46])\n                z = float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLU',649),('B','ARG',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLU',649):'E3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\n\nmodels = ['cluster_1_model_1.pdb.gz','cluster_1_model_2.pdb.gz','cluster_1_model_3.pdb.gz','cluster_1_model_4.pdb.gz']\n\n# Collect all receptor residues within 5A of any peptide atom\nall_contacts = defaultdict(lambda: defaultdict(list))  # pep_res -> rec_res -> [min_dists]\npocket_residues = set()\n\nfor mi, mf in enumerate(models):\n    atoms = read_pdb(mf)\n    pep_atoms = {k:v for k,v in atoms.items() if (k[0],k[1],k[2]) in PEPTIDE}\n    \n    for pk, pxyz in pep_atoms.items():\n        pres = (pk[0], pk[1], pk[2])\n        for rk, rxyz in atoms.items():\n            if rk[0] != 'A': continue\n            d = dist(pxyz, rxyz)\n            if d <= 5.0:\n                rres = (rk[0], rk[1], rk[2])\n                all_contacts[pres][rres].append(d)\n                pocket_residues.add(rres)\n\n# For each peptide residue, report best contacts across models\nprint('=== KFERQ BINDING POCKET: residues within 5\u00c5 ===')\nprint()\n\nfor pres in PEPTIDE:\n    pname = PEP_NAMES[pres]\n    contacts = all_contacts[pres]\n    # Average min dist across models\n    avg_contacts = []\n    for rres, dists in contacts.items():\n        avg_d = sum(dists) / len(dists)\n        avg_contacts.append((rres, avg_d, min(dists)))\n    avg_contacts.sort(key=lambda x: x[1])\n    \n    print(f'--- {pname} ({pres[1]}{pres[2]}) ---')\n    print(f'  Receptor contacts ({len(avg_contacts)} residues):')\n    for rres, avg, mind in avg_contacts[:10]:\n        print(f'    A-{rres[1]}{rres[2]:>4s}  avg {avg:.1f}\u00c5  min {mind:.1f}\u00c5')\n    print()\n\n# Pocket composition\nprint('=== POCKET COMPOSITION ===')\nprint(f'Total unique receptor residues contacting peptide: {len(pocket_residues)}')\npolar = sum(1 for r in pocket_residues if r[1] in ('SER','THR','ASN','GLN','TYR','HIS','CYS'))\ncharged_pos = sum(1 for r in pocket_residues if r[1] in ('LYS','ARG'))\ncharged_neg = sum(1 for r in pocket_residues if r[1] in ('ASP','GLU'))\napolar = sum(1 for r in pocket_residues if r[1] in ('ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET'))\ngly = sum(1 for r in pocket_residues if r[1] == 'GLY')\nprint(f'  Polar (S/T/N/Q/Y/H/C): {polar}')\nprint(f'  Positive (K/R): {charged_pos}')\nprint(f'  Negative (D/E): {charged_neg}')\nprint(f'  Apolar (A/V/L/I/P/F/W/M): {apolar}')\nprint(f'  Glycine: {gly}')\nprint(f'  All pocket residues: {sorted(pocket_residues, key=lambda x: x[2])}')\n\" 2>&1\n"}

{"event_type":"tool_call","timestamp":"2026-06-20T20:29:22.075378Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 << 'PYEOF'\nimport csv\n\nwith open(\"results/comparison.csv\") as f:\n    rows = list(csv.DictReader(f))\n\n# Add dEtot\nfor r in rows:\n    r[\"dEtot\"] = float(r[\"Etot_our\"]) - float(r[\"Etot_lit\"])\n    r[\"dHOMO\"] = float(r[\"HOMO_our\"]) - float(r[\"HOMO_lit\"])\n    r[\"dGAP\"] = float(r[\"GAP_our\"]) - float(r[\"GAP_lit\"])\n\n# Sort by |dEtot|\nrows.sort(key=lambda r: abs(r[\"dEtot\"]), reverse=True)\n\n# Write outliers (> 1 eV)\nwith open(\"results/outliers.csv\", \"w\", newline=\"\") as f:\n    w = csv.DictWriter(f, fieldnames=[\"molecule\",\"n_rings\",\"HOMO_our\",\"HOMO_lit\",\"dHOMO\",\n        \"LUMO_our\",\"LUMO_lit\",\"GAP_our\",\"GAP_lit\",\"dGAP\",\"Etot_our\",\"Etot_lit\",\"dEtot\"])\n    w.writeheader()\n    for r in rows:\n        if abs(r[\"dEtot\"]) > 1.0:\n            w.writerow({k: r[k] for k in w.fieldnames})\n\nn_out = sum(1 for r in rows if abs(r[\"dEtot\"]) > 1.0)\nprint(f\"Outliers (|\u0394Etot| > 1 eV): {n_out} / {len(rows)}\")\nprint(f\"Saved: results/outliers.csv\")\n\n# Also save top 20 for quick view\nwith open(\"results/outliers_top20.csv\", \"w\", newline=\"\") as f:\n    w = csv.DictWriter(f, fieldnames=[\"molecule\",\"n_rings\",\"HOMO_our\",\"HOMO_lit\",\"dHOMO\",\n        \"LUMO_our\",\"LUMO_lit\",\"GAP_our\",\"GAP_lit\",\"dGAP\",\"Etot_our\",\"Etot_lit\",\"dEtot\"])\n    w.writeheader()\n    for r in rows[:20]:\n        w.writerow({k: r[k] for k in w.fieldnames})\n\nprint(f\"Saved: results/outliers_top20.csv\")\nprint()\nprint(\"Top 20:\")\nprint(f\"{'Molecule':35s} {'rings':>5s} {'dEtot':>10s} {'dHOMO':>8s} {'dGAP':>8s}\")\nfor r in rows[:20]:\n    print(f\"{r['molecule']:35s} {r['n_rings']:>5s} {float(r['dEtot']):+10.3f} {float(r['dHOMO']):+8.4f} {float(r['dGAP']):+8.4f}\")\nPYEOF\n"}
{"event_type":"tool_success","timestamp":"2026-06-20T20:29:22.171527Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":96,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-20T20:30:39.304205Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas/runs/2026-06-20_compas_xtb_5000 && python3 << 'PYEOF'\nimport csv, re, os\nfrom collections import defaultdict\nimport matplotlib\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport numpy as np\n\nSCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))\nRUN_DIR = os.path.dirname(SCRIPT_DIR)\nOUTPUT_DIR = os.path.join(RUN_DIR, \"output\")\nRESULTS_DIR = os.path.join(RUN_DIR, \"results\")\nCOMPAS_CSV = os.path.join(SCRIPT_DIR, \"..\", \"..\", \"..\", \"raw_input\", \"compas_data\", \"compas-1x.csv\")\nSEL_CSV = os.path.join(RUN_DIR, \"inputs\", \"selected.csv\")\n\n_nf = {\"n_rings\",\"HOMO_eV\",\"LUMO_eV\",\"GAP_eV\",\"Etot_eV\",\"Erel_eV\",\"aIP_eV\",\"aEA_eV\"}\n\npub = {}\nwith open(COMPAS_CSV) as f:\n    for r in csv.DictReader(f):\n        pub[r[\"molecule\"]] = {k: float(v) if k in _nf else v for k, v in r.items()}\n\nwith open(SEL_CSV) as f:\n    selected = list(csv.DictReader(f))\n\nresults = []\nfor m in selected:\n    name = m[\"molecule\"]\n    outfile = os.path.join(OUTPUT_DIR, f\"{name}.out\")\n    if not os.path.exists(outfile): continue\n    with open(outfile) as f: text = f.read()\n    etot_m = re.search(r\"TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh\", text)\n    gap_m = re.search(r\"HOMO-LUMO GAP\\s+([\\d.]+)\\s+eV\", text)\n    homo_m = re.findall(r\"(-?[\\d.]+)\\s+\\(HOMO\\)\", text)\n    lumo_m = re.findall(r\"(-?[\\d.]+)\\s+\\(LUMO\\)\", text)\n    if not all([etot_m, gap_m, homo_m, lumo_m]): continue\n    etot_ev = float(etot_m.group(1)) * 27.2114\n    p = pub.get(name, {})\n    results.append({\n        \"molecule\": name, \"n_rings\": int(m[\"n_rings\"]),\n        \"HOMO_our\": float(homo_m[-1]), \"HOMO_lit\": p.get(\"HOMO_eV\"),\n        \"LUMO_our\": float(lumo_m[-1]), \"LUMO_lit\": p.get(\"LUMO_eV\"),\n        \"GAP_our\": float(gap_m.group(1)), \"GAP_lit\": p.get(\"GAP_eV\"),\n        \"Etot_our\": etot_ev, \"Etot_lit\": p.get(\"Etot_eV\"),\n        \"Erel_lit\": p.get(\"Erel_eV\"),\n    })\n\n# Compute Erel\nby_rings = defaultdict(list)\nfor r in results:\n    by_rings[r[\"n_rings\"]].append(r)\nfor n, group in by_rings.items():\n    our_min = min(r[\"Etot_our\"] for r in group)\n    for r in group:\n        r[\"Erel_our\"] = r[\"Etot_our\"] - our_min\n\n# Filter out outliers: |dEtot| > 1.0 eV\nfiltered = []\nfor r in results:\n    if r[\"Etot_lit\"] is None or r[\"Etot_our\"] is None: continue\n    if abs(r[\"Etot_our\"] - r[\"Etot_lit\"]) <= 1.0:\n        filtered.append(r)\n\nprint(f\"All: {len(results)}, after filtering |\u0394Etot|<=1 eV: {len(filtered)}\")\n\n# --- Plotting ---\nplt.rcParams.update({\n    \"font.family\": \"sans-serif\", \"font.sans-serif\": [\"Arial\", \"DejaVu Sans\"],\n    \"font.size\": 9, \"axes.labelsize\": 11, \"axes.titlesize\": 12,\n    \"xtick.labelsize\": 9, \"ytick.labelsize\": 9,\n})\n\nfig, axes = plt.subplots(2, 3, figsize=(15, 10))\naxes = axes.flatten()\n\ndef scatter_plot(ax, x, y, xlabel, ylabel, title, color_by=None, cmap_label=None):\n    if color_by is not None and len(color_by) == len(x):\n        sc = ax.scatter(x, y, c=color_by, cmap=\"viridis\", s=1, alpha=0.5, rasterized=True)\n        cbar = plt.colorbar(sc, ax=ax)\n        if cmap_label: cbar.set_label(cmap_label)\n    else:\n        ax.scatter(x, y, s=1, alpha=0.3, color=\"steelblue\", rasterized=True)\n    mx, my = np.mean(x), np.mean(y)\n    ss_xy = np.sum((x-mx)*(y-my))\n    ss_xx = np.sum((x-mx)**2); ss_yy = np.sum((y-my)**2)\n    r2 = (ss_xy**2)/(ss_xx*ss_yy) if ss_xx*ss_yy!=0 else 0\n    slope = ss_xy/ss_xx if ss_xx!=0 else 0\n    xr = np.linspace(min(x), max(x), 100)\n    ax.plot(xr, xr, \"k--\", linewidth=0.5, alpha=0.3)\n    ax.set_xlabel(xlabel); ax.set_ylabel(ylabel)\n    ax.set_title(f\"{title}  (R\u00b2={r2:.4f}, slope={slope:.4f})\")\n    mae = np.mean(np.abs(np.array(x)-np.array(y)))\n    ax.text(0.05,0.95,f\"MAE={mae:.4f} eV\",transform=ax.transAxes,va=\"top\",fontsize=8)\n    ax.text(0.05,0.88,f\"N={len(x)}\",transform=ax.transAxes,va=\"top\",fontsize=8)\n\ndef extract(k, data=filtered):\n    our = np.array([r[f\"{k}_our\"] for r in data if r[f\"{k}_our\"] is not None and r[f\"{k}_lit\"] is not None])\n    lit = np.array([r[f\"{k}_lit\"] for r in data if r[f\"{k}_our\"] is not None and r[f\"{k}_lit\"] is not None])\n    return our, lit\n\nrings_f = np.array([r[\"n_rings\"] for r in filtered if r[\"HOMO_our\"] is not None and r[\"HOMO_lit\"] is not None])\n\nour_h, lit_h = extract(\"HOMO\")\nour_l, lit_l = extract(\"LUMO\")\nour_g, lit_g = extract(\"GAP\")\nour_e, lit_e = extract(\"Erel\")\n\nscatter_plot(axes[0], our_h, lit_h, \"Our HOMO (eV)\", \"Published HOMO (eV)\", \"HOMO\", rings_f, \"n_rings\")\nscatter_plot(axes[1], our_l, lit_l, \"Our LUMO (eV)\", \"Published LUMO (eV)\", \"LUMO\", rings_f, \"n_rings\")\nscatter_plot(axes[2], our_g, lit_g, \"Our GAP (eV)\", \"Published GAP (eV)\", \"HOMO-LUMO Gap\", rings_f, \"n_rings\")\nscatter_plot(axes[3], our_e, lit_e, \"Our Erel (eV)\", \"Published Erel (eV)\", \"Relative Energy\", rings_f, \"n_rings\")\n\n# \u0394Erel histogram\ndErel = our_e - lit_e\naxes[4].hist(dErel, bins=100, color=\"steelblue\", alpha=0.7, edgecolor=\"white\", linewidth=0.3)\naxes[4].set_xlabel(\"\u0394Erel (eV)\")\naxes[4].set_ylabel(\"Count\")\naxes[4].set_title(f\"\u0394Erel Distribution  (MAE={np.mean(np.abs(dErel)):.4f} eV)\")\naxes[4].axvline(0, color=\"k\", linestyle=\"--\", linewidth=0.5)\n\n# GAP vs n_rings\nn_all = np.array([r[\"n_rings\"] for r in filtered if r[\"GAP_our\"] is not None])\ngap_all = np.array([r[\"GAP_our\"] for r in filtered if r[\"GAP_our\"] is not None])\naxes[5].scatter(n_all, gap_all, s=1, alpha=0.15, color=\"steelblue\", rasterized=True)\nfor n in sorted(set(n_all)):\n    mask = n_all==n\n    if np.sum(mask)>0:\n        axes[5].plot(n, np.median(gap_all[mask]), \"ro\", markersize=4)\naxes[5].set_xlabel(\"Number of Rings\"); axes[5].set_ylabel(\"HOMO-LUMO Gap (eV)\")\naxes[5].set_title(\"Gap vs Ring Size  (red = median)\")\n\nplt.tight_layout()\nplt.savefig(os.path.join(RESULTS_DIR, \"figure4_correlation_filtered.png\"), dpi=150)\nplt.savefig(os.path.join(RESULTS_DIR, \"figure4_correlation_filtered.svg\"))\nprint(f\"Saved: {RESULTS_DIR}/figure4_correlation_filtered.png\")\nprint(f\"Saved: {RESULTS_DIR}/figure4_correlation_filtered.svg\")\n\n# Print comparison stats\nprint(f\"\\nExcluding {len(results)-len(filtered)} outliers (|\u0394Etot| > 1 eV):\")\nfor label, our, lit in [(\"HOMO\",our_h,lit_h),(\"LUMO\",our_l,lit_l),(\"GAP\",our_g,lit_g),(\"Erel\",our_e,lit_e)]:\n    d = our - lit; ad = np.abs(d)\n    mx, my = np.mean(our), np.mean(lit)\n    ss_xy = np.sum((our-mx)*(lit-my)); ss_xx = np.sum((our-mx)**2); ss_yy = np.sum((lit-my)**2)\n    r2 = (ss_xy**2)/(ss_xx*ss_yy) if ss_xx*ss_yy!=0 else 0\n    slope = ss_xy/ss_xx if ss_xx!=0 else 0\n    print(f\"  {label:5s}: MAE={ad.mean():.4f}  R\u00b2={r2:.4f}  slope={slope:.4f}  max|\u0394|={ad.max():.4f}\")\nPYEOF\n"}

{"event_type":"tool_call","timestamp":"2026-06-05T08:57:27.855356Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\n# Standard amino acid 3-letter codes\nAA3 = {'A':'ALA','K':'LYS','F':'PHE','Q':'GLN','E':'GLU','R':'ARG'}\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\n# Load KFERQ docked structure (template for 5-mer binding pose)\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\") or line.startswith(\"HETATM\"):\n                atoms.append({\n                    \"line\": line,\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(), \"elem\": line[76:78].strip(),\n                    \"serial\": int(line[6:11]),\n                })\n    return atoms\n\nkferq_all = read_pdb(f\"{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nkferqx2_all = read_pdb(f\"{base}/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\n\n# Extract just peptide B\npep5 = sorted([a for a in kferq_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"serial\"]))\npep11 = sorted([a for a in kferqx2_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"serial\"]))\n\n# Get template residues from KFERQx2 (they have proper HADDOCK3 atom names + hydrogens)\n# K652=LYS, F648=PHE, Q651=GLN (for extending)\ndef get_residue_template(atoms, resi):\n    return [a for a in atoms if a[\"resi\"]==resi]\n\n# Templates\nlys_template = get_residue_template(pep11, 652)  # K\nphe_template = get_residue_template(pep11, 648)  # F (same as F648 but we use 648 as template)\ngln_template = get_residue_template(pep11, 651)  # Q\nala_template = None  # need to build ALA differently\n\nprint(f\"LYS template: {len(lys_template)} atoms\")\nprint(f\"PHE template: {len(phe_template)} atoms\")\nprint(f\"GLN template: {len(gln_template)} atoms\")\n\n# Compute backbone continuation from Q651 in KFERQ 5-mer\nq651_atoms = [a for a in pep5 if a[\"resi\"]==651]\nq651_c = next(a for a in q651_atoms if a[\"name\"]==\"C\")\nq651_ca = next(a for a in q651_atoms if a[\"name\"]==\"CA\")\nq651_n = next(a for a in q651_atoms if a[\"name\"]==\"N\")\nq651_o = next(a for a in q651_atoms if a[\"name\"]==\"O\")\n\n# Backbone direction: CA -> C\nvec_backbone = (q651_c[\"x\"]-q651_ca[\"x\"], q651_c[\"y\"]-q651_ca[\"y\"], q651_c[\"z\"]-q651_ca[\"z\"])\nvlen = math.sqrt(vec_backbone[0]**2+vec_backbone[1]**2+vec_backbone[2]**2)\nvec_norm = tuple(v/vlen for v in vec_backbone)\n\n# Where the next residue's N would be (peptide bond length ~1.33A from C)\nn_next = tuple(q651_c[k] + 1.33*vec_norm[i] for i,k in enumerate([\"x\",\"y\",\"z\"]))\nprint(f\"\\nQ651 C: ({q651_c['x']:.1f}, {q651_c['y']:.1f}, {q651_c['z']:.1f})\")\nprint(f\"Backbone direction: ({vec_norm[0]:.3f}, {vec_norm[1]:.3f}, {vec_norm[2]:.3f})\")\nprint(f\"Next N position: ({n_next[0]:.1f}, {n_next[1]:.1f}, {n_next[2]:.1f})\")\n\n# For N-terminal extension, go backwards from K647\nk647_atoms = [a for a in pep5 if a[\"resi\"]==647]\nk647_n = next(a for a in k647_atoms if a[\"name\"]==\"N\")\nk647_ca = next(a for a in k647_atoms if a[\"name\"]==\"CA\")\n# Direction N -> CA, then extend backwards\nvec_nterm = (k647_ca[\"x\"]-k647_n[\"x\"], k647_ca[\"y\"]-k647_n[\"y\"], k647_ca[\"z\"]-k647_n[\"z\"])\nvlen_n = math.sqrt(vec_nterm[0]**2+vec_nterm[1]**2+vec_nterm[2]**2)\nvec_n_norm = tuple(v/vlen_n for v in vec_nterm)\nc_prev = tuple(k647_n[k] - 1.33*vec_n_norm[i] for i,k in enumerate([\"x\",\"y\",\"z\"]))\nprint(f\"\\nK647 N: ({k647_n['x']:.1f}, {k647_n['y']:.1f}, {k647_n['z']:.1f})\")\nprint(f\"N-term direction: ({vec_n_norm[0]:.3f}, {vec_n_norm[1]:.3f}, {vec_n_norm[2]:.3f})\")\nprint(f\"Previous C position: ({c_prev[0]:.1f}, {c_prev[1]:.1f}, {c_prev[2]:.1f})\")\n\nPYEOF"}

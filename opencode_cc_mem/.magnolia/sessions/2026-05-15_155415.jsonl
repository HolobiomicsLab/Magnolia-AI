               \"type\": parts[4].strip(),\n                \"prob\": float(parts[5]),\n                \"dist\": float(parts[6]),\n            })\n    all_contacts[name] = contacts\n\n# ============================================================\n# TABLE 1: OVERVIEW\n# ============================================================\nprint(\"=\" * 120)\nprint(\"TABLE 1: OVERVIEW \u2014 Contact density & convergence\")\nprint(\"=\" * 120)\nprint(f\"{'Peptide':>10s} {'Seq':>8s} {'c1_n':>6s} {'c1%':>6s} {'AIR-free':>9s} {'DockQ':>6s} {'Contacts':>9s} {'per_res':>8s} {'Unique rec':>10s}\")\nprint(\"-\" * 120)\nfor name in names:\n    contacts = all_contacts[name]\n    str_contacts = [c for c in contacts if c[\"prob\"] >= 0.5 and c[\"dist\"] <= 5.0]\n    all_contacts_count = len(contacts)\n    unique_rec = len(set(c[\"rec\"] for c in str_contacts))\n    per_res = len(str_contacts) / seqlen[name]\n    print(f\"{name:>10s} {name:>8s} {conv_n[name]:6d} {conv_p[name]:5.1f}% {scores[name]:9.2f} {dockq[name]:6.3f} {len(str_contacts):9d} {per_res:8.1f} {unique_rec:10d}\")\nprint(f\"\\n   Strong contacts defined as: shortest-dist \u2264 5.0 \u00c5 AND probability \u2265 0.5\")\n\n# ============================================================\n# TABLE 2: L4 HYDROPHOBIC ANCHOR\n# ============================================================\nprint()\nprint(\"=\" * 120)\nprint(\"TABLE 2: L4 HYDROPHOBIC ANCHOR \u2014 contact probability matrix (shortest-dist prob)\")\nprint(\"=\" * 120)\n\nkey_pocket = [\n    (\"A-403-ILE\", \"ILE403\"),\n    (\"A-404-GLU\", \"GLU404\"),\n    (\"A-405-THR\", \"THR405\"),\n    (\"A-406-ALA\", \"ALA406\"),\n    (\"A-428-PHE\", \"PHE428\"),\n    (\"A-429-THR\", \"THR429\"),\n    (\"A-430-THR\", \"THR430\"),\n    (\"A-431-TYR\", \"TYR431\"),\n    (\"A-438-VAL\", \"VAL438\"),\n    (\"A-439-LEU\", \"LEU439\"),\n    (\"A-440-ILE\", \"ILE440\"),\n]\n\nprint(f\"{'Receptor':>14s}\", end=\"\")\nfor name in names:\n    print(f\"  {name:>6s}\", end=\"\")\nprint(\"  Notes\")\nprint(\"-\" * 120)\n\nfor rec_id, rec_short in key_pocket:\n    print(f\"{rec_short:>14s}\", end=\"\")\n    for name in names:\n        # For TGFMALQ, L is at position 6; for others at position 4\n        l_pos = \"B-6\" if name == \"TGFMALQ\" else \"B-4\"\n        best = 0.0\n        for c in all_contacts[name]:\n            if c[\"rec\"] == rec_id and l_pos in c[\"pep\"] and \"LEU\" in c[\"pep\"]:\n                best = max(best, c[\"prob\"])\n        if best >= 0.5:\n            print(f\"  \\033[32m{best:6.2f}\\033[0m\", end=\"\")\n        elif best > 0:\n            print(f\"  {best:6.2f}\", end=\"\")\n        else:\n            print(f\"     \u2014  \", end=\"\")\n    # Notes column\n    total = sum(1 for name in names if any(c[\"rec\"] == rec_id and (\"B-4\" in c[\"pep\"] or \"B-6\" in c[\"pep\"]) and \"LEU\" in c[\"pep\"] and c[\"prob\"] >= 0.5 for c in all_contacts[name]))\n    status = \"CORE\" if total >= 4 else (\"frequent\" if total >= 2 else \"rare\")\n    print(f\"  {status}\")\n\n# ============================================================\n# TABLE 3: A3 (mutated position) contact comparison\n# ============================================================\nprint()\nprint(\"=\" * 120)\nprint(\"TABLE 3: POSITION-3 \u2014 D3\u2192A3/G3/N3 contact gain/loss (prob \u2265 0.5)\")\nprint(\"=\" * 120)\n\npos3_map = {\"RKDLQ\": \"B-3-ASP\", \"RKALQ\": \"B-3-ALA\", \"RKGLQ\": \"B-3-GLY\", \"RKNLQ\": \"B-3-ASN\"}\n\n# Collect all receptor residues contacted by any position-3\nall_p3_recs = set()\nfor name in [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\"]:\n    for c in all_contacts[name]:\n        if c[\"pep\"] == pos3_map[name] and c[\"prob\"] >= 0.2:\n            all_p3_recs.add(c[\"rec\"])\n\nprint(f\"{'Receptor':>14s}\", end=\"\")\nfor name in [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\"]:\n    print(f\"  {name:>8s}\", end=\"\")\nprint()\nprint(\"-\" * 120)\n\nfor rec in sorted(all_p3_recs, key=lambda x: int(x.split(\"-\")[1])):\n    print(f\"{rec:>14s}\", end=\"\")\n    for name in [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\"]:\n        val = \"\u2014\"\n        for c in all_contacts[name]:\n            if c[\"rec\"] == rec and c[\"pep\"] == pos3_map[name]:\n                val = f\"{c['prob']:.2f}/{c['dist']:.0f}\u00c5\"\n                break\n        if \"0.00\" in val:\n            val = \"\u2014\"\n        print(f\"  {val:>8s}\", end=\"\")\n    print()\n\n# ============================================================\n# TABLE 4: Q5 C-terminal \u2014 lid contacts\n# ============================================================\nprint()\nprint(\"=\" * 120)\nprint(\"TABLE 4: Q5 C-TERMINAL \u2014 lid contacts (prob \u2265 0.3)\")\nprint(\"=\" * 120)\n\nlid_res = [\"A-540-ASN\",\"A-541-SER\",\"A-543-GLU\",\"A-544-SER\",\n           \"A-578-ILE\",\"A-581-LEU\",\"A-582-ASP\",\"A-585-GLN\"]\n\nprint(f\"{'Lid residue':>14s}\", end=\"\")\nfor name in [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\"]:\n    print(f\"  {name:>8s}\", end=\"\")\nprint()\nprint(\"-\" * 120)\n\nfor lr in lid_res:\n    print(f\"{lr:>14s}\", end=\"\")\n    for name in [\"RKDLQ\",\"RKALQ\",\"RKGLQ\",\"RKNLQ\"]:\n        val = \"\u2014\"\n        for c in all_contacts[name]:\n            if c[\"rec\"] == lr and c[\"pep\"] == \"B-5-GLN\":\n                val = f\"{c['prob']:.2f}/{c['dist']:.0f}\u00c5\"\n                break\n        print(f\"  {val:>8s}\", end=\"\")\n    print()\n\n# ============================================================\n# TABLE 5: R1 N-terminal contacts\n# ============================================================\nprint()\nprint(\"=\" * 120)\nprint(\"TABLE 5: R1 N-TERMINAL \u2014 contacts (prob \u2265 0.5)\")\nprint(\"=\" * 120)\n\nfor name in names:\n    p1 = \"B-1-THR\" if name == \"TGFMALQ\" else \"B-1-ARG\"\n    strong = [(c[\"rec\"], c[\"prob\"], c[\"dist\"]) for c in all_contacts[name]\n              if c[\"pep\"] == p1 and c[\"prob\"] >= 0.5]\n    strong.sort(key=lambda x: -x[1])\n    if strong:\n        contacts_str = \" | \".join(f\"{r}({p:.2f}/{d:.0f}\u00c5)\" for r,p,d in strong)\n        print(f\"  {name}: {contacts_str}\")\n    else:\n        print(f\"  {name}: NO strong contacts\")\n\n# ============================================================\n# TABLE 6: TGFMALQ-specific \u2014 F-M-L triad contact profile\n# ============================================================\nprint()\nprint(\"=\" * 120)\nprint(\"TABLE 6: TGFMALQ \u2014 F3-M4-L6 hydrophobic triad\")\nprint(\"=\" * 120)\n\nfor pos, res in [(3,\"PHE\"),(4,\"MET\"),(6,\"LEU\")]:\n    ptag = f\"B-{pos}-{res}\"\n    contacts = [(c[\"rec\"], c[\"prob\"], c[\"dist\"]) for c in all_contacts[\"TGFMALQ\"]\n                if c[\"pep\"] == ptag and c[\"prob\"] >= 0.5]\n    contacts.sort(key=lambda x: -x[1])\n    recs = \" | \".join(f\"{r}({p:.2f}/{d:.0f}\u00c5)\" for r,p,d in contacts)\n    print(f\"  {res}{pos}: {recs}\")\n\nprint()\n\n# ============================================================\n# TABLE 7: Binding mode similarity matrix\n# ============================================================\nprint(\"=\" * 120)\nprint(\"TABLE 7: BINDING MODE SIMILARITY \u2014 shared receptor contacts between pairs\")\nprint(\"=\" * 120)\n\nfor i, n1 in enumerate(names):\n    for j, n2 in enumerate(names):\n        if j <= i:\n            continue\n        c1 = set(c[\"rec\"] for c in all_contacts[n1] if c[\"prob\"] >= 0.5)\n        c2 = set(c[\"rec\"] for c in all_contacts[n2] if c[\"prob\"] >= 0.5)\n        shared = c1 & c2\n        n1_only = c1 - c2\n        n2_only = c2 - c1\n        jaccard = len(shared) / len(c1 | c2) * 100 if (c1 | c2) else 0\n        print(f\"  {n1:>8s} \u2194 {n2:<8s}: {len(shared)} shared, \"\n              f\"{n1}+{len(n1_only)} only, {n2}+{len(n2_only)} only, \"\n              f\"Jaccard={jaccard:.0f}%\")\n\nPYEOF"}

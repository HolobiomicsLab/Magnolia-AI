{"event_type":"tool_call","timestamp":"2026-06-18T13:22:27.372978Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') if path.endswith('.gz') else open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'serial': int(line[6:11]),\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                })\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\ndef centroid(atoms):\n    return (sum(a['x'] for a in atoms)/len(atoms),\n            sum(a['y'] for a in atoms)/len(atoms),\n            sum(a['z'] for a in atoms)/len(atoms))\n\ndef analyze_residue(atoms, chain, resi, label, cutoff=6.0):\n    pep_atoms = [a for a in atoms if a['chain'] == chain and a['resi'] == resi]\n    if not pep_atoms:\n        print(f\"\\n--- {label} POS {resi}: not found ---\")\n        return\n    \n    resn = pep_atoms[0]['resn']\n    print(f\"\\n{'='*60}\")\n    print(f\"{label} Position {resi} ({resn})\")\n    print(f\"{'='*60}\")\n    \n    # Sidechain atoms\n    ca = [a for a in pep_atoms if a['name'] == 'CA']\n    cb = [a for a in pep_atoms if a['name'] == 'CB']\n    cg = [a for a in pep_atoms if a['name'] == 'CG']\n    cd1 = [a for a in pep_atoms if a['name'] == 'CD1']\n    cd2 = [a for a in pep_atoms if a['name'] == 'CD2']\n    ce1 = [a for a in pep_atoms if a['name'] == 'CE1']\n    ce2 = [a for a in pep_atoms if a['name'] == 'CE2']\n    cz = [a for a in pep_atoms if a['name'] == 'CZ']\n    \n    # Get receptor atoms within cutoff\n    nearby = []\n    for pa in pep_atoms:\n        for ra in atoms:\n            if ra['chain'] != chain:\n                d = dist(pa, ra)\n                if d < cutoff:\n                    nearby.append((d, ra, pa))\n    \n    nearby.sort(key=lambda x: x[0])\n    rec_res = defaultdict(list)\n    for d, ra, pa in nearby:\n        key = f\"{ra['chain']}-{ra['resi']}-{ra['resn']}\"\n        rec_res[key].append((d, pa['name'], ra['name']))\n    \n    charged_set = {'ARG','LYS','ASP','GLU'}\n    hydrophobic_set = {'ALA','VAL','LEU','ILE','PHE','TRP','MET','PRO'}\n    aro_set = {'PHE','TYR','TRP','HIS'}\n    \n    print(f\"  Receptor residues within {cutoff}\u00c5:\")\n    for rr in sorted(rec_res, key=lambda x: min(d for d,_,_ in rec_res[x])):\n        dists = rec_res[rr]\n        mind = min(d for d,_,_ in dists)\n        close_contacts = [d for d,_,_ in dists if d < 4.0]\n        resn_rr = rr.split('-')[2]\n        sign = '+/-' if resn_rr in charged_set else ('\u03a6' if resn_rr in hydrophobic_set else ('\u03c0' if resn_rr in aro_set else '~'))\n        print(f\"    {rr:22s} {sign}  min={mind:.1f}\u00c5  contacts<4\u00c5: {len(close_contacts)}\")\n    \n    # Measure pocket dimensions in the CB\u2192CZ direction\n    if cb and cz:\n        # Direction from CB to CZ (along the ring axis)\n        vec = (cz[0]['x'] - cb[0]['x'], cz[0]['y'] - cb[0]['y'], cz[0]['z'] - cb[0]['z'])\n        vec_len = math.sqrt(vec[0]**2 + vec[1]**2 + vec[2]**2)\n        vec_unit = (vec[0]/vec_len, vec[1]/vec_len, vec[2]/vec_len)\n        print(f\"  Ring axis (CB\u2192CZ): length={vec_len:.1f}\u00c5, direction=({vec_unit[0]:.2f},{vec_unit[1]:.2f},{vec_unit[2]:.2f})\")\n        \n        # What receptor atoms are near CZ?\n        cz_nearby = [(dist(cz[0], ra), ra) for ra in atoms if ra['chain'] != chain]\n        cz_nearby.sort()\n        print(f\"  CZ nearest receptor atoms:\")\n        for d, ra in cz_nearby[:3]:\n            print(f\"    {ra['chain']}-{ra['resi']}-{ra['resn']} {ra['name']:5s}  {d:.1f}\u00c5\")\n    \n    # For checking if PHE would fit at RKALQ position 3\n    if ca:\n        # Measure void space in CB direction\n        cb_dir = None\n        if cb:\n            cb_dir = (cb[0]['x'] - ca[0]['x'], cb[0]['y'] - ca[0]['y'], cb[0]['z'] - ca[0]['z'])\n        elif cg:  # for residues without CB (unlikely but handle)\n            cb_dir = (cg[0]['x'] - ca[0]['x'], cg[0]['y'] - ca[0]['y'], cg[0]['z'] - ca[0]['z'])\n        \n        if cb_dir:\n            dir_len = math.sqrt(cb_dir[0]**2 + cb_dir[1]**2 + cb_dir[2]**2)\n            dir_unit = (cb_dir[0]/dir_len, cb_dir[1]/dir_len, cb_dir[2]/dir_len)\n            print(f\"  CA\u2192CB direction: ({dir_unit[0]:.2f},{dir_unit[1]:.2f},{dir_unit[2]:.2f})\")\n            \n            # Check distance to nearest receptor atom along this direction\n            for mult in [2.0, 4.0, 5.0, 6.0]:\n                probe = (ca[0]['x'] + dir_unit[0]*mult, \n                         ca[0]['y'] + dir_unit[1]*mult, \n                         ca[0]['z'] + dir_unit[2]*mult)\n                nearest_d = min(math.sqrt((probe[0]-ra['x'])**2 + (probe[1]-ra['y'])**2 + (probe[2]-ra['z'])**2) \n                               for ra in atoms if ra['chain'] != chain)\n                if nearest_d > 2.5:\n                    print(f\"  Void check: {mult:.0f}\u00c5 along CB dir \u2192 nearest receptor atom: {nearest_d:.1f}\u00c5\")\n                else:\n                    print(f\"  Clash check: {mult:.0f}\u00c5 along CB dir \u2192 nearest receptor atom: {nearest_d:.1f}\u00c5 (CLASH)\")\n\n# TGFMALQ PHE3 environment\nprint(\"TGFMALQ PHE3 \u2014 the dominant anchor (-26.60)\")\natoms_tgf = parse_pdb('projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\nanalyze_residue(atoms_tgf, 'B', 3, 'TGFMALQ')\n\n# RKALQ ALA3 environment \u2014 can PHE fit?\nprint(\"\\n\\nRKALQ ALA3 \u2014 check if PHE would fit\")\natoms_rka = parse_pdb('projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\nanalyze_residue(atoms_rka, 'B', 3, 'RKALQ')\n\n# Also measure: what is the minimum distance from RKALQ CB to the nearest receptor atom?\n# And what's the distance from the hypothetical ring position\nprint(\"\\n\\n=== PHE ring size check ===\")\n# A typical PHE has: CA-CB ~1.53\u00c5, CB-CG ~1.51\u00c5, CG-CD ~1.39\u00c5 ring, total ~5-6\u00c5 from CA to ring edge\nprint(\"PHE ring radius from CA: ~4-6\u00c5 (CA\u2192CB\u2192CG\u2192ring centroid\u2192edge)\")\nprint(\"CB to ring centroid: ~3-4\u00c5\")\nprint(\"ALA methyl from CA: ~2.5\u00c5\")\n# ALA CB is at ~2.5\u00c5 from CA with methyl ~1.5\u00c5 out \u2192 total reach ~3-4\u00c5\n# PHE CG is at ~4\u00c5 from CA with ring extending to ~6\u00c5\n\nPYEOF"}

{"event_type":"tool_success","timestamp":"2026-06-03T14:07:51.384276Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":243,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-03T14:08:05.060886Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFQRQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\nPEPTIDE = [('B','LYS',647),('B','PHE',648),('B','GLN',649),('B','ARG',650),('B','GLN',651)]\nPEP_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLN',649):'Q3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\nKFERQ_NAMES = {('B','LYS',647):'K1', ('B','PHE',648):'F2', ('B','GLU',649):'E3', ('B','ARG',650):'R4', ('B','GLN',651):'Q5'}\n\n# Analyze all clusters\nclusters = {1:['cluster_1_model_%d.pdb.gz'%i for i in range(1,5)],\n            2:['cluster_2_model_%d.pdb.gz'%i for i in range(1,5)],\n            3:['cluster_3_model_%d.pdb.gz'%i for i in range(1,5)],\n            4:['cluster_4_model_%d.pdb.gz'%i for i in range(1,5)]}\n\nfor cid in [1, 2, 3, 4]:\n    print(f'=== KFQRQ Cluster {cid} ===')\n    all_dists = defaultdict(list)\n    pocket = set()\n    \n    for mf in clusters[cid]:\n        atoms = read_pdb(mf)\n        for pk, pxyz in atoms.items():\n            if pk[0] != 'B': continue\n            pres = (pk[0], pk[1], pk[2])\n            if pres not in PEPTIDE: continue\n            pname = PEP_NAMES.get(pres)\n            for rk, rxyz in atoms.items():\n                if rk[0] != 'A': continue\n                d = dist(pxyz, rxyz)\n                if d <= 5.0:\n                    rres = (rk[0], rk[1], rk[2])\n                    all_dists[(pres, rres)].append(d)\n                    pocket.add(rres)\n    \n    # Per peptide residue, best contacts\n    for pres in PEPTIDE:\n        pname = PEP_NAMES[pres]\n        contacts = []\n        for (p, r), dists in all_dists.items():\n            if p == pres:\n                avg_d = sum(dists)/len(dists)\n                contacts.append((r, avg_d, min(dists)))\n        contacts.sort(key=lambda x: x[1])\n        \n        print(f'  {pname}: ', end='')\n        top = [f'{r[1]}{r[2]}({c[2]:.1f}A)' for c in contacts[:5] if c[2] <= 3.5]\n        if top:\n            print(', '.join(top))\n        else:\n            print('no contacts < 3.5A')\n    \n    # Mutation site contacts specifically\n    print(f'  Q3 (mutated E3\u2192Q) best contacts: ', end='')\n    q3_contacts = []\n    for (p, r), dists in all_dists.items():\n        if p == ('B','GLN',649):\n            avg_d = sum(dists)/len(dists)\n            q3_contacts.append((r, avg_d, min(dists)))\n    q3_contacts.sort(key=lambda x: x[1])\n    top_q3 = [(f'{r[1]}{r[2]}', c[2]) for c in q3_contacts if c[2] <= 4.0]\n    for rn, d in top_q3[:6]:\n        print(f'  {rn}: {d:.1f}A', end='')\n    print()\n    print()\nPYEOF\n"}

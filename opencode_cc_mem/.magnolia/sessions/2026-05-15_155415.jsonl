{"event_type":"tool_call","timestamp":"2026-06-09T11:58:08.577588Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport re\n\nZ11_NAMES = ['Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH']\n# Indices in alphabetical SDF order: Z11-16-Ac=30, Z11-16-Ald=31, Z11-16-COOH=32, Z11-16-OH=33\n\ndef parse_log(path):\n    with open(path) as f: text = f.read()\n    blocks = text.split('mode |  affinity')\n    dock = []\n    for block in blocks[1:]:\n        for line in block.strip().split('\\n'):\n            m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n            if m: dock.append((float(m.group(2)),float(m.group(4)),float(m.group(5)))); break\n    return dock\n\nruns = {\n    \"TRS rigid (20\u00c5)\":     (\"gnina_dock_v3.out\",     0,  0),\n    \"P2Rank rigid (20\u00c5)\":  (\"gnina_p2rank_box.out\",   12, 0),\n    \"P2Rank flex 4res (24\u00c5)\": (\"gnina_flex_res.out\",  5,  0),\n}\n\nprint(f\"{'Z11-16 compound':<15s} {'Exp Kd':>8s}\", end=\"\")\nfor label in runs:\n    print(f\"  {label[:14]:>14s}\", end=\"\")\nprint()\nprint(\"-\" * 80)\n\nfor comp_idx, zname in enumerate(Z11_NAMES):\n    print(f\"{zname:<15s}\", end=\"\")\n    # Get experimental Kd from first run's info\n    if comp_idx == 0:\n        import json\n        with open('compounds.json') as f: exp = json.load(f)\n        exp_lk = {c['name']: c.get('kd_obp3',999) for c in exp}\n        kd = exp_lk.get(zname, 999)\n        print(f\" {kd:>8.3f}\", end=\"\")\n    else:\n        print(f\" {'':>8s}\", end=\"\")\n    \n    for label, (path, _, _) in runs.items():\n        dock = parse_log(path)\n        sdf_idx = 30 + comp_idx\n        if sdf_idx < len(dock):\n            aff = dock[sdf_idx][0]\n            print(f\"  {aff:>+14.2f}\", end=\"\")\n        else:\n            print(f\"  {'N/A':>14s}\", end=\"\")\n    print()\n\n# Also show expected trend\nprint(f\"\\n{'Expected trend':<15s} {'':>8s}  {'BEST (0.35)':>14s}  {'':>14s}  {'WORST (42.6)':>14s}\")\nprint(\"  Z11-16:Ald should have most favorable (most negative) affinity\")\nprint(\"  Z11-16:Ac should have least favorable (non-binder)\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-07-01T07:58:53.698123Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /tmp\necho \"=== run with direct provider, default format, capture both streams ===\"\ntimeout 150 opencode run -m deepseek/deepseek-v4-flash \"Reply with exactly the token SMOKE_PONG and nothing else.\" >/tmp/smoke.out 2>/tmp/smoke.err\necho \"exit=$?\"\necho \"=== stdout bytes ===\" && wc -c </tmp/smoke.out\necho \"=== stderr bytes ===\" && wc -c </tmp/smoke.err\necho \"=== stdout (first 60 lines) ===\" && head -60 /tmp/smoke.out\necho \"=== stderr (first 40 lines) ===\" && head -40 /tmp/smoke.err"}
{"event_type":"tool_success","timestamp":"2026-07-01T08:01:23.745393Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":150047,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-07-01T08:01:59.823204Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef domain_contacts(run_dir, cluster_id):\n    \"\"\"Map each peptide residue to receptor domain contacts\"\"\"\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return None\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    pep_to_domains = {}  # pep_resnum -> {domain: [(rec_res, dist)]}\n    for row in reader:\n        m1 = re.match(r'A-(\\d+)-(\\w+)', row.get('res1',''))\n        m2 = re.match(r'B-(\\d+)-(\\w+)', row.get('res2',''))\n        if not m1 or not m2: continue\n        rec_num = int(m1.group(1))\n        pep_num = int(m2.group(2))\n        dist = float(row.get('shortest-dist', 999))\n        \n        # Domain classification\n        if rec_num < 390:\n            domain = \"NBD\"\n        elif rec_num <= 520:\n            domain = \"SBD\u03b2\"\n        elif rec_num <= 615:\n            domain = \"SBD\u03b1-lid\"\n        else:\n            domain = \"beyond-615\"\n        \n        if pep_num not in pep_to_domains:\n            pep_to_domains[pep_num] = {\"NBD\": [], \"SBD\u03b2\": [], \"SBD\u03b1-lid\": [], \"beyond-615\": []}\n        pep_to_domains[pep_num][domain].append((rec_num, dist))\n    \n    return pep_to_domains\n\n# Groove-only clusters for each peptide\nruns = [\n    (\"EGGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1, \"EGGFQMALT\"),\n    (\"EAGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\", 3, \"EAGFQMALT\"),\n    (\"EGGFQMAKT\", \"L8\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3, \"EGGFQMAKT\"),\n    (\"EAKFQMALT\", \"G3\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", 2, \"EAKFQMALT\"),\n    (\"EAGFQMRLT\", \"A7\u2192R\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1, \"EAGFQMRLT\"),\n    (\"EAGFQMKLT\", \"A7\u2192K\", \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", 1, \"EAGFQMKLT\"),\n]\n\n# Also include reference short peptides for comparison\nrefs = [\n    (\"TGGFQMALT (9-mer ref)\", \"ref\", \"projects/hsc70_new/runs/2026-06-16_af3_TGGFQMALT_s10000_full\", 2, \"TGGFQMALT\"),\n]\n\n# Also KFERQ (5-mer, all in SBD\u03b2) for reference\nrefs2 = [\n    (\"KFERQ (5-mer ref)\", \"ref\", \"projects/hsc70_new/runs/2026-06-16_af3_KFERQ_s5000_full\", None, \"KFERQ\"),\n]\n\nfor label, mut, d, cl, seq in runs + refs:\n    # Find best cluster if not specified\n    if cl is None:\n        for c in range(1, 10):\n            if os.path.exists(f\"{d}/output/13_contactmap/cluster{c}_interchain_contacts.tsv\"):\n                cl = c; break\n    \n    ptd = domain_contacts(d, cl)\n    if ptd is None:\n        print(f\"\\n=== {label} === NO CONTACT MAP for cluster {cl}\")\n        continue\n    \n    print(f\"\\n=== {label} ({mut}) \u2014 cluster {cl} ===\")\n    print(f\"  {'Pep pos':>6s}  {'NBD':>20s}  {'SBD\u03b2':>20s}  {'SBD\u03b1-lid':>20s}  {'beyond':>12s}\")\n    print(f\"  {'-'*85}\")\n    \n    domain_totals = {\"NBD\": 0, \"SBD\u03b2\": 0, \"SBD\u03b1-lid\": 0, \"beyond-615\": 0}\n    \n    for pep_num in sorted(ptd.keys()):\n        parts = []\n        for domain in [\"NBD\", \"SBD\u03b2\", \"SBD\u03b1-lid\", \"beyond-615\"]:\n            contacts = sorted(ptd[pep_num][domain], key=lambda x: x[1])\n            if contacts:\n                domain_totals[domain] += len(contacts)\n                # Show closest contact\n                r, dist = contacts[0]\n                parts.append(f\"{r}@{dist:.1f}\")\n                if len(contacts) > 1:\n                    parts[-1] += f\"(+{len(contacts)-1})\"\n            else:\n                parts.append(\"\u2014\")\n        print(f\"  {pep_num:>6d}  {parts[0]:>20s}  {parts[1]:>20s}  {parts[2]:>20s}  {parts[3]:>12s}\")\n    \n    print(f\"  {'TOTAL':>6s}  {domain_totals['NBD']:>20d}  {domain_totals['SBD\u03b2']:>20d}  {domain_totals['SBD\u03b1-lid']:>20d}  {domain_totals['beyond-615']:>12d}\")\nPYEOF"}

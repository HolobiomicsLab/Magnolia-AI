{"event_type":"tool_call","timestamp":"2026-07-01T07:33:20.806542Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, shutil, gzip\nfrom datetime import date\n\nruns = [\n    (\"EGGFQMAKT\", \"EGGFQMAKT_s10000\", \"cluster_3_model_1\"),\n    (\"EGGFQMART\", \"EGGFQMART_s10000\", \"cluster_1_model_1\"),\n    (\"EAKFQMALT\", \"EAKFQMALT_s10000\", \"cluster_2_model_1\"),\n    (\"EAGFQMRLT\", \"EAGFQMRLT_s10000\", \"cluster_1_model_1\"),\n    (\"EAGFQMKLT\", \"EAGFQMKLT_s10000\", \"cluster_1_model_1\"),\n]\n\ntoday = date.today().isoformat()\n\nfor label, run_dir, model in runs:\n    outdir = f\"projects/hsc70_new/runs/{today}_alascan_{label.lower()}\"\n    os.makedirs(outdir, exist_ok=True)\n    \n    # Copy complex PDB\n    src_pdb = f\"projects/hsc70_new/runs/2026-06-25_{run_dir}/output/11_seletopclusts/{model}.pdb.gz\"\n    dst_pdb = f\"{outdir}/complex.pdb\"\n    with gzip.open(src_pdb, 'rb') as src:\n        with open(dst_pdb, 'wb') as dst:\n            dst.write(src.read())\n    \n    # Get peptide chain B residue numbers\n    res_nums = set()\n    with open(dst_pdb) as f:\n        for line in f:\n            if line.startswith('ATOM') and line[21] == 'B':\n                rn = line[22:26].strip()\n                if rn.isdigit():\n                    res_nums.add(int(rn))\n    res_list = sorted(res_nums)\n    \n    # Filter out ACE (res 1) if present and scan only real residues\n    # ACE is typically res 1. We want residues 2+\n    # But let's check: if 1 is the cap, scan from 2 onward\n    min_res = min(res_list)\n    scan_res = [r for r in res_list if r > min_res] if min_res == 1 else res_list\n    \n    # Write config\n    config = f\"\"\"run_dir = \"output\"\nncores = 16\nmode = \"local\"\nmolecules = [\"complex.pdb\"]\nclean = false\n\n[topoaa]\n\n[alascan]\nresdic_B = {scan_res}\nchains = [\"A\", \"B\"]\nscan_residue = \"ALA\"\nint_cutoff = 5.0\n\"\"\"\n    with open(f\"{outdir}/config.cfg\", 'w') as f:\n        f.write(config)\n    \n    print(f\"{label}: {outdir}  res_B={scan_res}\")\nPYEOF"}

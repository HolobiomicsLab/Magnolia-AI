{"event_type":"tool_call","timestamp":"2026-06-23T14:33:25.636583Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport sqlite3, json\n\nconn = sqlite3.connect('/home/tjiang/.local/share/opencode/opencode.db')\n\n# Get the complete timeline of submit_job across ALL sessions\nall_submits = []\n\nsession_dates = {\n    'ses_14d178160ffeFCUNF8muY7i3DL': '2026-06-10',\n    'ses_14a8d1dd6ffesLHxScnqDJwwUz': '2026-06-11',\n    'ses_14a4301fcffe2zIr27rODUZ3PS': '2026-06-11',\n    'ses_1456d0e73ffe6ULEPwvHYx84J4': '2026-06-12',\n    'ses_13fc23de2ffelf2ddyTWl2olKC': '2026-06-13',\n    'ses_134c7b1a2ffeMFkXQrSHFP8Cs1': '2026-06-15',\n    'ses_1349d35caffeQYdQoegiPzSDIl': '2026-06-15',\n    'ses_130e4d4e4ffeJu5Q6ZBCByktmm': '2026-06-16',\n    'ses_12b819265ffeRiCjSRTOF2mCwU': '2026-06-17',\n    'ses_12b8117ebffeVUQKhrJh87qWNB': '2026-06-17',\n    'ses_12b670a8effezB5zYoxyPnSA46': '2026-06-17',\n    'ses_12a46493fffehueb24QomyJNE8': '2026-06-17',\n    'ses_12a373231ffeLcYS57pJqIwi68': '2026-06-17',\n    'ses_12a31596dffeU2R6yIw5W4l4yk': '2026-06-17',\n    'ses_125e030f7ffeXnTIPy3gi7ezbx': '2026-06-18',\n    'ses_120fa984affeN2zTmXpUOp3es8': '2026-06-19',\n    'ses_11186eec2ffe47heamLxUwWbfN': '2026-06-22',\n    'ses_1112f1045ffeaXFZuHiIouAkDM': '2026-06-22',\n    'ses_111257958ffe11RGJcUGSOER9m': '2026-06-22',\n    'ses_10bc31326ffeTnbvzCh53fUJnF': '2026-06-23',\n    'ses_10bbac41affe71w1NKzuwR3QGR': '2026-06-23',\n}\n\nfor sess_id, date in session_dates.items():\n    rows = conn.execute('''\n        SELECT p.data, m.data, p.time_created\n        FROM part p JOIN message m ON p.message_id = m.id\n        WHERE p.session_id = ?\n        ORDER BY p.time_created\n    ''', [sess_id]).fetchall()\n    \n    if not rows:\n        continue\n    \n    for p_data, m_data, ts in rows:\n        try:\n            part = json.loads(p_data)\n            if part.get('type') != 'tool':\n                continue\n            tool_name = part.get('tool', '')\n            if 'submit_job' not in tool_name:\n                continue\n            \n            state = part.get('state', {})\n            tool_input = state.get('input', {})\n            if not isinstance(tool_input, dict):\n                continue\n            \n            sched = tool_input.get('scheduler', '?')\n            cmd = str(tool_input.get('command', '?'))\n            nc = tool_input.get('ncores', '?')\n            mem = tool_input.get('memory', '?')\n            tl = tool_input.get('time_limit', '?')\n            pt = tool_input.get('partition', '?')\n            tool = tool_input.get('tool', '?')\n            jn = tool_input.get('job_name', '?')\n            wd = tool_input.get('working_dir', '?')\n            \n            # Extract sampling from cmd or job_name\n            sampling = '?'\n            import re\n            m = re.search(r's(\\d{4,6})', str(cmd) + str(jn))\n            if m:\n                sampling = f's{m.group(1)}'\n            \n            # Extract peptide name from job_name\n            peptide = jn\n            \n            all_submits.append({\n                'date': date, 'sess': sess_id[:20], 'jn': jn,\n                'nc': nc, 'mem': mem, 'tl': tl, 'pt': pt,\n                'sched': sched, 'sampling': sampling, 'tool': tool,\n                'peptide': peptide\n            })\n        except:\n            pass\n\n# Print timeline sorted by date\nprint(f'Total submit_job calls: {len(all_submits)}')\nprint()\n\n# Group by date\ndates_seen = set()\nfor s in sorted(all_submits, key=lambda x: x['date']):\n    d = s['date']\n    if d not in dates_seen:\n        dates_seen.add(d)\n        print(f'\\n--- {d} ---')\n    print(f\"  [{s['sched']}] {s['jn'][:50]:50s} nc={s['nc']} mem={s['mem']:6s} time={s['tl']:>10s} part={s['pt']:>10s} samp={s['sampling']}\")\n\nconn.close()\nPYEOF\n 2>&1 | head -300"}

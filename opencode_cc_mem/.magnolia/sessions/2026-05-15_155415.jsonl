{"event_type":"tool_call","timestamp":"2026-06-21T10:27:26.207964Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/studium/studium && .venv/bin/python <<'PYEOF'\nimport fitz, re\npdf = fitz.open('courses_raw_input/l1-courschimie-smd.pdf')\n\n# Reusable page-header/footer strings to filter (appear on every page)\nHEADER_FOOTER = {\n    \"Spectroscopies\", \"Structure des mol\u00e9cules\", \"Interactions intermol\u00e9culaires\",\n    \"Nicolas Ch\u00e9ron\", \"PSL \u2013 Licence SMD \u2013 L1 Chimie \u2013 2024-2025\",\n    \"PSL \u2013 Licence Sciences pour un Monde Durable \u2013 2024-2025\",\n}\n\ndef is_garbage(text: str) -> bool:\n    s = text.strip()\n    if not s: return True\n    if s in HEADER_FOOTER: return True\n    if s.isdigit(): return True  # page number\n    # mostly equation: <25% of chars inside real words\n    words = re.findall(r\"[A-Za-z\u00c0-\u00ff]{3,}\", s)\n    return len(s) > 4 and sum(len(w) for w in words) / len(s) < 0.25\n\ndef is_figure_label(text: str) -> bool:\n    return bool(re.match(r\"^(Figure|Fig\\.|Tableau|Table|Sch\u00e9ma)\\s*\\d+\", text.strip(), re.IGNORECASE))\n\n# Per page, iterate over blocks (\u2248 paragraphs), then lines/spans inside each block.\n# Join lines within a block with a space to reconstruct the paragraph.\nmd_lines = [\n    \"# Spectroscopies \u2014 UV-Visible et Infra-Rouge\",\n    \"\",\n    \"_Source : \u00ab Introduction \u00e0 la chimie \u00bb, Nicolas Ch\u00e9ron, PSL \u2014 Licence Sciences pour un Monde Durable, 2024-2025, chapitre Spectroscopies (p.80-92)._\",\n    \"\",\n]\n\nfor pno in range(79, 92):  # pages 80-92 (1-indexed)\n    page = pdf[pno]\n    d = page.get_text('dict')\n    for block in d.get('blocks', []):\n        # First: detect the block's dominant font size (heading vs body)\n        block_spans = [s for line in block.get('lines', []) for s in line.get('spans', [])]\n        if not block_spans: continue\n        max_size = max(s['size'] for s in block_spans)\n        # Reconstruct the block's full text\n        block_lines = []\n        for line in block.get('lines', []):\n            ln_text = ''.join(s['text'] for s in line.get('spans', [])).strip()\n            if ln_text and not is_garbage(ln_text) and not is_figure_label(ln_text):\n                block_lines.append(ln_text)\n        if not block_lines: continue\n        text = ' '.join(block_lines)\n        # Apply heading levels based on dominant font size\n        title_only = re.sub(r\"^\\s*\\d+\\)\\s+\", \"\", text)\n        title_only = re.sub(r\"^\\s*\\d+\\.\\s+\", \"\", title_only)\n        if max_size >= 19:\n            continue  # chapter 20pt \u2014 H1 already added above\n        elif max_size >= 15:\n            md_lines.append(f\"## {title_only}\")\n            md_lines.append(\"\")\n        elif max_size >= 13 and re.match(r\"^\\s*\\d+\\.\\s+\", text):\n            md_lines.append(f\"### {title_only}\")\n            md_lines.append(\"\")\n        else:\n            md_lines.append(text)\n            md_lines.append(\"\")\n\n# Collapse 3+ blank lines\noutput = re.sub(r\"\\n{3,}\", \"\\n\\n\", \"\\n\".join(md_lines)).strip() + \"\\n\"\nprint(f\"output: {len(output)} chars (~{len(output)//5} tokens)\")\nwith open(\"eval/corpus/04-spectroscopies.md\", \"w\", encoding=\"utf-8\") as f:\n    f.write(output)\nPYEOF\necho \"=== preview 30 lines + structure ===\" && head -40 eval/corpus/04-spectroscopies.md; echo \"...\"; grep \"^##\" eval/corpus/04-spectroscopies.md | head"}

{"event_type":"tool_call","timestamp":"2026-07-01T08:03:08.268855Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\ndef domain_summary(run_dir, cluster_id):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cluster_id}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Per-peptide-residue domain assignment\n    pep_domain = {}  # pep_num -> set of domains\n    domain_residues = {\"NBD\": set(), \"SBD\u03b2\": set(), \"SBD\u03b1-lid\": set(), \"beyond-615\": set()}\n    domain_contacts_count = {\"NBD\": 0, \"SBD\u03b2\": 0, \"SBD\u03b1-lid\": 0, \"beyond-615\": 0}\n    \n    for row in reader:\n        parts1 = row.get('res1','').strip().split('-')\n        parts2 = row.get('res2','').strip().split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1])\n            pep_num = int(parts2[1])\n        except ValueError:\n            continue\n        \n        if rec_num < 390: domain = \"NBD\"\n        elif rec_num <= 520: domain = \"SBD\u03b2\"\n        elif rec_num <= 615: domain = \"SBD\u03b1-lid\"\n        else: domain = \"beyond-615\"\n        \n        domain_residues[domain].add(rec_num)\n        domain_contacts_count[domain] += 1\n        if pep_num not in pep_domain:\n            pep_domain[pep_num] = set()\n        pep_domain[pep_num].add(domain)\n    \n    return pep_domain, domain_residues, domain_contacts_count\n\nruns = [\n    (\"EGGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\", 1, \"EGGFQMALT\"),\n    (\"EAGFQMALT\", \"parent\", \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\", 3, \"EAGFQMALT\"),\n    (\"EGGFQMAKT\", \"L8\u2192K\",   \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\", 3, \"EGGFQMAKT\"),\n    (\"EAKFQMALT\", \"G3\u2192K\",   \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\", 2, \"EAKFQMALT\"),\n    (\"EAGFQMRLT\", \"A7\u2192R\",   \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\", 1, \"EAGFQMRLT\"),\n    (\"EAGFQMKLT\", \"A7\u2192K\",   \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\", 1, \"EAGFQMKLT\"),\n]\n\nprint(f\"{'Peptide':<14s} {'Mut':>6s} {'Cl':>3s}  {'NBD':>4s} {'SBD\u03b2':>5s} {'lid':>4s} {'beyond':>6s}  | {'NBD residues':>18s} {'lid residues':>18s}  {'spanning?':>10s}\")\nprint(\"-\" * 100)\n\nfor label, mut, d, cl, seq in runs:\n    result = domain_summary(d, cl)\n    if result is None:\n        print(f\"{label:<14s} {mut:>6s} {cl:>3d}  \u2014 no contact map\")\n        continue\n    pep_domain, dr, dc = result\n    \n    nbd_str = \",\".join(str(r) for r in sorted(dr[\"NBD\"])[:6]) if dr[\"NBD\"] else \"\u2014\"\n    lid_str = \",\".join(str(r) for r in sorted(dr[\"SBD\u03b1-lid\"])[:6]) if dr[\"SBD\u03b1-lid\"] else \"\u2014\"\n    \n    multi = dr[\"NBD\"] or dr[\"SBD\u03b1-lid\"] or dr[\"beyond-615\"]\n    spanning = \"YES\" if multi else \"SBD\u03b2-only\"\n    \n    print(f\"{label:<14s} {mut:>6s} {cl:>3d}  {dc['NBD']:>4d} {dc['SBD\u03b2']:>5d} {dc['SBD\u03b1-lid']:>4d} {dc['beyond-615']:>6d}  | {nbd_str:>18s} {lid_str:>18s}  {spanning:>10s}\")\n\n# Now show per-residue domain mapping for the most interesting cases\nprint(\"\\n\\n=== Per-residue domain mapping ===\")\nprint(f\"{'Peptide':<14s} {'Mut':>6s}  \", end=\"\")\nfor i in range(2, 11):\n    print(f\"  B{i:d}\", end=\"\")\nprint(\"  spanning?\")\nprint(\"-\" * 90)\n\nfor label, mut, d, cl, seq in runs:\n    result = domain_summary(d, cl)\n    if result is None: continue\n    pep_domain, dr, dc = result\n    \n    cells = []\n    for pep_num in range(2, 11):\n        if pep_num in pep_domain:\n            domains = pep_domain[pep_num]\n            if \"NBD\" in domains and \"SBD\u03b2\" in domains:\n                cells.append(\"NBD+S\u03b2\")\n            elif \"NBD\" in domains:\n                cells.append(\"NBD\")\n            elif \"SBD\u03b1-lid\" in domains and \"SBD\u03b2\" in domains:\n                cells.append(\"lid+S\u03b2\")\n            elif \"SBD\u03b1-lid\" in domains:\n                cells.append(\"lid\")\n            elif \"SBD\u03b2\" in domains:\n                cells.append(\"S\u03b2\")\n            else:\n                cells.append(\"?\")\n        else:\n            cells.append(\"\u2014\")\n    \n    multi = any(\"NBD\" in c or \"lid\" in c for c in cells)\n    print(f\"{label:<14s} {mut:>6s}  \", end=\"\")\n    for c in cells:\n        print(f\"  {c:>4s}\", end=\"\")\n    print(f\"  {'YES' if multi else 'no'}\")\nPYEOF"}

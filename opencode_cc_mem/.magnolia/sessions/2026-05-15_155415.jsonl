{"event_type":"tool_call","timestamp":"2026-07-01T07:46:21.204673Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_contacts(run_dir):\n    \"\"\"Find available cluster interchain contacts files and parse them\"\"\"\n    cm_dir = f\"{run_dir}/output/13_contactmap\"\n    if not os.path.isdir(cm_dir):\n        return {}\n    \n    results = {}\n    for fname in sorted(os.listdir(cm_dir)):\n        if not fname.endswith('_interchain_contacts.tsv'):\n            continue\n        cl_id = fname.replace('cluster','').replace('_interchain_contacts.tsv','')\n        if not cl_id.isdigit():\n            continue\n        fpath = os.path.join(cm_dir, fname)\n        with open(fpath) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        rec_res = set()\n        pep_res = set()\n        for row in reader:\n            m = re.match(r'A-(\\d+)-', row.get('res1',''))\n            if m: rec_res.add(int(m.group(1)))\n            m = re.match(r'B-(\\d+)-', row.get('res2',''))\n            if m: pep_res.add(int(m.group(1)))\n        results[int(cl_id)] = (rec_res, pep_res)\n    return results\n\n# Parents\nparents = {\n    \"EGGFQMALT cl1\": \"projects/hsc70_new/runs/2026-06-24_EGGFQMALT_s10000\",\n    \"EAGFQMALT cl3\": \"projects/hsc70_new/runs/2026-06-24_EAGFQMALT_s10000\",\n}\n\n# Mutants  \nmutants = {\n    \"EGGFQMAKT\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMAKT_s10000\",\n    \"EGGFQMART\": \"projects/hsc70_new/runs/2026-06-25_EGGFQMART_s10000\",\n    \"EAKFQMALT\": \"projects/hsc70_new/runs/2026-06-25_EAKFQMALT_s10000\",\n    \"EAGFQMRLT\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMRLT_s10000\",\n    \"EAGFQMKLT\": \"projects/hsc70_new/runs/2026-06-25_EAGFQMKLT_s10000\",\n}\n\nprint(\"=== RECEPTOR CONTACT ZONES COMPARISON ===\")\nprint()\n\nfor label, d in parents.items():\n    contacts = get_contacts(d)\n    for cl, (rec_res, pep_res) in sorted(contacts.items()):\n        sorted_rr = sorted(rec_res)\n        nbd = [r for r in sorted_rr if r < 390]\n        sbd_b = [r for r in sorted_rr if 390 <= r <= 520]\n        lid = [r for r in sorted_rr if 520 < r <= 615]\n        beyond = [r for r in sorted_rr if r > 615]\n        print(f\"  {label}: nbd={len(nbd)} sbdB={len(sbd_b)} lid={len(lid)} beyond={len(beyond)} | total={len(rec_res)} rec residues\")\n        print(f\"    sbdB range: {min(sbd_b) if sbd_b else '-'}-{max(sbd_b) if sbd_b else '-'}\")\n\nprint()\n\nfor label, d in mutants.items():\n    contacts = get_contacts(d)\n    for cl, (rec_res, pep_res) in sorted(contacts.items()):\n        sorted_rr = sorted(rec_res)\n        nbd = [r for r in sorted_rr if r < 390]\n        sbd_b = [r for r in sorted_rr if 390 <= r <= 520]\n        lid = [r for r in sorted_rr if 520 < r <= 615]\n        beyond = [r for r in sorted_rr if r > 615]\n        print(f\"  {label} cl{cl}: nbd={len(nbd)} sbdB={len(sbd_b)} lid={len(lid)} beyond={len(beyond)} | total={len(rec_res)} rec residues\")\n        if sbd_b:\n            print(f\"    sbdB range: {min(sbd_b)}-{max(sbd_b)}\")\n\n# Now compare the specific receptor residues in sbdB\nprint(\"\\n=== SBDbeta core residues (4PO2 reference: 403-440,460,469,473) ===\")\ncore = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n\nfor label, d in {**parents, **mutants}.items():\n    contacts = get_contacts(d)\n    if not contacts:\n        continue\n    cl = min(contacts.keys())  # first cluster\n    rec_res, _ = contacts[cl]\n    overlap = rec_res & core\n    missing = core - rec_res\n    print(f\"  {label} cl{cl}: {len(overlap)}/{len(core)} core residues matched, missing: {sorted(missing)[:5]}...\")\nPYEOF"}

esi)] = (min(dists), sum(dists)/len(dists), len(dists))\n    return results\n\nLYS_NZ = ['NZ','HZ1','HZ2','HZ3']\nLYS_ALL = LYS_NZ + ['CE','CD']\nPHE_RING = ['CG','CD1','CD2','CE1','CE2','CZ']\nARG_GUAN = ['NH1','NH2','NE','CZ','HH11','HH12','HH21','HH22']\nSER_OG = ['OG','HG']\nTHR_OG = ['OG1','HG1']\nASP_COO = ['OD1','OD2']\nILE_CG = ['CG1','CG2','CD1']\nGLY_CA = ['CA','N']\nASN_OD = ['OD1','ND2','HD21','HD22']\n\nKFERQ_MODELS = ['cluster_1_model_%d.pdb.gz'%i for i in range(1,5)]\nKFQKQ_MODELS = ['/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFQKQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_%d.pdb.gz'%i for i in range(1,5)]\n\nprint('=== K1(LYS647) contact verification ===')\nprint()\nprint('--- KFERQ K1 targets ---')\nfor t_resn, t_resi, t_atoms in [\n    ('ASP',366,ASP_COO), ('THR',37,THR_OG), ('ASN',364,ASN_OD), ('ARG',342,LYS_NZ),\n    ('SER',276,SER_OG), ('ARG',272,ARG_GUAN), ('SER',275,SER_OG)\n]:\n    dists = []\n    for mp in KFERQ_MODELS:\n        atoms = read_pdb(mp)\n        d = min_dist(atoms, 'B', 'LYS', 647, LYS_NZ, t_resn, t_resi, t_atoms)\n        if d: dists.append(d)\n    if dists:\n        label = f'KFERQ K1 \u2192 {t_resn}{t_resi}'\n        print(f'  {label:<25s}  min {min(dists):.1f}A  avg {sum(dists)/len(dists):.1f}A ({len(dists)}/4)')\n\nprint()\nprint('--- KFQKQ K1 targets ---')\nfor t_resn, t_resi, t_atoms in [\n    ('ASP',366,ASP_COO), ('THR',37,THR_OG), ('ASN',364,ASN_OD), ('ARG',342,LYS_NZ),\n    ('SER',276,SER_OG), ('ARG',272,ARG_GUAN), ('SER',275,SER_OG)\n]:\n    dists = []\n    for mp in KFQKQ_MODELS:\n        atoms = read_pdb(mp)\n        d = min_dist(atoms, 'B', 'LYS', 647, LYS_NZ, t_resn, t_resi, t_atoms)\n        if d: dists.append(d)\n    if dists:\n        label = f'KFQKQ K1 \u2192 {t_resn}{t_resi}'\n        print(f'  {label:<25s}  min {min(dists):.1f}A  avg {sum(dists)/len(dists):.1f}A ({len(dists)}/4)')\n\nprint()\nprint('=== F2(PHE648) contact verification ===')\nprint()\np
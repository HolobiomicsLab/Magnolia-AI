{"event_type":"tool_call","timestamp":"2026-06-09T11:53:21.620698Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport gzip\n\nASN_ND2 = (37.7, -29.2, 0.5)\nASN_CG = (37.3, -30.2, -0.3)\n\nwith gzip.open('docked_bridge_Z11.sdf.gz', 'rt') as f:\n    mols = f.read().strip().split('$$$$\\n')\n\nprint(\"\u2550\u2550\u2550 Z11-16:Ald \u2014 Bridge box + 15 flex residues \u2550\u2550\u2550\")\nfor pose_i in range(min(10, len(mols))):\n    mol = mols[pose_i].strip()\n    if not mol: continue\n    lines = mol.split('\\n')\n    try: natoms = int(lines[3][:3].strip())\n    except: continue\n    \n    # Collect all atoms\n    coords = []\n    o_coords = []\n    for j in range(4, 4 + natoms):\n        l = lines[j]\n        if len(l) < 34: continue\n        try:\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            elem = l[31:34].strip()\n            coords.append((x, y, z))\n            if elem == 'O':\n                o_coords.append((x, y, z))\n        except: continue\n    \n    if not coords: continue\n    \n    # Centroid\n    cx = sum(a[0] for a in coords) / len(coords)\n    cy = sum(a[1] for a in coords) / len(coords)\n    cz = sum(a[2] for a in coords) / len(coords)\n    \n    # Distance to Asn90\n    dist_to_cg = ((cx-ASN_CG[0])**2 + (cy-ASN_CG[1])**2 + (cz-ASN_CG[2])**2)**0.5\n    \n    # Min O-ND2 distance\n    min_ond2 = min(((x-ASN_ND2[0])**2 + (y-ASN_ND2[1])**2 + (z-ASN_ND2[2])**2)**0.5 for x,y,z in o_coords) if o_coords else 999\n    \n    hbond = \" \u2713 \u2713 \u2713 H-BOND!\" if min_ond2 < 3.5 else (\" ~ close\" if min_ond2 < 5 else \"\")\n    print(f\"  Pose {pose_i+1:2d}: centroid\u2192Asn90_CG={dist_to_cg:5.1f}\u00c5  aldehydeO\u2192ND2={min_ond2:5.1f}\u00c5{hbond}\")\n\n# Also check the scores\nprint(f\"\\n\u2550\u2550\u2550 Scores from log \u2550\u2550\u2550\")\nwith open('gnina_bridge_Z11.out') as f:\n    for line in f:\n        if 'mode |' in line or line.strip().startswith('1 ') or line.strip().startswith('   1 '):\n            print(line.rstrip())\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-09T11:53:21.855074Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":235,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T11:54:56.511841Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json, re, numpy as np\nfrom scipy.stats import spearmanr\n\nsdf_names_sorted = ['+-Carvone','--Carvone','37-Dimethyloctanol','C10-Ald','C12-Ald','C14-Ald','C16-Ald','C18-Ald',\n    'C8-Ald','Cedrol','Citral','Citralva','Citronellal','Coniferyl_aldehyde','Decanoic_acid','E2-10-Ald',\n    'Eugenol','Farnesol','Geraniol','Geranyl_acetate','Lauric_acid','Linalool','Linoleic_acid','Myristic_acid',\n    'Octanoic_acid','Oleic_acid','Palmitic_acid','Phytol','Safranal','Stearic_acid',\n    'Z11-16-Ac','Z11-16-Ald','Z11-16-COOH','Z11-16-OH','Z13-18-COOH','Z9-14-Ald','Z9-14-COOH','Z9-16-Ald','Z9-16-COOH','\u03b2-Ionone']\nname_map = {'+-Carvone':'(+)-Carvone','--Carvone':'(-)-Carvone','37-Dimethyloctanol':'3,7-Dimethyloctanol',\n    'Coniferyl_aldehyde':'Coniferyl aldehyde','Decanoic_acid':'Decanoic acid','Lauric_acid':'Lauric acid',\n    'Linoleic_acid':'Linoleic acid','Myristic_acid':'Myristic acid','Octanoic_acid':'Octanoic acid',\n    'Oleic_acid':'Oleic acid','Palmitic_acid':'Palmitic acid','Stearic_acid':'Stearic acid',\n    'Geranyl_acetate':'Geranyl acetate'}\n\n# Parse flexible docking (4 residues, P2Rank 24\u00c5)\nwith open('gnina_flex_res.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\ndock_flex = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m: dock_flex.append((float(m.group(2)),float(m.group(4)),float(m.group(5)))); break\n\n# Parse TRS rigid for comparison\nwith open('gnina_dock_v3.out') as f: text = f.read()\nblocks = text.split('mode |  affinity')\ndock_rigid = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m: dock_rigid.append((float(m.group(2)),float(m.group(4)),float(m.group(5)))); break\n\nwith open('compounds.json') as f: exp_data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\ndef compute(pairs_label, dock_data):\n    pairs = []\n    for i, fn in enumerate(sdf_names_sorted):\n        if i >= len(dock_data): break\n        name = name_map.get(fn, fn)\n        kd = exp_lk.get(name, 999)\n        pairs.append((name, kd, dock_data[i][0], dock_data[i][1], dock_data[i][2]))\n    \n    kd_a = np.array([p[1] for p in pairs])\n    aff_a = np.array([p[2] for p in pairs])\n    cnn_a = np.array([p[3] for p in pairs])\n    cnnaff_a = np.array([p[4] for p in pairs])\n    \n    rho, p = spearmanr(aff_a, kd_a)\n    rho_c, p_c = spearmanr(cnn_a, kd_a)\n    \n    GOO = [p[2] for p in pairs if p[1] < 1.0]\n    MOD = [p[2] for p in pairs if 1.0 <= p[1] < 10]\n    WEA = [p[2] for p in pairs if p[1] >= 10]\n    \n    print(f\"\\n\u2550\u2550\u2550 {pairs_label} \u2550\u2550\u2550\")\n    print(f\"  \u03c1_emp = {rho:+.4f} (p={p:.4f})   \u03c1_cnn = {rho_c:+.4f} (p={p_c:.4f})\")\n    print(f\"  Clashes: {(aff_a>0).sum()}/{len(aff_a)}\")\n    print(f\"  STRONG:      {np.mean(GOO):+.2f} \u00b1 {np.std(GOO):.2f}\")\n    print(f\"  MODERATE:    {np.mean(MOD):+.2f} \u00b1 {np.std(MOD):.2f}\")\n    print(f\"  WEAK/NON:    {np.mean(WEA):+.2f} \u00b1 {np.std(WEA):.2f}\")\n    \n    # Top 5 by affinity\n    print(f\"  Top 5 by affinity:\")\n    sorted_p = sorted(pairs, key=lambda x: x[2])\n    for name, kd, aff, cnn, _ in sorted_p[:5]:\n        cls = \"STRONG\" if kd < 1 else (\"MOD\" if kd < 10 else \"WEAK\")\n        print(f\"    {name:<22s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}  [{cls}]\")\n    \n    # Z11-16 selectivity\n    print(f\"  Z11-16 series:\")\n    for name, kd, aff, cnn, _ in pairs:\n        if 'Z11-16' in name:\n            print(f\"    {name:<15s} Kd={kd:>6.3f}  Aff={aff:>+7.2f}\")\n    \n    return rho\n\nrho_rigid = compute(\"RIGID (TRS 20\u00c5)\", dock_rigid)\nrho_flex = compute(\"FLEX 4res (P2Rank 24\u00c5)\", dock_flex)\n\nprint(f\"\\n\u2550\u2550\u2550 SUMMARY \u2550\u2550\u2550\")\nprint(f\"  Rigid:     \u03c1={rho_rigid:+.4f}\")\nprint(f\"  Flex (4):  \u03c1={rho_flex:+.4f}\")\nprint(f\"  Change:    {rho_flex - rho_rigid:+.4f}\")\nPYEOF"}

{"event_type":"tool_success","timestamp":"2026-06-17T20:16:17.003351Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":20950,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-17T20:16:31.221647Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os\n\nWD = \"projects/hsc70_new/runs/2026-06-17_mmgbsa_analysis/RKALQ_5mer\"\nSURFTEN = 0.0072\n\n# Parse sander_decomp.out\ntotal_data = {}\nsc_data = {}\nbb_data = {}\n\nwith open(os.path.join(WD, \"sander_decomp.out\")) as f:\n    lines = f.readlines()\n\n# TOTAL\nin_sec = False\nfor line in lines:\n    if \"PRINT DECOMP - TOTAL ENERGIES\" in line:\n        in_sec = True\n        continue\n    if in_sec:\n        if line.strip().startswith(\"TDC\"):\n            p = line.split()\n            rid = int(p[1])\n            total_data[rid] = {\n                \"vdw\": float(p[3]), \"eel\": float(p[4]),\n                \"pol\": float(p[5]), \"sas\": float(p[6]) * SURFTEN\n            }\n        elif line.strip() == \"\" and total_data:\n            break\n\n# SIDECHAIN\nin_sec = False\nfor line in lines:\n    if \"PRINT DECOMP - SIDECHAIN ENERGIES\" in line:\n        in_sec = True\n        continue\n    if in_sec:\n        if line.strip().startswith(\"SDC\"):\n            p = line.split()\n            rid = int(p[1])\n            sc_data[rid] = {\n                \"vdw\": float(p[3]), \"eel\": float(p[4]),\n                \"pol\": float(p[5]), \"sas\": float(p[6]) * SURFTEN\n            }\n        elif line.strip() == \"\" and sc_data:\n            break\n\n# BACKBONE\nin_sec = False\nfor line in lines:\n    if \"PRINT DECOMP - BACKBONE ENERGIES\" in line:\n        in_sec = True\n        continue\n    if in_sec:\n        if line.strip().startswith(\"BDC\"):\n            p = line.split()\n            rid = int(p[1])\n            bb_data[rid] = {\n                \"vdw\": float(p[3]), \"eel\": float(p[4]),\n                \"pol\": float(p[5]), \"sas\": float(p[6]) * SURFTEN\n            }\n        elif line.strip() == \"\" and bb_data:\n            break\n\n# Peptide residues are 647-651 in the complex prmtop\n# (1-646 = receptor, 647-651 = peptide)\n# Get residue names from the prmtop via tleap log or just use sequence\n\npep_resnames = {647: \"ARG\", 648: \"LYS\", 649: \"ALA\", 650: \"LEU\", 651: \"GLN\"}\n\nHYDROPHOBIC = {\"ALA\", \"VAL\", \"LEU\", \"ILE\", \"MET\", \"PHE\", \"TRP\", \"PRO\", \"TYR\"}\nCHARGED = {\"ARG\", \"LYS\", \"ASP\", \"GLU\", \"HIS\"}\n\n# Calculate AIR-free score (from docking)\nair_free = -79.15\n\nprint(\"=\" * 80)\nprint(f\"RKALQ PER-RESIDUE SIDECHAIN DECOMPOSITION (AIR-free={air_free:.1f})\")\nprint(\"=\" * 80)\nprint(f\"{'Pos':>3s} {'Res':>4s} {'Type':>10s} {'SC_vdw':>8s} {'SC_eel':>8s} {'SC_gas':>8s} {'SC_total':>8s} {'Verdict':>22s}\")\nprint(\"-\" * 80)\n\nall_unfavorable = []\n\nfor pr_idx, (prid, prname) in enumerate(sorted(pep_resnames.items()), 1):\n    d = sc_data.get(prid, {})\n    if not d:\n        print(f\"{pr_idx:3d} {prname:>4s}  NO DATA\")\n        continue\n    \n    sc_gas = d[\"vdw\"] + d[\"eel\"]\n    sc_total = sc_gas + d[\"pol\"] + d[\"sas\"]\n    \n    if prname in HYDROPHOBIC:\n        rtype = \"hydrophobic\"\n    elif prname in CHARGED:\n        rtype = \"charged\"\n    else:\n        rtype = \"polar\"\n    \n    if sc_gas > 5:\n        verdict = \"MUTATION TARGET\"\n    elif sc_gas > 0:\n        verdict = \"slightly unfavorable\"\n    elif rtype == \"hydrophobic\" and sc_gas < -5:\n        verdict = \"HYDROPHOBIC ANCHOR\"\n    elif rtype == \"charged\" and sc_gas < -50:\n        verdict = \"charged anchor*\"\n    elif sc_gas < -10:\n        verdict = \"favorable\"\n    else:\n        verdict = \"neutral\"\n    \n    print(f\"{pr_idx:3d} {prname:>4s} {rtype:>10s} {d['vdw']:8.1f} {d['eel']:8.1f} {sc_gas:8.1f} {sc_total:8.1f} {verdict:>22s}\")\n\nprint()\nprint(\"=\" * 80)\nprint(\"TOTAL ENERGIES (sidechain + backbone)\")\nprint(\"=\" * 80)\nprint(f\"{'Pos':>3s} {'Res':>4s} {'T_vdw':>8s} {'T_eel':>8s} {'T_pol':>8s} {'T_sas':>8s} {'T_total':>8s}\")\nprint(\"-\" * 80)\n\nfor pr_idx, (prid, prname) in enumerate(sorted(pep_resnames.items()), 1):\n    td = total_data.get(prid, {})\n    if td:\n        t_total = td[\"vdw\"] + td[\"eel\"] + td[\"pol\"] + td[\"sas\"]\n        print(f\"{pr_idx:3d} {prname:>4s} {td['vdw']:8.1f} {td['eel']:8.1f} {td['pol']:8.1f} {td['sas']:8.1f} {t_total:8.1f}\")\n\n# COMPARISON with RKDLQ baseline\nprint()\nprint(\"=\" * 80)\nprint(\"COMPARISON: RKDLQ vs RKALQ (sidechain gas-phase energy)\")\nprint(\"=\" * 80)\n\nrkd_data = {1: (\"ARG\", -238.7), 2: (\"LYS\", -35.3), 3: (\"ASP\", 6.4), 4: (\"LEU\", -23.1), 5: (\"GLN\", -47.3)}\n\nprint(f\"{'Pos':>3s} {'RKDLQ_res':>6s} {'RKDLQ_SCgas':>12s} {'RKALQ_res':>6s} {'RKALQ_SCgas':>12s} {'Delta':>8s}\")\nprint(\"-\" * 80)\n\nfor pos in range(1, 6):\n    rkd_name, rkd_val = rkd_data[pos]\n    rka_rid = 646 + pos\n    rka_name = pep_resnames[rka_rid]\n    rka_d = sc_data.get(rka_rid, {})\n    rka_val = rka_d[\"vdw\"] + rka_d[\"eel\"] if rka_d else 0\n    delta = rka_val - rkd_val\n    sign = \"+\" if delta > 0 else \"\"\n    print(f\"{pos:3d} {rkd_name:>6s} {rkd_val:12.1f} {rka_name:>6s} {rka_val:12.1f} {sign}{delta:7.1f}\")\n\nPYEOF"}

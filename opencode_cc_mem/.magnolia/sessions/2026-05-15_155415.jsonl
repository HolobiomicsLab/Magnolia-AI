{"event_type":"tool_call","timestamp":"2026-06-09T11:45:38.836332Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\n# TRS entrance: (21.14, -32.68, -2.14)\n# Asn90 CG: (37.3, -30.2, -0.3)\n# Midpoint box center \u2192 bridges entrance to binding site\ncx = (21.14 + 37.3) / 2\ncy = (-32.68 - 30.2) / 2\ncz = (-2.14 - 0.3) / 2\nprint(f\"Bridge box center: ({cx:.1f}, {cy:.1f}, {cz:.1f})\")\n\n# Merged flexible residues \u2014 paper + P2Rank pocket\nour = [39, 87, 90, 120]\np2r = [25, 39, 41, 56, 58, 71, 84, 86, 92, 105, 107, 118, 120]\nmerged = sorted(set(our + p2r))\nprint(f\"Merged flex residues ({len(merged)}): A:{','.join(map(str,merged))}\")\n\n# Check: 24\u00c5 box covers both TRS and Asn90?\nTRS = (21.14, -32.68, -2.14)\nASN = (37.3, -30.2, -0.3)\nfor name, pt in [(\"TRS\",TRS), (\"Asn90\",ASN)]:\n    in_x = cx-12 <= pt[0] <= cx+12\n    in_y = cy-12 <= pt[1] <= cy+12\n    in_z = cz-12 <= pt[2] <= cz+12\n    print(f\"  {name} inside box: x={in_x} y={in_y} z={in_z}\")\n\nprint(f\"\\nCommand:\")\nflexstr = ','.join(f'A:{r}' for r in merged)\nprint(f\"--center_x {cx:.1f} --center_y {cy:.1f} --center_z {cz:.1f} --size_x 24 --size_y 24 --size_z 24 --flexres {flexstr}\")\nPYEOF"}

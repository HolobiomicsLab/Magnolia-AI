{"event_type":"tool_call","timestamp":"2026-06-10T13:08:19.694765Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_box\n\npython3 << 'PYEOF'\nimport json, math\n\nwith open('../2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\n# Parse receptor once\nrec_atoms = []\nwith open('receptor.pdb') as rf:\n    for l in rf:\n        if not l.startswith('ATOM'): continue\n        res = l[17:20].strip()\n        rnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((res, rnum, x, y, z))\n\nligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Z11-16-OH', 'C8-Ald', 'C12-Ald', \n           '\u03b2-Ionone', 'Citral', 'Palmitic_acid']\n\nprint(f\"{'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'EmpAff':>7s} {'CNNaff':>7s} {'Asn90':>6s}\")\nprint(\"-\" * 60)\n\nfor lig in ligands:\n    fname = f'docked_{lig}_asn90.sdf'\n    c = compounds.get(lig, {})\n    ic50 = c.get('ic50_obp3', 999)\n    kd = c.get('kd_obp3', 999)\n    \n    try:\n        with open(fname) as fh:\n            content = fh.read()\n    except:\n        print(f\"{lig:16s} {ic50:>7.1f} {kd:>7.3f} {'N/A':>7s} {'N/A':>7s} {'-':>6s}\")\n        continue\n\n    blocks = content.split('$$$$')\n    best = None\n    best_asn90 = 999\n    \n    for b in blocks:\n        if not b.strip(): continue\n        lines = b.strip().split('\\n')\n        \n        # Find atom count - it's the line with \"V2000\" or look for \"  NN \" pattern\n        cnn_score = cnn_aff = emp_aff = 0\n        na = 0\n        atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l:\n                parts = l.split()\n                if parts:\n                    na = int(parts[0])\n                atom_start = j + 1\n            if l.startswith('> <CNNscore>'):\n                cnn_score = float(lines[j+1])\n            if l.startswith('> <CNNaffinity>'):\n                cnn_aff = float(lines[j+1])\n            if l.startswith('> <minimizedAffinity>'):\n                emp_aff = float(lines[j+1])\n        \n        if na == 0 or atom_start < 0:\n            continue\n            \n        if best is None or emp_aff < best[1]:\n            best = (cnn_score, emp_aff, cnn_aff)\n            \n            # Check Asn90 distance for this pose\n            min_d = 999\n            for i in range(atom_start, min(atom_start + na, len(lines))):\n                l = lines[i]\n                if len(l) < 30: continue\n                try:\n                    x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n                except: continue\n                for ra in rec_atoms:\n                    if ra[0] == 'ASN' and ra[1] == 90:\n                        d = math.sqrt((ra[2]-x)**2 + (ra[3]-y)**2 + (ra[4]-z)**2)\n                        if d < min_d: min_d = d\n            best_asn90 = min_d\n\n    if best:\n        cs, ea, ca = best\n        asn90_s = f'{best_asn90:.1f}A' if best_asn90 < 6 else 'none'\n        print(f\"{lig:16s} {ic50:>7.1f} {kd:>7.3f} {ea:>7.2f} {ca:>7.3f} {asn90_s:>6s}\")\n    else:\n        print(f\"{lig:16s} {ic50:>7.1f} {kd:>7.3f} {'N/A':>7s} {'N/A':>7s} {'-':>6s}\")\nPYEOF"}

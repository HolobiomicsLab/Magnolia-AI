{"event_type":"tool_call","timestamp":"2026-06-24T12:36:16.063790Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/2026-06-16_af3_KFERQ-KILDQ-fusion_s10000_full 2>/dev/null || cd projects/hsc70_new/runs/2026-03_KFERQ-KILDQ-fusion_p2rank1_s10000\necho \"PWD: $(pwd)\"\necho \"=== find contactmap interchain contacts (best cluster) ===\"\nf=$(find output -name 'cluster1_interchain_contacts.tsv' -o -name 'cluster_1_interchain_contacts.tsv' 2>/dev/null | head -1)\necho \"file: $f\"\nif [ -z \"$f\" ]; then f=$(find output -name '*interchain_contacts.tsv' 2>/dev/null | head -1); echo \"fallback: $f\"; fi\necho\necho \"=== receptor residues contacted by peptide (chain A resnums), mapped to NBD(1-383)/linker/SBD(384-646) ===\"\n# columns vary; try to find receptor residue column. Print unique receptor resnums contacted.\npython3 - \"$f\" <<'PY'\nimport sys,re\nfn=sys.argv[1]\nres=set()\nwith open(fn) as fh:\n    hdr=None\n    for line in fh:\n        if line.startswith('#') or not line.strip(): continue\n        cols=line.rstrip('\\n').split('\\t')\n        if hdr is None:\n            hdr={c:i for i,c in enumerate(cols)}; continue\n        # find a column holding a receptor (chain A) residue number; try common names\n        for key in ('residue2_id','residue2','residue2_resnum','resnum2','receptor_residue','res2','residue_B'):\n            if key in hdr:\n                v=cols[hdr[key]]\n                m=re.search(r'\\d+',v)\n                if m: res.add(int(m.group()))\n                break\n        else:\n            # fallback: assume two residue-id columns; take the one with larger numbers (receptor)\n            nums=[int(re.search(r'\\d+',c).group()) for c in cols if re.search(r'\\d+',c)]\n            if nums: res.add(max(nums))\nres=sorted(res)\nprint(\"contacted receptor resnums:\", res)\nnbd=[r for r in res if r<=383]; sbd=[r for r in res if r>=384]\nprint(f\"NBD (1-383): {len(nbd)} residues -> min {min(nbd) if nbd else '-'}, max {max(nbd) if nbd else '-'}\")\nprint(f\"SBD (384-646): {len(sbd)} residues -> min {min(sbd) if sbd else '-'}, max {max(sbd) if sbd else '-'}\")\nPY"}

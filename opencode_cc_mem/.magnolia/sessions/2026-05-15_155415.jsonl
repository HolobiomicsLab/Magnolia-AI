{"event_type":"tool_call","timestamp":"2026-07-01T16:28:08.154815Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv\n\ndef quick_contact_summary(run_dir, cl):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath): return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    core = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n    rec_set = set()\n    pep_to_rec = {}  # pep_pdb -> [(dist, rec_num, rec_res)]\n    \n    for row in reader:\n        p1 = row['res1'].split('-')\n        p2 = row['res2'].split('-')\n        if len(p1)<3 or len(p2)<3: continue\n        try:\n            rn=int(p1[1]); rr=p1[2]; pn=int(p2[1])\n        except: continue\n        dist=float(row['shortest-dist'])\n        rec_set.add(rn)\n        if pn not in pep_to_rec: pep_to_rec[pn]=[]\n        pep_to_rec[pn].append((dist,rn,rr))\n    \n    # Per-peptide-residue: which groove zone (404 vs 428-431 vs 460)?\n    zone_map = {}\n    for pn in sorted(pep_to_rec):\n        contacts = sorted(pep_to_rec[pn])\n        zones = set()\n        for d, rn, rr in contacts:\n            if d > 5.0: continue\n            if 400 <= rn <= 410: zones.add(\"entry(400-410)\")\n            elif 425 <= rn <= 440: zones.add(\"mid(425-440)\")\n            elif 455 <= rn <= 470: zones.add(\"deep(455-470)\")\n            elif rn > 520: zones.add(\"lid\")\n        zone_map[pn] = zones\n    \n    overlap = len(rec_set & core)\n    missing = sorted(core - rec_set)\n    has_460 = 460 in rec_set\n    has_404 = 404 in rec_set\n    \n    return overlap, missing, has_460, has_404, zone_map, pep_to_rec\n\npeptides = [\n    # (label, run_dir, cl, AF, DQ, groove%, seq_with_pdb_positions)\n    (\"EKGFQMAKT\", \"runs/2026-07-01_EKGFQMAKT_G2K_on_EGGFQMAKT_s10000\", 1, -97.29, 1.000, 52.0,\n     \"ACE\u2081-E\u2082-K\u2083-G\u2084-F\u2085-Q\u2086-M\u2087-A\u2088-K\u2089-T\u2081\u2080\"),\n    (\"EKGFQMALT\", \"runs/2026-07-01_EKGFQMALT_G2K_on_EGGFQMALT_s10000\", 5, -109.56, 1.000, 4.5,\n     \"ACE\u2081-E\u2082-K\u2083-G\u2084-F\u2085-Q\u2086-M\u2087-A\u2088-L\u2089-T\u2081\u2080\"),\n    (\"ERQKFERRQ\", \"runs/2026-07-01_ERQKFERRQ_truncated_KFERQx2_s10000\", 3, -107.60, 0.661, 39.0,\n     \"E\u2081-R\u2082-Q\u2083-K\u2084-F\u2085-E\u2086-R\u2087-R\u2088-Q\u2089\"),\n    (\"EGGFQMAKT\", \"runs/2026-06-25_EGGFQMAKT_s10000\", 3, -118.59, 0.765, 4.0,\n     \"ACE\u2081-E\u2082-G\u2083-G\u2084-F\u2085-Q\u2086-M\u2087-A\u2088-K\u2089-T\u2081\u2080\"),\n    (\"EGGFQMALT\", \"runs/2026-06-24_EGGFQMALT_s10000\", 1, -110.86, 1.000, 68.0,\n     \"ACE\u2081-E\u2082-G\u2083-G\u2084-F\u2085-Q\u2086-M\u2087-A\u2088-L\u2089-T\u2081\u2080\"),\n    (\"EAGFQMRLT\", \"runs/2026-06-25_EAGFQMRLT_s10000\", 1, -116.51, 1.000, 48.5,\n     \"ACE\u2081-E\u2082-A\u2083-G\u2084-F\u2085-Q\u2086-M\u2087-R\u2088-L\u2089-T\u2081\u2080\"),\n]\n\nprint(f\"{'Peptide':<14s} {'AF':>9s} {'DQ':>6s} {'%':>5s} {'Core':>5s} {'E460':>5s} {'E404':>5s}  Per-residue groove zone\")\nprint(\"-\" * 110)\nfor label, rd, cl, af, dq, pct, seq in peptides:\n    result = quick_contact_summary(f\"projects/hsc70_new/{rd}\", cl)\n    if not result:\n        print(f\"{label:<14s} {af:>+9.2f} {dq:>6.3f} {pct:>4.0f}%  \u2014 no contact map\")\n        continue\n    overlap, missing, has_460, has_404, zone_map, pep_to_rec = result\n    \n    # Build zone string per position\n    zones_str = \"\"\n    for pn in sorted(zone_map):\n        z = zone_map[pn]\n        if not z: zones_str += f\"  B{pn}:\u2014\"\n        else: zones_str += f\"  B{pn}:{'/'.join(sorted(z))}\"\n    \n    print(f\"{label:<14s} {af:>+9.2f} {dq:>6.3f} {pct:>4.0f}% {overlap:>4d}/19 {'Y' if has_460 else '\u2014':>5s} {'Y' if has_404 else '\u2014':>5s}  {zones_str}\")\n\nprint(f\"\\n{'Key: entry(400-410)=groove entrance, mid(425-440)=central groove, deep(455-470)=deep groove, lid=SBD\u03b1':^110s}\")\nPYEOF"}

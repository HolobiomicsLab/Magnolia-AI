{"event_type":"tool_call","timestamp":"2026-06-09T08:33:27.025283Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re\n\nPAPER_NOTES = {\n    \"Z9-14-Ald\":         \"Good ligand \u2014 fits cavity, H-bond to Asn90. Pheromone candidate.\",\n    \"Z11-16-Ald\":        \"Excellent ligand \u2014 fills entire cavity, H-bond to Asn90. Best aldehyde.\",\n    \"Z11-16-Ac\":         \"Does NOT bind \u2014 acetate group clashes with cavity.\",\n    \"Z11-16-OH\":         \"Weak binder \u2014 alcohol group cannot H-bond Asn90 like aldehyde.\",\n    \"Z9-16-Ald\":         \"Good ligand \u2014 unsaturated aldehyde, H-bond to Asn90.\",\n    \"E2-10-Ald\":         \"Moderate binder \u2014 shorter unsaturated aldehyde.\",\n    \"C8-Ald\":            \"Does NOT bind at 200 \u00b5M \u2014 saturated, too short.\",\n    \"C10-Ald\":           \"Does NOT bind at 200 \u00b5M \u2014 saturated, too short.\",\n    \"C12-Ald\":           \"Moderate binder \u2014 saturated aldehyde, borderline size.\",\n    \"C14-Ald\":           \"Weak binder \u2014 saturated, approaching optimal length.\",\n    \"C16-Ald\":           \"Does NOT bind at 200 \u00b5M \u2014 saturated C16 paradoxically worse than unsaturated.\",\n    \"C18-Ald\":           \"Does NOT bind at 200 \u00b5M \u2014 saturated, too long.\",\n    \"(-)-Carvone\":       \"Moderate binder \u2014 bamboo volatile (monoterpenoid).\",\n    \"(+)-Carvone\":       \"Moderate binder \u2014 enantiomer of carvone, slightly better than (\u2212).\",\n    \"Citral\":            \"Good ligand \u2014 bamboo volatile. Affinity improves in Ser122Ala mutant.\",\n    \"Safranal\":          \"Good ligand \u2014 bamboo volatile. Selective for AimelOBP3 over OBP5.\",\n    \"Citronellal\":       \"Moderate binder \u2014 bamboo volatile (monoterpenoid aldehyde).\",\n    \"Coniferyl aldehyde\":\"Weak binder \u2014 phenylpropanoid bamboo volatile.\",\n    \"Eugenol\":           \"Weak binder \u2014 phenylpropanoid. Much weaker in Asn90Leu mutant.\",\n    \"Citralva\":          \"Good ligand \u2014 synthetic citral analog (geranyl nitrile).\",\n    \"Linalool\":          \"Does NOT bind at 200 \u00b5M \u2014 despite being common bamboo terpenoid.\",\n    \"Geraniol\":          \"Moderate binder \u2014 bamboo volatile. Weaker than citral (aldehyde > alcohol).\",\n    \"Phytol\":            \"Does NOT bind at 200 \u00b5M \u2014 too large/bulky for cavity.\",\n    \"\u03b2-Ionone\":          \"Excellent ligand \u2014 key bamboo volatile. High affinity.\",\n    \"Geranyl acetate\":   \"Excellent ligand \u2014 but OBP5 does NOT bind it (selective).\",\n    \"3,7-Dimethyloctanol\":\"Moderate binder \u2014 saturated terpenoid alcohol.\",\n    \"Farnesol\":          \"Excellent ligand \u2014 sesquiterpene, abundant in bamboo.\",\n    \"Cedrol\":            \"Excellent ligand \u2014 high affinity. Most abundant in SPRING bamboo (mating season).\",\n    \"Octanoic acid\":     \"No binding to AimelOBP3 \u2014 fatty acids are AimelOBP5 ligands.\",\n    \"Decanoic acid\":     \"No binding to AimelOBP3 \u2014 binds AimelOBP5 (size-dependent, peak at C16).\",\n    \"Lauric acid\":       \"No binding to AimelOBP3 \u2014 binds AimelOBP5.\",\n    \"Myristic acid\":     \"No binding to AimelOBP3 \u2014 binds AimelOBP5.\",\n    \"Palmitic acid\":     \"No binding to AimelOBP3 \u2014 peak affinity for AimelOBP5 (C16).\",\n    \"Stearic acid\":      \"No binding to AimelOBP3 \u2014 weak AimelOBP5 binder.\",\n    \"Z9-16-COOH\":        \"Weak AimelOBP3 binder \u2014 unsaturated C16 acid. Good AimelOBP5 ligand.\",\n    \"Z9-14-COOH\":        \"Weak AimelOBP3 binder. Moderate AimelOBP5 ligand.\",\n    \"Z11-16-COOH\":       \"Weak AimelOBP3 binder. Good AimelOBP5 ligand.\",\n    \"Z13-18-COOH\":       \"Weak AimelOBP3 binder. Good AimelOBP5 ligand.\",\n    \"Oleic acid\":        \"No binding to AimelOBP3 at 200 \u00b5M \u2014 but good AimelOBP5 ligand (unsaturated).\",\n    \"Linoleic acid\":     \"Weak AimelOBP3 binder \u2014 good AimelOBP5 ligand (polyunsaturated).\",\n}\n\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\nblocks = text.split('mode |  affinity')\ndock_all = []\nfor block in blocks[1:]:\n    poses = []\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            poses.append({'rank': int(m.group(1)), 'affinity': float(m.group(2)),\n                'intramol': float(m.group(3)), 'cnn_pose': float(m.group(4)), 'cnn_aff': float(m.group(5))})\n    dock_all.append(poses)\n\nlines = []\n# Header\nlines.append(f\"{'#':<3s} {'Compound':<22s} {'Kd':>7s} {'Aff':>7s} {'Agree?':>7s}  Paper claims\")\nlines.append(\"-\" * 120)\n\nagree_count = 0\nfor i, c in enumerate(exp_data):\n    if i >= len(dock_all): break\n    kd = c.get('kd_obp3', 999)\n    poses = dock_all[i]\n    if not poses: continue\n    top = poses[0]\n    cls = \"STRONG\" if kd < 1.0 else (\"MOD\" if kd < 10 else (\"WEAK\" if kd < 43 else \"NON\"))\n    note = PAPER_NOTES.get(c['name'], \"\u2014\")\n    # Check agreement: non-binders should have weak gnina scores\n    # Strong binders should be better than negatives\n    agree = \"\"\n    if cls == \"STRONG\" and top['affinity'] < -3.0: agree = \"\u2713\"\n    elif cls == \"NON\" and top['affinity'] > -2.5: agree = \"\u2713\"\n    elif cls in (\"WEAK\",\"MOD\"): agree = \"~\"\n    else: agree = \"\u2717\"\n\n    lines.append(f\"{i+1:<3d} {c['name']:<22s} {kd:>7.3f} {top['affinity']:>+7.2f} {agree:>7s}  {note}\")\n\nlines.append(\"-\" * 120)\nlines.append(\"Agreement: \u2713=directionally correct  \u2717=wrong direction  ~=ambiguous\")\nlines.append(\"Paper source: Zhu et al. 2017 PNAS 114(46):E9802-E9810\")\n\nout = '\\n'.join(lines)\nwith open('docking_results_table.txt', 'w') as f: f.write(out + '\\n')\nwith open('docking_results_with_notes.txt', 'w') as f: f.write(out + '\\n')\nprint(out)\nPYEOF"}

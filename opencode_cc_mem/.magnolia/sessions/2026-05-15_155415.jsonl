{"event_type":"tool_call","timestamp":"2026-06-24T14:30:13.845463Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/measure5.py << 'PYEOF'\nimport numpy as np\natoms=[]\nwith open(\"/tmp/cl2m1.pdb\") as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"): continue\n        atoms.append(dict(an=line[12:16].strip(), rn=line[17:20].strip(),\n            ch=line[21], ri=int(line[22:26]),\n            xyz=np.array([float(line[30:38]),float(line[38:46]),float(line[46:54])]),\n            el=(line[76:78].strip() if len(line)>=78 else line[12:16].strip()[0])))\ndef atom(ch,ri,an):\n    m=[a for a in atoms if a['ch']==ch and a['ri']==ri and a['an']==an]; return m[0] if m else None\ndef d(a,b): return np.linalg.norm(a['xyz']-b['xyz'])\n\nprint(\"K415 (positive) distances to T1 / ACE cap atoms:\")\nfor ban in [\"CA\",\"CB\",\"OG1\",\"CG2\"]:\n    a=atom(\"B\",2,ban)\n    if a is None: continue\n    for ran in [\"NZ\",\"HZ1\",\"HZ2\",\"HZ3\",\"CE\"]:\n        b=atom(\"A\",415,ran)\n        if b: print(f\"  T1 {ban} ... K415 {ran}: {d(a,b):.2f} \u00c5\")\n# ACE cap\nfor ban in [\"C\",\"O\",\"CH3\",\"CA\"]:\n    a=atom(\"B\",1,ban)\n    if a is None: continue\n    b=atom(\"A\",415,\"NZ\")\n    if b: print(f\"  ACE {ban} ... K415 NZ: {d(a,b):.2f} \u00c5\")\n\nprint(\"\\nReceptor CHARGED residues (ASP/GLU/LYS/ARG) within 7 \u00c5 of each TOLERANT peptide residue:\")\ntolerant=[(1,\"ACE-cap\"),(2,\"T1\"),(3,\"G2\"),(4,\"G3\"),(6,\"Q5\"),(8,\"A7\"),(10,\"T9\")]\ncharged={}\nfor a in atoms:\n    if a['ch']!=\"A\": continue\n    if a['rn'] in (\"ASP\",\"GLU\",\"LYS\",\"ARG\") and a['el']!=\"H\":\n        charged.setdefault((a['ri'],a['rn']),[]).append(a)\nfor pri,lab in tolerant:\n    pa=[a for a in atoms if a['ch']==\"B\" and a['ri']==pri and a['el']!=\"H\"]\n    print(f\"\\n  B-{pri} ({lab}):\")\n    hits=[]\n    for (ri,rn),alist in charged.items():\n        mind=min(d(x,y) for x in pa for y in alist)\n        if mind<=7.0:\n            sign=\"(+)\" if rn in (\"LYS\",\"ARG\") else \"(-)\"\n            hits.append((ri,rn,sign,mind))\n    hits.sort(key=lambda x:x[3])\n    for ri,rn,sign,mind in hits[:6]:\n        region=\"\u03b2-groove\" if 388<=ri<=508 else (\"lid\" if 509<=ri<=613 else (\"post-lid\" if ri>613 else \"NBD\"))\n        print(f\"    A-{ri}-{rn} {sign} [{region}]  nearest {mind:.2f} \u00c5\")\nPYEOF\npython3 /tmp/measure5.py"}

{"event_type":"tool_call","timestamp":"2026-06-04T20:26:43.396820Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c # Extract clean energy decomposition for all runs - vdw, elec, desolv, air, score\n# col1=rank, col2=cl_id, col5=score, col19=air, col21=bsa, col23=desolv, col25=elec, col29=vdw\necho \"Run\tCluster\tScore\tw_vdw*vdw\tw_elec*elec\tw_desolv*desolv\tw_air*air\tvdw(raw)\telec(raw)\tdesolv(raw)\tair(raw)\tBSA\tDockQ\"\nfor f in \\\n  \"KFQRQ s5000|projects/hsc70_new/runs/2026-06-03_KFQRQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"KFQKQ s5000|projects/hsc70_new/runs/2026-06-03_KFQKQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"KFERQ s5000|projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"RKELQ s5000|projects/hsc70_new/runs/2026-06-02_RKELQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"KILDQ s5000|projects/hsc70_new/runs/2026-06-01_KILDQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"QRKEL s5000|projects/hsc70_new/runs/2026-06-02_QRKEL_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"RKDLQ s5000|projects/hsc70_new/runs/2026-06-02_RKDLQ_p2rank1_s5000/output/12_caprieval/capri_clt.tsv\" \\\n  \"KFERQx2 s10k|projects/hsc70_new/runs/2026-06-03_KFERQx2_p2rank1_s10000/output/12_caprieval/capri_clt.tsv\" \\\n  \"RKELQx2 s10k|projects/hsc70_new/runs/2026-06-03_RKELQx2_p2rank1_s10000/output/12_caprieval/capri_clt.tsv\" \\\n  \"RKDLQv s10k|projects/hsc70_new/runs/2026-06-03_RKDLQ-variant_p2rank1_s10000/output/12_caprieval/capri_clt.tsv\" \\\n  \"QRKELx2 s10k|projects/hsc70_new/runs/2026-06-03_QRKELx2_p2rank1_s10000/output/12_caprieval/capri_clt.tsv\" \\\n  \"Fusion s10k|projects/hsc70_new/runs/2026-06-03_KFERQ-KILDQ-fusion_p2rank1_s10000/output/12_caprieval/capri_clt.tsv\" \\\n; do\n  label=\"${f%%|*}\"\n  path=\"${f#*|}\"\n  grep -v '^#' \"$path\" 2>/dev/null | head -1 | awk -F'\\t' -v l=\"$label\" '{\n    score=$5; air=$19; bsa=$21; desolv=$23; elec=$25; vdw=$29; dockq=$13\n    w_vdw = vdw\n    w_elec = 0.2 * elec\n    w_desolv = desolv\n    w_air = 0.1 * air\n    air_free = score - w_air\n    printf \"%-14s cl%-3s %7.1f %7.1f %7.1f %8.1f %6.1f %8.1f %7.1f %9.1f %7.1f %6.0f %6.3f\\n\",\n      l, $2, score, w_vdw, w_elec, w_desolv, w_air, vdw, elec, desolv, air, bsa, dockq\n  }'\ndone"}

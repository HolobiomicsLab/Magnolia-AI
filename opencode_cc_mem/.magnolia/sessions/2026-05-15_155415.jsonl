{"event_type":"tool_call","timestamp":"2026-06-09T10:10:49.472687Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\n# Compute centroid of all paper-confirmed cavity residues\n# and also include their CA atoms + the entrance path\n\nkey_residues = [('ASN',90), ('GLU',120), ('MET',39), ('ASP',87), ('SER',73), ('SER',122)]\n\ncoords = []\nwith open('receptor.pdb') as f:\n    for line in f:\n        if not (line.startswith('ATOM') or line.startswith('HETATM')):\n            continue\n        rname = line[17:20].strip()\n        try: rnum = int(line[22:26].strip())\n        except: continue\n        atom = line[12:16].strip()\n        \n        for gname, gnum in key_residues:\n            if rname == gname and rnum == gnum and atom == 'CA':\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                coords.append((x, y, z))\n\ncx = sum(c[0] for c in coords) / len(coords)\ncy = sum(c[1] for c in coords) / len(coords)\ncz = sum(c[2] for c in coords) / len(coords)\n\n# Also compute the spread \u2014 how big does the box need to be?\nxs = [c[0] for c in coords]; ys = [c[1] for c in coords]; zs = [c[2] for c in coords]\nspread_x = max(xs) - min(xs)\nspread_y = max(ys) - min(ys)\nspread_z = max(zs) - min(zs)\n\n# Compare with TRS and P2Rank\nTRS = (21.141, -32.681, -2.137)\nP2R = (32.2114, -31.8694, 4.2005)\n\nprint(f\"\u2550\u2550\u2550 MANUAL BOX from paper-confirmed residues \u2550\u2550\u2550\")\nprint(f\"Residues: {key_residues}\")\nprint(f\"  CA positions:\")\nfor i, (nome, num) in enumerate(key_residues):\n    print(f\"    {nome} {num}: ({coords[i][0]:.1f}, {coords[i][1]:.1f}, {coords[i][2]:.1f})\")\n\nprint(f\"\\n  Centroid: ({cx:.1f}, {cy:.1f}, {cz:.1f})\")\nprint(f\"  Spread: \u0394x={spread_x:.1f}  \u0394y={spread_y:.1f}  \u0394z={spread_z:.1f}\")\nprint(f\"  Minimum box size to encompass residues: {max(spread_x, spread_y, spread_z)*1.3:.0f} \u00c5\")\n\nprint(f\"\\n  Distances:\")\nprint(f\"    Manual center \u2192 TRS:      {((cx-TRS[0])**2+(cy-TRS[1])**2+(cz-TRS[2])**2)**0.5:.1f} \u00c5\")\nprint(f\"    Manual center \u2192 P2Rank:   {((cx-P2R[0])**2+(cy-P2R[1])**2+(cz-P2R[2])**2)**0.5:.1f} \u00c5\")\nprint(f\"    Manual center \u2192 Asn90 CA: {((cx-36.6)**2+(cy+29.5)**2+(cz+2.6)**2)**0.5:.1f} \u00c5\")\n\n# Check: does a 24 \u00c5 box centered here cover the entrance?\nprint(f\"\\n  Box 24 \u00c5 centered on manual: [{cx-12:.1f}, {cx+12:.1f}] \u00d7 [{cy-12:.1f}, {cy+12:.1f}] \u00d7 [{cz-12:.1f}, {cz+12:.1f}]\")\nprint(f\"  Asn90 (37.3, -30.2, -0.3) \u2192 inside? x:{cx-12<=37.3<=cx+12} y:{cy-12<=-30.2<=cy+12} z:{cz-12<=-0.3<=cz+12}\")\n\n# Recommended box\nbox = max(spread_x, spread_y, spread_z) * 1.5\nprint(f\"\\n  Recommended: --center_x {cx:.1f} --center_y {cy:.1f} --center_z {cz:.1f} --size_x {box:.0f} --size_y {box:.0f} --size_z {box:.0f}\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-16T13:19:40.807977Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new && python3 << 'PYEOF'\nimport os, subprocess, gzip, glob, shutil\n\nBASE = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nRUNS = [\n    \"2026-06-16_4po2_KFERQ_s5000\",\n    \"2026-06-16_4po2_KILDQ_s5000\",\n    \"2026-06-16_4po2_RKDLQ_s5000\",\n    \"2026-06-16_4po2_RKELQ_s5000\",\n    \"2026-06-16_4po2_QRKEL_s5000\",\n    \"2026-06-16_4po2_HAMNG_s5000\",\n    \"2026-06-16_4po2_KFERQx2_s10000\",\n    \"2026-06-16_4po2_QRKELx2_s10000\",\n    \"2026-06-16_4po2_RKELQx2_s10000\",\n    \"2026-06-16_4po2_RKDLQ-variant_s10000\",\n    \"2026-06-16_4po2_KFERQ-KILDQ-fusion_s10000\",\n]\n\nTLEAP_SCRIPT = \"\"\"source leaprc.protein.ff14SB\ncomplex = loadpdb {complex_pdb}\nsaveamberparm complex {prmtop} {rst7}\nrec = loadpdb {rec_pdb}\nsaveamberparm rec {rec_prmtop} {rec_rst7}\nlig = loadpdb {lig_pdb}\nsaveamberparm lig {lig_prmtop} {lig_rst7}\nquit\n\"\"\"\n\nMMPBSA_INPUT = \"\"\"&general\n  startframe=1, endframe=1, interval=1, keep_files=0, verbose=0,\n/\n&gb\n  igb=5, saltcon=0.150,\n/\n&decomp\n  idecomp=1, dec_verbose=3,\n/\n\"\"\"\n\nconda_setup = \"source /home/tjiang/anaconda3/etc/profile.d/conda.sh && conda activate ambertools\"\n\nresults = {}\n\nfor run_name in RUNS:\n    tag = run_name.replace(\"2026-06-16_4po2_\", \"\").replace(\"_s5000\",\"\").replace(\"_s10000\",\"\")\n    rd = f\"{BASE}/runs/{run_name}\"\n    seletop_dirs = glob.glob(f\"{rd}/output/*seletopclusts*\")\n    model_gz = f\"{seletop_dirs[0]}/cluster_1_model_1.pdb.gz\"\n    \n    work = f\"/tmp/mmpbsa_{tag}\"\n    os.makedirs(work, exist_ok=True)\n    \n    # Extract and split complex\n    with gzip.open(model_gz, 'rt') as f:\n        lines = f.readlines()\n    \n    def no_h(atoms):\n        return [l for l in atoms if not l[12:16].strip().startswith('H') and l[12:16].strip()]\n    \n    rec = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'A'])\n    lig = no_h([l for l in lines if l.startswith('ATOM') and l[21] == 'B'])\n    \n    for pdb_type, atoms in [('complex', rec + lig), ('rec', rec), ('lig', lig)]:\n        with open(f\"{work}/{pdb_type}.pdb\", 'w') as f:\n            f.writelines(atoms + ['END\\n'])\n    \n    # Build topologies\n    tleap_in = TLEAP_SCRIPT.format(\n        complex_pdb=f\"{work}/complex.pdb\",\n        prmtop=f\"{work}/complex.prmtop\", rst7=f\"{work}/complex.rst7\",\n        rec_pdb=f\"{work}/rec.pdb\",\n        rec_prmtop=f\"{work}/rec.prmtop\", rec_rst7=f\"{work}/rec.rst7\",\n        lig_pdb=f\"{work}/lig.pdb\",\n        lig_prmtop=f\"{work}/lig.prmtop\", lig_rst7=f\"{work}/lig.rst7\",\n    )\n    with open(f\"{work}/tleap.in\", 'w') as f:\n        f.write(tleap_in)\n    \n    subprocess.run(f\"{conda_setup} && cd {work} && tleap -f tleap.in > tleap.log 2>&1\", \n                   shell=True, capture_output=True)\n    \n    # Run MMPBSA\n    with open(f\"{work}/mmpbsa.in\", 'w') as f:\n        f.write(MMPBSA_INPUT)\n    \n    subprocess.run(\n        f\"{conda_setup} && cd {work} && \"\n        f\"MMPBSA.py -O -i mmpbsa.in \"\n        f\"-cp complex.prmtop -rp rec.prmtop -lp lig.prmtop \"\n        f\"-y complex.rst7 -o out.dat -do decomp.dat \"\n        f\"-sp complex.prmtop -sr complex.rst7 > mmpbsa.log 2>&1\",\n        shell=True, capture_output=True\n    )\n    \n    # Extract ligand residue contributions\n    lig_data = []\n    try:\n        with open(f\"{work}/decomp.dat\") as f:\n            for line in f:\n                if ',L ' in line and 'TOTAL' not in line and 'Residue' not in line:\n                    parts = line.strip().split(',')\n                    resname = parts[0].split()[0]\n                    resi = parts[0].split()[1]\n                    total = float(parts[-3]) if parts[-3].strip() else 0.0\n                    vdw = float(parts[3]) if parts[3].strip() else 0.0\n                    elec = float(parts[6]) if parts[6].strip() else 0.0\n                    polar = float(parts[9]) if parts[9].strip() else 0.0\n                    lig_data.append((resi, resname, vdw, elec, polar, total))\n    except FileNotFoundError:\n        pass\n    \n    results[tag] = lig_data\n    # Cleanup\n    shutil.rmtree(work, ignore_errors=True)\n\n# Print results table\nprint(\"=== Per-residue interaction energy (MM-GBSA, kcal/mol) ===\")\nprint(f\"{'Peptide':<25} {'Residues (TOTAL kcal/mol)':<80}\")\nprint(\"-\" * 105)\nfor tag, data in results.items():\n    if not data:\n        continue\n    parts = []\n    for resi, resname, vdw, elec, polar, total in data:\n        sign = \"+\" if total >= 0 else \"\"\n        parts.append(f\"{resname}{resi}:{sign}{total:.1f}\")\n    print(f\"{tag:<25} {'  '.join(parts)}\")\n\nprint()\nprint(\"=== Per-residue vdW only ===\")\nfor tag, data in results.items():\n    if not data:\n        continue\n    parts = []\n    for resi, resname, vdw, elec, polar, total in data:\n        parts.append(f\"{resname}{resi}:{vdw:.1f}\")\n    print(f\"{tag:<25} {'  '.join(parts)}\")\n\nprint()\nprint(\"=== Key: best residue in each peptide (most negative TOTAL) ===\")\nfor tag, data in results.items():\n    if not data:\n        continue\n    best = min(data, key=lambda x: x[5])\n    print(f\"{tag:<25} {best[1]}{best[0]} = {best[5]:.1f} kcal/mol (vdW={best[2]:.1f})\")\nPYEOF"}

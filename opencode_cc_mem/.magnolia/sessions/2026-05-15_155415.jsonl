{"event_type":"tool_call","timestamp":"2026-06-12T13:06:21.859940Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c ssh azzurra 'python3 << '\\''PYEOF'\\''\nimport os, glob\n\nbase = \"/workspace/tjiang/magnolia/hsc70_new/bindcraft/run1/Trajectory\"\ncategories = {\"Clashing\": \"REJECTED (clashes)\", \"LowConfidence\": \"REJECTED (low confidence)\"}\n\nfor subdir, label in categories.items():\n    print(f\"\\n=== {label} ===\")\n    for f in sorted(glob.glob(f\"{base}/{subdir}/*.pdb\")):\n        name = os.path.basename(f).replace(\".pdb\",\"\")\n        chain_b = []\n        with open(f) as fh:\n            for line in fh:\n                if not line.startswith(\"ATOM\"): continue\n                chain = line[21:22]\n                if chain != \"B\": continue\n                resn = line[17:20].strip()\n                resi = int(line[22:26])\n                if not chain_b or chain_b[-1][1] != resi:\n                    chain_b.append((resn, resi))\n        seq = \"\".join(r for r, _ in chain_b)\n        length = len(chain_b)\n        print(f\"  {name}  l={length}  {seq}\")\n\nprint(f\"\\n=== ACCEPTED ===\")\naccepted = glob.glob(f\"{base}/../Accepted/**/*.pdb\", recursive=True)\nif accepted:\n    for f in accepted:\n        print(f\"  {f}\")\nelse:\n    print(\"  No accepted PDBs yet (pipeline still running)\")\nPYEOF\n'"}

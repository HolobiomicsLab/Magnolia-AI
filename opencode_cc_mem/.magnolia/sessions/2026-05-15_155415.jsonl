{"event_type":"tool_call","timestamp":"2026-06-02T11:35:20.587259Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c DIR=\"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000\"\n\n# Find the mdref origin models for cluster 1\ngrep 'cluster_1' \"$DIR/output/11_seletopclusts/seletopclusts.txt\" | head -5\n\necho\necho \"=== Cluster 1 model scores from final caprieval ===\"\n# Look up scores for these models in the capri_ss.tsv\npython3 -c \"\nimport gzip\n# Map model origins to scores\nmodels = {}\nwith open('$DIR/output/11_seletopclusts/seletopclusts.txt') as f:\n    for line in f:\n        if 'cluster_1' in line:\n            parts = line.strip().split()\n            # e.g., ../08_mdref/mdref_20.pdb\n            md_name = parts[2].split('/')[-1].replace('.pdb','')\n            models[parts[1]] = md_name  # ori_name -> mdref name\n\n# Scores from capri_ss\nwith open('$DIR/output/12_caprieval/capri_ss.tsv') as f:\n    header = f.readline()\n    for line in f:\n        p = line.strip().split('\\t')\n        # model column\n        ori = p[0]\n        if ori in models:\n            score = float(p[3])\n            print(f'{models[ori]} -> ori={ori} score={score:.2f}')\n\"\n"}

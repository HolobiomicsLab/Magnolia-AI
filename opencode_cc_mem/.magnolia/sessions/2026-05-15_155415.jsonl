{"event_type":"tool_call","timestamp":"2026-06-24T13:12:32.828180Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new\npython3 - <<'PY'\nimport numpy as np\ndef ca_chain(path):\n    d={}\n    for line in open(path):\n        if not line.startswith('ATOM') or line[12:16].strip()!='CA': continue\n        if line[21] not in ('A',' '): continue\n        try: res=int(line[22:26]); x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n        except ValueError: continue\n        d[res]=(line[17:20].strip(),np.array([x,y,z]))\n    return d\npo2=ca_chain(\"raw_input/receptor/4po2_chainA.pdb\"); af3=ca_chain(\"runs/2026-06-17_RKALQ_s5000/receptor.pdb\")\ncommon=[r for r in sorted(set(po2)&set(af3)) if po2[r][0]==af3[r][0]]\ndef fit_devs(lo,hi):\n    rs=[r for r in common if lo<=r<=hi]\n    P=np.array([po2[r][1] for r in rs]); Q=np.array([af3[r][1] for r in rs])\n    Pc=P-P.mean(0);Qc=Q-Q.mean(0);H=Pc.T@Qc\n    U,S,Vt=np.linalg.svd(H);d=np.sign(np.linalg.det(Vt.T@U.T));R=Vt.T@np.diag([1,1,d])@U.T\n    Pr=Pc@R.T; dev=np.sqrt(((Pr-Qc)**2).sum(1))\n    return rs,dev\nrs,dev=fit_devs(386,508)  # \u03b2-sandwich\nprint(f\"\u03b2-sandwich (n={len(rs)}): mean={dev.mean():.2f} median={np.median(dev):.2f} max={dev.max():.2f} \u00c5\")\nprint(f\"  fraction <2\u00c5: {100*(dev<2).mean():.0f}%   <1.5\u00c5: {100*(dev<1.5).mean():.0f}%   >4\u00c5: {100*(dev>4).mean():.0f}%\")\nprint(\"  worst 10 residues (res, resname, dev \u00c5):\")\nworst=np.argsort(dev)[::-1][:10]\nfor i in worst: print(f\"    {rs[i]} {po2[rs[i]][0]:3s} {dev[i]:.2f}\")\n# also try tighter \u03b2-strand-only core (drop obvious loops): 393-401,404-411,415-420,425-434,439-446,450-456,461-468,475-484,487-494,499-504 (rough strands)\nPY"}

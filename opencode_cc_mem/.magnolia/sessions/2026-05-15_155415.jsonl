{min(po2_resi)}-{max(po2_resi)}\")\n\n# Overlap region\nprint(\"\\n=== Overlapping residues ===\")\naf3_set = set(af3_resi)\npo2_set = set(po2_resi)\noverlap = sorted(af3_set & po2_set)\nprint(f\"Common residues: {len(overlap)}, range {min(overlap)}-{max(overlap)}\")\n\n# SBD\u03b2 alignment\nsbd_beta = (386, 510)\naf3_dict_all = {r: c for r, c in zip(af3_resi, af3_coords)}\npo2_dict_all = {r: c for r, c in zip(po2_resi, po2_coords)}\n\ncommon_beta = sorted(set(r for r in overlap if sbd_beta[0] <= r <= sbd_beta[1]))\nprint(f\"\\n=== SBD\u03b2 ({sbd_beta[0]}-{sbd_beta[1]}) ===\")\nprint(f\"Common CAs: {len(common_beta)}\")\n\naf3_beta = np.array([af3_dict_all[r] for r in common_beta])\npo2_beta = np.array([po2_dict_all[r] for r in common_beta])\nrmsd_beta = kabsch_rmsd(af3_beta, po2_beta)\nprint(f\"SBD\u03b2 C\u03b1 RMSD: {rmsd_beta:.2f} \u00c5\")\n\n# Lid\nlid_range = (531, 613)\ncommon_lid = sorted(set(r for r in overlap if lid_range[0] <= r <= lid_range[1]))\nprint(f\"\\n=== SBD\u03b1 lid ({lid_range[0]}-{lid_range[1]}) ===\")\nprint(f\"Common CAs: {len(common_lid)}\")\n\naf3_lid = np.array([af3_dict_all[r] for r in common_lid])\npo2_lid = np.array([po2_dict_all[r] for r in common_lid])\nrmsd_lid = kabsch_rmsd(af3_lid, po2_lid)\nprint(f\"Lid C\u03b1 RMSD: {rmsd_lid:.2f} \u00c5\")\n\n# Combined\naf3_all = np.array([af3_dict_all[r] for r in common_beta + common_lid])\npo2_all = np.array([po2_dict_all[r] for r in common_beta + common_lid])\nrmsd_all = kabsch_rmsd(af3_all, po2_all)\nprint(f\"\\n=== Combined SBD\u03b2+Lid C\u03b1 RMSD: {rmsd_all:.2f} \u00c5 ===\")\n\n# Binding site residues\nprint(\"\\n=== Binding site residue C\u03b1 deviation (\u00c5) ===\")\n# After alignment of SBD\u03b2\nP = af3_beta - af3_beta.mean(axis=0)\nQ = po2_beta - po2_beta.mean(axis=0)\nC = P.T @ Q\nV, S, Wt = np.linalg.svd(C)\nd = np.sign(np.linalg.det(V @ Wt))\nR = V @ np.diag([1, 1, d]) @ Wt\n\n# Apply same rotation to ALL AF3 coordinates for per-residue comparison\naf3_centroid = af3_beta.mean(axis=0)\nbinding = [403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473]\nfor r in binding:\n    if r in af3_dict_all and r in po2_dict_all:\n        af3_rot = (af3_dict_all[r] - af3_centroid) @ R + po2_beta.mean(axis=0)\n        d = np.linalg.norm(af3_rot - po2_dict_all[r])\n        print(f\"  {r}: {d:.2f} \u00c5\")\n    else:\n        print(f\"  {r}: missing\")\n\n# Lid hotspot residues\nprint(\"\\n=== Lid hotspot residues C\u03b1 deviation (\u00c5) ===\")\nhotspots = [545,548,552,558,561,600,607,610,611]\nfor r in hotspots:\n    if r in af3_dict_all and r in po2_dict_all:\n        af3_rot = (af3_dict_all[r] - af3_centroid) @ R + po2_beta.mean(axis=0)\n        d = np.linalg.norm(af3_rot - po2_dict_all[r])\n        print(f\"  {r}: {d:.2f} \u00c5\")\n    else:\n        print(f\"  {r}: missing in one\")\n\nPYEOF"}

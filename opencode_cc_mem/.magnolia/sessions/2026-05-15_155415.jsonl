{"event_type":"tool_call","timestamp":"2026-06-05T08:59:02.092836Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/build_6mers.py << 'PYEOF'\nimport math, gzip, os, copy\n\n# === Amino acid templates (ALA built from ideal geometry) ===\n# Standard peptide geometry\n# Peptide bond: C-N = 1.33 A\n# N-CA = 1.46 A\n# CA-C = 1.52 A\n# C=O = 1.23 A\n# CA-CB = 1.53 A\n\ndef rotation_matrix(axis, angle):\n    \"\"\"Rodrigues rotation formula\"\"\"\n    axis = axis / math.sqrt(sum(x*x for x in axis))\n    a = math.cos(angle)\n    b = math.sin(angle)\n    c = 1 - a\n    x, y, z = axis\n    return [\n        [a + x*x*c, x*y*c - z*b, x*z*c + y*b],\n        [y*x*c + z*b, a + y*y*c, y*z*c - x*b],\n        [z*x*c - y*b, z*y*c + x*b, a + z*z*c],\n    ]\n\ndef matvec(m, v):\n    return [m[0][0]*v[0]+m[0][1]*v[1]+m[0][2]*v[2],\n            m[1][0]*v[0]+m[1][1]*v[1]+m[1][2]*v[2],\n            m[2][0]*v[0]+m[2][1]*v[1]+m[2][2]*v[2]]\n\ndef vec_sub(a, b):\n    return (a[0]-b[0], a[1]-b[1], a[2]-b[2])\n\ndef vec_norm(v):\n    l = math.sqrt(v[0]**2+v[1]**2+v[2]**2)\n    return (v[0]/l, v[1]/l, v[2]/l) if l > 0 else (0,0,0)\n\ndef vec_cross(a, b):\n    return (a[1]*b[2]-a[2]*b[1], a[2]*b[0]-a[0]*b[2], a[0]*b[1]-a[1]*b[0])\n\ndef build_ala_backbone(n_pos, ca_dir_vec, resi):\n    \"\"\"Build an ALA residue with N at n_pos, CA extending in ca_dir_vec direction.\"\"\"\n    atoms = []\n    serial = 1\n    # N atom\n    atoms.append({\"serial\":serial,\"name\":\"N\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":n_pos[0],\"y\":n_pos[1],\"z\":n_pos[2],\"elem\":\"N\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    # HN\n    hn = (n_pos[0]-0.5, n_pos[1]+0.3, n_pos[2]-0.8)  # approximate\n    atoms.append({\"serial\":serial,\"name\":\"HN\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":hn[0],\"y\":hn[1],\"z\":hn[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    \n    # CA: 1.46A from N along ca_direction\n    ca_dir = vec_norm(ca_dir_vec)\n    ca = (n_pos[0]+1.46*ca_dir[0], n_pos[1]+1.46*ca_dir[1], n_pos[2]+1.46*ca_dir[2])\n    atoms.append({\"serial\":serial,\"name\":\"CA\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":ca[0],\"y\":ca[1],\"z\":ca[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    # HA\n    ha = (ca[0]+0.5, ca[1]+0.3, ca[2]+0.3)\n    atoms.append({\"serial\":serial,\"name\":\"HA\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":ha[0],\"y\":ha[1],\"z\":ha[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    \n    # CB: perpendicular to N-CA, ~1.53A from CA\n    # Use approximate direction perpendicular to backbone\n    perp = vec_norm(vec_cross(ca_dir, (0,1,0)))\n    cb = (ca[0]+1.53*perp[0], ca[1]+1.53*perp[1], ca[2]+1.53*perp[2])\n    atoms.append({\"serial\":serial,\"name\":\"CB\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":cb[0],\"y\":cb[1],\"z\":cb[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    # HB1-3\n    for j in range(3):\n        hb = (cb[0]+0.3*(j-1), cb[1]+0.5, cb[2]+0.3*j)\n        atoms.append({\"serial\":serial,\"name\":f\"HB{j+1}\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                       \"x\":hb[0],\"y\":hb[1],\"z\":hb[2],\"elem\":\"H\",\"occ\":1.0,\"bf\":15.0})\n        serial += 1\n    \n    # C: 1.52A from CA along ca_direction\n    c = (ca[0]+1.52*ca_dir[0], ca[1]+1.52*ca_dir[1], ca[2]+1.52*ca_dir[2])\n    atoms.append({\"serial\":serial,\"name\":\"C\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":c[0],\"y\":c[1],\"z\":c[2],\"elem\":\"C\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    # O\n    o = (c[0]+0.5, c[1]-1.2, c[2]+0.2)\n    atoms.append({\"serial\":serial,\"name\":\"O\",\"resn\":\"ALA\",\"resi\":resi,\"chain\":\"B\",\n                   \"x\":o[0],\"y\":o[1],\"z\":o[2],\"elem\":\"O\",\"occ\":1.0,\"bf\":15.0})\n    serial += 1\n    return atoms\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\") or line.startswith(\"HETATM\"):\n                atoms.append({\n                    \"serial\": int(line[6:11]),\n                    \"name\": line[12:16].strip(),\n                    \"resn\": line[17:20].strip(),\n                    \"chain\": line[21],\n                    \"resi\": int(line[22:26]),\n                    \"x\": float(line[30:38]),\n                    \"y\": float(line[38:46]),\n                    \"z\": float(line[46:54]),\n                    \"occ\": float(line[54:60]) if line[54:60].strip() else 1.0,\n                    \"bf\": float(line[60:66]) if line[60:66].strip() else 15.0,\n                    \"elem\": line[76:78].strip(),\n                })\n    return atoms\n\ndef write_pdb(atoms, path, peptide=True):\n    with open(path, 'w') as f:\n        f.write(f\"REMARK   Generated 6-mer peptide for HADDOCK3\\n\")\n        for i, a in enumerate(atoms):\n            serial = i + 1\n            name = a[\"name\"]\n            if len(name) < 4:\n                name = f\" {name:<3}\" if len(name) < 3 else f\"{name} \"\n            f.write(f\"ATOM  {serial:5d} {name}{a['resn']} {a['chain']}{a['resi']:4d}    \"\n                    f\"{a['x']:8.3f}{a['y']:8.3f}{a['z']:8.3f}\"\n                    f\"{a['occ']:6.2f}{a['bf']:6.2f}          {a['elem']:>2}  \\n\")\n        f.write(\"END\\n\")\n\ndef get_res_by_name(atoms, resi, name):\n    for a in atoms:\n        if a[\"resi\"]==resi and a[\"name\"]==name:\n            return a\n    return None\n\ndef align_residue(template_atoms, target_n, target_ca_dir):\n    \"\"\"Translate and rotate template so N goes to target_n and N->CA aligns with target_ca_dir.\"\"\"\n    t_n = get_res_by_name(template_atoms, template_atoms[0][\"resi\"], \"N\")\n    t_ca = get_res_by_name(template_atoms, template_atoms[0][\"resi\"], \"CA\")\n    if not t_n or not t_ca:\n        return template_atoms\n    \n    # Vector from template N to template CA\n    t_vec = (t_ca[\"x\"]-t_n[\"x\"], t_ca[\"y\"]-t_n[\"y\"], t_ca[\"z\"]-t_n[\"z\"])\n    t_len = math.sqrt(t_vec[0]**2+t_vec[1]**2+t_vec[2]**2)\n    \n    target_dir = vec_norm(target_ca_dir)\n    t_dir = vec_norm(t_vec)\n    \n    # Rotation axis (cross product)\n    axis = vec_cross(t_dir, target_dir)\n    axis_len = math.sqrt(axis[0]**2+axis[1]**2+axis[2]**2)\n    \n    result = []\n    if axis_len < 1e-6:\n        # Vectors are parallel, just translate\n        for a in template_atoms:\n            na = copy.deepcopy(a)\n            na[\"x\"] += target_n[0] - t_n[\"x\"]\n            na[\"y\"] += target_n[1] - t_n[\"y\"]\n            na[\"z\"] += target_n[2] - t_n[\"z\"]\n            result.append(na)\n    else:\n        axis = vec_norm(axis)\n        angle = math.acos(max(-1, min(1, sum(t_dir[i]*target_dir[i] for i in range(3)))))\n        R = rotation_matrix(axis, angle)\n        \n        for a in template_atoms:\n            # Translate to origin relative to N\n            rel = (a[\"x\"]-t_n[\"x\"], a[\"y\"]-t_n[\"y\"], a[\"z\"]-t_n[\"z\"])\n            # Rotate\n            rot = matvec(R, rel)\n            # Scale to match CA distance\n            # Actually don't scale, just rotate and translate to new N\n            na = copy.deepcopy(a)\n            na[\"x\"] = target_n[0] + rot[0] * (1.46 / t_len)\n            na[\"y\"] = target_n[1] + rot[1] * (1.46 / t_len)\n            na[\"z\"] = target_n[2] + rot[2] * (1.46 / t_len)\n            result.append(na)\n    \n    return result\n\n# === Main ===\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\n# Load structures\nkferq_all = read_pdb(f\"{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nkferqx2_all = read_pdb(f\"{base}/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\n\npep5 = sorted([a for a in kferq_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"serial\"]))\npep11 = sorted([a for a in kferqx2_all if a[\"chain\"]==\"B\"], key=lambda a: (a[\"resi\"], a[\"serial\"]))\n\n# Get template residues\ndef get_res_template(atoms, resi, name):\n    res_atoms = [a for a in atoms if a[\"resi\"]==resi]\n    return res_atoms\n\nlys_t = get_res_template(pep11, 652)\nphe_t = get_res_template(pep11, 648)\ngln_t = get_res_template(pep11, 651)\n\n# Get Q651 C and backbone direction from KFERQ\nq651 = [a for a in pep5 if a[\"resi\"]==651]\nq651_c = get_res_by_name(pep5, 651, \"C\")\nq651_n = get_res_by_name(pep5, 651, \"N\")\nq651_ca = get_res_by_name(pep5, 651, \"CA\")\n\n# Direction for c-term extension: CA651 -> C651\ncterm_dir = vec_norm((q651_c[\"x\"]-q651_ca[\"x\"], q651_c[\"y\"]-q651_ca[\"y\"], q651_c[\"z\"]-q651_ca[\"z\"]))\n\n# Target N position for next residue\nn652 = (q651_c[\"x\"]+1.33*cterm_dir[0], q651_c[\"y\"]+1.33*cterm_dir[1], q651_c[\"z\"]+1.33*cterm_dir[2])\n\n# N-term extension direction (go backwards from K647)\nk647 = [a for a in pep5 if a[\"resi\"]==647]\nk647_n = get_res_by_name(pep5, 647, \"N\")\nk647_ca = get_res_by_name(pep5, 647, \"CA\")\nnterm_dir = vec_norm((k647_n[\"x\"]-k647_ca[\"x\"], k647_n[\"y\"]-k647_ca[\"y\"], k647_n[\"z\"]-k647_ca[\"z\"]))\n# C of previous residue\nc646 = (k647_n[\"x\"]+1.33*nterm_dir[0], k647_n[\"y\"]+1.33*nterm_dir[1], k647_n[\"z\"]+1.33*nterm_dir[2])\n# CA of previous residue\nca646_dir = vec_norm((k647_n[\"x\"]-k647_ca[\"x\"], k647_n[\"y\"]-k647_ca[\"y\"], k647_n[\"z\"]-k647_ca[\"z\"]))\n# N of previous residue (1.46A from CA in opposite direction of N->CA)\nn646 = (c646[0]-1.33*ca646_dir[0], c646[1]-1.33*ca646_dir[1], c646[2]-1.33*ca646_dir[2])\n# CA of previous residue\nca646 = (n646[0]+1.46*ca646_dir[0], n646[1]+1.46*ca646_dir[1], n646[2]+1.46*ca646_dir[2])\n\n# Build 6-mers\noutput_dir = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/raw_input/peptides/6mers\"\nos.makedirs(output_dir, exist_ok=True)\n\n# --- C-term LYS (KFERQ+K) ---\ndef build_cterm_6mer(base_pep, new_res_template, new_resn, new_resi, target_n, ca_dir):\n    atoms = []\n    # Copy existing peptide atoms\n    for a in base_pep:\n        atoms.append(copy.deepcopy(a))\n    # Align and add new residue\n    aligned = align_residue(new_res_template, target_n, ca_dir)\n    for a in aligned:\n        na = copy.deepcopy(a)\n        na[\"resi\"] = new_resi\n        na[\"resn\"] = new_resn\n        atoms.append(na)\n    return atoms\n\npep_kferq_k = build_cterm_6mer(pep5, lys_t, \"LYS\", 652, n652, cterm_dir)\nwrite_pdb(pep_kferq_k, f\"{output_dir}/KFERQ_K.pdb\")\n\npep_kferq_f = build_cterm_6mer(pep5, phe_t, \"PHE\", 652, n652, cterm_dir)\nwrite_pdb(pep_kferq_f, f\"{output_dir}/KFERQ_F.pdb\")\n\npep_kferq_q = build_cterm_6mer(pep5, gln_t, \"GLN\", 652, n652, cterm_dir)\nwrite_pdb(pep_kferq_q, f\"{output_dir}/KFERQ_Q.pdb\")\n\n# ALA C-term: build from scratch\nala_cterm = build_ala_backbone(n652, cterm_dir, 652)\nall_ala_c = list(pep5) + ala_cterm\nwrite_pdb(all_ala_c, f\"{output_dir}/KFERQ_A_C.pdb\")\n\n# ALA N-term: prepend before K647\n# We need to place ALA at position 646\n# This is harder since we need the direction from CA646 to C646 to N647\nk647_n_pos = (k647_n[\"x\"], k647_n[\"y\"], k647_n[\"z\"])\n# The direction from previous CA to C is aligned with N647->CA647\nca646_to_c646 = vec_norm((k647_ca[\"x\"]-k647_n[\"x\"], k647_ca[\"y\"]-k647_n[\"y\"], k647_ca[\"z\"]-k647_n[\"z\"]))\n# C646 is 1.33A before N647 (peptide bond)\nc646_pos = (k647_n[\"x\"]-1.33*ca646_to_c646[0], k647_n[\"y\"]-1.33*ca646_to_c646[1], k647_n[\"z\"]-1.33*ca646_to_c646[2])\n# CA646 is 1.52A before C646 along same direction\nca646_pos = (c646_pos[0]-1.52*ca646_to_c646[0], c646_pos[1]-1.52*ca646_to_c646[1], c646_pos[2]-1.52*ca646_to_c646[2])\n# N646 is 1.46A before CA646 along same direction\nn646_pos = (ca646_pos[0]-1.46*ca646_to_c646[0], ca646_pos[1]-1.46*ca646_to_c646[1], ca646_pos[2]-1.46*ca646_to_c646[2])\n\nala_nterm = build_ala_backbone(n646_pos, ca646_to_c646, 646)\n# Combine: ALA first, then KFERQ (renumber KFERQ to 647-651)\nall_ala_n = list(ala_nterm)\nfor a in pep5:\n    na = copy.deepcopy(a)\n    all_ala_n.append(na)\nwrite_pdb(all_ala_n, f\"{output_dir}/A_KFERQ_N.pdb\")\n\nprint(\"Generated 5 6-mer PDBs:\")\nfor f in sorted(os.listdir(output_dir)):\n    path = f\"{output_dir}/{f}\"\n    atoms = read_pdb(path)\n    residues = sorted(set((a[\"resi\"],a[\"resn\"]) for a in atoms))\n    seq = \"\".join(aa[0] for _,aa in residues)\n    print(f\"  {f}: {len(residues)} residues [{seq}], {len(atoms)} atoms\")\nPYEOF\npython3 /tmp/build_6mers.py"}

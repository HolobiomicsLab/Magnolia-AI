{"event_type":"tool_call","timestamp":"2026-06-20T08:24:54.717351Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/compas && python3 << 'PYEOF'\nimport csv, re, os, subprocess\n\n# Read the published data\npublished = {}\nwith open(\"raw_input/compas_data/compas-1x.csv\") as f:\n    for r in csv.DictReader(f):\n        published[r['molecule']] = {\n            'HOMO_eV': float(r['HOMO_eV']),\n            'LUMO_eV': float(r['LUMO_eV']),\n            'GAP_eV': float(r['GAP_eV']),\n            'Etot_eV': float(r['Etot_eV']),\n        }\n\n# Read selected molecules\nwith open(\"raw_input/compas_data/selected_molecules.csv\") as f:\n    selected = list(csv.DictReader(f))\n\nrun_dir = \"runs/2026-06-20_compas_xtb_validation\"\nresults = []\n\nfor m in selected:\n    name = m['molecule']\n    logfile = f\"{run_dir}/{name}.xtbopt.log\"\n    \n    if not os.path.exists(logfile):\n        print(f\"MISSING: {logfile}\")\n        continue\n    \n    with open(logfile) as f:\n        text = f.read()\n    \n    # Extract total energy\n    etot_match = re.search(r'TOTAL ENERGY\\s+(-?[\\d.]+)\\s+Eh', text)\n    homo_match = re.search(r'HOMO-LUMO Gap\\s+.*?\\n.*?HOMO\\s+(-?[\\d.]+)\\s+eV', text)\n    lumo_match = re.search(r'HOMO-LUMO Gap\\s+.*?\\n.*?HOMO\\s+-?[\\d.]+\\s+eV\\s+LUMO\\s+(-?[\\d.]+)\\s+eV', text)\n    gap_match = re.search(r'HOMO-LUMO Gap\\s+\\(EH\\):\\s+(-?[\\d.]+)\\s+eV', text)\n    \n    etot_au = float(etot_match.group(1)) if etot_match else None\n    etot_ev = etot_au * 27.2114 if etot_au else None  # Hartree to eV\n    homo = float(homo_match.group(1)) if homo_match else None\n    lumo = float(lumo_match.group(1)) if lumo_match else None\n    gap = float(gap_match.group(1)) if gap_match else None\n    \n    # Get published values\n    pub = published.get(name, {})\n    \n    results.append({\n        'name': name,\n        'rings': int(m['n_rings']),\n        'homo_our': homo, 'homo_pub': pub.get('HOMO_eV'),\n        'lumo_our': lumo, 'lumo_pub': pub.get('LUMO_eV'),\n        'gap_our': gap, 'gap_pub': pub.get('GAP_eV'),\n        'etot_our': etot_ev, 'etot_pub': pub.get('Etot_eV'),\n    })\n\n# Print results\nprint(f\"{'Molecule':35s} {'Rings':>5s} {'HOMO(our)':>9s} {'HOMO(pub)':>9s} {'\u0394HOMO':>9s} {'GAP(our)':>8s} {'GAP(pub)':>8s} {'\u0394GAP':>8s} {'Etot(our)':>12s} {'Etot(pub)':>12s} {'\u0394Etot':>10s}\")\nprint(\"-\" * 140)\n\nfor r in results:\n    dh = r['homo_our'] - r['homo_pub'] if r['homo_our'] and r['homo_pub'] else None\n    dg = r['gap_our'] - r['gap_pub'] if r['gap_our'] and r['gap_pub'] else None\n    de = r['etot_our'] - r['etot_pub'] if r['etot_our'] and r['etot_pub'] else None\n    \n    dh_s = f\"{dh:+.4f}\" if dh is not None else \"N/A\"\n    dg_s = f\"{dg:+.4f}\" if dg is not None else \"N/A\"\n    de_s = f\"{de:+.2f}\" if de is not None else \"N/A\"\n    \n    ho = f\"{r['homo_our']:.4f}\" if r['homo_our'] else \"N/A\"\n    hp = f\"{r['homo_pub']:.4f}\" if r['homo_pub'] else \"N/A\"\n    go = f\"{r['gap_our']:.4f}\" if r['gap_our'] else \"N/A\"\n    gp = f\"{r['gap_pub']:.4f}\" if r['gap_pub'] else \"N/A\"\n    eo = f\"{r['etot_our']:.2f}\" if r['etot_our'] else \"N/A\"\n    ep = f\"{r['etot_pub']:.2f}\" if r['etot_pub'] else \"N/A\"\n    \n    print(f\"{r['name']:35s} {r['rings']:>5d} {ho:>9s} {hp:>9s} {dh_s:>9s} {go:>8s} {gp:>8s} {dg_s:>8s} {eo:>12s} {ep:>12s} {de_s:>10s}\")\n\n# Compute statistics\ndiffs_homo = [r['homo_our'] - r['homo_pub'] for r in results if r['homo_our'] and r['homo_pub']]\ndiffs_gap = [r['gap_our'] - r['gap_pub'] for r in results if r['gap_our'] and r['gap_pub']]\ndiffs_etot = [r['etot_our'] - r['etot_pub'] for r in results if r['etot_our'] and r['etot_pub']]\n\nif diffs_homo:\n    mae_homo = sum(abs(d) for d in diffs_homo) / len(diffs_homo)\n    mae_gap = sum(abs(d) for d in diffs_gap) / len(diffs_gap)\n    mae_etot = sum(abs(d) for d in diffs_etot) / len(diffs_etot)\n    print(f\"\\n{'MAE HOMO:':>15s} {mae_homo:.4f} eV\")\n    print(f\"{'MAE GAP:':>15s} {mae_gap:.4f} eV\")\n    print(f\"{'MAE Etot:':>15s} {mae_etot:.2f} eV\")\nPYEOF\n"}

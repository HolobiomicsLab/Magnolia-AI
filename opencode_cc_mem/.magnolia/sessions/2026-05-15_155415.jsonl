>8.3f} {aff:>+9.2f} {cnn:>8.4f} {cnnaff:>8.4f}\")\n    affs = [g[0] for g in entries]\n    w(f\"  {'\u2500'*60}\")\n    w(f\"  MEAN: {np.mean(affs):+.2f} \u00b1 {np.std(affs):.2f}   range: [{min(affs):+.2f}, {max(affs):+.2f}]\")\n    w(f\"  {note}\")\n    w()\n\nblock(\"PAPER: STRONG BINDERS (Kd < 1 \u00b5M) \u2014 gnina should score these BEST\",\n      GOOD, \"5/10 are terpenoid bamboo volatiles, 4/10 are unsaturated aldehydes, 1/10 synthetic\")\n\nblock(\"PAPER: MODERATE BINDERS (1 \u2264 Kd < 10 \u00b5M)\",\n      MOD, \"Mixed: aldehydes, terpenoids, unsaturated fatty acids, alcohols\")\n\nblock(\"PAPER: WEAK / NON-BINDERS (Kd \u2265 10 \u00b5M) \u2014 NEGATIVE CONTROLS\",\n      WEAK, \"Saturated fatty acids, short/long aldehydes, bulky terpenoids. Should score WORST.\")\n\nw(\"\u2550\u2550\u2550 SUMMARY \u2550\u2550\u2550\")\nfor label, grp in [(\"STRONG (n=10)\",GOOD),(\"MODERATE (n=16)\",MOD),(\"WEAK/NON (n=14)\",WEAK)]:\n    affs = [g[0] for g in grp]\n    w(f\"  {label:<20s} affinity = {np.mean(affs):+.2f} \u00b1 {np.std(affs):.2f}   [range {min(affs):+.2f} to {max(affs):+.2f}]\")\nw()\nw(\"  CONCLUSION: All three classes are indistinguishable by gnina empirical affinity.\")\nw(\"  The scoring function cannot resolve the subtle functional-group recognition\")\nw(\"  in this buried 392 \u00c5\u00b3 lipocalin cavity.\")\nw()\nw(\"  Paper: Zhu et al. 2017 PNAS 114(46):E9802-E9810\")\nw(\"  PDB: 5NGH, 2.80 \u00c5. Docking box: TRS centroid. Gnina v1.3.2, exhaust=8.\")\n\nout = '\\n'.join(lines)\nwith open('results_by_class.txt', 'w') as f:\n    f.write(out + '\\n')\nprint(out)\nPYEOF"}

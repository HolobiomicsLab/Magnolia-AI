ctions = re.split(r'(## Observation \\d+)', content)\n                    n_obs = sum(1 for o in obs_sections if o.startswith('## Observation'))\n                    print(f'  Observations: {n_obs}')\n                    for i, sec in enumerate(obs_sections[:6]):\n                        if sec.startswith('## Observation'):\n                            print(f'    {sec}{obs_sections[i+1][:200] if i+1 < len(obs_sections) else \\\"\\\"}')\n            print()\n        except Exception as e:\n            print(f'TASK: {task[:150]} - error: {e}')\n            print()\n\" 2>&1"}

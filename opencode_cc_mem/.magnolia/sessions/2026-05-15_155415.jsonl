{"event_type":"tool_call","timestamp":"2026-06-24T13:47:26.600949Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\necho \"=== all capri_clt.tsv locations in 14-mer run ===\"\nfind af3_KFERQ-KILDQ-fusion_s10000_full -name 'capri_clt.tsv' 2>/dev/null\necho\npython3 - <<'PY'\nimport glob,json,os,re\nruns=[\"af3_KFERQ-KILDQ-fusion_s10000_full\",\"af3_KFERQx2_s10000_full\",\"af3_RKELQx2_s10000_full\",\n      \"af3_QRKELx2_s10000_full\",\"af3_RKDLQ-variant_s10000_full\",\"af3_TGGFQMALT_s10000_full\"]\nfor r in runs:\n    ts=glob.glob(f\"{r}/output/*/capri_clt.tsv\")\n    if not ts: \n        print(f\"{r:42s} NONE\"); continue\n    # highest-numbered caprieval\n    def num(t):\n        m=re.search(r'/(\\d+)_caprieval/',t); return int(m.group(1)) if m else 0\n    f=max(ts,key=num)\n    wp=f.replace('capri_clt.tsv','weights_params.json')\n    wair=0.1\n    try: wair=json.load(open(wp)).get('w_air',0.1)\n    except: pass\n    rows=[];idx={}\n    for line in open(f):\n        if line.startswith('#') or not line.strip(): continue\n        if not idx: idx={c:i for i,c in enumerate(line.rstrip().split('\\t'))}; continue\n        rows.append(line.rstrip().split('\\t'))\n    def g(rw,c): return rw[idx[c]]\n    rw=rows[0]\n    af=float(g(rw,'score'))-wair*float(g(rw,'air'))\n    print(f\"{r:42s} AIR-free={af:8.2f} DockQ={float(g(rw,'dockq')):.3f} n={g(rw,'n')} [{os.path.basename(os.path.dirname(f))}]\")\nPY"}

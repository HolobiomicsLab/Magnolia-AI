lso check status\n            status = output.get('status', 'unknown')\n            \n            if content and len(content) > 100 and 'no matching' not in content.lower():\n                # Count how many project entries appear\n                entry_count = 0\n                for entry_marker in ['error_resolution', 'success_pattern', 'failure_pattern', 'parameter_guidance',\n                                       'SBD_only_docking', 'AIR-free', 'OOM_kill', 'HADDOCK3', '4PO2', \n                                       'KFERQ_N-ALA', 'KFERQ_N-GLY', 'KFERQ_N-VAL', 'TGGFQMALT',\n                                       'mm_gbsa', 'contact_map', 'BindCraft']:\n                    if entry_marker.lower() in content.lower():\n                        entry_count += 1\n                \n                # Look for entry titles (lines that start with '# ' or '## ')\n                entry_titles = []\n                for line in content.split('\\\\n'):\n                    if line.startswith('# ') or line.startswith('## '):\n                        entry_titles.append(line[:100])\n                \n                print(f'CALL #{call_num} | {sid}')\n                print(f'  Task: {task[:130]}')\n                print(f'  Content len: {len(content)}, markers found: {entry_count}')\n                if entry_titles:\n                    print(f'  Titles:')\n                    for t in entry_titles[:8]:\n                        print(f'    {t}')\n                print()\n        except Exception as e:\n            pass\n\" 2>&1"}

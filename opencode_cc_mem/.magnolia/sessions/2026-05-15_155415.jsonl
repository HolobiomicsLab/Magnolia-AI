{"event_type":"tool_call","timestamp":"2026-06-05T08:41:58.535606Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\n# Load KFERQ p2rank (cluster 1 model 1)\nkferq = read_pdb(f\"{base}/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\n\n# Load KFERQx2 (cluster 1 = rank 3, best model)\nkferqx2 = read_pdb(f\"{base}/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz\")\n\n# Peptide info\nfor label, atoms in [(\"KFERQ\", kferq), (\"KFERQx2\", kferqx2)]:\n    pep = sorted(set((a[\"resi\"], a[\"resn\"]) for a in atoms if a[\"chain\"]==\"B\"))\n    seq = \"\".join(r for _, r in pep)\n    print(f\"{label}: {len(pep)} residues [{seq}], resi {pep[0][0]}-{pep[-1][0]}\")\n\n# CA positions\ndef pep_cas(atoms):\n    return sorted([a for a in atoms if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"], key=lambda a: a[\"resi\"])\n\nkferq_cas = pep_cas(kferq)\nkferqx2_cas = pep_cas(kferqx2)\n\n# Compare core 5-mer (resi 647-651)\nkferq_core = {a[\"resi\"]: a for a in kferq_cas}\nkferqx2_core = {a[\"resi\"]: a for a in kferqx2_cas if a[\"resi\"] <= 651}\n\nprint(\"\\n=== Core 5-mer CA positions ===\")\nfor resi in sorted(kferq_core):\n    a1 = kferq_core[resi]\n    a2 = kferqx2_core.get(resi)\n    print(f\"  {a1['resn']}{resi}  KFERQ:  ({a1['x']:7.1f}, {a1['y']:7.1f}, {a1['z']:7.1f})\", end=\"\")\n    if a2:\n        print(f\"    KFERQx2: ({a2['x']:7.1f}, {a2['y']:7.1f}, {a2['z']:7.1f})\", end=\"\")\n        d = math.sqrt((a1[\"x\"]-a2[\"x\"])**2+(a1[\"y\"]-a2[\"y\"])**2+(a1[\"z\"]-a2[\"z\"])**2)\n        print(f\"   \u0394={d:.1f}A\")\n    else:\n        print()\n\n# RMSD\nif all(r in kferqx2_core for r in kferq_core):\n    sqs = sum((kferq_core[r][\"x\"]-kferqx2_core[r][\"x\"])**2+(kferq_core[r][\"y\"]-kferqx2_core[r][\"y\"])**2+(kferq_core[r][\"z\"]-kferqx2_core[r][\"z\"])**2 for r in kferq_core)\n    rmsd = math.sqrt(sqs/len(kferq_core))\n    print(f\"\\nCore 5-mer CA RMSD: {rmsd:.2f}A\")\n\n# Extra residues in KFERQx2\nextra = [a for a in kferqx2_cas if a[\"resi\"] > 651]\nprint(f\"\\n=== Extra residues in KFERQx2 ===\")\nfor a in extra:\n    print(f\"  {a['resn']}{a['resi']}: ({a['x']:7.1f}, {a['y']:7.1f}, {a['z']:7.1f})\")\n\n# Backbone direction\nn_ca = kferqx2_core[min(kferqx2_core)]\nc_ca = kferqx2_core[max(kferqx2_core)]\nvec_core = (c_ca[\"x\"]-n_ca[\"x\"], c_ca[\"y\"]-n_ca[\"y\"], c_ca[\"z\"]-n_ca[\"z\"])\nvlen = math.sqrt(vec_core[0]**2+vec_core[1]**2+vec_core[2]**2)\nvec_norm = tuple(v/vlen for v in vec_core)\nprint(f\"\\nCore backbone: ({vec_core[0]:.1f}, {vec_core[1]:.1f}, {vec_core[2]:.1f}), {vlen:.1f}A\")\n\n# Check if extras continue the backbone direction\nprint(\"\\nExtension vectors (CA\u2192CA):\")\nprev = c_ca\nfor a in extra:\n    v = (a[\"x\"]-prev[\"x\"], a[\"y\"]-prev[\"y\"], a[\"z\"]-prev[\"z\"])\n    vl = math.sqrt(v[0]**2+v[1]**2+v[2]**2)\n    dot = (v[0]*vec_norm[0]+v[1]*vec_norm[1]+v[2]*vec_norm[2])/vl if vl>0 else 0\n    angle = math.degrees(math.acos(max(-1,min(1,dot))))\n    print(f\"  -> {a['resn']}{a['resi']}: ({v[0]:5.1f}, {v[1]:5.1f}, {v[2]:5.1f}), {vl:.1f}A, deviation={angle:.0f}\u00b0\")\n    prev = a\n\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-17T20:22:56.262493Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\nROOT = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\ncontacts = []\nwith open(f\"{ROOT}/2026-06-17_RKALQ_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\") as f:\n    for line in f:\n        if line[0] == '#' or line.startswith(\"res1\"):\n            continue\n        parts = line.strip().split(\"\\t\")\n        if len(parts) < 7:\n            continue\n        contacts.append({\n            \"rec\": parts[0].strip(), \"pep\": parts[1].strip(),\n            \"prob\": float(parts[5]), \"dist\": float(parts[6]),\n        })\n\npdb = \"/tmp/rkalq_c1_m1.pdb\"\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26]); atomname = line[12:16].strip()\n        atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\npep_atoms = [(a[1], a[2], a[3], a[4], a[5], a[6]) for a in atoms if a[0] == 'B']\nrec_by_res = {}\nfor a in atoms:\n    if a[0] == 'A':\n        if a[2] not in rec_by_res:\n            rec_by_res[a[2]] = {\"resname\": a[1], \"atoms\": []}\n        rec_by_res[a[2]][\"atoms\"].append((a[3], a[4], a[5], a[6]))\n\npocket = {}\nfor rid in sorted(rec_by_res.keys()):\n    min_d = min(dist((px,py,pz), ra) for _,_,_,px,py,pz in pep_atoms for ra in rec_by_res[rid][\"atoms\"])\n    if min_d <= 5.0:\n        pocket[rid] = min_d\n\ncontacted = set()\nweak_contacted = set()\nfor c in contacts:\n    rid = int(c[\"rec\"].split(\"-\")[1])\n    if c[\"prob\"] >= 0.5:\n        contacted.add(rid)\n    elif c[\"prob\"] >= 0.2:\n        weak_contacted.add(rid)\n\nall_pocket = set(pocket.keys())\nunderutilized = all_pocket - contacted\n\nsbd_start, lid_start = 386, 531\n\nprint(\"POCKET RESIDUES - UTILIZATION (RKALQ)\")\nprint(f\"{'Resid':>6s} {'Name':>4s} {'Dist':>7s} {'Domain':>6s} {'Contacted by peptide':>30s} Status\")\nprint(\"-\" * 80)\nfor rid in sorted(all_pocket):\n    name = rec_by_res[rid][\"resname\"]\n    d = pocket[rid]\n    domain = \"LID\" if rid >= lid_start else (\"SBD\" if rid >= sbd_start else \"NBD\")\n    hits = []\n    for c in contacts:\n        if int(c[\"rec\"].split(\"-\")[1]) == rid and c[\"prob\"] >= 0.5:\n            pn = c[\"pep\"].split(\"-\")[2]\n            pi = c[\"pep\"].split(\"-\")[1]\n            hits.append(f\"{pn}{pi}({c['prob']:.1f})\")\n    hit_str = \",\".join(hits) if hits else \"-\"\n    if rid in contacted:\n        st = \"STRONG\"\n    elif rid in weak_contacted:\n        st = \"WEAK\"\n    else:\n        st = \"!! UNDER\"\n    print(f\"{rid:6d} {name:>4s} {d:7.2f} {domain:>6s} {hit_str:>30s} {st}\")\n\nprint(f\"\\nTotal: {len(all_pocket)} | Strong: {len(all_pocket & contacted)} | Weak: {len(all_pocket & weak_contacted)} | Under-utilized: {len(underutilized)}\")\nprint(f\"Under-utilized: {sorted(underutilized)}\")\nfor rid in sorted(underutilized):\n    print(f\"  {rid} ({rec_by_res[rid]['resname']})\")\n\nPYEOF"}

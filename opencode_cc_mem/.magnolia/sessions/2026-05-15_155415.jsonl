{"event_type":"tool_call","timestamp":"2026-07-01T08:22:03.967690Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\nd = \"projects/hsc70_new/runs/2026-06-25_KFERQx2_s20000\"\n\n# List available contact map files\ncm_dir = f\"{d}/output/13_contactmap\"\nprint(\"Available contact maps:\")\nfor f in sorted(os.listdir(cm_dir)):\n    if 'interchain' in f:\n        print(f\"  {f}\")\n\n# Parse each cluster\nfor cl in range(1, 8):\n    fpath = f\"{cm_dir}/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath):\n        continue\n    \n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    if len(lines) <= 1:\n        continue\n    reader = csv.DictReader(lines, delimiter='\\t')\n    \n    # Domain classification per peptide residue\n    pep_domains = {}\n    domain_counts = {\"NBD\": 0, \"SBD\u03b2\": 0, \"SBD\u03b1-lid\": 0, \"beyond-615\": 0}\n    domain_residues = {\"NBD\": set(), \"SBD\u03b2\": set(), \"SBD\u03b1-lid\": set(), \"beyond-615\": set()}\n    \n    for row in reader:\n        parts1 = row.get('res1','').strip().split('-')\n        parts2 = row.get('res2','').strip().split('-')\n        if len(parts1) < 3 or len(parts2) < 3: continue\n        try:\n            rec_num = int(parts1[1])\n            pep_num = int(parts2[1])\n        except ValueError:\n            continue\n        dist = float(row.get('shortest-dist', 999))\n        \n        if rec_num < 390: domain = \"NBD\"\n        elif rec_num <= 520: domain = \"SBD\u03b2\"\n        elif rec_num <= 615: domain = \"SBD\u03b1-lid\"\n        else: domain = \"beyond-615\"\n        \n        domain_counts[domain] += 1\n        domain_residues[domain].add(rec_num)\n        \n        if pep_num not in pep_domains:\n            pep_domains[pep_num] = set()\n        pep_domains[pep_num].add(domain)\n    \n    # Get cluster score\n    ss = f\"{d}/output/12_caprieval/capri_ss.tsv\"\n    af = dq = \"?\"\n    if os.path.exists(ss):\n        with open(ss) as f:\n            slines = [l for l in f if not l.startswith('#')]\n        sreader = csv.DictReader(slines, delimiter='\\t')\n        for row in sreader:\n            cid = row.get('cluster_id','')\n            if cid == str(cl):\n                score = float(row['score']); air = float(row.get('air',0))\n                af = f\"{score - 0.1*air:.2f}\"\n                dq = f\"{float(row.get('dockq',0)):.3f}\"\n                break\n    \n    print(f\"\\n=== Cluster {cl} (AIR-free={af}, DockQ={dq}) ===\")\n    print(f\"  NBD={domain_counts['NBD']} SBD\u03b2={domain_counts['SBD\u03b2']} lid={domain_counts['SBD\u03b1-lid']} beyond={domain_counts['beyond-615']}\")\n    if domain_residues['NBD']:\n        print(f\"  NBD residues: {sorted(domain_residues['NBD'])}\")\n    if domain_residues['SBD\u03b2']:\n        print(f\"  SBD\u03b2 residues: {min(domain_residues['SBD\u03b2'])}-{max(domain_residues['SBD\u03b2'])}\")\n    if domain_residues['SBD\u03b1-lid']:\n        print(f\"  SBD\u03b1-lid residues: {sorted(domain_residues['SBD\u03b1-lid'])}\")\n    if domain_residues['beyond-615']:\n        print(f\"  beyond-615 residues: {sorted(domain_residues['beyond-615'])}\")\n    \n    # Per-residue domain mapping\n    print(f\"  Per-residue:\")\n    for pn in sorted(pep_domains.keys()):\n        ds = pep_domains[pn]\n        if \"NBD\" in ds and \"SBD\u03b2\" in ds:\n            tag = \"NBD+S\u03b2\"\n        elif \"NBD\" in ds:\n            tag = \"NBD\"\n        elif \"SBD\u03b1-lid\" in ds and \"SBD\u03b2\" in ds:\n            tag = \"lid+S\u03b2\"\n        elif \"SBD\u03b1-lid\" in ds:\n            tag = \"lid\"\n        elif \"SBD\u03b2\" in ds:\n            tag = \"S\u03b2\"\n        else:\n            tag = \"?\"\n        print(f\"    B{pn}: {tag}\")\nPYEOF"}

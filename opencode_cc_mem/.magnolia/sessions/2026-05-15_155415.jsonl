{"event_type":"tool_call","timestamp":"2026-06-10T12:43:07.624153Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c echo \"=== HADDOCK Asn90 check ===\" && for lig in Z11-16-Ald Z11-16-Ac; do\n  echo \"--- $lig ---\"\n  python3 -c \"\nimport gzip, math\natoms = []\nwith gzip.open('projects/obp/runs/2026-06-09_docking_5NGH/haddock3_runs/run_${lig}/output/5_seletopclusts/cluster_1_model_1.pdb.gz','rt') as f:\n    for l in f:\n        if not (l.startswith('ATOM') or l.startswith('HETATM')): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        chain = l[21:22].strip()\n        resnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        atoms.append((res, resnum, chain, name, x, y, z))\n\nrec = [a for a in atoms if a[2]=='A']\nlig = [a for a in atoms if a[2]=='B']\n\n# Find Asn90 and its contacts\nasn90 = [a for a in rec if a[1]==90]\nfor ra in asn90:\n    for la in lig:\n        d = math.sqrt((ra[4]-la[4])**2 + (ra[5]-la[5])**2 + (ra[6]-la[6])**2)\n        if d < 8.0:\n            print(f'  {ra[0]}{ra[1]}:{ra[3]} -- {la[3]}  d={d:.2f}\u00c5')\n\" 2>/dev/null\ndone"}

{"event_type":"tool_call","timestamp":"2026-06-09T08:28:57.227714Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport json, re\nfrom scipy.stats import spearmanr\nimport numpy as np\n\nwith open('compounds.json') as f:\n    exp_data = json.load(f)\nwith open('gnina_dock_v3.out') as f:\n    text = f.read()\n\nblocks = text.split('mode |  affinity')\ndock = []\nfor block in blocks[1:]:\n    for line in block.strip().split('\\n'):\n        m = re.match(r'\\s+(\\d+)\\s+(-?\\d+\\.\\d+)\\s+(-?\\d+\\.\\d+)\\s+(\\d+\\.\\d+)\\s+(\\d+\\.\\d+)', line)\n        if m:\n            dock.append(float(m.group(2)))  # affinity in kcal/mol\n            break\n\n# Sort by experimental Kd (lower = better binder)\npairs = []\nfor i, c in enumerate(exp_data):\n    kd = c.get('kd_obp3')\n    if kd is not None and i < len(dock):\n        pairs.append((c['name'], kd, dock[i]))\n\n# Sort by affinity (more negative = better predicted binder)\npairs.sort(key=lambda x: x[2])\n\nprint(f\"{'Rank':<5s} {'Compound':<25s} {'Affinity':>10s} {'Kd_exp':>10s} {'Kd_class':>12s}\")\nprint(\"-\" * 70)\nfor rank, (name, kd, aff) in enumerate(pairs, 1):\n    kd_class = \"STRONG\" if kd < 1.0 else (\"MOD\" if kd < 10 else (\"WEAK\" if kd < 43 else \"NON\"))\n    print(f\"{rank:<5d} {name:<25s} {aff:>+10.2f} {kd:>10.3f} {kd_class:>12s}\")\n\n# Spearman\nkd_arr = np.array([p[1] for p in pairs])\naff_arr = np.array([p[2] for p in pairs])\nrho, p = spearmanr(aff_arr, kd_arr)\nprint(f\"\\nSpearman \u03c1 = {rho:+.4f}  p = {p:.4f}\")\n\n# Check selectivity test specifically\nprint(\"\\n=== Selectivity: Z11-16 series ===\")\nfor n, k, a in pairs:\n    if 'Z11-16' in n:\n        print(f\"  {n:<15s} affinity={a:+6.2f} kcal/mol  Kd={k:.3f} \u00b5M\")\n\n# Check if top-10 by affinity are enriched for strong binders\ntop10 = set(p[0] for p in pairs[:10])\nstrong = set(p[0] for p in pairs if p[1] < 1.0)\noverlap = top10 & strong\nprint(f\"\\nTop-10 by affinity: {len(overlap)}/{len(strong)} strong binders recovered\")\nfor n in sorted(overlap):\n    print(f\"  \u2713 {n}\")\n\nPYEOF"}

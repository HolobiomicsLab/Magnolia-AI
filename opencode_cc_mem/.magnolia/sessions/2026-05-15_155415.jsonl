{"event_type":"tool_call","timestamp":"2026-06-18T13:41:08.010516Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, math\n\ndef parse_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                })\n    return atoms\n\ndef d3(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\natoms = parse_pdb('projects/hsc70_new/runs/2026-06-17_RKALQ_s5000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\na3 = [a for a in atoms if a['chain'] == 'B' and a['resi'] == 3]\nrec_atoms = [a for a in atoms if a['chain'] == 'A']\nrec_xyz = [(a['x'], a['y'], a['z']) for a in rec_atoms]\n\nca = [a for a in a3 if a['name'] == 'CA'][0]\ncb = [a for a in a3 if a['name'] == 'CB'][0]\n\ncb_dir = (cb['x'] - ca['x'], cb['y'] - ca['y'], cb['z'] - ca['z'])\nl = math.sqrt(cb_dir[0]**2 + cb_dir[1]**2 + cb_dir[2]**2)\nu = (cb_dir[0]/l, cb_dir[1]/l, cb_dir[2]/l)\n\n# Perpendiculars for lateral sweep\nperp1 = (u[1], -u[0], 0)\nl1 = math.sqrt(perp1[0]**2 + perp1[1]**2)\nperp1 = (perp1[0]/l1, perp1[1]/l1, 0)\nperp2 = (u[1]*perp1[2] - u[2]*perp1[1], u[2]*perp1[0] - u[0]*perp1[2], u[0]*perp1[1] - u[1]*perp1[0])\n\n# Nearest receptors to CB\nprint(\"=== Nearest receptor atoms to CB ===\")\ncb_near = [(math.sqrt((cb['x']-ra['x'])**2+(cb['y']-ra['y'])**2+(cb['z']-ra['z'])**2), ra) for ra in rec_atoms]\ncb_near.sort()\nfor d, ra in cb_near[:8]:\n    sign = '+/-' if ra['resn'] in ['ARG','LYS','ASP','GLU'] else ('\u03a6' if ra['resn'] in ['ALA','VAL','LEU','ILE','PHE','TRP','MET','PRO'] else '~')\n    print(f\"  {ra['chain']}-{ra['resi']}-{ra['resn']} {ra['name']:5s}  {d:.1f}\u00c5  [{sign}]\")\n\nprint(\"\\n=== Void space along CB (conical sweep \u00b130\u00b0) ===\")\nfor label, dist_out in [(\"ALA methyl\", 1.5), (\"VAL branch\", 2.5), (\"ILE branch\", 3.0), (\"LEU tip\", 4.0)]:\n    min_dist = 99\n    for angle in range(0, 360, 45):\n        rad = math.radians(angle)\n        cone_r = dist_out * 0.25\n        lateral = (perp1[0]*cone_r*math.cos(rad) + perp2[0]*cone_r*math.sin(rad),\n                   perp1[1]*cone_r*math.cos(rad) + perp2[1]*cone_r*math.sin(rad),\n                   perp1[2]*cone_r*math.cos(rad) + perp2[2]*cone_r*math.sin(rad))\n        forward = dist_out * 0.9\n        probe = (cb['x'] + u[0]*forward + lateral[0],\n                 cb['y'] + u[1]*forward + lateral[1],\n                 cb['z'] + u[2]*forward + lateral[2])\n        d = min(d3(probe, rc) for rc in rec_xyz)\n        min_dist = min(min_dist, d)\n    \n    if min_dist > 2.5: status = \"CLEAR\"\n    elif min_dist > 1.5: status = \"TIGHT\"\n    else: status = \"CLASH\"\n    print(f\"  {label:20s} nearest receptor: {min_dist:.1f}\u00c5  [{status}]\")\n\n# Now check the actual receptor residues contacting ALA3 methyl\nprint(\"\\n=== Receptor residues near ALA3 CB (<5\u00c5) ===\")\nfor ra in rec_atoms:\n    d = math.sqrt((cb['x']-ra['x'])**2+(cb['y']-ra['y'])**2+(cb['z']-ra['z'])**2)\n    if d < 5.0:\n        sign = '+/-' if ra['resn'] in ['ARG','LYS','ASP','GLU'] else ('\u03a6' if ra['resn'] in ['ALA','VAL','LEU','ILE','PHE','TRP','MET','PRO'] else '~')\n        print(f\"  {ra['chain']}-{ra['resi']}-{ra['resn']:3s} {sign}  {ra['name']:5s}  {d:.1f}\u00c5\")\n\nPYEOF"}

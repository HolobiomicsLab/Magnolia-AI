 = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = 647\nfle_end_2 = {fle_end}\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 4\n\n[caprieval]\nallatoms = true\n\n[contactmap]\n\"\"\"\n    with open(os.path.join(run_dir, \"config.cfg\"), \"w\") as f:\n        f.write(config)\n    \n    print(f\"Created: {dirname} (fle_end={fle_end}, {nres} residues)\")\n\nPYEOF\n"}

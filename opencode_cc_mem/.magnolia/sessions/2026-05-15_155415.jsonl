{"event_type":"tool_call","timestamp":"2026-06-12T07:40:59.287989Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                })\n    return atoms\n\ndef dist(a1, a2): \n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\nPOS_GROUPS = {'LYS': ['NZ'], 'ARG': ['NH1','NH2']}\nNEG_GROUPS = {'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2']}\nHBOND_DONORS_H = {\n    'ARG': {'NH1': ['HH11','HH12'], 'NH2': ['HH21','HH22'], 'NE': ['HE']},\n    'LYS': {'NZ': ['HZ1','HZ2','HZ3']},\n    'ASN': {'ND2': ['HD21','HD22']}, 'GLN': {'NE2': ['HE21','HE22']},\n    'SER': {'OG': ['HG']}, 'THR': {'OG1': ['HG1']}, 'TYR': {'OH': ['HH']},\n}\nHBOND_ACCEPTORS = {\n    'ASP': ['OD1','OD2'], 'GLU': ['OE1','OE2'],\n    'ASN': ['OD1'], 'GLN': ['OE1'], 'SER': ['OG'], 'THR': ['OG1'], 'TYR': ['OH'],\n}\nAPOLAR = {'ALA','VAL','LEU','ILE','PRO','PHE','TRP','MET','CYS'}\n\nname = 'KFERQ (5-mer)'\npath = '/tmp/kferq5_cl1m1.pdb'\natoms = parse_pdb(path)\nchain_a = [a for a in atoms if a['chain'] == 'A']\nchain_b = [a for a in atoms if a['chain'] == 'B']\n\nb_resis = sorted(set(a['resi'] for a in chain_b))\nb_seq = []\nfor r in b_resis:\n    a = next(a for a in chain_b if a['resi'] == r)\n    b_seq.append(f\"{a['resn']}{r}\")\n\nprint(f\"KFERQ (5-mer)  |  Peptide: {'-'.join(b_seq)}\")\n\n# Salt bridges\nsalt_bridges = []\nfor a_a in chain_a:\n    if a_a['resn'] not in POS_GROUPS and a_a['resn'] not in NEG_GROUPS: continue\n    for a_b in chain_b:\n        if a_b['resn'] not in POS_GROUPS and a_b['resn'] not in NEG_GROUPS: continue\n        a_charged = POS_GROUPS.get(a_a['resn']) or NEG_GROUPS.get(a_a['resn'])\n        b_charged = POS_GROUPS.get(a_b['resn']) or NEG_GROUPS.get(a_b['resn'])\n        if a_a['name'] not in a_charged: continue\n        if a_b['name'] not in b_charged: continue\n        a_is_pos = a_a['resn'] in POS_GROUPS\n        b_is_pos = a_b['resn'] in POS_GROUPS\n        if a_is_pos == b_is_pos: continue\n        d = dist(a_a, a_b)\n        if d <= 4.0:\n            salt_bridges.append((a_a, a_b, d))\n\nseen_sb = set()\nunique_sb = []\nfor a_a, a_b, d in sorted(salt_bridges, key=lambda x: x[2]):\n    key = (a_a['resi'], a_b['resi'])\n    if key not in seen_sb:\n        seen_sb.add(key)\n        unique_sb.append((a_a, a_b, d))\n\nprint(f\"\\nSALT BRIDGES (N\u2013O \u2264 4.0 \u00c5):\")\nfor a_a, a_b, d in unique_sb:\n    print(f\"  A-{a_a['resi']:>4}-{a_a['resn']:<4}{a_a['name']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}{a_b['name']:<4}  {d:.1f} \u00c5\")\n\n# H-bonds  \nhbonds = []\nfor a_a in chain_a:\n    for a_b in chain_b:\n        a_is_acceptor = a_a['name'] in HBOND_ACCEPTORS.get(a_a['resn'], [])\n        b_is_acceptor = a_b['name'] in HBOND_ACCEPTORS.get(a_b['resn'], [])\n        a_is_hdonor = a_a['name'] in HBOND_DONORS_H.get(a_a['resn'], {})\n        b_is_hdonor = a_b['name'] in HBOND_DONORS_H.get(a_b['resn'], {})\n        d = dist(a_a, a_b)\n        if d > 3.5: continue\n        if a_is_acceptor and b_is_hdonor:\n            hbonds.append((a_b, a_a, d, 'B\u2192A'))\n        elif b_is_acceptor and a_is_hdonor:\n            hbonds.append((a_a, a_b, d, 'A\u2192B'))\n\nseen_hb = set()\nunique_hb = []\nfor donor, acceptor, d, direction in sorted(hbonds, key=lambda x: x[2]):\n    key = (donor['resi'], acceptor['resi'])\n    if key not in seen_hb:\n        seen_hb.add(key)\n        unique_hb.append((donor, acceptor, d, direction))\n\nprint(f\"\\nH-BONDS (donor-H \u2192 acceptor \u2264 3.5 \u00c5):\")\nfor donor, acceptor, d, direction in unique_hb:\n    dp = f\"A-{donor['resi']}-{donor['resn']}:{donor['name']}\" if donor['chain'] == 'A' else f\"B-{donor['resi']}-{donor['resn']}:{donor['name']}\"\n    ap = f\"A-{acceptor['resi']}-{acceptor['resn']}:{acceptor['name']}\" if acceptor['chain'] == 'A' else f\"B-{acceptor['resi']}-{acceptor['resn']}:{acceptor['name']}\"\n    print(f\"  {dp} \u2192 {ap}  {d:.1f} \u00c5 [{direction}]\")\n\n# Hydrophobic\nhydrophobic = []\nfor a_a in chain_a:\n    if a_a['resn'] not in APOLAR: continue\n    if a_a['name'] != 'CB' and not (a_a['resn'] == 'GLY' and a_a['name'] == 'CA'): continue\n    for a_b in chain_b:\n        if a_b['resn'] not in APOLAR: continue\n        if a_b['name'] != 'CB' and not (a_b['resn'] == 'GLY' and a_b['name'] == 'CA'): continue\n        d = dist(a_a, a_b)\n        if d <= 5.0:\n            hydrophobic.append((a_a, a_b, d))\n\nprint(f\"\\nHYDROPHOBIC CONTACTS (C\u03b2\u2013C\u03b2 \u2264 5.0 \u00c5):\")\nif hydrophobic:\n    for a_a, a_b, d in sorted(hydrophobic, key=lambda x: x[2]):\n        print(f\"  A-{a_a['resi']:>4}-{a_a['resn']:<4} \u2194 B-{a_b['resi']}-{a_b['resn']:<4}  {d:.1f} \u00c5\")\nelse:\n    print(f\"  (none)\")\n\n# Per-residue contacts\nprint(f\"\\nPER-RESIDUE CONTACT MAP (receptor contacts \u2264 4.0 \u00c5):\")\nfor b_r in b_resis:\n    contacts = []\n    for a_a in chain_a:\n        best_d = 999\n        for a_b in chain_b:\n            if a_b['resi'] != b_r: continue\n            d = dist(a_a, a_b)\n            if d < best_d: best_d = d\n        if best_d <= 4.0:\n            contacts.append((a_a['resi'], a_a['resn'], best_d))\n    contacts.sort(key=lambda x: x[2])\n    b_rn = next(a['resn'] for a in chain_b if a['resi'] == b_r)\n    contact_str = ', '.join(f\"{r}-{rn}({d:.1f})\" for r, rn, d in contacts[:10])\n    if len(contacts) > 10: contact_str += f' ... (+{len(contacts)-10})'\n    print(f\"  B-{b_r}-{b_rn:<4} \u2192 {len(contacts):>2} contacts: {contact_str}\")\n\n# Total unique receptor contacts\nall_receptor = set()\nfor a_a in chain_a:\n    for a_b in chain_b:\n        if dist(a_a, a_b) <= 4.0:\n            all_receptor.add(a_a['resi'])\nprint(f\"\\n  Total unique receptor residues contacting peptide: {len(all_receptor)}\")\n\n# R650 contacts in detail\nprint(f\"\\nR650 (B-650-ARG) detailed contacts:\")\nfor a_a in chain_a:\n    best_d = 999\n    best_name = ''\n    for a_b in chain_b:\n        if a_b['resi'] != 650: continue\n        d = dist(a_a, a_b)\n        if d < best_d: \n            best_d = d\n            best_name = a_b['name']\n    if best_d <= 5.0:\n        print(f\"  A-{a_a['resi']:>4}-{a_a['resn']:<4} \u2192 B-650-ARG:{best_name}  {best_d:.1f} \u00c5\")\nPYEOF"}

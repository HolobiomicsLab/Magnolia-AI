{"event_type":"tool_call","timestamp":"2026-07-01T17:06:48.321321Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport os, csv, re\n\ndef get_scores(run_dir):\n    for sfx in ['12_caprieval', '09_caprieval']:\n        ss = f\"{run_dir}/output/{sfx}/capri_ss.tsv\"\n        if not os.path.exists(ss): continue\n        with open(ss) as f:\n            lines = [l for l in f if not l.startswith('#')]\n        reader = csv.DictReader(lines, delimiter='\\t')\n        clusters = {}\n        for row in reader:\n            cid = row.get('cluster_id','')\n            if not cid.isdigit(): continue\n            cid = int(cid)\n            score = float(row['score']); air = float(row.get('air',0))\n            af = score - 0.1*air\n            if cid not in clusters or af < clusters[cid]['af']:\n                clusters[cid] = {'af': af, 'dq': float(row.get('dockq',0)),\n                                 'vdw': float(row.get('vdw',0)), 'elec': float(row.get('elec',0)),\n                                 'bsa': float(row.get('bsa',0)), 'desolv': float(row.get('desolv',0))}\n        sizes = {}\n        clf = f\"{run_dir}/output/10_clustfcc/clustfcc.txt\"\n        if os.path.exists(clf):\n            with open(clf) as f:\n                for line in f:\n                    m = re.search(r'Cluster (\\d+) \\(#(\\d+), n=(\\d+)', line)\n                    if m: sizes[int(m.group(1))] = (int(m.group(2)), int(m.group(3)))\n        return clusters, sizes\n    return None, None\n\ndef contact_info(run_dir, cl):\n    fpath = f\"{run_dir}/output/13_contactmap/cluster{cl}_interchain_contacts.tsv\"\n    if not os.path.exists(fpath): return None\n    with open(fpath) as f:\n        lines = [l for l in f if not l.startswith('#')]\n    reader = csv.DictReader(lines, delimiter='\\t')\n    core = {403,404,405,406,411,426,427,428,429,430,431,435,437,438,439,440,460,469,473}\n    rec_set = set()\n    for row in reader:\n        p1 = row['res1'].split('-')\n        if len(p1) >= 3:\n            try: rec_set.add(int(p1[1]))\n            except: pass\n    return len(rec_set & core), 460 in rec_set, 404 in rec_set\n\n# All TGFMALQ family + RKALQ family with correct paths\npeptides = [\n    (\"TGFMALQ\", \"runs/2026-06-17_TGFMALQ_s10000\"),\n    (\"TAFMALQ\", \"runs/2026-06-18_TAFMALQ_s10000\"),\n    (\"RKALQ\", \"runs/2026-06-17_RKALQ_s5000\"),\n    (\"RKGLQ\", \"runs/2026-06-17_RKGLQ_s5000\"),\n    (\"RKNLQ\", \"runs/2026-06-17_RKNLQ_s5000\"),\n    (\"RKVLQ\", \"runs/2026-06-18_RKVLQ_s5000\"),\n    (\"RKILQ\", \"runs/2026-06-18_RKILQ_s5000\"),\n    (\"RKLLQ\", \"runs/2026-06-18_RKLLQ_s5000\"),\n    # TGGFQMALT for reference\n    (\"TGGFQMALT\", \"runs/2026-06-16_af3_TGGFQMALT_s10000_full\"),\n]\n\nprint(f\"{'Peptide':<12s} {'Cl':>3s} {'n':>5s} {'%':>5s} {'AIR-free':>9s} {'DockQ':>6s} {'vdw':>8s} {'elec':>8s} {'desolv':>8s} {'bsa':>5s} {'Core':>5s} {'E460':>5s}\")\nprint(\"-\" * 95)\n\nfor label, rd in peptides:\n    d = f\"projects/hsc70_new/{rd}\"\n    clusters, sizes = get_scores(d)\n    if not clusters:\n        print(f\"{label:<12s}  \u2014 no data ({rd})\")\n        continue\n    \n    for cid in sorted(clusters.keys()):\n        c = clusters[cid]\n        rank_n = sizes.get(cid, (0,0))\n        rank, n = rank_n\n        pct = f\"{100*n/200:.0f}%\" if n else \"?\"\n        \n        ci = contact_info(d, cid)\n        if ci:\n            core_overlap, has460, has404 = ci\n            print(f\"{label:<12s} {cid:>3d} {n:>5d} {pct:>5s} {c['af']:>+9.2f} {c['dq']:>6.3f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['desolv']:>+8.1f} {c['bsa']:>5.0f} {core_overlap:>4d}/19 {'\u2713' if has460 else '\u2717':>5s}\")\n        else:\n            print(f\"{label:<12s} {cid:>3d} {n:>5d} {pct:>5s} {c['af']:>+9.2f} {c['dq']:>6.3f} {c['vdw']:>+8.1f} {c['elec']:>+8.1f} {c['desolv']:>+8.1f} {c['bsa']:>5.0f}  \u2014\")\nPYEOF"}

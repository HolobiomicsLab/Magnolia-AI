a['kws'])\n        if ov > best:\n            best = ov\n            best_pn = pn\n    results.append((best, bn, best_pn, sdata['title']))\n\nstrong = sum(1 for r in results if r[0] >= 10)\nmed   = sum(1 for r in results if 7 <= r[0] < 10)\nlow   = sum(1 for r in results if 5 <= r[0] < 7)\nvlow  = sum(1 for r in results if r[0] < 5)\ntotal = len(results)\n\nprint(f\"Project entries: {len(entries)}  |  Staging: {total}\")\nprint(f\"  >=10 kw overlap (well covered):   {strong:3d} ({strong*100//total}%)\")\nprint(f\"  7-9 kw overlap  (partially):      {med:3d} ({med*100//total}%)\")\nprint(f\"  5-6 kw overlap  (weakly):         {low:3d} ({low*100//total}%)\")\nprint(f\"  <5 kw overlap   (uncovered):      {vlow:3d} ({vlow*100//total}%)\")\nprint()\n\n# Show the low coverage entries by category\nprint(\"=== UNCOVERED / VERY WEAK (<5) ===\")\ncats = {}\nfor ov, bn, pn, title in results:\n    if ov < 5:\n        t = title.lower()\n        if 'bindcraft' in t: g = 'bindcraft_install'\n        elif any(w in t for w in ['shell','tool','mcp','nonetype','attributeerror','pipe']): g = 'tool_errors'\n        elif any(w in t for w in ['session','conversation','distillation','memory_']): g = 'session_meta'\n        elif any(w in t for w in ['p2rank']): g = 'p2rank'\n        elif any(w in t for w in ['vmd']): g = 'vmd'\n        elif any(w in t for w in ['rsync','fetch','ssh','azzurra','pending']): g = 'operations'\n        elif any(w in t for w in ['topoaa','acpype','parameter']): g = 'setup'\n        else: g = 'other'\n        cats.setdefault(g,[]).append(title[:100])\n\nfor g in sorted(cats.keys()):\n    items = cats[g]\n    print(f\"\\n  [{g}] ({len(items)})\")\n    for t in items[:3]:\n        print(f\"    - {t}\")\n    if len(items) > 3:\n        print(f\"    ... +{len(items)-3} more\")\nPYEOF\n"}

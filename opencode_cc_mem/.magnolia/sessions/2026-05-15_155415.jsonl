{"event_type":"tool_call","timestamp":"2026-06-10T12:57:08.353982Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport gzip, sys\n\n# Extract top pose from docked_asn90.sdf\nwith open('projects/obp/runs/2026-06-10_gnina_asn90_box/docked_asn90.sdf') as f:\n    content = f.read()\nblocks = content.split('\\$\\$\\$\\$')\n# Find block with best CNNscore\nbest = None\nbest_cnn = -1\nfor b in blocks:\n    if not b.strip(): continue\n    lines = b.strip().split('\\n')\n    for j, l in enumerate(lines):\n        if l.startswith('> <CNNscore>'):\n            cnn = float(lines[j+1])\n            if cnn > best_cnn:\n                best_cnn = cnn\n                best = b\n            break\n\nif best:\n    with open('/tmp/z11_asn90_top.sdf', 'w') as f:\n        f.write(best)\n        f.write('\\$\\$\\$\\$\\n')\n    print(f'Top pose CNNscore: {best_cnn}')\nelse:\n    print('No poses found')\n\""}

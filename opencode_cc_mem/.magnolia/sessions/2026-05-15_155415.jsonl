{"event_type":"tool_call","timestamp":"2026-06-09T10:01:41.873571Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\n# Check cavity gate residues in the protonated receptor\n# Key: Asp87, Asn90, Met39 \u2014 these gate the cavity\n\ngate_residues = [\n    ('ASP', 87), ('ASN', 90), ('MET', 39),\n    ('GLU', 120), ('SER', 122), ('SER', 73)\n]\n\nprint(\"\u2550\u2550\u2550 Cavity gate residues in receptor (with hydrogens) \u2550\u2550\u2550\")\nprint(f\"{'Residue':<12s} {'Atom':<6s} {'X':>8s} {'Y':>8s} {'Z':>8s}\")\nprint(\"-\" * 45)\n\nwith open('receptor.pdb') as f:\n    for line in f:\n        if not (line.startswith('ATOM') or line.startswith('HETATM')):\n            continue\n        rname = line[17:20].strip()\n        try:\n            rnum = int(line[22:26].strip())\n        except:\n            continue\n        atom = line[12:16].strip()\n        \n        for gname, gnum in gate_residues:\n            if rname == gname and rnum == gnum:\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                print(f\"  {gname} {gnum:<4d}  {atom:<6s} {x:>8.1f} {y:>8.1f} {z:>8.1f}\")\n\n# Also count hydrogens in the gate region\nprint(f\"\\n\u2550\u2550\u2550 Hydrogen atoms near gate residues (within 5 \u00c5 of Asn90 CG) \u2550\u2550\u2550\")\nasn90_cg = (37.3, -30.2, -0.3)\nh_count = 0\nwith open('receptor.pdb') as f:\n    for line in f:\n        if not (line.startswith('ATOM') or line.startswith('HETATM')):\n            continue\n        elem = line[76:78].strip()\n        if elem != 'H':\n            continue\n        x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n        d = ((x-asn90_cg[0])**2 + (y-asn90_cg[1])**2 + (z-asn90_cg[2])**2)**0.5\n        if d < 5.0:\n            h_count += 1\n            rname = line[17:20].strip()\n            rnum = line[22:26].strip()\n            if h_count <= 10:\n                print(f\"  H atom: {rname} {rnum} at ({x:.1f}, {y:.1f}, {z:.1f}) dist={d:.1f}\")\nprint(f\"  ... total {h_count} hydrogens within 5 \u00c5 of Asn90\")\n\nPYEOF"}
{"event_type":"tool_success","timestamp":"2026-06-09T10:01:41.919735Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":47,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-09T10:02:05.080940Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH && python3 << 'PYEOF'\nimport gzip\n\n# Asn90 H-bond donor: ND2 at (37.7, -29.2, 0.5), HD21 & HD22 nearby\nASN_ND2 = (37.7, -29.2, 0.5)\nASN_OD1 = (37.8, -31.3, -0.3)\n\n# Z11-16:Ald is the 32nd compound (index 31 in alphabetical order)\n# 20 poses \u2192 starting at entry 31*20 = 620\nZ11_IDX = 31 * 20\n\nwith gzip.open('docked.sdf.gz', 'rt') as f:\n    content = f.read()\nmols = content.strip().split('$$$$\\n')\n\nprint(\"\u2550\u2550\u2550 Z11-16:Ald \u2014 top pose vs Asn90 \u2550\u2550\u2550\")\nmol = mols[Z11_IDX].strip()\nlines = mol.split('\\n')\nnatoms = int(lines[3][:3].strip())\n\n# Find the aldehyde oxygen (closest to any O atom)\no_atoms = []\nfor j in range(4, 4 + natoms):\n    l = lines[j]\n    elem = l[31:34].strip() if len(l) > 34 else ''\n    if elem == 'O':\n        x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n        d_nd2 = ((x-ASN_ND2[0])**2 + (y-ASN_ND2[1])**2 + (z-ASN_ND2[2])**2)**0.5\n        d_od1 = ((x-ASN_OD1[0])**2 + (y-ASN_OD1[1])**2 + (z-ASN_OD1[2])**2)**0.5\n        o_atoms.append((x, y, z, d_nd2, d_od1))\n\nprint(f\"  Aldehyde O atoms: {len(o_atoms)}\")\nfor x, y, z, dnd2, dod1 in o_atoms:\n    print(f\"    O at ({x:.1f}, {y:.1f}, {z:.1f})\")\n    print(f\"    dist to Asn90 ND2: {dnd2:.1f} \u00c5  (H-bond if <3.5)\")\n    print(f\"    dist to Asn90 OD1: {dod1:.1f} \u00c5\")\n\n# Also check overall pose quality: is the aldehyde carbon near Asn90?\nprint(f\"\\n\u2550\u2550\u2550 All 20 poses \u2014 aldehyde O distance to Asn90 ND2 \u2550\u2550\u2550\")\nfor pose_i in range(20):\n    mol = mols[Z11_IDX + pose_i].strip()\n    lines = mol.split('\\n')\n    try:\n        natoms = int(lines[3][:3].strip())\n    except:\n        continue\n    min_dist = 999\n    for j in range(4, 4 + natoms):\n        l = lines[j]\n        elem = l[31:34].strip() if len(l) > 34 else ''\n        if elem == 'O':\n            x, y, z = float(l[0:10]), float(l[10:20]), float(l[20:30])\n            d = ((x-ASN_ND2[0])**2 + (y-ASN_ND2[1])**2 + (z-ASN_ND2[2])**2)**0.5\n            if d < min_dist: min_dist = d\n    hbond = \" \u2713 H-BOND\" if min_dist < 3.5 else \"\"\n    print(f\"  Pose {pose_i+1:2d}: O-ND2 = {min_dist:.1f} \u00c5{hbond}\")\n\nPYEOF"}

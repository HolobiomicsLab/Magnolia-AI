{"event_type":"tool_call","timestamp":"2026-06-11T09:26:30.219068Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\n# Map to clean names\nresults = []\n\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21:\n                continue\n            results.append({\n                'run': d,\n                'score': float(parts[4]),\n                'dockq': float(parts[12]),\n                'irmsd': float(parts[6]),\n                'bsa': float(parts[20]),\n                'air': float(parts[18]),\n                'cluster_n': int(parts[2]),\n                'cluster_id': int(parts[1]),\n                'rank': int(parts[0])\n            })\n            if parts[0] == '1':\n                break\n\n# Deduplicate by run name (take first cluster_rank=1)\nseen = set()\nuniq = []\nfor r in results:\n    if r['run'] not in seen:\n        seen.add(r['run'])\n        uniq.append(r)\n\n# Sort by category\ndef cat(r):\n    n = r['run']\n    if 'x2' in n or 'fusion' in n or 'variant' in n:\n        return 3\n    if 'pK' in n or 'pF' in n or 'pQ' in n or 'pA_C' in n or 'ApKFERQ' in n:\n        return 2\n    if 'p2rank' in n:\n        return 1\n    return 0\n\nuniq.sort(key=lambda r: (cat(r), r['score']))\n\nprint(f'{'Run':<42} {'Score':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7} {'AIR':>8}')\nprint('-' * 82)\nfor r in uniq:\n    print(f'{r[\\\"run\\\"]:<42} {r[\\\"score\\\"]:>9.2f} {r[\\\"dockq\\\"]:>6.3f} {r[\\\"irmsd\\\"]:>7.3f} {r[\\\"bsa\\\"]:>7.0f} {r[\\\"air\\\"]:>8.1f}')\n\""}

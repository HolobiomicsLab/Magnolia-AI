data = json.load(f)\nexp_lk = {c['name']: c.get('kd_obp3',999) for c in exp_data}\n\n# \u2500\u2500 Blocks \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nGOOD  = []  # Kd < 1 \u00b5M  (strong binders)\nMOD   = []  # 1 \u2264 Kd < 10 \u00b5M\nWEAK  = []  # 10 \u2264 Kd < 43 \u00b5M\nNON   = []  # Kd = 42.55 (no binding at highest concentration)\n\nfor i, fn in enumerate(sdf_names):\n    if i >= len(dock): break\n    name = name_map.get(fn, fn)\n    kd = exp_lk.get(name, 999)\n    aff, cnn, cnnaff = dock[i]\n    entry = (aff, name, kd, cnn, cnnaff)\n    if kd < 1.0:     GOOD.append(entry)\n    elif kd < 10:    MOD.append(entry)\n    elif kd < 43:    WEAK.append(entry)\n    else:            NON.append(entry)\n\nfor block in GOOD:  GOOD.sort(key=lambda x: x[0])\nfor block in MOD:   MOD.sort(key=lambda x: x[0])\nfor block in WEAK:  WEAK.sort(key=lambda x: x[0])\nfor block in NON:   NON.sort(key=lambda x: x[0])\n\ndef show(title, entries):\n    print(f\"\\n{'\u2500'*100}\")\n    print(f\"  {title}  ({len(entries)} compounds, sorted by gnina affinity)\")\n    print(f\"{'\u2500'*100}\")\n    print(f\"  {'Compound':<24s} {'Kd_exp':>8s} {'GninaAff':>9s} {'CNNpose':>8s} {'CNNaff':>8s}\")\n    print(f\"  {'-'*60}\")\n    for aff, name, kd, cnn, cnnaff in entries:\n        print(f\"  {name:<24s} {kd:>8.3f} {aff:>+9.2f} {cnn:>8.4f} {cnnaff:>8.4f}\")\n\nshow(\"PAPER: STRONG BINDERS (Kd < 1 \u00b5M) \u2014 gnina should score these BEST\", GOOD)\nshow(\"PAPER: MODERATE BINDERS (1 \u2264 Kd < 10 \u00b5M)\", MOD)\nshow(\"PAPER: WEAK / MARGINAL BINDERS (10 \u2264 Kd < 43 \u00b5M)\", WEAK)\nshow(\"PAPER: NON-BINDERS \u2014 NEGATIVE CONTROLS (Kd = 42.55 \u00b5M, no displacement at 200 \u00b5M)\", NON)\n\n# Stats\nprint(f\"\\n{'\u2500'*100}\")\nprint(\"  STATISTICS\")\nprint(f\"{'\u2500'*100}\")\nimport numpy as np\nfor label, grp in [(\"STRONG binders\",GOOD),(\"MODERATE binders\",MOD),(\"WEAK binders\",WEAK),(\"NON binders (neg ctl)\",NON)]:\n    if grp:\n        affs = [g[0] for g in grp]\n        print(f\"  {label:<25s} gnina affinity: {np.mean(affs):+.2f} \u00b1 {np.std(affs):.2f}  (range: {min(affs):+.2f} to {max(affs):+.2f})\")\nPYEOF"}

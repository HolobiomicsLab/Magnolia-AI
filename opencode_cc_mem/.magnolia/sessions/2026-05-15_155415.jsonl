{"event_type":"tool_call","timestamp":"2026-06-17T09:15:32.902064Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c ssh azzurra 'python3 << \"PYEOF\"\nimport os, csv, re\n\nbase = \"/workspace/tjiang/magnolia/hsc70_new/runs\"\nw_air = 0.01\n\nruns = {\n    \"213648\": \"TGGFQMALT\", \"213650\": \"KFERQ\", \"213651\": \"KILDQ\",\n    \"213653\": \"RKDLQ\", \"213654\": \"RKELQ\", \"213656\": \"QRKEL\",\n    \"213703\": \"HAMNG\", \"213704\": \"KFERQKFERRQ\", \"213706\": \"QRKELQRKEL\",\n    \"213707\": \"RKELQRKELQ\", \"213709\": \"RKDLQRKDDQ\", \"213710\": \"KFERQKILDQRFFE\",\n}\nruns_4po2 = {\n    \"121304\": \"KFERQ\", \"121306\": \"HAMNG\", \"121308\": \"RKELQ\",\n    \"135825\": \"KILDQ\", \"135828\": \"RKDLQ\", \"135830\": \"QRKEL\",\n    \"135833\": \"KFERQKFERRQ\", \"135835\": \"QRKELQRKEL\", \"135838\": \"RKELQRKELQ\",\n    \"165058\": \"RKDLQRKDDQ\", \"165100\": \"KFERQKILDQRFFE\",\n}\naa_map = {\"ALA\":\"A\",\"ARG\":\"R\",\"ASN\":\"N\",\"ASP\":\"D\",\"CYS\":\"C\",\"GLN\":\"Q\",\"GLU\":\"E\",\n           \"GLY\":\"G\",\"HIS\":\"H\",\"ILE\":\"I\",\"LEU\":\"L\",\"LYS\":\"K\",\"MET\":\"M\",\"PHE\":\"F\",\n           \"PRO\":\"P\",\"SER\":\"S\",\"THR\":\"T\",\"TRP\":\"W\",\"TYR\":\"Y\",\"VAL\":\"V\",\"HIE\":\"H\",\"ACE\":\"x\"}\n\ndef get_sequence(p):\n    res = {}\n    with open(p) as f:\n        for l in f:\n            if l.startswith(\"ATOM\"):\n                rn = l[17:20].strip()\n                rs = int(l[22:26].strip())\n                if rs not in res: res[rs] = rn\n    s = \"\"\n    for k in sorted(res):\n        o = aa_map.get(res[k], \"?\")\n        if o != \"x\": s += o\n    return s\n\ndef get_capri(rd):\n    cp = os.path.join(rd, \"output\", \"12_caprieval\", \"capri_clt.tsv\")\n    if not os.path.isfile(cp): return []\n    with open(cp) as f:\n        lines = [l for l in f if not l.startswith(\"#\")]\n    r = csv.DictReader(lines, delimiter=\"\\t\")\n    out = []\n    for row in r:\n        out.append({\"rank\":int(row[\"cluster_rank\"]),\"n\":int(row[\"n\"]),\n            \"score\":float(row[\"score\"]),\"air\":float(row[\"air\"]),\n            \"dockq\":float(row[\"dockq\"]),\"irmsd\":float(row[\"irmsd\"]),\n            \"fnat\":float(row[\"fnat\"]),\n            \"af\":float(row[\"score\"]) - w_air*float(row[\"air\"])})\n    return out\n\ndef get_cf(rd):\n    cf = os.path.join(rd, \"output\", \"10_clustfcc\", \"clustfcc.txt\")\n    if not os.path.isfile(cf): return None\n    total = 0\n    c1 = None\n    with open(cf) as f:\n        for l in f:\n            if l.startswith(\"Cluster \"):\n                total += 1\n                m = re.search(r\"n=(\\d+)\", l)\n                if m:\n                    n = int(m.group(1))\n                    if total == 1: c1 = n\n    return {\"total\": total, \"c1_real\": c1}\n\nprint(\"###AF3###\")\nfor rid in sorted(runs):\n    label = runs[rid]\n    rd = os.path.join(base, \"haddock3_20260616_\" + rid)\n    pep = os.path.join(rd, \"peptide.pdb\")\n    seq = get_sequence(pep) if os.path.isfile(pep) else \"NA\"\n    cl = get_capri(rd)\n    cf = get_cf(rd)\n    print(f\"RUN|{rid}|{label}|{seq}|{len(seq)}|{cf['total'] if cf else '?'}|{cf['c1_real'] if cf else '?'}\")\n    for c in cl[:3]:\n        print(f\"CL|c{c['rank']}|{c['n']}|{c['score']:.3f}|{c['air']:.3f}|{c['af']:.2f}|{c['dockq']:.3f}|{c['irmsd']:.3f}|{c['fnat']:.3f}\")\n\nprint(\"###4PO2###\")\nfor rid in sorted(runs_4po2):\n    label = runs_4po2[rid]\n    rd = os.path.join(base, \"haddock3_20260616_\" + rid)\n    cl = get_capri(rd)\n    cf = get_cf(rd)\n    c = cl[0] if cl else None\n    print(f\"RUN|{rid}|{label}|{cf['total'] if cf else '?'}|{cf['c1_real'] if cf else '?'}\")\n    if c:\n        print(f\"CL|c1|{c['n']}|{c['score']:.3f}|{c['air']:.3f}|{c['af']:.2f}|{c['dockq']:.3f}|{c['irmsd']:.3f}\")\nPYEOF'"}

xt))\n                if m:\n                    print(f'  sampling: s{m.group(1)}')\n                \n                # Check command\n                m = re.search(r'command[\"\\']\\s*:\\s*[\"\\']([^\"\\']{5,200})', str(text))\n                if m:\n                    print(f'  cmd: {m.group(1)}')\n                \n                # Get reasoning context (message text around this)\n                # Find which message has the reasoning\n                context = msg.get('content', msg.get('data', {}))\n                if isinstance(context, dict):\n                    content = context.get('content', '')\n                    if 'memory' in content.lower() or 'ncores' in content.lower() or 'sampling' in content.lower() or 'haddock3' in content.lower():\n                        print(f'  context: {content[:500]}')\n                \n        except Exception as e:\n            print(f'  ERROR: {e}')\n\nconn.close()\nPYEOF\n 2>&1"}

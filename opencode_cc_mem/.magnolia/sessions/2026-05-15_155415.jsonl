{"event_type":"tool_call","timestamp":"2026-06-17T15:07:51.496926Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\npdb = \"/tmp/rkdlq_c1_m1.pdb\"\n\n# Parse atoms\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"):\n            continue\n        chain = line[21]\n        x = float(line[30:38])\n        y = float(line[38:46])\n        z = float(line[46:54])\n        resname = line[17:20].strip()\n        resid = int(line[22:26])\n        atomname = line[12:16].strip()\n        atoms.append((chain, resname, resid, atomname, x, y, z))\n\ndef get_atom(chain, resid, atomname):\n    for a in atoms:\n        if a[0] == chain and a[2] == resid and a[3] == atomname:\n            return a[4], a[5], a[6]\n    return None\n\ndef dist(p1, p2):\n    return math.sqrt(sum((a-b)**2 for a,b in zip(p1, p2)))\n\ndef vec(p1, p2):\n    return tuple(b-a for a,b in zip(p1, p2))\n\ndef vec_len(v):\n    return math.sqrt(sum(x*x for x in v))\n\ndef normalize(v):\n    l = vec_len(v)\n    return tuple(x/l for x in v) if l > 0 else (0,0,0)\n\ndef dot(v1, v2):\n    return sum(a*b for a,b in zip(v1, v2))\n\n# ============================================================\n# 1. N-TERMINAL GEOMETRY OF PEPTIDE (chain B, resi 1 = ARG)\n# ============================================================\n\nN_pos = get_atom('B', 1, 'N')\nCA_pos = get_atom('B', 1, 'CA')\nC_pos = get_atom('B', 1, 'C')\nCB_pos = get_atom('B', 1, 'CB')\n\nprint(\"=\" * 70)\nprint(\"N-TERMINAL GEOMETRY \u2014 ARG1 (chain B)\")\nprint(\"=\" * 70)\n\n# Vector from CA to N (opposite of N\u2192CA, i.e. direction TO the N-terminus)\nN_to_CA = vec(N_pos, CA_pos)\nCA_to_N = vec(CA_pos, N_pos)\nprint(f\"N\u2192CA vector:       ({N_to_CA[0]:6.2f}, {N_to_CA[1]:6.2f}, {N_to_CA[2]:6.2f})  length={vec_len(N_to_CA):.2f} \u00c5\")\nprint(f\"CA\u2192N vector:       ({CA_to_N[0]:6.2f}, {CA_to_N[1]:6.2f}, {CA_to_N[2]:6.2f})  length={vec_len(CA_to_N):.2f} \u00c5\")\nprint(f\"N atomic position: ({N_pos[0]:6.2f}, {N_pos[1]:6.2f}, {N_pos[2]:6.2f})\")\n\n# Backbone direction (CA \u2192 C)\nCA_to_C = vec(CA_pos, C_pos)\nprint(f\"CA\u2192C vector:       ({CA_to_C[0]:6.2f}, {CA_to_C[1]:6.2f}, {CA_to_C[2]:6.2f})  length={vec_len(CA_to_C):.2f} \u00c5\")\n\n# The direction an N-terminal extension would grow:\n# A new residue X0 would be added BEFORE ARG1. Its C-terminus bonds to ARG1's N.\n# The new residue's C\u03b1 position would be roughly:\n#   - extend ~3.8 \u00c5 from N in the N\u2192CA direction (the direction the amide bond points)\n#   - the sidechain branches from C\u03b1\n# \n# Actually, the direction from N to the new C\u03b1 is approximately the opposite\n# of the CA\u2192N bond direction. In an extended chain, the backbone zigzags.\n# More precisely: the new C\u03b1 position = N_pos + CA_to_N (approximately)\n# because the amide bond N-terminus connects to the previous residue's C=O,\n# and the C\u03b1 of that previous residue is roughly in the CA\u2192N direction\n# extended by ~1.45 \u00c5 (C-N bond) + ~1.52 \u00c5 (N-C\u03b1 bond) = ~3.0 \u00c5 along N\u2192CA.\n\n# Let me compute a realistic new C\u03b1 position:\n# The new C\u03b1 would be along the direction from N back toward where the previous\n# residue would be. A simple approximation: new_C\u03b1 \u2248 N + CA_to_N_normalized * 3.0\nca_to_n_norm = normalize(CA_to_N)\nnew_ca_pos = tuple(N_pos[i] + ca_to_n_norm[i] * 3.0 for i in range(3))\nprint(f\"\\nProjected new C\u03b1 (N + 3.0 \u00c5 along CA\u2192N): ({new_ca_pos[0]:6.2f}, {new_ca_pos[1]:6.2f}, {new_ca_pos[2]:6.2f})\")\n\n# The new C\u03b2 (sidechain origin) would branch from new C\u03b1.\n# For each residue type, the sidechain extends in a different direction.\n# CB direction from CA is roughly: CA + CB_vector_direction * 1.53 \u00c5\n# The CB vector is approximately opposite to the average of N\u2192CA and C\u2192CA\n# (the sidechain points away from the peptide plane).\n\n# Compute direction of CB from CA for ARG1 as a reference:\nCB_pos_arg = get_atom('B', 1, 'CB')\nca_to_cb = vec(CA_pos, CB_pos_arg)\nca_to_cb_norm = normalize(ca_to_cb)\nprint(f\"CA1\u2192CB1 vector:    ({ca_to_cb[0]:6.2f}, {ca_to_cb[1]:6.2f}, {ca_to_cb[2]:6.2f})  length={vec_len(ca_to_cb):.2f} \u00c5\")\n\n# Projected CB for new residue:\nnew_cb_pos = tuple(new_ca_pos[i] + ca_to_cb_norm[i] * 1.53 for i in range(3))\n\nprint(f\"\\nProjected new C\u03b2 (new_CA + 1.53 \u00c5 \u00d7 CA1\u2192CB1): ({new_cb_pos[0]:6.2f}, {new_cb_pos[1]:6.2f}, {new_cb_pos[2]:6.2f})\")\n\n# ============================================================\n# 2. DISTANCES TO TARGET RECEPTOR RESIDUES\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"DISTANCES FROM N-TERMINUS / PROJECTED NEW RESIDUE TO TARGETS\")\nprint(\"=\" * 70)\n\ntargets = [\n    (431, \"TYR\", \"SBD\u03b2, R1 contacts this (4.4 \u00c5 shortest)\"),\n    (469, \"ARG\", \"SBD\u03b2, 2.16 \u00c5 from peptide\"),\n    (543, \"GLU\", \"LID, 3.60 \u00c5 from peptide\"),\n]\n\n# Also check which peptide residue each target is closest to\nrec_atoms_by_res = {}\nfor a in atoms:\n    if a[0] == 'A':\n        k = a[2]\n        if k not in rec_atoms_by_res:\n            rec_atoms_by_res[k] = []\n        rec_atoms_by_res[k].append((a[3], a[4], a[5], a[6]))\n\npep_atoms = [(a[2], a[3], a[4], a[5], a[6]) for a in atoms if a[0] == 'B']\n\nfor t_resid, t_name, t_desc in targets:\n    print(f\"\\n--- Target: {t_resid}-{t_name} ({t_desc}) ---\")\n    \n    # Closest receptor atom to N, CA, CB of ARG1, and to projected new CA/CB\n    r_atoms = rec_atoms_by_res.get(t_resid, [])\n    if not r_atoms:\n        print(\"  No atoms found\")\n        continue\n    \n    # Distance from ARG1 N\n    min_d_n = min(dist(N_pos, (ra[1], ra[2], ra[3])) for ra in r_atoms)\n    print(f\"  ARG1-N      \u2192 {t_name}{t_resid}: {min_d_n:.2f} \u00c5\")\n    \n    # Distance from ARG1 CA\n    min_d_ca = min(dist(CA_pos, (ra[1], ra[2], ra[3])) for ra in r_atoms)\n    print(f\"  ARG1-CA     \u2192 {t_name}{t_resid}: {min_d_ca:.2f} \u00c5\")\n    \n    # Distance from projected new C\u03b1\n    min_d_newca = min(dist(new_ca_pos, (ra[1], ra[2], ra[3])) for ra in r_atoms)\n    print(f\"  new-CA      \u2192 {t_name}{t_resid}: {min_d_newca:.2f} \u00c5\")\n    \n    # Distance from projected new C\u03b2\n    min_d_newcb = min(dist(new_cb_pos, (ra[1], ra[2], ra[3])) for ra in r_atoms)\n    print(f\"  new-CB      \u2192 {t_name}{t_resid}: {min_d_newcb:.2f} \u00c5\")\n    \n    # Which peptide resi is closest to this target?\n    best = (999, 0, \"\")\n    for pid, paname, px, py, pz in pep_atoms:\n        for ra in r_atoms:\n            d = dist((px, py, pz), (ra[1], ra[2], ra[3]))\n            if d < best[0]:\n                best = (d, pid, paname)\n    print(f\"  Closest peptide contact: B-{best[1]}-{best[2]} at {best[0]:.2f} \u00c5\")\n\n# ============================================================\n# 3. HOW FAR CAN ONE RESIDUE REACH?\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"REACH OF ONE N-TERMINAL RESIDUE\")\nprint(\"=\" * 70)\n\n# A typical amino acid: backbone ~3.8 \u00c5 (C\u03b1-C\u03b1)\n# Sidechain max reach from C\u03b1 depends on residue:\n# - GLY: ~0 \u00c5 (no sidechain)\n# - ALA: ~1.5 \u00c5 (methyl)\n# - ARG: ~6.5 \u00c5 (guanidinium at end of long chain)\n# - LYS: ~6.0 \u00c5 (amino at end of chain)\n# - TYR: ~6.0 \u00c5 (phenyl ring)\n# - GLU: ~5.0 \u00c5 (carboxylate)\n\n# But the key question is: can a single residue at position 0 reach\n# residues that are currently ~X \u00c5 from the N-terminus?\n# The new residue adds ~3.8 \u00c5 backbone + sidechain reach.\n# Total reach from current N = ~3 \u00c5 (to new C\u03b1) + sidechain length\n\nreach = {\n    \"GLY\": (0, \"no sidechain\"),\n    \"ALA\": (1.5, \"methyl\"),\n    \"ARG\": (6.5, \"guanidinium, longest reach\"),\n    \"LYS\": (6.0, \"amino-butyl chain\"),\n    \"TYR\": (5.5, \"phenyl ring\"),\n    \"PHE\": (5.0, \"phenyl ring\"),\n    \"GLU\": (5.0, \"carboxylate chain\"),\n    \"GLN\": (5.0, \"amide chain\"),\n    \"ASP\": (3.5, \"carboxylate\"),\n    \"ASN\": (3.5, \"amide\"),\n    \"SER\": (2.5, \"hydroxyl\"),\n    \"THR\": (3.0, \"hydroxyl\"),\n    \"VAL\": (3.0, \"isopropyl\"),\n    \"LEU\": (4.0, \"isobutyl\"),\n    \"ILE\": (4.0, \"sec-butyl\"),\n    \"MET\": (5.0, \"thioether chain\"),\n    \"TRP\": (5.5, \"indole ring\"),\n    \"HIS\": (4.5, \"imidazole\"),\n}\n\nprint(f\"{'Res':>4s}  {'Backbone (\u00c5)':>12s}  {'CB reach (\u00c5)':>12s}  {'Total from N (\u00c5)':>16s}  Notes\")\nprint(\"-\" * 70)\n\n# Backbone: N \u2192 C\u03b1 \u2248 1.45 \u00c5 (N-C\u03b1 bond), plus the N-C bond to previous \u2248 1.32 \u00c5\n# But the vector direction matters. Approximate: new C\u03b1 is 3.0 \u00c5 from current N.\n\nBB_EXTENSION = 3.0  # N to new C\u03b1 distance\n\nfor res, (reach_val, note) in sorted(reach.items(), key=lambda x: -x[1][0]):\n    total = BB_EXTENSION + reach_val\n    print(f\"{res:>4s}  {BB_EXTENSION:12.1f}  {reach_val:12.1f}  {total:16.1f}  {note}\")\n\n# ============================================================\n# 4. ANGLE ANALYSIS \u2014 direction from N toward targets\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"ANGULAR ANALYSIS \u2014 IS THE TARGET IN THE RIGHT DIRECTION?\")\nprint(\"=\" * 70)\n\n# The new N-terminal residue extends roughly in the direction of CA\u2192N\n# (from the N atom, going backward along the backbone).\n# If the target is in the OPPOSITE direction (toward C\u2192CA, i.e., deeper into\n# the channel), the extension WON'T reach it; it will go the wrong way.\n\nfor t_resid, t_name, t_desc in targets:\n    print(f\"\\n--- Target: {t_resid}-{t_name} ---\")\n    \n    # Find the closest receptor atom to N\n    r_atoms = rec_atoms_by_res.get(t_resid, [])\n    closest_ra = min(r_atoms, key=lambda ra: dist(N_pos, (ra[1], ra[2], ra[3])))\n    closest_pos = (closest_ra[1], closest_ra[2], closest_ra[3])\n    \n    # Vector from N to target\n    n_to_target = vec(N_pos, closest_pos)\n    n_to_target_norm = normalize(n_to_target)\n    d_nt = vec_len(n_to_target)\n    \n    # Vector from N toward the N-terminal direction (CA\u2192N direction)\n    nterm_dir = CA_to_N  # points from CA to N = direction toward N-terminus\n    \n    # For N-terminal extension, the new residue extends FURTHER in the\n    # N-terminal direction. From the N atom, going backward along backbone:\n    # N \u2192 new_C\u03b1 is approximately along N\u2192CA (which is opposite to CA\u2192N)\n    # Actually: the new residue's C=O bonds to the current N.\n    # The new C\u03b1 is positioned such that:\n    #   new_C=O --- N_current --- C\u03b1_current --- ...\n    # So the vector from N_current to new_C\u03b1 is approximately perpendicular\n    # to the N-C\u03b1 bond, leaning slightly toward the CA\u2192N direction.\n    \n    # More precisely in peptide geometry:\n    # The amide plane is N_current(i), H(i), C(i-1), O(i-1)\n    # new_C\u03b1(i-1) is connected to C(i-1)\n    # From N_current(i), going to new_C\u03b1(i-1):\n    #   - first go to C(i-1): roughly along the HN bond direction (opposite)\n    #   - then to C\u03b1(i-1): along C\u2192C\u03b1 which is similar to CA\u2192N direction\n    \n    # So N\u2192new_C\u03b1 \u2248 normalized(CA\u2192N) \u00d7 3.0 \u00c5 (this is our new_ca_pos)\n    \n    # Angle between N\u2192new_C\u03b1 direction and N\u2192target direction\n    new_ca_dir = normalize(vec(N_pos, new_ca_pos))\n    cos_angle = dot(new_ca_dir, n_to_target_norm)\n    angle = math.degrees(math.acos(max(-1, min(1, cos_angle))))\n    \n    print(f\"  N\u2192target distance:     {d_nt:.2f} \u00c5\")\n    print(f\"  N\u2192new_C\u03b1 direction:    ({new_ca_dir[0]:.3f}, {new_ca_dir[1]:.3f}, {new_ca_dir[2]:.3f})\")\n    print(f\"  N\u2192target direction:    ({n_to_target_norm[0]:.3f}, {n_to_target_norm[1]:.3f}, {n_to_target_norm[2]:.3f})\")\n    print(f\"  Angle (new_C\u03b1 vs target): {angle:.1f}\u00b0\")\n    \n    if angle < 60:\n        print(f\"  \u2192 FAVORABLE: target is in the N-terminal extension direction\")\n    elif angle < 90:\n        print(f\"  \u2192 MARGINAL:  target is somewhat off the extension axis\")\n    elif angle < 120:\n        print(f\"  \u2192 UNFAVORABLE: target is mostly in the wrong direction; sidechain needed\")\n    else:\n        print(f\"  \u2192 AGAINST: target is opposite to the extension direction; C-terminal extension would be better\")\n\n# ============================================================\n# 5. C-TERMINAL CHECK \u2014 for comparison\n# ============================================================\n\nprint()\nprint(\"=\" * 70)\nprint(\"C-TERMINAL EXTENSION (for comparison)\")\nprint(\"=\" * 70)\n\n# C-terminus: GLN5\nCterm_C = get_atom('B', 5, 'C')\nCterm_CA = get_atom('B', 5, 'CA')\nCterm_O = get_atom('B', 5, 'O')\n\n# Direction C\u2192new_N points from C along the C=O bond direction\n# but a C-terminal extension goes from the C atom toward the next residue.\n# C\u2192new_N \u2248 direction of CA\u2192C extended past C\nca5_to_c5 = vec(Cterm_CA, Cterm_C)\nca5_to_c5_norm = normalize(ca5_to_c5)\nnew_n_cterm = tuple(Cterm_C[i] + ca5_to_c5_norm[i] * 1.33 for i in range(3))\n\nprint(f\"C-term (GLN5 C):       ({Cterm_C[0]:6.2f}, {Cterm_C[1]:6.2f}, {Cterm_C[2]:6.2f})\")\nprint(f\"C-term direction:      ({ca5_to_c5_norm[0]:6.3f}, {ca5_to_c5_norm[1]:6.3f}, {ca5_to_c5_norm[2]:6.3f})\")\n\nfor t_resid, t_name, t_desc in targets:\n    r_atoms = rec_atoms_by_res.get(t_resid, [])\n    closest_ra = min(r_atoms, key=lambda ra: dist(Cterm_C, (ra[1], ra[2], ra[3])))\n    closest_pos = (closest_ra[1], closest_ra[2], closest_ra[3])\n    d_c = dist(Cterm_C, closest_pos)\n    \n    cterm_dir = normalize(vec(Cterm_C, new_n_cterm))\n    target_dir = normalize(vec(Cterm_C, closest_pos))\n    cos_a = dot(cterm_dir, target_dir)\n    angle = math.degrees(math.acos(max(-1, min(1, cos_a))))\n    \n    verdict = \"favorable\" if angle < 90 else \"against\"\n    print(f\"  \u2192 {t_name}{t_resid}: dist={d_c:.2f} \u00c5, angle={angle:.1f}\u00b0 ({verdict})\")\n\nPYEOF"}

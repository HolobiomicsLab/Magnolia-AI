{"event_type":"tool_call","timestamp":"2026-06-24T14:23:13.109177Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/measure.py << 'PYEOF'\nimport numpy as np, re, itertools\n\npdb = \"/tmp/cl2m1.pdb\"\n# Parse: list of (atom_name, res_name, chain, resnum, x, y, z, element)\natoms = []\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith(\"ATOM\"): continue\n        atom_name = line[12:16].strip()\n        res_name  = line[17:20].strip()\n        chain     = line[21]\n        resnum    = int(line[22:26])\n        x=float(line[30:38]); y=float(line[38:46]); z=float(line[46:54])\n        elem = line[76:78].strip() if len(line)>=78 else atom_name[0]\n        atoms.append(dict(an=atom_name, rn=res_name, ch=chain, ri=resnum,\n                          xyz=np.array([x,y,z]), el=elem))\n\ndef A(ch, ri, an):\n    return [a for a in atoms if a['ch']==ch and a['ri']==ri and a['an']==an]\ndef res_atoms(ch, ri):\n    return [a for a in atoms if a['ch']==ch and a['ri']==ri]\ndef dist(a,b): return np.linalg.norm(a['xyz']-b['xyz'])\n\n# Ring atoms for aromatic residues (PHE: CG,CD1,CD2,CE1,CE2,CZ ; TYR: same + OH ; TRP: CD2,CE2,CE3,CZ2,CZ3,CH2)\nRING = {\"PHE\": [\"CG\",\"CD1\",\"CD2\",\"CE1\",\"CE2\",\"CZ\"],\n        \"TYR\": [\"CG\",\"CD1\",\"CD2\",\"CE1\",\"CE2\",\"CZ\"],\n        \"TRP\": [\"CG\",\"CD1\",\"CD2\",\"NE1\",\"CE2\",\"CE3\",\"CZ2\",\"CZ3\",\"CH2\"]}\ndef centroid(ch, ri, rn):\n    rs = res_atoms(ch, ri)\n    if rn not in RING: return None\n    names = RING[rn]\n    pts = [a['xyz'] for a in rs if a['an'] in names]\n    if len(pts) < 3: return None\n    return np.mean(pts, axis=0)\n\ndef closest_pairs(pch, pri, rch, rri_list, cutoff=5.0, exclude_backbone_only_H=False):\n    pa = res_atoms(pch, pri)\n    out = []\n    for rri in rri_list:\n        ra = res_atoms(rch, rri)\n        for a in pa:\n            for b in ra:\n                d = dist(a,b)\n                if d <= cutoff:\n                    out.append((rri, a['an'], a['rn'], b['an'], b['rn'], d))\n    out.sort(key=lambda x: x[5])\n    return out\n\nprint(\"=\"*70)\nprint(\"PEPTIDE: B-2=T1, B-3=G2, B-4=G3, B-5=F4, B-6=Q5, B-7=M6, B-8=A7, B-9=L8, B-10=T9\")\nprint(\"=\"*70)\n\npeptide_map = [(2,\"T1\",\"THR\"),(3,\"G2\",\"GLY\"),(4,\"G3\",\"GLY\"),(5,\"F4\",\"PHE\"),\n               (6,\"Q5\",\"GLN\"),(7,\"M6\",\"MET\"),(8,\"A7\",\"ALA\"),(9,\"L8\",\"LEU\"),(10,\"T9\",\"THR\")]\n\n# Per-residue receptor contacts (shortest-dist <= 5.0)\nprint(\"\\n### A. Closest receptor heavyatom contacts per peptide residue (<=5.0 A)\")\nfor pri, label, rn in peptide_map:\n    pairs = closest_pairs(\"B\", pri, \"A\", list(range(388,647)), cutoff=5.0)\n    # unique receptor residues, keep shortest\n    seen = {}\n    for rri, pan, prn, ran, rrn, d in pairs:\n        if rri not in seen or d < seen[rri][1]:\n            seen[rri] = ((pan,prn,ran,rrn), d)\n    items = sorted(seen.items(), key=lambda x: x[1][1])\n    print(f\"\\n  B-{pri} ({label}, {rn}):\")\n    for rri, ((pan,prn,ran,rrn), d) in items[:8]:\n        region = \"\u03b2-groove\" if 388<=rri<=508 else (\"lid\" if 509<=rri<=613 else (\"post-lid\" if rri>613 else \"?\"))\n        print(f\"    A-{rri}-{rrn:3s} [{region:8s}] {prn}-{pan}\u00b7\u00b7\u00b7{ran}-{rrn}  {d:.2f} \u00c5\")\nPYEOF\npython3 /tmp/measure.py"}

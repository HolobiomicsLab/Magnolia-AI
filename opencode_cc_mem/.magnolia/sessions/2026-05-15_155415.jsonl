{"event_type":"tool_call","timestamp":"2026-06-02T12:40:10.010548Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c DIR=\"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000\"\n\necho \"=== A-15-TYR contacts ===\"\ngrep 'A-15-TYR' \"$DIR/output/13_contactmap/cluster1_interchain_contacts.tsv\"\n\necho\necho \"=== B-648-PHE contacts ===\"\ngrep 'B-648-PHE' \"$DIR/output/13_contactmap/cluster1_interchain_contacts.tsv\"\n\necho\necho \"=== Measure ring centroid distance TYR15-PHE648 ===\"\npython3 -c \"\n# Read the best model PDB\npdb = '/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb'\nimport math\n\n# Collect ring atoms for TYR15 and PHE648\ntyr_ring = []  # CG, CD1, CD2, CE1, CE2, CZ\nphe_ring = []  # CG, CD1, CD2, CE1, CE2, CZ\n\nwith open(pdb) as f:\n    for line in f:\n        if not line.startswith('ATOM') and not line.startswith('HETATM'):\n            continue\n        resi = int(line[22:26].strip())\n        resn = line[17:20].strip()\n        atname = line[12:16].strip()\n        x = float(line[30:38])\n        y = float(line[38:46])\n        z = float(line[46:54])\n        \n        if resi == 15 and resn == 'TYR' and atname in ('CG','CD1','CD2','CE1','CE2','CZ'):\n            tyr_ring.append((atname, x, y, z))\n        if resi == 648 and resn == 'PHE' and atname in ('CG','CD1','CD2','CE1','CE2','CZ'):\n            phe_ring.append((atname, x, y, z))\n\nif tyr_ring and phe_ring:\n    tyr_cent = [sum(c[i] for _,c in tyr_ring)/len(tyr_ring) for i in range(3)]\n    phe_cent = [sum(c[i] for _,c in phe_ring)/len(phe_ring) for i in range(3)]\n    dist = math.sqrt(sum((tyr_cent[i]-phe_cent[i])**2 for i in range(3)))\n    print(f'TYR15 ring centroid: ({tyr_cent[0]:.1f}, {tyr_cent[1]:.1f}, {tyr_cent[2]:.1f})')\n    print(f'PHE648 ring centroid: ({phe_cent[0]:.1f}, {phe_cent[1]:.1f}, {phe_cent[2]:.1f})')\n    print(f'Ring centroid distance: {dist:.2f} \u00c5')\n    if dist < 5.5:\n        print('Within pi-stacking range (<5.5 \u00c5)')\n    elif dist < 7.0:\n        print('Marginal \u2014 weak pi contact possible')\n    else:\n        print('Too far for pi-stacking')\nelse:\n    print('Could not find ring atoms')\n\""}

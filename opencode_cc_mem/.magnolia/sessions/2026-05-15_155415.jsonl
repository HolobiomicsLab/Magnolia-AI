{"event_type":"tool_call","timestamp":"2026-06-11T09:54:42.784742Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob, re\n\ndef get_length(run_name):\n    n = run_name.lower()\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    if 'apkferq' in n: return 6\n    if 'kferqp' in n: return 6\n    return 5\n\ndef peptide_name(run_name):\n    n = re.sub(r'^\\d{4}-\\d{2}-\\d{2}_', '', run_name)\n    for s in ['_p2rank1','_clean','_SBD_']:\n        n = n.replace(s, '')\n    n = re.sub(r'_s\\d+', '', n) if not any(x in n for x in ['x2','fusion','variant']) else re.sub(r'_s\\d+', '', n)\n    return n\n\ndef cat(r):\n    n = r['run'].lower()\n    if 'x2' in n or 'fusion' in n or 'variant' in n: return 3\n    if 'apkferq' in n or 'kferqp' in n: return 2\n    if 'p2rank' in n: return 1\n    return 0\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nresults = []\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'): continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21: continue\n            score, air = float(parts[4]), float(parts[18])\n            results.append({\n                'run': d, 'pep': peptide_name(d),\n                'score': score, 'air_free': score - 0.1*air,\n                'dockq': float(parts[12]), 'bsa': float(parts[20]),\n                'len': get_length(d),\n            })\n            if parts[0] == '1': break\n\nseen = set()\nuniq = [r for r in results if r['run'] not in seen and not seen.add(r['run'])]\n\n# KFERQ p2rank parent for deltas\nparent = next(r for r in uniq if r['run'] == '2026-06-02_KFERQ_p2rank1_s5000')\n\n# P2Rank runs only\np2r = [r for r in uniq if cat(r) in (1,2,3)]\n\nprint(f\\\"{'Peptide':<26} {'Len':>3} {'AIR-free':>9} {'BSA':>7} {'AF/res':>8} {'AF/100A2':>10} {'\u0394AF vs parent':>14}\\\")\nprint('-' * 86)\nfor r in sorted(p2r, key=lambda x: x['air_free'] / x['bsa'], reverse=True):\n    delta = r['air_free'] - parent['air_free']\n    eff_res = r['air_free'] / r['len']\n    eff_bsa = r['air_free'] / r['bsa'] * 100\n    print(f\\\"{r['pep']:<26} {r['len']:>3} {r['air_free']:>9.2f} {r['bsa']:>7.0f} {eff_res:>8.2f} {eff_bsa:>10.3f} {delta:>14.2f}\\\")\n\""}

{"event_type":"tool_call","timestamp":"2026-06-26T12:59:19.098519Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cat > /tmp/mcp_smoke.py <<'PYEOF'\nimport json,sys; sys.path.insert(0,\"/tmp\"); from mcplib import *\nconnect()\n# 1. schema for create_knowledge_base\nres=post({\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\"})\ntools={}\ndef walk(x):\n    if isinstance(x,dict):\n        if x.get(\"result\",{}).get(\"tools\"):\n            for t in x[\"result\"][\"tools\"]:tools[t[\"name\"]]=t\n        for v in x.values():walk(v)\n    elif isinstance(x,list):\n        for v in x:walk(v)\nwalk(res)\nfor n in (\"create_knowledge_base\",\"add_dois_to_kb\"):\n    s=tools[n][\"inputSchema\"]; print(f\"{n}: required={s.get('required')} props={list(s.get('properties',{}).keys())}\")\n# 2. create KB\nprint(\"\\n--- create studium_refs ---\")\nprint(call(\"create_knowledge_base\",{\"name\":\"studium_refs\",\"description\":\"Studium manuscript references + literature-scan neighbors (DOI-verified)\"},t=60)[:300])\n# 3. smoke add 2 DOIs (one certain, one to verify: EduRAG)\nprint(\"\\n--- add_dois smoke (kasneci2023 + EduRAG) ---\")\nout=call(\"add_dois_to_kb\",{\"kb_name\":\"studium_refs\",\"dois\":[\"10.1016/j.lindif.2023.102274\",\"10.1109/access.2026.3704123\"]},t=180)\nprint(out[:600])\nPYEOF\ntimeout 220 python3 /tmp/mcp_smoke.py 2>&1 | head -40"}

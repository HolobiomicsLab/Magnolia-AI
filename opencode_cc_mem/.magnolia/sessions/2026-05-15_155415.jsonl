n    if all_mins:\n        print(f'  R4 \u2192 {target_resn}{target_resi}: min {min(all_mins):.1f}A avg {sum(all_mins)/len(all_mins):.1f}A')\n\nprint()\nprint('=== KFERQ: Q5(GLN651) contacts (Q5 predecessor) ===')\nfor target_resn, target_resi, target_atoms in [\n    ('ASP',10,ASP_COO), ('GLU',175,GLU_COO), ('ASP',199,ASP_COO),\n    ('ASP',234,ASP_COO), ('GLU',231,GLU_COO), ('GLU',268,GLU_COO),\n    ('LYS',271,LYS_NZ)\n]:\n    all_mins = []\n    for mf in models:\n        atoms = read_pdb(mf)\n        pep = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n               if c=='B' and rn=='GLN' and ri==651 and name in GLN_AMIDE]\n        rec = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n               if c=='A' and rn==target_resn and ri==target_resi and name in target_atoms]\n        if pep and rec:\n            all_mins.append(min(dist(p[1], r[1]) for p in pep for r in rec))\n    if all_mins:\n        print(f'  Q5 \u2192 {target_resn}{target_resi}: min {min(all_mins):.1f}A avg {sum(all_mins)/len(all_mins):.1f}A')\n\nprint()\nprint('=== Side-by-side: R4 vs K4, Q5 vs Q5 ===')\nprint(f'{\"Pair\":<18s} {\"KFERQ\":>10s} {\"KFQKQ\":>10s}')\nprint(f'{\"-\"*18} {\"-\"*10} {\"-\"*10}')\nprint(f'{\"R4/K4 \u2192 D10\":<18s} {\"\u2014\":>10s} {\"1.7A \u2713\":>10s}')\nprint(f'{\"R4/K4 \u2192 E175\":<18s} {\"\u2014\":>10s} {\"1.6A \u2713\":>10s}')\nprint(f'{\"R4/K4 \u2192 D199\":<18s} {\"\u2014\":>10s} {\"2.0A \u2713\":>10s}')\nprint(f'{\"R4/K4 \u2192 E231\":<18s} {\"1.6A \u2713\":>10s} {\"\u2014\":>10s}')\nprint(f'{\"R4/K4 \u2192 D234\":<18s} {\"1.6A \u2713\":>10s} {\"\u2014\":>10s}')\nprint(f'{\"R4/K4 \u2192 E268\":<18s} {\"1.7A \u2713\":>10s} {\"\u2014\":>10s}')\nprint(f'{\"R4/K4 \u2192 K271\":<18s} {\"3.0A clash\":>10s} {\"14A \u2713\":>10s}')\nprint(f'{\"Q5/Q5 \u2192 D10\":<18s} {\"2.2A \u2713\":>10s} {\"\u2014\":>10s}')\nprint(f'{\"Q5/Q5 \u2192 E175\":<18s} {\"1.8A \u2713\":>10s} {\"\u2014\":>10s}')\nprint(f'{\"Q5/Q5 \u2192 D199\":<18s} {\"2.3A \u2713\"
{"event_type":"tool_call","timestamp":"2026-06-12T14:06:44.774524Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'EOF'\n# Check the conformation of our Hsc70 receptor\n# Measure SBD-beta (resi ~394-509) vs SBD-alpha lid (resi ~510-615) distance\nimport math\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') and line[13:16].strip() == 'CA':\n                atoms.append({\n                    'resn': line[17:20].strip(), 'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                })\n    return atoms\n\npath = \"projects/hsc70_new/raw_input/receptor/hsc70-full_processed.pdb\"\natoms = parse_pdb(path)\nchain_a = [a for a in atoms if a['chain'] == 'A']\n\n# SBD-beta core (substrate binding pocket floor)\nsbd_beta = [a for a in chain_a if 394 <= a['resi'] <= 509]\n# SBD-alpha lid\nsbd_alpha = [a for a in chain_a if 510 <= a['resi'] <= 615]\n\n# Compute COM of each domain\ndef com(atoms):\n    x = sum(a['x'] for a in atoms) / len(atoms)\n    y = sum(a['y'] for a in atoms) / len(atoms)\n    z = sum(a['z'] for a in atoms) / len(atoms)\n    return (x, y, z)\n\ncom_beta = com(sbd_beta)\ncom_alpha = com(sbd_alpha)\ndist = math.sqrt(sum((a-b)**2 for a,b in zip(com_beta, com_alpha)))\nprint(f\"SBD-beta (394-509) COM: {com_beta}\")\nprint(f\"SBD-alpha/lid (510-615) COM: {com_alpha}\")\nprint(f\"COM distance: {dist:.1f} A\")\nprint(f\"SBD-beta residues: {len(sbd_beta)}\")\nprint(f\"SBD-alpha residues: {len(sbd_alpha)}\")\n\n# Key residue: check if lid covers the binding pocket by measuring\n# distance between lid residues and beta-sandwich residues\n# Known binding pocket residues in SBD-beta: I402, V405, T406, I413, A434, T435, I437, F440, D444, V471\n# Known lid residues that close: I515, Y530, M533, G534, L538\n\nprint(f\"\\n=== Key distances (lid vs pocket floor) ===\")\npocket_floor = [394, 401, 404, 433, 436, 437, 438, 470]  # approximate\nlid_key = [515, 530, 533, 534, 538]\n\nfor pr in pocket_floor:\n    for lr in lid_key:\n        a1 = next((a for a in chain_a if a['resi'] == pr), None)\n        a2 = next((a for a in chain_a if a['resi'] == lr), None)\n        if a1 and a2:\n            d = math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n            if d < 15:\n                print(f\"  SBD-beta {a1['resn']}{pr} \u2194 lid {a2['resn']}{lr}: {d:.1f} A\")\n\n# Check interdomain linker (resi ~386-393 connects NBD to SBD-beta)\nlinker = [a for a in chain_a if 386 <= a['resi'] <= 393]\nnbd = [a for a in chain_a if 1 <= a['resi'] <= 385]\ncom_linker = com(linker) if linker else (0,0,0)\ncom_nbd = com(nbd)\ncom_sbd_beta = com(sbd_beta)\nd_nbd_sbd = math.sqrt(sum((a-b)**2 for a,b in zip(com_nbd, com_sbd_beta)))\nprint(f\"\\nNBD-SBD beta COM distance: {d_nbd_sbd:.1f} A\")\n\n# In open state (ATP): NBD docked to SBD, lid open \u2192 NBD-SBD close, lid far\n# In closed state (ADP): NBD separated from SBD, lid closed \u2192 NBD-SBD far, lid close\nEOF"}

{"event_type":"tool_call","timestamp":"2026-06-10T12:57:37.448117Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\n# Parse receptor\nrec_atoms = []\nwith open('projects/obp/runs/2026-06-10_gnina_asn90_box/receptor.pdb') as f:\n    for l in f:\n        if not (l.startswith('ATOM') or l.startswith('HETATM')): continue\n        name = l[12:16].strip()\n        res = l[17:20].strip()\n        chain = l[21:22].strip()\n        resnum = int(l[22:26])\n        x = float(l[30:38]); y = float(l[38:46]); z = float(l[46:54])\n        rec_atoms.append((res, resnum, name, x, y, z))\n\n# Parse top ligand pose\nwith open('/tmp/z11_asn90_top.sdf') as f:\n    lines = f.readlines()\n\n# Find atom count and atoms\nna = int(lines[3][:3])\nlig_atoms = []\nfor i in range(4, 4+na):\n    l = lines[i]\n    x = float(l[0:10]); y = float(l[10:20]); z = float(l[20:30])\n    elem = l[31:34].strip() or 'C'\n    lig_atoms.append((f'L{i-3}', x, y, z))\n\n# Find contacts\nprint(f\"Receptor: {len(rec_atoms)} atoms, Ligand: {len(lig_atoms)} atoms\")\nprint(f\"Asn90 centroid: ({36.7:.1f}, {-29.4:.1f}, {-1.6:.1f})\")\nprint()\n\ncontacts = []\nfor ra in rec_atoms:\n    rres, rnum, rname, rx, ry, rz = ra\n    for la in lig_atoms:\n        lname, lx, ly, lz = la\n        d = math.sqrt((rx-lx)**2 + (ry-ly)**2 + (rz-lz)**2)\n        if d <= 5.0:\n            contacts.append((rres, rnum, rname, lname, d))\n\ncontacts.sort(key=lambda c: c[4])\n\n# Group by residue\nfrom collections import defaultdict\nby_res = defaultdict(list)\nfor c in contacts:\n    by_res[f\"{c[0]}{c[1]}\"].append(c)\n\nprint(f\"Total contacts (d <= 5.0A): {len(contacts)}\")\nprint()\nprint(f\"{'Residue':16s} {'#contacts':>10s} {'shortest':>9s}\")\nprint(\"-\" * 40)\nfor res in sorted(by_res, key=lambda r: min(c[4] for c in by_res[r])):\n    clist = by_res[res]\n    dmin = min(c[4] for c in clist)\n    print(f\"{res:16s} {len(clist):>10d} {dmin:>8.2f}A\")\n\nprint(f\"\\nTop 15 closest atom-level contacts:\")\nprint(f\"{'Receptor':24s} {'Ligand':12s} {'Dist(A)':>8s}\")\nprint(\"-\" * 48)\nfor c in contacts[:15]:\n    print(f\"{c[0]}{c[1]}:{c[2]:5s} {c[3]:12s} {c[4]:>8.2f}\")\n\n# Check Asn90\nprint(f\"\\nAsn90 contacts:\")\nasn90 = [c for c in contacts if c[0]=='ASN' and c[1]==90]\nif asn90:\n    for c in sorted(asn90, key=lambda x: x[4]):\n        print(f\"  ASN90:{c[2]} -- {c[3]}  d={c[4]:.2f}A\")\nelse:\n    # Check distance to Asn90 atoms\n    print(\"  No contacts within 5A. Checking distances...\")\n    for ra in rec_atoms:\n        if ra[0]=='ASN' and ra[1]==90:\n            for la in lig_atoms:\n                d = math.sqrt((ra[3]-la[1])**2 + (ra[4]-la[2])**2 + (ra[5]-la[3])**2)\n                if d < 8.0:\n                    print(f\"  ASN90:{ra[2]} -- {la[0]}  d={d:.2f}A\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-12T14:07:13.512951Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'EOF'\nimport math\n\ndef parse_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith('ATOM') and line[13:16].strip() == 'CA':\n                atoms.append({\n                    'resn': line[17:20].strip(), 'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]), 'y': float(line[38:46]), 'z': float(line[46:54]),\n                })\n    return atoms\n\npath = \"projects/hsc70_new/raw_input/receptor/hsc70-full_processed.pdb\"\natoms = parse_pdb(path)\nchain_a = [a for a in atoms if a['chain'] == 'A']\n\nmax_resi = max(a['resi'] for a in chain_a)\nmin_resi = min(a['resi'] for a in chain_a)\nprint(f\"Chain A residue range: {min_resi} - {max_resi}\")\n\n# NBD subdomains:\n# IA: ~1-39, 116-188\n# IB: ~40-115\n# IIA: ~189-228, 307-385\n# IIB: ~229-306\n# Interdomain linker: ~386-393\n# SBD-beta: ~394-509\n# SBD-alpha (lid): ~510-615\n\n# Check if lid is detached: measure min distance between any lid CA and any SBD-beta CA\nsbd_beta = [a for a in chain_a if 394 <= a['resi'] <= 509]\nsbd_alpha = [a for a in chain_a if 510 <= a['resi'] <= 615]\n\nmin_dist = 999\nclosest_pair = None\nfor a in sbd_alpha:\n    for b in sbd_beta:\n        d = math.sqrt((a['x']-b['x'])**2 + (a['y']-b['y'])**2 + (a['z']-b['z'])**2)\n        if d < min_dist:\n            min_dist = d\n            closest_pair = (a, b)\n\nprint(f\"\\nMin SBD-alpha \u2192 SBD-beta distance: {min_dist:.1f} A\")\nprint(f\"  Between: lid {closest_pair[0]['resn']}{closest_pair[0]['resi']} \u2194 SBD-beta {closest_pair[1]['resn']}{closest_pair[1]['resi']}\")\n\n# In open state, NBD is docked to SBD-beta via interdomain linker\n# Check if linker residue 393 CA is close to NBD\nlinker_393 = next((a for a in chain_a if a['resi'] == 393), None)\nnbd_core = [a for a in chain_a if 1 <= a['resi'] <= 39]  # IA subdomain\n\nif linker_393:\n    for a in nbd_core:\n        d = math.sqrt((a['x']-linker_393['x'])**2 + (a['y']-linker_393['y'])**2 + (a['z']-linker_393['z'])**2)\n        if d < 10:\n            print(f\"\\nLinker V393 close to NBD {a['resn']}{a['resi']}: {d:.1f} A \u2192 NBD-SBD docked (open state)\")\n            break\n\n# Check P2Rank pocket location relative to SBD-beta\n# The P2Rank pocket residues from our runs are at specific locations\n# Let me check what residues are around the KFERQ binding site\n# From our contact analysis: D366, T37, G202, G339, R272, E231, D234, E268, etc.\n# D366 is in SBD-beta? Let me check\nd366 = next((a for a in chain_a if a['resi'] == 366), None)\nif d366:\n    print(f\"\\nD366 (key K1 salt bridge partner): chain A, domain assignment: NBD (resi 1-385)\")\n\n# SBD-beta pocket key residues  \nr272 = next((a for a in chain_a if a['resi'] == 272), None)\ne231 = next((a for a in chain_a if a['resi'] == 231), None)\ng202 = next((a for a in chain_a if a['resi'] == 202), None)\ng339 = next((a for a in chain_a if a['resi'] == 339), None)\n\nprint(f\"R272 (key E3 partner): NBD\")\nprint(f\"E231 (key R4 partner): NBD\")  \nprint(f\"G202 (glycine-rich loop): NBD\")\nprint(f\"G339 (glycine-rich loop): NBD\")\n\n# So the peptide binds at the NBD-SBD-beta interface, not the SBD-alpha lid!\n# The P2Rank pocket is at the interdomain cleft\nprint(f\"\\n=== CONCLUSION ===\")\nprint(f\"The peptide binds at the NBD-SBD-beta interface cleft,\")\nprint(f\"not at the SBD-alpha lid (which is 64 A away).\")\nprint(f\"The 'lid' in our restraint definition (531-615) is misleading:\")\nprint(f\"P2Rank redirected restraints to residues near this cleft.\")\nEOF"}

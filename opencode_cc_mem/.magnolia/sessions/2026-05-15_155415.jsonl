{"event_type":"tool_call","timestamp":"2026-06-16T21:31:09.106616Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\n\nRECEPTOR=\"raw_input/receptor/Hsc70_AF3_closed_chainA.pdb\"\nDATE=\"2026-06-16\"\nREC_ACTIVE=\"403 404 405 406 411 426 427 428 429 430 431 435 437 438 439 440 460 469 473\"\nREC_PASSIVE=\"401 402 407 408 409 410 412 425 432 433 434 436 441 442 443 444 459 461 462 468 470 471 472\"\n\n# 5-mers: s5000\nFIVEMERS=(\"KFERQ:runs/${DATE}_4po2_KFERQ_s5000/peptide.pdb:647:651\"\n          \"KILDQ:runs/${DATE}_4po2_KILDQ_s5000/peptide.pdb:652:656\"\n          \"RKDLQ:runs/${DATE}_4po2_RKDLQ_s5000_full/peptide.pdb:1:5\"\n          \"RKELQ:runs/${DATE}_4po2_RKELQ_s5000/peptide.pdb:652:656\"\n          \"QRKEL:runs/${DATE}_4po2_QRKEL_s5000/peptide.pdb:652:656\"\n          \"HAMNG:runs/${DATE}_4po2_HAMNG_s5000_full/peptide.pdb:1:5\")\n\n# Long peptides: s10000\nLONGS=(\"KFERQx2:runs/${DATE}_4po2_KFERQx2_s10000_full/peptide.pdb:1:11\"\n       \"QRKELx2:runs/${DATE}_4po2_QRKELx2_s10000/peptide.pdb:647:656\"\n       \"RKELQx2:runs/${DATE}_4po2_RKELQx2_s10000/peptide.pdb:647:656\"\n       \"RKDLQ-variant:runs/${DATE}_4po2_RKDLQ-variant_s10000_full/peptide.pdb:647:656\"\n       \"KFERQ-KILDQ-fusion:runs/${DATE}_4po2_KFERQ-KILDQ-fusion_s10000_full/peptide.pdb:1:14\")\n\n# TGGFQMALT: s10000\nTGG=\"raw_input/peptides/TGGFQMALT.pdb\"\n\nsetup_run() {\n    local peptide=$1 pdb=$2 fle_start=$3 fle_end=$4 sampling=$5\n    RD=\"runs/${DATE}_af3_${peptide}_s${sampling}_full\"\n    mkdir -p \"$RD\"\n    cp \"$RECEPTOR\" \"$RD/receptor.pdb\"\n    cp \"$pdb\" \"$RD/peptide.pdb\"\n    \n    # Receptor actpass\n    echo \"$REC_ACTIVE\" > \"$RD/receptor.actpass\"\n    echo \"$REC_PASSIVE\" >> \"$RD/receptor.actpass\"\n    \n    # Peptide actpass\n    pep_resis=$(seq $fle_start $fle_end | tr '\\n' ' ')\n    echo \"$pep_resis\" > \"$RD/peptide.actpass\"\n    echo \"\" >> \"$RD/peptide.actpass\"\n    \n    cat > \"$RD/config.cfg\" << CFGEND\nrun_dir = \"output\"\nncores = 32\nmode = \"local\"\nmolecules = [\"receptor.pdb\", \"peptide.pdb\"]\n\n[topoaa]\n\n[rigidbody]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nsampling = $sampling\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[flexref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = $fle_start\nfle_end_2 = $fle_end\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nmdsteps_rigid = 2000\nmdsteps_cool1 = 2000\nmdsteps_cool2 = 4000\nmdsteps_cool3 = 4000\n\n[caprieval]\n\n[seletop]\nselect = 200\n\n[emref]\nambig_fname = \"ambig.tbl\"\n\n[mdref]\ntolerance = 5\nambig_fname = \"ambig.tbl\"\nfle_sta_2 = $fle_start\nfle_end_2 = $fle_end\nfle_seg_2 = \"B\"\nssdihed = \"alphabeta\"\nsolvent = \"water\"\nwaterheatsteps = 100\nwatersteps = 1250\nwatercoolsteps = 500\nkeepwater = false\n\n[caprieval]\n\n[clustfcc]\n\n[seletopclusts]\ntop_models = 20\n\n[caprieval]\nallatoms = true\n\n[contactmap]\nCFGEND\n\n    haddock3-restraints active_passive_to_ambig \\\n        \"$RD/receptor.actpass\" \"$RD/peptide.actpass\" \\\n        --segid-one A > \"$RD/ambig.tbl\" 2>/dev/null\n    \n    echo \"\u2713 $peptide: s=$sampling fle=$fle_start-$fle_end ambig=$(wc -l < \"$RD/ambig.tbl\")\"\n}\n\n# Setup TGGFQMALT separately\nsetup_run \"TGGFQMALT\" \"$TGG\" 1 9 10000\n\n# Setup 5-mers\nfor entry in \"${FIVEMERS[@]}\"; do\n    IFS=':' read -r peptide pdb start end <<< \"$entry\"\n    setup_run \"$peptide\" \"$pdb\" \"$start\" \"$end\" 5000\ndone\n\n# Setup long peptides\nfor entry in \"${LONGS[@]}\"; do\n    IFS=':' read -r peptide pdb start end <<< \"$entry\"\n    setup_run \"$peptide\" \"$pdb\" \"$start\" \"$end\" 10000\ndone"}

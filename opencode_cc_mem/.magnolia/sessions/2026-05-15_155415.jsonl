{"event_type":"tool_call","timestamp":"2026-06-13T10:27:26.837395Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\ndef strip_caps_and_renumber(inpath, outpath, start_resi, chain_id='B', remove_resn=['ACE', 'NHE']):\n    \"\"\"Remove cap residues and renumber remaining residues.\"\"\"\n    lines = []\n    with open(inpath, 'r') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                resn = line[17:20].strip()\n                if resn not in remove_resn:\n                    lines.append(line.rstrip())\n    \n    # Group by old residue number, map to new\n    old_resis = []\n    for line in lines:\n        old_resi = line[22:26].strip()\n        if old_resi not in old_resis:\n            old_resis.append(old_resi)\n    \n    resi_map = {r: start_resi + i for i, r in enumerate(old_resis)}\n    \n    atom_num = 1\n    with open(outpath, 'w') as out:\n        for line in lines:\n            old_resi = line[22:26].strip()\n            new_resi = resi_map[old_resi]\n            new_line = (\n                line[:6] +\n                f\"{atom_num:5d}\" +\n                line[11:21] +\n                f\"{chain_id}\" +\n                f\"{new_resi:4d}\" +\n                line[26:]\n            )\n            out.write(new_line + '\\n')\n            atom_num += 1\n        out.write('END\\n')\n    return outpath, len(lines), start_resi, start_resi + len(old_resis) - 1\n\n# Strip caps and renumber\nfor label, inpath, outpath in [\n    ('fusion_14mer', '/tmp/fusion_fixed.pdb', '/tmp/fusion_clean.pdb'),\n    ('qrkelx2_10mer', '/tmp/qrkelx2_fixed.pdb', '/tmp/qrkelx2_clean.pdb'),\n]:\n    out, n, rs, re = strip_caps_and_renumber(inpath, outpath, 647)\n    \n    # Verify backbone\n    atoms = []\n    with open(outpath, 'r') as f:\n        for line in f:\n            if line.startswith('ATOM') and 'CA' in line[12:16]:\n                resn = line[17:20].strip()\n                resi = line[22:26].strip()\n                x = float(line[30:38]); y = float(line[38:46]); z = float(line[46:54])\n                atoms.append((resn, resi, x, y, z))\n    \n    breaks = []\n    for i in range(1, len(atoms)):\n        dx = atoms[i][2] - atoms[i-1][2]; dy = atoms[i][3] - atoms[i-1][3]; dz = atoms[i][4] - atoms[i-1][4]\n        d = math.sqrt(dx*dx+dy*dy+dz*dz)\n        if d > 5.0:\n            breaks.append(f'{atoms[i-1][0]}{atoms[i-1][1]}->{atoms[i][0]}{atoms[i][1]}:{d:.1f}A')\n    \n    print(f'\\n{label}: {n} atoms, residues {rs}-{re}')\n    if breaks:\n        for b in breaks: print(f'  BROKEN: {b}')\n    else:\n        print(f'  Backbone OK ({len(atoms)} CA atoms, all ~3.8A)')\n    for a in atoms:\n        print(f'    {a[0]} {a[1]}')\nPYEOF"}

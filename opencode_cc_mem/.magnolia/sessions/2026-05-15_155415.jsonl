{"event_type":"tool_call","timestamp":"2026-06-24T12:06:34.223964Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs\necho \"############ RKALQL + RKALQR scores (12_caprieval) ############\"\npython3 - <<'PY'\nimport json\nfor label,r in [(\"RKALQL +C-term LEU\",\"2026-06-17_RKALQL_s10000\"),(\"RKALQR +C-term ARG\",\"2026-06-17_RKALQR_s10000\")]:\n    wp=f\"{r}/output/12_caprieval/weights_params.json\"\n    try: wair=json.load(open(wp)).get('w_air')\n    except: wair=0.1\n    tsv=f\"{r}/output/analysis/12_caprieval_analysis/capri_clt.tsv\"\n    rows=[];idx={}\n    try:\n        with open(tsv) as f:\n            hdr=None\n            for line in f:\n                if line.startswith('#') or not line.strip(): continue\n                if hdr is None: hdr=line.rstrip().split('\\t');idx={c:i for i,c in enumerate(hdr)};continue\n                rows.append(line.rstrip().split('\\t'))\n    except FileNotFoundError:\n        print(f\"\\n{label}: MISSING {tsv}\"); continue\n    def g(rw,c):\n        i=idx.get(c);return rw[i] if i is not None and i<len(rw) else 'NA'\n    print(f\"\\n{label} [{r}] w_air={wair}\")\n    print(f\"{'clt':>4}{'n':>4}{'score':>9}{'air':>8}{'airfree':>9}{'vdw':>9}{'dockq':>7}{'rank':>5}\")\n    for rw in rows[:4]:\n        try: af=f\"{float(g(rw,'score'))-float(wair)*float(g(rw,'air')):.3f}\"\n        except: af='NA'\n        print(f\"{g(rw,'cluster_id'):>4}{g(rw,'n'):>4}{g(rw,'score'):>9}{g(rw,'air'):>8}{af:>9}{g(rw,'vdw'):>9}{g(rw,'dockq'):>7}{g(rw,'caprieval_rank'):>5}\")\nPY\necho\necho \"############ RECEPTOR IDENTITY (AF3=646 res vs 4PO2 SBD ~386-613) ############\"\nfor r in 2026-06-17_RKALQL_s10000 2026-06-17_RKALQ_s5000 2026-06-17_TGFMALQ_s10000; do\n  echo \"--- $r ---\"\n  rf=$(ls $r/receptor.pdb $r/*.pdb 2>/dev/null | head -1)\n  echo \"receptor file: $rf\"\n  # residue range + chain\n  awk '/^ATOM/{print $5, $6}' \"$rf\" 2>/dev/null | sort -k2 -n -u | awk 'NR==1{print \"first:\",$0} END{print \"last:\",$0}'\n  echo \"atom count:\"; grep -c '^ATOM' \"$rf\" 2>/dev/null\ndone"}

in_dist:>8.1f}  {samples}\")\n\nprint(f\"\\n=== Tight contacts (<4A) - ACTIVE candidates ===\")\nsorted_tight = sorted(tight_contacts, key=lambda x: int(x[0]))\nprint(f\"Residues: {', '.join([r[0] for r in sorted_tight])}\")\nprint(f\"Count: {len(sorted_tight)}\")\n\n# Location breakdown\nbeta = [r for r in sorted_res if int(r[0]) <= 510]\nlid = [r for r in sorted_res if int(r[0]) >= 511]\nprint(f\"\\n=== Location breakdown ===\")\nprint(f\"Beta-sandwich (386-510): {len(beta)} residues\")\nfor r in beta:\n    marker = \" **ACTIVE**\" if (r[0], r[1]) in tight_contacts else \"\"\n    print(f\"  {r[0]} {r[1]}{marker}\")\nprint(f\"\\nLid (511-613): {len(lid)} residues\")  \nfor r in lid:\n    marker = \" **ACTIVE**\" if (r[0], r[1]) in tight_contacts else \"\"\n    print(f\"  {r[0]} {r[1]}{marker}\")\n\nPYEOF"}

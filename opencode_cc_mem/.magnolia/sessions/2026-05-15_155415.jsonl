{"event_type":"tool_call","timestamp":"2026-06-25T09:02:48.229741Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /tmp/agent-hub-smoke\npython3 - <<'PY'\nimport json, time, urllib.request, os\nHUB=\"http://127.0.0.1:4096\"\nAG=\"/home/tjiang/.agent-hub/agents\"; MSG=\"/home/tjiang/.agent-hub/messages\"\nos.makedirs(AG, exist_ok=True); os.makedirs(MSG, exist_ok=True)\ndef post(path, body):\n    req=urllib.request.Request(HUB+path, data=json.dumps(body).encode(), headers={\"content-type\":\"application/json\"}, method=\"POST\")\n    return json.load(urllib.request.urlopen(req, timeout=15))\ndef get(path):\n    return json.load(urllib.request.urlopen(HUB+path, timeout=15))\nnow=int(time.time()*1000)\n# reuse alice, create bob\nalice=\"ses_101fc39f7ffeC4ODg2cdqbQgS4\"\nbob=post(\"/session\", {\"agent\":\"build\"})[\"id\"]\nprint(\"alice=\",alice); print(\"bob=\",bob)\n# register both as agents (mirror coordinator.json shape)\nfor aid,sid in [(\"alice\",alice),(\"bob\",bob)]:\n    json.dump({\"id\":aid,\"sessionId\":sid,\"projectPath\":\"/tmp/agent-hub-smoke\",\n               \"role\":\"smoke-test agent \"+aid,\"capabilities\":[\"agent-hub_send_message\"],\n               \"collaboratesWith\":[],\"status\":\"active\",\"lastSeen\":now},\n              open(f\"{AG}/{aid}.json\",\"w\"))\nprint(\"registered alice+bob\")\n# drop a message alice -> bob (exactly what agent-hub_send_message writes)\nmf=f\"{MSG}/smoke_{now}.json\"\njson.dump({\"from\":\"alice\",\"to\":\"bob\",\"type\":\"message\",\n           \"content\":\"PING from alice. Reply with the single word PONG.\",\"priority\":\"normal\",\n           \"threadId\":\"smoke-1\",\"timestamp\":now}, open(mf,\"w\"))\nprint(\"dropped message\", mf)\nPY\necho \"waiting 12s for daemon to route + inject + LLM...\"; sleep 12\necho \"=== daemon log (last 12 lines) ===\"; tail -12 /tmp/agent-hub-smoke/daemon.log\necho \"=== messages/ now ===\"; ls -la ~/.agent-hub/messages/ ~/.agent-hub/messages/archive/ 2>&1\necho \"=== bob session messages ===\"; curl -s \"http://127.0.0.1:4096/session/$(python3 -c 'import json;print(json.load(open(\"/home/tjiang/.agent-hub/agents/bob.json\"))[\"sessionId\"])')/message\" 2>&1 | python3 -c 'import sys,json; d=json.load(sys.stdin); print(json.dumps([{ \"role\":m[\"info\"][\"role\"], \"agent\":m[\"info\"].get(\"agent\"), \"model\":m[\"info\"].get(\"model\"), \"text\": (m[\"parts\"][0][\"text\"][:160] if m.get(\"parts\") else \"\") } for m in d], indent=2))' 2>&1 | head -40"}

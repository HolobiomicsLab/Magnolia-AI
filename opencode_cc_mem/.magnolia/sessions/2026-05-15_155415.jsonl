{"event_type":"tool_call","timestamp":"2026-06-05T08:41:12.664306Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math\n\ndef read_pdb(path):\n    atoms = []\n    with open(path) as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\ndef centroid(atoms):\n    return [sum(a[k] for a in atoms)/len(atoms) for k in [\"x\",\"y\",\"z\"]]\n\n# Load both structures\nkferq = read_pdb(\"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts/cluster_1_model_1.pdb\")\nkferqx2 = read_pdb(\"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFERQx2_p2rank1_s10000/output/11_seletopclusts/cluster_3_model_1.pdb\")\n\n# Get peptide residues\nfor label, atoms in [(\"KFERQ\", kferq), (\"KFERQx2\", kferqx2)]:\n    pep = sorted(set((a[\"resi\"], a[\"resn\"]) for a in atoms if a[\"chain\"]==\"B\"))\n    seq = \"\".join(r for _, r in pep)\n    print(f\"{label}: {len(pep)} residues [{seq}], resi {pep[0][0]}-{pep[-1][0]}\")\n\n# Align on receptor CA atoms (simple Kabsch would be better, but let's use receptor centroids as rough check)\n# Actually, let's just compare peptide coordinates directly \u2014 since both are docked to the SAME receptor PDB, the receptor coordinates should be identical\nprint()\n\n# Check if receptor coordinates are identical\nrec_kferq = [a for a in kferq if a[\"chain\"]==\"A\" and a[\"name\"]==\"CA\"]\nrec_kferqx2 = [a for a in kferqx2 if a[\"chain\"]==\"A\" and a[\"name\"]==\"CA\"]\nrec_kferq.sort(key=lambda a: a[\"resi\"])\nrec_kferqx2.sort(key=lambda a: a[\"resi\"])\n\n# Compare first 5 receptor CA atoms\nsame = all(abs(r1[\"x\"]-r2[\"x\"])<0.001 and abs(r1[\"y\"]-r2[\"y\"])<0.001 and abs(r1[\"z\"]-r2[\"z\"])<0.001 for r1, r2 in zip(rec_kferq[:10], rec_kferqx2[:10]))\nprint(f\"Receptor coordinates identical? {same}\")\nprint()\n\n# Get peptide CA positions\ndef pep_cas(atoms):\n    cas = [a for a in atoms if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"]\n    cas.sort(key=lambda a: a[\"resi\"])\n    return cas\n\nkferq_cas = pep_cas(kferq)\nkferqx2_cas = pep_cas(kferqx2)\n\nprint(\"KFERQ CA positions:\")\nfor a in kferq_cas:\n    print(f\"  {a['resn']} {a['resi']}: ({a['x']:.1f}, {a['y']:.1f}, {a['z']:.1f})\")\n\nprint(\"\\nKFERQx2 CA positions:\")\nfor a in kferqx2_cas:\n    print(f\"  {a['resn']} {a['resi']}: ({a['x']:.1f}, {a['y']:.1f}, {a['z']:.1f})\")\n\n# Compare first 5 residues (KFERQ core) between the two structures\nprint(\"\\n=== KFERQ core (resi 647-651) alignment ===\")\nkferq_core = {a[\"resi\"]: a for a in kferq_cas if a[\"resi\"] <= 651}\nkferqx2_core = {a[\"resi\"]: a for a in kferqx2_cas if a[\"resi\"] <= 651}\n\nfor resi in sorted(kferq_core):\n    a1 = kferq_core[resi]\n    a2 = kferqx2_core[resi]\n    d = math.sqrt((a1[\"x\"]-a2[\"x\"])**2 + (a1[\"y\"]-a2[\"y\"])**2 + (a1[\"z\"]-a2[\"z\"])**2)\n    print(f\"  {a1['resn']} {resi}: ({a1['x']:.1f},{a1['y']:.1f},{a1['z']:.1f}) vs ({a2['x']:.1f},{a2['y']:.1f},{a2['z']:.1f}) -> \u0394={d:.2f}A\")\n\n# RMSD of the KFERQ core\nsqs = sum((kferq_core[r][\"x\"]-kferqx2_core[r][\"x\"])**2 + (kferq_core[r][\"y\"]-kferqx2_core[r][\"y\"])**2 + (kferq_core[r][\"z\"]-kferqx2_core[r][\"z\"])**2 for r in kferq_core)\nrmsd = math.sqrt(sqs / len(kferq_core))\nprint(f\"\\n  Core 5-mer CA RMSD: {rmsd:.2f}A\")\n\n# What are the extra residues in KFERQx2?\nextra = [a for a in kferqx2_cas if a[\"resi\"] > 651]\nprint(f\"\\n=== Extra residues in KFERQx2 (resi {extra[0]['resi']}-{extra[-1]['resi']}) ===\")\nfor a in extra:\n    print(f\"  {a['resn']} {a['resi']}: ({a['x']:.1f}, {a['y']:.1f}, {a['z']:.1f})\")\n\n# Backbone direction of KFERQ core in KFERQx2\nn_ca = kferqx2_core[min(kferqx2_core)]\nc_ca = kferqx2_core[max(kferqx2_core)]\nvec = (c_ca[\"x\"]-n_ca[\"x\"], c_ca[\"y\"]-n_ca[\"y\"], c_ca[\"z\"]-n_ca[\"z\"])\nprint(f\"\\nKFERQ core backbone vector (N-term -> C-term): ({vec[0]:.1f}, {vec[1]:.1f}, {vec[2]:.1f})\")\n\n# Check if extra residues follow the same vector direction\nif extra:\n    last_core = kferqx2_core[max(kferqx2_core)]\n    extra_vecs = []\n    prev = last_core\n    for a in extra:\n        v = (a[\"x\"]-prev[\"x\"], a[\"y\"]-prev[\"y\"], a[\"z\"]-prev[\"z\"])\n        extra_vecs.append(v)\n        prev = a\n    print(f\"  Continuous C-term extension vectors:\")\n    for i, v in enumerate(extra_vecs):\n        vlen = math.sqrt(v[0]**2+v[1]**2+v[2]**2)\n        print(f\"    Step {i+1}: ({v[0]:.1f}, {v[1]:.1f}, {v[2]:.1f}), len={vlen:.1f}A\")\n\n    # Full backbone dirdection\n    full_vec = (extra[-1][\"x\"]-n_ca[\"x\"], extra[-1][\"y\"]-n_ca[\"y\"], extra[-1][\"z\"]-n_ca[\"z\"])\n    full_len = math.sqrt(full_vec[0]**2+full_vec[1]**2+full_vec[2]**2)\n    print(f\"\\n  Full N->C vector: ({full_vec[0]:.1f}, {full_vec[1]:.1f}, {full_vec[2]:.1f}), len={full_len:.1f}A\")\n\nPYEOF"}

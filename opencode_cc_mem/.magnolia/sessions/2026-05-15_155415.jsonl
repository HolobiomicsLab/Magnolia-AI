{"event_type":"tool_call","timestamp":"2026-06-10T16:00:12.797091Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-10_gnina_asn90_all40\n\npython3 << 'PYEOF'\nimport json\nfrom collections import defaultdict\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\n\n# Build fingerprint for each compound from their SDF files\n# Key: (heavy_atom_count, num_O) -> compound name\nsdf_fingerprints = {}\nfor c in data:\n    safe = c['name'].replace('/','_').replace(' ','_').replace('(','').replace(')','').replace('+','plus').replace('-','minus')\n    fname = f'{safe}.sdf'\n    try:\n        with open(fname) as f:\n            content = f.read()\n        b = content.split('$$$$')[0]; lines = b.strip().split('\\n')\n        na = 0; atom_start = -1\n        for j, l in enumerate(lines):\n            if 'V2000' in l: na = int(l.split()[0]); atom_start = j + 1; break\n        elems = {}\n        for i in range(atom_start, atom_start+na):\n            l = lines[i]\n            if len(l) > 31:\n                e = l[31:34].strip() or 'C'\n                elems[e] = elems.get(e,0)+1\n        heavies = sum(v for k,v in elems.items() if k!='H')\n        n_o = elems.get('O', 0)\n        n_n = elems.get('N', 0)\n        fp = (heavies, n_o, n_n)\n        sdf_fingerprints[fp] = c['name']\n    except: pass\n\n# Parse docked SDF\nwith open('docked_all40_asn90_flex5.sdf') as f:\n    content = f.read()\nblocks = content.split('$$$$')\n\nresults = defaultdict(list)\nunmatched = 0\nfor b in blocks:\n    if not b.strip(): continue\n    lines = b.strip().split('\\n')\n    \n    # Get properties\n    cnn_score = cnn_aff = emp_aff = 0\n    for j, l in enumerate(lines):\n        if l.startswith('> <CNNscore>'): cnn_score = float(lines[j+1])\n        if l.startswith('> <CNNaffinity>'): cnn_aff = float(lines[j+1])\n        if l.startswith('> <minimizedAffinity>'): emp_aff = float(lines[j+1])\n    \n    # Get atom composition\n    na = 0; atom_start = -1\n    for j, l in enumerate(lines):\n        if 'V2000' in l: na = int(l.split()[0]); atom_start = j + 1; break\n    if na == 0: continue\n    elems = {}\n    for i in range(atom_start, atom_start+na):\n        l = lines[i]\n        if len(l) > 31:\n            e = l[31:34].strip() or 'C'\n            elems[e] = elems.get(e,0)+1\n    heavies = sum(v for k,v in elems.items() if k!='H')\n    n_o = elems.get('O', 0)\n    n_n = elems.get('N', 0)\n    fp = (heavies, n_o, n_n)\n    \n    name = sdf_fingerprints.get(fp)\n    if name:\n        results[name].append((emp_aff, cnn_score, cnn_aff))\n    else:\n        unmatched += 1\n\n# Display\nprint(f\"{'Ligand':25s} {'IC50':>7s} {'Kd':>7s} {'EmpAff':>8s} {'CNNaff':>7s} {'CNNscore':>9s} {'Poses':>6s} {'Class':>12s}\")\nprint(\"-\" * 100)\n\n# Classify: strong (Kd<1), moderate (1-10), weak (>=10)\ndef classify(kd):\n    if kd is None or not isinstance(kd, (int,float)): return '?'\n    if kd < 1: return 'STRONG'\n    if kd < 10: return 'MODERATE'\n    return 'WEAK/NON'\n\nrows = []\nfor c in data:\n    name = c['name']\n    if name not in results:\n        continue\n    poses = results[name]\n    best_emp = min(poses, key=lambda x: x[0])\n    rows.append((name, c.get('ic50_obp3', 999), c.get('kd_obp3', 999), \n                 best_emp[0], best_emp[1], best_emp[2], len(poses), classify(c.get('kd_obp3'))))\n\nrows.sort(key=lambda x: x[3])\n\nfor name, ic50, kd, emp, cs, ca, np, cls in rows:\n    ic50_s = f'{ic50:.1f}' if isinstance(ic50, (int,float)) else str(ic50)\n    kd_s = f'{kd:.3f}' if isinstance(kd, (int,float)) else str(kd)\n    print(f\"{name:25s} {ic50_s:>7s} {kd_s:>7s} {emp:>8.1f} {ca:>7.1f} {cs:>9.4f} {np:>6d} {cls:>12s}\")\n\n# Class averages\nclasses = defaultdict(list)\nfor r in rows:\n    classes[r[7]].append(r[3])\nprint()\nfor cls in ['STRONG','MODERATE','WEAK/NON']:\n    vals = classes[cls]\n    if vals:\n        print(f\"  {cls:12s}: mean={sum(vals)/len(vals):.1f}, range=[{min(vals):.1f}, {max(vals):.1f}], n={len(vals)}\")\n\n# Spearman\nnumeric = [(r[1], r[3]) for r in rows if isinstance(r[1], (int,float))]\nif len(numeric) >= 5:\n    from scipy.stats import spearmanr\n    rho, p = spearmanr([n[0] for n in numeric], [n[1] for n in numeric])\n    print(f\"\\nSpearman \u03c1(IC50 vs EmpAff) = {rho:+.3f} (p={p:.3f}, n={len(numeric)})\")\n\nprint(f\"\\nDocked: {len(results)}/40  Unmatched blocks: {unmatched}\")\nPYEOF"}

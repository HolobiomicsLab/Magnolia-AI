{"event_type":"tool_call","timestamp":"2026-06-03T14:23:08.728631Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd /home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-03_KFQKQ_p2rank1_s5000/output/11_seletopclusts && python3 << 'PYEOF'\nimport math, gzip\nfrom collections import defaultdict\n\ndef read_pdb(path):\n    atoms = {}\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                name = line[12:16].strip()\n                resn = line[17:20].strip()\n                chain = line[21:22]\n                resi = int(line[22:26].strip())\n                x, y, z = float(line[30:38]), float(line[38:46]), float(line[46:54])\n                atoms[(chain, resn, resi, name)] = (x, y, z)\n    return atoms\n\ndef dist(a, b):\n    return math.sqrt((a[0]-b[0])**2 + (a[1]-b[1])**2 + (a[2]-b[2])**2)\n\n# Check specific claims for KFQKQ cluster 1 across all 4 models\nmodels = ['cluster_1_model_%d.pdb.gz'%i for i in range(1,5)]\n\n# CLAIM 1: \"K4 took over Q5's pocket (D10, E175, D366, D199)\"\n# Check: K4 NZ-HZ atoms to D10 OD1/OD2, E175 OE1/OE2, D366 OD1/OD2, D199 OD1/OD2\n\n# CLAIM 2: \"Q5 took over R4's pocket (E231, E268, D234, K271)\"\n# Check: Q5 NE2-HE atoms to E231 OE1/OE2, etc.\n\n# CLAIM 3: \"Q3-D366 clash eliminated\" \n# Check: Q3 OE1/NE2 to D366 OD1/OD2 distances vs KFERQ E3 OE1/OE2 to D366 OD1/OD2\n\nLYS_NZ_ATOMS = ['NZ','HZ1','HZ2','HZ3']\nLYS_CE_ATOMS = ['CE']\nGLU_CARBOXYL = ['OE1','OE2','CD','CG']\nASP_CARBOXYL = ['OD1','OD2','CG']\nGLN_AMIDE = ['NE2','OE1','CD','HE21','HE22']\nARG_GUANID = ['NH1','NH2','NE','CZ','HH11','HH12','HH21','HH22']\n\nprint('=== CLAIM 1: K4 contact network ===')\nprint('K4(LYS650) NZ/HZ distances to key acidic residues:')\nfor target_resn, target_resi, target_atoms in [\n    ('ASP',10,ASP_CARBOXYL), ('GLU',175,GLU_CARBOXYL),\n    ('ASP',366,ASP_CARBOXYL), ('ASP',199,ASP_CARBOXYL),\n    ('GLU',367,GLU_CARBOXYL)\n]:\n    all_mins = []\n    for mf in models:\n        atoms = read_pdb(mf)\n        k4_nz = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n                 if c=='B' and rn=='LYS' and ri==650 and name in LYS_NZ_ATOMS]\n        target = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n                  if c=='A' and rn==target_resn and ri==target_resi and name in target_atoms]\n        if k4_nz and target:\n            d = min(dist(ka[1], ta[1]) for ka in k4_nz for ta in target)\n            all_mins.append(d)\n    if all_mins:\n        avg_d = sum(all_mins)/len(all_mins)\n        min_d = min(all_mins)\n        print(f'  K4(NZ/HZ) \u2192 {target_resn}{target_resi}: min {min_d:.1f}A, avg {avg_d:.1f}A ({len(all_mins)}/4 models)')\n\n# Also check K4 CE-NZ to K271 (the clash that was in KFERQ)\nprint()\nprint('  K4-K271 clash check:')\nfor mf in models:\n    atoms = read_pdb(mf)\n    d = min(dist(\n        next(xyz for (c,rn,ri,name),xyz in atoms.items() if c=='B' and rn=='LYS' and ri==650 and name==an),\n        next(xyz for (c,rn,ri,name),xyz in atoms.items() if c=='A' and rn=='LYS' and ri==271 and name==an2))\n        for an in LYS_NZ_ATOMS for an2 in LYS_NZ_ATOMS)\n    print(f'    model {models.index(mf)+1}: K4(NZ/HZ) \u2192 K271(NZ/HZ) min {d:.1f}A')\n\nprint()\nprint('=== CLAIM 2: Q5 contact network ===')\nprint('Q5(GLN651) NE2/HE distances to key residues:')\nfor target_resn, target_resi, target_atoms in [\n    ('ASP',234,ASP_CARBOXYL), ('GLU',231,GLU_CARBOXYL),\n    ('GLU',268,GLU_CARBOXYL), ('LYS',271,LYS_NZ_ATOMS),\n    ('THR',14,['OG1','HG1']), ('TYR',15,['OH','HH'])\n]:\n    all_mins = []\n    for mf in models:\n        atoms = read_pdb(mf)\n        q5_amide = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n                    if c=='B' and rn=='GLN' and ri==651 and name in GLN_AMIDE]\n        target = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n                  if c=='A' and rn==target_resn and ri==target_resi and name in target_atoms]\n        if q5_amide and target:\n            d = min(dist(qa[1], ta[1]) for qa in q5_amide for ta in target)\n            all_mins.append(d)\n    if all_mins:\n        avg_d = sum(all_mins)/len(all_mins)\n        min_d = min(all_mins)\n        print(f'  Q5(NE2/HE) \u2192 {target_resn}{target_resi}: min {min_d:.1f}A, avg {avg_d:.1f}A ({len(all_mins)}/4)')\n\nprint()\nprint('=== CLAIM 3: Q3 vs E3 \u2014 D366 clash ===')\n# KFQKQ Q3(649) to D366\nprint('KFQKQ: Q3(GLN649) \u2192 D366:')\nfor mf in models:\n    atoms = read_pdb(mf)\n    q3_amide = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n                if c=='B' and rn=='GLN' and ri==649 and name in GLN_AMIDE]\n    d366 = [(name, xyz) for (c,rn,ri,name), xyz in atoms.items() \n            if c=='A' and rn=='ASP' and ri==366 and name in ASP_CARBOXYL]\n    d = min(dist(qa[1], ta[1]) for qa in q3_amide for ta in d366)\n    print(f'  model {models.index(mf)+1}: Q3(amide) \u2192 D366(COO) min {d:.1f}A')\nPYEOF\n"}

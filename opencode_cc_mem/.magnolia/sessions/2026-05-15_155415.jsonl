{"event_type":"tool_call","timestamp":"2026-06-18T13:29:36.041662Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport gzip, math\nfrom collections import defaultdict\n\ndef parse_pdb(path):\n    atoms = []\n    with gzip.open(path, 'rt') as f:\n        for line in f:\n            if line.startswith('ATOM') or line.startswith('HETATM'):\n                atoms.append({\n                    'name': line[12:16].strip(),\n                    'resn': line[17:20].strip(),\n                    'chain': line[21:22],\n                    'resi': int(line[22:26]),\n                    'x': float(line[30:38]),\n                    'y': float(line[38:46]),\n                    'z': float(line[46:54]),\n                })\n    return atoms\n\ndef dist(a1, a2):\n    return math.sqrt((a1['x']-a2['x'])**2 + (a1['y']-a2['y'])**2 + (a1['z']-a2['z'])**2)\n\ndef analyze_residue(atoms, chain, resi, label, cutoff=6.0):\n    pep_atoms = [a for a in atoms if a['chain'] == chain and a['resi'] == resi]\n    if not pep_atoms: return\n    \n    resn = pep_atoms[0]['resn']\n    print(f\"\\n{'='*60}\")\n    print(f\"{label} Position {resi} ({resn})\")\n    print(f\"{'='*60}\")\n    \n    ca = [a for a in pep_atoms if a['name'] == 'CA']\n    cb = [a for a in pep_atoms if a['name'] == 'CB']\n    \n    # Receptor residues nearby\n    rec_res = defaultdict(list)\n    for pa in pep_atoms:\n        for ra in atoms:\n            if ra['chain'] != chain:\n                d = dist(pa, ra)\n                if d < cutoff:\n                    rec_res[f\"{ra['chain']}-{ra['resi']}-{ra['resn']}\"].append(d)\n    \n    charged_set = {'ARG','LYS','ASP','GLU'}\n    hydrophobic_set = {'ALA','VAL','LEU','ILE','PHE','TRP','MET','PRO'}\n    aro_set = {'PHE','TYR','TRP','HIS'}\n    \n    print(f\"  Receptor residues within {cutoff}\u00c5:\")\n    for rr in sorted(rec_res, key=lambda x: min(rec_res[x])):\n        mind = min(rec_res[rr])\n        close = sum(1 for d in rec_res[rr] if d < 4.0)\n        resn_rr = rr.split('-')[2]\n        sign = '+/-' if resn_rr in charged_set else ('\u03a6' if resn_rr in hydrophobic_set else ('\u03c0' if resn_rr in aro_set else '~'))\n        print(f\"    {rr:22s} {sign}  min={mind:.1f}\u00c5  <4\u00c5: {close}\")\n    \n    # Void in CB direction\n    if ca and cb:\n        d = (cb[0]['x'] - ca[0]['x'], cb[0]['y'] - ca[0]['y'], cb[0]['z'] - ca[0]['z'])\n        l = math.sqrt(d[0]**2 + d[1]**2 + d[2]**2)\n        u = (d[0]/l, d[1]/l, d[2]/l)\n        \n        # Check perp directions too (ring would need lateral space)\n        # Find two perp vectors\n        if abs(u[0]) < 0.9:\n            v1 = (1, 0, -u[0]/u[2]) if abs(u[2]) > 0.01 else (0, 1, 0)\n        else:\n            v1 = (-u[1]/u[0], 1, 0)\n        l1 = math.sqrt(v1[0]**2 + v1[1]**2 + v1[2]**2)\n        v1 = (v1[0]/l1, v1[1]/l1, v1[2]/l1)\n        # v2 = u \u00d7 v1\n        v2 = (u[1]*v1[2] - u[2]*v1[1], u[2]*v1[0] - u[0]*v1[2], u[0]*v1[1] - u[1]*v1[0])\n        \n        rec_coords = [(ra['x'], ra['y'], ra['z']) for ra in atoms if ra['chain'] != chain]\n        \n        print(f\"  CB direction: ({u[0]:.2f},{u[1]:.2f},{u[2]:.2f})\")\n        for label_test, mult in [(\"ALA CB (2.5\u00c5)\", 2.5), (\"VAL/ILE reach (~3.5\u00c5)\", 3.5), (\"LEU reach (~4.5\u00c5)\", 4.5), (\"PHE ring (~6\u00c5)\", 6.0)]:\n            probe = (ca[0]['x'] + u[0]*mult, ca[0]['y'] + u[1]*mult, ca[0]['z'] + u[2]*mult)\n            nd = min(math.sqrt((probe[0]-x)**2 + (probe[1]-y)**2 + (probe[2]-z)**2) for x,y,z in rec_coords)\n            status = \"\u2713 CLEAR\" if nd > 2.5 else (\"TIGHT\" if nd > 2.0 else \"CLASH\")\n            print(f\"    {label_test:25s} nearest receptor: {nd:.1f}\u00c5  [{status}]\")\n\natoms = parse_pdb('projects/hsc70_new/runs/2026-06-17_TGFMALQ_s10000/output/11_seletopclusts/cluster_1_model_1.pdb.gz')\n\n# TGFMALQ A5 environment\nanalyze_residue(atoms, 'B', 5, 'TGFMALQ')\n# TGFMALQ Q7 environment\nanalyze_residue(atoms, 'B', 7, 'TGFMALQ')\n# TGFMALQ T1 environment\nanalyze_residue(atoms, 'B', 1, 'TGFMALQ')\n\nPYEOF"}

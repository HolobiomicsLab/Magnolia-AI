{"event_type":"tool_call","timestamp":"2026-06-11T09:36:30.246507Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new && python3 -c \"\nimport os, glob, re\n\ndef get_length(run_name):\n    n = run_name.lower()\n    if 'kferq-kildq-fusion' in n: return 14\n    if 'kferqx2' in n: return 11\n    if 'rkelqx2' in n: return 10\n    if 'qrkelx2' in n: return 10\n    if 'rkdlq-variant' in n: return 10\n    if 'apkferq' in n: return 6\n    if 'kferqpk' in n: return 6\n    if 'kferqpf' in n: return 6\n    if 'kferqpq' in n: return 6\n    if 'kferqpa' in n: return 6\n    return 5\n\ndef peptide_name(run_name):\n    # Strip date prefix like '2026-06-01_'\n    n = re.sub(r'^\\d{4}-\\d{2}-\\d{2}_', '', run_name)\n    # Strip suffixes\n    for s in ['_p2rank1_s5000','_p2rank1_s10000','_p2rank1_s2000','_s5000','_s2000','_s1000','_clean']:\n        n = n.replace(s, '')\n    if '_SBD_' in n:\n        n = n.replace('_SBD_', ' (SBD)')\n    return n\n\ndef cat(r):\n    n = r['run'].lower()\n    if 'x2' in n or 'fusion' in n or 'variant' in n: return 3\n    if 'apkferq' in n or 'kferqp' in n: return 2\n    if 'p2rank' in n: return 1\n    return 0\n\nruns = sorted(glob.glob('runs/*/output/12_caprieval/capri_clt.tsv'))\nresults = []\n\nfor f in runs:\n    d = os.path.basename(os.path.dirname(os.path.dirname(os.path.dirname(f))))\n    with open(f) as fh:\n        for line in fh:\n            if line.startswith('#') or line.startswith('cluster_rank'):\n                continue\n            parts = line.strip().split('\\t')\n            if len(parts) < 21:\n                continue\n            results.append({\n                'run': d, 'pep': peptide_name(d),\n                'score': float(parts[4]),\n                'air_free': float(parts[4]) - 0.1 * float(parts[18]),\n                'dockq': float(parts[12]), 'irmsd': float(parts[6]),\n                'bsa': float(parts[20]), 'len': get_length(d),\n            })\n            if parts[0] == '1':\n                break\n\nseen = set()\nuniq = [r for r in results if r['run'] not in seen and not seen.add(r['run'])]\nuniq.sort(key=lambda r: (cat(r), r['air_free']))\n\n# Print grouped\nsections = [\n    ('Experimentalist restraints (positive raw scores)', [r for r in uniq if cat(r)==0]),\n    ('P2Rank \u2014 5-mers', [r for r in uniq if cat(r)==1]),\n    ('P2Rank \u2014 6-mers', [r for r in uniq if cat(r)==2]),\n    ('P2Rank \u2014 longer peptides', [r for r in uniq if cat(r)==3]),\n]\n\nfor title, group in sections:\n    print(f'\\\\n### {title}')\n    print(f\\\"{'Peptide':<24} {'Len':>3} {'Score':>9} {'AIR-free':>9} {'DockQ':>6} {'iRMSD':>7} {'BSA':>7}\\\")\n    print('-' * 72)\n    for r in group:\n        print(f\\\"{r['pep']:<24} {r['len']:>3} {r['score']:>9.2f} {r['air_free']:>9.2f} {r['dockq']:>6.3f} {r['irmsd']:>7.3f} {r['bsa']:>7.0f}\\\")\n\""}

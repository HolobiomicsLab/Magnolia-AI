 FROM message m WHERE m.session_id = ? AND m.data LIKE \\'%memory_get_context%\\' ORDER BY m.time_created', [sid]).fetchall()        \n    # print(f'Session {sid}: {len(rows2)} message mentions')\n\nprint(f'Total memory retrieval calls: {len(all_calls)}')\nfor i, c in enumerate(all_calls):\n    tool_short = c['tool'].split('_', 2)[-1] if '_' in c['tool'] else c['tool']\n    print(f'{i+1}. {c[\\\"session\\\"]} | {tool_short}')\n\" 2>&1"}

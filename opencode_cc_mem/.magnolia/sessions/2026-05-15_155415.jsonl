{"event_type":"tool_call","timestamp":"2026-06-02T11:32:16.308638Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c '\nimport collections, re\nDIR = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs\"\n\nruns = {\n    \"KILDQ\": \"2026-06-01_KILDQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"KFERQ\": \"2026-06-02_KFERQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"QRKEL\": \"2026-06-02_QRKEL_p2rank1_s5000/output/13_contactmap/cluster12_interchain_contacts.tsv\",\n    \"RKELQ\": \"2026-06-02_RKELQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n    \"RKDLQ\": \"2026-06-02_RKDLQ_p2rank1_s5000/output/13_contactmap/cluster1_interchain_contacts.tsv\",\n}\nrec_contacts = collections.defaultdict(list)\nfor pep, path in runs.items():\n    import os\n    full = os.path.join(DIR, path)\n    for line in open(full):\n        if line.startswith(\"#\"): continue\n        p = line.strip().split(\"\\t\")\n        if len(p) < 7: continue\n        if not p[0].startswith(\"A-\"): continue\n        m = re.match(r\"A-(\\d+)-(\\w+)\", p[0])\n        if not m: continue\n        rnum = int(m.group(1)); rname = m.group(2)\n        rec_contacts[rnum].append({\"pep\":pep,\"name\":rname,\"type\":p[4],\"prob\":float(p[5]),\"dist\":float(p[6])})\n\ncounts = collections.Counter()\nbest = {}\nfor rnum, entries in rec_contacts.items():\n    counts[rnum] = len(set(e[\"pep\"] for e in entries))\n    best[rnum] = min(entries, key=lambda e: e[\"dist\"])\n\nprint(f\"{\\\"Res\\\":<10} {\\\"Name\\\":<6} {\\\"Freq\\\":<6} {\\\"Best contact\\\":<35} {\\\"dist\\\":<6} {\\\"prob\\\":<6}\")\nprint(\"-\"*75)\nfor rnum, freq in counts.most_common():\n    if freq < 3: continue\n    b = best[rnum]\n    bc = f\"{b[\\\"pep\\\"]} {b[\\\"type\\\"]}\"\n    print(f\"A-{rnum:<8} {b[\\\"name\\\"]:<6} {freq}/5    {bc:<35} {b[\\\"dist\\\"]:<5.1f} {b[\\\"prob\\\"]:<5.2f}\")\n'"}

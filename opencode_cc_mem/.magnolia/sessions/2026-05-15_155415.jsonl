{"event_type":"tool_call","timestamp":"2026-06-18T13:46:42.464798Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c # Regenerate ambig.tbl with proper actpass\nfor rundir in \\\n  projects/hsc70_new/runs/2026-06-18_RKVLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKILQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKLLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_TAFMALQ_s10000; do\n  \n  name=$(basename $rundir)\n  conda run -n haddock3-py311 haddock3-restraints active_passive_to_ambig \\\n    \"$rundir/receptor.actpass\" \"$rundir/peptide.actpass\" > \"$rundir/ambig.tbl\" 2>/dev/null\n  echo \"$name: ambig.tbl regenerated ($(wc -l < $rundir/ambig.tbl) lines)\"\ndone\n\necho \"\"\necho \"=== Final validation summary ===\"\nfor rundir in \\\n  projects/hsc70_new/runs/2026-06-18_RKVLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKILQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_RKLLQ_s5000 \\\n  projects/hsc70_new/runs/2026-06-18_TAFMALQ_s10000; do\n  \n  name=$(basename $rundir)\n  echo \"--- $name ---\"\n  \n  # Peptide validation\n  patom=$(grep -c '^ATOM' \"$rundir/peptide.pdb\")\n  chain=$(grep '^ATOM' \"$rundir/peptide.pdb\" | head -1 | cut -c22)\n  pep_first=$(grep '^ATOM' \"$rundir/peptide.pdb\" | awk '{print $6}' | sort -nu | head -1)\n  pep_last=$(grep '^ATOM' \"$rundir/peptide.pdb\" | awk '{print $6}' | sort -nu | tail -1)\n  seq=$(grep '^ATOM' \"$rundir/peptide.pdb\" | awk 'NR==1 || $6!=prev {printf \"%s\",$4; prev=$6} END{print \"\"}')\n  \n  fle_sta=$(grep 'fle_sta_2' \"$rundir/config.cfg\" | head -1 | awk '{print $NF}')\n  fle_end=$(grep 'fle_end_2' \"$rundir/config.cfg\" | head -1 | awk '{print $NF}')\n  sampling=$(grep 'sampling' \"$rundir/config.cfg\" | head -1 | awk '{print $NF}')\n  \n  echo \"  Seq: $seq\"\n  echo \"  Chain: $chain  Resi: $pep_first-$pep_last  Atoms: $patom\"\n  echo \"  Config: fle=$fle_sta-$fle_end  sampling=$sampling\"\n  echo \"  Actpass: $(head -1 $rundir/peptide.actpass | wc -w) active resi\"\n  \n  # Check consistency\n  issues=\"\"\n  [ \"$chain\" != \"B\" ] && issues=\"$issues CHAIN\"\n  [ \"$pep_first\" != \"$fle_sta\" ] && issues=\"$issues FLE_STA\"\n  [ \"$pep_last\" != \"$fle_end\" ] && issues=\"$issues FLE_END\"\n  \n  [ -z \"$issues\" ] && echo \"  \u2713 ALL CHECKS PASSED\" || echo \"  \u2717 ISSUES:$issues\"\ndone"}

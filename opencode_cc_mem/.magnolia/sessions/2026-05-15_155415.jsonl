{"event_type":"tool_call","timestamp":"2026-06-24T15:23:06.044450Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new\nmkdir -p runs/_mutant_peptides\ncd runs/_mutant_peptides\nbuild() {  # name, tleap-sequence-args\n  local name=\"$1\"; shift\n  cat > $name.tleap <<EOF\nsource leaprc.protein.ff14SB\npep = sequence { $1 }\nsavepdb pep ${name}_raw.pdb\nquit\nEOF\n  conda run -n ambertools tleap -f $name.tleap >/dev/null 2>&1 && echo \"built $name\" || echo \"FAILED $name\"\n}\n# TGGFQMALT mutants (ACE-capped; ACE=1, residues 2-10)\nbuild TAGFQMALT \"ACE THR ALA GLY PHE GLN MET ALA LEU THR\"\nbuild EGGFQMALT \"ACE GLU GLY GLY PHE GLN MET ALA LEU THR\"\nbuild EAGFQMALT \"ACE GLU ALA GLY PHE GLN MET ALA LEU THR\"\n# RKELQRKEAQ (L9->A, no cap; will renumber to 647-656)\nbuild RKELQRKEAQ \"ARG LYS GLU LEU GLN ARG LYS GLU ALA GLN\"\necho\necho \"=== verify each built peptide (residues) ===\"\nfor f in TAGFQMALT EGGFQMALT EAGFQMALT RKELQRKEAQ; do\n  echo \"--- $f ---\"\n  awk '/^ATOM/{print $4,$5,$6}' ${f}_raw.pdb 2>/dev/null | sort -u -k3 -n | tr '\\n' ' '; echo\ndone"}
{"event_type":"tool_success","timestamp":"2026-06-24T15:23:18.398630Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":12354,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-24T15:23:55.391009Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c cd projects/hsc70_new/runs/_mutant_peptides\npython3 - <<'PY'\nimport re\ndef fix(inp,out,renumber=False):\n    out_l=[]\n    seen={}\n    for line in open(inp):\n        if not line.startswith('ATOM'):\n            if line.startswith('TER'): continue  # drop TER; HADDOCK re-adds\n            if line.startswith('END'): continue\n            out_l.append(line.rstrip('\\n')); continue\n        # fixed cols: chain=21, resSeq=22-26, resName=17-20\n        name=line[12:16].strip(); resn=line[17:20].strip()\n        try: res=int(line[22:26])\n        except: continue\n        if renumber: res=res+646   # 1-10 -> 647-656\n        # rewrite: set chain B (col22), resSeq right-justified in 23-26\n        nl=line[:21]+'B'+str(res).rjust(4)+line[26:].rstrip()\n        # strip element/segid junk beyond col 66 to keep clean; keep through col 66\n        out_l.append(nl[:66])\n        seen[(res,resn)]=seen.get((res,resn),0)+1\n    open(out,'w').write('\\n'.join(out_l+['END'])+'\\n')\n    print(f\"{out}: residues -> {sorted(set(r for r,n in seen))}\")\n    # sequence string\n    seq=[n for r,n in sorted(seen) ]\n    print(f\"   unique res: {[(r,n) for r,n in sorted(seen)]}\")\n# TGGFQMALT mutants: keep numbering (ACE=1, 2-10)\nfor m in ['TAGFQMALT','EGGFQMALT','EAGFQMALT']:\n    fix(f\"{m}_raw.pdb\", f\"{m}.pdb\", renumber=False)\n# RKELQRKEAQ: renumber to 647-656\nfix(\"RKELQRKEAQ_raw.pdb\",\"RKELQRKEAQ.pdb\", renumber=True)\nPY\necho\necho \"=== final checks: chain + first/last residues ===\"\nfor f in TAGFQMALT EGGFQMALT EAGFQMALT RKELQRKEAQ; do\n  echo \"--- $f.pdb ---\"\n  grep '^ATOM' $f.pdb | awk '{print substr($0,18,3),substr($0,22,1),substr($0,23,4)}' | sort -u -k3 -n | tr '\\n' ' '; echo\ndone"}

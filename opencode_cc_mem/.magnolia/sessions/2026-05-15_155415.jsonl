{"event_type":"tool_call","timestamp":"2026-06-10T12:09:58.544976Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c /home/tjiang/anaconda3/bin/python3 << 'PYEOF'\nimport json\nfrom scipy.stats import spearmanr\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\ncompounds = {c['name']: c for c in data}\n\nligands = [\n    ('Z11-16-Ald',   -42.0, -4.01, 'Excellent \u2014 fills cavity, H-bond Asn90'),\n    ('Z11-16-Ac',    -47.6, -3.80, 'Does NOT bind \u2014 acetate clashes'),\n    ('Cedrol',       -41.3, -3.53, 'Excellent \u2014 most abundant'),\n    ('\u03b2-Ionone',     -31.3, -3.12, 'Excellent \u2014 key bamboo volatile'),\n    ('C8-Ald',       -30.5, -3.86, 'Does NOT bind \u2014 too short'),\n    ('C12-Ald',      -34.2, -2.27, 'Moderate \u2014 borderline size'),\n    ('Palmitic acid',-49.9, None,  'Does NOT bind'),\n    ('Citral',       -25.7, -2.95, 'Good \u2014 bamboo volatile'),\n]\n\nnames  = [l[0] for l in ligands]\nh3     = [l[1] for l in ligands]\ngnina  = [l[2] for l in ligands if l[2] is not None]\nic50s  = [compounds[l[0]]['ic50_obp3'] for l in ligands]\nkds    = [compounds[l[0]]['kd_obp3'] for l in ligands]\nnotes  = [l[3] for l in ligands]\n\n# Rankings (lower = better for all metrics)\ndef rank(vals):\n    s = sorted(vals)\n    return [s.index(v)+1 for v in vals]\n\nr_h3 = rank(h3)\nr_ic50 = rank(ic50s)\n\n# Gnina rankings (7 ligands)\ng_names = [l[0] for l in ligands if l[2] is not None]\ng_vals = [l[2] for l in ligands if l[2] is not None]\nr_g = rank(g_vals)\n\nprint(f\"{'Ligand':16s} {'IC50':>7s} {'Kd':>7s} {'HADDOCK':>8s} {'Gnina':>7s}  {'Rank':>4s}{'Rank':>4s}{'Rank':>4s}  Paper\")\nprint(f\"{'':16s} {'(\u03bcM)':>7s} {'(\u03bcM)':>7s} {'score':>8s} {'CNNaff':>7s}  {'IC50':>4s}{'H3':>4s}{'G':>4s}\")\nprint(\"-\" * 90)\n\nfor i, (name, h, g, note) in enumerate(ligands):\n    ic50 = ic50s[i]\n    kd = kds[i]\n    g_str = f'{g:>7.2f}' if g else '    N/A'\n    ri = r_ic50[i]\n    rh = r_h3[i]\n    rg = r_g[g_names.index(name)] if g else '-'\n    rg_str = f'{rg:>4}' if rg != '-' else '   -'\n    print(f\"{name:16s} {ic50:>7.1f} {kd:>7.3f} {h:>8.1f} {g_str}  {ri:>4d} {rh:>4d} {rg_str}  {note}\")\n\n# Correlations\nrho_h3_ic50, p_h3 = spearmanr(ic50s, h3)\nrho_h3_g, p_hg = spearmanr([h3[i] for i in range(8) if ligands[i][2] is not None], g_vals)\nrho_g_ic50, p_g = spearmanr([ic50s[i] for i in range(8) if ligands[i][2] is not None], g_vals)\n\nprint(f\"\\n{'':16s} \u03c1(H3 vs IC50)={rho_h3_ic50:+.2f} (p={p_h3:.2f})  \u03c1(H3 vs G)={rho_h3_g:+.2f} (p={p_hg:.2f})  \u03c1(G vs IC50)={rho_g_ic50:+.2f} (p={p_g:.2f})\")\nPYEOF"}

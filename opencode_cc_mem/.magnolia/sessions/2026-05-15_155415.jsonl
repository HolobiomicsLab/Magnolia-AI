{"event_type":"tool_call","timestamp":"2026-06-10T12:03:51.820029Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport json\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\n\nour_ligands = ['Z11-16-Ald', 'Z11-16-Ac', 'Cedrol', '\u03b2-Ionone', 'C8-Ald', 'C12-Ald', 'Palmitic acid', 'Citral']\nfor lig in our_ligands:\n    for c in data:\n        if c['name'] == lig:\n            ic50 = c.get('ic50_obp3', 'N/A')\n            kd = c.get('kd_obp3', 'N/A')\n            print(f'{lig:20s}  IC50={str(ic50):>6s} \u03bcM   Kd={str(kd):>8s} \u03bcM')\n            break\n    else:\n        print(f'{lig:20s}  NOT FOUND in compounds.json')\n\""}
{"event_type":"tool_success","timestamp":"2026-06-10T12:03:51.871652Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","duration_ms":51,"result_summary":"exit=0"}
{"event_type":"tool_call","timestamp":"2026-06-10T12:04:02.081912Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 -c \"\nimport json\nfrom scipy.stats import spearmanr\n\nwith open('/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/obp/runs/2026-06-09_docking_5NGH/compounds.json') as f:\n    data = json.load(f)\n\nhaddock_scores = {\n    'Z11-16-Ald': -42.0,\n    'Z11-16-Ac': -47.6,\n    'Cedrol': -41.3,\n    '\u03b2-Ionone': -31.3,\n    'C8-Ald': -30.5,\n    'C12-Ald': -34.2,\n    'Palmitic acid': -49.9,\n    'Citral': -25.7,\n}\n\ncompounds = {c['name']: c for c in data}\n\nprint('Ligand             IC50(\u03bcM)  Kd(\u03bcM)    HADDOCK_Score')\nprint('-' * 60)\npairs = []\nfor name, score in haddock_scores.items():\n    c = compounds.get(name)\n    if c:\n        ic50 = c['ic50_obp3']\n        kd = c['kd_obp3']\n        pairs.append((ic50, score))\n        print(f'{name:20s} {ic50:>8.1f}  {kd:>8.3f}  {score:>12.1f}')\n\n# Spearman: lower HADDOCK score = better binding, lower IC50 = better binding\n# Positive correlation expected if docking works\nrho, p = spearmanr([p[0] for p in pairs], [p[1] for p in pairs])\nprint(f'\\nSpearman \u03c1(IC50 vs HADDOCK score) = {rho:.3f}  (p = {p:.3f})')\nprint('Negative \u03c1 = HADDOCK score anti-correlated with experiment (bad)')\nprint('Positive \u03c1 would mean better docking score = better binding (good)')\n\"\n"}

{"event_type":"tool_call","timestamp":"2026-06-17T12:12:19.407134Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c source ~/anaconda3/etc/profile.d/conda.sh && conda activate ambertools && export AMBERHOME=~/anaconda3/envs/ambertools\n\nPDIR=/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new/runs/2026-06-17_mmgbsa_analysis/TGGFQMALT_9mer\ncd \"$PDIR\"\n\npython3 << 'PYEOF'\nimport re, subprocess, os\n\nCONDA = os.path.expanduser(\"~/anaconda3/envs/ambertools/bin\")\nos.environ[\"PATH\"] = CONDA + \":\" + os.environ.get(\"PATH\",\"\")\nos.environ[\"AMBERHOME\"] = os.path.expanduser(\"~/anaconda3/envs/ambertools\")\n\n# Split chains, skip ACE\nrec_lines = []\npep_lines = []\nfor line in open(\"cluster_1_model_1.pdb\"):\n    if not line.startswith(\"ATOM\"): continue\n    if len(line) < 22: continue\n    chain = line[21]\n    resname = line[17:20].strip()\n    if chain == \"A\":\n        rec_lines.append(line)\n    elif chain == \"B\" and resname != \"ACE\":\n        pep_lines.append(line)\n\nopen(\"receptor_raw.pdb\",\"w\").writelines(rec_lines)\nopen(\"peptide_raw.pdb\",\"w\").writelines(pep_lines)\n\nAAS = {\"LYS\",\"ARG\",\"PHE\",\"ASP\",\"ILE\",\"LEU\",\"MET\",\"ALA\",\"ASN\",\"GLY\",\"THR\",\"VAL\",\"GLU\",\"GLN\",\"TRP\",\"SER\",\"CYS\",\"HIS\",\"PRO\",\"TYR\"}\ndef clean(infile, outfile):\n    out = []\n    for line in open(infile):\n        if not line.startswith(\"ATOM\"): continue\n        elem = line[76:78].strip()\n        name = line[12:16].strip()\n        if elem == \"H\" or re.match(r\"^H[A-Z0-9]?$\", name) or re.match(r\"^[0-9]H\", name): continue\n        rn = line[17:20].strip()\n        if len(rn)==4 and rn[0] in (\"N\",\"C\") and rn[1:] in AAS: rn = rn[1:]\n        if rn == \"HIE\": rn = \"HIS\"\n        line = line[:17] + rn.ljust(3) + line[20:]\n        out.append(line)\n    open(outfile,\"w\").writelines(out)\n\nclean(\"receptor_raw.pdb\",\"receptor.pdb\")\nclean(\"peptide_raw.pdb\",\"peptide_noH.pdb\")\n\n# Renumber peptide\nlines = open(\"peptide_noH.pdb\").readlines()\nout = []; prev=None; r=0\nfor line in lines:\n    if len(line)>=26:\n        rn = int(line[22:26])\n        if rn!=prev: r+=1; prev=rn\n        line = line[:22]+str(r).rjust(4)+line[26:]\n    out.append(line)\nopen(\"peptide.pdb\",\"w\").writelines(out)\nprint(f\"peptide residues: {r}\")\n\n# tleap\nwith open(\"tleap.in\",\"w\") as f:\n    f.write(\"source leaprc.protein.ff14SB\\nrec = loadpdb receptor.pdb\\nlig = loadpdb peptide.pdb\\ncomplex = combine {rec lig}\\nsaveamberparm complex complex.prmtop complex.rst7\\nsaveamberparm rec receptor.prmtop receptor.rst7\\nsaveamberparm lig ligand.prmtop ligand.rst7\\nquit\\n\")\nr = subprocess.run(\"tleap -f tleap.in\", shell=True, capture_output=True, text=True)\nif not os.path.isfile(\"complex.prmtop\"):\n    print(\"TLEAP FAILED\")\n    for line in r.stdout.split(\"\\n\"):\n        if \"fatal\" in line.lower() or \"error\" in line.lower():\n            print(f\"  {line.strip()}\")\n    exit(1)\nprint(\"tleap: OK\")\n\n# Read residue counts\ndef read_flag(fn, flag):\n    data=[]; inf=False\n    for line in open(fn):\n        if \"%FLAG\" in line:\n            if flag in line: inf=True; continue\n            elif inf: break\n            else: inf=False\n        elif inf and \"%FORMAT\" in line: continue\n        elif inf: data.extend(line.split())\n    return data\n\nnres_rec = len(read_flag(\"receptor.prmtop\",\"RESIDUE_LABEL\"))\nnres_lig = len(read_flag(\"ligand.prmtop\",\"RESIDUE_LABEL\"))\nlast = nres_rec + nres_lig\nprint(f\"rec={nres_rec} lig={nres_lig} total={last}\")\n\n# sander mdin\nmdin = f\"\"\"Per-residue energy decomposition\n &cntrl\n  ntb=0, nsnb=99999, cut=999.0, imin=5,\n  ncyc=0, igb=5, saltcon=0.15, gbsa=2,\n  surften=0.0072, extdiel=80.0,\n  idecomp=2,\n /\nResidues considered as REC\nRRES 1 {nres_rec}\nEND\nResidues considered as LIG\nLRES {nres_rec+1} {last}\nEND\nResidues to print\n\"\"\"\nfor r in range(nres_rec+1, last+1):\n    mdin += f\"RES {r} {r}\\n\"\nmdin += \"END\\nEND\\n\"\nopen(\"sander_decomp.mdin\",\"w\").write(mdin)\n\n# mdcrd\nsubprocess.run(\"echo 'trajin complex.rst7\\ntrajout complex.mdcrd\\ngo' | cpptraj complex.prmtop\", \n               shell=True, capture_output=True)\n\n# sander\nsubprocess.run(\"sander -O -i sander_decomp.mdin -o sander_decomp.out -r restrt \"\n               \"-c complex.rst7 -y complex.mdcrd -p complex.prmtop\", \n               shell=True, capture_output=True)\n\nif \"PRINT DECOMP - TOTAL ENERGIES\" in open(\"sander_decomp.out\").read():\n    print(\"sander decomp: SUCCESS\")\nelse:\n    print(\"sander decomp: FAILED\")\nPYEOF"}

{"event_type":"tool_call","timestamp":"2026-06-05T12:37:29.641123Z","session_id":"2026-05-15_155415","project_id":"opencode_cc_mem","source":"magnolia-run","tool":"shell","args_summary":"bash -c python3 << 'PYEOF'\nimport math, gzip\n\ndef read_pdb(path):\n    opener = gzip.open if path.endswith('.gz') else open\n    atoms = []\n    with opener(path, 'rt') as f:\n        for line in f:\n            if line.startswith(\"ATOM\"):\n                atoms.append({\n                    \"x\": float(line[30:38]), \"y\": float(line[38:46]), \"z\": float(line[46:54]),\n                    \"resn\": line[17:20].strip(), \"resi\": int(line[22:26]), \"chain\": line[21],\n                    \"name\": line[12:16].strip(),\n                })\n    return atoms\n\ndef get_contacts(atoms, cutoff=5.0):\n    rec = [a for a in atoms if a[\"chain\"]==\"A\"]\n    pep = [a for a in atoms if a[\"chain\"]==\"B\"]\n    contacts = {}\n    for ra in rec:\n        for pa in pep:\n            d = math.sqrt((ra[\"x\"]-pa[\"x\"])**2+(ra[\"y\"]-pa[\"y\"])**2+(ra[\"z\"]-pa[\"z\"])**2)\n            if d <= cutoff:\n                key = (ra[\"resn\"], ra[\"resi\"], pa[\"resn\"], pa[\"resi\"])\n                if key not in contacts or d < contacts[key]:\n                    contacts[key] = d\n    return contacts\n\nbase = \"/home/tjiang/repos/project_magnolia/opencode_cc_mem/projects/hsc70_new\"\nrun = f\"{base}/runs/2026-06-02_KFERQ_p2rank1_s5000/output/11_seletopclusts\"\n\n# Load N-ALA reference\nn_ala = read_pdb(f\"{base}/analysis/6mer_stage1/cluster_2_model_1.pdb\")\ncn_ref = get_contacts(n_ala)\n\n# Get signature: set of (rec_resn, rec_resi) for each peptide residue\ndef contact_signature(contacts):\n    sig = {}\n    for (rrn, rri, prn, pri), d in contacts.items():\n        if pri not in sig:\n            sig[pri] = set()\n        sig[pri].add((rrn, rri))\n    return sig\n\n# N-ALA reference signatures per KFERQ core residue\nsig_ref = contact_signature(cn_ref)\n\n# Check all clusters in parent run\nimport os, glob\nclusters = sorted(glob.glob(f\"{run}/cluster_*_model_1.pdb*\"))\nprint(f\"Checking {len(clusters)} clusters from KFERQ parent...\\n\")\n\nfor clf in clusters:\n    cl_name = os.path.basename(clf).replace('.pdb','').replace('.gz','')\n    atoms = read_pdb(clf)\n    contacts = get_contacts(atoms)\n    sig = contact_signature(contacts)\n    \n    # Compare: for each core residue (647-651), compute Jaccard overlap\n    overlap = {}\n    for resi in [647,648,649,650,651]:\n        s1 = sig_ref.get(resi, set())\n        s2 = sig.get(resi, set())\n        if s1 or s2:\n            jaccard = len(s1 & s2) / len(s1 | s2) if (s1 | s2) else 0\n            overlap[resi] = jaccard\n    \n    avg_jaccard = sum(overlap.values()) / len(overlap) if overlap else 0\n    \n    # Also compute backbone direction\n    cas = sorted([a for a in atoms if a[\"chain\"]==\"B\" and a[\"name\"]==\"CA\"], key=lambda a: a[\"resi\"])\n    if len(cas) >= 2:\n        v = (cas[-1][\"x\"]-cas[0][\"x\"], cas[-1][\"y\"]-cas[0][\"y\"], cas[-1][\"z\"]-cas[0][\"z\"])\n        vlen = math.sqrt(v[0]**2+v[1]**2+v[2]**2)\n    else:\n        v, vlen = (0,0,0), 0\n    \n    # Get air_free and dockq from capri_clt\n    # We'll grab this from the capri data table\n    # For now just show the overlap\n    \n    # Count per-residue contacts\n    counts = {}\n    for (rrn, rri, prn, pri), d in contacts.items():\n        counts[pri] = counts.get(pri, 0) + 1\n    count_str = \", \".join(f\"{pri}:{counts.get(pri,0)}\" for pri in sorted(counts))\n    \n    print(f\"{cl_name}: avg Jaccard={avg_jaccard:.3f}, backbone_len={vlen:.1f}A, counts=[{count_str}]\")\n    print(f\"  per-resi Jaccard: \" + \", \".join(f\"{r}:{overlap.get(r,0):.2f}\" for r in [647,648,649,650,651]))\n\n    # Show which cluster this is in the capri ranking\n    # Print top 5 receptor contacts for K1 and Q5 for quick comparison\n    k1_contacts = [(rn,ri,d) for (rn,ri,pn,pri),d in contacts.items() if pri==647]\n    k1_contacts.sort(key=lambda x: x[2])\n    q5_contacts = [(rn,ri,d) for (rn,ri,pn,pri),d in contacts.items() if pri==651]\n    q5_contacts.sort(key=lambda x: x[2])\n    print(f\"  K1 top: {', '.join(f'{rn}{ri}({d:.1f})' for rn,ri,d in k1_contacts[:5])}\")\n    print(f\"  Q5 top: {', '.join(f'{rn}{ri}({d:.1f})' for rn,ri,d in q5_contacts[:5])}\")\n    print()\n\nPYEOF"}
